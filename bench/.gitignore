.venv/
_bench_tmp/
__pycache__/

# Derived artifacts. `build_corpus.py` emits pages/; `capture.py` emits shots/ and
# snapshots/. The generators plus manifest.json are the source of truth, and
# regenerating is two commands -- committing ~47k lines of rendered output would
# bury the evidence that actually matters (findings_dom.json, local_vlm_results.json,
# blind_key.json) in noise that changes on every Chromium bump.
corpus/out/pages/
corpus/out/shots/
corpus/out/snapshots/
corpus/out/blind/

# The vision layer's work queue and its crops. Derived per profile per run, and
# they restate findings_*.json plus geometry the snapshot already holds -- four
# profiles is ~60k of JSON that changes whenever a capture does. fp_budget.json
# is the exception and IS tracked: it is the defended zero-false-positive
# baseline the README cites, so a run that moves it must show up as a diff.
corpus/out/queue_*.json
corpus/out/crops/
