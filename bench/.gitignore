.venv/
_bench_tmp/
__pycache__/

# Derived artifacts. `build_corpus.py` emits pages/; `capture.py` emits shots/ and
# snapshots/. The generators plus manifest.json are the source of truth, and
# regenerating is two commands -- committing ~47k lines of rendered output would
# bury the evidence that actually matters (findings_dom.json, local_vlm_results.json,
# blind_key.json) in noise that changes on every Chromium bump.
corpus/out/pages/
corpus/out/shots/
corpus/out/snapshots/
corpus/out/blind/

# Same rule for the review pipeline's own output. `review.py` and `route.py`
# default their --out to the corpus dir, so a run in place drops these here;
# every one of them is a re-derivable function of the generators plus the
# detectors, and the crops in particular are PNGs that change on every render.
corpus/out/annotated/
corpus/out/queue/
corpus/out/review.json
corpus/out/vlm_queue.json
