#!/usr/bin/env bash
# cc-custody — dispatched-work custody ledger (CLOSE_INTEGRITY W2; generator G1).
#
# THE GAP THIS CLOSES (recon report-adversarial G1 + report-census §1.2, 2026-08-10): every close
# rung is a function of LOCAL git state, so an origin/lead session whose work is IN FLIGHT in
# dispatched /handoff sessions reads ✅/read-only by construction and every Stop rail correctly
# waves it through. dispatch-assert is discharged by the FIRE itself; nothing ever asserts the
# RETURN was collected. The damage signature matches exactly: 62 content-stranded commits across
# 21 branches in 5 wave-day spikes — "a wave fans out, some members land, the lead's context ends,
# and the unlanded members are never revisited" (111 of 115 worktrees had no live session).
#
# THE MODEL. One APPEND-ONLY jsonl per originator-cwd:
#   ${CC_CUSTODY_DIR:-~/.claude/autonomy/custody}/<cwd-key>.jsonl
# cwd-key = _fired_cwd_key from hooks/lib/origin-identity.sh — the SAME normalisation the
# fired-peer store uses, so the two stores cannot disagree about what a cwd is. Rows:
#   {ts, kind:open|return|abandon, cwd, originatorPane, targetPane, marker, slug, notifyBack, why}
# An OPEN row is discharged by a later return/abandon row matching its MARKER (unique per fire —
# the engagement marker), falling back to slug+targetPane for marker-less fires. Append-only means
# a crashed writer can never corrupt an existing verdict; the open-set is derived at read time.
#
# PRODUCERS: scripts/handoff-fire.sh `open`s beside the fire (notify-back armed ⇒ a return is
#   owed) and `return`s from sc_announce_before_retire; hooks/mailbox-drain.sh `return`s on a
#   received HANDOFF-PING. All best-effort — custody bookkeeping must never break a fire or close.
#   THE TWO DISCHARGE KEYS ARE NOT INTERCHANGEABLE, and which one a caller can use is fixed by what
#   it can see (custody v1.1, item d29b73103189). self-close and cloud-return hold the MARKER —
#   globally unique — so they discharge store-wide and may run from any cwd. The drain holds only
#   the SLUG, because the slug is the sole custody field echoed to the peer (handoff-fire arms
#   `HANDOFF-PING <slug>: …`; the marker is never sent), and a slug is a prompt-file basename that
#   two originators can collide on — so that path discharges --cwd-scoped, which is safe because
#   the ping's recipient IS the originator by construction. A store-wide slug discharge could drop
#   a different cwd's custody silently, which is the direction the POLARITY note below rejects.
# CONSUMERS: scripts/wrap-ledger.sh (CUSTODY_OPEN=), hooks/completion-assert.sh (a done-claim over
#   open custody is a contradiction), hooks/session-continue.sh wake floor (idle + open custody +
#   no armed watcher ⇒ arm the watcher), hooks/operator-readout.sh (renders the line).
# POLARITY: cwd-keyed v1 — two sessions sharing one cwd share a custody view (CUSTODY_SRC=cwd says
#   so). Per-session worktrees (the rollout) make cwd unique in steady state; over-counting a
#   sibling's dispatch costs a bounded, latched block, while a per-pane key would silently DROP
#   custody across the measured resume-loses-pane-id case. Chosen deliberately.
#
# AGE / THE STALE CLASS (item 3b464e94b3ff, 2026-08-17). Rows had no age disposition at all: an
#   open debt from a peer that was reaped, crashed, or died before its detach is indistinguishable
#   from one fired a minute ago, so EVERY later session sharing that cwd inherits it as 🔧 until a
#   human runs `abandon`. The rule chosen — and the one deliberately NOT chosen:
#     · NOT expiry. A TTL that DROPS a row is the silent-loss direction this file's POLARITY note
#       already rejects: the whole store exists because an unreturned wave is invisible, and an
#       age-triggered delete makes it invisible again, this time by construction. Nothing here
#       deletes, nothing here rewrites; the log stays append-only and `count --open` (the sole
#       consumer contract — wrap-ledger's CUSTODY_OPEN) counts stale rows exactly as before.
#     · AGE IS DERIVED AND VISIBLE. Every open row carries `ageHours` (from its own ts) and a
#       `stale` boolean = age >= CC_CUSTODY_TTL_HOURS (default 24 — a dispatched wave that has not
#       pinged back a full day after its fire is not in flight, it is gone). `list --open` renders
#       the age and marks STALE; `--json` carries both fields.
#     · THE STALE SET IS SEPARATELY ADDRESSABLE. `--stale` / `--fresh` select it on list+count, so
#       a consumer can treat a dead peer's debt differently from a fresh one WITHOUT this file
#       deciding for it, and `abandon --stale --why …` discharges the whole set in one explicit,
#       reason-carrying, append-only act. The disposition is a human/agent decision that age makes
#       cheap — never an automatic one.
#   Unparseable/absent ts ⇒ ageHours null ⇒ NOT stale: the classification gates a bulk discharge,
#   so an unknown age must fail toward keeping the debt (lookup-miss-is-not-absence).
#
# Env seams (tests): CC_CUSTODY_DIR · CC_CUSTODY_TTL_HOURS · (lib) CC_FIRED_DIR unused here.
set -uo pipefail

CUSTODY_DIR="${CC_CUSTODY_DIR:-$HOME/.claude/autonomy/custody}"
TTL_HOURS="${CC_CUSTODY_TTL_HOURS:-24}"
case "$TTL_HOURS" in ''|*[!0-9]*) TTL_HOURS=24 ;; esac

_die() { printf 'cc-custody: %s\n' "$1" >&2; exit "${2:-2}"; }

command -v jq >/dev/null 2>&1 || _die "jq not found" 3

# _fired_cwd_key comes from the shared lib — resolve through $0's own symlink first (the live copy
# is ~/.claude/bin/cc-custody -> the checkout; a brand-new lib has no live symlink until install).
_OI_LIB=""
for _c in "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/../hooks/lib/origin-identity.sh" \
          "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/lib/origin-identity.sh" \
          "$HOME/.claude/hooks/lib/origin-identity.sh"; do
  [ -f "$_c" ] && { _OI_LIB="$_c"; break; }
done
# shellcheck source=../hooks/lib/origin-identity.sh
# shellcheck disable=SC1090,SC1091
{ [ -n "$_OI_LIB" ] && . "$_OI_LIB"; } || _die "cannot source origin-identity lib (cwd keying unavailable)" 3

_now() { date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true; }

_row() { # kind cwd originatorPane targetPane marker slug notifyBack why → one compact json line
  jq -nc --arg ts "$(_now)" --arg kind "$1" --arg cwd "$2" --arg op "$3" --arg tp "$4" \
         --arg marker "$5" --arg slug "$6" --arg nb "$7" --arg why "$8" \
    '{ts:$ts, kind:$kind, cwd:$cwd}
     + (if $op     == "" then {} else {originatorPane:$op} end)
     + (if $tp     == "" then {} else {targetPane:$tp}     end)
     + (if $marker == "" then {} else {marker:$marker}     end)
     + (if $slug   == "" then {} else {slug:$slug}         end)
     + (if $nb     == "" then {} else {notifyBack:$nb}     end)
     + (if $why    == "" then {} else {why:$why}           end)'
}

# jq program deriving the OPEN set from one-or-more jsonl streams. Key = marker when present,
# else "slug|targetPane". Latest verdict per key wins; only kind==open survives.
_OPEN_JQ='
  [ inputs ]
  | map(. + {k: (if (.marker // "") != "" then ("m:"+.marker) else ("s:"+(.slug//"")+"|"+(.targetPane//"")) end)})
  | group_by(.k) | map(sort_by(.ts) | last) | map(select(.kind == "open"))
'

# Age annotation, applied AFTER _OPEN_JQ. Needs --argjson ttl. A row whose ts will not parse gets
# ageHours null and stale false — never true (see the AGE block in the header).
# shellcheck disable=SC2016  # $t and $ttl are JQ variables — the single quotes are the point, and
# letting the shell expand them would hand jq an empty binding and silently mark every row fresh.
_AGE_JQ='
  | map( ((.ts // "") | (try fromdateiso8601 catch null)) as $t
         | . + {ageHours: (if $t == null then null else (((now - $t) / 3600) | floor) end)}
         | . + {stale: ((.ageHours != null) and (.ageHours >= $ttl))} )
'
# _select_jq — the stale/fresh filter for list+count, given WANT_STALE/WANT_FRESH.
_select_jq() {
  if [ "$WANT_STALE" -eq 1 ]; then printf '%s' ' | map(select(.stale))'
  elif [ "$WANT_FRESH" -eq 1 ]; then printf '%s' ' | map(select(.stale | not))'
  fi
}

_files_for() { # $1=cwd-or-empty → prints the file list (existing only)
  local cwd="${1:-}" key f
  if [ -n "$cwd" ]; then
    key="$(_fired_cwd_key "$cwd")"; [ -n "$key" ] || return 0
    f="$CUSTODY_DIR/$key.jsonl"; [ -f "$f" ] && printf '%s\n' "$f"
  else
    for f in "$CUSTODY_DIR"/*.jsonl; do [ -f "$f" ] && printf '%s\n' "$f"; done
  fi
  return 0
}

cmd="${1:-}"; shift 2>/dev/null || true
CWD="" TARGET="" MARKER="" SLUG="" NB="" OP="" WHY="" WANT_OPEN=0 WANT_JSON=0 TOKEN=""
WANT_STALE=0 WANT_FRESH=0
# A flag where the token should be is a MALFORMED call, not a token (review #5: `return --cwd X`
# used to adopt "--cwd" as the token and rc-0 "no OPEN row matches" — a silent non-discharge).
case "$cmd" in return|abandon)
  TOKEN="${1:-}"
  case "$TOKEN" in --*) TOKEN="" ;; ''|*) [ -n "$TOKEN" ] && shift ;; esac ;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd) shift; CWD="${1:-}" ;;
    --target) shift; TARGET="${1:-}" ;;
    --marker) shift; MARKER="${1:-}" ;;
    --slug) shift; SLUG="${1:-}" ;;
    --notify-back) shift; NB="${1:-}" ;;
    --originator-pane) shift; OP="${1:-}" ;;
    --why) shift; WHY="${1:-}" ;;
    --open) WANT_OPEN=1 ;;
    --json) WANT_JSON=1 ;;
    # stale/fresh are age CLASSES of the open set — each implies --open (a discharged row has no
    # age disposition worth asking about).
    --stale) WANT_STALE=1; WANT_OPEN=1 ;;
    --fresh) WANT_FRESH=1; WANT_OPEN=1 ;;
    *) _die "unknown arg: $1" ;;
  esac
  shift 2>/dev/null || true
done
[ "$WANT_STALE" -eq 1 ] && [ "$WANT_FRESH" -eq 1 ] && _die "--stale and --fresh are exclusive"

case "$cmd" in
  open)
    [ -n "$CWD" ] && [ -n "$TARGET" ] || _die "open needs --cwd and --target"
    key="$(_fired_cwd_key "$CWD")"; [ -n "$key" ] || _die "cwd does not resolve: $CWD"
    mkdir -p "$CUSTODY_DIR" 2>/dev/null || _die "cannot create $CUSTODY_DIR" 3
    _row open "$CWD" "$OP" "$TARGET" "$MARKER" "$SLUG" "$NB" "" >> "$CUSTODY_DIR/$key.jsonl" \
      || _die "append failed" 3
    ;;
  return|abandon)
    # BULK: `abandon --stale --why …` discharges every STALE open row in scope. One explicit act
    # carrying one reason, appended per row like any other verdict — the addressability half of the
    # age rule (never an expiry, never a rewrite). Prints the number discharged.
    if [ "$cmd" = abandon ] && [ -z "$TOKEN" ] && [ "$WANT_STALE" -eq 1 ]; then
      [ -n "$WHY" ] || _die "abandon needs --why"
      bulk_n=0
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        stale_rows="$(jq -nc --argjson ttl "$TTL_HOURS" "$_OPEN_JQ$_AGE_JQ"' | .[]' "$f" 2>/dev/null || true)"
        while IFS= read -r r; do
          [ -n "$r" ] || continue
          [ "$(printf '%s' "$r" | jq -r '.stale // false')" = true ] || continue
          _row abandon \
            "$(printf '%s' "$r" | jq -r '.cwd // ""')" "$OP" \
            "$(printf '%s' "$r" | jq -r '.targetPane // ""')" \
            "$(printf '%s' "$r" | jq -r '.marker // ""')" \
            "$(printf '%s' "$r" | jq -r '.slug // ""')" "" "$WHY" >> "$f" \
            || _die "append failed" 3
          bulk_n=$((bulk_n + 1))
        done <<INNER
$stale_rows
INNER
      done <<OUTER
$(_files_for "$CWD")
OUTER
      printf '%s\n' "$bulk_n"
      exit 0
    fi
    [ -n "$TOKEN" ] || _die "$cmd needs a <marker-or-slug> token"
    [ "$cmd" = abandon ] && [ -z "$WHY" ] && _die "abandon needs --why"
    matched=""
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      m="$(jq -nc --arg t "$TOKEN" "$_OPEN_JQ"' | map(select(.marker == $t or .slug == $t)) | first // empty' \
             "$f" 2>/dev/null || true)"
      [ -n "$m" ] && { matched="$m"; matched_file="$f"; break; }
    done <<EOF
$(_files_for "$CWD")
EOF
    if [ -n "$matched" ]; then
      _row "$cmd" \
        "$(printf '%s' "$matched" | jq -r '.cwd // ""')" "$OP" \
        "$(printf '%s' "$matched" | jq -r '.targetPane // ""')" \
        "$(printf '%s' "$matched" | jq -r '.marker // ""')" \
        "$(printf '%s' "$matched" | jq -r '.slug // ""')" "" "$WHY" >> "$matched_file" \
        || _die "append failed" 3
    else
      # Best-effort by design: a peer returning after its originator's store was pruned must not
      # fail its own close path. Loud on stderr, rc 0.
      printf 'cc-custody: no OPEN row matches %s — nothing discharged\n' "$TOKEN" >&2
    fi
    ;;
  list)
    files="$(_files_for "$CWD")"
    [ -n "$files" ] || { [ "$WANT_JSON" -eq 1 ] && printf '[]\n' || :; exit 0; }
    if [ "$WANT_OPEN" -eq 1 ]; then
      # shellcheck disable=SC2086
      out="$(cat $files 2>/dev/null | jq -nc --argjson ttl "$TTL_HOURS" "$_OPEN_JQ$_AGE_JQ$(_select_jq)" 2>/dev/null || printf '[]')"
    else
      # shellcheck disable=SC2086
      out="$(cat $files 2>/dev/null | jq -nc '[ inputs ]' 2>/dev/null || printf '[]')"
    fi
    if [ "$WANT_JSON" -eq 1 ]; then printf '%s\n' "$out"
    else printf '%s' "$out" | jq -r '.[] | [.ts, .kind, (.slug // "-"), (.targetPane // "-"), (.marker // "-")]
                                        + (if has("ageHours") then [(if .ageHours == null then "age?" else ((.ageHours|tostring) + "h") end), (if .stale then "STALE" else "fresh" end)] else [] end)
                                        | @tsv' 2>/dev/null || true
    fi
    ;;
  count)
    [ "$WANT_OPEN" -eq 1 ] || _die "count supports --open (optionally with --stale/--fresh) only"
    files="$(_files_for "$CWD")"
    [ -n "$files" ] || { printf '0\n'; exit 0; }
    # The bare `count --open` contract is UNCHANGED — stale rows still count. wrap-ledger's
    # CUSTODY_OPEN reads exactly this, and an age class must never silently shrink a debt.
    if [ "$WANT_STALE" -eq 1 ] || [ "$WANT_FRESH" -eq 1 ]; then
      # shellcheck disable=SC2086
      cat $files 2>/dev/null | jq -nc --argjson ttl "$TTL_HOURS" "$_OPEN_JQ$_AGE_JQ$(_select_jq)"' | length' 2>/dev/null || _die "store unreadable" 3
    else
      # shellcheck disable=SC2086
      cat $files 2>/dev/null | jq -nc "$_OPEN_JQ"' | length' 2>/dev/null || _die "store unreadable" 3
    fi
    ;;
  *) _die "usage: cc-custody open --cwd <dir> --target <pane> [--marker M] [--slug S] [--notify-back NB] [--originator-pane P]
       cc-custody return|abandon <marker-or-slug> [--cwd <dir>] [--why <text>]
       cc-custody abandon --stale --why <text> [--cwd <dir>]   (bulk: every STALE open row)
       cc-custody list [--open [--stale|--fresh]] [--cwd <dir>] [--json]
       cc-custody count --open [--stale|--fresh] [--cwd <dir>]
       stale = open and ageHours >= CC_CUSTODY_TTL_HOURS (default 24); nothing ever expires" ;;
esac
exit 0
