#!/usr/bin/env bash
# cc-resume-debt — a CLOSE is a debt until the resumed session is PROVEN alive
# (docs/plans/CLOSE_RESUME_CUSTODY.md §2 D1/D2; the contract is there, this file implements it).
#
# THE GAP (2026-09-28): an automatic upgrade mover /exit-ed an idle customer session, the relaunch
# into its pane failed because the window was gone, and the only trace was a log row. Every mover
# that closes a session therefore opens a debt here BEFORE the close, and the debt is discharged
# only by proof. Unproven ⇒ one retry in a NEW window with the SAME session id; still unproven ⇒
# ONE runnable operator backlog row plus ONE message to the session's own mailbox. Never silent,
# never twice.
#
# RECOVERY DEBTS (RECYCLE_KEYSTROKELESS_DELIVERY §D4). `settle --recovery <packet>` records a failed
# recycle's packet (~/.claude/autonomy/recycle-failed/<sid>.json) in meta.recovery. Its retry passes
# the packet's <sid>.prompt.md as --prompt-file, its proof needs more than liveness (_prove_debt),
# and its escalation hands the operator the packet's refire_cmd.
#
# STORAGE (D1). bin/cc-custody is reused unchanged against a SIBLING store
#   CC_CUSTODY_DIR=${CC_RESUME_DEBT_DIR:-~/.claude/autonomy/resume-debt}
# — never the dispatch store, whose consumers scope by cwd and would convict the next innocent
# session in the subject's worktree. Rich per-debt state lives beside it in meta/<sid>.json
# (rewritten via temp + mv, never partially):
#   {sid, marker, pane, cfg, account, cwd, by, why, opened_epoch, state, attempts, attempt_epoch,
#    relaunch_rc, backlog_id, page_verdict, events:[{epoch,state,note}]}
#   plus, when present: recovery (packet path), deferrals + first_defer_epoch (H(sid)>0 deferrals),
#   mailed_epoch (packet prompt mailed to a live original), recycle_wait_epoch (first deferral to a
#   live recycle watcher), and the closer's kitty_to / kitty_listen_on / kitty_pid.
#   state ∈ open | retrying | escalated | proven | abandoned
#
# STATE MACHINE (one transition per `step`, under a per-sid mkdir lock):
#   proven | abandoned                         → nothing
#   any other state, proof holds               → discharge (proven)
#   a pending-launch marker still young        → nothing (an indeterminate launch may yet arrive)
#   open, a recycle watcher alive on its pane  → nothing, sweep only (the recycle is not over)
#   open, age ≥ GRACE (or settle's --now)      → relaunch, retrying
#   retrying, relaunch rc≠0 or WAIT elapsed    → escalate (backlog row + mailbox), escalated
#   escalated                                  → nothing new (latched); a later proof still discharges
# PROOF is `cc-find <sid>` reporting LIVE (registry pid + lstart) on two reads HOLD s apart. A
# point-in-time argv/ps match is NOT proof — that was the incident's false positive. A recovery
# debt's proof is stricter still (see _prove_debt).
#
# EXIT CODES: 0 ok · 1 not proven / escalated (prove, settle, surface-absent) · 2 usage ·
#   3 undecided / store or enumerator failure · 4 settle ended on an abandoned debt.
#
# Env seams: CC_RESUME_DEBT_{DIR,CUSTODY_BIN,RESOLVE_BIN,FIND_BIN,PANE_BIN,BACKLOG_BIN,NOTIFY_BIN,
#   RELAUNCH,NOW,HOLD_S,GRACE_S,WAIT_S,POLL_S,LOCK_STALE_S,MAX_DEFER,DEFER_SPAN_S,MAIL_WAIT_S,
#   RECYCLE_WAIT_S,RECYCLE_PENDING_LIB,HANDOFFS_LOG,KITTY_BIN,PENDING_TTL_S}, CC_PENDING_LAUNCH_DIR
#   (boot-resume-launch's indeterminate-launch markers) and CC_REGISTRY_DIR (the pane registry).
#   CC_RESUME_DEBT_RELAUNCH is a command PREFIX and is word-split on purpose (default
#   `bash <repo>/scripts/boot-resume-launch.sh`); <account> <cwd> <sid> are appended, then
#   `--prompt-file <packet>.prompt.md` for a recovery debt.
#   CC_RESUME_DEBT_NOW pins the state-machine clock (tests); settle's own deadline stays wall-clock.
#   CC_RESUME_DEBT_{FENCE,LR_LIB} pin lr-recon-fence.sh and lr-lib.sh.
#
# TAKEOVER (LIMIT_RECOVER_FLEET_V2_ARCHITECTURE.md §C10 "Relaunch"). A relaunch types a resume, so
# it is a typer like every other: it runs only when the reconciler fence says act, under the
# per-sid launch lock, and only while H(sid) — the live holders of the session — is empty. A
# deferral leaves the debt state as it is and records one `deferred` event; H(sid)>0 deferrals count
# as a failed attempt only once there are MAX_DEFER of them spanning DEFER_SPAN_S, and a recovery
# debt's live original is mailed its packet instead (see _relaunch). The launcher child inherits LR_LAUNCH_LOCK, so
# boot-resume-launch acts under this lock rather than deferring to it. Every retry is a new window
# (the in-pane branch was dead and is removed; see above _relaunch).
set -uo pipefail

_SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
_HERE="$(cd "$(dirname "$_SELF")" 2>/dev/null && pwd)"
_REPO="$(cd "$_HERE/.." 2>/dev/null && pwd)"

_die() { printf 'cc-resume-debt: %s\n' "$1" >&2; exit "${2:-2}"; }
_note() { printf 'cc-resume-debt: %s\n' "$1" >&2; }

command -v jq >/dev/null 2>&1 || _die "jq not found" 3

# _sib <name> — the sibling beside this script, else the live copy, else the bare name (PATH).
_sib() {
  if [ -x "$_HERE/$1" ]; then printf '%s' "$_HERE/$1"
  elif [ -x "$HOME/.claude/bin/$1" ]; then printf '%s' "$HOME/.claude/bin/$1"
  else printf '%s' "$1"; fi
}
_launcher() {
  if [ -f "$_REPO/scripts/boot-resume-launch.sh" ]; then printf 'bash %s' "$_REPO/scripts/boot-resume-launch.sh"
  else printf 'bash %s' "$HOME/.claude/scripts/boot-resume-launch.sh"; fi
}
_num() { case "$1" in ''|*[!0-9]*) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac; }

DIR="${CC_RESUME_DEBT_DIR:-$HOME/.claude/autonomy/resume-debt}"
CUSTODY="${CC_RESUME_DEBT_CUSTODY_BIN:-$(_sib cc-custody)}"
RESOLVE="${CC_RESUME_DEBT_RESOLVE_BIN:-$(_sib cc-resume-resolve)}"
FIND="${CC_RESUME_DEBT_FIND_BIN:-$(_sib cc-find)}"
PANE="${CC_RESUME_DEBT_PANE_BIN:-$(_sib cc-pane)}"
BACKLOG="${CC_RESUME_DEBT_BACKLOG_BIN:-$(_sib cc-backlog)}"
NOTIFY="${CC_RESUME_DEBT_NOTIFY_BIN:-$(_sib cc-notify)}"
RELAUNCH="${CC_RESUME_DEBT_RELAUNCH:-$(_launcher)}"
HOLD_S="$(_num "${CC_RESUME_DEBT_HOLD_S:-}" 15)"
GRACE_S="$(_num "${CC_RESUME_DEBT_GRACE_S:-}" 240)"
WAIT_S="$(_num "${CC_RESUME_DEBT_WAIT_S:-}" 180)"
POLL_S="$(_num "${CC_RESUME_DEBT_POLL_S:-}" 5)"
LOCK_STALE_S="$(_num "${CC_RESUME_DEBT_LOCK_STALE_S:-}" 300)"
MAIL_WAIT_S="$(_num "${CC_RESUME_DEBT_MAIL_WAIT_S:-}" 600)"
RECYCLE_WAIT_S="$(_num "${CC_RESUME_DEBT_RECYCLE_WAIT_S:-}" 1800)"
PENDING_TTL_S="$(_num "${CC_RESUME_DEBT_PENDING_TTL_S:-}" 900)"
PENDING="${CC_PENDING_LAUNCH_DIR:-$HOME/.claude/autonomy/pending-launch}"
HANDOFFS_LOG="${CC_RESUME_DEBT_HANDOFFS_LOG:-$HOME/.claude/logs/handoffs.jsonl}"
KITTY_BIN="${CC_RESUME_DEBT_KITTY_BIN:-kitty}"
REG_DIR="${CC_REGISTRY_DIR:-$HOME/.claude/cc-registry}"
META="$DIR/meta"; LOCKS="$DIR/lock"; LOGS="$DIR/log"

_now() { printf '%s' "${CC_RESUME_DEBT_NOW:-$(date +%s)}"; }
_utc() { date -u -r "$1" +%FT%TZ 2>/dev/null || date -u -d "@$1" +%FT%TZ 2>/dev/null || printf '%s' "$1"; }
_bounded() { if command -v timeout >/dev/null 2>&1; then timeout 10 "$@"; else "$@"; fi; }

# ── meta sidecar ────────────────────────────────────────────────────────────────────────────────
_meta() { printf '%s/%s.json' "$META" "$1"; }
_get() { jq -r --arg k "$2" '.[$k] // "" | tostring' "$(_meta "$1")" 2>/dev/null; }
# _set <sid> <jq filter> [jq args…] — atomic rewrite; a failed filter leaves the old file intact.
_set() {
  local f tmp filt; f="$(_meta "$1")"; filt="$2"; shift 2
  tmp="$f.tmp.$$"
  if jq "$@" "$filt" "$f" > "$tmp" 2>/dev/null; then mv -f "$tmp" "$f"; else rm -f "$tmp"; return 1; fi
}
# _ev <sid> <state> <note> — set state and append the event that explains it.
_ev() {
  # shellcheck disable=SC2016  # $s $n $e are jq variables
  _set "$1" '.state = $s | .events += [{epoch: ($e|tonumber), state: $s, note: $n}]' \
    --arg s "$2" --arg n "$3" --arg e "$(_now)"
}
_active() { case "$1" in open|retrying|escalated) return 0 ;; esac; return 1; }

# ── lock (per sid; a lock older than LOCK_STALE_S by mtime may be taken) ─────────────────────────
_HELD=""
_release() { [ -n "$_HELD" ] && rmdir "$_HELD" 2>/dev/null; _HELD=""; }
# The launch lock _relaunch may hold is released on exit too, whatever path ends the process.
_on_exit() { _release; command -v lr_recon_act_done >/dev/null 2>&1 && lr_recon_act_done; return 0; }
trap _on_exit EXIT
_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }
_stale() { local m; m="$(_mtime "$1")"; [ -n "$m" ] && [ $(( $(date +%s) - m )) -ge "$LOCK_STALE_S" ]; }
_lock() {
  local l="$LOCKS/$1" moved
  mkdir -p "$LOCKS" 2>/dev/null
  if ! mkdir "$l" 2>/dev/null; then
    _stale "$l" || return 1
    # Take a stale lock by RENAME (atomic; exactly one taker wins), then re-check what we moved: a
    # racer may have re-made it fresh between our check and our mv — hand that one back.
    moved="$l.stale.$$"
    mv "$l" "$moved" 2>/dev/null || return 1
    if ! _stale "$moved"; then mv "$moved" "$l" 2>/dev/null || rmdir "$moved" 2>/dev/null; return 1; fi
    rmdir "$moved" 2>/dev/null
    mkdir "$l" 2>/dev/null || return 1
  fi
  _HELD="$l"
}

# ── proof ───────────────────────────────────────────────────────────────────────────────────────
_live_once() {
  local out; out="$("$FIND" "$1" 2>/dev/null)" || true   # capture first: no pipe for pipefail to misread
  awk -F'\t' -v s="$1" '$1 == s && $6 == "LIVE" { f = 1 } END { exit !f }' <<<"$out"
}
_prove() { # <sid> <hold>
  _live_once "$1" || return 1
  [ "$2" -gt 0 ] && sleep "$2"
  _live_once "$1"
}
# A FRESH-brief recycle hands the pane to a NEW session id, so the closed sid never comes back and
# its own proof can never pass. Its debt is also discharged by a LIVE successor holding the pane the
# close happened in (`cc-find <pane>`, a sid other than the closed one) — without this, a watcher
# that died after a good relaunch would leave the sweep to resume the old sid beside its successor.
#
# A KITTY WINDOW ID IS NOT A PANE ACROSS KITTY RESTARTS: ids restart at 1, so after a restart "a live
# session in window 44" may be an unrelated session in a NEW kitty's window 44. cc-find does not
# report the kitty generation, but the registry row it joins on (<pane>.json) carries kitty_pid, and
# the debt records the closer's own (KITTY_PID at open). Both known and different ⇒ another kitty,
# not a successor. Either one unknown keeps the pane-id-only reading this proof always had.
_same_kitty() { # <sid> <pane> → rc 1 only when both kitty generations are known and differ
  local want got
  want="$(_get "$1" kitty_pid)"
  got="$(jq -r '.kitty_pid // "" | tostring' "$REG_DIR/$2.json" 2>/dev/null)"
  case "$want" in ''|*[!0-9]*) return 0 ;; esac
  case "$got" in ''|*[!0-9]*) return 0 ;; esac
  [ "$want" = "$got" ]
}
_successor_once() { # <closed sid> <pane>
  local out; out="$("$FIND" "$2" 2>/dev/null)" || true
  awk -F'\t' -v s="$1" -v p="$2" '$2 == p && $1 != s && $6 == "LIVE" { f = 1 } END { exit !f }' <<<"$out" \
    && _same_kitty "$1" "$2"
}
# A RESUME-mode recycle relaunches the SAME sid into the same pane, so its success looks like the
# closed sid LIVE in its recorded pane — which _successor_once (a DIFFERENT sid) can never see.
_same_in_pane_once() { # <sid> <pane>
  local out; out="$("$FIND" "$1" 2>/dev/null)" || true
  awk -F'\t' -v s="$1" -v p="$2" '$1 == s && $2 == p && $6 == "LIVE" { f = 1 } END { exit !f }' <<<"$out" \
    && _same_kitty "$1" "$2"
}
# A RECOVERY debt (settle --recovery <packet>, RECYCLE_KEYSTROKELESS_DELIVERY §D4) is a failed
# recycle's original. LIVE alone proved nothing on 2026-10-09: the original was resumed with no
# prompt, sat idle and LIVE, and its debt discharged while nobody re-fired the recycle. Its proof is
# a live successor holding the pane, or the packet's token in a user record followed by an assistant
# record — the original read the failure and answered, and a re-fire then owns its own debt.
_transcript() { # <sid> → the newest <cfg>/projects/*/<sid>.jsonl, if any
  local cfg f best=""
  cfg="$(_get "$1" cfg)"; [ -n "$cfg" ] || return 1
  for f in "$cfg"/projects/*/"$1".jsonl; do
    [ -f "$f" ] || continue
    { [ -z "$best" ] || [ "$f" -nt "$best" ]; } && best="$f"
  done
  [ -n "$best" ] && printf '%s' "$best"
}
# The token may arrive as a USER record (a launch-argument prompt) or as an ATTACHMENT record (hook
# additionalContext: recycle-failed-inject at SessionStart, or mailbox-drain delivering the packet
# _relaunch mailed to a live original). Either, followed by an assistant record, is an answer. Lines
# are parsed one by one (`fromjson? // empty`): with `jq -n inputs`, ONE malformed line — a record
# cut mid-write — failed the whole parse, and the proof could never pass.
_token_answered() { # <sid> <token> — rc 0 when a user/attachment record carries the token and an assistant record follows it
  local t
  [ -n "$2" ] || return 1
  t="$(_transcript "$1")" || return 1
  grep -qF -- "$2" "$t" 2>/dev/null || return 1   # cheap pre-filter; transcripts reach tens of MB
  # shellcheck disable=SC2016  # jq program
  jq -nR --arg tok "$2" 'reduce (inputs | (fromjson? // empty) | select(type == "object")) as $r ({u: false, a: false};
      if (.u | not) and ($r.type == "user" or $r.type == "attachment")
         and ((($r.message // "") | tostring | contains($tok)) or (($r.attachment // "") | tostring | contains($tok))) then .u = true
      elif .u and $r.type == "assistant" then .a = true else . end) | .a' "$t" 2>/dev/null | grep -qx true
}
_pkt_field() { # <packet> <field> → the field, or nothing (an unparseable packet reads as no field)
  jq -r --arg f "$2" 'if type == "object" then (.[$f] // "" | tostring) else "" end' "$1" 2>/dev/null
}
# THE RE-FIRE IS A PROOF TOO (review item 5). A recovery debt is settled the moment someone re-fires
# the failed recycle — the original after reading its packet, the operator's cc-do of the row's
# refire_cmd, from any pane — and that re-fire owns its own debt from then on. Without this, a re-fire
# in another pane left the recovery debt escalated forever. Two signs: the packet's refired_at (the
# re-fire stamps it), or a recycle-engaged row in handoffs.jsonl whose prev_sid is this sid, written
# after the packet's failed_at (before the failure, an engaged row is the failed recycle's history).
_refired() { # <sid> <packet>
  local since
  [ -n "$(_pkt_field "$2" refired_at)" ] && { _PROOF="the recycle was re-fired (packet refired_at)"; return 0; }
  [ -f "$HANDOFFS_LOG" ] || return 1
  since="$(_pkt_field "$2" failed_at)"; [ -n "$since" ] || since="$(_utc "$(_get "$1" opened_epoch)")"
  # shellcheck disable=SC2016  # jq program
  grep -F '"recycle-engaged"' "$HANDOFFS_LOG" 2>/dev/null | grep -F -- "$1" \
    | jq -nR --arg s "$1" --arg t "$since" 'any(inputs | (fromjson? // empty) | select(type == "object");
        .class == "recycle-engaged" and .engaged == true and .prev_sid == $s and ((.ts // "") >= $t))' 2>/dev/null \
    | grep -qx true || return 1
  _PROOF="the recycle was re-fired (a recycle-engaged row with prev_sid $1 after $since)"
}
# _prove_debt sets _PROOF to the proof that held; _step records it as the discharge note.
_PROOF=""
_prove_debt() { # <sid> <hold> — the proof a debt's mode admits
  local pane pkt tok mode
  pkt="$(_get "$1" recovery)"; tok=""
  [ -n "$pkt" ] && tok="$(_pkt_field "$pkt" token)"
  pane="$(_get "$1" pane)"; mode="$(_get "$1" mode)"
  # A recovery debt whose packet is gone, unparseable or tokenless has nothing stricter to prove
  # against, so it falls through to the plain proof below rather than staying unprovable.
  if [ -n "$tok" ]; then
    _token_answered "$1" "$tok" && { _PROOF="proven: recovery token answered"; return 0; }
    _refired "$1" "$pkt" && return 0
    [ -n "$pane" ] || return 1
    if [ "$mode" = resume ]; then
      _same_in_pane_once "$1" "$pane" || return 1
      [ "$2" -gt 0 ] && sleep "$2"
      _same_in_pane_once "$1" "$pane" || return 1
      _PROOF="proven: the same session LIVE in its recorded pane $pane (resume-mode recycle)"; return 0
    fi
    _successor_once "$1" "$pane" || return 1
    [ "$2" -gt 0 ] && sleep "$2"
    _successor_once "$1" "$pane" || return 1
    _PROOF="proven: a live successor holds pane $pane"; return 0
  fi
  _prove "$1" "$2" && { _PROOF="proven LIVE by cc-find"; return 0; }
  [ "$mode" = fresh ] || return 1
  [ -n "$pane" ] || return 1
  _successor_once "$1" "$pane" || return 1
  [ "$2" -gt 0 ] && sleep "$2"
  _successor_once "$1" "$pane" || return 1
  _PROOF="proven: a live successor holds pane $pane"
}

# ── verbs ───────────────────────────────────────────────────────────────────────────────────────
_open() {
  local cur marker now ccwd key val kpid
  [ -n "$SID" ] || _die "open needs --sid"
  if [ -f "$(_meta "$SID")" ] && _active "$(_get "$SID" state)"; then
    _get "$SID" marker; return 0
  fi
  if [ -z "$CFG" ] || [ -z "$CWD" ] || [ -z "$ACCOUNT" ]; then
    while IFS='=' read -r key val; do
      case "$key" in
        account) [ -n "$ACCOUNT" ] || ACCOUNT="$val" ;;
        config_dir) [ -n "$CFG" ] || CFG="$val" ;;
        cwd) [ -n "$CWD" ] || CWD="$val" ;;
      esac
    done <<EOF
$("$RESOLVE" "$SID" 2>/dev/null || true)
EOF
  fi
  now="$(_now)"; marker="resume:$SID:$now"
  mkdir -p "$META" 2>/dev/null || _die "cannot create $META" 3
  cur="$(_meta "$SID")"
  # The closer's kitty, captured here because `open` runs in the closer's environment and the sweep
  # (launchd) has none: kitty_to/kitty_listen_on key the recycle lock (_recycle_wait), kitty_pid is
  # the kitty generation (_same_kitty). Without KITTY_PID, the closed sid's own registry row has it.
  kpid="${KITTY_PID:-}"
  if [ -z "$kpid" ] && [ -n "$PANE_ID" ] \
     && [ "$(jq -r '.session_id // ""' "$REG_DIR/$PANE_ID.json" 2>/dev/null)" = "$SID" ]; then
    kpid="$(jq -r '.kitty_pid // "" | tostring' "$REG_DIR/$PANE_ID.json" 2>/dev/null)"
  fi
  jq -n --arg sid "$SID" --arg marker "$marker" --arg pane "$PANE_ID" --arg cfg "$CFG" \
    --arg account "$ACCOUNT" --arg cwd "$CWD" --arg by "$BY" --arg why "$WHY" --arg e "$now" \
    --arg mode "$MODE" --arg kto "${CC_TERM_KITTY_TO:-}" --arg klo "${KITTY_LISTEN_ON:-}" --arg kpid "$kpid" \
    '{sid:$sid, marker:$marker, pane:$pane, mode:$mode, cfg:$cfg, account:$account, cwd:$cwd, by:$by, why:$why,
      kitty_to:$kto, kitty_listen_on:$klo, kitty_pid:$kpid,
      opened_epoch:($e|tonumber), state:"open", attempts:0, attempt_epoch:0, relaunch_rc:null,
      backlog_id:"", page_verdict:"", events:[{epoch:($e|tonumber), state:"open", note:("opened by "+$by)}]}' \
    > "$cur.tmp.$$" && mv -f "$cur.tmp.$$" "$cur" || _die "meta write failed" 3
  # custody --cwd must resolve to an existing dir; a vanished worktree keys the row on $HOME.
  ccwd="$CWD"; [ -n "$ccwd" ] && [ -d "$ccwd" ] || ccwd="$HOME"
  if ! CC_CUSTODY_DIR="$DIR" "$CUSTODY" open --cwd "$ccwd" --target "${PANE_ID:--}" --marker "$marker" \
       --slug "$SID" --originator-pane "daemon:$BY" --provenance "$BY: $WHY" >/dev/null 2>&1; then
    # The meta alone still drives the state machine, so the debt is kept, loudly, not dropped.
    _set "$SID" '.events += [{epoch: .opened_epoch, state: "open", note: "custody open FAILED"}]'
    _note "custody open failed for $SID — debt kept in meta only"
    printf '%s\n' "$marker"; return 3
  fi
  printf '%s\n' "$marker"
}

_discharge() { # <sid> <why>
  local st id
  [ -f "$(_meta "$1")" ] || { _note "no debt for $1 — nothing to discharge"; return 0; }
  st="$(_get "$1" state)"
  _active "$st" || { _note "debt for $1 is already $st — nothing to discharge"; return 0; }
  CC_CUSTODY_DIR="$DIR" "$CUSTODY" return "$(_get "$1" marker)" --why "$2" >/dev/null 2>&1 \
    || _note "custody return failed for $1"
  _ev "$1" proven "$2"
  id="$(_get "$1" backlog_id)"
  if [ -n "$id" ]; then
    env -u CLAUDE_CODE_SESSION_ID -u CLAUDE_SESSION_ID -u CC_SESSION_ID \
      "$BACKLOG" "done" "$id" --evidence "$2" >/dev/null 2>&1 || _note "backlog done $id failed"
  fi
  return 0
}

_abandon() { # <sid> <why>
  local st
  [ -f "$(_meta "$1")" ] || { _note "no debt for $1 — nothing to abandon"; return 0; }
  st="$(_get "$1" state)"
  _active "$st" || { _note "debt for $1 is already $st — nothing to abandon"; return 0; }
  CC_CUSTODY_DIR="$DIR" "$CUSTODY" abandon "$(_get "$1" marker)" --why "$2" >/dev/null 2>&1 \
    || _note "custody abandon failed for $1"
  _ev "$1" abandoned "$2"
}

# _evnote <sid> <state> <note> — append an event WITHOUT changing .state; a repeat of the last
# event is dropped, so a sweep that defers every tick does not grow the file without bound.
_evnote() {
  # shellcheck disable=SC2016  # $s $n $e are jq variables
  _set "$1" 'if ((.events[-1].state // "") == $s and (.events[-1].note // "") == $n) then .
             else .events += [{epoch: ($e|tonumber), state: $s, note: $n}] end' \
    --arg s "$2" --arg n "$3" --arg e "$(_now)"
}

# The fence and lr-lib are sourced only on the relaunch path: every other verb stays a cheap CLI.
_FENCE_OK=""
_fence_load() {
  local f
  [ -n "$_FENCE_OK" ] && return 0
  for f in "${CC_RESUME_DEBT_FENCE:-}" "$_REPO/scripts/limit-recover/lr-recon-fence.sh" \
           "$HOME/.claude/scripts/limit-recover/lr-recon-fence.sh"; do
    # shellcheck disable=SC1090  # runtime-resolved
    [ -n "$f" ] && [ -f "$f" ] && . "$f" 2>/dev/null && { _FENCE_OK=1; return 0; }
  done
  # Legacy behaviour when the fence is not deployed: act, said once.
  _note "recon fence unreachable - relaunching as before"
  lr_recon_may_act() { return 0; }
  lr_recon_act_done() { return 0; }
  _FENCE_OK=1
}
_holders() { # <sid> → H(sid) on stdout; rc 1 when lr-lib is unreachable (the caller treats it as NOT empty)
  local f
  if ! command -v lr_holder_count >/dev/null 2>&1; then
    for f in "${CC_RESUME_DEBT_LR_LIB:-}" "$_REPO/scripts/limit-recover/lr-lib.sh" \
             "$HOME/.claude/scripts/limit-recover/lr-lib.sh"; do
      # shellcheck disable=SC1090  # runtime-resolved
      [ -n "$f" ] && [ -f "$f" ] && . "$f" 2>/dev/null && break
    done
  fi
  command -v lr_holder_count >/dev/null 2>&1 || return 1
  lr_holder_count "$1"
}
# THE IN-PANE BRANCH IS GONE (RECYCLE_KEYSTROKELESS_DELIVERY §D4, 2026-10-09). `_in_pane_ok` asked
# `cc-pane state <pane>`, a verb cc-pane has never had, so it refused on every call and the branch
# never ran. It was dead twice over: the handoff-fire --relaunch-at-shell it fed also REQUIRES
# --expect-identity (a pane identity file recorded at close time), which this store never held, so
# the call would have exited 2 even with a working probe. A pane left at a bare shell is now reached
# by the pane-successor consumer (lib/pane-successor.sh, run by the pane's own shell), not typed
# into from here. Every retry is a new window, with the same sid.

# Deferrals on H(sid)>0 are COUNTED (§D4), so a debt cannot stay open and silent behind a holder
# forever — but counted by TIME as well as by number. Counted by number alone, settle's 5 s poll
# turned a 15 s transient holder (a launch lock mid-handover) into a permanent escalation with no
# relaunch ever tried. A deferral becomes a failed attempt (relaunch_rc 75, and the next step
# escalates) only once there have been MAX_DEFER of them AND the first is DEFER_SPAN_S old.
MAX_DEFER="$(_num "${CC_RESUME_DEBT_MAX_DEFER:-}" 3)"
DEFER_SPAN_S="$(_num "${CC_RESUME_DEBT_DEFER_SPAN_S:-}" 600)"

_pkt_stamp() { # <packet> <field> — temp + mv, never in place; best-effort
  local tmp="$1.tmp.$$"
  if jq --arg f "$2" --arg v "$(date -u +%FT%TZ)" '.[$f] = $v' "$1" > "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$1" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
}
_notify_verdict() { # <stderr file> <rc> → page_verdict, read from cc-notify's own stderr token
  local v
  v="$(sed -n 's/.*cc-notify: verdict=\([a-z-]*\).*/\1/p' "$1" 2>/dev/null | tail -1)"
  if [ "$2" -ne 0 ]; then printf 'refused-rc%s%s' "$2" "${v:+ ($v)}"; return 0; fi
  case "$v" in
    delivered) printf reached ;;
    '') printf 'enqueued-unverified' ;;   # rc 0 with no verdict token: enqueued, delivery unknown
    *) printf '%s' "$v" ;;                # mailbox-only, unverified, degraded … recorded as said
  esac
}

# A RECOVERY DEBT'S ORIGINAL IS ALIVE (review ORDERING (b)). Relaunching beside it would be a second
# writer, and counting the deferral escalated it ~15 s into settle although the original was right
# there to be told. So the packet's prompt goes to the original's OWN mailbox, once (mailed_epoch in
# the debt, mailed_at in the packet), and the debt waits for the token-answered proof. MAIL_WAIT_S
# after the mail with no answer — or a mail that could not be sent — is a failed attempt, and the
# next step escalates as before.
_mail_original() { # <sid> <H(sid)> — always rc 1 (the relaunch did not happen)
  local pkt pf me age err rc v
  pkt="$(_get "$1" recovery)"; pf="${pkt%.json}.prompt.md"
  me="$(_num "$(_get "$1" mailed_epoch)" "")"
  if [ -z "$me" ]; then
    err="$LOGS/$1.notify.$$"
    if [ -s "$pf" ]; then
      _bounded "$NOTIFY" --from cc-resume-debt "$1" "$(cat "$pf")" </dev/null >/dev/null 2>"$err"; rc=$?
    else
      printf 'prompt %s missing or empty\n' "$pf" > "$err"; rc=66
    fi
    v="$(_notify_verdict "$err" "$rc")"; cat "$err" >> "$LOGS/$1.log" 2>/dev/null; rm -f "$err"
    if [ "$rc" -ne 0 ]; then
      # shellcheck disable=SC2016  # jq variables
      _set "$1" '.attempts += 1 | .attempt_epoch = ($e|tonumber) | .relaunch_rc = 75' --arg e "$(_now)"
      _ev "$1" retrying "H(sid)=$2: the original is alive but its packet could not be mailed ($v) - counted as a failed attempt"
      return 1
    fi
    _pkt_stamp "$pkt" mailed_at
    # shellcheck disable=SC2016  # jq variables
    _set "$1" '.mailed_epoch = ($e|tonumber) | .mail_verdict = $v' --arg e "$(_now)" --arg v "$v"
    _evnote "$1" deferred "H(sid)=$2: the original is alive - its packet prompt was mailed to it ($v); waiting for its answer"
    return 1
  fi
  age=$(( $(_now) - me ))
  if [ "$age" -ge "$MAIL_WAIT_S" ]; then
    # shellcheck disable=SC2016  # jq variables
    _set "$1" '.attempts += 1 | .attempt_epoch = ($e|tonumber) | .relaunch_rc = 75' --arg e "$(_now)"
    _ev "$1" retrying "H(sid)=$2: the packet mailed to the live original is unanswered after ${age}s - counted as a failed attempt"
    return 1
  fi
  _evnote "$1" deferred "H(sid)=$2: packet mailed to the live original; waiting for its answer"
  return 1
}

_relaunch() { # <sid> — the retry: a NEW window with the SAME sid.
  local acct cwd rc n pkt pf d first
  local -a extra=()
  mkdir -p "$LOGS" 2>/dev/null
  _fence_load
  if ! lr_recon_may_act "$1" cc-resume-debt always 2>>"$LOGS/$1.log"; then
    _evnote "$1" deferred "reconciler owns it"
    return 1
  fi
  if ! n="$(_holders "$1")"; then
    _note "lr-lib.sh unreachable: H($1) unknown, treated as not empty - no relaunch"
    _evnote "$1" deferred "holders unknown (lr-lib unreachable)"
    lr_recon_act_done; return 1
  fi
  case "$n" in ''|*[!0-9]*) n=1 ;; esac
  if [ "$n" -gt 0 ]; then
    lr_recon_act_done
    pkt="$(_get "$1" recovery)"
    if [ -n "$pkt" ] && [ -n "$(_pkt_field "$pkt" token)" ]; then _mail_original "$1" "$n"; return 1; fi
    # shellcheck disable=SC2016  # jq program
    _set "$1" '.deferrals = ((.deferrals // 0) + 1) | .first_defer_epoch = (.first_defer_epoch // ($e|tonumber))' \
      --arg e "$(_now)"
    d="$(_num "$(_get "$1" deferrals)" 1)"
    first="$(_num "$(_get "$1" first_defer_epoch)" "$(_now)")"
    if [ "$d" -ge "$MAX_DEFER" ] && [ $(( $(_now) - first )) -ge "$DEFER_SPAN_S" ]; then
      # shellcheck disable=SC2016  # jq variables
      _set "$1" '.attempts += 1 | .attempt_epoch = ($e|tonumber) | .relaunch_rc = 75' --arg e "$(_now)"
      _ev "$1" retrying "deferred $d times over $(( $(_now) - first ))s: H(sid)=$n live holder(s) - counted as a failed attempt"
      return 1
    fi
    _evnote "$1" deferred "H(sid)=$n live holder(s)"
    return 1
  fi
  acct="$(_get "$1" account)"; cwd="$(_get "$1" cwd)"
  # A recovery debt's retry carries the packet's prompt, so the resumed original wakes on it.
  pkt="$(_get "$1" recovery)"
  if [ -n "$pkt" ]; then
    pf="${pkt%.json}.prompt.md"
    if [ -s "$pf" ]; then extra=(--prompt-file "$pf")
    else _note "recovery prompt $pf missing or empty - relaunching $1 without it"; fi
  fi
  if [ -z "$acct" ] || [ -z "$cwd" ]; then
    rc=64   # unresolvable subject: counts as a failed attempt, so the next step escalates
  else
    # shellcheck disable=SC2086  # RELAUNCH is a command PREFIX, word-split on purpose (header)
    CC_RESUME_DEBT_SETTLING=1 $RELAUNCH "$acct" "$cwd" "$1" ${extra[@]+"${extra[@]}"} </dev/null >>"$LOGS/$1.log" 2>&1
    rc=$?
  fi
  lr_recon_act_done
  # shellcheck disable=SC2016  # jq variables
  _set "$1" '.attempts += 1 | .attempt_epoch = ($e|tonumber) | .relaunch_rc = ($rc|tonumber)' \
    --arg e "$(_now)" --arg rc "$rc"
  _ev "$1" retrying "relaunch rc=$rc$([ "$rc" = 9 ] && printf ' (capacity deferred)')$([ "$rc" = 6 ] && printf ' (launch indeterminate, reconciling)')"
}

# ── ORDERING (review must-fix (a)): a recycle still in flight owns the pane ────────────────────────
# A fresh-mode recycle opens its debt before the /exit, and its watcher's typed fallback may run for
# 10 minutes. The sweep used to relaunch the original at GRACE (240 s) regardless — before the
# recovery packet existed, so the original woke with no prompt and settle --recovery then found it
# alive. While the pane's recycle lock has a live holder (lib/pane-recycle-pending.sh, the ONE
# reading of that lock) the sweep defers, uncounted. Settle does not: handoff-fire's watcher calls
# settle AFTER it has judged the recycle failed, so a live holder seen from settle is, as a rule,
# that caller itself, and deferring there would block the very recovery it asked for.
# Bounded by RECYCLE_WAIT_S from the first such deferral: the lib reads a holder it cannot parse as
# PENDING (fail-safe for a closer), and a broken lock must not hold a debt open forever. An absent
# lib defers nothing (the relaunch it would have prevented is the pre-existing behaviour).
_RP=""
_recycle_wait() { # <sid> → rc 0 = deferred to a live recycle watcher; 1 = go on
  local pane f k first
  pane="$(_get "$1" pane)"; [ -n "$pane" ] || return 1
  if [ -z "$_RP" ]; then
    _RP=absent
    for f in "${CC_RESUME_DEBT_RECYCLE_PENDING_LIB:-}" "$_REPO/lib/pane-recycle-pending.sh" \
             "$HOME/.claude/lib/pane-recycle-pending.sh"; do
      # shellcheck disable=SC1090  # runtime-resolved
      [ -n "$f" ] && [ -f "$f" ] && . "$f" 2>/dev/null && command -v cc_pane_recycle_pending >/dev/null 2>&1 \
        && { _RP=ok; break; }
    done
  fi
  [ "$_RP" = ok ] || return 1
  # The lock key embeds the recycler's kitty socket; the sweep has no kitty env, so the closer's own
  # (recorded at open) is used when there is one; the subshell keeps it from leaking.
  if ! ( k="$(_get "$1" kitty_to)"; [ -n "$k" ] && CC_TERM_KITTY_TO="$k"
         k="$(_get "$1" kitty_listen_on)"; [ -n "$k" ] && KITTY_LISTEN_ON="$k"
         cc_pane_recycle_pending "$pane" ); then
    return 1
  fi
  # shellcheck disable=SC2016  # jq variables
  _set "$1" '.recycle_wait_epoch = (.recycle_wait_epoch // ($e|tonumber))' --arg e "$(_now)"
  first="$(_num "$(_get "$1" recycle_wait_epoch)" "$(_now)")"
  if [ $(( $(_now) - first )) -ge "$RECYCLE_WAIT_S" ]; then
    _evnote "$1" deferred "recycle lock on pane $pane still reads pending after ${RECYCLE_WAIT_S}s - no longer deferring to it"
    return 1
  fi
  _evnote "$1" deferred "a recycle watcher is alive on pane $pane - the recycle is not over"
  return 0
}

# ── PENDING LAUNCH (review item 2): an indeterminate launch is reconciled, not guessed ─────────────
# boot-resume-launch exits 6 when its kitty client timed out and no window carried its launch token
# YET — on 2026-10-09 kitty created the window nine minutes later — and leaves
# $PENDING/<sid>.json {token, launched_at, acct, cwd, kitty_to}. Each step re-asks kitty for a
# window carrying the token: one exists ⇒ the launch arrived (marker removed; a retry that rc-6'd is
# treated as launched and the proof runs its WAIT); none and the marker is PENDING_TTL_S old ⇒ the
# launch is lost (marker removed; that retry reopens, so the normal relaunch follows); otherwise the
# debt waits. An unreadable marker counts as lost: it cannot be reconciled, and must not wedge.
_pending_launch() { # <sid> → rc 0 = still indeterminate (defer); 1 = no marker, or reconciled
  local m tok at kto out age
  m="$PENDING/$1.json"; [ -f "$m" ] || return 1
  tok="$(_pkt_field "$m" token)"; kto="$(_pkt_field "$m" kitty_to)"
  at="$(_num "$(_pkt_field "$m" launched_at)" 0)"
  if [ -n "$tok" ]; then
    if [ -n "$kto" ]; then out="$(_bounded "$KITTY_BIN" @ --to "$kto" ls --match "env:CC_LAUNCH_TOKEN=$tok" 2>/dev/null)"
    else out="$(_bounded "$KITTY_BIN" @ ls --match "env:CC_LAUNCH_TOKEN=$tok" 2>/dev/null)"; fi
    case "$out" in
      *"$tok"*)
        rm -f "$m"
        if [ "$(_get "$1" state)" = retrying ] && [ "$(_get "$1" relaunch_rc)" = 6 ]; then
          # shellcheck disable=SC2016  # jq variables
          _set "$1" '.relaunch_rc = 0 | .attempt_epoch = ($e|tonumber)' --arg e "$(_now)"
        fi
        _evnote "$1" reconciled "pending launch $tok: its window exists - launched late, awaiting proof"
        return 1 ;;
    esac
  fi
  age=$(( $(_now) - at ))
  if [ -z "$tok" ] || [ "$age" -ge "$PENDING_TTL_S" ]; then
    rm -f "$m"
    if [ "$(_get "$1" state)" = retrying ] && [ "$(_get "$1" relaunch_rc)" = 6 ]; then
      _ev "$1" open "pending launch ${tok:-<unreadable>}: no window after ${age}s - presumed lost, relaunch allowed"
    else
      _evnote "$1" reconciled "pending launch ${tok:-<unreadable>}: no window after ${age}s - marker removed"
    fi
    return 1
  fi
  _evnote "$1" deferred "pending launch $tok is indeterminate (${age}s old) - waiting for its window"
  return 0
}

# _escalate — once per debt: one backlog row (the operator readout renders needs-human rows) and one
# message to the stranded session's OWN mailbox, which mailbox-drain delivers the moment it next
# takes a turn. It used to call `cc-notify --page`, a flag cc-notify has never had: every page was
# refused with rc 2 (bin/cc-notify, the unknown-option arm) and recorded as `refused-rc2`. The
# verdict still lands in .page_verdict, now for the mailbox send: reached (verdict=delivered),
# mailbox-only and the other cc-notify verdicts as said, or refused-rc<N>. A recovery debt names the fix
# itself: the packet's refire_cmd is the row's --run, and the packet path rides in title and --run.
_escalate() { # <sid>
  local acct cwd by opened run title out rc id prc msg pkt refire err verdict
  acct="$(_get "$1" account)"; cwd="$(_get "$1" cwd)"; by="$(_get "$1" by)"
  opened="$(_get "$1" opened_epoch)"; pkt="$(_get "$1" recovery)"; refire=""
  [ -n "$pkt" ] && refire="$(jq -r '.refire_cmd // ""' "$pkt" 2>/dev/null)"
  run="$(printf 'bash %s %q %q %q' "$HOME/.claude/scripts/boot-resume-launch.sh" "$acct" "$cwd" "$1")"
  title="Resume stranded session $1 ($(basename "${cwd:-?}"), account ${acct:-?}) — ${by:-a mover} closed it and the relaunch failed (debt opened $(_utc "$opened"))"
  if [ -n "$pkt" ]; then
    # bash -c runs a --run (bin/cc-do), so the trailing packet path is a comment, never an argument.
    [ -n "$refire" ] && run="$refire  # recovery packet: $pkt"
    title="Re-fire the failed recycle of session $1 ($(basename "${cwd:-?}"), account ${acct:-?}) — its recovery relaunch was not proven (debt opened $(_utc "$opened")); packet $pkt; re-fire: ${refire:-<packet has no refire_cmd>}"
  fi
  out="$(env -u CLAUDE_CODE_SESSION_ID -u CLAUDE_SESSION_ID -u CC_SESSION_ID \
           "$BACKLOG" needs "$title" --class needs-human --project claude-infrastructure --run "$run" </dev/null 2>/dev/null)"
  rc=$?
  id=""; [ "$rc" -eq 0 ] && id="$(printf '%s\n' "$out" | grep -xE '[0-9a-f]{12}' | tail -1)"
  # Latch BEFORE the message: a crash after this point cannot mint a second row.
  # shellcheck disable=SC2016  # jq variables
  _set "$1" '.backlog_id = $id' --arg id "$id"
  _ev "$1" escalated "backlog needs rc=$rc id=${id:-none}"
  if [ -n "$pkt" ]; then
    # The packet already carries the re-fire order (its prompt); a second one here would be two
    # instructions to act on one failure. The mail points at the packet and orders nothing.
    msg="STRANDED SESSION $1 — the recovery of its failed recycle was not proven; recovery packet: $pkt"
  elif [ -n "$id" ]; then msg="STRANDED SESSION $1 — relaunch failed; run: cc-do $id"
  else msg="STRANDED SESSION $1 — relaunch failed; run: $run"; fi
  # HONEST VERDICT (review item 8). cc-notify exits 0 for a mailbox-only enqueue to a dead target as
  # well as for a live delivery; only its stderr token tells them apart (bin/cc-notify, Exit:).
  mkdir -p "$LOGS" 2>/dev/null
  err="$LOGS/$1.notify.$$"
  _bounded "$NOTIFY" --from cc-resume-debt "$1" "$msg" </dev/null >/dev/null 2>"$err"; prc=$?
  verdict="$(_notify_verdict "$err" "$prc")"; cat "$err" >> "$LOGS/$1.log" 2>/dev/null; rm -f "$err"
  # shellcheck disable=SC2016  # jq variables
  _set "$1" '.page_verdict = $v' --arg v "$verdict"
}

_step() { # <sid> <now-flag 0|1> — ONE transition; a held lock makes it a no-op.
  local st age
  [ -f "$(_meta "$1")" ] || { _note "no debt for $1"; return 0; }
  _lock "$1" || return 0
  st="$(_get "$1" state)"
  if _active "$st"; then
    _PROOF=""
    if _prove_debt "$1" "$HOLD_S"; then
      rm -f "$PENDING/$1.json" 2>/dev/null
      _discharge "$1" "${_PROOF:-proven LIVE by cc-find}"
    elif _pending_launch "$1"; then
      :   # an indeterminate launch may still arrive: no relaunch, no escalation
    else
      st="$(_get "$1" state)"   # the reconcile may have reopened a retry
      case "$st" in
        open)
          age=$(( $(_now) - $(_get "$1" opened_epoch) ))
          if [ "$2" -eq 1 ] || [ "$age" -ge "$GRACE_S" ]; then
            { [ "$2" -eq 0 ] && _recycle_wait "$1"; } || _relaunch "$1"
          fi ;;
        retrying)
          age=$(( $(_now) - $(_get "$1" attempt_epoch) ))
          { [ "$(_get "$1" relaunch_rc)" != 0 ] || [ "$age" -ge "$WAIT_S" ]; } && _escalate "$1" ;;
      esac
    fi
  fi
  _release
  return 0
}

_settle() { # <sid> <wait> — rc 0 proven · 1 escalated · 3 undecided · 4 abandoned
  local deadline st
  # A settle IS the caller saying "I closed this session and could not bring it back". No debt on
  # file (an older mover closed it, or its open failed) must not turn that into a silent no-op:
  # open one now from what cc-resume-resolve knows, then settle it like any other.
  if [ ! -f "$(_meta "$1")" ] || ! _active "$(_get "$1" state)"; then
    [ "$BY" = unknown ] && BY="settle (no prior debt)"
    _open >/dev/null || [ -f "$(_meta "$1")" ] || { _note "no debt for $1 and none could be opened"; return 3; }
  fi
  # --recovery <packet>: stored on the debt whether it was just opened or already on file, so the
  # retry, the proof and the escalation below all see it.
  if [ -n "$RECOVERY" ]; then
    # shellcheck disable=SC2016  # jq variables
    _set "$1" '.recovery = $r' --arg r "$RECOVERY" || _note "could not record recovery packet for $1"
  fi
  deadline=$(( SECONDS + $2 ))
  while :; do
    _step "$1" 1
    st="$(_get "$1" state)"
    case "$st" in proven) return 0 ;; escalated) return 1 ;; abandoned) return 4 ;; esac
    [ "$SECONDS" -ge "$deadline" ] && return 3
    sleep "$POLL_S"
  done
}

_sids() { # every sid with a meta file
  local f
  for f in "$META"/*.json; do [ -f "$f" ] && basename "$f" .json; done
  return 0
}

_sweep() {
  local s
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    # escalated is swept too: it stays OPEN (D2) and only a proof here can discharge it.
    _active "$(_get "$s" state)" || continue
    _step "$s" 0
    printf '%s %s\n' "$s" "$(_get "$s" state)"
  done <<EOF
$(_sids)
EOF
  return 0
}

_surface() { # <pane> — rc 0 enumerated · 1 absent · 3 enumerator failed/empty (unknown ≠ absent)
  local out
  out="$(_bounded "$PANE" list 2>/dev/null)" || return 3
  [ -n "$out" ] || return 3
  # Whole-line match without a pipe (pipefail-sigpipe ratchet); $'\n' because a $( ) would strip
  # the trailing newline and the LAST pane in the list could never match.
  case $'\n'"$out"$'\n' in *$'\n'"$1"$'\n'*) return 0 ;; esac
  return 1
}

_list() {
  local files filt
  files="$(_sids | while IFS= read -r s; do [ -n "$s" ] && _meta "$s" && printf '\n'; done)"
  filt='.'
  [ "$WANT_OPEN" -eq 1 ] && filt="$filt | map(select(.state == \"open\" or .state == \"retrying\" or .state == \"escalated\"))"
  [ "$WANT_ESC" -eq 1 ] && filt="$filt | map(select(.state == \"escalated\"))"
  if [ -z "$files" ]; then [ "$WANT_JSON" -eq 1 ] && printf '[]\n'; return 0; fi
  if [ "$WANT_JSON" -eq 1 ]; then
    # shellcheck disable=SC2086  # one path per word; sids are validated to carry no whitespace
    jq -s "$filt" $files
  else
    # shellcheck disable=SC2086
    jq -rs "$filt | .[] | [.sid, .state, (.attempts|tostring), (if .backlog_id == \"\" then \"-\" else .backlog_id end), .marker] | @tsv" $files
  fi
}

usage() {
  cat <<'U'
usage: cc-resume-debt open   --sid S [--cfg CFG] [--cwd C] [--pane P] [--account A] [--by WHO] [--why TEXT]
                             [--mode resume|fresh]   fresh = a successor with a NEW sid in --pane also proves
       cc-resume-debt prove  --sid S [--hold N]
       cc-resume-debt discharge --sid S --why TEXT
       cc-resume-debt abandon   --sid S --why TEXT
       cc-resume-debt step   --sid S
       cc-resume-debt settle --sid S [--wait N] [--recovery PACKET]
                             PACKET = a failed recycle's recycle-failed/<sid>.json
       cc-resume-debt sweep
       cc-resume-debt surface --pane P
       cc-resume-debt list [--open] [--escalated] [--json]
U
}

# ── args ────────────────────────────────────────────────────────────────────────────────────────
cmd="${1:-}"; shift 2>/dev/null || true
SID="" CFG="" CWD="" PANE_ID="" ACCOUNT="" BY="unknown" WHY="" HOLD="" WAIT="" MODE="resume" RECOVERY=""
WANT_OPEN=0 WANT_ESC=0 WANT_JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --sid) shift; SID="${1:-}" ;;
    --cfg) shift; CFG="${1:-}" ;;
    --cwd) shift; CWD="${1:-}" ;;
    --pane) shift; PANE_ID="${1:-}" ;;
    --account) shift; ACCOUNT="${1:-}" ;;
    --by) shift; BY="${1:-}" ;;
    --why) shift; WHY="${1:-}" ;;
    --mode) shift; MODE="${1:-}" ;;
    --hold) shift; HOLD="${1:-}" ;;
    --wait) shift; WAIT="${1:-}" ;;
    --recovery) shift; RECOVERY="${1:-}" ;;
    --open) WANT_OPEN=1 ;;
    --escalated) WANT_ESC=1 ;;
    --json) WANT_JSON=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; _die "unknown arg: $1" ;;
  esac
  shift 2>/dev/null || true
done
# The sid names a file under meta/ and lock/ — refuse anything that could leave them.
case "$SID" in ''|[A-Za-z0-9]*) ;; *) _die "bad --sid: $SID" ;; esac
case "$SID" in *[!A-Za-z0-9._-]*) _die "bad --sid: $SID" ;; esac
case "$MODE" in resume|fresh) ;; *) _die "bad --mode: $MODE (resume|fresh)" ;; esac
# A missing packet costs the recovery handling, never the settle: the debt still runs as a plain one.
if [ -n "$RECOVERY" ] && [ ! -f "$RECOVERY" ]; then
  _note "--recovery: no such packet: $RECOVERY - settling as a plain resume debt"; RECOVERY=""
fi
_need_sid() { [ -n "$SID" ] || _die "$cmd needs --sid"; }

case "$cmd" in
  open) _open ;;
  prove) _need_sid; _prove "$SID" "$(_num "$HOLD" "$HOLD_S")" ;;
  discharge) _need_sid; [ -n "$WHY" ] || _die "discharge needs --why"; _discharge "$SID" "$WHY" ;;
  abandon) _need_sid; [ -n "$WHY" ] || _die "abandon needs --why"; _abandon "$SID" "$WHY" ;;
  step) _need_sid; _step "$SID" 0 ;;
  settle) _need_sid; _settle "$SID" "$(_num "$WAIT" $(( WAIT_S + 30 )))" ;;
  sweep) _sweep ;;
  surface) [ -n "$PANE_ID" ] || _die "surface needs --pane"; _surface "$PANE_ID" ;;
  list) _list ;;
  -h|--help|help) usage ;;
  *) usage >&2; _die "unknown verb: ${cmd:-<none>}" ;;
esac
