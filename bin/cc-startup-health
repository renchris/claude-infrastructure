#!/usr/bin/env bash
# cc-startup-health — what a session's startup hooks failed to deliver, and how to get it back.
#
#   cc-startup-health [<sid>]   read-only report. With a sid: every own SessionStart hook's state
#                               (confirmed lost / possible, unconfirmed / delivered / nothing owed),
#                               its sentinel record and its recovery; foreign project hooks the
#                               harness cancelled, NAMED and never run; the dispatcher's outbox board.
#                               Without one: the sessions that have anything not delivered.
#   cc-startup-health --fleet   the off-path fold, run by the keepwarm tick (bin/claude-accounts
#                               --keepwarm): writes the accounts-board line to $R/fleet-line.txt,
#                               stamps $R/fleet.stamp, scans any unscanned start epoch, and deletes
#                               session dirs older than 7 days.
#   cc-startup-health --span    the load-banded startup span (24 h and 7 d) behind the board's span line
#   cc-startup-health --detector  the shadow drop detector's held trips and its last log rows
#   cc-startup-health --ack     acknowledge every occurrence the line counts now. Any LATER
#                               occurrence raises the line again: clearing is per occurrence
#                               (<sid>:<hook>:<start-mtime>), never by kind and never on a timer.
#
# docs/research/startup-hooks-2026-10-18/README.md §5 units 3.3 and 3.5; gap-G3 (the transcript is
# the authority), gap-G4 (the fleet line: ~94% of own-hook startup drops happen in panes no person is
# shown to watch, so a per-pane line alone cannot reach the operator). Losses count under ⚠;
# deferrals (a mailbox-drain cancel: its mail re-delivers; a cancel of a hook that owed nothing) go
# in the plain suffix, and alone print no line, so the ⚠ never becomes wallpaper.
#
# R=${CC_STARTUP_HEALTH_DIR:-$HOME/.claude/state/startup-health}. bash 3.2-safe; jq for scans only.
set -uo pipefail

R="${CC_STARTUP_HEALTH_DIR:-$HOME/.claude/state/startup-health}"
SETTLE_S="${CC_STARTUP_HEALTH_SETTLE_S:-120}"   # a start younger than this may still be running
KEEP_DAYS="${CC_STARTUP_HEALTH_KEEP_DAYS:-7}"

_self="$0"
while [ -L "$_self" ]; do
  _l="$(readlink "$_self")"
  if [ "${_l#/}" != "$_l" ]; then _self="$_l"; else _self="$(dirname "$_self")/$_l"; fi
done
_root="$(cd "$(dirname "$_self")/.." 2>/dev/null && pwd || true)"
LIB=""
for _c in "$_root/hooks/lib/startup-health.sh" "$HOME/.claude/hooks/lib/startup-health.sh"; do
  [ -f "$_c" ] && { LIB="$_c"; break; }
done
[ -n "$LIB" ] || { echo "cc-startup-health: hooks/lib/startup-health.sh not found" >&2; exit 2; }
# shellcheck source=../hooks/lib/startup-health.sh disable=SC1091
. "$LIB"

now="$(date +%s)"
mtime() { stat -f %m "$1" 2>/dev/null || echo 0; }
fmt_age() { # <seconds>
  if   [ "$1" -lt 3600 ];   then printf '%sm' "$(( $1 / 60 ))"
  elif [ "$1" -lt 172800 ]; then printf '%sh' "$(( $1 / 3600 ))"
  else                           printf '%sd' "$(( $1 / 86400 ))"
  fi
}
fmt_t() { date -r "$1" '+%m-%d %H:%M' 2>/dev/null || echo "?"; }

newest_start() { # <dir> → epoch of the newest hook .start (0 if none)
  local f m n=0
  for f in "$1"/*.start; do
    [ -e "$f" ] || continue
    case "$f" in */session.start) continue ;; esac
    m="$(mtime "$f")"; [ "$m" -gt "$n" ] && n="$m"
  done
  printf '%s' "$n"
}

# judge_live <dir> → "name<TAB>verdict" lines for the CURRENT epoch WITHOUT writing anything:
# the stored verdicts when this epoch is scanned, else a scan into a private temp file, else
# (no transcript yet) nothing — the caller falls back to the sentinels.
JUDGE_SRC=""
judge_live() {
  local d="$1" f h v tmp
  if sh_current "$d"; then
    JUDGE_SRC=transcript
    for f in "$d"/*.verdict; do
      [ -e "$f" ] || continue
      h="${f##*/}"; h="${h%.verdict}"; v="$(head -1 "$f")"
      printf '%s\t%s\n' "$h" "$v"
    done
    return 0
  fi
  tmp="$(mktemp -t cc-startup-health.XXXXXX)" || return 1
  if sh_scan "$d" > "$tmp"; then
    JUDGE_SRC=transcript
    cp "$tmp" "$tmp.c"; sh_judge "$d" "$tmp.c"; rm -f "$tmp.c"
  else
    JUDGE_SRC=sentinels
  fi
  rm -f "$tmp"
}

# ── report ───────────────────────────────────────────────────────────────────────────────────────
report_sid() {
  local sid="$1" d f h v seen=" " n
  sh_dir "$sid" || { echo "cc-startup-health: not a session id: $sid" >&2; return 2; }
  d="$SH_D"
  [ -d "$d" ] || { echo "no startup sentinels for $sid (under $R)"; return 0; }
  echo "startup health — $sid"
  local vf verdicts; vf="$(mktemp -t cc-startup-health.XXXXXX)" || return 1
  judge_live "$d" > "$vf"; verdicts="$(cat "$vf")"; rm -f "$vf"
  echo "  source: $JUDGE_SRC$( [ "$JUDGE_SRC" = sentinels ] && printf ' (no transcript yet — states below are possible, not confirmed)')"
  for f in "$d"/*.start "$d"/*.verdict; do
    [ -e "$f" ] || continue
    h="${f##*/}"; h="${h%.*}"
    case "$h" in session|foreign-*) continue ;; esac
    case "$seen" in *" $h "*) continue ;; esac
    seen="$seen$h "
    v="$(printf '%s\n' "$verdicts" | awk -F'\t' -v h="$h" '$1 == h { print $2; exit }')"
    sh_possible "$d" "$h"; sh_lost_of "$h" "$sid"
    local rec="no .done (never finished)"
    [ "$SH_DONE" = 1 ] && rec="rc=$SH_RC elapsed=${SH_EL}s owed=${SH_OWED}B timeout=${SH_TMO}ms"
    [ -e "$d/$h.start" ] || rec="no sentinel (cancelled before it opened)"
    case "$v" in
      confirmed)    printf '  ✗ %-24s LOST — %s · recover: %s   [%s]\n' "$h" "$SH_LOST" "$SH_RECOV" "$rec" ;;
      nothing-owed) printf '  · %-24s cancelled, nothing owed   [%s]\n' "$h" "$rec" ;;
      cleared)      printf '  ✓ %-24s delivered (no cancel record)   [%s]\n' "$h" "$rec" ;;
      *) if [ -n "$SH_REASON" ]; then
           printf '  ? %-24s possible loss, unconfirmed (%s) — %s · recover: %s   [%s]\n' "$h" "$SH_REASON" "$SH_LOST" "$SH_RECOV" "$rec"
         else
           printf '  ~ %-24s no loss signal, unconfirmed   [%s]\n' "$h" "$rec"
         fi ;;
    esac
  done
  n=0
  while IFS=$'\t' read -r h v; do
    case "$h" in foreign-*) ;; *) continue ;; esac
    n=$(( n + 1 ))
    printf '  ✗ project hook cancelled — not re-run · re-run it by hand: %s\n' "${v#confirmed }"
  done <<< "$verdicts"
  if [ -s "$R/alerts/$sid" ]; then
    echo "  pending idle-pane alerts ($R/alerts/$sid):"
    sed 's/^/    /' "$R/alerts/$sid"
  fi
  if [ -s "$d/outbox.txt" ]; then
    # The dispatcher's outbox is its printed hook JSON: show both channels it carried, the operator's
    # systemMessage and the model's additionalContext.
    echo "  dispatcher outbox (the startup board it built):"
    { jq -r '(.systemMessage // empty), (.hookSpecificOutput.additionalContext // empty)' "$d/outbox.txt" 2>/dev/null \
        || cat "$d/outbox.txt"; } | sed 's/^/    /'
  fi
}

list_sessions() {
  local d sid any=0 v
  [ -d "$R" ] || { echo "no startup-health state under $R"; return 0; }
  for d in "$R"/*/; do
    d="${d%/}"; sid="${d##*/}"
    sh_dir "$sid" || continue
    v="$(judge_live "$d" | awk -F'\t' '$2 ~ /^confirmed/ { n++ } END { print n + 0 }')"
    if [ "$v" -gt 0 ]; then
      any=1; printf '%s  %s lost  (started %s)\n' "$sid" "$v" "$(fmt_t "$(newest_start "$d")")"
    fi
  done
  [ "$any" = 1 ] || echo "no confirmed startup losses under $R"
}

# ── fleet fold ───────────────────────────────────────────────────────────────────────────────────
# fold_rows → "<id><TAB><class><TAB><label><TAB><start-epoch>" for every occurrence. Classes: loss,
# deferred, and `start` (one per hook start, plus one `session` row per session: the denominators of
# the shadow drop detector, #26; render() ignores them).
#
# COST. This runs every keepwarm tick over a week of session dirs, so a settled session is folded
# ONCE: its rows are cached in "<dir>/fold.cache" and reused while no file in that dir is newer (a
# builtin -nt per file, no fork). A recompute costs one `stat` for all of a dir's .start files. Only
# a session judged from its transcript is cached; a sentinel-only one (no transcript yet) and a start
# still settling are recomputed each tick, because a transcript appearing changes nothing in the dir.
fold_rows() {
  local d sid f fresh l
  for d in "$R"/*/; do
    d="${d%/}"; sid="${d##*/}"
    sh_dir "$sid" || continue
    if [ -f "$d/fold.cache" ]; then
      fresh=1
      for f in "$d"/*; do [ "$f" -nt "$d/fold.cache" ] && { fresh=0; break; }; done
      if [ "$fresh" = 1 ]; then
        while IFS= read -r l; do printf '%s\n' "$l"; done < "$d/fold.cache"
        continue
      fi
    fi
    fold_dir "$d" "$sid"
  done
}

fold_dir() { # <dir> <sid> → that session's rows on stdout (and into its cache once judged)
  local d="$1" sid="$2" ns=0 m p name v st cls j="$R/.fold-j.$$" out="$R/.fold-o.$$" starts
  starts="$(stat -f '%m %N' "$d"/*.start 2>/dev/null)"
  while read -r m p; do
    case "$p" in */session.start|'') continue ;; esac
    [ "$m" -gt "$ns" ] && ns="$m"
  done <<< "$starts"
  [ "$ns" -gt 0 ] || return 0
  [ $(( now - ns )) -ge "$SETTLE_S" ] || return 0
  if [ "${FOLD_WRITE:-0}" = 1 ]; then
    sh_current "$d" || sh_write "$d" >/dev/null 2>&1
    sh_settle "$d" >/dev/null 2>&1   # unit 5.4: panes with no prompt too
  fi
  st_of() { # <hook> → its .start mtime, from the one stat above
    local m2 p2
    while read -r m2 p2; do [ "$p2" = "$d/$1.start" ] && { printf '%s' "$m2"; return 0; }; done <<< "$starts"
    printf '%s' "$ns"
  }
  judge_live "$d" > "$j" 2>/dev/null || { rm -f "$j"; return 0; }
  {
    printf '%s:session:%s:start\tstart\tsession\t%s\n' "$sid" "$ns" "$ns"
    while read -r m p; do
      case "$p" in */session.start|'') continue ;; esac
      name="${p##*/}"; name="${name%.start}"
      printf '%s:%s:%s:start\tstart\t%s\t%s\n' "$sid" "$name" "$m" "$name" "$m"
    done <<< "$starts"
    if [ "$JUDGE_SRC" = transcript ]; then
      while IFS=$'\t' read -r name v; do
        v="${v%% *}"
        case "$name" in
          foreign-*) [ "$v" = confirmed ] && printf '%s:%s:%s\tloss\tproject hook\t%s\n' "$sid" "$name" "$ns" "$ns" ;;
          *) st="$(st_of "$name")"
             cls=""
             case "$v" in
               confirmed) cls=loss; [ "$name" = mailbox-drain ] && cls=deferred ;;
               nothing-owed) cls=deferred ;;
             esac
             [ -n "$cls" ] && printf '%s:%s:%s\t%s\t%s\t%s\n' "$sid" "$name" "$st" "$cls" "$name" "$st" ;;
        esac
      done < "$j"
    else
      # No transcript (an idle pane never gets one): the sentinels are the only signal. A possible
      # loss there is unproven delivery, which counts as a loss (gap-G4 §3 item 4).
      while read -r m p; do
        case "$p" in */session.start|'') continue ;; esac
        name="${p##*/}"; name="${name%.start}"
        sh_possible "$d" "$name"
        [ -n "$SH_REASON" ] || continue
        cls=loss; [ "$name" = mailbox-drain ] && cls=deferred
        printf '%s:%s:%s\t%s\t%s\t%s\n' "$sid" "$name" "$m" "$cls" "$name" "$m"
      done <<< "$starts"
    fi
  } > "$out"
  cat "$out"
  # Cache only a transcript-judged session with nothing left to settle.
  if [ "${FOLD_WRITE:-0}" = 1 ] && [ "$JUDGE_SRC" = transcript ] && ! ls "$d"/proof.* >/dev/null 2>&1; then
    mv -f "$out" "$d/fold.cache" 2>/dev/null
  fi
  rm -f "$j" "$out"
}

# ── load-banded startup span guard (README §2 row #25, A7 R5/A7-7) ───────────────────────────────
# The span of a start is the dispatcher's own total_ms from its per-child ledger (a harness-term row
# counts at the second it was cancelled), binned by the 1-minute load sampled at or before it (within
# 15 min) from the capacity log. A load band whose 24 h p90 is over the target (10.1 s, the post-0056
# goal in A7 §1) with n ≥ 5 puts ONE line on the accounts board; otherwise nothing, so a healthy fleet
# adds no line. Recomputed at most hourly (span.stamp), because it reads a day of load samples.
SPAN_TARGET_MS="${CC_STARTUP_SPAN_TARGET_MS:-10100}"
SPAN_MIN_N="${CC_STARTUP_SPAN_MIN_N:-5}"
SPAN_EVERY_S="${CC_STARTUP_SPAN_EVERY_S:-3600}"
SSD_LEDGER="${CC_SSD_LEDGER:-$HOME/.claude/logs/session-start-dispatch.jsonl}"
CAP_LOG="${CC_CAPACITY_LOG:-$HOME/.claude/logs/capacity-alarm.jsonl}"

span_table() { # <window-s> → "band<TAB>n<TAB>p50_ms<TAB>p90_ms" per load band seen
  local since=$(( now - $1 )) cap="$R/.span-cap.$$" led="$R/.span-led.$$"
  [ -f "$SSD_LEDGER" ] || return 0
  tail -n "${CC_STARTUP_SPAN_CAP_LINES:-12000}" "$CAP_LOG" 2>/dev/null \
    | jq -c --argjson s "$(( since - 900 ))" 'select(.load_1m != null) | {t: (.ts | fromdateiso8601? // 0), l: .load_1m} | select(.t >= $s)' \
      > "$cap" 2>/dev/null
  jq -c --argjson s "$since" '
      select((.kind == null and .total_ms != null) or .kind == "harness-term")
      | {t: (.ts | fromdateiso8601? // 0), ms: (.total_ms // ((.at_s // 0) * 1000))} | select(.t >= $s)' \
    "$SSD_LEDGER" > "$led" 2>/dev/null
  jq -rn --slurpfile cap "$cap" --slurpfile led "$led" '
    def band: if . == null then "unknown" elif . < 50 then "0-50" elif . < 150 then "50-150"
              elif . < 300 then "150-300" else "300+" end;
    def pct($p): sort as $a | $a[(($a | length) - 1) * $p | floor];
    ($cap | sort_by(.t)) as $c
    | [ $led[] | . as $r
        | ([$c[] | select(.t <= $r.t and .t >= $r.t - 900)] | last | .l?) as $l
        | {b: ($l | band), ms: $r.ms} ]
    | group_by(.b)[] | [.[0].b, length, (map(.ms) | pct(0.5)), (map(.ms) | pct(0.9))] | @tsv' 2>/dev/null
  rm -f "$cap" "$led"
}

span_guard() { # → rewrites $R/span-line.txt (empty when every band is inside the target)
  local t="$R/.span-line.$$" b n p50 p90 worst=0 line=""
  if [ -f "$R/span.stamp" ] && [ $(( now - $(mtime "$R/span.stamp") )) -lt "$SPAN_EVERY_S" ]; then return 0; fi
  while IFS=$'\t' read -r b n p50 p90; do
    case "$n$p90" in ''|*[!0-9]*) continue ;; esac
    [ "$b" = unknown ] && continue
    [ "$n" -ge "$SPAN_MIN_N" ] && [ "$p90" -gt "$SPAN_TARGET_MS" ] && [ "$p90" -gt "$worst" ] || continue
    worst="$p90"
    line="⚠ startup span p90 $(( p90 / 1000 )).$(( p90 % 1000 / 100 )) s at load $b over 24 h (n $n; target $(( SPAN_TARGET_MS / 1000 )).$(( SPAN_TARGET_MS % 1000 / 100 )) s) · cc-startup-health --span"
  done < <(span_table 86400)
  printf '%s' "${line:+$line
}" > "$t" && mv -f "$t" "$R/span-line.txt"
  : > "$R/span.stamp"
}

span_report() {
  local w b n p50 p90
  for w in 86400 604800; do
    [ "$w" = 86400 ] && echo "startup span by load band, last 24 h (target p90 $(( SPAN_TARGET_MS / 1000 )).$(( SPAN_TARGET_MS % 1000 / 100 )) s):" \
                     || echo "last 7 d:"
    printf '  %-9s %6s %8s %8s\n' load n p50 p90
    while IFS=$'\t' read -r b n p50 p90; do
      printf '  %-9s %6s %7ss %7ss\n' "$b" "$n" "$(( p50 / 1000 )).$(( p50 % 1000 / 100 ))" "$(( p90 / 1000 )).$(( p90 % 1000 / 100 ))"
    done < <(span_table "$w")
  done
  echo "  source: $SSD_LEDGER (total_ms) joined to $CAP_LOG (load_1m within 15 min)"
}

# ── fleet drop detector, SHADOW mode (README §2 row #26; A5 §4.4 as amended by A5-F9) ─────────────
# Over the same fold rows, per hook label, losses only (deferrals render nothing unless their retry
# fails), unacked occurrences only. A label trips on any of:
#   floor     an absolute per-hook floor: >= DETECT_FLOOR losses in the last 6 h. The amendment's
#             point: a relative rule alone lets a sustained load-era rate become its own baseline.
#   relative  6 h loss share >= 2x its 7 d share, and >= 5 %, with n >= 20 starts in the 6 h.
#   new       a label with a loss in the last 6 h and none before it in the 7 d kept.
# A trip PERSISTS until every occurrence that raised it is acknowledged (cc-startup-health --ack):
# clearing must match the occurrence, never a window rolling past it (README §6). SHADOW: trips and
# clears are only logged to DETECT_LOG — nothing is paged and the board never shows them — until a
# shadow period has shown the rules quiet at baseline. State: $R/detector.state.
DETECT_LOG="${CC_STARTUP_DETECT_LOG:-$HOME/.claude/logs/startup-health-detector.jsonl}"
DETECT_FLOOR="${CC_STARTUP_DETECT_FLOOR:-3}"

detect_trips() { # <rows-file> → "rule<TAB>label<TAB>l6<TAB>n6<TAB>l7<TAB>n7<TAB>ids" per trip now
  awk -F'\t' -v now="$now" -v ackf="$R/fleet-ack.txt" -v floor="$DETECT_FLOOR" '
    BEGIN { while ((getline l < ackf) > 0) acked[l] = 1 }
    $2 == "start" { s7[$3]++; if (now - $4 <= 21600) s6[$3]++; next }
    $2 != "loss"  { next }
    { lab = $3; if (now - $4 > 21600) prior[lab] = 1 }
    ($1 in acked) { next }
    { l7[lab]++; if (now - $4 <= 21600) { l6[lab]++; ids[lab] = ids[lab] (ids[lab] == "" ? "" : ",") $1 } }
    END {
      for (lab in l6) {
        den = (lab == "project hook") ? "session" : lab
        n6 = s6[den] + 0; n7 = s7[den] + 0
        sh6 = (n6 > 0) ? l6[lab] / n6 : 0; sh7 = (n7 > 0) ? l7[lab] / n7 : 0
        row = lab "\t" l6[lab] "\t" n6 "\t" l7[lab] "\t" n7 "\t" ids[lab]
        if (l6[lab] >= floor) print "floor\t" row
        if (n6 >= 20 && sh6 >= 0.05 && sh6 >= 2 * sh7) print "relative\t" row
        if (!(lab in prior)) print "new\t" row
      }
    }' "$1"
}

detect_shadow() { # <rows-file> — fold the trips into $R/detector.state and log every change
  local st="$R/detector.state" new="$R/.detector.$$" ts rule lab l6 n6 l7 n7 ids keep id
  ts="$(date -u +%FT%TZ)"
  : > "$new"
  # 1. Every held trip stays until each of its occurrences is acked; then it clears (logged).
  if [ -f "$st" ]; then
    while IFS=$'\t' read -r rule lab ids; do
      [ -n "$rule" ] || continue
      keep=0
      for id in ${ids//,/ }; do grep -qxF -- "$id" "$R/fleet-ack.txt" 2>/dev/null || { keep=1; break; }; done
      if [ "$keep" = 1 ]; then printf '%s\t%s\t%s\n' "$rule" "$lab" "$ids" >> "$new"
      else jq -nc --arg ts "$ts" --arg r "$rule" --arg h "$lab" \
             '{ts:$ts, event:"clear", rule:$r, hook:$h, cleared_by:"ack", shadow:true}' >> "$DETECT_LOG" 2>/dev/null
      fi
    done < "$st"
  fi
  # 2. A trip not already held is raised (logged once).
  while IFS=$'\t' read -r rule lab l6 n6 l7 n7 ids; do
    [ -n "$rule" ] || continue
    awk -F'\t' -v r="$rule" -v h="$lab" '$1 == r && $2 == h { f = 1 } END { exit !f }' "$new" && continue
    printf '%s\t%s\t%s\n' "$rule" "$lab" "$ids" >> "$new"
    mkdir -p "${DETECT_LOG%/*}" 2>/dev/null
    jq -nc --arg ts "$ts" --arg r "$rule" --arg h "$lab" --argjson l6 "$l6" --argjson n6 "$n6" \
      --argjson l7 "$l7" --argjson n7 "$n7" --arg ids "$ids" \
      '{ts:$ts, event:"trip", rule:$r, hook:$h, losses_6h:$l6, starts_6h:$n6, losses_7d:$l7, starts_7d:$n7,
        occurrences:($ids | split(",")), shadow:true}' >> "$DETECT_LOG" 2>/dev/null
  done < <(detect_trips "$1")
  mv -f "$new" "$st"
}

detector_report() {
  echo "startup drop detector — SHADOW mode (logs only; nothing is paged or shown on the board)"
  if [ -s "$R/detector.state" ]; then
    echo "  held trips (each clears when every occurrence that raised it is acked):"
    awk -F'\t' '{ n = split($3, a, ","); printf "    %-9s %-24s %d occurrence(s)\n", $1, $2, n }' "$R/detector.state"
  else
    echo "  no trip held"
  fi
  [ -s "$DETECT_LOG" ] && { echo "  last log rows ($DETECT_LOG):"; tail -n 5 "$DETECT_LOG" | sed 's/^/    /'; }
  return 0
}

fold_lock() {
  mkdir "$R/.fold.lock" 2>/dev/null && { printf '%s\n' "$$" > "$R/.fold.lock/pid"; return 0; }
  local p=""; read -r p < "$R/.fold.lock/pid" 2>/dev/null
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then return 1; fi
  rm -f "$R/.fold.lock/pid"; rmdir "$R/.fold.lock" 2>/dev/null
  mkdir "$R/.fold.lock" 2>/dev/null && { printf '%s\n' "$$" > "$R/.fold.lock/pid"; return 0; }
  return 1
}
fold_unlock() { rm -f "$R/.fold.lock/pid"; rmdir "$R/.fold.lock" 2>/dev/null; }

# render <rows-file> → the board line (empty when there is no unacked loss)
render() {
  local rows="$1" ack="$R/fleet-ack.txt" at="never"
  [ -f "$ack" ] && at="$(fmt_t "$(mtime "$ack")")"
  awk -F'\t' -v now="$now" -v at="$at" -v ackf="$ack" '
    BEGIN { while ((getline l < ackf) > 0) acked[l] = 1 }
    ($1 in acked) { next }
    $2 == "loss"     { L++; lc[$3]++; if (!o || $4 < o) o = $4; if (!($3 in lseen)) { lseen[$3] = 1; lord[++ln] = $3 } }
    $2 == "deferred" { D++; dc[$3]++; if (!($3 in dseen)) { dseen[$3] = 1; dord[++dn] = $3 } }
    END {
      if (!L) exit
      a = now - o
      age = (a < 3600) ? int(a / 60) "m" : (a < 172800) ? int(a / 3600) "h" : int(a / 86400) "d"
      s = "⚠ startup losses since ack " at " (oldest " age "): " L " —"
      for (i = 1; i <= ln; i++) s = s (i > 1 ? "," : "") " " lord[i] " " lc[lord[i]]
      if (D) { s = s " · deferred:"; for (i = 1; i <= dn; i++) s = s (i > 1 ? "," : "") " " dord[i] " " dc[dord[i]] }
      print s " · cc-startup-health --ack"
    }' "$rows"
}

fleet() { # [--ack]
  local rows tmp
  # No state dir ⇒ no sentinel was ever written on this box: nothing to fold, and creating one here
  # would put files under a HOME that never ran a hook (the keepwarm suites diff theirs).
  [ -d "$R" ] || return 0
  fold_lock || { echo "cc-startup-health: another fold is running" >&2; return 0; }
  trap 'fold_unlock' EXIT
  # Retention first, so a week-old session never re-enters the count.
  find "$R" -mindepth 1 -maxdepth 1 -type d ! -name alerts ! -name '.*' -mtime +"$KEEP_DAYS" \
    -exec rm -rf {} + 2>/dev/null
  # An idle-pane alert file outlives nothing: drop any whose session dir is gone.
  for tmp in "$R"/alerts/*; do
    [ -f "$tmp" ] && [ ! -d "$R/${tmp##*/}" ] && rm -f "$tmp"
  done
  rows="$R/.fold-rows.$$"
  FOLD_WRITE=1 fold_rows > "$rows"
  if [ "${1:-}" = --ack ]; then
    local before=0 added
    [ -f "$R/fleet-ack.txt" ] && before="$(wc -l < "$R/fleet-ack.txt" | tr -d ' ')"
    : >> "$R/fleet-ack.txt"
    awk -F'\t' '$2 != "start" { print $1 }' "$rows" | grep -vxFf "$R/fleet-ack.txt" > "$R/.fleet-new.$$"
    cat "$R/.fleet-new.$$" >> "$R/fleet-ack.txt"; rm -f "$R/.fleet-new.$$"
    added=$(( $(wc -l < "$R/fleet-ack.txt" | tr -d ' ') - before ))
    echo "acknowledged $added occurrence(s); a later one raises the line again"
  fi
  # Drop acks whose session is gone (retention), so the ack file stays bounded.
  if [ -f "$R/fleet-ack.txt" ]; then
    tmp="$R/.fleet-ack.$$"
    while IFS= read -r a; do [ -d "$R/${a%%:*}" ] && printf '%s\n' "$a"; done < "$R/fleet-ack.txt" > "$tmp"
    mv -f "$tmp" "$R/fleet-ack.txt"
  fi
  tmp="$R/.fleet-line.$$"
  render "$rows" > "$tmp" && mv -f "$tmp" "$R/fleet-line.txt"
  span_guard 2>/dev/null
  detect_shadow "$rows" 2>/dev/null
  : > "$R/fleet.stamp"
  rm -f "$rows" "$tmp"
  [ "${1:-}" = --ack ] || [ ! -s "$R/fleet-line.txt" ] || cat "$R/fleet-line.txt"
  return 0
}

case "${1:-}" in
  --fleet) fleet ;;
  --ack)   fleet --ack ;;
  --span)  span_report ;;
  --detector) detector_report ;;
  -h|--help) sed -n '2,26p' "$_self" | sed 's/^# \{0,1\}//' ;;
  "")      list_sessions ;;
  -*)      echo "cc-startup-health: unknown flag $1 (see --help)" >&2; exit 2 ;;
  *)       report_sid "$1" ;;
esac
