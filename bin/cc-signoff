#!/usr/bin/env python3
"""cc-signoff — the ONLY path from `awaiting-signoff` to `signed`, and the only way to sign a
research program's frame, certificate or built implementation, buy its extra round set, reopen
it, or veto a default.
Operator only.

The operator's ruling, verbatim: "deeming completion for these items ie. bottle service,
floor plan HAS TO BE HUMAN SIGNED OFF. you do not have the awareness YET to have that call."

So this command exists to be UNRUNNABLE BY AN AGENT, and to make a signature a claim about
BYTES rather than about a name.

THREE ARMS, and the third is the honest one. They live in scripts/lib/operator_sign.py, which
this file, bin/cc-mission and the research kit (scripts/research-kit/) all share:

  ARM 1 — ANCESTRY.  Walk our own parent chain (absolute /bin/ps); refuse if any ancestor is a
  claude process.  Verified live from inside a Bash tool call: pid -> /bin/zsh -> ppid ->
  .../node_modules/.bin/claude at depth 1 -> REFUSE.  The operator's own shell walks
  zsh -> kitty with no claude in it -> ALLOW.

  ARM 2 — CONTENT PIN.  A mission signature records `git rev-parse origin/main:<path>` for every
  artifact path; `cc-mission render` recomputes them and one changed byte re-opens the row.  A
  research signature records the git blob id of the frame or certificate it covers; one changed
  byte makes it STALE, and the gate stops honouring it.

  ARM 3 — THE READER IS THE AUDITOR.  We run as the operator's uid, so a determined process
  can bypass arms 1 and 2; claiming otherwise would be false, and a false claim here is
  worse than the gap.  What is achievable is that a forgery ADVERTISES ITSELF: every record
  stores the ancestry chain that wrote it, and any record showing a claude ancestor, or no
  chain at all, is read as VOID by every consumer — the mission board renders it by name, and
  the research gate refuses to count it.

DELIBERATELY NOT USED: a `[ -t 0 ]` TTY gate.  It was measured and REFUTED as a
human/agent discriminator in both directions — git hands pre-commit hooks /dev/null on
stdin (so the operator's own `git commit` is byte-identical to an agent), and `pty.spawn`
hands an agent a tty.
"""

from __future__ import annotations

import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts" / "lib"))
import operator_sign  # noqa: E402

HOME = Path.home()
STORE = HOME / ".claude" / "autonomy" / "customer"
ROWS = STORE / "rows"
JOURNAL = STORE / "signoff.jsonl"
CC_MISSION = HOME / ".claude" / "bin" / "cc-mission"

USAGE = """usage: cc-signoff <row-id> --evidence <live-url|sha> [--note <text>]
       cc-signoff research:<slug>/frame --evidence <what you read>
       cc-signoff research:<slug>/cert  --evidence <what you read>
       cc-signoff research:<slug>/extra-round --because "<why>"
       cc-signoff research:<slug>/reopen      --because "<why>"
       cc-signoff research:<slug>/veto/<decision-id> --because "<why>"
       cc-signoff research:<slug>/extend-decision/<decision-id> --because "<why>"
       cc-signoff research:<slug>/implementation --evidence <what you read>
       cc-signoff research:<slug>/third-read/<set>.<stratum> --because "<why>"
       run this in YOUR OWN terminal; an agent cannot."""


def sign_research(rid: str, evidence: str | None, because: str | None) -> int:
    try:
        rec = operator_sign.sign_research(rid, evidence=evidence, because=because)
    except operator_sign.Refused as e:
        print(str(e), file=sys.stderr)
        return e.code
    except Exception as e:  # a registry or records problem: refuse, never half-sign
        print(f"REFUSED — {e}", file=sys.stderr)
        return 2
    print(f"SIGNED {rid}")
    for path, pin in sorted(rec["pins"].items()):
        print(f"  pinned {path} = {pin} — one changed byte voids this signature")
    if rec["action"] == "implementation":
        # the registry has one writer, gate.sh; hand it the move so this stays one command
        gate = Path(__file__).resolve().parents[1] / "scripts" / "research-kit" / "gate.sh"
        out = subprocess.run(("/bin/bash", str(gate), "built-signed", "--program", rec["program"]),
                             capture_output=True, text=True)
        print("  " + (out.stdout + out.stderr).strip().replace("\n", "\n  "))
        if out.returncode != 0:
            print(f"  the signature is recorded; the registry did not move. Re-run: {gate} "
                  f"built-signed --program {rec['program']}")
    return 0


def sign_mission(rid: str, evidence: str | None, note: str | None) -> int:
    chain = operator_sign.ancestry()
    claude_anc = operator_sign.claude_ancestor(chain)

    f = ROWS / f"{rid}.json"
    if not f.exists():
        print(f"no such row: {rid}\ntry: cc-mission list", file=sys.stderr)
        return 2
    row = json.loads(f.read_text())

    if claude_anc:
        # ARM 1. Refuse, and say exactly which ancestor convicted us.
        print("REFUSED — cc-signoff is descended from a claude process "
              f"({claude_anc['comm']} at depth {claude_anc['depth']}).\n"
              "A floor plan or bottle menu is signed off by the operator, in his own\n"
              "terminal, after looking at it. An agent may only advance a row to\n"
              "'awaiting-signoff'.\n\n"
              f"  Operator, to sign this:  cc-signoff {rid} --evidence <the URL you opened>",
              file=sys.stderr)
        return 3

    if not evidence:
        print("REFUSED — --evidence is required: the live URL you actually opened, or a\n"
              "sha of what you looked at. A signature with no referent is a claim about\n"
              "nothing.", file=sys.stderr)
        return 2

    if row.get("state") != "awaiting-signoff":
        print(f"REFUSED — row is '{row.get('state')}', not 'awaiting-signoff'. Nothing has\n"
              "been published for your eyes yet.", file=sys.stderr)
        return 2

    # ARM 2 — pin the bytes.
    repo = row.get("repo", "")
    pins = {}
    for p in row.get("paths") or []:
        out = subprocess.run(("git", "-C", repo, "rev-parse", f"origin/main:{p}"),
                             capture_output=True, text=True)
        if out.returncode != 0:
            print(f"REFUSED — cannot pin '{p}' on origin/main. Fetch first, or the row's\n"
                  "paths are wrong; signing an unpinnable artifact would be a signature\n"
                  "over nothing.", file=sys.stderr)
            return 2
        pins[p] = out.stdout.strip()

    now = time.time()
    row["state"] = "signed"
    row["signoff"] = {
        "at": now,
        "at_human": time.strftime("%Y-%m-%d %H:%M", time.localtime(now)),
        "evidence": evidence,
        "note": note,
        "pins": pins,
        "provenance": {"claude_ancestor": False,
                       "chain": [c["comm"] for c in chain]},
    }
    tmp = f.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(row, indent=2) + "\n")
    tmp.replace(f)

    JOURNAL.parent.mkdir(parents=True, exist_ok=True)
    with JOURNAL.open("a") as fh:
        fh.write(json.dumps({"id": rid, "at": now, "evidence": evidence,
                             "pins": pins,
                             "chain": [c["comm"] for c in chain]}) + "\n")

    subprocess.run((str(CC_MISSION), "render"), capture_output=True)
    print(f"SIGNED {rid}\n  pinned {len(pins)} artifact blob(s) — if any of them changes,\n"
          "  the row re-opens on the board and says so.")
    return 0


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(USAGE)
        return 0

    rid = sys.argv[1]
    args = sys.argv[2:]
    evidence = note = because = None
    i = 0
    while i < len(args):
        if args[i] == "--evidence" and i + 1 < len(args):
            evidence, i = args[i + 1], i + 2
        elif args[i] == "--note" and i + 1 < len(args):
            note, i = args[i + 1], i + 2
        elif args[i] == "--because" and i + 1 < len(args):
            because, i = args[i + 1], i + 2
        else:
            print(f"unknown option: {args[i]}", file=sys.stderr)
            return 2

    if rid.startswith("research:"):
        return sign_research(rid, evidence, because)
    return sign_mission(rid, evidence, note)


if __name__ == "__main__":
    sys.exit(main())
