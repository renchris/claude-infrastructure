#!/bin/bash
# cc-wave-plan — QUOTA-AWARE WAVE PLACEMENT (T-P7-6): a wave of work-items → a concrete placement plan
# {account, model, effort, fire_line} per item, OR a STOP on a quota cliff. This is the WAVE layer the
# dispatcher (cc-dispatch) calls; per-slot model/effort routing already lives in `cc-route` — this tool
# LEVERAGES cc-route for that and layers wave spread (spread-aware least-loaded placement + ≤N/account cap)
# and the pre-emptive Fable-window STRADDLE guard on top. It NEVER fires anything (fire_line is a template).
#
#   cc-wave-plan --items <json> [--json]     <json> = JSON array of {id:string, slot:string}
#                                            slot ∈ lead | judgment-dense | transcription | adversarial
#                                            (--items - reads the array from stdin)
#   cc-wave-plan selftest
#
# PLACEMENT: SPREAD-AWARE least-loaded round-robin (NOT greedy best-first — that reconcentrated every wave
#   onto the top-ranked account: operator-observed 2026-07-19). `--rank general` gives the healthy set +
#   tie-break order; each account is pre-loaded with its LIVE session count (`--json .rows[].k`); every item
#   goes to the least-loaded account (live + placed-this-wave), so a wave round-robins across the set AND an
#   account already carrying sessions from prior waves is de-prioritized. ≤ CC_WAVE_MAX_PER_ACCT (default 2)
#   items/account/wave is retained as the cliff bound — no account under that cap anywhere = cliff.
#
# URGENCY (W2-B, the DEMAND half of M7): the flat cap above is urgency-BLIND — it allowances an account
#   whose weekly quota strands in <24h exactly like one with six idle days, so a wave cannot concentrate
#   where quota is about to be lost. EXACTLY ONE account per plan — the TOP-RANKED account that is BEHIND
#   (its `weekly_need_pct_per_day` exceeds its measured `burn_wk_ppd`) — is capped at
#   min(CC_WAVE_MAX_PER_ACCT_URGENT, KMAX − k_eff) instead, floor 0; every other account keeps the flat
#   cap. A row missing EITHER field carries no urgency claim (a missing measurement is not urgency) and
#   an unreadable KMAX means no bound, so both degrade to flat — the widening is never unbounded and
#   never inferred. It is also never SILENT: the applied allowance renders on stdout (text) or stderr
#   (--json) and lands in the IDL detail, because a widening nobody can see is the alarm-polarity defect.
#
# LIVE SOURCES (never hardcoded — memory: frontier-window-ssot-discipline):
#   · `claude-accounts --rank general` → ranked "name score" lines (best first) — healthy set + tie-break.
#   · `claude-accounts --json`         → .window.deadline (straddle guard) + .rows[].k (live session counts,
#                                        the per-account load seed for spread-aware placement).
#   · `cc-route <slot> --json`         → per-slot {model, lead_effort, reason}; already SSOT-parses model
#                                        ids + owns the frontier-window (route='none') + quota-cliff edges.
#
# 🚨 THE EDGES (RED-proven in selftest):
#   · FABLE-WINDOW STRADDLE — a frontier slot (judgment-dense|adversarial) whose Fable window is within
#     CC_WAVE_FABLE_GUARD_MIN (default 30) minutes of close, OR route='none', degrades to an EXPLICIT
#     reason-carrying Opus fallback. The fable model id NEVER appears in a straddle plan.
#   · WALL — no plan, and the verdict is TRICHOTOMOUS + EVIDENCED (AUTONOMY_DISPATCH_V2 §3 S3/S4,
#     §5 F4/F5/F6/F8). One undifferentiated `exit 4 / quota-cliff` used to collapse three structurally
#     different states, two of which are FALSE cliffs aiming the operator at the wrong problem:
#       4 capped   the oracle ANSWERED and every account it knows is at its quota limit → /limit-recover
#       5 auth     the oracle ANSWERED, ≥1 account needs an auth action, NONE healthy   → /relogin
#       6 unknown  the oracle timed out / exited non-zero / emitted nothing usable      → retry next pass
#     `unknown` is the ABSENCE of a verdict, not a wall: never a cliff, never a page. (4 also covers
#     `capacity` — a wave larger than per-wave placement capacity — which is wave sizing, NOT a quota
#     wall; it keeps exit 4 for the cc-dispatch contract but is a distinct verdict in the journal so
#     the A4 read below cannot mistake it for a cliff. Memory: dispatch-false-cliff-wave-sizing.)
#     Every wall writes ONE IDL record carrying machine-readable `evidence` {oracle_rc, ranked_n,
#     accounts:[{acct,state,k,…}], raw_excerpt, timeout_bin}. Without it "zero false cliffs" (§7 A4)
#     is not measurable at all — an unevidenced verdict IS the defect (F6), not a cosmetic gap.
#   · BOUNDED ORACLE — every claude-accounts / cc-route call runs under absolute-path timeout(1)
#     (CC_WAVE_ORACLE_TIMEOUT_S, default 20). rc 124 ⇒ `unknown`, NEVER `capped` (S4's load-bearing
#     mapping: a hang reported as "everything is capped" is the exact bug being removed).
#
# Exit: 0 = plan emitted · 2 = usage (bad/empty args) · 3 = config/parse-fail (LOUD, never a silent
#       default) · 4 = capped | capacity · 5 = auth · 6 = unknown. One IDL record per invocation.
# Env (tests): CC_WAVE_ACCOUNTS_BIN, CC_WAVE_ROUTE_BIN, CC_WAVE_MAX_PER_ACCT, CC_WAVE_FABLE_GUARD_MIN,
#       CC_WAVE_IDL, CC_WAVE_ORACLE_TIMEOUT_S, CC_WAVE_TIMEOUT_BIN (set-but-empty ⇒ force "absent"),
#       CC_WAVE_VERDICT_LANE (v1 ⇒ the pre-v2 path verbatim: one exit 4, no evidence, no bound),
#       CC_WAVE_MAX_PER_ACCT_URGENT (≤ CC_WAVE_MAX_PER_ACCT ⇒ urgency off, byte-identical plans),
#       CLAUDE_ACCOUNTS_JSON (the SSOT accounts.json the router's KMAX is read from — the SAME env
#       override claude-accounts itself honours, so a test pins ONE file for both sides).
set -uo pipefail

ACCOUNTS_BIN_DEFAULT="claude-accounts"
ROUTE_BIN_DEFAULT="cc-route"
MAX_PER_ACCT="${CC_WAVE_MAX_PER_ACCT:-2}"
# W2-B — the URGENT per-account allowance (the demand half of M7). The flat cap above is
# urgency-BLIND: it hands an account whose weekly quota strands in <24h exactly the same 2 slots
# as one with six idle days. ONE account per wave — the top-ranked account whose weekly NEED
# outruns its measured recent BURN — may take up to this many, bounded by KMAX − its live charge.
# KILL SWITCH: set this at or below CC_WAVE_MAX_PER_ACCT and the urgency path is never evaluated
# at all (not even read) — plans are byte-identical to the flat lane.
URGENT_PER_ACCT="${CC_WAVE_MAX_PER_ACCT_URGENT:-4}"
GUARD_MIN="${CC_WAVE_FABLE_GUARD_MIN:-30}"
# Per-item worktree root. Only ever composed into the fire_line TEMPLATE — this script creates
# nothing (cc-dispatch, the actuator, provisions the path warm before it fires).
WTROOT="${CC_WAVE_WTROOT:-$HOME/Development/.worktrees}"
IDL="${CC_WAVE_IDL:-$HOME/.claude/autonomy/idl.jsonl}"
# S3/S4 kill switch (§6): v1 restores the pre-v2 wall behaviour VERBATIM — one undifferentiated
# exit 4, no evidence blob, no timeout wrapping — so this change is reversible by env, never by a
# revert. Everything new below is gated on it.
VERDICT_LANE="${CC_WAVE_VERDICT_LANE:-v2}"
ORACLE_TIMEOUT_S="${CC_WAVE_ORACLE_TIMEOUT_S:-20}"

usage()       { sed -n '2,52p' "$0" | sed 's/^# \{0,1\}//'; }
die()         { echo "cc-wave-plan: $*" >&2; exit 2; }                       # usage
fail_config() { idl failed "config: $*"; echo "cc-wave-plan: REFUSING — $* (config/parse-fail; never a silent default)." >&2; exit 3; }
# cliff_v1 — the pre-v2 wall, kept BYTE-IDENTICAL as the kill-switch target. Never call it directly;
# go through cliff()/wall_* so lane v2 gets a verdict and lane v1 gets exactly this.
cliff_v1()    { idl failed "quota-cliff: $*"; echo "cc-wave-plan: ⛔ QUOTA CLIFF — $*. STOP: run /limit-recover (disk-truth audit, re-run or transplant). No plan emitted." >&2; exit 4; }

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ── S4: the bounded oracle ────────────────────────────────────────────────────────────────────────
# ABSOLUTE paths only, resolved ONCE. This file is reached from a launchd job whose PATH is
# /usr/bin:/bin, so `command -v timeout` resolves differently there than in a login shell; and
# Homebrew's coreutils ships the GNU binary as `timeout` or `gtimeout` depending on install flavour,
# so probing both is what makes the bound actually apply on this box rather than silently not.
# When NOTHING is found the calls run UNWRAPPED and every verdict records timeout_bin:"absent" —
# the bound is never silently skipped, because a skipped bound that nobody can see is F8 again.
TIMEOUT_BIN=""
resolve_timeout_bin() {
  local p
  if [ -n "${CC_WAVE_TIMEOUT_BIN+set}" ]; then       # set-but-empty ⇒ force the "absent" path (tests)
    if [ -n "${CC_WAVE_TIMEOUT_BIN}" ] && [ -x "${CC_WAVE_TIMEOUT_BIN}" ]; then TIMEOUT_BIN="$CC_WAVE_TIMEOUT_BIN"; fi
    return 0
  fi
  for p in /usr/bin/timeout /opt/homebrew/bin/timeout /usr/local/bin/timeout \
           /opt/homebrew/bin/gtimeout /usr/local/bin/gtimeout; do
    if [ -x "$p" ]; then TIMEOUT_BIN="$p"; return 0; fi
  done
  return 0
}
resolve_timeout_bin

# Oracle stderr sink. Created in the PARENT and only ever APPENDED to, because run_oracle is called
# inside $( ) — a subshell, whose global assignments are lost (the same trap place_item documents).
# Without this an `unknown` verdict would carry an empty excerpt exactly when the oracle's own
# diagnostic is the entire value of the record.
ORACLE_ERRF=""
oracle_errf() {
  [ -n "$ORACLE_ERRF" ] && return 0
  ORACLE_ERRF="$(mktemp "${TMPDIR:-/tmp}/cc-wave-oracle.XXXXXX" 2>/dev/null)" || ORACLE_ERRF=""
  [ -n "$ORACLE_ERRF" ]
}
cleanup_oracle() { [ -n "${ORACLE_ERRF:-}" ] && rm -f "$ORACLE_ERRF"; return 0; }
trap cleanup_oracle EXIT
oracle_stderr()  { { [ -n "$ORACLE_ERRF" ] && [ -s "$ORACLE_ERRF" ] && cat "$ORACLE_ERRF" 2>/dev/null; }; return 0; }

# run_oracle <bin> <args…> — THE single external-call chokepoint (§7 A8: zero unwrapped
# claude-accounts / cc-route call sites). stdout passes through VERBATIM so every existing parse is
# byte-identical; stderr is teed to the evidence sink; the call is bounded. Returns the callee's rc
# (124 = timeout(1) expiry). Lane v1 runs unwrapped, as it did before.
run_oracle() {
  local bin="$1"; shift
  if [ "$VERDICT_LANE" = v1 ] || [ -z "$TIMEOUT_BIN" ]; then
    if [ -n "$ORACLE_ERRF" ]; then "$bin" "$@" 2>>"$ORACLE_ERRF"; else "$bin" "$@" 2>/dev/null; fi
  else
    if [ -n "$ORACLE_ERRF" ]; then "$TIMEOUT_BIN" "$ORACLE_TIMEOUT_S" "$bin" "$@" 2>>"$ORACLE_ERRF"
    else "$TIMEOUT_BIN" "$ORACLE_TIMEOUT_S" "$bin" "$@" 2>/dev/null; fi
  fi
}

# excerpt <text> — one bounded, single-line excerpt for the evidence blob. An IDL record is one
# line; a raw oracle dump would break that and a full dump is not evidence, it is noise.
excerpt() { printf '%s' "${1:-}" | tr '\n\t\r' '   ' | cut -c1-200; }

# TSV field-collapse guard — docs/research/TSV_FIELD_COLLAPSE_2026-07-25.md. Tab is IFS-*whitespace*,
# so `IFS=$'\t' read` collapses a RUN of tabs and ANY empty cell shifts every later field LEFT. The
# item read below is guarded upstream by the `jq -e 'all(...)'` schema check (non-empty id + enum
# slot), so this padding is belt-not-brace TODAY — it is here so the guarantee lives at the emitter
# next to the read rather than 20 lines away in a validation that a later edit could relax.
CELL='def cell(ph): (if . == null then "" else . end) | tostring
      | gsub("[\\t\\r\\n]"; " ") | if . == "" then ph else . end; '

# IDL (one record per invocation): action ∈ fired|passed|abstained|failed.
idl() { # <action> <detail>
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -cn --arg ts "$(now_iso)" --arg actor "cc-wave-plan" --arg action "$1" --arg detail "$2" \
     '{ts:$ts, actor:$actor, action:$action, detail:$detail}' >> "$IDL" 2>/dev/null || true
}

accounts_bin() {
  if [ -n "${CC_WAVE_ACCOUNTS_BIN:-}" ]; then echo "$CC_WAVE_ACCOUNTS_BIN"
  elif command -v "$ACCOUNTS_BIN_DEFAULT" >/dev/null 2>&1; then command -v "$ACCOUNTS_BIN_DEFAULT"
  elif [ -x "$HOME/bin/$ACCOUNTS_BIN_DEFAULT" ]; then echo "$HOME/bin/$ACCOUNTS_BIN_DEFAULT"
  else echo ""; fi
}
route_bin() {
  if [ -n "${CC_WAVE_ROUTE_BIN:-}" ]; then echo "$CC_WAVE_ROUTE_BIN"
  elif command -v "$ROUTE_BIN_DEFAULT" >/dev/null 2>&1; then command -v "$ROUTE_BIN_DEFAULT"
  elif [ -x "$HOME/.claude/bin/$ROUTE_BIN_DEFAULT" ]; then echo "$HOME/.claude/bin/$ROUTE_BIN_DEFAULT"
  else echo ""; fi
}

# ── the account oracle, read ONCE per invocation ──────────────────────────────────────────────────
# `claude-accounts --json` feeds THREE consumers here (the straddle guard's window, the live-load
# seed, and the wall verdict's per-account state). It used to be invoked once per consumer and
# unbounded; one bounded call is strictly less hang surface (F8) and guarantees all three reason
# about the SAME snapshot. Prime it from the PARENT (load_acct_json inside a $( ) would memoize
# into a subshell and be lost).
ACCT_JSON=""; ACCT_JSON_RC=0; ACCT_JSON_TRIED=0
load_acct_json() {
  [ "$ACCT_JSON_TRIED" -eq 1 ] && { [ -n "$ACCT_JSON" ]; return $?; }
  ACCT_JSON_TRIED=1
  local bin; bin="$(accounts_bin)"; [ -n "$bin" ] || { ACCT_JSON_RC=127; return 1; }
  ACCT_JSON="$(run_oracle "$bin" --json)"; ACCT_JSON_RC=$?
  [ "$ACCT_JSON_RC" -eq 0 ] && [ -n "$ACCT_JSON" ]
}

# ── S3: trichotomous, EVIDENCED wall verdicts ─────────────────────────────────────────────────────
# evidence.oracle_rc is the FAILURE rc — the rc of the call that stopped the oracle from
# answering, and 0 whenever it DID answer. §7 A4 reads exactly that ("0 records where verdict==
# capped and the oracle rc was non-zero"): a capped verdict built on a broken oracle is a false
# cliff by definition. The producer's own no-candidate codes (2 = policy refused, 3 = data
# unavailable) are answers, not failures, so they are carried separately as evidence.rank_rc.
EV_ORACLE_RC=0; EV_ROUTE_RC=0; EV_ACCOUNTS="[]"; RANK_RAW=""; RANK_RC=0
build_evidence_accounts() {
  [ -n "$ACCT_JSON" ] || return 0
  local a
  # `state` REPORTS the raw SSOT auth string; the booleans are what we DECIDE on (see wall_no_headroom).
  # session_pct/weekly_pct are carried because A4's read — "no account healthy" — is about QUOTA
  # headroom, and an auth-healthy account sitting at 12% is exactly the false cliff A4 must catch.
  a="$(printf '%s' "$ACCT_JSON" | jq -c '[ .rows[]? | {acct:.acct, state:.auth, k:(.k // 0),
        actionable:.auth_actionable, login_fixable:.login_fixable,
        session_pct:.session_pct, weekly_pct:.weekly_pct} ]' 2>/dev/null)" || return 0
  [ -n "$a" ] && EV_ACCOUNTS="$a"
  return 0
}

# wall_emit <verdict> <exit-code> <operator-action> <reason> <human-message>
# ONE evidence-carrying IDL record + one stderr line, then exit. The record's top-level `action` is
# the IDL vocabulary token "wall"; the OPERATOR's action lives at evidence.action, which is what §7
# A6 reads ("routes to /relogin in its action field").
wall_emit() {
  local verdict="$1" code="$2" action="$3" reason="$4" msg="$5" tb
  tb="${TIMEOUT_BIN:-}"; [ -n "$tb" ] || tb="absent"
  build_evidence_accounts
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -cn --arg ts "$(now_iso)" --arg actor "cc-wave-plan" --arg verdict "$verdict" \
         --arg act "$action" --arg reason "$reason" --arg detail "$msg" --arg tb "$tb" \
         --arg raw "$(excerpt "$RANK_RAW")" --arg err "$(excerpt "$(oracle_stderr)")" \
         --argjson rc "$EV_ORACLE_RC" --argjson rrc "$RANK_RC" --argjson orc "$EV_ROUTE_RC" \
         --argjson rn "${#RANKED[@]}" --argjson accts "$EV_ACCOUNTS" \
     '{ts:$ts, actor:$actor, action:"wall", verdict:$verdict, detail:$detail,
       evidence:{oracle_rc:$rc, rank_rc:$rrc, route_rc:$orc, ranked_n:$rn, accounts:$accts,
                 raw_excerpt:$raw, stderr_excerpt:$err, timeout_bin:$tb,
                 reason:$reason, action:$act}}' \
     >> "$IDL" 2>/dev/null || true
  case "$verdict" in
    unknown)  echo "cc-wave-plan: ⚠️  WALL[unknown] — $msg. NOT a wall and NOT a page: the oracle gave no answer. Retry next pass. No plan emitted." >&2 ;;
    auth)     echo "cc-wave-plan: ⛔ WALL[auth] — $msg. STOP: run /relogin. This is an AUTH wall, not a quota wall." >&2 ;;
    capacity) echo "cc-wave-plan: ⛔ WALL[capacity] — $msg. STOP: plan a smaller wave — the accounts have headroom, this is wave sizing. No plan emitted." >&2 ;;
    *)        echo "cc-wave-plan: ⛔ WALL[capped] — $msg. STOP: run /limit-recover (disk-truth audit, re-run or transplant). No plan emitted." >&2 ;;
  esac
  exit "$code"
}
wall_capped()   { wall_emit capped   4 /limit-recover   "$1" "$2"; }
wall_capacity() { wall_emit capacity 4 reduce-wave-size "$1" "$2"; }
wall_auth()     { wall_emit auth     5 /relogin         "$1" "$2"; }
wall_unknown()  { wall_emit unknown  6 retry-next-pass  "$1" "$2"; }

# cliff <reason> <human-message> — the non-rank walls: a cc-route-reported quota cliff, and a wave
# exceeding per-wave placement capacity. Lane v1 keeps the single undifferentiated exit-4 message.
cliff() {
  [ "$VERDICT_LANE" = v1 ] && cliff_v1 "$2"
  case "$1" in
    wave-overflow) wall_capacity "$1" "$2" ;;
    *)             wall_capped   "$1" "$2" ;;
  esac
}

# route_guard <rc> <what> — the ONE place a cc-route return code becomes a verdict.
#   124  → unknown  (the bound expired: never a config-fail, and NEVER a cliff — S4)
#     4  → capped   (cc-route's own quota-cliff signal, propagated with evidence)
#  else  → config-fail (LOUD, never a silent default)
route_guard() {
  local rc="$1" what="$2"
  [ "$rc" -eq 0 ] && return 0
  EV_ROUTE_RC="$rc"
  if [ "$rc" -eq 124 ] && [ "$VERDICT_LANE" != v1 ]; then
    EV_ORACLE_RC="$rc"
    wall_unknown oracle-timeout "cc-route ($what) exceeded the ${ORACLE_TIMEOUT_S}s bound"
  fi
  # rc 4 is cc-route's ANSWER — "general route none, every account capped" (bin/cc-route:29,264,
  # itself derived from claude-accounts' policy-refused rc 2) — not a failure of the oracle. So
  # evidence.oracle_rc stays 0 and A4's read is not tripped by a genuine cliff; the raw code is
  # carried as evidence.route_rc instead.
  [ "$rc" -eq 4 ] && cliff route-cliff "cc-route reports a quota cliff ($what)"
  EV_ORACLE_RC="$rc"
  fail_config "cc-route failed (rc=$rc) for $what"
}

# iso_to_epoch <iso> → seconds (UTC assumed; tz offset stripped). BSD + GNU date.
iso_to_epoch() {
  local s="${1:0:19}"   # YYYY-MM-DDTHH:MM:SS (drops any +00:00 / Z suffix)
  date -u -j -f "%Y-%m-%dT%H:%M:%S" "$s" +%s 2>/dev/null \
    || date -u -d "$s" +%s 2>/dev/null
}

# window_mins_to_close → integer minutes until the Fable window closes; empty when unknown (→ no pre-empt,
# cc-route's live route still governs). active:false = closed = 0.
window_mins_to_close() {
  local j active deadline dl now
  j="$ACCT_JSON"                                  # the ONE bounded snapshot (primed by cmd_plan)
  [ -n "$j" ] || return 1
  active="$(printf '%s' "$j" | jq -r '.window.active // empty' 2>/dev/null)"
  [ "$active" = "false" ] && { echo 0; return 0; }
  deadline="$(printf '%s' "$j" | jq -r '.window.deadline // empty' 2>/dev/null)"
  [ -n "$deadline" ] || return 1
  dl="$(iso_to_epoch "$deadline")"; [ -n "$dl" ] || return 1
  now="$(date -u +%s)"
  echo $(( (dl - now) / 60 ))
}

# ── ranked-account placement (bash-3.2 safe: parallel indexed arrays, NO associative arrays) ──────────
# SPREAD-AWARE, not greedy best-first: three parallel arrays index the healthy set — RANKED[i] (name,
# best-first), RLOAD[i] (its CURRENT live session count, the cross-wave load seed) and RCOUNTS[i] (items
# placed on it THIS wave). Each item lands on the account minimising RLOAD+RCOUNTS, so a wave round-robins
# across the set AND an account already loaded from prior waves is de-prioritised — the fix for the
# greedy-fill concentration bug where one top-ranked account absorbed every wave (operator, 2026-07-19).
RANKED=(); RCOUNTS=(); RLOAD=(); RCAP=()
RANK_NONE=0; RANK_BAD=0
load_ranks() {
  local bin line name score
  bin="$(accounts_bin)"; [ -n "$bin" ] || fail_config "claude-accounts unavailable (cannot rank accounts)"
  # Captured (not piped from a process substitution) because the rc and the RAW text are both
  # EVIDENCE now: an empty ranked set means nothing until you know whether the oracle answered.
  RANK_RAW="$(run_oracle "$bin" --rank general)"; RANK_RC=$?
  # PARSE BY SHAPE, against the producer's literal contract: `--rank` emits
  # `f"{acct} {score:.6f}"` per routable account (claude-accounts:1699), and when NOTHING is
  # routable it prints the sentinel `none` on stdout and exits 2 (policy refused) or 3 (data
  # unavailable) — claude-accounts:1678-1685. It does NOT return empty stdout.
  # Accepting any non-blank text as an account name (`${line%% *}`, unconditional) therefore turned
  # that sentinel — and an HTML error page, and a stray warning — into a PHANTOM ACCOUNT that the
  # wave was then placed on and fired at (`--account none`). The no-headroom branch below was
  # correspondingly unreachable against the real CLI. Shape validation is what makes S3 decidable.
  while IFS= read -r line; do
    case "$line" in ''|[[:space:]]*) continue ;; esac              # blank / indented: not a rank line
    name="${line%% *}"
    [ "$name" = none ] && { RANK_NONE=1; continue; }               # the CLI's no-candidate sentinel
    case "$line" in *' '*) score="${line#* }" ;; *) RANK_BAD=1; continue ;; esac
    case "$score" in ''|*[!0-9.]*) RANK_BAD=1; continue ;; esac    # field 2 must be the numeric score
    RANKED+=("$name"); RCOUNTS+=(0); RLOAD+=(0); RCAP+=("$MAX_PER_ACCT")
  done <<EOF
$RANK_RAW
EOF
  [ "${#RANKED[@]}" -gt 0 ] || wall_no_headroom
}

# wall_no_headroom — the ranked set came back EMPTY. Which of the three states is that?
#
# F4/F5: the incumbent answer was "always a quota cliff", so a hung oracle and a fleet of
# logged-out accounts both paged `/limit-recover`. `--rank general` empties identically on quota
# exhaustion, on auth loss, and on the oracle failing to answer at all — the emptiness itself
# carries no information. The state is decided from the SSOT's OWN per-row verdicts
# (claude-accounts:717-723 emits auth_actionable/login_fixable precisely so consumers stop
# re-deriving from a hand-copied auth-state list, which had already drifted once). So we DECIDE on
# those booleans and only REPORT the raw `auth` string; a row carrying NEITHER boolean is
# state-unknown and counts toward neither side — never re-derived from a vocabulary copied here.
wall_no_headroom() {
  [ "$VERDICT_LANE" = v1 ] && cliff_v1 "no account has general headroom (rank empty)"
  local tsv rows_n healthy_n actionable_n fixable_n

  # (1) THE ORACLE DID NOT ANSWER ⇒ `unknown`. rc 124 is timeout(1)'s expiry: the single most
  # important mapping in S4 — a hang must never be reported as "every account is capped".
  EV_ORACLE_RC="$RANK_RC"
  [ "$RANK_RC" -eq 124 ] && wall_unknown oracle-timeout \
      "claude-accounts --rank general exceeded the ${ORACLE_TIMEOUT_S}s bound"
  # rc 2 and rc 3 are the producer's OWN no-candidate codes, not failures: 2 = "data was fine and
  # policy refused", 3 = "data unavailable, callers may degrade to a proxy" (claude-accounts:836-838).
  # Both print the `none` sentinel. They are ANSWERS and are classified at (3) from per-account
  # state; any OTHER non-zero is the oracle failing to answer at all.
  case "$RANK_RC" in
    0|2|3) : ;;
    *) wall_unknown oracle-rc "claude-accounts --rank general exited rc=$RANK_RC" ;;
  esac

  # (2) Text came back that carried neither a valid `<acct> <score>` line nor the `none` sentinel ⇒
  # we could not parse the answer. Unparseable is the absence of a verdict, not a wall.
  if [ "$RANK_BAD" -eq 1 ] && [ "$RANK_NONE" -eq 0 ]; then
    wall_unknown oracle-unparseable \
      "claude-accounts --rank general answered but no '<acct> <score>' line parsed"
  fi

  # (3) The oracle ANSWERED "nothing is routable" — so the rc is not a failure rc, and
  # evidence.oracle_rc (which §7 A4 reads as "was this verdict built on a broken oracle?") is 0.
  # The producer's raw code is kept alongside it as rank_rc; nothing is lost.
  EV_ORACLE_RC=0
  # WHICH wall this is depends on per-account state.
  if ! load_acct_json; then
    EV_ORACLE_RC="$ACCT_JSON_RC"
    [ "$ACCT_JSON_RC" -eq 124 ] && wall_unknown oracle-timeout \
        "claude-accounts --json exceeded the ${ORACLE_TIMEOUT_S}s bound (no per-account state)"
    wall_unknown accounts-json-unavailable \
        "claude-accounts --json unavailable or empty (rc=$ACCT_JSON_RC) — no per-account state to verdict on"
  fi
  # Every field below is a jq `length` ⇒ always a non-empty integer, so no empty cell can shift a
  # later field left (the TSV field-collapse trap this file guards against at the item read).
  tsv="$(printf '%s' "$ACCT_JSON" | jq -r '[ ([.rows[]?]|length),
        ([.rows[]? | select(.auth_actionable == false)]|length),
        ([.rows[]? | select(.auth_actionable == true)]|length),
        ([.rows[]? | select(.login_fixable == true)]|length) ] | @tsv' 2>/dev/null)" || tsv=""
  [ -n "$tsv" ] || wall_unknown accounts-json-unparseable \
      "claude-accounts --json did not parse (no per-account state to verdict on)"
  IFS=$'\t' read -r rows_n healthy_n actionable_n fixable_n <<EOF
$tsv
EOF
  case "${rows_n:-}"       in ''|*[!0-9]*) rows_n=0 ;;       esac
  case "${healthy_n:-}"    in ''|*[!0-9]*) healthy_n=0 ;;    esac
  case "${actionable_n:-}" in ''|*[!0-9]*) actionable_n=0 ;; esac
  case "${fixable_n:-}"    in ''|*[!0-9]*) fixable_n=0 ;;    esac

  # (3a) AUTH wall (F5): something needs an operator auth action and NOTHING is healthy. The action
  # is /relogin — telling the operator to run /limit-recover here sends them at the wrong problem,
  # and no amount of waiting for a quota reset fixes a logged-out account.
  if [ "$actionable_n" -ge 1 ] && [ "$healthy_n" -eq 0 ]; then
    wall_auth auth-wall \
      "$actionable_n of $rows_n account(s) need an auth action ($fixable_n /relogin-fixable), none healthy"
  fi
  # (3b) rc 3 = the producer's own "we could not SEE the data — degrade to a proxy". With no auth
  # wall to explain it, that is an `unknown`: reporting "everything is at its limit" on the strength
  # of data we could not read is the false cliff this design exists to remove. (Ordered AFTER the
  # auth check on purpose: an all-logged-out fleet exits 3 too, because a logged-out row carries an
  # `error` and reason_class maps that to "data" — and its verdict is auth, not unknown.)
  [ "$RANK_RC" -eq 3 ] && wall_unknown rank-data-unavailable \
      "claude-accounts --rank general reports data unavailable (rc=3) — no account state explains it"
  # (3c) Accounts exist, none is auth-walled, and the producer refused by POLICY ⇒ the honest
  # reading is that every one of them is at its quota limit. Rows carrying no state field land here
  # too, by design: "accounts present, no state info" is `capped`, not a guess at auth.
  [ "$rows_n" -ge 1 ] && wall_capped rank-empty \
      "no account has general headroom — $rows_n account(s) known, all at limit"
  # (3d) The oracle answered and knows about NO account at all. That is not evidence of a quota
  # wall; it is the absence of evidence, and calling it a cliff is exactly the F6 defect.
  wall_unknown accounts-empty \
      "claude-accounts --json reports no accounts — no evidence of a quota wall"
}
# load_live_counts → seed RLOAD[i] with RANKED[i]'s live session count from `claude-accounts --json`
# (.rows[].k). Best-effort: an unavailable/unparseable --json leaves the seeds at 0 and placement degrades
# to pure round-robin (still spreads within a wave, just without the cross-wave penalty) — consistent with
# window_mins_to_close, which likewise treats an absent --json as "unknown, no pre-empt". Never fail-loud
# here: round-robin is a principled fallback, not a silent-wrong default.
load_live_counts() {
  local j kv i name k
  j="$ACCT_JSON"                                  # the ONE bounded snapshot (primed by cmd_plan)
  [ -n "$j" ] || return 0
  kv="$(printf '%s' "$j" | jq -r '.rows[]? | [.acct, (.k // 0)] | @tsv' 2>/dev/null)" || return 0
  [ -n "$kv" ] || return 0
  for i in "${!RANKED[@]}"; do
    name="${RANKED[$i]}"
    k="$(printf '%s\n' "$kv" | awk -F'\t' -v n="$name" '$1==n{print $2; exit}')"
    case "$k" in ''|*[!0-9]*) k=0 ;; esac      # absent / non-integer → 0 (never a bad arithmetic seed)
    RLOAD[i]="$k"
  done
}
# ── W2-B: the URGENT per-account allowance ────────────────────────────────────────────────────────
# ssot_kmax → the router's KMAX from the SSOT accounts.json, or empty. Read from the SAME file the
# producer reads and via the SAME env override (CLAUDE_ACCOUNTS_JSON, claude-accounts:127) so the two
# sides can never disagree about which file is authoritative — and so a test pins ONE path for both.
# KMAX is deliberately NOT taken from `--json`: that payload does not carry it (only s_cut rides at
# top level, claude-accounts:2756-2760), and inventing a fallback constant here is exactly the
# "hardcoding 85 in prose that silently diverges" failure that comment exists to prevent.
ssot_kmax() {
  local f k
  f="${CLAUDE_ACCOUNTS_JSON:-$HOME/.claude/accounts.json}"
  [ -r "$f" ] || return 1
  k="$(jq -r '.router.KMAX // empty' "$f" 2>/dev/null)" || return 1
  case "${k:-}" in ''|*[!0-9]*) return 1 ;; esac      # absent / non-integer ⇒ NO bound ⇒ no urgency
  echo "$k"
}

# apply_urgency → raises RCAP for AT MOST ONE account: the top-ranked BEHIND one. Everything about
# this is fail-soft toward the flat cap, because every degradation direction here is a WIDENING and a
# widening taken on absent data is a widening taken on a guess:
#   · knob at/below the flat cap  ⇒ never evaluated (the kill switch — not even the SSOT is read)
#   · no --json snapshot / no KMAX ⇒ flat (the bound is what keeps the allowance honest)
#   · a row missing EITHER pace field ⇒ that account makes NO urgency claim. "Missing measurement"
#     and "not behind" must reach the same place; treating absence as urgency is how a silent
#     widening would ship on the day the utilization series thins out.
# BEHIND is the producer's own predicate (measured < needed, claude-accounts:1396) — re-derived here
# only because --json emits the two terms and not the verdict; no threshold is invented.
# k_eff mirrors claude-accounts:1219-1221 for the same reason: k_work when the sweep could measure
# it, else the pane census (absence degrades to the STRICTER count, never to zero), plus phantoms.
URG_ACCT=""; URG_NEED=""; URG_BURN=""; URG_KEFF=""; URG_KMAX=""; URG_CAP=""
apply_urgency() {
  [ "$URGENT_PER_ACCT" -gt "$MAX_PER_ACCT" ] || return 0        # kill switch: unset/equal ⇒ flat lane
  [ "${#RANKED[@]}" -gt 0 ] || return 0
  [ -n "$ACCT_JSON" ] || return 0
  local kmax tsv acct need burn keff head cap i
  kmax="$(ssot_kmax)" || return 0
  # ONE jq pass, in RANK ORDER: the ranked names go in as data, so "top-ranked BEHIND" is decided
  # where the numbers are (need/burn are floats — bash cannot compare them) rather than by a shell
  # loop that would have to shell out per account anyway.
  tsv="$(printf '%s' "$ACCT_JSON" | jq -r --arg ranked "${RANKED[*]}" '
      . as $j
      | ($ranked | split(" ") | map(select(. != ""))) as $order
      | [ $order[]
          | . as $a
          | (($j.rows // []) | map(select(.acct == $a)) | first)
          | select(. != null)
          | select((.weekly_need_pct_per_day | type) == "number")
          | select((.burn_wk_ppd            | type) == "number")
          | select(.weekly_need_pct_per_day > .burn_wk_ppd)
          | [ .acct,
              (.weekly_need_pct_per_day * 10 | round / 10 | tostring),
              (.burn_wk_ppd             * 10 | round / 10 | tostring),
              ( ( if (.k_work | type) == "number" then .k_work else (.k // 0) end )
                + (.k_phantom // 0) | tostring ) ]
        ] | first | select(. != null) | @tsv' 2>/dev/null)" || return 0
  [ -n "$tsv" ] || return 0
  IFS=$'\t' read -r acct need burn keff <<EOF
$tsv
EOF
  case "${keff:-}" in ''|*[!0-9]*) return 0 ;; esac
  head=$(( kmax - keff ))                                       # what the concurrency ceiling leaves
  cap="$URGENT_PER_ACCT"; [ "$head" -lt "$cap" ] && cap="$head"
  [ "$cap" -lt 0 ] && cap=0                                     # a FULL account gets nothing, urgent or not
  for i in "${!RANKED[@]}"; do
    [ "${RANKED[$i]}" = "$acct" ] || continue
    RCAP[i]="$cap"
    URG_ACCT="$acct"; URG_NEED="$need"; URG_BURN="$burn"; URG_KEFF="$keff"; URG_KMAX="$kmax"; URG_CAP="$cap"
    return 0
  done
  return 0
}

# urgency_line → the one-line disclosure, or empty. A widening that renders nowhere is indistinguishable
# from no widening at all — the whole point of the alarm being POSITIVE here (memory: alarm-polarity).
urgency_line() {
  [ -n "$URG_ACCT" ] || return 1
  printf 'urgency: %s is BEHIND (needs %s%%/d, recent %s%%/d) → allowance %s this wave (flat %s; KMAX %s − live %s)' \
    "$URG_ACCT" "$URG_NEED" "$URG_BURN" "$URG_CAP" "$MAX_PER_ACCT" "$URG_KMAX" "$URG_KEFF"
}

# wave_capacity → Σ per-account caps. The capacity wall's message used to multiply the flat cap by the
# account count; with one account possibly carrying a different cap that product is no longer the
# capacity, and a wall that misstates the bound it enforced is unactionable.
wave_capacity() {
  local i t=0
  for i in "${!RCAP[@]}"; do t=$(( t + RCAP[i] )); done
  echo "$t"
}

# place_item → sets PLACED_ACCT to the LEAST-LOADED ranked account with per-wave headroom (RLOAD+RCOUNTS
# minimal, RCOUNTS < its cap), rank breaking ties: RANKED is best-first and the strict `<` keeps the earliest
# account at the running minimum. rc=1 when every account is at the per-wave cap (→ cliff). MUST set a
# global (not echo) — a command-substitution caller runs in a subshell and would lose the RCOUNTS bump.
# The cap is PER ACCOUNT (RCAP[i]) since W2-B, not the one flat MAX_PER_ACCT — placement ORDER is
# untouched by that: the urgent account is still chosen by least-load, it just stops being skipped sooner.
PLACED_ACCT=""
place_item() {
  local i eff best_i=-1 best_load=""
  for i in "${!RANKED[@]}"; do
    [ "${RCOUNTS[$i]}" -lt "${RCAP[$i]}" ] || continue        # skip accounts already at their per-wave cap
    eff=$(( RLOAD[i] + RCOUNTS[i] ))
    if [ -z "$best_load" ] || [ "$eff" -lt "$best_load" ]; then best_load="$eff"; best_i="$i"; fi
  done
  [ "$best_i" -ge 0 ] || return 1
  RCOUNTS[best_i]=$(( RCOUNTS[best_i] + 1 )); PLACED_ACCT="${RANKED[$best_i]}"; return 0
}

# ── per-slot model/effort resolution (memoized per distinct slot; STRADDLE decided once per invocation) ──
LEAD_MODEL=""; STRADDLE=0; STRADDLE_MINS=""
route_call() { RJ_OUT="$(run_oracle "$(route_bin)" "$@")"; return $?; }   # sets RJ_OUT, returns cc-route rc (bounded)

resolve_lead_model() { # SSOT lead_default via cc-route (never hardcode a model id)
  [ -n "$LEAD_MODEL" ] && return 0
  [ -n "$(route_bin)" ] || fail_config "cc-route unavailable (cannot resolve model/effort)"
  route_call lead --json; local rc=$?
  route_guard "$rc" "lead route"
  LEAD_MODEL="$(printf '%s' "$RJ_OUT" | jq -r '.model // empty' 2>/dev/null)"
  [ -n "$LEAD_MODEL" ] || fail_config "cc-route returned no model for the lead slot"
}

R_MODEL=""; R_EFF=""; R_REASON=""; R_FALLBACK=0
resolve_slot() { # <slot> → sets R_MODEL R_EFF R_REASON R_FALLBACK
  local slot="$1"
  case "$slot" in
    lead|transcription)
      [ -n "$(route_bin)" ] || fail_config "cc-route unavailable (cannot resolve model/effort)"
      route_call "$slot" --json; local rc=$?
      route_guard "$rc" "slot $slot"
      R_MODEL="$(printf '%s' "$RJ_OUT" | jq -r '.model // empty')"
      R_EFF="$(printf '%s' "$RJ_OUT" | jq -r '.lead_effort // empty')"
      R_REASON="$(printf '%s' "$RJ_OUT" | jq -r '.reason // empty')"
      R_FALLBACK=0
      ;;
    judgment-dense|adversarial)
      resolve_lead_model
      if [ "$STRADDLE" -eq 1 ]; then
        # STRADDLE guard: pre-empt the fable id entirely — explicit reason-carrying Opus fallback.
        R_MODEL="$LEAD_MODEL"
        [ "$slot" = adversarial ] && R_EFF=xhigh || R_EFF=max
        R_REASON="fable window ${STRADDLE_MINS}m to close < guard ${GUARD_MIN}m → Opus straddle fallback"
        R_FALLBACK=1
      else
        route_call "$slot" --json; local rc=$?
        route_guard "$rc" "slot $slot"
        R_MODEL="$(printf '%s' "$RJ_OUT" | jq -r '.model // empty')"
        R_EFF="$(printf '%s' "$RJ_OUT" | jq -r '.lead_effort // empty')"
        R_REASON="$(printf '%s' "$RJ_OUT" | jq -r '.reason // empty')"
        # cc-route fell back on its own (window route='none') iff a frontier slot resolved to lead_default.
        [ "$R_MODEL" = "$LEAD_MODEL" ] && R_FALLBACK=1 || R_FALLBACK=0
      fi
      ;;
    *) fail_config "invalid slot '$slot' (lead | judgment-dense | transcription | adversarial)" ;;
  esac
  [ -n "$R_MODEL" ] && [ -n "$R_EFF" ] || fail_config "empty model/effort resolving slot $slot"
}

# slot→resolution memo (parallel arrays; ≤4 distinct slots).
SKEYS=(); SMODEL=(); SEFF=(); SREASON=(); SFB=()
memo_slot() { # <slot> — resolve once, cache
  local i
  for i in "${!SKEYS[@]}"; do [ "${SKEYS[$i]}" = "$1" ] && return 0; done
  resolve_slot "$1"
  SKEYS+=("$1"); SMODEL+=("$R_MODEL"); SEFF+=("$R_EFF"); SREASON+=("$R_REASON"); SFB+=("$R_FALLBACK")
}
memo_get() { # <slot> — sets R_MODEL R_EFF R_REASON R_FALLBACK from cache
  local i
  for i in "${!SKEYS[@]}"; do
    if [ "${SKEYS[$i]}" = "$1" ]; then
      R_MODEL="${SMODEL[$i]}"; R_EFF="${SEFF[$i]}"; R_REASON="${SREASON[$i]}"; R_FALLBACK="${SFB[$i]}"; return 0
    fi
  done
  return 1
}

cmd_plan() {
  local items="$1" as_json="$2"
  # Parse + validate the items array (fail-loud, never a silent default).
  printf '%s' "$items" | jq -e 'type=="array"' >/dev/null 2>&1 || fail_config "--items is not a JSON array"
  local n; n="$(printf '%s' "$items" | jq 'length' 2>/dev/null)" || fail_config "--items is unparseable JSON"
  [ "$n" -gt 0 ] || die "--items is an empty array (nothing to place)"
  printf '%s' "$items" | jq -e 'all(.[]; (.id|type=="string") and (.id|length>0)
      and (.slot=="lead" or .slot=="judgment-dense" or .slot=="transcription" or .slot=="adversarial"))' \
    >/dev/null 2>&1 || fail_config "every item needs a non-empty string id and a valid slot"

  # Read items in order into parallel arrays.
  local ids=() slots=() line id slot
  while IFS=$'\t' read -r id slot; do ids+=("$id"); slots+=("$slot"); done \
    < <(printf '%s' "$items" | jq -r "$CELL"'.[] | [(.id | cell("?")), (.slot | cell("?"))] | @tsv')

  # Prime the ONE bounded account snapshot in the PARENT, before anything reads it. Every consumer
  # below (straddle window, live-load seed, wall evidence) shares it; a failure here is NOT fatal —
  # only the wall path turns an unavailable snapshot into a verdict.
  oracle_errf || true
  load_acct_json || true

  # Rank accounts FIRST, before any cc-route call. The account wall is the cheapest and most
  # authoritative wall signal, and it is the only one that can produce the full trichotomy. Ranking
  # after the straddle block (as this used to) meant a FRONTIER wave hit `resolve_lead_model` first,
  # so an all-logged-out fleet surfaced as cc-route's config-fail (exit 3) instead of the auth
  # verdict — the S3 states were unreachable for exactly the wave shapes that use them most. Ranking
  # first also means a genuine wall costs zero cc-route calls.
  load_ranks
  load_live_counts
  apply_urgency          # W2-B: at most ONE account's cap is raised, from the same snapshot

  # Decide the Fable STRADDLE once (window state is uniform across the wave).
  local has_frontier=0 i
  for slot in "${slots[@]}"; do case "$slot" in judgment-dense|adversarial) has_frontier=1;; esac; done
  if [ "$has_frontier" -eq 1 ]; then
    resolve_lead_model
    local mins; mins="$(window_mins_to_close)"
    if [ -n "$mins" ] && [ "$mins" -lt "$GUARD_MIN" ]; then STRADDLE=1; STRADDLE_MINS="$mins"; fi
  fi

  # Spread-place every item (all-or-nothing: any overflow walls, never a partial plan).
  local accts=()
  for i in "${!ids[@]}"; do
    place_item || cliff wave-overflow "wave of $n items exceeds capacity (${#RANKED[@]} accounts, $(wave_capacity) slot(s) total$([ -n "$URG_ACCT" ] && echo " incl. ${URG_ACCT}'s urgent ${URG_CAP}") — all capped)"
    accts+=("$PLACED_ACCT")
  done

  # Resolve model/effort per distinct slot.
  for slot in "${slots[@]}"; do memo_slot "$slot"; done

  # Build the plan; track whether any frontier slot degraded (→ abstained), and account fan-out.
  local objs=() any_fb=0 fire model eff
  local seen_accts=""
  # SURFACE is now UNCONDITIONAL --split-right (2026-07-30). History, because both halves matter:
  #   2026-07-25 (drain incident): a hardcoded --split-right killed EVERY headless spawn — under
  #     launchd $ITERM_SESSION_ID never exists and handoff-fire REFUSED the anchorless split. 0
  #     `fired` IDL records ever, 408 `failed` in one day. The fix was to emit --window headlessly.
  #   2026-07-30 (this change): that fix made every dispatched session open a BRAND-NEW iTerm2
  #     WINDOW — 174 anchorless fires in one day, each its own window, which is precisely the
  #     "handoffs open a whole new window instead of a ⌘D split" the operator has reported since
  #     2026-07-03. Surface choice does not belong in the planner: handoff-fire.sh is the chokepoint
  #     and now resolves a live anchor ITSELF for anchor-free callers (resolve_headless_anchor →
  #     desk role pane → active session → any live pane), degrading to a background tab in the SAME
  #     window when that tab is already dense, and to a fresh window ONLY when iTerm2 has no live
  #     pane at all. So the planner asks for the surface the operator wants and lets the chokepoint
  #     honour it. The anchorless-refusal that caused the 2026-07-25 drain no longer fires here.
  local surface="--split-right"
  for i in "${!ids[@]}"; do
    memo_get "${slots[$i]}"; model="$R_MODEL"; eff="$R_EFF"
    [ "$R_FALLBACK" -eq 1 ] && any_fb=1
    case " $seen_accts " in *" ${accts[$i]} "*) : ;; *) seen_accts="$seen_accts ${accts[$i]}" ;; esac
    # fire_line is a copy-paste TEMPLATE, not run by this script — the literal ~ is deliberate (the
    # consuming shell expands it at fire time; cc-wave-plan NEVER fires).
    #
    # --cwd (item b87573077f11), never --worktree. Workers used to fire co-cwd with the desk in the
    # SHARED checkout, so a wave of them fought over one git index and land-conflicted (rebase exit
    # 5). Each item now gets its OWN worktree path. It is `--cwd <path>` and not `--worktree <br>`
    # deliberately: handoff-fire's --worktree branch provisions COLD (scripts/worktree-pool.sh, its
    # only warm path, does not exist — so POOL_ELIGIBLE is always 0), and a cold worktree fire races
    # CC boot for the auto-submit keystroke — the session never engages, 0 commits, looks fired
    # (memory cold-worktree-fire-autosubmit-race). cc-dispatch, the ACTUATOR, creates this path warm
    # before firing; cc-wave-plan stays a pure planner and emits only the path.
    # shellcheck disable=SC2088
    fire="~/.claude/scripts/handoff-fire.sh --prompt-file /tmp/fire-${ids[$i]}.txt --cwd ${WTROOT}/wt-${ids[$i]} --account ${accts[$i]} --model ${model} --effort ${eff} ${surface}"
    objs+=("$(jq -cn --arg id "${ids[$i]}" --arg slot "${slots[$i]}" --arg acct "${accts[$i]}" \
        --arg model "$model" --arg eff "$eff" --arg fire "$fire" \
        '{id:$id, slot:$slot, account:$acct, model:$model, effort:$eff, fire_line:$fire}')")
  done

  local n_accts; n_accts="$(echo "$seen_accts" | wc -w | tr -d ' ')"
  # The urgent allowance rides the SAME record as the placement it changed — a widening whose only
  # trace is the plan's shape is not auditable after the fact.
  local urg_detail=""; urg_detail="$(urgency_line)" || urg_detail=""
  [ -n "$urg_detail" ] && urg_detail="; $urg_detail"
  if [ "$any_fb" -eq 1 ]; then
    idl abstained "fable-straddle-fallback: frontier items → Opus (window guard ${GUARD_MIN}m); placed $n across $n_accts accounts$urg_detail"
  else
    idl fired "placed $n items across $n_accts accounts$urg_detail"
  fi

  if [ "$as_json" -eq 1 ]; then
    # stdout is the machine plan and stays pure JSON, so the disclosure goes to stderr — it must
    # exist on BOTH surfaces, or --json becomes the lane where a widening is silent.
    [ -n "$URG_ACCT" ] && echo "cc-wave-plan: $(urgency_line)" >&2
    printf '%s\n' "${objs[@]}" | jq -s '.'
  else
    echo "cc-wave-plan: $n items placed across $n_accts account(s)$([ "$any_fb" -eq 1 ] && echo ' — Fable straddle fallback active')"
    [ -n "$URG_ACCT" ] && echo "  $(urgency_line)"
    for i in "${!ids[@]}"; do
      memo_get "${slots[$i]}"
      printf '  %-14s %-14s → %-16s @ %-5s on %s\n' "${ids[$i]}" "${slots[$i]}" "$R_MODEL" "$R_EFF" "${accts[$i]}"
    done
  fi
}

# ── selftest: every edge RED-proven against stubbed accounts + cc-route ───────────────────────────────
selftest() {
  local pass=0 fail=0 skipn=0 rc tmp SELF
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/cc-wave-plan-selftest.XXXXXX")" || die "cannot mktemp"
  # Composed, not replacing: a bare `trap … EXIT` here would silently drop the module-level
  # cleanup_oracle handler, leaking a stderr sink the moment selftest calls an oracle directly.
  trap 'cleanup_oracle; rm -rf "${tmp:-}"' EXIT
  export CC_WAVE_IDL="$tmp/idl.jsonl"
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  # accounts stub: --rank general (STUB_RANK space-list; set-but-empty = nobody has headroom) · --json
  # (window deadline = now + STUB_WIN_MIN minutes, default 600 = wide open; rows).
  #
  # FIXTURE-SHAPE PARITY with the real producer (memory: fixture-shape-parity-with-real-producer).
  # `--rank general` answers "who has HEADROOM"; `--json` answers "what accounts EXIST and what is
  # their state" — different questions, and the real claude-accounts emits a row per CONFIGURED
  # account regardless of headroom (bin/claude-accounts:694-723). The old stub defaulted rows to []
  # while --rank listed four accounts, so its universe emptied along with its headroom set and it
  # could not express "every account is capped" at all. Rows now default to the STUB_ACCTS universe
  # and carry the CLI-OWNED verdict fields (auth_actionable / login_fixable) the real producer
  # attaches to every row — the fields this tool decides on.
  #   STUB_ROWS       explicit rows JSON (wins over the generated universe)
  #   STUB_ACCTS      the configured universe for --json rows
  #   STUB_AUTH/_ACTIONABLE/_FIXABLE   uniform auth state for that universe
  #   STUB_SLEEP      sleep before answering (exercises the S4 bound)
  #   STUB_RANK_RC    --rank exits non-zero · STUB_RANK_GARBAGE  --rank answers unparseably
  #   STUB_JSON_RC    --json exits non-zero
  cat > "$tmp/accounts-stub" <<'STUB'
#!/bin/bash
[ -n "${STUB_SLEEP:-}" ] && sleep "$STUB_SLEEP"
case "${1:-}" in
  --rank)
    [ -n "${STUB_RANK_RC:-}" ] && { echo "claude-accounts: rank probe failed" >&2; exit "$STUB_RANK_RC"; }
    [ -n "${STUB_RANK_GARBAGE:-}" ] && { printf '   \n<html>rate limited</html>\n'; exit 0; }
    i=0; for n in ${STUB_RANK-next next4 next3 next2}; do printf '%s 0.%06d\n' "$n" $((900-i)); i=$((i+1)); done
    # No candidate ⇒ the producer prints the `none` SENTINEL and exits 2 (policy refused) or 3
    # (data unavailable) — claude-accounts:1678-1685. It never returns empty stdout, and the old
    # fixture's silent-empty claim is what let a phantom account through unnoticed.
    [ -z "${STUB_RANK-x}" ] && { echo none; echo "claude-accounts: no routable account for general" >&2; exit "${STUB_RANK_NONE_RC:-2}"; }
    : ;;
  --json)
    [ -n "${STUB_JSON_RC:-}" ] && { echo "claude-accounts: json probe failed" >&2; exit "$STUB_JSON_RC"; }
    m="${STUB_WIN_MIN:-600}"
    dl="$(date -u -v+"${m}"M +%Y-%m-%dT%H:%M:%S+00:00 2>/dev/null || date -u -d "+${m} minutes" +%Y-%m-%dT%H:%M:%S+00:00)"
    if [ -n "${STUB_ROWS:-}" ]; then rows="$STUB_ROWS"
    else
      rows='['; sep=''
      for n in ${STUB_ACCTS-next next4 next3 next2}; do
        rows="$rows$sep{\"acct\":\"$n\",\"k\":0,\"auth\":\"${STUB_AUTH:-ok}\""
        rows="$rows,\"auth_actionable\":${STUB_ACTIONABLE:-false},\"login_fixable\":${STUB_FIXABLE:-false}"
        rows="$rows,\"session_pct\":${STUB_SESSION_PCT:-97},\"weekly_pct\":${STUB_WEEKLY_PCT:-96}}"
        sep=','
      done
      rows="$rows]"
    fi
    printf '{"window":{"active":true,"deadline":"%s"},"rows":%s}\n' "$dl" "$rows" ;;
  *) exit 2 ;;
esac
STUB
  chmod +x "$tmp/accounts-stub"; export CC_WAVE_ACCOUNTS_BIN="$tmp/accounts-stub"

  # cc-route stub: mirrors the real slot table + edges (STUB_ROUTE_CLIFF → exit 4; STUB_FABLE_NONE → Opus).
  cat > "$tmp/route-stub" <<'STUB'
#!/bin/bash
[ -n "${STUB_ROUTE_SLEEP:-}" ] && sleep "$STUB_ROUTE_SLEEP"
[ -n "${STUB_ROUTE_CLIFF:-}" ] && { echo "cc-route: cliff" >&2; exit 4; }
slot="$1"
case "$slot" in
  lead)          model=claude-opus-4-8; eff=max;  reason="general route" ;;
  transcription) model=claude-opus-4-8; eff=high; reason="general route" ;;
  judgment-dense|adversarial)
    if [ -n "${STUB_FABLE_NONE:-}" ]; then
      model=claude-opus-4-8; reason="frontier unavailable → designed Opus fallback"
      [ "$slot" = adversarial ] && eff=xhigh || eff=max
    else model=claude-fable-5; eff=xhigh; reason="frontier window open"; fi ;;
  *) echo "unknown slot" >&2; exit 2 ;;
esac
jq -cn --arg s "$slot" --arg m "$model" --arg a stub --arg e "$eff" --arg r "$reason" \
   '{slot:$s,model:$m,account:$a,lead_effort:$e,reason:$r}'
STUB
  chmod +x "$tmp/route-stub"; export CC_WAVE_ROUTE_BIN="$tmp/route-stub"

  # SSOT fixture for the W2-B urgency bound. PINNED, not ambient: KMAX is a new input to this tool
  # and the box's real accounts.json is operator-tunable (it has already been hand-raised 4→8), so an
  # unpinned read would let a live constant decide a suite's verdict — the exact fixture-surface rule
  # M7 landed on (ACCOUNT_ROUTING_V2 §13: a new ambient input is a new fixture surface for the suites
  # that drive it).
  printf '{"router":{"KMAX":8}}\n' > "$tmp/accounts-ssot.json"
  export CLAUDE_ACCOUNTS_JSON="$tmp/accounts-ssot.json"

  check() { # <label> <want-rc> <cmd...>
    local label="$1" want="$2"; shift 2
    "$@" >/dev/null 2>&1; rc=$?
    if [ "$rc" = "$want" ]; then printf '  ok   %-62s (exit %s)\n' "$label" "$rc"; pass=$((pass+1))
    else printf '  FAIL %-62s (exit %s, wanted %s)\n' "$label" "$rc" "$want"; fail=$((fail+1)); fi
  }

  echo "cc-wave-plan selftest — every edge must RED-prove:"

  # Happy path — a mixed wave places + carries model/effort.
  check "happy: mixed wave -> exit 0" 0 \
    env "$SELF" --items '[{"id":"a","slot":"lead"},{"id":"b","slot":"transcription"}]' --json
  check "happy: lead item carries opus @ max on the best account (next)" 0 \
    bash -c "'$SELF' --items '[{\"id\":\"a\",\"slot\":\"lead\"}]' --json | jq -e '.[0]|select(.model==\"claude-opus-4-8\" and .effort==\"max\" and .account==\"next\")'"
  check "happy: fire_line references handoff-fire.sh + the id's prompt-file" 0 \
    bash -c "'$SELF' --items '[{\"id\":\"zz\",\"slot\":\"lead\"}]' --json | jq -e '.[0].fire_line|test(\"handoff-fire.sh\") and test(\"/tmp/fire-zz.txt\")'"

  # (e) b87573077f11 — each worker routes to its OWN worktree, WARM. Co-cwd firing made a wave fight
  # over the shared checkout's git index (land-conflict, rebase exit 5); `--worktree` would take
  # handoff-fire's cold path and race the auto-submit keystroke (cold-worktree-fire-autosubmit-race).
  check "worktree: fire_line routes to a per-item --cwd worktree path" 0 \
    bash -c "CC_WAVE_WTROOT=/wt '$SELF' --items '[{\"id\":\"zz\",\"slot\":\"lead\"}]' --json | jq -e '.[0].fire_line|test(\"--cwd /wt/wt-zz\")'"
  check "worktree: fire_line NEVER emits the cold --worktree flag" 0 \
    bash -c "CC_WAVE_WTROOT=/wt '$SELF' --items '[{\"id\":\"zz\",\"slot\":\"lead\"}]' --json | jq -e '.[0].fire_line|test(\"--worktree\")|not'"
  check "worktree: two items get DISTINCT worktrees (no shared index between workers)" 0 \
    bash -c "CC_WAVE_WTROOT=/wt '$SELF' --items '[{\"id\":\"a\",\"slot\":\"lead\"},{\"id\":\"b\",\"slot\":\"lead\"}]' --json | jq -e '(.[0].fire_line|test(\"--cwd /wt/wt-a\")) and (.[1].fire_line|test(\"--cwd /wt/wt-b\"))'"
  # PURE PLANNER: emitting the path must create nothing on disk.
  check "worktree: planning CREATES nothing (cc-wave-plan never actuates)" 0 \
    bash -c "CC_WAVE_WTROOT='$tmp/wtroot' '$SELF' --items '[{\"id\":\"zz\",\"slot\":\"lead\"}]' --json >/dev/null; [ ! -e '$tmp/wtroot' ]"

  # (s) SURFACE is unconditional --split-right (2026-07-30). The inverse of what this pair asserted
  # between 2026-07-25 and 2026-07-30: emitting --window headlessly cured the anchorless-refusal
  # drain but opened a brand-new iTerm2 WINDOW per dispatched session (174 in one day). The anchor
  # is resolved at the chokepoint now (handoff-fire.sh resolve_headless_anchor), so a headless plan
  # must ask for the ⌘D split like every other caller and must NEVER hardcode --window.
  # handoff-fire refuses an anchorless split, so a headless split-right plan is a 100%-dead wave
  # (0 fired ever; 408 failed/day). An anchored (interactive) plan keeps the ⌘D split default.
  check "surface: HEADLESS plan emits --split-right and NEVER --window" 0 \
    bash -c "env -u ITERM_SESSION_ID '$SELF' --items '[{\"id\":\"zz\",\"slot\":\"lead\"}]' --json | jq -e '.[0].fire_line|(test(\"--split-right\") and (test(\"--window\")|not))'"
  check "surface: anchored (ITERM_SESSION_ID set) plan keeps --split-right" 0 \
    bash -c "ITERM_SESSION_ID=w0t0p0:TEST '$SELF' --items '[{\"id\":\"zz\",\"slot\":\"lead\"}]' --json | jq -e '.[0].fire_line|test(\"--split-right\")'"

  # (b) Fable-window STRADDLE — within-guard window → Opus fallback carrying reason; NO fable id.
  check "straddle: window 10m<guard -> judgment-dense falls back to opus" 0 \
    bash -c "STUB_WIN_MIN=10 '$SELF' --items '[{\"id\":\"j\",\"slot\":\"judgment-dense\"}]' --json | jq -e '.[0]|select(.model==\"claude-opus-4-8\" and .effort==\"max\" and (.slot==\"judgment-dense\"))'"
  check "straddle: adversarial keeps xhigh on fallback (verify_judge tier)" 0 \
    bash -c "STUB_WIN_MIN=10 '$SELF' --items '[{\"id\":\"v\",\"slot\":\"adversarial\"}]' --json | jq -e '.[0]|select(.model==\"claude-opus-4-8\" and .effort==\"xhigh\")'"
  check "straddle: NO fable id anywhere in the plan" 0 \
    bash -c "STUB_WIN_MIN=10 '$SELF' --items '[{\"id\":\"j\",\"slot\":\"judgment-dense\"}]' --json 2>/dev/null | grep -vq fable"
  check "straddle: IDL records the invocation as abstained" 0 \
    bash -c "STUB_WIN_MIN=10 '$SELF' --items '[{\"id\":\"j\",\"slot\":\"judgment-dense\"}]' --json >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e 'select(.action==\"abstained\" and .actor==\"cc-wave-plan\")'"

  # Window WIDE OPEN — the fable id IS emitted (guard is not over-firing).
  check "open: window 600m -> judgment-dense keeps the fable model @ xhigh" 0 \
    bash -c "STUB_WIN_MIN=600 '$SELF' --items '[{\"id\":\"j\",\"slot\":\"judgment-dense\"}]' --json | jq -e '.[0]|select(.model==\"claude-fable-5\" and .effort==\"xhigh\")'"
  check "open: fable-none route also degrades to opus (cc-route's own edge)" 0 \
    bash -c "STUB_WIN_MIN=600 STUB_FABLE_NONE=1 '$SELF' --items '[{\"id\":\"j\",\"slot\":\"judgment-dense\"}]' --json | jq -e '.[0].model==\"claude-opus-4-8\"'"

  # (c) SPREAD-AWARE placement — round-robin within a wave + a live-session load penalty across waves.
  # Round-robin: 2 idle accounts, 2 items → one each (greedy-fill would have put BOTH on rank[0]).
  check "spread: 2 idle accts, 2 items -> one each (round-robin, not both on rank[0])" 0 \
    bash -c "STUB_RANK='acctA acctB' '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"},{\"id\":\"2\",\"slot\":\"lead\"}]' --json | jq -e '(.[0].account==\"acctA\") and (.[1].account==\"acctB\")'"
  # ≤N/account cap still bounds a wave: 3 items, MAX=2, 2 idle accts → A,B,A (round-robin; A caps at 2).
  check "spread: 3 items, MAX=2, 2 accts -> round-robin A,B,A (per-wave cap retained)" 0 \
    bash -c "STUB_RANK='acctA acctB' CC_WAVE_MAX_PER_ACCT=2 '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"},{\"id\":\"2\",\"slot\":\"lead\"},{\"id\":\"3\",\"slot\":\"lead\"}]' --json | jq -e '(.[0].account==\"acctA\") and (.[1].account==\"acctB\") and (.[2].account==\"acctA\")'"
  # Load penalty (the cross-wave fix): acctA is BEST-ranked but already carries 3 live sessions; acctB is
  # idle → the item goes to acctB. Greedy best-first piled onto acctA regardless of its live load.
  check "spread: a live-loaded best-ranked acct is de-prioritized (k=3 -> item to idle acctB)" 0 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS='[{\"acct\":\"acctA\",\"k\":3},{\"acct\":\"acctB\",\"k\":0}]' '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"}]' --json | jq -e '.[0].account==\"acctB\"'"
  # Least-loaded-first across the wave: seeds A=5,B=6,C=4 (rank A,B,C) → item1→C(4), item2→A(5) (C now 5,
  # A 5 tie → best rank A). Reproduces the operator scenario: the heaviest account (B) is left alone.
  check "spread: least-loaded-first across live seeds (A=5,B=6,C=4 -> C then A)" 0 \
    bash -c "STUB_RANK='acctA acctB acctC' STUB_ROWS='[{\"acct\":\"acctA\",\"k\":5},{\"acct\":\"acctB\",\"k\":6},{\"acct\":\"acctC\",\"k\":4}]' CC_WAVE_MAX_PER_ACCT=2 '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"},{\"id\":\"2\",\"slot\":\"lead\"}]' --json | jq -e '(.[0].account==\"acctC\") and (.[1].account==\"acctA\")'"

  # (u) W2-B — the URGENT per-account allowance (the DEMAND half of M7). Every check below is a PAIR
  # against the same wave: the only variable is whether the top-ranked account's weekly need outruns
  # its measured burn. A widening asserted only by "it placed" would also pass against a tool that
  # simply raised the flat cap for everyone, so the kill-switch and fail-soft arms are what make the
  # urgent lane distinguishable from a blanket one.
  #   acctA ranks first and is BEHIND (needs 20%/d, burning 3%/d); acctB is AHEAD (4 vs 9).
  #   With KMAX=8 and acctA's live charge at 1, its allowance is min(4, 8−1)=4 while acctB stays at 2,
  #   so a 5-item wave that flat-caps at 2×2=4 slots now fits.
  export URG_BEHIND='[{"acct":"acctA","k":1,"k_work":1,"k_phantom":0,"weekly_need_pct_per_day":20.0,"burn_wk_ppd":3.0},{"acct":"acctB","k":0,"k_work":0,"k_phantom":0,"weekly_need_pct_per_day":4.0,"burn_wk_ppd":9.0}]'
  # Same accounts, same loads, NO pace fields — the shape a thin utilization series actually produces.
  export URG_NOFIELDS='[{"acct":"acctA","k":1},{"acct":"acctB","k":0}]'
  # Same urgency claim, but acctA's live charge is 5 (k_work 4 + 1 phantom) ⇒ KMAX−k_eff = 3 binds
  # BELOW the knob's 4. Both terms of k_eff are exercised: drop the phantom and the clamp reads 4.
  export URG_CLAMP='[{"acct":"acctA","k":5,"k_work":4,"k_phantom":1,"weekly_need_pct_per_day":20.0,"burn_wk_ppd":3.0},{"acct":"acctB","k":0,"k_work":0,"k_phantom":0,"weekly_need_pct_per_day":4.0,"burn_wk_ppd":9.0}]'
  # The one shape where urgency must take AWAY: an account already AT the concurrency ceiling. Its
  # charge is 8 PHANTOMS against a census of 0 — deliberately, and the deliberateness is the test.
  # Spending the ceiling as `k:8` would have let the ORDINARY load penalty (RLOAD) explain the same
  # placement, so the check would have passed identically against a tool with no floor at all
  # (verified: it did). k=0 leaves the load seeds tied, so only the floor can move the items.
  export URG_FULL='[{"acct":"acctA","k":0,"k_work":0,"k_phantom":8,"weekly_need_pct_per_day":20.0,"burn_wk_ppd":3.0},{"acct":"acctB","k":0,"k_work":0,"k_phantom":0,"weekly_need_pct_per_day":4.0,"burn_wk_ppd":9.0}]'
  export URG_IT5='[{"id":"1","slot":"lead"},{"id":"2","slot":"lead"},{"id":"3","slot":"lead"},{"id":"4","slot":"lead"},{"id":"5","slot":"lead"}]'
  export URG_IT6='[{"id":"1","slot":"lead"},{"id":"2","slot":"lead"},{"id":"3","slot":"lead"},{"id":"4","slot":"lead"},{"id":"5","slot":"lead"},{"id":"6","slot":"lead"}]'

  check "urgency: top-ranked BEHIND acct takes 4 -> a 5-item wave that flat-caps at 4 PLACES" 0 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_BEHIND\" '$SELF' --items \"\$URG_IT5\" --json"
  check "urgency: it is the URGENT acct that absorbed them (acctA 3, acctB 2 — B is still capped)" 0 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_BEHIND\" '$SELF' --items \"\$URG_IT5\" --json 2>/dev/null | jq -e '([.[]|select(.account==\"acctA\")]|length)==3 and ([.[]|select(.account==\"acctB\")]|length)==2'"
  check "urgency: KILL SWITCH (urgent==flat) -> the SAME wave walls at capacity" 4 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_BEHIND\" CC_WAVE_MAX_PER_ACCT_URGENT=2 '$SELF' --items \"\$URG_IT5\""
  check "urgency: rows with NO pace fields make no claim -> same wave walls (fail-soft to flat)" 4 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_NOFIELDS\" '$SELF' --items \"\$URG_IT5\""
  check "urgency: an unreadable SSOT (no KMAX) is NO bound -> no widening, the wave walls" 4 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_BEHIND\" CLAUDE_ACCOUNTS_JSON='$tmp/nope.json' '$SELF' --items \"\$URG_IT5\""
  check "urgency: KMAX - k_eff CLAMPS the allowance to 3 (k_work 4 + phantom 1) -> 6 items wall" 4 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_CLAMP\" '$SELF' --items \"\$URG_IT6\""
  check "urgency: …and 5 items still place under that clamp (the bound binds, it does not veto)" 0 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_CLAMP\" '$SELF' --items \"\$URG_IT5\" --json"
  check "urgency: an acct AT KMAX gets nothing (floor 0) -> both items land on acctB" 0 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_FULL\" '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"},{\"id\":\"2\",\"slot\":\"lead\"}]' --json 2>/dev/null | jq -e 'all(.[]; .account==\"acctB\")'"
  check "urgency: the widening RENDERS on stdout (acct, need vs burn, allowance) — never silent" 0 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_BEHIND\" '$SELF' --items \"\$URG_IT5\" 2>/dev/null | grep -q 'urgency: acctA is BEHIND (needs 20%/d, recent 3%/d) → allowance 4'"
  check "urgency: --json keeps stdout PURE json and discloses on stderr instead" 0 \
    bash -c "STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_BEHIND\" '$SELF' --items \"\$URG_IT5\" --json 2>'$tmp/urg.err' | jq -e 'length==5' >/dev/null && grep -q 'urgency: acctA is BEHIND' '$tmp/urg.err'"
  check "urgency: the flat lane renders NOTHING (the alarm carries a bit only if it can be absent)" 0 \
    bash -c "! STUB_RANK='acctA acctB' STUB_ROWS=\"\$URG_NOFIELDS\" '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"}]' 2>&1 | grep -q urgency:"
  unset URG_BEHIND URG_NOFIELDS URG_CLAMP URG_FULL URG_IT5 URG_IT6

  # (a) QUOTA CLIFF — rank empty, and wave-exceeds-capacity; both exit 4 with NO plan on stdout.
  check "cliff: empty rank -> exit 4" 4 bash -c "STUB_RANK='' '$SELF' --items '[{\"id\":\"a\",\"slot\":\"lead\"}]'"
  check "cliff: empty rank emits NO plan + names /limit-recover" 0 \
    bash -c "out=\$(STUB_RANK='' '$SELF' --items '[{\"id\":\"a\",\"slot\":\"lead\"}]' 2>'$tmp/err'); [ -z \"\$out\" ] && grep -q limit-recover '$tmp/err'"
  check "cliff: wave exceeds capacity (5 items, MAX=2, 2 accts) -> exit 4" 4 \
    bash -c "STUB_RANK='acctA acctB' CC_WAVE_MAX_PER_ACCT=2 '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"},{\"id\":\"2\",\"slot\":\"lead\"},{\"id\":\"3\",\"slot\":\"lead\"},{\"id\":\"4\",\"slot\":\"lead\"},{\"id\":\"5\",\"slot\":\"lead\"}]'"
  check "cliff: cc-route quota cliff propagates -> exit 4" 4 \
    bash -c "STUB_ROUTE_CLIFF=1 '$SELF' --items '[{\"id\":\"a\",\"slot\":\"lead\"}]'"

  # (f) S3/S4 — TRICHOTOMOUS EVIDENCED WALL VERDICTS + the bounded oracle (§3 S3/S4, §5 F4/F5/F6/F8).
  # Note on absence assertions: a "writes NO page" check would be VACUOUS here — cc-wave-plan has no
  # pages dir at all (cc-dispatch owns that surface), so it would pass against a totally broken tool
  # (memory: absence-alarm-needs-existence-evidence). The real absence/presence pair for THIS tool is
  # the operator action it names, and every absence check below sits beside its positive control.
  local IT1='[{"id":"a","slot":"lead"}]'

  # THE DISCRIMINATING PAIR — same harness, same wave, ONE variable: does the oracle ANSWER?
  #   sleeps past the bound          -> 6 unknown  (retry next pass)
  #   answers "nobody has headroom"  -> 4 capped   (/limit-recover)
  # If these two ever agree, this whole task has failed.
  if [ -n "$TIMEOUT_BIN" ]; then
    check "S4 DISCRIMINATOR a: oracle sleeps past the bound -> exit 6 unknown" 6 \
      bash -c "STUB_SLEEP=5 CC_WAVE_ORACLE_TIMEOUT_S=1 '$SELF' --items '$IT1'"
    check "S4 DISCRIMINATOR b: SAME harness, empty-but-successful rank -> exit 4 capped" 4 \
      bash -c "STUB_RANK='' CC_WAVE_ORACLE_TIMEOUT_S=1 '$SELF' --items '$IT1'"
    check "S4: a timed-out oracle NEVER names /limit-recover (a hang is not a quota wall)" 0 \
      bash -c "STUB_SLEEP=5 CC_WAVE_ORACLE_TIMEOUT_S=1 '$SELF' --items '$IT1' 2>'$tmp/err'; grep -q limit-recover '$tmp/err' && exit 1; grep -qi 'retry next pass' '$tmp/err'"
    check "S4 positive control: the CAPPED path DOES name /limit-recover" 0 \
      bash -c "STUB_RANK='' '$SELF' --items '$IT1' 2>'$tmp/err'; grep -q limit-recover '$tmp/err'"
    check "S4: timeout verdict is unknown with oracle_rc 124 on the IDL record" 0 \
      bash -c "STUB_SLEEP=5 CC_WAVE_ORACLE_TIMEOUT_S=1 '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e 'select(.verdict==\"unknown\" and .evidence.oracle_rc==124 and .evidence.reason==\"oracle-timeout\")'"
    check "S4: a bounded cc-route that hangs is unknown, NOT config-fail (exit 3)" 6 \
      bash -c "STUB_ROUTE_SLEEP=5 CC_WAVE_ORACLE_TIMEOUT_S=1 '$SELF' --items '$IT1'"
    check "S4: the bound is recorded (timeout_bin is a real path, never silently skipped)" 0 \
      bash -c "STUB_RANK='' '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e '.evidence.timeout_bin|test(\"^/\")'"
    check "S4: no timeout(1) available -> runs unwrapped and records timeout_bin absent" 4 \
      bash -c "STUB_RANK='' CC_WAVE_TIMEOUT_BIN= '$SELF' --items '$IT1' >/dev/null 2>&1; rc=\$?; tail -1 '$tmp/idl.jsonl' | jq -e '.evidence.timeout_bin==\"absent\"' >/dev/null && exit \$rc; exit 9"
  else
    printf '  skip %-62s (no absolute-path timeout(1) on this box)\n' "S4: bounded-oracle checks (8)"
    skipn=$((skipn+8))
  fi

  # AUTH (F5) — every account logged out. `--rank general` empties EXACTLY as it does on quota
  # exhaustion; only the per-account state tells them apart, and the action differs completely.
  check "S3 auth: all accounts logged out -> exit 5 (not 4)" 5 \
    bash -c "STUB_RANK='' STUB_AUTH=logged-out STUB_ACTIONABLE=true STUB_FIXABLE=true '$SELF' --items '$IT1'"
  check "S3 auth: names /relogin and NEVER /limit-recover (the wrong operator action)" 0 \
    bash -c "STUB_RANK='' STUB_AUTH=logged-out STUB_ACTIONABLE=true STUB_FIXABLE=true '$SELF' --items '$IT1' 2>'$tmp/err'; grep -q limit-recover '$tmp/err' && exit 1; grep -q relogin '$tmp/err'"
  check "S3 auth: IDL verdict=auth with evidence.action=/relogin (A6)" 0 \
    bash -c "STUB_RANK='' STUB_AUTH=logged-out STUB_ACTIONABLE=true STUB_FIXABLE=true '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e 'select(.verdict==\"auth\" and .evidence.action==\"/relogin\")'"
  # ...and the discriminator: ONE healthy account among the logged-out ones is a QUOTA wall, not an
  # auth wall — the healthy account has no headroom, which is what `capped` means.
  check "S3 auth: one healthy account among logged-out ones -> capped (4), not auth" 4 \
    bash -c "STUB_RANK='' STUB_ROWS='[{\"acct\":\"a\",\"auth\":\"logged-out\",\"auth_actionable\":true,\"login_fixable\":true,\"k\":0},{\"acct\":\"b\",\"auth\":\"ok\",\"auth_actionable\":false,\"login_fixable\":false,\"k\":0}]' '$SELF' --items '$IT1'"

  # UNKNOWN (F4) — three ways the oracle fails to ANSWER; none of them is a wall.
  check "S3 unknown: --rank exits non-zero -> exit 6 (not a cliff)" 6 \
    bash -c "STUB_RANK_RC=3 '$SELF' --items '$IT1'"
  check "S3 unknown: --rank answers unparseably -> exit 6" 6 \
    bash -c "STUB_RANK_GARBAGE=1 '$SELF' --items '$IT1'"
  check "S3 unknown: rank empty + --json unavailable -> exit 6 (no state to verdict on)" 6 \
    bash -c "STUB_RANK='' STUB_JSON_RC=1 '$SELF' --items '$IT1'"
  check "S3 unknown: rank empty + oracle knows NO accounts -> exit 6 (absence of evidence)" 6 \
    bash -c "STUB_RANK='' STUB_ROWS='[]' '$SELF' --items '$IT1'"
  check "S3 unknown: the failing-oracle excerpt reaches the record (stderr is the diagnostic)" 0 \
    bash -c "STUB_RANK_RC=3 '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e '.evidence.stderr_excerpt|test(\"rank probe failed\")'"
  # rc 3 = the producer's OWN "data unavailable — degrade to a proxy" (claude-accounts:836-838).
  # With healthy accounts and no auth wall to explain it, that is unknown: a wall asserted on data
  # we could not read IS the false cliff. Its rc-2 twin (policy refused) is the positive control.
  check "S3 unknown: no-candidate rc=3 (data unavailable) -> exit 6, NOT capped" 6 \
    bash -c "STUB_RANK='' STUB_RANK_NONE_RC=3 '$SELF' --items '$IT1'"
  check "S3 positive control: the SAME sentinel with rc=2 (policy refused) -> exit 4 capped" 4 \
    bash -c "STUB_RANK='' STUB_RANK_NONE_RC=2 '$SELF' --items '$IT1'"
  # ...and rc 3 caused by AUTH is still an auth wall, not unknown — an all-logged-out fleet exits 3
  # because a logged-out row carries an `error` and reason_class maps that to "data".
  check "S3 auth: rc=3 caused by logged-out accounts is still exit 5 (order matters)" 5 \
    bash -c "STUB_RANK='' STUB_RANK_NONE_RC=3 STUB_AUTH=logged-out STUB_ACTIONABLE=true STUB_FIXABLE=true '$SELF' --items '$IT1'"

  # The `none` SENTINEL — claude-accounts prints it on stdout when nothing is routable. Accepting
  # any non-blank line as an account name made it a PHANTOM ACCOUNT: a plan placing the wave on an
  # account literally named "none", fired as `--account none`, instead of any wall at all.
  check "S3 sentinel: 'none' is never parsed as an account (no phantom placement)" 0 \
    bash -c "out=\$(STUB_RANK='' '$SELF' --items '$IT1' --json 2>/dev/null); [ -z \"\$out\" ]"
  check "S3 sentinel: a rank line needs a numeric score (an HTML error page is not an account)" 6 \
    bash -c "STUB_RANK_GARBAGE=1 '$SELF' --items '$IT1'"
  check "S3 sentinel positive control: a well-formed '<acct> <score>' line still ranks" 0 \
    bash -c "STUB_RANK='acctA' '$SELF' --items '$IT1' --json | jq -e '.[0].account==\"acctA\"'"

  # CAPPED (F6) — the evidence blob is the whole point: without it A4 ("zero false cliffs") cannot
  # be read at all. A capped record must carry rc 0, the per-account state, and a zero ranked set.
  check "S3 capped: IDL carries evidence {oracle_rc:0, ranked_n:0, 4 accounts}" 0 \
    bash -c "STUB_RANK='' '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e 'select(.action==\"wall\" and .verdict==\"capped\" and .evidence.oracle_rc==0 and .evidence.ranked_n==0 and (.evidence.accounts|length)==4)'"
  check "S3 capped: every evidence account carries {acct,state,k} (A4 is unreadable without it)" 0 \
    bash -c "STUB_RANK='' '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e '.evidence.accounts|all(has(\"acct\") and has(\"state\") and has(\"k\"))'"
  # capacity (wave sizing) is NOT a quota cliff — it keeps exit 4 for the cc-dispatch contract but
  # verdicts distinctly, so A4's `verdict=="capped"` read cannot mistake healthy accounts for one
  # (memory: dispatch-false-cliff-wave-sizing).
  check "S3 capacity: wave overflow verdicts 'capacity', never 'capped' (A4 stays readable)" 0 \
    bash -c "STUB_RANK='acctA acctB' CC_WAVE_MAX_PER_ACCT=1 '$SELF' --items '[{\"id\":\"1\",\"slot\":\"lead\"},{\"id\":\"2\",\"slot\":\"lead\"},{\"id\":\"3\",\"slot\":\"lead\"}]' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e 'select(.verdict==\"capacity\" and .evidence.ranked_n==2)'"
  check "S3: NO plan is emitted on any wall verdict (auth/unknown included)" 0 \
    bash -c "for e in 'STUB_RANK=' 'STUB_RANK_RC=3' 'STUB_RANK= STUB_AUTH=logged-out STUB_ACTIONABLE=true'; do out=\$(env \$e '$SELF' --items '$IT1' --json 2>/dev/null); [ -n \"\$out\" ] && exit 1; done; exit 0"

  # ORDERING — the account wall is decided BEFORE any cc-route call, so the trichotomy is reachable
  # for every wave shape. A frontier wave used to resolve the lead model first, turning an
  # all-logged-out fleet into cc-route's config-fail (exit 3) instead of the auth verdict.
  check "S3 order: a FRONTIER wave on a logged-out fleet still verdicts auth (5), not 3" 5 \
    bash -c "STUB_RANK='' STUB_AUTH=logged-out STUB_ACTIONABLE=true STUB_FIXABLE=true '$SELF' --items '[{\"id\":\"j\",\"slot\":\"judgment-dense\"}]'"
  check "S3 order: a FRONTIER wave on a capped fleet still verdicts capped (4)" 4 \
    bash -c "STUB_RANK='' '$SELF' --items '[{\"id\":\"j\",\"slot\":\"judgment-dense\"}]'"
  # cc-route's rc 4 is its ANSWER ("every account capped"), not an oracle failure — so the record
  # keeps oracle_rc 0 (A4 must not flag a genuine cliff) and carries the raw code as route_rc.
  check "S3 route-cliff: capped with oracle_rc 0 and route_rc 4 (A4 not tripped)" 0 \
    bash -c "STUB_ROUTE_CLIFF=1 '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e 'select(.verdict==\"capped\" and .evidence.oracle_rc==0 and .evidence.route_rc==4)'"

  # KILL SWITCH (§6) — v1 restores the pre-v2 wall verbatim: one exit 4, the old message, no verdict.
  check "lane v1: an auth wall reverts to the single exit 4" 4 \
    bash -c "CC_WAVE_VERDICT_LANE=v1 STUB_RANK='' STUB_AUTH=logged-out STUB_ACTIONABLE=true '$SELF' --items '$IT1'"
  check "lane v1: a failing oracle reverts to exit 4 (the pre-v2 conflation, on purpose)" 4 \
    bash -c "CC_WAVE_VERDICT_LANE=v1 STUB_RANK_RC=3 '$SELF' --items '$IT1'"
  check "lane v1: writes the OLD unevidenced record (action=failed, no verdict/evidence)" 0 \
    bash -c "CC_WAVE_VERDICT_LANE=v1 STUB_RANK='' '$SELF' --items '$IT1' >/dev/null 2>&1; tail -1 '$tmp/idl.jsonl' | jq -e 'select(.action==\"failed\" and (has(\"verdict\")|not) and (has(\"evidence\")|not))'"
  check "lane v1: the happy path is untouched by the switch" 0 \
    bash -c "CC_WAVE_VERDICT_LANE=v1 '$SELF' --items '$IT1' --json | jq -e '.[0].account==\"next\"'"

  # (d) usage + config edges.
  check "usage: empty items array -> exit 2" 2 "$SELF" --items '[]'
  check "usage: --items with no value -> exit 2" 2 "$SELF" --items
  check "usage: unknown flag -> exit 2" 2 "$SELF" --bogus
  check "config: non-array items -> exit 3" 3 "$SELF" --items '{"id":"a"}'
  check "config: malformed JSON items -> exit 3" 3 "$SELF" --items 'not-json'
  check "config: invalid slot in an item -> exit 3 (never a silent default)" 3 \
    "$SELF" --items '[{"id":"a","slot":"chief-vibes-officer"}]'

  echo "cc-wave-plan selftest: $pass passed, $fail failed, $skipn skipped"
  [ "$fail" -eq 0 ] || exit 1
}

command -v jq >/dev/null 2>&1 || { echo "cc-wave-plan: jq required" >&2; exit 3; }

case "${1:-}" in
  selftest)     selftest ;;
  -h|--help|"") usage; exit 0 ;;
  --items)
    shift
    [ $# -gt 0 ] || die "--items requires a JSON array argument"
    ITEMS="$1"; shift
    [ "$ITEMS" = "-" ] && ITEMS="$(cat)"
    AS_JSON=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --json) AS_JSON=1; shift ;;
        *) die "unexpected argument '$1' (usage: cc-wave-plan --items <json> [--json])" ;;
      esac
    done
    cmd_plan "$ITEMS" "$AS_JSON"
    ;;
  --json)
    # allow --json before --items
    shift; AS_JSON=1
    [ "${1:-}" = "--items" ] || die "usage: cc-wave-plan --items <json> [--json]"
    shift; [ $# -gt 0 ] || die "--items requires a JSON array argument"
    ITEMS="$1"; [ "$ITEMS" = "-" ] && ITEMS="$(cat)"
    cmd_plan "$ITEMS" "$AS_JSON"
    ;;
  *) die "unknown argument '$1' (usage: cc-wave-plan --items <json> [--json] | selftest)" ;;
esac
