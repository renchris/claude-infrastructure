#!/bin/bash
# cc-resume-open — reopen ONE Claude Code session, by id, in a new kitty OS window. The agent runs
# this itself; it never hands the operator a `claudeN --resume <sid>` line.
#
# WHY (operator, 2026-10-26): a session wanted the finished kitty-PR session (bff40040) back and
# handed over `cd <wt> && claude3 --resume <sid>`. Run through `!` it died at once —
# `command not found: _cc_sync_account` — because the claudeN launchers are interactive-shell
# functions that neither `!` nor a Bash tool call loads. The operator: "Why does that command need
# me to run it for you; please adjust … so new sessions like these have the ability and agency for
# commands needed to resume." The agent then did it by hand in four steps (resolve, open a window,
# re-run through three capacity refusals, read the footer); this is those four steps as one verb.
#
# What it does:
#   1. RESOLVE  bin/cc-resume-resolve: the full sid, its account, the cwd it recorded, and the
#               branch from the transcript's last gitBranch (reso-resume-one recreates a reaped
#               worktree from it).
#   2. OPEN     `kitten @ launch --type=os-window` (never a tab, never a fifth pane), keep-focus, the
#               window running `cc-resume-open --in-pane …`.
#   3. RETRY    --in-pane calls bin/reso-resume-one under THIS bash, so a refusal returns its code
#               instead of turning the pane into a shell (reso-resume-one rr_refused_exit). rc 9 is a
#               capacity refusal: the per-sid budget admits after its third refusal, so the loop
#               re-asks every CC_RESUME_OPEN_GAP_S (default 20) up to CC_RESUME_OPEN_TRIES (default 5).
#               Any other refusal (a live holder, a teammate, an unresolvable worktree) is final.
#   4. VERIFY   the launching side reads the window's text until the Claude footer shows the sid's
#               first 8 characters, and prints `cc-resume-open: verdict=resumed|deferred|failed`.
#
# It never nudges the resumed session: it comes back at rest (resume-sessions skill, Phase 3).
#
# Usage:
#   cc-resume-open <session-id|8+ char prefix> [--effort E] [--dry-run] [--no-wait]
#   cc-resume-open --in-pane <acct> <cwd> <sid> [branch] [--effort E]     (internal: the window's command)
#
# Exit: 0 resumed (or --dry-run / --no-wait launched) · 2 usage · 3 unresolvable id · 4 already live
#       · 5 kitty unreachable or launch failed · 6 not seen in the footer within the wait (deferred).
# Env: CC_RESUME_OPEN_ENGINE (default bin/reso-resume-one beside this file) · CC_RESUME_OPEN_TRIES ·
#      CC_RESUME_OPEN_GAP_S · CC_RESUME_OPEN_WAIT_S (footer wait, default 300) · KITTY_LISTEN_ON.
set -u

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" 2>/dev/null && pwd)"
ENGINE="${CC_RESUME_OPEN_ENGINE:-$HERE/reso-resume-one}"
RESOLVE="${CC_RESUME_RESOLVE_BIN:-$HERE/cc-resume-resolve}"
TRIES="${CC_RESUME_OPEN_TRIES:-5}";   case "$TRIES" in ''|*[!0-9]*) TRIES=5 ;; esac
GAP="${CC_RESUME_OPEN_GAP_S:-20}";    case "$GAP" in ''|*[!0-9]*) GAP=20 ;; esac
WAIT="${CC_RESUME_OPEN_WAIT_S:-300}"; case "$WAIT" in ''|*[!0-9]*) WAIT=300 ;; esac
# Run #! helpers through their interpreter, not by path (kalloc leak: scripts/lib/cc-run.sh).
# shellcheck disable=SC1091  # runtime-resolved source; the ship gate runs shellcheck without -x
if [ -f "$HERE/../scripts/lib/cc-run.sh" ]; then . "$HERE/../scripts/lib/cc-run.sh"; else cc_run() { "$@"; }; fi
# One row per window opened (scripts/lib/pane-spawn-log.sh: a pane with no row came from outside this tree).
# shellcheck disable=SC1091  # runtime-resolved source; the ship gate runs shellcheck without -x
[ -f "$HERE/../scripts/lib/pane-spawn-log.sh" ] && . "$HERE/../scripts/lib/pane-spawn-log.sh"

usage() { sed -n '/^# Usage:/,/^# Exit:/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# ── the window's own command: retry the engine through capacity refusals, then stay a shell ──
if [ "${1:-}" = "--in-pane" ]; then
  shift
  [ $# -ge 3 ] || usage
  acct="$1" cwd="$2" sid="$3"; shift 3
  args=("$acct" "$cwd" "$sid")
  if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then args+=("$1"); shift; fi
  args+=("$@")
  try=1
  while :; do
    cc_run "$ENGINE" "${args[@]}"; rc=$?
    [ "$rc" -eq 9 ] && [ "$try" -lt "$TRIES" ] || break
    printf '[cc-resume-open] capacity refusal %s of %s — re-asking in %ss\n' "$try" "$TRIES" "$GAP" >&2
    try=$((try + 1)); sleep "$GAP"
  done
  [ "$rc" -eq 0 ] || printf '\n[cc-resume-open] not resumed (rc %s) — this pane is now a shell so the reason stays readable.\n' "$rc" >&2
  [ -n "${CC_RESUME_OPEN_NO_SHELL:-}" ] && exit "$rc"
  exec "${SHELL:-/bin/zsh}" -l -i
fi

# ── the launching side ────────────────────────────────────────────────────────────────────
ID="" EFFORT="" DRY=0 NOWAIT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --effort)  [ $# -ge 2 ] || usage; EFFORT="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    --no-wait) NOWAIT=1; shift ;;
    -h|--help) usage ;;
    -*) printf 'cc-resume-open: unknown option %s\n' "$1" >&2; exit 2 ;;
    *)  [ -z "$ID" ] || { printf 'cc-resume-open: one session id at a time\n' >&2; exit 2; }
        ID="$1"; shift ;;
  esac
done
[ -n "$ID" ] || usage

sid="" account="" cwd="" transcript=""
while IFS='=' read -r k v; do
  case "$k" in sid) sid="$v" ;; account) account="$v" ;; cwd) cwd="$v" ;; transcript) transcript="$v" ;; esac
done < <(cc_run "$RESOLVE" "$ID" 2>/dev/null)
if [ -z "$sid" ] || [ -z "$cwd" ] || [ -z "$account" ] || [ "$account" = "?" ]; then
  printf 'cc-resume-open: cannot resolve %s to an account and a cwd (cc-resume-resolve --print %s)\n' "$ID" "$ID" >&2
  printf 'cc-resume-open: verdict=failed reason=unresolvable sid=%s\n' "$ID"
  exit 3
fi
branch="$(grep -o '"gitBranch":"[^"]*"' "$transcript" 2>/dev/null | tail -n 1 | sed 's/^"gitBranch":"//; s/"$//')"
[ "$branch" = "HEAD" ] && branch=""

# Already live? reso-resume-one refuses a second writer too; asking first saves opening a window.
reg="${CC_REGISTRY_DIR:-$HOME/.claude/cc-registry}"
for f in "$reg"/*.json; do
  [ -f "$f" ] || continue
  grep -q "\"$sid\"" "$f" 2>/dev/null || continue
  pid="$(sed -n 's/.*"pid": *\([0-9][0-9]*\).*/\1/p' "$f" | head -n 1)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    printf 'cc-resume-open: %s is already live (pid %s, %s) — nothing opened\n' "$sid" "$pid" "${f##*/}" >&2
    printf 'cc-resume-open: verdict=live sid=%s pid=%s\n' "$sid" "$pid"
    exit 4
  fi
done

pane_cmd=("$HERE/cc-resume-open" --in-pane "$account" "$cwd" "$sid")   # absolute: the window's cwd differs
[ -n "$branch" ] && pane_cmd+=("$branch")
[ -n "$EFFORT" ] && pane_cmd+=(--effort "$EFFORT")
launch_cwd="$cwd"; [ -d "$launch_cwd" ] || launch_cwd="$HOME"
title="${cwd##*/} (resumed ${sid:0:8})"

if [ "$DRY" = 1 ]; then
  printf 'cc-resume-open: DRY sid=%s account=%s cwd=%s branch=%s\n' "$sid" "$account" "$cwd" "${branch:-}"
  printf 'cc-resume-open: DRY window: %s\n' "${pane_cmd[*]}"
  exit 0
fi

sock="${KITTY_LISTEN_ON:-}"
if [ -z "$sock" ]; then
  # shellcheck disable=SC2012  # newest kitty socket by mtime; names are unix:/tmp/kitty-<pid>
  s="$(ls -t /tmp/kitty-[0-9]* 2>/dev/null | head -n 1)"; [ -n "$s" ] && sock="unix:$s"
fi
[ -n "$sock" ] || { printf 'cc-resume-open: verdict=failed reason=no-kitty-socket sid=%s\n' "$sid"; exit 5; }
KB="${CC_KITTEN_BIN:-kitten}"

wid="$("$KB" @ --to "$sock" launch --type=os-window --keep-focus --cwd "$launch_cwd" \
        --os-window-title "$title" "${pane_cmd[@]}" 2>&1)"
case "$wid" in
  ''|*[!0-9]*) printf 'cc-resume-open: kitty launch failed: %s\n' "$wid" >&2
               printf 'cc-resume-open: verdict=failed reason=launch sid=%s\n' "$sid"; exit 5 ;;
esac
command -v cc_log_pane_spawn >/dev/null 2>&1 && cc_log_pane_spawn os-window kitty "$wid" "$launch_cwd" "cc-resume-open resume $sid on $account"
printf 'cc-resume-open: opened kitty window %s for %s (%s, %s)\n' "$wid" "$sid" "$account" "$cwd" >&2
[ "$NOWAIT" = 1 ] && { printf 'cc-resume-open: verdict=launched sid=%s window=%s\n' "$sid" "$wid"; exit 0; }

# The footer is the proof: the launcher rewrites argv, so ps cannot see `--resume <sid>`.
waited=0
while [ "$waited" -lt "$WAIT" ]; do
  txt="$("$KB" @ --to "$sock" get-text --match "id:$wid" 2>/dev/null)"
  if printf '%s' "$txt" | grep -q "#$wid ${sid:0:8}"; then
    printf 'cc-resume-open: verdict=resumed sid=%s window=%s\n' "$sid" "$wid"; exit 0
  fi
  if printf '%s' "$txt" | grep -q '\[cc-resume-open\] not resumed'; then
    printf '%s\n' "$txt" | grep -E 'reso-resume-one:|cc-resume-open' | tail -n 3 >&2
    printf 'cc-resume-open: verdict=failed reason=refused sid=%s window=%s\n' "$sid" "$wid"; exit 6
  fi
  sleep 5; waited=$((waited + 5))
done
printf 'cc-resume-open: verdict=deferred sid=%s window=%s — not in the footer after %ss; the window keeps retrying\n' "$sid" "$wid" "$WAIT"
exit 6
