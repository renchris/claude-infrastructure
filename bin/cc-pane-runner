#!/bin/bash
# cc-pane-runner — the argv of a freshly-split agent pane, so the pane's COMMAND never has to be
# TYPED at an interactive prompt.
#
# ── WHY THIS FILE EXISTS (plan §9.1, measured 2026-08-03) ────────────────────────────────────────
# Claude Code's ITermBackend delivers a teammate's launch command by TYPING it:
#
#   sendCommandToPane(paneId, cmd)  →  it2 session send -s <id> $'\x15'   (Ctrl-U, clear the line)
#                                      it2 session run  -s <id> <cmd>     (the text, then Enter)
#
# Those are TWO separate process spawns against ONE mutable resource — the pane's prompt line, which
# the human also owns. On 2026-08-03 a 7-way fan-out lost two agents to exactly that race: the
# operator's own in-flight keystroke landed BETWEEN the Ctrl-U and the payload, concatenating into
# `ccd …` (command not found) and `tcd …` (parked forever on zsh's `correct 'tcd' to 'cd' [nyae]?`).
# Both single-character corruptions; both silent to the parent, which reported "Spawned successfully".
#
# It cannot be fixed by better escaping or better timing. Correctness would require that the operator
# not be typing, which is neither knowable nor enforceable. Note that Claude Code's OWN tmux backend
# already does the right thing —
#
#   TmuxBackend.sendCommandToPane → tmux respawn-pane -k -t <pane> -- <cmd>   ← the pane's argv IS
#                                                                              the command
#
# — so the defect is confined to the iTerm2 backend, and the remedy is to give kitty the same shape.
#
# ── THE ONE-HOP DEFERRAL, AND WHY IT IS NEEDED ───────────────────────────────────────────────────
# kitty CAN launch a window whose argv is a command, but Claude Code's protocol does not hand us the
# command at split time — it splits first and sends the text afterwards. So `split` launches THIS
# file instead of an interactive shell, and `run` DROPS THE COMMAND AS A FILE which this file is
# already blocked waiting on. No prompt line is ever involved: there is no line to collide with, no
# ZLE to race, no spell-correction to trigger, and the operator's keystrokes cannot become argv.
#
# ── ENV PARITY IS LOAD-BEARING, AND IT IS WHY THE LAUNCH ARGV IS `zsh -l -i -c` ──────────────────
# The pane a teammate runs in is not a bare process host: ~/.zprofile puts ~/.claude/shims on PATH
# (the login-PATH race, plan §8.4) and ~/.zshrc synthesizes ITERM_SESSION_ID="w0t0p0:$KITTY_WINDOW_ID"
# (the pane identity every hook, cc-notify address and two-way-comms registration is keyed on). A
# runner exec'd from a NON-login, NON-interactive shell would silently produce agents with no PATH
# and no addressable pane identity — alive and unreachable, which is worse than dead.
#
#   bin/it2-kitty launches:  <shell> -l -i -c 'exec /bin/bash "$CC_PANE_RUNNER"'
#
# `-l` reads .zprofile, `-i` reads .zshrc, and both run BEFORE this file, so everything they export is
# inherited here. Measured on kitty 0.48.2 / zsh, pane 331: ITERM_SESSION_ID=w0t0p0:331 (the NEW
# pane's own id, not the leader's), shims on PATH, --env values present.
#
# ── AFTER THE COMMAND: THE RUNNER OWNS THE PANE'S END (docs/research/husk-history-2026-10-24) ─────
# When the command returns, the pane ends in exactly one of three ways, and the runner writes which
# into the exit record's `tail` (§ THE EXIT RECORD below) before it acts:
#   · CLOSED (`closed`) — a claude session (or a fleet launch line) that exited cleanly: rc 0, rc 75
#     (queued), or claude never started while a durable record owns the retry. The runner exits 0,
#     which closes the pane from inside (husk-panes-2026-09-30 fix F-a), once kitty-fullscreen-guard
#     says removing this pane cannot empty a native-fullscreen window (rc 0 or 4).
#   · HELD (`hold:fs` / `hold:unreadable`) — the same clean exit, but the guard refused: this is the
#     last pane of a fullscreen window, or kitty did not answer. The runner stays the pane's process,
#     paints "closes itself when safe", ignores INT/QUIT/TSTP/TERM/HUP, and re-asks the guard with
#     backoff; it exits 0 after two consecutive safe reads, a clear `--any-fs` read on a deaf kitty,
#     or once kitty itself is gone. It never falls back to a shell for this: the shell left there was
#     the "husk" (pane 289), and nothing would ever close it.
#   · KEPT (`keep:<why>`) — an ordinary login shell, for a reason a closed pane would destroy:
#     a crash (`keep:crash`: the watchdog paints its verdict here, the operator resumes HERE), a recycle
#     pending for this pane (`keep:recycle`: handoff-fire types the relaunch at this shell), the kill
#     switch CC_PANE_CLOSE_ON_EXIT=0, a command that is not a session (`keep:not-a-session`, parity
#     with the split this replaced: later `it2 session run/send` find a prompt), a missing or unusable
#     guard or recycle lib (fail closed), or `keep:fallback` — any unplanned exit of this runner after
#     the command returned, caught by the EXIT trap.
# From the command's return on, a signal cannot end this process unguarded (_guarded), and there is
# exactly one `exec` of a shell in this file (_fallback).
#
# Env contract (all set by bin/it2-kitty split):
#   CC_PANE_CMD_DIR   directory holding <pane-id>.armed / <pane-id>.cmd
#   KITTY_WINDOW_ID   set by kitty in the new window; THIS pane's id, and the key for both files
#   CC_PANE_CMD_WAIT_S  how long to wait for a command before giving up (default 300)
#   CC_PANE_CLOSE_ON_EXIT  0 keeps a shell even after a clean claude exit (default 1)
#   CC_PANE_HOLD_STEP_S / CC_PANE_HOLD_MAX_POLLS  the hold's base poll step (default 5 s) and a
#     poll budget after which it escapes to keep:fallback (default none) — test seams
# Exported to the command: CC_PANE_RUNNER_OWNS_CLOSE=<this pane's window id> — this runner closes its
#   own pane, so the opt-in close in bin/cc-close-attrib must stand down, and the self-close watcher
#   reads the record's `tail` only when the id is ITS pane's. (Not CC_PANE_RUNNER: that already
#   carries this file's PATH into every runner pane, including the ordinary shell it degrades to.)

set -u
# shellcheck disable=SC1091  # #! helpers run via their interpreter, not by path (kalloc leak; plan KALLOC_TRIGGER_ELIMINATION W4)
if [ -f "${BASH_SOURCE[0]%/*}/../scripts/lib/cc-run.sh" ]; then . "${BASH_SOURCE[0]%/*}/../scripts/lib/cc-run.sh"; else cc_run() { "$@"; }; fi

_dir="${CC_PANE_CMD_DIR:-}"
_id="${KITTY_WINDOW_ID:-}"
_wait="${CC_PANE_CMD_WAIT_S:-300}"

# The fallback is an ORDINARY SHELL, never an exit. A pane that vanishes because a variable was unset
# takes its diagnostic with it; a pane sitting at a prompt can be read by the operator and by the
# `session list` liveness probe, and Claude Code's dead-pane pruning will not mistake it for gone.
# CONSUME THE ARMING MARKER ON THE WAY OUT TOO (2026-09-17). The marker is a claim that "a runner
# is waiting behind this pane id", and it is consumed at :239 only on the path where a command
# actually arrived. Every OTHER exit from this file — the wait loop timing out, an unusable state
# dir, an empty command — left it on disk forever, where it outlives this pane and then answers
# `armed()` for whatever LIVE pane later carries that id (kitty window ids are a per-process counter
# that restarts at 1). Measured on this box 2026-09-17: 12 markers on disk, 11 of them for panes
# that no longer exist, and `17.armed` — written 19h earlier — sitting over a LIVE Claude Code
# session. `it2 session run -s 17 /exit` therefore wrote /exit to a FILE no runner reads and failed
# its 20s pickup proof, which is precisely why handoff-fire's --recycle and self-close could not
# type /exit in a kitty pane (docs/plans/KITTY_RECYCLE_TRANSPORT.md).
#
# Best-effort and unconditional: a pane degrading to a shell has no further use for the marker, and
# a failure to remove it must never keep this pane from becoming the shell it promised to be.
# The ownership marker goes too: once this file has exec'd away the pane is an ordinary shell, and a
# claude the operator resumes at that prompt is no longer one this runner will close.
# The shell gets the default signal dispositions back, and no EXIT trap: _guarded's are the runner's.
_fallback() {
  trap - INT QUIT TSTP TERM HUP EXIT
  [ -n "${_armed:-}" ] && rm -f "$_armed" 2>/dev/null
  [ -n "${1:-}" ] && _say warn "$1" "pane is an ordinary shell"
  unset CC_PANE_RUNNER_OWNS_CLOSE CC_PANE_STARTED_FILE CC_PANE_EXIT_OWED
  exec "${SHELL:-/bin/zsh}" -l -i
}

# THIS file's real directory. It is reached through ~/.claude/bin's per-file symlinks as often as
# through the checkout, so siblings are found from the resolved path. Every candidate is
# unset-guarded: a bare $HOME here would abort the whole runner under `set -u` and take the pane's
# command with it — the resolver failing wider than the thing it resolves. Empty when unresolvable.
_self_dir() {
  local _s="$0" _t
  while [ -L "$_s" ]; do
    _t="$(readlink "$_s" 2>/dev/null)" || break
    case "$_t" in /*) _s="$_t" ;; *) _s="$(dirname "$_s")/$_t" ;; esac
  done
  (cd "$(dirname "$_s")" 2>/dev/null && pwd) || true
}

# ── WHAT THIS PANE SAYS: ONE LINE PER EVENT, AND ONLY WHEN NOBODY ELSE DID (lr-wake 2026-10-18, RC8) ─
# The runner used to echo the whole launch line (median 335 chars, 6-8 wrapped rows at 57 columns)
# and then add "the fleet launch line exited 9 — keeping a shell" under a refusal the launcher had
# already explained: 2 of the 7 lines on husk pane 435 (g-message-design §2.2). Now every line goes
# through the shared renderer (lib/cc-say.sh), the launch line and every routine decision go to the
# cc-say log only (CC_SAY_VERBOSE=1 prints them), and the pane shows a line only for what the
# operator must know: a failed launch, or a pane kept that should have closed. The renderer is
# sourced lazily; with neither the checkout's nor the live layer's copy, a plain stand-in prints the
# same one-line shape. Its variables are LOCAL to _say: this runner's environment is the command's.
_say_load() {
  command -v cc_say >/dev/null 2>&1 && return 0
  local _sd _c
  _sd="$(_self_dir)"
  for _c in "${_sd:+$_sd/../lib/cc-say.sh}" "${HOME:-}/.claude/lib/cc-say.sh"; do
    # shellcheck source=/dev/null  # runtime-resolved: checkout sibling, else the live layer
    [ -n "$_c" ] && [ -r "$_c" ] && { . "$_c" 2>/dev/null; break; }
  done
  command -v cc_say >/dev/null 2>&1 && return 0
  cc_say() {
    local _g='─'
    case "$1" in ok) _g='✓' ;; fail) _g='✗' ;; warn) _g='⚠' ;; wait) _g='⏸' ;; run) _g='⟳' ;; esac
    printf '%s %s%s%s\n' "$_g" "$2" "${3:+ · $3}" "${4:+ · ▶ $4}" >&2
  }
  cc_say_detail() { :; }
}
# shellcheck disable=SC2034  # CC_SAY_TOOL / CC_SAY_PANE are read by cc_say through bash's dynamic scope
_say()    { _say_load; local CC_SAY_TOOL=cc-pane-runner CC_SAY_PANE="${KITTY_WINDOW_ID:-}"; cc_say "$@"; }
# shellcheck disable=SC2034  # as above
_detail() { _say_load; local CC_SAY_TOOL=cc-pane-runner CC_SAY_PANE="${KITTY_WINDOW_ID:-}"; cc_say_detail "$@"; }

# ── A KEPT PANE IS A DURABLE ROW (husk-panes-2026-10-22 F3) ───────────────────────────────────────
# Every keep below used to be final: the close was one attempt at the moment the command returned, so
# a pane kept while kitty was deaf (pane 42, 2026-10-22) stayed a shell forever. Each keep that is not
# on purpose now leaves a `husk` row in the pane-close queue, and scripts/pane-close-retry.sh retries
# the close through bin/cc-pane-close until it closes or someone takes the pane over. On purpose, and
# so no row: CC_PANE_CLOSE_ON_EXIT=0, a recycle pending for this pane, a human's pane (no command).
# A subshell, so the queue lib's names never reach the command's environment; never fatal.
_husk_row() { # $1=reason [key=value …]
  local _sd _c _q="" _t=""
  [ -n "${KITTY_WINDOW_ID:-}" ] || return 0
  _sd="$(_self_dir)"
  for _c in "${_sd:+$_sd/../scripts/lib/pane-close-queue.sh}" "${HOME:-}/.claude/scripts/lib/pane-close-queue.sh"; do
    [ -n "$_c" ] && [ -r "$_c" ] && { _q="$_c"; break; }
  done
  [ -n "$_q" ] || { _detail "pane kept with no retry row" "pane-close-queue.sh not found"; return 0; }
  _t="$(tty 2>/dev/null)" || _t=""
  # shellcheck source=/dev/null  # runtime-resolved: checkout sibling, else the live layer
  ( . "$_q" && pcq_add husk "$KITTY_WINDOW_ID" reason="$1" "${@:2}" kitty_pid="${KITTY_PID:-}" \
      kitty_sock="${KITTY_LISTEN_ON:-}" tty="$_t" producer=cc-pane-runner ) >/dev/null 2>&1 \
    || _detail "pane kept with no retry row" "pcq_add husk failed"
  return 0
}

# ── THE PANE'S FINAL WORDS COME FROM ONE WRITER (husk-panes-2026-10-22 F5) ─────────────────────────
# A kept pane's screen and title are painted by bin/cc-pane-verdict, which renders the contract's
# states and repaints only on a change; this runner hands it facts. Returns 0 only when the tool ran
# against a real tty: with none (a test, a pipe) the caller keeps its one-line _say instead.
# CC_PANE_RUNNER_TTY is the test seam for the pane's tty.
_PV_PAINTED=0
_verdict() { # cc-pane-verdict arguments after --pane/--sid/--tty
  local _sd _v _t _reg _sid=""
  [ -n "${KITTY_WINDOW_ID:-}" ] || return 1
  _t="${CC_PANE_RUNNER_TTY:-$(tty 2>/dev/null)}" || _t=""
  [ -n "$_t" ] && [ -w "$_t" ] || return 1
  _sd="$(_self_dir)"
  _v="${_sd:+$_sd/cc-pane-verdict}"
  [ -n "$_v" ] && [ -x "$_v" ] || _v="${HOME:-}/.claude/bin/cc-pane-verdict"
  [ -x "$_v" ] || return 1
  _reg="${CC_REGISTRY_DIR:-${HOME:-}/.claude/cc-registry}/$KITTY_WINDOW_ID.json"
  if [ -n "$_PANE_EXIT_DIR" ] && _since_launch "$_reg"; then _sid="$(jq -r '.session_id // empty' "$_reg" 2>/dev/null)"; fi
  cc_run "$_v" --pane "$KITTY_WINDOW_ID" ${_sid:+--sid "$_sid"} --tty "$_t" "$@" >/dev/null 2>&1 || return 1
  _PV_PAINTED=1
}

# The launch VERB, iff the command starts a Claude session: strip a leading `nocorrect`, take the
# first word, then its basename. rc 1 (and no output) for any other command. ONE list, read by both
# the wedge watch and the close-on-exit decision, so the two cannot drift on what "a claude pane" is.
# `claude.exe` is listed as an EXACT spelling, not as `claude.*`: the two families here are the two
# that were measured, and a wildcard would annex any future `claude.<anything>` — a probe, a wrapper,
# a shim — into a pager that has no business watching it and a pane that has no business closing
# (memory: denylist-enumerates-spellings-not-the-class — widening past the evidence is the twin
# defect of missing a spelling, and this gate has now made both mistakes once).
#
# THE VERB IS THE LAUNCHER, NOT THE FIRST WORD (2026-10-01, husk panes 69 and 76). Claude Code
# 2.1.284 hands a teammate pane `cd <dir> && env CLAUDECODE=1 … <path>/claude.exe --agent-id …`, so
# the first word is `cd` and the `claude.exe` spelling measured below never matched: a retired
# member's clean exit fell through to a shell (a husk), and the wedge watch never armed for a team
# pane at all. So skip the two PREFIXES that only set up the launch — one leading `cd <dir> && `
# and an `env` with its `VAR=value` words (or bare leading assignments) — and judge the word after
# them. The spelling list itself is unchanged: this widens where we look, not what counts.
# `read -a` WITHOUT -r on purpose: printf %q escapes a space in a path as `\ `, and read's
# backslash handling keeps such a word whole.
_claude_verb() { # $1=command → prints the verb; rc 0 iff it is a claude session
  local _l="${1#nocorrect }" _v="" _w _words
  case "$_l" in "cd "*" && "*) _l="${_l#* && }"; _l="${_l#nocorrect }" ;; esac
  # shellcheck disable=SC2162  # backslash processing is wanted — see the comment above
  read -a _words <<<"$_l"
  for _w in ${_words[@]+"${_words[@]}"}; do
    case "$_w" in
      env) continue ;;
      [A-Za-z_]*=*) continue ;;   # VAR=value, as env operands or as leading assignments
      *) _v="$_w"; break ;;
    esac
  done
  _v="${_v##*/}"
  case "$_v" in
    claude|claude[0-9]|claude-*|claude.exe|fable|fable[0-9]|cc) printf '%s' "$_v" ;;
    *) return 1 ;;
  esac
}

# Decide what the pane becomes after the command returned (§ AFTER THE COMMAND in the header). Three
# steps, none in a subshell, because each sets globals the next one reads (FIX-DESIGN §4 W1a):
#   _guarded      from the command's return, no signal ends this process unguarded (D2);
#   _exit_policy  the decision the exit status alone makes: _TAIL=close, or keep:<why>;
#   _end          gates a `close` (_gate → closed | hold:<class> | keep:<why>), writes the record's
#                 tail, then acts on it. It never returns.
# The recycle check's lib is a sibling of bin/ in the checkout, else the live layer; an unreadable lib
# keeps the shell — the fail-safe direction (lib/pane-recycle-pending.sh says why).
#
# A FLEET LAUNCH LINE IS A CLAUDE SESSION TOO, even though its first word is `cd` or `{`. The
# interactive delivery mode (CC_PANE_CMD_INTERACTIVE=1) is set by exactly two callers —
# scripts/handoff-fire.sh (:1175, :14233), whose CMD is always `cd <dir> && [env …] <launcher> …`
# or `{ cd … ; } && <launcher> …`, and scripts/limit-recover/lr-lib.sh (:932), `bash <resume
# script>` — and in every shape the session launcher is the LAST command, so the line's exit status
# IS the session's. Keying the close on the verb alone left every handoff successor a husk after its
# own clean /exit, which is the "fleet-launched pane" case this decision exists for. A failed `cd`
# is non-zero and keeps the shell like any other failure. The verb list itself is NOT widened: the
# wedge watch reads it too, and what it may page is a separate question from what may close.
#
# ── A PANE THAT NEVER RAN CLAUDE CLOSES TOO (lr-wake incident 2026-10-18, REPORT §4 Wave B step 6, K3) ─
# The operator's rule: a pane that leaves Claude either runs Claude or is closed. Overnight 13
# refusal panes sat as plain shells, each ending `the fleet launch line exited 9 — keeping a shell`
# (c2 §2.2), with no session in them and the transcript safe on disk. So besides a clean exit, two
# more outcomes close the pane, both only for a claude verb or a fleet launch line:
#   · rc 75 — the launcher QUEUED the launch (one durable requests/<sid>.cc-lr.json retries it);
#   · claude never started (the exit record's claude_started=false) AND a durable record owns the
#     retry (the launcher touched $CC_PANE_EXIT_OWED, or this pane's own LR_RUN_DIR holds a
#     relaunch.rc — the run-dir owner retries, K3's rc 9).
# Every other non-zero exit keeps the shell, as before. And no reason closes an IN-PLACE pane: a
# recycle pending for this pane means handoff-fire is about to type the relaunch at this shell.
_TAIL="" _V="" _WHY="" _KEEP_HINT="" _KEEP_DETAIL="" _SAY_ON_KEEP="" _GUARD="" _DONE=0
_exit_policy() { # $1=command $2=rc $3=1 iff fleet launch line $4=claude_started $5=1 iff owed → _TAIL, _V, _WHY (no git, no transcript)
  _TAIL=close _WHY=""
  if ! _V="$(_claude_verb "$1")"; then
    [ "${3:-0}" = 1 ] || { _TAIL=keep:not-a-session; return 0; }
    _V="the fleet launch line"
  fi
  if [ "${CC_PANE_CLOSE_ON_EXIT:-1}" = 0 ]; then _TAIL=keep:kill-switch _WHY="exited $2"; return 0; fi
  case "$2" in
    0)  _WHY="exited 0"; return 0 ;;
    75) _WHY="exited 75 (queued — one durable request retries it)"; return 0 ;;
  esac
  if [ "${4:-true}" = false ] && [ "${5:-0}" = 1 ]; then
    _WHY="exited $2 before claude started, and a durable record owns the retry"; return 0
  fi
  _TAIL=keep:crash
}

# From the command's return, INT/QUIT/TSTP/TERM/HUP are ignored (and so are they in every child the
# runner starts: the guard, the hold's sleep), and any exit that is not a planned one runs _escape,
# which keeps a shell. HEAD's close asked the guard with default dispositions, so a ^C in that 5 s
# window ended the pane unguarded (FIX-DESIGN D2, break 4). _fallback resets both before its exec.
_guarded() { trap '' INT QUIT TSTP TERM HUP; trap '_escape' EXIT; }
# shellcheck disable=SC2329  # invoked indirectly — the EXIT trap only.
_escape() { # the EXIT trap: a planned exit set _DONE; anything else keeps a shell, said and retried
  [ "${_DONE:-0}" = 1 ] && return 0
  _pane_exit_tail keep:fallback
  _husk_row runner-escape what="${_V:-}"
  _fallback "the runner ended unexpectedly"
}

_recycle_lib() { # sources lib/pane-recycle-pending.sh; rc 1 when no readable copy sources
  local _sd _c _lib=""
  _sd="$(_self_dir)"
  for _c in "${_sd:+$_sd/../lib/pane-recycle-pending.sh}" "${HOME:-}/.claude/lib/pane-recycle-pending.sh"; do
    [ -n "$_c" ] && [ -r "$_c" ] && { _lib="$_c"; break; }
  done
  [ -n "$_lib" ] || return 1
  # shellcheck source=/dev/null  # runtime-resolved: checkout sibling, else the live layer
  . "$_lib" 2>/dev/null
}
_guard_bin() { # → _GUARD; rc 1 when it is not executable. A CC_KITTY_FS_GUARD path overrides it.
  local _sd
  _GUARD="${CC_KITTY_FS_GUARD:-}"
  if [ -z "$_GUARD" ]; then
    _sd="$(_self_dir)"
    _GUARD="${_sd:+$_sd/kitty-fullscreen-guard}"
    [ -n "$_GUARD" ] && [ -x "$_GUARD" ] || _GUARD="${HOME:-}/.claude/bin/kitty-fullscreen-guard"
  fi
  [ -x "$_GUARD" ]
}

# THE GATE on a `close`: recycle check, then kitty-fullscreen-guard (docs/research/kitty-crash-2026-10-15
# /README.md § Chosen fix — emptying a native-fullscreen OS window from inside crashed the whole kitty).
# REFUSE mode never toggles. rc 0 (safe, or not the last pane) and rc 4 (the window is already gone)
# close; rc 3 HOLDS — never a shell: the guard's rc is 3 for a fullscreen last pane AND for a kitty
# that did not answer, and only its verdict TEXT tells the two apart (husk-panes-2026-10-22 F4), so
# its words go to the cc-say log, never the pane. Any other rc is a guard that cannot answer: keep.
# --scope pane, not os-window: the runner removes only ITS OWN pane, and the kitten counts "last"
# across every tab of the OS window (K3 as amended). Not in kitty ⇒ nothing to empty ⇒ no gate;
# CC_KITTY_FS_GUARD=off is the operator's kill switch.
_gate() { # $1=what exited → _TAIL=closed|hold:fs|hold:unreadable|keep:<why>
  local _o _rc=0
  if ! _recycle_lib; then
    _TAIL=keep:no-recycle-lib _KEEP_HINT="recycle check unavailable"
    _KEEP_DETAIL="$1 $_WHY — recycle check unavailable, keeping the shell"; return 0
  fi
  if cc_pane_recycle_pending "${KITTY_WINDOW_ID:-}"; then
    # The relaunch that is coming here says what it is; a line from this runner would be a second.
    _detail "$1 $_WHY — recycle pending, keeping the shell" "an in-place relaunch is coming here"
    _TAIL=keep:recycle; return 0
  fi
  [ -n "${KITTY_WINDOW_ID:-}" ] || { _TAIL=closed; return 0; }
  if [ "${CC_KITTY_FS_GUARD:-}" = off ]; then
    _detail "CC_KITTY_FS_GUARD=off — closing without the fullscreen guard"; _TAIL=closed; return 0
  fi
  if ! _guard_bin; then
    _TAIL=keep:no-guard _KEEP_HINT="fullscreen guard missing"
    _KEEP_DETAIL="fullscreen guard not executable at $_GUARD — keeping the shell ($1 $_WHY)"; return 0
  fi
  _o="$(cc_run "$_GUARD" --window "$KITTY_WINDOW_ID" --mode refuse --scope pane --tool cc-pane-runner 2>&1)" || _rc=$?
  case "$_rc" in
    0|4) _TAIL=closed ;;
    3)   _detail "$1 $_WHY — guard: ${_o:-no output}" "held: closes itself when safe"
         case "$_o" in *"refused (refused-fs)"*) _TAIL=hold:fs ;; *) _TAIL=hold:unreadable ;; esac ;;
    *)   _TAIL=keep:no-guard _KEEP_HINT="fullscreen guard failed"
         _KEEP_DETAIL="fullscreen guard rc $_rc — keeping the shell ($1 $_WHY): ${_o:-no output}" ;;
  esac
}

_end() { # $1=what exited $2=rc $3=1 iff fleet launch line $4=claude_started — never returns
  # The arming marker goes FIRST: one that outlives the decision answers armed() for whatever pane
  # next carries this id, and the gate below can take seconds (FIX-DESIGN break 7).
  [ -n "${_armed:-}" ] && rm -f "$_armed" 2>/dev/null
  _V="${1:-}" # what _escape's row names
  [ "$_TAIL" = close ] && _gate "${1:-}"
  _pane_exit_tail "$_TAIL"
  case "$_TAIL" in
    closed)
      _detail "${1:-} $_WHY — closing this pane" "CC_PANE_CLOSE_ON_EXIT=0 keeps it"
      _DONE=1; exit 0 ;;
    hold:*) _hold "${_TAIL#hold:}"; exit 1 ;;
    keep:crash) _kept_line "${1:-}" "${2:-}" "${3:-0}" "${4:-true}" ;;
    keep:kill-switch) _detail "${1:-} $_WHY — CC_PANE_CLOSE_ON_EXIT=0, keeping the shell" ;;
    keep:no-guard|keep:no-recycle-lib)
      CC_SAY_DETAIL="$_KEEP_DETAIL" _say warn "pane kept, not closed" "$_KEEP_HINT"
      _husk_row "${_TAIL#keep:}" what="${1:-}" ;;
    keep:recycle|keep:not-a-session) ;;
    *) _TAIL=keep:fallback; _pane_exit_tail keep:fallback; _husk_row runner-escape what="${1:-}" ;;
  esac
  # One writer: when the verdict was painted, the fallback adds no line of its own.
  [ "$_PV_PAINTED" = 1 ] && _SAY_ON_KEEP=""
  _fallback "$_SAY_ON_KEEP"
}

# ── THE HOLD (FIX-DESIGN D1, D3) ─────────────────────────────────────────────────────────────────
# A clean exit the guard refused. The runner stays the pane's process and re-asks the guard with
# backoff (step CC_PANE_HOLD_STEP_S, doubling to a cap of 12 steps for fullscreen, 60 for a kitty that
# does not answer). It closes only on TWO consecutive safe reads (rc 0 or 4) — a single safe read can
# be a sample inside a fullscreen enter animation — on a clear `--any-fs` read when the kitten itself
# failed (remote control down: the same no-socket proof cc-pane-close accepts), or once KITTY_PID is
# gone (nothing left to empty). A guard that cannot answer, or the CC_PANE_HOLD_MAX_POLLS budget,
# exits 1 into _escape. Painted as DONE + held, never RESUME: this was a clean exit.
_hold() { # $1=fs|unreadable — exits 0 only once removing this pane cannot empty a fullscreen window
  local _c="$1" _s="${CC_PANE_HOLD_STEP_S:-5}" _w _ok=0 _n=0 _rc _o _cap
  case "$_s" in ''|*[!0-9]*) _s=5 ;; esac
  _hold_paint "$_c"; _w="$_s"
  while :; do
    /bin/sleep "$_w"; _n=$((_n + 1))
    if [ -n "${KITTY_PID:-}" ] && ! kill -0 "$KITTY_PID" 2>/dev/null; then _hold_done; fi
    if [ -n "${CC_PANE_HOLD_MAX_POLLS:-}" ] && [ "$_n" -gt "$CC_PANE_HOLD_MAX_POLLS" ]; then exit 1; fi
    _rc=0; _o="$(cc_run "$_GUARD" --window "$KITTY_WINDOW_ID" --mode refuse --scope pane --tool cc-pane-hold 2>&1)" || _rc=$?
    if [ "$_rc" = 3 ] && [ -n "${KITTY_PID:-}" ]; then
      case "$_o" in *kitten-failed*)
        _rc=0; cc_run "$_GUARD" --any-fs --kitty-pid "$KITTY_PID" --tool cc-pane-hold >/dev/null 2>&1 || _rc=3 ;;
      esac
    fi
    case "$_rc" in
      0|4) _ok=$((_ok + 1)); [ "$_ok" -ge 2 ] && _hold_done; _w=$((2 * _s)) ;;
      3)   _ok=0
           case "$_o" in *"refused (refused-fs)"*) _hold_class fs ;; *) _hold_class unreadable ;; esac
           _cap=$((12 * _s)); [ "$_c" = unreadable ] && _cap=$((60 * _s))
           _w=$((_w * 2)); [ "$_w" -gt "$_cap" ] && _w="$_cap"; [ "$_w" -gt 0 ] || _w="$_s" ;;
      *)   exit 1 ;;
    esac
  done
}
_hold_class() { [ "$1" = "$_c" ] && return 0; _c="$1"; _pane_exit_tail "hold:$_c"; _hold_paint "$_c"; } # _c: _hold's
_hold_paint() { # $1=fs|unreadable
  if [ "$1" = fs ]; then _verdict --state "${_PV_STATE:-DONE}" --guard held || _say wait "done · closes itself when safe" "⌘W closes it now"
  else _verdict --state "${_PV_STATE:-DONE}" --guard unreadable || _say wait "kitty didn't answer" "closes when it does"; fi
}
_hold_done() { _DONE=1; _pane_exit_tail closed; _detail "held pane — removing it is safe now, closing it"; exit 0; }

# A non-zero exit that keeps the shell. One line, or none (one event, one line):
#   · rc 3 / 9 from a fleet launcher — lr-fire-resume already printed the refusal and why;
#   · claude ran and then died — the shell stays for the resume lead-crash-watchdog paints here;
#   · the launch never started claude — the one case only this runner can see.
# `✗ launch failed (exit N)` is also what handoff-fire's PARKED detector matches (FIRE_PARKED_RE).
# "Never started" needs the exit record's evidence (a kitty pane): without it the runner cannot tell
# a launch that died from a session that ran, and says only what it saw.
_kept_line() { # $1=verb $2=rc $3=1 iff fleet launch line $4=claude_started
  local _s="$1 exited $2 — keeping a shell for diagnosis/resume"
  if [ "$3" = 1 ] && { [ "$2" = 3 ] || [ "$2" = 9 ]; }; then
    _detail "$_s" "the launcher printed the refusal"
  elif [ "$4" = true ] || [ -z "$_PANE_EXIT_DIR" ]; then
    # claude ran and died: the row lets the closer retry once the session is ruled done (custody
    # returned, Good to close, landed elsewhere) — cc-pane-close's gate 3 refuses it until then.
    [ "$4" = true ] && _husk_row crash what="$1" rc="$2"
    # No pane line: "resume" is not established yet, and an exit code is not for the screen (the
    # F5 contract). The crash watchdog decides RESUME, OWNED or DONE and paints it via cc-pane-verdict.
    _detail "$_s" "kept; the crash watchdog paints the verdict"
  else
    # With a pane id the command takes the fact's room (cc_say drops a fact before it moves a command).
    _s="$_s (claude never started)"
    if [ -n "${KITTY_WINDOW_ID:-}" ]; then CC_SAY_DETAIL="$_s" _say fail "launch failed (exit $2)" "" "cc-husk-sweep --pane $KITTY_WINDOW_ID"
    else CC_SAY_DETAIL="$_s" _say fail "launch failed (exit $2)" "shell kept"; fi
  fi
}

# ── THE EXIT RECORD — A CONTRACT OTHER FILES READ (lr-wake 2026-10-18, K3) ──────────────────────
# Written on EVERY return of the command, before the pane decides what to become:
#
#   ~/.claude/run/pane-exit/<window>.json     (<window> = KITTY_WINDOW_ID; dir = $CC_PANE_EXIT_DIR)
#   {"rc": <int>, "claude_started": <true|false>, "launch_sha": "<hex>", "ts": <int>, "tail": "<state>"}
#
#   rc              the command's exit status, as this runner saw it
#   claude_started  true iff a claude session demonstrably started in THIS pane during this launch:
#                   the launcher touched $CC_PANE_STARTED_FILE, or this pane's cc-registry row or a
#                   beat naming this pane was written after the launch began
#   launch_sha      sha256 of the exact command line this runner ran (empty if no hasher), so a
#                   reader can tell its own launch's record from an older one in the same window id
#   ts              epoch seconds at which the command returned
#   tail            what the pane became, added once decided and rewritten as a hold moves on:
#                   closed · hold:fs · hold:unreadable · keep:<why>. Absent = not decided yet.
#
# The self-close watcher (scripts/handoff-fire.sh hf_pane_exit_tail) waits for `tail` on a record of
# its own launch rather than reading `ts` alone, because the record is written before the decision.
#
# Readers: lr-fire-resume (Wave C), handoff-fire's PARKED verdict (Wave E), cc-pane-close's
# never-launched arm (Wave F). Change a field only with all three. Exported to the command, so a
# launcher can supply the two facts this runner cannot observe from outside:
#   CC_PANE_STARTED_FILE  touch it when claude is about to start (the TUI handover)
#   CC_PANE_EXIT_OWED     touch it when the exit leaves a durable record that owns the retry
_PANE_EXIT_DIR=""
_pane_exit_prepare() { # → sets _PANE_EXIT_DIR; exports the two launcher-side paths; never fatal
  local _id="${KITTY_WINDOW_ID:-}"
  [ -n "$_id" ] || return 0
  case "$_id" in *[!0-9]*) return 0 ;; esac
  _PANE_EXIT_DIR="${CC_PANE_EXIT_DIR:-${HOME:-}/.claude/run/pane-exit}"
  mkdir -p "$_PANE_EXIT_DIR" 2>/dev/null || { _PANE_EXIT_DIR=""; return 0; }
  rm -f "$_PANE_EXIT_DIR/$_id.started" "$_PANE_EXIT_DIR/$_id.owed" 2>/dev/null
  : > "$_PANE_EXIT_DIR/$_id.launch" 2>/dev/null || true
  export CC_PANE_STARTED_FILE="$_PANE_EXIT_DIR/$_id.started" CC_PANE_EXIT_OWED="$_PANE_EXIT_DIR/$_id.owed"
}
# "not older than the launch marker", i.e. written at or after the launch began (same-second safe)
_since_launch() { [ -e "$1" ] && [ ! "$_PANE_EXIT_DIR/${KITTY_WINDOW_ID:-}.launch" -nt "$1" ]; }
_pane_claude_started() { # → prints true|false
  local _id="${KITTY_WINDOW_ID:-}" _bd
  [ -n "$_PANE_EXIT_DIR" ] || { printf 'false'; return 0; }
  _since_launch "$_PANE_EXIT_DIR/$_id.started" && { printf 'true'; return 0; }
  _since_launch "${CC_REGISTRY_DIR:-${HOME:-}/.claude/cc-registry}/$_id.json" && { printf 'true'; return 0; }
  _bd="${CC_BEAT_DIR:-${HOME:-}/.claude/cc-beats}"
  if [ -d "$_bd" ] && find "$_bd" -name '*.json' -newer "$_PANE_EXIT_DIR/$_id.launch" \
       -exec grep -El "\"pane\"[[:space:]]*:[[:space:]]*\"?$_id\"?[,}[:space:]]" {} + 2>/dev/null | grep -q .; then
    printf 'true'; return 0
  fi
  printf 'false'
}
_pane_owed() { # → prints 1 iff a durable record owns this launch's retry, else 0
  if [ -n "$_PANE_EXIT_DIR" ] && _since_launch "$_PANE_EXIT_DIR/${KITTY_WINDOW_ID:-}.owed"; then printf 1; return 0; fi
  if [ -n "${LR_RUN_DIR:-}" ] && [ -f "$LR_RUN_DIR/relaunch.rc" ]; then printf 1; return 0; fi
  printf 0
}
# The fields stay in globals, so the decision can rewrite the same record with its `tail` added
# (§ AFTER THE COMMAND in the header) — same ts: the watcher reads "this launch's record, decided".
_PE_RC="" _PE_STARTED="" _PE_SHA="" _PE_TS=""
_pane_exit_write() { # [$1=tail] → writes the record from the globals atomically (tmp + mv); never fatal
  local _id="${KITTY_WINDOW_ID:-}" _t
  [ -n "$_PANE_EXIT_DIR" ] && [ -n "$_PE_RC" ] || return 0
  _t="$_PANE_EXIT_DIR/.$_id.json.$$"
  printf '{"rc":%s,"claude_started":%s,"launch_sha":"%s","ts":%s%s}\n' "$_PE_RC" "$_PE_STARTED" "$_PE_SHA" "$_PE_TS" \
    "${1:+,\"tail\":\"$1\"}" > "$_t" 2>/dev/null && mv -f "$_t" "$_PANE_EXIT_DIR/$_id.json" 2>/dev/null
  rm -f "$_t" 2>/dev/null
  return 0
}
_pane_exit_tail() { _pane_exit_write "$1"; } # $1=closed|hold:<class>|keep:<why>
_pane_exit_record() { # $1=command $2=rc $3=claude_started → writes the record atomically; never fatal
  local _sha=""
  [ -n "$_PANE_EXIT_DIR" ] || return 0
  case "$2" in ''|*[!0-9]*) return 0 ;; esac
  # /sbin/sha256sum, never shasum: /usr/bin/shasum is a #! perl script (a kernel-memory leak per
  # exec on macOS 15.8.1). Same bytes; Linux takes the coreutils branch.
  if [ -x /sbin/sha256sum ]; then
    _sha="$(printf '%s' "$1" | /sbin/sha256sum 2>/dev/null | cut -d' ' -f1)"
  elif command -v sha256sum >/dev/null 2>&1; then
    _sha="$(printf '%s' "$1" | sha256sum 2>/dev/null | cut -d' ' -f1)"
  fi
  case "$_sha" in *[!0-9a-f]*) _sha="" ;; esac
  _PE_RC="$2" _PE_STARTED="$3" _PE_SHA="$_sha" _PE_TS="$(date +%s)"
  _pane_exit_write
}

# ── RUNNING THE COMMAND: two eval shells, because two callers name things differently ────────────
# eval (default) — Claude Code hands over an ABSOLUTE PATH to a binary. Running it in THIS shell is
#   what lets an `exec …` inside the command replace this process, exactly as it would at a prompt.
# `$SHELL -l -i -c` (CC_PANE_CMD_INTERACTIVE=1) — scripts/handoff-fire.sh hands over a SHELL COMMAND
#   LINE whose verb is a launcher (`claude4`, `nocorrect claude4 …`). Measured on this box: those
#   launchers are zsh FUNCTIONS defined only in the operator's INTERACTIVE rc —
#     zsh -l -i -c 'whence -w claude4'  → claude4: function      ← resolves
#     zsh -l -c    'whence -w claude4'  → not found              ← -i is load-bearing, not -l
#     bash -lc     'type -t claude4'    → not found              ← this file's own shebang
#   so an `eval` here (bash) would print the command and die on `command not found`, i.e. delivering
#   handoff's command as argv would be WORSE than typing it. This branch is what makes the argv
#   transport usable by handoff at all; it is not a stylistic alternative to eval.
# `nocorrect` survives it (a zsh reserved word, verified under -l -i -c), so the shared $CMD shapes —
# which tests/handoff-fire-typed-cmd-correctable.bats pins — need no argv-specific variant.
# ── STARTUP-WEDGE WATCHDOG (backlog 71908843ff77) ────────────────────────────────────────────────
# This file is the chokepoint every kitty-spawned agent pane passes through, and it is the only
# place that sees the launch BEFORE the command runs — so it is where the census
# (docs/research/cc-startup-modals-2026-08-04.md §3) put the detector for the one failure mode that
# no other instrument on this box can see: a session stopped at a blocking startup modal. The pane
# is alive, the process is alive, SessionStart never fires, so there is no cc-registry row, no
# telemetry row and no transcript. cc-spawn-verify reports `0 RUNNING` because the process really
# does exist. The brief is never run and nothing notices.
#
# ARM ONLY FOR A CLAUDE SESSION. This runner transports whatever command it is handed; a monitor,
# a probe or a plain shell has no assistant turn to produce and no composer to render, so arming
# on one would page a pane that is behaving exactly as intended. The verb is matched, not the whole
# line, so a `--append-system-prompt` that merely MENTIONS claude cannot arm it.
#
# ── `claude.exe` IS THE TEAMMATE SPELLING, AND OMITTING IT LEFT TEAM PANES UNWATCHED ─────────────
# Backlog `bc50117059ac` (spawn start-ack) ranks the un-acked spawn surfaces by who survives to
# notice: handoff successor FIRST, then TEAM PANES, subagents last. The handoff arm has been
# fail-closed since 0a4c8c9c (handoff-fire.sh:verify_engagement, exit 1 on all three failure
# verdicts). The team-pane arm reached this gate and fell out of it.
#
# Agent-Teams teammate panes arrive here through the FILE delivery mode below — Claude Code splits
# first and sends the command afterwards — so a teammate's launch command IS transported by this
# runner and DOES reach this function. It simply never matched: the verb is `claude.exe`, and
# `claude-*` does not match a dot. Two independent measurements name that spelling as the teammate
# population, not a variant of it:
#   · scripts/capacity-alarm.sh:583 — sessions launch under TWO DISJOINT spellings,
#     `.../claude-code/bin/claude.exe` (measured ≡ exactly the `--agent-id` teammate set) and
#     `.../node_modules/.bin/claude` (the interactive launcher). Measured intersection: ZERO.
#   · hooks/lib/agent-identity.sh:14 — the measured 2.1.220 teammate argv is
#     `claude.exe --agent-id <n>@session-<t> --agent-name <n> --team-name <t> …`.
# So the incumbent set covered the launcher family and nothing else, and the surface the backlog
# item ranks SECOND was the one surface with no watchdog at all.
#
# WHAT THE WATCHDOG CAN AND CANNOT SEE HERE, stated because it is NOT the same as for a launcher
# pane. cc-wedge-watch is a conjunction: WEDGED := NOT engaged(assistant turn) AND NOT ui_up(screen).
# For a teammate its FIRST axis is structurally blind — an assignee pane has no cc-registry row at
# all (134/134, hooks/lib/lead-crash-watchdog.sh:596), so cc_engaged_pane returns 1 with
# `no-registry-row` every time (hooks/lib/engagement.sh:99-105 — a clean, reasoned abstain, not an
# error). The verdict therefore rests entirely on the SUPPRESSOR: a healthy teammate renders CC's
# composer/auto-mode footer and reads ENGAGED via `proof=ui-anchor`; a teammate that died at the
# shell or stalled on a startup modal renders neither and pages. That is the designed degradation
# (the conjunction exists so either axis alone cannot convict), but it means the anchor set is
# load-bearing on this path — `cc-wedge-watch --calibrate` is the guard that it still matches the
# live fleet, and it exits 3 when 0 of N panes match (memory: control-calibrated-to-implementation-
# decays; the prescribed `? for shortcuts` anchor measured 0/23 live four days after it was written).
#
# BLAST RADIUS. A side-car must fail no wider than itself (memory:
# addon-failure-exceeds-its-blast-radius). Everything below is unset-safe, non-fatal, backgrounded,
# and — load-bearing in a pane launcher — has all three fds redirected to /dev/null. A background
# child that keeps the pane's stdout/stderr open is how 43 wrappers once sat pinned for 10h on one
# orphan's fd2 (memory: procsub-pid-is-unreachable-own-the-pipe).
_arm_wedge_watch() { # $1=the command about to run
  [ "${CC_PANE_WEDGE_WATCH:-1}" = 0 ] && return 0
  [ -n "${KITTY_WINDOW_ID:-}" ] || return 0

  # The launch VERB (_claude_verb above owns the list and why it is exact spellings).
  local _v _sd _c _w=""
  _v="$(_claude_verb "$1")" || return 0

  # This file's real directory first, then the live layer.
  _sd="$(_self_dir)"
  for _c in "${_sd:+$_sd/cc-wedge-watch}" "${HOME:-}/.claude/bin/cc-wedge-watch"; do
    [ -n "$_c" ] && [ -x "$_c" ] && { _w="$_c"; break; }
  done
  [ -n "$_w" ] || return 0

  ( "$_w" --pane "$KITTY_WINDOW_ID" --label "${_v}" >/dev/null 2>&1 </dev/null & ) >/dev/null 2>&1
  return 0
}

# THE LAUNCH LINE, SHORT (lr-wake Wave H2). The full command goes to the cc-say log. A fleet launch
# line (interactive mode: handoff-fire, lr-lib) prints nothing here, because its launcher speaks for
# itself — lr-fire-resume prints one line just before claude starts, and a refusal is its first
# line. A delivered command (file mode: Claude Code's teammate panes) gets one gray line naming
# the verb and the directory, and KEEPS `--agent-name <n>` verbatim: cc-spawn-verify's
# parked_evidence greps a dead teammate pane's screen for exactly that string, so it is printed at the
# full 56-cell budget, never fitted to a narrower pane (kitty's get-text joins a soft-wrapped line).
_launch_line() { # $1=command $2=1 iff interactive (fleet) mode
  local _l="${1#nocorrect }" _d="" _v _n=""
  if [ "$2" = 1 ]; then _detail "fleet launch line" "$1"; return 0; fi
  case "$_l" in "cd "*" && "*) _d="${_l#cd }"; _d="${_d%% && *}" ;; esac
  _d="${_d%/}"; _d="${_d##*/}"; [ -n "$_d" ] || _d="${PWD##*/}"
  _v="$(_claude_verb "$1")" || { _v="${_l%% *}"; _v="${_v##*/}"; }
  case " $_l " in *" --agent-name "*) _n="${_l#* --agent-name }"; _n=" --agent-name ${_n%% *}" ;; esac
  CC_SAY_DETAIL="$1" CC_SAY_WIDTH=56 _say run "starting ${_v}${_n}" "$_d"
}

_launch() { # $1=command — never returns
  _launch_line "$1" "${CC_PANE_CMD_INTERACTIVE:-0}"
  # CONSUME the env-mode delivery record before running it — the exact analogue of the `rm -f` the
  # file path does below, and for the mirror-image reason. `kitty @ launch --env` puts these two in
  # the PANE's environment, so they are inherited by the command this file runs and by every
  # DESCENDANT of it: a delivery record that outlives its delivery by the entire life of the pane.
  # Measured 2026-08-07 in a pane scripts/handoff-fire.sh had fired — the agent session it started
  # still carried the launch line that started IT, so `bin/it2-kitty session split` run inside that
  # session read the ancestor's spent CC_PANE_CMD as its own caller's intent (it2-kitty:626),
  # forwarded it as `--env CC_PANE_CMD=<the parent's own handoff command>`, and did NOT arm the new
  # pane. The child would have re-run the PARENT's launch, while the command Claude Code actually
  # meant for it was typed at a pane with no prompt to receive it. Non-emptiness is not provenance
  # (memory: second-transport-makes-an-e2e-ambient); consuming the record is what restores it.
  # Read the mode FIRST: it is half of the same record, and the branch below still needs it.
  local _interactive="${CC_PANE_CMD_INTERACTIVE:-0}"
  unset CC_PANE_CMD CC_PANE_CMD_INTERACTIVE
  _arm_wedge_watch "$1"
  # `set +u` FIRST — and it is parity, not laxity. The command this file runs used to be typed at an
  # interactive zsh where nounset is off; inheriting THIS file's `set -u` into it would abort any
  # command that reads an unset variable, i.e. this file would change the meaning of commands it is
  # only supposed to transport. The guard exists for the runner's own logic above, and its job is done.
  set +u
  local _rc _started
  export CC_PANE_RUNNER_OWNS_CLOSE="${KITTY_WINDOW_ID:-1}"
  _pane_exit_prepare
  if [ "$_interactive" = 1 ]; then
    "${SHELL:-/bin/zsh}" -l -i -c "$1"; _rc=$?; _guarded
  else
    eval "$1"; _rc=$?; _guarded
  fi
  _started="$(_pane_claude_started)"
  _pane_exit_record "$1" "$_rc" "$_started"
  _exit_policy "$1" "$_rc" "$_interactive" "$_started" "$(_pane_owed)"
  _end "$_V" "$_rc" "$_interactive" "$_started"
  exit 1 # unreachable: _end never returns; if it did, _escape keeps a shell
}

# ── TWO DELIVERY MODES, because the two callers learn the command at different times ─────────────
# ENV (CC_PANE_CMD non-empty) — the command was known BEFORE this pane existed, so it rode in on the
#   launch itself: there is nothing to wait for, no id-keyed file, and NO WINDOW IN WHICH ANYTHING
#   COULD RACE IT. scripts/handoff-fire.sh works this way — it BUILDS the launch line and only then
#   creates the surface, so it can hand the command over as argv+env in one atomic act.
# FILE (CC_PANE_CMD unset) — Claude Code's protocol splits first and sends the command afterwards, so
#   the command can only arrive later and must be polled for. The original mode, unchanged below.
# Checked before CC_PANE_CMD_DIR/KITTY_WINDOW_ID because env mode needs NEITHER: requiring them would
# make a perfectly deliverable command fall back to a bare shell over a variable it never reads.
[ -n "${CC_PANE_CMD:-}" ] && _launch "$CC_PANE_CMD"

[ -n "$_dir" ] || _fallback "CC_PANE_CMD_DIR is unset"
[ -n "$_id" ]  || _fallback "KITTY_WINDOW_ID is unset (not a kitty window?)"

_cmdfile="$_dir/$_id.cmd"
_armed="$_dir/$_id.armed"

# Poll rather than block on a FIFO. A FIFO would make the ORDER of open() load-bearing between two
# processes that are started by different parents with no synchronisation between them — the writer
# (`it2 session run`) can legitimately arrive before this loop is reached, and a FIFO opened for
# write with no reader blocks the writer, i.e. it would hang Claude Code's spawn call. A regular file
# written atomically (tmp + mv) has no ordering requirement at all: the command either is there or is
# not, and arriving early is indistinguishable from arriving on time.
# NO COMMAND BY THE DEADLINE CLOSES THE PANE (2026-10-22). Reaching this loop at all means
# bin/it2-kitty's arm branch launched us as an AGENT pane, and the one party that would deliver to
# it has not: most often because the split's answer was lost (a client timeout under load — kitty
# finished the launch after it2-kitty had reported failure, so nobody holds this pane's id; 9 such
# shells sat ownerless on 2026-10-22). A shell here is a pane nobody will ever close. The other
# _fallback causes above (no state dir, not kitty) and an empty delivery keep the shell: those are
# a human's to read. CC_PANE_CLOSE_ON_EXIT=0 keeps it here too, and the close takes the same gates.
# The exit record comes FIRST (husk-panes-2026-10-22 F3, pane 101): without it cc-pane-close's
# never-launched arm has no evidence and refuses this pane forever. rc 124, claude_started=false.
# A refusal holds and closes itself, exactly as after a command (_end).
_no_command() {
  _guarded
  _pane_exit_prepare
  _pane_exit_record '<none>' 124 false
  _TAIL=close _WHY="received no command within ${_wait}s" _SAY_ON_KEEP="no command arrived within ${_wait}s"
  [ "${CC_PANE_CLOSE_ON_EXIT:-1}" = 0 ] && _TAIL=keep:kill-switch
  _PV_STATE=NOTHING _end "this armed agent pane" 124 0 false
}

_deadline=$(( $(date +%s) + _wait ))
while [ ! -f "$_cmdfile" ]; do
  [ "$(date +%s)" -ge "$_deadline" ] && _no_command
  # 50ms: fast enough that spawn latency is invisible next to a shell start-up, slow enough that a
  # pane idling for the full 300s costs ~6k wakeups rather than a busy core.
  sleep 0.05
done

_cmd="$(cat "$_cmdfile" 2>/dev/null)"

# Consume BOTH markers before running. Removing `.armed` is what returns this pane to the legacy
# typing transport for any SUBSEQUENT send/run — after the exec below there is a real program (and
# later a real prompt) here, so a second command must reach it the way it always did. Leaving the
# marker would silently swallow every later command into a file nobody reads.
rm -f "$_cmdfile" "$_armed" 2>/dev/null

[ -n "$_cmd" ] || _fallback "the delivered command was empty"

# _launch says what it is starting first (_launch_line: one short line, the full command in the
# cc-say log), and that line keeps the `--agent-name <n>` anchor cc-spawn-verify reads. It never
# returns — it ends in a closed pane, a hold that closes itself, or a kept shell (_end).
_launch "$_cmd"
