#!/bin/bash
# cc-pane-runner — the argv of a freshly-split agent pane, so the pane's COMMAND never has to be
# TYPED at an interactive prompt.
#
# ── WHY THIS FILE EXISTS (plan §9.1, measured 2026-08-03) ────────────────────────────────────────
# Claude Code's ITermBackend delivers a teammate's launch command by TYPING it:
#
#   sendCommandToPane(paneId, cmd)  →  it2 session send -s <id> $'\x15'   (Ctrl-U, clear the line)
#                                      it2 session run  -s <id> <cmd>     (the text, then Enter)
#
# Those are TWO separate process spawns against ONE mutable resource — the pane's prompt line, which
# the human also owns. On 2026-08-03 a 7-way fan-out lost two agents to exactly that race: the
# operator's own in-flight keystroke landed BETWEEN the Ctrl-U and the payload, concatenating into
# `ccd …` (command not found) and `tcd …` (parked forever on zsh's `correct 'tcd' to 'cd' [nyae]?`).
# Both single-character corruptions; both silent to the parent, which reported "Spawned successfully".
#
# It cannot be fixed by better escaping or better timing. Correctness would require that the operator
# not be typing, which is neither knowable nor enforceable. Note that Claude Code's OWN tmux backend
# already does the right thing —
#
#   TmuxBackend.sendCommandToPane → tmux respawn-pane -k -t <pane> -- <cmd>   ← the pane's argv IS
#                                                                              the command
#
# — so the defect is confined to the iTerm2 backend, and the remedy is to give kitty the same shape.
#
# ── THE ONE-HOP DEFERRAL, AND WHY IT IS NEEDED ───────────────────────────────────────────────────
# kitty CAN launch a window whose argv is a command, but Claude Code's protocol does not hand us the
# command at split time — it splits first and sends the text afterwards. So `split` launches THIS
# file instead of an interactive shell, and `run` DROPS THE COMMAND AS A FILE which this file is
# already blocked waiting on. No prompt line is ever involved: there is no line to collide with, no
# ZLE to race, no spell-correction to trigger, and the operator's keystrokes cannot become argv.
#
# ── ENV PARITY IS LOAD-BEARING, AND IT IS WHY THE LAUNCH ARGV IS `zsh -l -i -c` ──────────────────
# The pane a teammate runs in is not a bare process host: ~/.zprofile puts ~/.claude/shims on PATH
# (the login-PATH race, plan §8.4) and ~/.zshrc synthesizes ITERM_SESSION_ID="w0t0p0:$KITTY_WINDOW_ID"
# (the pane identity every hook, cc-notify address and two-way-comms registration is keyed on). A
# runner exec'd from a NON-login, NON-interactive shell would silently produce agents with no PATH
# and no addressable pane identity — alive and unreachable, which is worse than dead.
#
#   bin/it2-kitty launches:  <shell> -l -i -c 'exec "$CC_PANE_RUNNER"'
#
# `-l` reads .zprofile, `-i` reads .zshrc, and both run BEFORE this file, so everything they export is
# inherited here. Measured on kitty 0.48.2 / zsh, pane 331: ITERM_SESSION_ID=w0t0p0:331 (the NEW
# pane's own id, not the leader's), shims on PATH, --env values present.
#
# ── AFTER THE COMMAND, THE PANE BECOMES AN ORDINARY SHELL ────────────────────────────────────────
# Exact parity with the pane this replaced: today's split yields an interactive shell that runs the
# command and returns to a prompt. So do we — `exec` an interactive login shell when the command
# returns. That also keeps every LATER `it2 session run/send` against this pane behaving as it always
# did (there is a real prompt to type at again), which is what makes this change safe for the
# multi-send callers that legitimately type.
#
# Env contract (all set by bin/it2-kitty split):
#   CC_PANE_CMD_DIR   directory holding <pane-id>.armed / <pane-id>.cmd
#   KITTY_WINDOW_ID   set by kitty in the new window; THIS pane's id, and the key for both files
#   CC_PANE_CMD_WAIT_S  how long to wait for a command before giving up (default 300)

set -u

_dir="${CC_PANE_CMD_DIR:-}"
_id="${KITTY_WINDOW_ID:-}"
_wait="${CC_PANE_CMD_WAIT_S:-300}"

# The fallback is an ORDINARY SHELL, never an exit. A pane that vanishes because a variable was unset
# takes its diagnostic with it; a pane sitting at a prompt can be read by the operator and by the
# `session list` liveness probe, and Claude Code's dead-pane pruning will not mistake it for gone.
_fallback() {
  [ -n "${1:-}" ] && printf 'cc-pane-runner: %s — this pane is an ordinary shell.\n' "$1" >&2
  exec "${SHELL:-/bin/zsh}" -l -i
}

# ── RUNNING THE COMMAND: two eval shells, because two callers name things differently ────────────
# eval (default) — Claude Code hands over an ABSOLUTE PATH to a binary. Running it in THIS shell is
#   what lets an `exec …` inside the command replace this process, exactly as it would at a prompt.
# `$SHELL -l -i -c` (CC_PANE_CMD_INTERACTIVE=1) — scripts/handoff-fire.sh hands over a SHELL COMMAND
#   LINE whose verb is a launcher (`claude4`, `nocorrect claude4 …`). Measured on this box: those
#   launchers are zsh FUNCTIONS defined only in the operator's INTERACTIVE rc —
#     zsh -l -i -c 'whence -w claude4'  → claude4: function      ← resolves
#     zsh -l -c    'whence -w claude4'  → not found              ← -i is load-bearing, not -l
#     bash -lc     'type -t claude4'    → not found              ← this file's own shebang
#   so an `eval` here (bash) would print the command and die on `command not found`, i.e. delivering
#   handoff's command as argv would be WORSE than typing it. This branch is what makes the argv
#   transport usable by handoff at all; it is not a stylistic alternative to eval.
# `nocorrect` survives it (a zsh reserved word, verified under -l -i -c), so the shared $CMD shapes —
# which tests/handoff-fire-typed-cmd-correctable.bats pins — need no argv-specific variant.
# ── STARTUP-WEDGE WATCHDOG (backlog 71908843ff77) ────────────────────────────────────────────────
# This file is the chokepoint every kitty-spawned agent pane passes through, and it is the only
# place that sees the launch BEFORE the command runs — so it is where the census
# (docs/research/cc-startup-modals-2026-08-04.md §3) put the detector for the one failure mode that
# no other instrument on this box can see: a session stopped at a blocking startup modal. The pane
# is alive, the process is alive, SessionStart never fires, so there is no cc-registry row, no
# telemetry row and no transcript. cc-spawn-verify reports `0 RUNNING` because the process really
# does exist. The brief is never run and nothing notices.
#
# ARM ONLY FOR A CLAUDE SESSION. This runner transports whatever command it is handed; a monitor,
# a probe or a plain shell has no assistant turn to produce and no composer to render, so arming
# on one would page a pane that is behaving exactly as intended. The verb is matched, not the whole
# line, so a `--append-system-prompt` that merely MENTIONS claude cannot arm it.
#
# ── `claude.exe` IS THE TEAMMATE SPELLING, AND OMITTING IT LEFT TEAM PANES UNWATCHED ─────────────
# Backlog `bc50117059ac` (spawn start-ack) ranks the un-acked spawn surfaces by who survives to
# notice: handoff successor FIRST, then TEAM PANES, subagents last. The handoff arm has been
# fail-closed since 0a4c8c9c (handoff-fire.sh:verify_engagement, exit 1 on all three failure
# verdicts). The team-pane arm reached this gate and fell out of it.
#
# Agent-Teams teammate panes arrive here through the FILE delivery mode below — Claude Code splits
# first and sends the command afterwards — so a teammate's launch command IS transported by this
# runner and DOES reach this function. It simply never matched: the verb is `claude.exe`, and
# `claude-*` does not match a dot. Two independent measurements name that spelling as the teammate
# population, not a variant of it:
#   · scripts/capacity-alarm.sh:583 — sessions launch under TWO DISJOINT spellings,
#     `.../claude-code/bin/claude.exe` (measured ≡ exactly the `--agent-id` teammate set) and
#     `.../node_modules/.bin/claude` (the interactive launcher). Measured intersection: ZERO.
#   · hooks/lib/agent-identity.sh:14 — the measured 2.1.220 teammate argv is
#     `claude.exe --agent-id <n>@session-<t> --agent-name <n> --team-name <t> …`.
# So the incumbent set covered the launcher family and nothing else, and the surface the backlog
# item ranks SECOND was the one surface with no watchdog at all.
#
# WHAT THE WATCHDOG CAN AND CANNOT SEE HERE, stated because it is NOT the same as for a launcher
# pane. cc-wedge-watch is a conjunction: WEDGED := NOT engaged(assistant turn) AND NOT ui_up(screen).
# For a teammate its FIRST axis is structurally blind — an assignee pane has no cc-registry row at
# all (134/134, hooks/lib/lead-crash-watchdog.sh:596), so cc_engaged_pane returns 1 with
# `no-registry-row` every time (hooks/lib/engagement.sh:99-105 — a clean, reasoned abstain, not an
# error). The verdict therefore rests entirely on the SUPPRESSOR: a healthy teammate renders CC's
# composer/auto-mode footer and reads ENGAGED via `proof=ui-anchor`; a teammate that died at the
# shell or stalled on a startup modal renders neither and pages. That is the designed degradation
# (the conjunction exists so either axis alone cannot convict), but it means the anchor set is
# load-bearing on this path — `cc-wedge-watch --calibrate` is the guard that it still matches the
# live fleet, and it exits 3 when 0 of N panes match (memory: control-calibrated-to-implementation-
# decays; the prescribed `? for shortcuts` anchor measured 0/23 live four days after it was written).
#
# BLAST RADIUS. A side-car must fail no wider than itself (memory:
# addon-failure-exceeds-its-blast-radius). Everything below is unset-safe, non-fatal, backgrounded,
# and — load-bearing in a pane launcher — has all three fds redirected to /dev/null. A background
# child that keeps the pane's stdout/stderr open is how 43 wrappers once sat pinned for 10h on one
# orphan's fd2 (memory: procsub-pid-is-unreachable-own-the-pipe).
_arm_wedge_watch() { # $1=the command about to run
  [ "${CC_PANE_WEDGE_WATCH:-1}" = 0 ] && return 0
  [ -n "${KITTY_WINDOW_ID:-}" ] || return 0

  # The launch VERB: strip a leading `nocorrect`, take the first word, then its basename.
  # `claude.exe` is listed as an EXACT spelling, not as `claude.*`: the two families above are the
  # two that were measured, and a wildcard here would annex any future `claude.<anything>` — a probe,
  # a wrapper, a shim — into a pager that has no business watching it (memory:
  # denylist-enumerates-spellings-not-the-class — widening past the evidence is the twin defect of
  # missing a spelling, and this gate has now made both mistakes once).
  local _v="${1#nocorrect }"; _v="${_v%% *}"; _v="${_v##*/}"
  case "$_v" in
    claude|claude[0-9]|claude-*|claude.exe|fable|fable[0-9]|cc) ;;
    *) return 0 ;;
  esac

  # Resolve THIS file's real directory (it is reached through ~/.claude/bin's per-file symlinks as
  # often as through the checkout), then fall back to the live layer. Every candidate is
  # unset-guarded: a bare $HOME here would abort the whole runner under `set -u` and take the pane's
  # command with it — the resolver failing wider than the thing it resolves.
  local _s="$0" _t _sd _c _w=""
  while [ -L "$_s" ]; do
    _t="$(readlink "$_s" 2>/dev/null)" || break
    case "$_t" in /*) _s="$_t" ;; *) _s="$(dirname "$_s")/$_t" ;; esac
  done
  _sd="$(cd "$(dirname "$_s")" 2>/dev/null && pwd)" || _sd=""
  for _c in "${_sd:+$_sd/cc-wedge-watch}" "${HOME:-}/.claude/bin/cc-wedge-watch"; do
    [ -n "$_c" ] && [ -x "$_c" ] && { _w="$_c"; break; }
  done
  [ -n "$_w" ] || return 0

  ( "$_w" --pane "$KITTY_WINDOW_ID" --label "${_v}" >/dev/null 2>&1 </dev/null & ) >/dev/null 2>&1
  return 0
}

_launch() { # $1=command — never returns
  printf '%s\n' "$1"
  # CONSUME the env-mode delivery record before running it — the exact analogue of the `rm -f` the
  # file path does below, and for the mirror-image reason. `kitty @ launch --env` puts these two in
  # the PANE's environment, so they are inherited by the command this file runs and by every
  # DESCENDANT of it: a delivery record that outlives its delivery by the entire life of the pane.
  # Measured 2026-08-07 in a pane scripts/handoff-fire.sh had fired — the agent session it started
  # still carried the launch line that started IT, so `bin/it2-kitty session split` run inside that
  # session read the ancestor's spent CC_PANE_CMD as its own caller's intent (it2-kitty:626),
  # forwarded it as `--env CC_PANE_CMD=<the parent's own handoff command>`, and did NOT arm the new
  # pane. The child would have re-run the PARENT's launch, while the command Claude Code actually
  # meant for it was typed at a pane with no prompt to receive it. Non-emptiness is not provenance
  # (memory: second-transport-makes-an-e2e-ambient); consuming the record is what restores it.
  # Read the mode FIRST: it is half of the same record, and the branch below still needs it.
  local _interactive="${CC_PANE_CMD_INTERACTIVE:-0}"
  unset CC_PANE_CMD CC_PANE_CMD_INTERACTIVE
  _arm_wedge_watch "$1"
  # `set +u` FIRST — and it is parity, not laxity. The command this file runs used to be typed at an
  # interactive zsh where nounset is off; inheriting THIS file's `set -u` into it would abort any
  # command that reads an unset variable, i.e. this file would change the meaning of commands it is
  # only supposed to transport. The guard exists for the runner's own logic above, and its job is done.
  set +u
  if [ "$_interactive" = 1 ]; then
    "${SHELL:-/bin/zsh}" -l -i -c "$1"
  else
    eval "$1"
  fi
  _fallback ""
}

# ── TWO DELIVERY MODES, because the two callers learn the command at different times ─────────────
# ENV (CC_PANE_CMD non-empty) — the command was known BEFORE this pane existed, so it rode in on the
#   launch itself: there is nothing to wait for, no id-keyed file, and NO WINDOW IN WHICH ANYTHING
#   COULD RACE IT. scripts/handoff-fire.sh works this way — it BUILDS the launch line and only then
#   creates the surface, so it can hand the command over as argv+env in one atomic act.
# FILE (CC_PANE_CMD unset) — Claude Code's protocol splits first and sends the command afterwards, so
#   the command can only arrive later and must be polled for. The original mode, unchanged below.
# Checked before CC_PANE_CMD_DIR/KITTY_WINDOW_ID because env mode needs NEITHER: requiring them would
# make a perfectly deliverable command fall back to a bare shell over a variable it never reads.
[ -n "${CC_PANE_CMD:-}" ] && _launch "$CC_PANE_CMD"

[ -n "$_dir" ] || _fallback "CC_PANE_CMD_DIR is unset"
[ -n "$_id" ]  || _fallback "KITTY_WINDOW_ID is unset (not a kitty window?)"

_cmdfile="$_dir/$_id.cmd"
_armed="$_dir/$_id.armed"

# Poll rather than block on a FIFO. A FIFO would make the ORDER of open() load-bearing between two
# processes that are started by different parents with no synchronisation between them — the writer
# (`it2 session run`) can legitimately arrive before this loop is reached, and a FIFO opened for
# write with no reader blocks the writer, i.e. it would hang Claude Code's spawn call. A regular file
# written atomically (tmp + mv) has no ordering requirement at all: the command either is there or is
# not, and arriving early is indistinguishable from arriving on time.
_deadline=$(( $(date +%s) + _wait ))
while [ ! -f "$_cmdfile" ]; do
  [ "$(date +%s)" -ge "$_deadline" ] && _fallback "no command arrived within ${_wait}s"
  # 50ms: fast enough that spawn latency is invisible next to a shell start-up, slow enough that a
  # pane idling for the full 300s costs ~6k wakeups rather than a busy core.
  sleep 0.05
done

_cmd="$(cat "$_cmdfile" 2>/dev/null)"

# Consume BOTH markers before running. Removing `.armed` is what returns this pane to the legacy
# typing transport for any SUBSEQUENT send/run — after the exec below there is a real program (and
# later a real prompt) here, so a second command must reach it the way it always did. Leaving the
# marker would silently swallow every later command into a file nobody reads.
rm -f "$_cmdfile" "$_armed" 2>/dev/null

[ -n "$_cmd" ] || _fallback "the delivered command was empty"

# _launch echoes the command first: the operator watching this pane sees the same line they would
# have seen typed, and a `kitty @ get-text` progress probe has something to anchor on. It never
# returns — it ends in a shell either way.
_launch "$_cmd"
