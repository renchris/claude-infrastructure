#!/bin/bash
# cc-notify — deliver a message to ANY Claude Code session (any account) by friendly name or pane UUID,
# as a MESSAGE it reads at a safe boundary — NEVER as keystrokes on its live input line.
#
#   cc-notify <target> "<message>"   target = friendly-name | pane-UUID | --self
#   cc-notify --role <name> "<msg>"  target = a ROLE (desk/operator/…), resolved at SEND time
#   cc-notify --cloud <id> "<msg>"   target = an OFF-BOX cloud session (no pane, no inbox — §9.2)
#   cc-notify --self                 print THIS session's pane UUID and exit
#   cc-notify --list [--json]        list sessions (delegates to cc-sessions)
#   cc-notify --receipt <t> <line>   did they READ it? rc 0 = read · 1 = not read (line from the send)
#
# Options:
#   --role <name>     address a ROLE, not a pane: reads ~/.claude/cc-roles/<name> at SEND time, so a
#                     recycled/succeeded pane is followed automatically. PREFER THIS for any automated
#                     pager (see ADDRESSING below). Missing/empty role file → exit 3.
#   --cloud <id>      address an OFF-BOX cloud session by its session id — a FOURTH address KIND with
#                     no pane uuid and no inbox file, so it never enters the role/forward/uuid
#                     resolver at all. Undeclared to cc-cloud → exit 3 (an undeclared cloud target is
#                     unobservable, so "delivered" about it could never be checked). See OFF-BOX below.
#                     --receipt on a --cloud target exits 7 = UNKNOWN, NEVER 0: the API's {ok:true} is
#                     QUEUED, and off-box there is no `acked` cursor that could make it READ.
#   --from <name>     attribution written to the inbox line (default: own registered name / account)
#   --mailbox-only    force inbox-only (skip the liveness classification / never a "not-live" note)
#   --receipt         READ side of the cursor a send prints. DELIVERED IS NOT READ — a claim that a
#                     session was told must cite acked≥line, never the send. rc 0 = read.
#   -h, --help        this help
#
# ── TRANSPORT (v2, 2026-07-20): the INBOX, drained at a safe boundary — NO keystroke injection ──
#   cc-notify APPENDS the message to the target's inbox ~/.claude/mailbox/<uuid>.md (one line:
#   "<ISO> [<from>] <message>"). The target's `hooks/mailbox-drain.sh` drains it and surfaces it as
#   CONTEXT — additionalContext on SessionStart/UserPromptSubmit, or a Stop decision:block reason —
#   so it ALWAYS lands as a message the session reads and NEVER races the user's typing (at a Claude
#   prompt OR a bash prompt). An idle session is woken by its own armed `cc-await-ping` watcher (which
#   polls this same inbox) → the harness task-completion notification re-invokes it. Non-keystroke,
#   robust to pane state. The v1 it2 `session send` transport is GONE — it raced live input (the exact
#   bug this replaces): at a bash prompt the surface text ran as a command; at a Claude prompt it
#   corrupted the half-typed message + cursor.
#
# The <uuid>.seen line-count cursor (shared with handoff-disposition.sh --ack and mailbox-drain.sh)
# makes delivery exactly-once. A single-line-per-message invariant is preserved (newlines in the
# message are collapsed to spaces) so the cursor counts messages, not physical lines.
#
# ── ADDRESSING (v3, 2026-07-20): a pane UUID is a STALE address the moment that pane recycles ──
#   Live forensics found 570 pages looping into ONE dead former-desk box for three days: producers had
#   snapshotted a UUID once and nothing ever re-resolved it. Three layers now make an address survive
#   a recycle — applied in this order, before the liveness verdict:
#     1. --role <name>   resolved at SEND time from ~/.claude/cc-roles/<name> (the same file
#                        cc-await-ping --role re-reads per poll). An automated pager should address a
#                        ROLE, never a frozen uuid. This is also the form scripts/payload-lint.sh:50
#                        already blesses as a sanctioned back-channel (P0-15) — the flag now exists.
#     2. forward chain   <uuid>.forward, written by handoff-fire at succession, followed here to the
#                        chain head (bounded 4 hops, cycle-safe — hooks/lib/mailbox-pending.sh).
#     3. reroute         a target that is not live — whether unforwarded, or forwarded to a chain head
#                        that is ALSO dead — would enqueue into a box nothing will ever drain. The line
#                        is still recorded there (forensics are never lost), AND tee'd to the desk
#                        role's box tagged "[for:<orig-uuid>]" so mail lands where triage happens
#                        instead of rotting. "the desk is the standing triager" is asserted ONLY when
#                        that desk box itself passes the liveness test — a desk that is down is
#                        reported as recorded-with-no-proven-reader, never as a reroute that worked.
#
# ── DELIVERABILITY (honest exit codes — an enqueue to a DEAD inbox must not read as delivered) ──
#   The target's liveness decides the verdict cc-announce trusts. A LIVE session (registered live in
#   cc-sessions, or a live iTerm2 pane) WILL drain the inbox → "delivered to inbox". A NOT-live target
#   (closed/recycled pane, dead pid) is enqueued but no drain will ever run → "mailbox only" (the
#   cc-announce alarm path; disk-truth that nothing reads is NOT a delivery — the W5 lesson holds).
#   A reroute does NOT upgrade that verdict to "delivered": stderr stays honest ("mailbox only …
#   rerouted to desk"), because the ORIGINAL addressee still did not receive it.
#
# ── RESOLVER AVAILABILITY (v4, 2026-07-25): the resolver must not depend on a BLOCKING subprocess ──
#   Measured: `it2 session list --json` — an IPC call into iTerm2's Python API — exceeded 120s under
#   pane load 13-16, at 2% CPU (blocked on IPC, not computing; `cc-sessions --json` clocked 72s wall
#   for 1.86s of CPU). cc-notify reached that call on BOTH of its hot paths — name resolution (via
#   `cc-sessions --json`) and the liveness verdict (via cc-sessions AND a direct call of its own) — so
#   under load a send either hung or returned rc=3 "cannot resolve target … not a live session name or
#   a pane UUID". That message names the TARGET as the fault when the target was valid and the RESOLVER
#   had simply timed out: an infrastructure outage reported as a user error. It cost this desk 6
#   non-delivered advisories across 3 attempts and 2 successively-wrong diagnoses.
#   Three properties now hold, at any load:
#     1. NAME RESOLUTION READS THE REGISTRY DIRECTLY (~/.claude/cc-registry/*.json — the same files
#        cc-sessions itself reads). One local `jq -s` over the set, liveness by `kill -0` (a bash
#        builtin, no fork). No IPC, so nothing to block on. The live-rows-only ADDRESSING contract
#        (cc-sessions' W4 property: a name never resolves onto a dead pane) is preserved on the pid
#        signal, and a name matching only dead rows stays unresolvable.
#     2. EVERY REMAINING it2 CALL IS BOUNDED (CC_IT2_TIMEOUT_S, default 5s) and degrades into the
#        "unknown liveness" branch this tool already models — never into a hang.
#     3. "RESOLVER UNAVAILABLE" IS ITS OWN EXIT CODE (4), distinct from "target unknown" (3).
#
# ── THE CALLER CONTRACT (2026-07-26): an exit code the CALLER never gets to see ─────────────────────
#   The resolver-availability rewrite above made cc-notify's OWN rc honest. It cannot make the rc a
#   caller sees honest, because a caller that BOUNDS this tool overwrites it: the desk's
#   `timeout 90 cc-notify …` during the 04:40Z incident returned 124 and NOTHING on stderr, while the
#   message had in fact already been enqueued (reproduced against the post-rewrite binary: rc 124,
#   empty stderr, the line present in the target's inbox). A caller could only guess, and guessing
#   "undelivered" means re-sending a message that landed; guessing "delivered" means losing one that
#   did not. Backlog 0298535c1584 fix direction (c).
#
#   So every terminal path prints a machine-parseable token FIRST, ahead of the human sentence (which
#   is unchanged — cc-announce, completion-push.sh and desk-invariant.sh all grep the prose):
#
#     cc-notify: verdict=<delivered|mailbox-only|unverified|unresolvable|degraded|ambiguous
#                         |undelivered|interrupted> enqueued=<0|1> uuid=<u> [reason=…]
#
#   `enqueued=1` is the load-bearing field: the message is DURABLY in the inbox, whatever happened to
#   the liveness verdict or to this process. A TERM/INT/HUP trap prints the same token, which is what
#   makes the bounded-caller case readable at all — `timeout` reports 124 regardless of what the child
#   exits with, so stderr is the ONLY channel left. Callers MUST read `enqueued=` before treating a
#   non-zero rc as a lost message; cc-announce does.
#
# ── OFF-BOX (--cloud, 2026-08-08): a FOURTH address KIND, dispatched before everything above ───────
#   docs/plans/CLOUD_OBSERVABILITY.md §9.2 is the SSOT for this path; the three steps below are its
#   three steps, in its order. A session running in an Anthropic-managed VM shares no filesystem with
#   this box: it has NO pane uuid and NO inbox file, so it cannot enter the role → forward-chain →
#   uuid resolver, and the liveness classification below has nothing to classify. It is therefore
#   dispatched FIRST, and its own three steps are the whole path:
#     1. `cc-cloud is-offbox <id>` → REFUSE (exit 3) if undeclared. An undeclared cloud target is
#        unobservable, so a "delivered" claim about it could never be checked — the one thing this
#        tool exists not to emit.
#     2. `claude -p "<message>" --cloud <id> --output-format json`. Transport VALIDATED 2026-08-08
#        against a live session with no pty and stdin closed → {"ok":true,"session_id":…,"url":…}.
#     3. ok:true  → record the send in the declaration's sidecar (<id>.sends under CC_CLOUD_STATE),
#                   INCLUDING the returned url, so the send is later checkable at all.
#        ok:false → exit 8 carrying the API's OWN reason, never a bare failure.
#
#   🚨 QUEUED IS NOT READ, and off-box there is no cursor that could ever upgrade it. The local
#   receipt is a line-count over the target's inbox (<uuid>.seen ≥ line); a cloud target has neither
#   the file nor an `acked` field, and {ok:true} is an ACK FROM A QUEUE. So `--receipt` on a --cloud
#   target exits 7 = UNKNOWN — distinct from the local rc 1 ("not read", a fact we measured) because
#   UNKNOWN is not a measurement at all. Returning 0 here would rebuild exactly the false confidence
#   this file's whole DELIVERED-IS-NOT-READ apparatus was paid for.
#
#   The `--cloud` FLAG ITSELF is version-dependent: present-but-hidden on CC 2.1.220, ABSENT on the
#   2.1.114 stable pin. `--help` cannot answer that (it does not list hidden flags), so support is
#   decided from the REAL call's own refusal — an "unknown option --cloud" is reported as exactly
#   that (exit 4, transport unavailable: the target is UNVERIFIED, not invalid), never as a generic
#   failure that reads like the session rejected the message.
#
# Resolution order: --cloud (off-box, first — see above) -> --role (cc-roles) -> friendly name
#   (exact, cc-registry, LIVE rows) -> raw pane UUID passthrough -> unambiguous UUID PREFIX (>=8 hex
#   — what `--list` prints) -> --self; then the forward chain.
# Env overrides (tests): CC_REGISTRY_DIR, CC_MAILBOX_DIR, CC_ROLES_DIR, CC_COMMS_ALARM_DIR, IT2_BIN,
#   CC_IT2_TIMEOUT_S, CC_CLOUD_BIN, CC_CLAUDE_BIN, CC_CLOUD_STATE.
# bash 3.2-safe. Exit: 0 = enqueued (delivered to a live inbox, OR mailbox-only to a not-live/unknown-
#   liveness target, possibly rerouted — stderr says which); 2 = usage; 3 = target genuinely UNKNOWN
#   (the registry was readable and holds no such name/uuid; incl. a missing/empty --role file, and an
#   UNDECLARED --cloud id);
#   4 = RESOLVER UNAVAILABLE (the registry could not be read — the target may well be valid; retry,
#   do NOT treat as a bad address; also: no claude binary / a claude binary with no --cloud flag);
#   6 = AMBIGUOUS uuid prefix (>1 pane matches — name one exactly);
#   5 = inbox UNWRITABLE (LOUD — a message that cannot even persist must alarm, never a silent drop);
#   7 = --receipt on a --cloud target: UNKNOWN, and unknowably so (never 0, never the measured 1);
#   8 = a --cloud send the API REFUSED (ok:false, or an unparseable answer) — stderr carries its reason;
#   124 = killed by a signal mid-send (a caller's own bound fired) — read `enqueued=` on stderr to
#   learn whether the message persisted; the rc alone cannot tell you.
set -uo pipefail

MAILBOX_DIR="${CC_MAILBOX_DIR:-$HOME/.claude/mailbox}"

# ── SENT-BODY ECHO (operator request 2026-07-28) ────────────────────────────────────────────────
# The receiver renders inbound mail as a block behind a left rule (hooks/mailbox-drain.sh); echo
# the OUTBOUND body behind the same rule so a hop looks like one channel from both ends. stderr
# only, after the verdict line, and never parsed — every token cc-announce greps is on its own
# line above this. Truncated so a long body cannot flood a tool result.
_echo_sent() {
  [ -n "${MSG:-}" ] || return 0
  printf '%s' "$MSG" | awk 'NR==1{ if (length($0)>120) print "  \xe2\x94\x82 " substr($0,1,117) "\xe2\x80\xa6"; else print "  \xe2\x94\x82 " $0 }
                            NR==2{ print "  \xe2\x94\x82 \xe2\x80\xa6"; exit }' >&2
}

ROLES_DIR="${CC_ROLES_DIR:-$HOME/.claude/cc-roles}"   # role → CURRENT pane uuid, re-read at SEND time
DESK_ROLE="${CC_DESK_ROLE:-desk}"                     # the standing triager reroutes land on
IT2="${IT2_BIN:-$HOME/.claude/bin/it2}"     # read-only here (session list, for pane liveness) — NEVER `session send`

# Forward-chain primitives (D1). Sourced best-effort from the sibling hooks/lib, then the live layer:
# cc-notify must still WORK if the lib is missing, so every use is guarded by a function-exists check —
# a missing lib degrades to "no forward following", never a hard failure on the send path.
for _cand in "$(dirname "$0")/../hooks/lib/mailbox-pending.sh" \
             "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/lib/mailbox-pending.sh" \
             "$HOME/.claude/hooks/lib/mailbox-pending.sh"; do
  # shellcheck source=../hooks/lib/mailbox-pending.sh
  # shellcheck disable=SC1091
  [ -f "$_cand" ] && { . "$_cand" 2>/dev/null || true; break; }
done

# The usage block is lines 2-26 of THIS file. The range is hard-coded, so a flag documented OUTSIDE
# it is a flag `--help` never mentions: extend the range whenever the block grows (a stale range is
# how help goes silently out of date about a flag that exists).
usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

# cc-sessions lives beside cc-notify (same bin/). Prefer the sibling (deterministic for tests +
# symlinked deploys), then PATH, then the canonical ~/.claude/bin. It is BOTH the name resolver and
# the liveness oracle (its --json lists LIVE sessions only: pid alive + pane present).
_sd="$(cd "$(dirname "$0")" 2>/dev/null && pwd || true)"

# ── comms-alarm chokepoint lib (the alarm store's hermeticity guard; see hooks/lib/comms-alarm.sh) ──
# Three candidates, in order: the checkout reached by resolving $0 THROUGH its symlinks, the plain
# sibling ../hooks/lib, then the deployed ~/.claude/hooks/lib. The symlink-resolved candidate is
# first and is the load-bearing one: ~/.claude/bin/cc-notify is a per-file symlink into the checkout,
# so a bare dirname "$0" yields ~/.claude/bin and finds only the DEPLOYED lib — which does not hold a
# brand-new tracked file until install.sh re-globs hooks/lib/*.sh on the next deploy. Resolving first
# means the guard is live from the moment it is committed, with no deploy-lag window.
_ca_self="$0"
while [ -L "$_ca_self" ]; do
  _ca_l="$(readlink "$_ca_self")"
  if [ "${_ca_l#/}" != "$_ca_l" ]; then _ca_self="$_ca_l"; else _ca_self="$(dirname "$_ca_self")/$_ca_l"; fi
done
_ca_root="$(cd "$(dirname "$_ca_self")/.." 2>/dev/null && pwd || true)"
for _ca_lib in "$_ca_root/hooks/lib/comms-alarm.sh" "$_sd/../hooks/lib/comms-alarm.sh" "$HOME/.claude/hooks/lib/comms-alarm.sh"; do
  if [ -f "$_ca_lib" ]; then
    # shellcheck source=/dev/null
    . "$_ca_lib" 2>/dev/null && command -v comms_alarm_write >/dev/null 2>&1 && break
  fi
done

CCS=""
if   [ -n "$_sd" ] && [ -x "$_sd/cc-sessions" ]; then CCS="$_sd/cc-sessions"
elif command -v cc-sessions >/dev/null 2>&1;     then CCS="$(command -v cc-sessions)"
elif [ -x "$HOME/.claude/bin/cc-sessions" ];      then CCS="$HOME/.claude/bin/cc-sessions"
fi

command -v jq >/dev/null 2>&1 || { echo "cc-notify: jq required" >&2; exit 1; }

REG_DIR="${CC_REGISTRY_DIR:-$HOME/.claude/cc-registry}"

# --- the registry, read DIRECTLY (v4) — the resolver's only input, and it cannot block ------------
# cc-sessions reads these same files; going straight to them removes the it2 IPC hop that was the
# measured hang. Cached in one variable so a single send parses the set at most once.
# Rows are "<name>\t<pid>\t<paneUUID>". REG_RC: 0 = read OK (a miss is then a REAL unknown target),
# 1 = the registry could not be read (a miss means NOTHING — that is exit 4, never exit 3).
REG_ROWS=""; REG_RC=-1
registry_load() {
  [ "$REG_RC" -ge 0 ] && return "$REG_RC"      # parse once per invocation
  local f any=0 out
  # -r and -x both matter: without them the glob below silently yields nothing, and an UNREADABLE
  # registry would masquerade as an EMPTY one — i.e. a resolver outage reported as "unknown target",
  # the precise conflation this version exists to end.
  if [ ! -d "$REG_DIR" ] || [ ! -r "$REG_DIR" ] || [ ! -x "$REG_DIR" ]; then REG_RC=1; return 1; fi
  for f in "$REG_DIR"/*.json; do [ -e "$f" ] && { any=1; break; }; done
  if [ "$any" = 0 ]; then REG_ROWS=""; REG_RC=0; return 0; fi   # readable but EMPTY: a real "unknown"
  # Fast path: ONE jq over the whole set. A single corrupt row fails `jq -s` wholesale, which would
  # turn one bad file into a total resolver outage — so fall back to per-file parsing (N forks, but
  # only ever on the degraded path) and simply skip the rows that will not parse.
  if out="$(jq -s -r '.[] | select(type=="object")
                    | [(.name // ""), (.pid // ""), (.paneUUID // "")] | @tsv' \
              "$REG_DIR"/*.json 2>/dev/null)"; then
    REG_ROWS="$out"; REG_RC=0; return 0
  fi
  out=""
  for f in "$REG_DIR"/*.json; do
    [ -e "$f" ] || continue
    local row
    row="$(jq -r 'select(type=="object")
                | [(.name // ""), (.pid // ""), (.paneUUID // "")] | @tsv' "$f" 2>/dev/null)" || continue
    [ -n "$row" ] && out="${out}${row}
"
  done
  REG_ROWS="$out"; REG_RC=0; return 0
}

# `kill -0` is a bash BUILTIN — liveness for the whole registry costs zero forks.
pid_live() { local p="$1"; case "$p" in ''|*[!0-9]*) return 1 ;; esac; kill -0 "$p" 2>/dev/null; }

# name → pane uuid, LIVE rows only (the W4 addressing contract: never resolve a name onto a dead
# pane). rc 0 = hit, 1 = readable-but-absent, 2 = registry unreadable.
registry_name_to_uuid() {
  local want="$1" n p u
  registry_load || return 2
  while IFS="$(printf '\t')" read -r n p u; do
    [ "$n" = "$want" ] && [ -n "$u" ] && pid_live "$p" && { printf '%s' "$u"; return 0; }
  done <<EOF
$REG_ROWS
EOF
  return 1
}

# uuid PREFIX → full uuid. `cc-notify --list` printed an 8-char column for years that its OWN input
# rejected; accepting the prefix closes that round-trip from the other side. Prefer a live pane, but
# a prefix names a PANE (like the full-uuid passthrough, which has always accepted dead ones), so a
# unique dead match still resolves — and the liveness verdict below stays honest about it.
# rc 0 = unique hit, 1 = no match, 2 = registry unreadable, 3 = AMBIGUOUS (never guess).
registry_prefix_to_uuid() {
  local want="$1" n p u lc_w lc_u hits="" live_hits="" n_hits=0 n_live=0
  registry_load || return 2
  # Both sides are compared DASH-STRIPPED and lower-cased, so "AAAAAAAA-1111", "aaaaaaaa1111" and the
  # full 32 hex digits all address the same pane. The value RETURNED is still the canonical dashed
  # uuid ($u), because that is what every downstream consumer (mailbox path, it2) expects.
  lc_w="$(printf '%s' "${want//-/}" | tr '[:upper:]' '[:lower:]')"
  while IFS="$(printf '\t')" read -r n p u; do
    [ -n "$u" ] || continue
    lc_u="$(printf '%s' "${u//-/}" | tr '[:upper:]' '[:lower:]')"
    case "$lc_u" in
      "$lc_w"*) hits="${hits}${u}
"; n_hits=$(( n_hits + 1 ))
                if pid_live "$p"; then live_hits="${live_hits}${u}
"; n_live=$(( n_live + 1 )); fi ;;
    esac
  done <<EOF
$REG_ROWS
EOF
  [ "$n_live" = 1 ] && { printf '%s' "$live_hits" | head -n1 | tr -d '\n'; return 0; }
  [ "$n_live" -gt 1 ] && { printf '%s' "$live_hits"; return 3; }
  [ "$n_hits" = 1 ] && { printf '%s' "$hits" | head -n1 | tr -d '\n'; return 0; }
  [ "$n_hits" -gt 1 ] && { printf '%s' "$hits"; return 3; }
  return 1
}

# --- BOUNDED it2 (v4) ------------------------------------------------------------------------------
# The one IPC call left on this path. It is the MEASURED hang (>120s alone under load), so it is
# bounded and a timeout degrades into the "unknown liveness" branch target_live() already models.
# Not factored into a shared lib on purpose: a brand-new tracked file is not symlinked into the live
# ~/.claude layer, so a shared helper would ship BROKEN until someone noticed. Twelve duplicated
# lines beat a new deploy unit (the twin lives in cc-sessions).
IT2_TIMEOUT_S="${CC_IT2_TIMEOUT_S:-5}"
_TO=""; for _c in timeout gtimeout; do command -v "$_c" >/dev/null 2>&1 && { _TO="$_c"; break; }; done
it2_list_bounded() {   # raw --json on stdout; rc != 0 on timeout/error
  [ -n "$IT2" ] && [ -x "$IT2" ] || return 1
  if [ -n "$_TO" ]; then "$_TO" "$IT2_TIMEOUT_S" "$IT2" session list --json 2>/dev/null; return $?; fi
  # No coreutils `timeout` on this box: bound it in pure bash rather than let the hang back in.
  local tmp bpid rc ticks=0 max=$(( IT2_TIMEOUT_S * 5 ))
  tmp="$(mktemp 2>/dev/null)" || return 1
  "$IT2" session list --json >"$tmp" 2>/dev/null & bpid=$!
  while kill -0 "$bpid" 2>/dev/null; do
    if [ "$ticks" -ge "$max" ]; then
      kill -TERM "$bpid" 2>/dev/null; wait "$bpid" 2>/dev/null; rm -f "$tmp"; return 1
    fi
    sleep 0.2 2>/dev/null || sleep 1; ticks=$(( ticks + 1 ))
  done
  wait "$bpid" 2>/dev/null; rc=$?
  cat "$tmp" 2>/dev/null; rm -f "$tmp"; return "$rc"
}

# --- the caller contract: one machine-parseable line per terminal outcome --------------------------
# Printed BEFORE the human sentence, never instead of it. `uuid` may not exist yet on the early
# failure paths, hence ${uuid:-}.
#
# CURSOR_LINE / UNACKED are the READ-RECEIPT fields (delivered ≠ read). They are empty until the
# message is actually persisted, so their presence in the token is itself the proof that a line
# exists to cite; every post-enqueue verdict carries them. See the enqueue site for why.
ENQUEUED=0; CURSOR_LINE=""; UNACKED=""
verdict() { # <verdict> [k=v ...]
  local v="$1"; shift
  printf 'cc-notify: verdict=%s enqueued=%s uuid=%s' "$v" "$ENQUEUED" "${uuid:-}" >&2
  [ -n "$CURSOR_LINE" ] && printf ' line=%s' "$CURSOR_LINE" >&2
  [ -n "$UNACKED" ]     && printf ' unacked=%s' "$UNACKED" >&2
  while [ $# -gt 0 ]; do printf ' %s' "$1" >&2; shift; done
  printf '\n' >&2
}

# `timeout` reports 124 whatever the child exits with, so on a bounded-caller kill this stderr line is
# the ONLY thing that can distinguish a persisted message from a lost one. Without it the incident's
# `timeout 90 cc-notify …` returned 124 and total silence over a message that HAD been enqueued.
# shellcheck disable=SC2329  # invoked indirectly by the `trap` below, which shellcheck cannot see
_on_signal() {
  verdict interrupted reason=signal
  if [ "$ENQUEUED" = 1 ]; then
    echo "cc-notify: killed by a signal mid-send — the message IS persisted in the target's inbox (the delivery stands; only the liveness verdict is missing)" >&2
  elif [ -n "${CLOUD_ID:-}" ]; then
    # The off-box path has no local durable step, so ENQUEUED=0 does NOT mean "nothing happened":
    # the API call may already have been accepted. Saying UNDELIVERED here would license a re-send
    # of a message that landed — the exact both-ways-wrong guess the CALLER CONTRACT above exists to
    # end. Name the ambiguity and point at the one artifact that can settle it.
    echo "cc-notify: killed by a signal mid --cloud send to [$CLOUD_ID] — the API call may or may not have been accepted; do NOT assume either. Check the send sidecar (cc-cloud show $CLOUD_ID / \$CC_CLOUD_STATE/$CLOUD_ID.sends) before re-sending." >&2
  else
    echo "cc-notify: killed by a signal BEFORE the message was persisted — treat as UNDELIVERED" >&2
  fi
  exit 124
}
trap _on_signal TERM INT HUP

# --- parse args ---
FROM=""; MAILBOX_ONLY=0; TARGET=""; MSG=""; HAVE_TARGET=0; HAVE_MSG=0; ROLE=""; ROLE_GIVEN=0; RECEIPT=0
CLOUD_ID=""; CLOUD_GIVEN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --list)         shift; if [ -n "$CCS" ]; then exec "$CCS" "$@"; else echo "cc-notify: cc-sessions not found" >&2; exit 1; fi ;;
    --self)         TARGET="__self__"; HAVE_TARGET=1; shift ;;
    --role)         ROLE="${2:-}"; HAVE_TARGET=1; ROLE_GIVEN=1; shift; [ $# -gt 0 ] && shift ;;
    --role=*)       ROLE="${1#--role=}"; HAVE_TARGET=1; ROLE_GIVEN=1; shift ;;
    # --cloud consumes the TARGET slot exactly as --role does, so the next positional is the MESSAGE.
    --cloud)        CLOUD_ID="${2:-}"; HAVE_TARGET=1; CLOUD_GIVEN=1; shift; [ $# -gt 0 ] && shift ;;
    --cloud=*)      CLOUD_ID="${1#--cloud=}"; HAVE_TARGET=1; CLOUD_GIVEN=1; shift ;;
    --mailbox-only) MAILBOX_ONLY=1; shift ;;
    --receipt)      RECEIPT=1; shift ;;
    --from)         FROM="${2:-}"; shift; [ $# -gt 0 ] && shift ;;
    --from=*)       FROM="${1#--from=}"; shift ;;
    -h|--help)      usage; exit 0 ;;
    --*)            echo "cc-notify: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    *)
      if   [ "$HAVE_TARGET" = 0 ]; then TARGET="$1"; HAVE_TARGET=1; shift
      elif [ "$HAVE_MSG" = 0 ];    then MSG="$1"; HAVE_MSG=1; shift
      else echo "cc-notify: too many arguments" >&2; usage >&2; exit 2; fi
      ;;
  esac
done

[ "$HAVE_TARGET" = 1 ] || { echo "cc-notify: no target given" >&2; usage >&2; exit 2; }

# --- resolve target -> pane UUID ---
own_uuid="${CC_PANE_ID:-${ITERM_SESSION_ID:-}}"; own_uuid="${own_uuid##*:}"

# --- attribution (default: own registered name, else account) ---
# Extracted so the OFF-BOX dispatch below and the local enqueue path further down share ONE
# definition of "who is speaking": the cloud path needs the same string, and it needs it before any
# uuid exists. Two copies would drift, and the attribution is what a recipient reads to decide
# whether to act on the message at all.
resolve_from() {
  [ -n "$FROM" ] && return 0
  local rdir="${CC_REGISTRY_DIR:-$HOME/.claude/cc-registry}"
  if [ -n "$own_uuid" ] && [ -f "$rdir/$own_uuid.json" ]; then
    FROM="$(jq -r '.name // empty' "$rdir/$own_uuid.json" 2>/dev/null)"
  fi
  [ -n "$FROM" ] || FROM="$(basename "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" | sed 's/^\.//')"
  return 0
}

# ══ OFF-BOX DISPATCH (--cloud) — see the OFF-BOX section of the header; SSOT is §9.2 ═══════════════
# FIRST, before role resolution / the forward chain / the liveness classification, because an
# off-box target is a different KIND of address rather than a different value of the same one: it
# has no pane uuid to resolve and no inbox file to enqueue into, so every layer below would be
# answering a question that does not apply to it.
if [ "$CLOUD_GIVEN" = 1 ]; then
  [ -n "$CLOUD_ID" ] || { echo "cc-notify: --cloud needs a session id (e.g. --cloud session_01ABC…)" >&2; usage >&2; exit 2; }
  # An off-box id and an on-box address are different KINDS, so accepting both would mean guessing
  # which one the caller meant. Refuse instead of picking.
  if [ "$ROLE_GIVEN" = 1 ] || [ -n "$TARGET" ]; then
    echo "cc-notify: --cloud cannot be combined with a pane/role target ('${TARGET:---role $ROLE}') — they are different address KINDS; name exactly one" >&2
    usage >&2; exit 2
  fi

  # ── SEAM: CC_CLOUD_BIN. SET, including set to EMPTY, is honored verbatim, so `CC_CLOUD_BIN=`
  # genuinely disables the lookup. `${VAR:-}` cannot tell unset from set-empty, and a seam that
  # cannot turn a thing OFF is not a seam. Same contract + same resolution order as the wave-A
  # sites (bin/cc-spawn-verify, bin/cc-board, scripts/team-orphan-reaper.sh): PATH first, so a test
  # shim wins; then the standard install path; then this repo's own bin/ (cc-notify is run straight
  # out of a worktree during development).
  if [ -n "${CC_CLOUD_BIN+set}" ]; then
    CC_CLOUD="$CC_CLOUD_BIN"
  else
    CC_CLOUD="$(command -v cc-cloud 2>/dev/null || true)"
    [ -n "$CC_CLOUD" ] || { [ -x "$HOME/.claude/bin/cc-cloud" ] && CC_CLOUD="$HOME/.claude/bin/cc-cloud"; }
    [ -n "$CC_CLOUD" ] || { [ -n "$_sd" ] && [ -x "$_sd/cc-cloud" ] && CC_CLOUD="$_sd/cc-cloud"; }
  fi

  # ── STEP 0 (before step 1): --receipt is answered UNKNOWN unconditionally ────────────────────
  # Placed ahead of the is-offbox refusal ON PURPOSE. The answer does not depend on the declaration,
  # on cc-cloud being installed, or on anything else that could fail: there IS no off-box read
  # cursor, so no configuration of this box could ever make the answer 0. Putting the check first is
  # what makes "never 0" an invariant rather than a behaviour of the happy path.
  if [ "$RECEIPT" = 1 ]; then
    verdict cloud-receipt-unknown reason=no-offbox-cursor "cloud=$CLOUD_ID"
    printf 'cc-notify: receipt=unknown cloud=%s line=%s\n' "$CLOUD_ID" "${MSG:-none}" >&2
    echo "cc-notify ❔ UNKNOWN — [$CLOUD_ID] is OFF-BOX: there is no <uuid>.seen/.acked cursor on this box to read, and the API's {ok:true} means QUEUED, not read. This is not 'not read' (rc 1, a fact we measured) — it is unmeasurable (rc 7). Do NOT report this session as told." >&2
    echo "  the only off-box progress signal is cc-cloud's own O1/O2 (a remote ref that ADVANCES): cc-cloud show $CLOUD_ID" >&2
    exit 7
  fi

  # A usage error is answered before anything is looked up or spent — checked here rather than with
  # the other arg validation above because --receipt legitimately takes no message.
  [ "$HAVE_MSG" = 1 ] || { echo "cc-notify: no message given" >&2; usage >&2; exit 2; }

  # ── STEP 1: is this id declared? An undeclared cloud target is UNOBSERVABLE, so a "delivered"
  # claim about it could never be checked — which makes refusing the send strictly better than
  # making an uncheckable claim. Fails CLOSED: no cc-cloud, an unreadable state dir and an
  # undeclared id are all a refusal, never a silent send.
  if [ -z "$CC_CLOUD" ] || [ ! -x "$CC_CLOUD" ]; then
    verdict cloud-unobservable reason=cc-cloud-unavailable "cloud=$CLOUD_ID"
    echo "cc-notify: cannot verify [$CLOUD_ID] is a DECLARED cloud session — cc-cloud is not available (CC_CLOUD_BIN='${CC_CLOUD_BIN-unset}', PATH, ~/.claude/bin, ./bin all missed)." >&2
    echo "  refusing the send: an unobservable target cannot carry a checkable delivery claim." >&2
    exit 3
  fi
  if ! "$CC_CLOUD" is-offbox "$CLOUD_ID" >/dev/null 2>&1; then
    verdict cloud-unobservable reason=undeclared "cloud=$CLOUD_ID"
    echo "cc-notify: [$CLOUD_ID] is NOT a declared, unretired cloud session — refusing to send." >&2
    echo "  an undeclared cloud target is unobservable from this box (no pane, no pid, no transcript,"  >&2
    echo "  no registry row), so a 'delivered' claim about it could never be checked afterwards." >&2
    echo "  declare it first: cc-cloud declare --id $CLOUD_ID --branch <b>   (or: cc-cloud list)" >&2
    exit 3
  fi

  # ── SEAM: CC_CLAUDE_BIN — same set-including-empty contract as CC_CLOUD_BIN above.
  if [ -n "${CC_CLAUDE_BIN+set}" ]; then
    CLOUD_CLAUDE="$CC_CLAUDE_BIN"
  else
    CLOUD_CLAUDE="$(command -v claude 2>/dev/null || true)"
    # bin/cc-claude-bin is this repo's own resolver for the pinned track (a `claude` that is only a
    # shell function is invisible to `command -v` in a script; that resolver knows the real paths).
    if [ -z "$CLOUD_CLAUDE" ] && [ -n "$_sd" ] && [ -x "$_sd/cc-claude-bin" ]; then
      CLOUD_CLAUDE="$("$_sd/cc-claude-bin" 2>/dev/null || true)"
    fi
    if [ -z "$CLOUD_CLAUDE" ] && [ -x "$HOME/.claude/bin/cc-claude-bin" ]; then
      CLOUD_CLAUDE="$("$HOME/.claude/bin/cc-claude-bin" 2>/dev/null || true)"
    fi
  fi
  if [ -z "$CLOUD_CLAUDE" ] || [ ! -x "$CLOUD_CLAUDE" ]; then
    verdict cloud-transport-unavailable reason=no-claude-binary "cloud=$CLOUD_ID"
    echo "cc-notify: no claude binary resolved for the --cloud transport (CC_CLAUDE_BIN='${CC_CLAUDE_BIN-unset}')." >&2
    echo "  [$CLOUD_ID] is UNVERIFIED, not invalid — this is a transport outage on THIS box; retry after setting CC_CLAUDE_BIN." >&2
    exit 4
  fi

  # ── STEP 1b: ROUTE TO THE OWNING ACCOUNT ────────────────────────────────────────────────────
  # A session id is NOT a globally-addressable handle. Measured 2026-08-08 (backlog 95422d3518bc)
  # with a clean A/B — same id, same command, only CLAUDE_CONFIG_DIR differs: the owning account
  # returns {ok:true}; another account returns {ok:false,…,"Session not found"}.
  #
  # 🚨 The scoping is not the trap; the ERROR STRING is. A wrong-account send fails as "Session not
  # found", which reads as a DEAD or expired session — so the otherwise-correct rule below ("exit
  # with the API's own reason, never a bare failure") is, on this ONE path, how a confidently wrong
  # diagnosis reaches a human with the API's authority behind it. Same class as the three liars in
  # §5.2: a condition converted into a different, scarier one on its way out. So the mismatch is
  # detected HERE and named HERE, before the transport can speak for it.
  #
  # THREE states, not two. A declaration with no `account=` predates the field, and "assume the
  # current account" is precisely the guess that manufactures the misleading error. It gets its own
  # warning and proceeds unrouted, because refusing would strand every declaration made before
  # today — but it is never silent.
  CLOUD_ACCT="$("$CC_CLOUD" show "$CLOUD_ID" 2>/dev/null | sed -n 's/^account=//p' | head -1)"
  CLOUD_CFG=""
  if [ -n "$CLOUD_ACCT" ]; then
    CLOUD_CFG="$(jq -r --arg a "$CLOUD_ACCT" '.accounts[]? | select(.name==$a) | (.config_dir // empty)' \
                 "$HOME/.claude/accounts.json" 2>/dev/null | head -1)"
    # accounts.json stores a literal `~`, which does NOT expand inside a variable. Skipping this
    # yields a path that exists nowhere — and the resulting failure would look like the very
    # wrong-account error this block exists to prevent.
    # shellcheck disable=SC2088  # the quoted ~ is the literal we are MATCHING, not one to expand
    case "$CLOUD_CFG" in "~/"*) CLOUD_CFG="$HOME/${CLOUD_CFG#\~/}" ;; esac
    if [ -z "$CLOUD_CFG" ] || [ ! -d "$CLOUD_CFG" ]; then
      verdict cloud-account-unresolvable reason=no-config-dir "cloud=$CLOUD_ID" "account=$CLOUD_ACCT"
      echo "cc-notify: [$CLOUD_ID] is declared to account '$CLOUD_ACCT', but that account has no usable config dir in ~/.claude/accounts.json." >&2
      echo "  refusing: sending from the wrong account returns 'Session not found', which is indistinguishable from a dead session." >&2
      exit 5
    fi
    if [ "$CLOUD_CFG" != "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ]; then
      echo "cc-notify: routing to owning account '$CLOUD_ACCT' (CLAUDE_CONFIG_DIR=$CLOUD_CFG) — a session id is scoped to the account that created it." >&2
    fi
  else
    verdict cloud-account-undeclared reason=predates-account-field "cloud=$CLOUD_ID"
    echo "cc-notify: ⚠ [$CLOUD_ID] carries NO owning account in its declaration, so this send cannot be routed — it will go from whatever account is ambient." >&2
    echo "  if that is not the account that CREATED the session, the API answers 'Session not found', which reads as a dead session and is NOT one." >&2
    echo "  fix the declaration: cc-cloud declare --id $CLOUD_ID --branch <b> --account <acct>" >&2
  fi

  resolve_from
  CLOUD_MSG1="$(printf '%s' "$MSG" | tr '\r\n' '  ')"

  # ── STEP 2: the transport. VALIDATED 2026-08-08 with no pty and stdin closed, so stdin is closed
  # here too rather than inherited — an inherited terminal is exactly the difference between a
  # measured call and an untested one.
  CLOUD_ERR="$(mktemp "${TMPDIR:-/tmp}/cc-notify-cloud.XXXXXX" 2>/dev/null || printf '/tmp/cc-notify-cloud.%s' "$$")"
  if [ -n "$CLOUD_CFG" ]; then
    CLOUD_OUT="$(CLAUDE_CONFIG_DIR="$CLOUD_CFG" "$CLOUD_CLAUDE" -p "$MSG" --cloud "$CLOUD_ID" --output-format json 2>"$CLOUD_ERR" </dev/null)"; CLOUD_RC=$?
  else
    CLOUD_OUT="$("$CLOUD_CLAUDE" -p "$MSG" --cloud "$CLOUD_ID" --output-format json 2>"$CLOUD_ERR" </dev/null)"; CLOUD_RC=$?
  fi
  CLOUD_ERRTXT="$(cat "$CLOUD_ERR" 2>/dev/null || true)"; rm -f "$CLOUD_ERR" 2>/dev/null || true

  # Is the flag even SUPPORTED? `--cloud` is present-but-hidden on CC 2.1.220 and ABSENT on the
  # 2.1.114 stable pin, and `--help` cannot answer that (it does not list hidden flags). So the
  # question is decided from the REAL call's own refusal, and only when that refusal names the
  # OPTION — a semantic refusal ("no such session") must NOT be laundered into "your binary is too
  # old", which would send the caller off upgrading a binary that was fine.
  case "$CLOUD_ERRTXT$CLOUD_OUT" in
    *"nknown option"*"--cloud"*|*"--cloud"*"nknown option"*|\
    *"nrecognized option"*"--cloud"*|*"--cloud"*"nrecognized option"*|\
    *"nknown argument"*"--cloud"*|*"--cloud"*"nknown argument"*|\
    *"nvalid option"*"--cloud"*|*"--cloud"*"nvalid option"*)
      verdict cloud-transport-unavailable reason=flag-unsupported "cloud=$CLOUD_ID" "bin=$CLOUD_CLAUDE"
      echo "cc-notify: this claude binary does NOT support --cloud: $CLOUD_CLAUDE" >&2
      echo "  it is present-but-hidden on CC 2.1.220 and ABSENT on the 2.1.114 stable pin, so this is a" >&2
      echo "  BINARY VERSION fault on this box — [$CLOUD_ID] is UNVERIFIED, not invalid, and the message" >&2
      echo "  was NOT sent. Point CC_CLAUDE_BIN at a 2.1.220+ binary and retry. The binary said:" >&2
      # stderr FIRST, but never only stderr: a CLI that writes its own refusal to stdout would
      # otherwise be quoted as having said nothing, which is the one thing it demonstrably did not do.
      _cl_said="$(printf '%s' "$CLOUD_ERRTXT" | head -n2)"
      [ -n "$_cl_said" ] || _cl_said="$(printf '%s' "$CLOUD_OUT" | head -n2)"
      printf '  %s\n' "$_cl_said" >&2
      exit 4 ;;
  esac

  # ── STEP 3: the answer. `ok` decides; anything that is not a parseable object carrying a boolean
  # `ok` is treated as a REFUSAL, never as success — a transport whose answer we cannot read has not
  # told us the message landed.
  CLOUD_OK="$(printf '%s' "$CLOUD_OUT" | jq -r 'if type=="object" and (.ok|type)=="boolean" then (.ok|tostring) else "" end' 2>/dev/null || true)"
  if [ "$CLOUD_OK" != "true" ]; then
    CLOUD_WHY="$(printf '%s' "$CLOUD_OUT" | jq -r 'if type=="object" then (.error // .message // .reason // .detail // empty) else empty end' 2>/dev/null || true)"
    # The API's OWN reason, never a bare failure. Falling back through stderr and then the raw body
    # keeps that promise even when the answer was not the shape we expected: a caller that is told
    # only "it failed" has to guess, and every guess here is a wrong action.
    [ -n "$CLOUD_WHY" ] || CLOUD_WHY="$(printf '%s' "$CLOUD_ERRTXT" | head -n3)"
    [ -n "$CLOUD_WHY" ] || CLOUD_WHY="$(printf '%s' "$CLOUD_OUT" | head -c 300)"
    [ -n "$CLOUD_WHY" ] || CLOUD_WHY="(the transport exited $CLOUD_RC and said NOTHING on stdout or stderr)"
    verdict cloud-refused reason=api-not-ok "cloud=$CLOUD_ID" "rc=$CLOUD_RC"
    echo "cc-notify ✖ --cloud send to [$CLOUD_ID] REFUSED — the message was NOT queued. The API's own reason:" >&2
    printf '  %s\n' "$CLOUD_WHY" >&2
    exit 8
  fi

  CLOUD_URL="$(printf '%s' "$CLOUD_OUT" | jq -r '.url // empty' 2>/dev/null || true)"
  CLOUD_SID="$(printf '%s' "$CLOUD_OUT" | jq -r '.session_id // empty' 2>/dev/null || true)"

  # ── STEP 3 (record). The sidecar lives beside the declaration, under the SAME state dir cc-cloud
  # reads (CC_CLOUD_STATE is the shared seam; cc-cloud's own `STATE=` line is its SSOT). One JSON
  # object per line, appended: a send is an EVENT and there are many of them, so the `key=value`
  # shape of .decl/.seen — which cc-cloud's dfield reads as first-match-wins — cannot hold them.
  # `.sends` is a name cc-cloud does not read, so this cannot disturb its state function.
  # Recording the URL is the load-bearing part: it is the only handle by which anyone can later go
  # LOOK at what the session did with the message.
  CLOUD_STATE_DIR="${CC_CLOUD_STATE:-$HOME/.claude/autonomy/cloud}"
  CLOUD_RECORDED=0
  CLOUD_REC="$(jq -nc --arg id "$CLOUD_ID" --arg url "$CLOUD_URL" --arg sid "$CLOUD_SID" \
                      --arg from "$FROM" --arg msg "$CLOUD_MSG1" \
                      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" \
       '{kind:"cloud-send", id:$id, url:$url, session_id:$sid, from:$from, msg:$msg, ts:$ts, queued:true, read:null}' 2>/dev/null || true)"
  if [ -n "$CLOUD_REC" ] && mkdir -p "$CLOUD_STATE_DIR" 2>/dev/null \
     && printf '%s\n' "$CLOUD_REC" >> "$CLOUD_STATE_DIR/$CLOUD_ID.sends" 2>/dev/null; then
    CLOUD_RECORDED=1
  fi

  verdict cloud-queued reason=api-ok "cloud=$CLOUD_ID" "queued=1" "recorded=$CLOUD_RECORDED" \
          "url=${CLOUD_URL:-none}"
  # `verdict=cloud-queued`, deliberately NOT `delivered`: the word this tool reserves for a message
  # a live reader will drain is not available for a queue ack. enqueued=0 in the token above is
  # likewise literal — nothing was written to a local inbox, because off-box there is none.
  echo "cc-notify ☁ QUEUED to off-box [$CLOUD_ID] — the API accepted it (ok:true). QUEUED IS NOT READ: there is no off-box cursor, so nothing here can ever prove the session consumed it (cc-notify --cloud $CLOUD_ID --receipt exits 7 UNKNOWN, by construction)." >&2
  [ -n "$CLOUD_URL" ] && echo "  session: $CLOUD_URL" >&2
  if [ "$CLOUD_RECORDED" = 1 ]; then
    echo "  recorded: $CLOUD_STATE_DIR/$CLOUD_ID.sends" >&2
  else
    # The message IS queued — that already happened at the API and no local failure can undo it. So
    # this is loud but NOT a failure exit: reporting failure would license a re-send of a message
    # that landed. What is lost is the forensic record, and saying so is the honest verdict.
    echo "  ⚠ NOT RECORDED — could not append to $CLOUD_STATE_DIR/$CLOUD_ID.sends. The send STANDS (do not re-send); what is missing is the local record of it, so this send is not auditable later." >&2
  fi
  _echo_sent
  exit 0
fi
# rc 0 = resolved (uuid on stdout) · 1 = target genuinely UNKNOWN · 4 = RESOLVER UNAVAILABLE
# · 6 = AMBIGUOUS prefix (candidates on stdout). The caller MUST branch on these: reporting a
# resolver outage as "not a live session name or a pane UUID" is what sent this desk chasing the
# target for three attempts. (Status travels by RETURN CODE, never a global — resolve() runs inside
# a command substitution, so a variable set in here would never reach the caller.)
resolve() {
  local t="$1" u="" rc=0
  if [ "$t" = "__self__" ]; then
    [ -n "$own_uuid" ] || return 1
    echo "$own_uuid"; return 0
  fi
  # 1. exact friendly-name match — read STRAIGHT from the registry (no it2 IPC, so no hang).
  u="$(registry_name_to_uuid "$t")"; rc=$?
  [ "$rc" = 0 ] && [ -n "$u" ] && { echo "$u"; return 0; }
  # 2. raw full UUID passthrough — needs no registry at all, so it works even when the registry does
  #    not. Tried BEFORE surfacing any resolver-unavailable verdict.
  if [[ "$t" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]; then
    echo "$t"; return 0
  fi
  # 3. unambiguous UUID prefix — makes the `--list` column round-trip into its own input. DASHES ARE
  #    OPTIONAL, on both sides. The column prints the full 36-char DASHED uuid, so a trimmed paste is
  #    normally dash-bearing ("AAAAAAAA-1111" — a double-click selection tends to stop at a dash
  #    boundary), while a hand-stripped one is not ("AAAAAAAA1111", or all 32 hex digits). Those are
  #    the SAME address, and a pure-hex gate rejected BOTH of the latter shapes: it demanded hex-only
  #    yet compared against a dashed uuid, so anything past the 8th character could not match. Every
  #    such paste returned "target genuinely UNKNOWN" — the precise lie this rewrite exists to end,
  #    made MORE likely by widening the column. The bar is unchanged: >=8 HEX DIGITS, counted with the
  #    dashes removed.
  if [[ "${t//-/}" =~ ^[0-9A-Fa-f]{8,}$ ]]; then
    u="$(registry_prefix_to_uuid "$t")"; local prc=$?
    case "$prc" in
      0) echo "$u"; return 0 ;;
      3) echo "$u"; return 6 ;;                       # ambiguous — candidates on stdout
      2) return 4 ;;
    esac
  fi
  # 4. no match. If the registry itself could not be read, the target may be perfectly valid — that
  #    is an infrastructure fault (4), NOT a bad address (1).
  [ "$rc" = 2 ] && return 4
  return 1
}

# ROLE resolution (v3 D2) — read the role file at SEND time, never a snapshot. This is what makes an
# automated pager survive the target recycling: the role file is repointed by handoff-fire at
# succession (refresh_roles_for), so the very next page goes to the continuation.
role_uuid() { # <role-name> → current pane uuid (empty + rc 1 if the role is unset)
  local r="$1" u=""
  [ -f "$ROLES_DIR/$r" ] || return 1
  u="$(head -n1 "$ROLES_DIR/$r" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$u" ] || return 1
  printf '%s' "$u"
}

if [ -n "$ROLE" ]; then
  if ! uuid="$(role_uuid "$ROLE")"; then
    verdict unresolvable reason=role-unset "target=--role $ROLE"
    echo "cc-notify: role '$ROLE' is not set — no live pane at $ROLES_DIR/$ROLE (missing or empty)" >&2
    echo "  a role is pointed at a pane by handoff-fire (--as-role) / cc-register; check: ls $ROLES_DIR" >&2
    exit 3
  fi
  TARGET="--role $ROLE"          # for human-readable messages only
elif [ "$ROLE_GIVEN" = 1 ]; then
  echo "cc-notify: --role needs a role name (e.g. --role desk)" >&2; usage >&2; exit 2
else
  uuid="$(resolve "$TARGET")"; _rrc=$?
  case "$_rrc" in
    0) : ;;
    6) # AMBIGUOUS prefix — never guess which pane the operator meant.
       verdict ambiguous reason=ambiguous-prefix "target=$TARGET"
       echo "cc-notify: uuid prefix '$TARGET' is AMBIGUOUS — it matches more than one pane:" >&2
       printf '%s\n' "$uuid" | sed '/^$/d; s/^/    /' >&2
       echo "  name one of them exactly (or use its friendly name)." >&2
       exit 6 ;;
    4) # RESOLVER UNAVAILABLE — the registry could not be read. Saying "not a live session name"
       # here is the exact lie this exit code exists to end: we do not KNOW that. The target is
       # unverified, not invalid.
       verdict degraded reason=resolver-unavailable "target=$TARGET"
       echo "cc-notify: RESOLVER UNAVAILABLE — could not read the session registry at $REG_DIR" >&2
       echo "  '$TARGET' is UNVERIFIED, not invalid — do not treat this as a bad address; retry, or" >&2
       echo "  address the target by its full 36-char pane UUID (that path needs no registry)." >&2
       exit 4 ;;
    *)
       if [ "$TARGET" = "__self__" ]; then
         verdict unresolvable reason=no-iterm-session target=--self
         echo "cc-notify: --self needs \$ITERM_SESSION_ID (not in an iTerm2 pane)" >&2
       else
         verdict unresolvable reason=no-such-target "target=$TARGET"
         echo "cc-notify: target '$TARGET' is UNKNOWN — the registry ($REG_DIR) is readable and holds" >&2
         echo "  no live session by that name, and it is not a pane UUID or a known uuid prefix." >&2
         echo "  try: cc-notify --list" >&2
       fi
       exit 3 ;;
  esac
fi

# FORWARD CHAIN (v3 D1) — a resolved uuid may be a pane that has since self-closed with a successor.
# Follow the chain to its head BEFORE enqueue, so the message lands on the continuation rather than in
# a box nothing drains. Degrades to the original uuid when the lib is absent or no forward exists.
ORIG_UUID="$uuid"
if command -v mailbox_forward_of >/dev/null 2>&1; then
  _fwd="$(mailbox_forward_of "$uuid" 2>/dev/null || true)"
  if [ -n "$_fwd" ] && [ "$_fwd" != "$uuid" ]; then
    uuid="$_fwd"
    echo "cc-notify: [$ORIG_UUID] has self-closed — following its forward chain to the successor [$uuid]" >&2
  fi
fi

# ── --receipt <target> <line> — DID THEY ACTUALLY READ IT? ────────────────────────────────────────
# The read side of the cursor the send side now prints. Without this the line number in a verdict is
# just another number nobody can check, and "cite the cursor" degrades back into prose — which is the
# exact failure this whole channel keeps re-learning: a discipline with no mechanism behind it is
# inert by construction. Placed AFTER resolution + the forward chain on purpose, so a receipt is
# looked up at the same address a send would reach (a self-closed pane's mail followed its successor;
# its receipt must follow it too, or the query reports "unread" about the wrong box).
#
# Exit code IS the verdict, so a caller can gate on it without parsing: 0 = read (a turn provably
# carried it) · 1 = NOT read (surfaced-but-unconsumed, or never surfaced). Anything a desk is about
# to report as "I told session X" should be gated on rc 0.
if [ "$RECEIPT" = 1 ]; then
  _line="$MSG"
  case "$_line" in ''|*[!0-9]*)
    echo "cc-notify --receipt: needs the LINE the message landed on: cc-notify --receipt <target> <line>" >&2
    echo "  (the line comes from the send's own verdict token: 'cc-notify: verdict=… line=<N> …')" >&2
    exit 2 ;;
  esac
  if ! command -v mailbox_receipt >/dev/null 2>&1; then
    echo "cc-notify --receipt: mailbox lib unavailable (hooks/lib/mailbox-pending.sh) — cannot read the cursors" >&2
    exit 4
  fi
  _rcpt="$(mailbox_receipt "$uuid" "$_line")"; _rrc2=$?
  _seen="$(mailbox_seen "$uuid" 2>/dev/null || echo 0)"
  _ackd="$(mailbox_acked "$uuid" 2>/dev/null || echo 0)"
  _unak="$(mailbox_unacked_count "$uuid" 2>/dev/null || echo 0)"
  printf 'cc-notify: receipt=%s uuid=%s line=%s seen=%s acked=%s unacked=%s\n' \
    "$_rcpt" "$uuid" "$_line" "$_seen" "$_ackd" "$_unak" >&2
  case "$_rcpt" in
    read)     echo "cc-notify 📬 READ — a turn in [$uuid] provably carried line $_line (acked=$_ackd ≥ $_line). Safe to report this session as told." >&2 ;;
    surfaced) echo "cc-notify 📭 SURFACED, NOT READ — line $_line was emitted to [$uuid] (seen=$_seen) but no turn has provably consumed it (acked=$_ackd). Do NOT report this session as told." >&2 ;;
    *)        echo "cc-notify 📪 UNREAD — line $_line has never even been surfaced to [$uuid] (seen=$_seen, $_unak unacked). Do NOT report this session as told." >&2 ;;
  esac
  exit "$_rrc2"
fi

# `cc-notify --self` with no message = just print own UUID (utility).
if [ "$HAVE_MSG" = 0 ]; then
  if [ "$TARGET" = "__self__" ]; then echo "$uuid"; exit 0; fi
  echo "cc-notify: no message given" >&2; usage >&2; exit 2
fi

# --- attribution (default: own registered name, else account) — defined once, above ---
resolve_from

# --- ENQUEUE to the inbox (the durable, keystroke-free transport) ---
# One message = one line: collapse any embedded newlines/CR to spaces so the <uuid>.seen line-count
# cursor counts MESSAGES, not physical lines (a multi-line message would otherwise desync the cursor).
MSG_1LINE="$(printf '%s' "$MSG" | tr '\r\n' '  ')"
# ── SENDER-SIDE SEND RECORD (F-1, 2026-08-09) ────────────────────────────────────────────────────
# The inbox is a record of what a target RECEIVED. Nothing recorded what a sender SENT, so no
# mechanism could answer "did this pane ever announce back?" — and that is exactly the question
# handoff-fire's `self-close` has to ask before it retires a peer that was fired with --notify-back.
# The `[<from>]` tag on the delivered line cannot answer it: it is a friendly NAME resolved from the
# registry (resolve_from, :406-411), not the sender's pane id, so it is neither unique nor derivable
# by a closing pane reasoning about itself.
#
# So each successful enqueue leaves one line under the SENDER's own key. `.sent/` sits beside the
# existing `.alias/` and `.watchers/` dirs, and the leading dot is what keeps it out of the box
# namespace by construction — `_mbx_valid_uuid` refuses any key beginning with `.`, so this can never
# be mistaken for an inbox. Best-effort and always 0: a send that succeeded must never be reported as
# failed because its audit line could not be written.
_record_send() { # <resolved-target-key>
  local sdir="$MAILBOX_DIR/.sent"
  [ -n "${own_uuid:-}" ] || return 0
  case "$own_uuid" in ''|*[!A-Za-z0-9._-]*|.*) return 0 ;; esac
  mkdir -p "$sdir" 2>/dev/null || return 0
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null)" "${1:-}" >> "$sdir/$own_uuid" 2>/dev/null || true
  return 0
}
mailbox_write() {
  mkdir -p "$MAILBOX_DIR" 2>/dev/null || return 1
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$FROM" "$MSG_1LINE" >> "$MAILBOX_DIR/$uuid.md" || return 1
  _record_send "$uuid"
}
if ! mailbox_write; then
  # A message that cannot even be persisted must NOT read as delivered — LOUD, never a silent drop.
  # F4: exit 5 alone is INERT (every fire-and-forget caller swallows it with `|| true`). So the backstop
  # for "cannot persist" must NOT depend on persistence — escalate DIRECTLY here: a durable alarm record
  # in a DIFFERENT dir (the target mailbox is what failed) + a best-effort push to the operator's phone.
  # Written through the comms-alarm chokepoint (hooks/lib/comms-alarm.sh), never straight to the
  # dir. This suite's OWN inbox-unwritable tests wrote 510 of these into the operator's LIVE store
  # (40% of it) and cc-inbox-guard phoned him once per record — see the lib header. The chokepoint
  # stamps test_origin and diverts a fixture-context write out of the live root. Lib absent (a
  # deployed layer whose install.sh has not re-globbed hooks/lib yet) → the original inline write,
  # so the backstop can never become WEAKER than it was before it had a chokepoint.
  _ca_rec="$(jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" --arg tgt "$uuid" --arg from "$FROM" --arg msg "$MSG_1LINE" \
    '{kind:"enqueue-failed", target:$tgt, from:$from, msg:$msg, ts:$ts}' 2>/dev/null)"
  if command -v comms_alarm_write >/dev/null 2>&1; then
    comms_alarm_write enqueue-fail "$_ca_rec" || true
  else
    adir="${CC_COMMS_ALARM_DIR:-$HOME/.claude/autonomy/comms-alarms}"
    if mkdir -p "$adir" 2>/dev/null; then
      printf '%s\n' "$_ca_rec" \
        > "$adir/enqueue-fail-$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null)-$$-${RANDOM}.json" 2>/dev/null || true
    fi
  fi
  for _p in "$_sd/../scripts/push-send.sh" "$HOME/.claude/scripts/push-send.sh" "$(command -v push-send.sh 2>/dev/null || true)"; do
    [ -n "$_p" ] && [ -x "$_p" ] && { "$_p" send --title "cc-notify enqueue FAILED" --message "inbox unwritable for $uuid; NOT delivered: $MSG_1LINE" >/dev/null 2>&1 || true; break; }
  done
  verdict undelivered reason=inbox-unwritable
  echo "cc-notify: FAILED to write inbox $MAILBOX_DIR/$uuid.md — message NOT delivered; alarm recorded + phone paged (check permissions/disk)" >&2
  exit 5
fi

ENQUEUED=1     # from here on the message is DURABLE — a kill can cost the verdict, never the delivery

# ── THE READ RECEIPT (delivered ≠ read) ───────────────────────────────────────────────────────────
# The append above put this message on exactly one line, and THAT LINE NUMBER is the only durable
# handle by which anyone can later prove the target actually consumed it: read ⇔ .acked ≥ line.
# Capture it here, at the one instant it is knowable, and put it in the verdict — a sender that
# reports only "delivered" is answering a different question than the one its caller is asking.
# UNACKED is the target's whole never-consumed backlog INCLUDING this line, which is what turns a
# single delivery into a picture: `unacked=5` on a live pane says the last four went unread too.
#   Costs one grep -c and one small file read on an already-written box — no extra I/O worth naming.
#   Degrades silently to empty when the lib is absent (this file's standing rule: a missing lib
#   degrades a feature, it never fails the send).
if command -v mailbox_lines >/dev/null 2>&1; then
  CURSOR_LINE="$(mailbox_lines "$uuid" 2>/dev/null || true)"
  UNACKED="$(mailbox_unacked_count "$uuid" 2>/dev/null || true)"
  case "$CURSOR_LINE" in ''|*[!0-9]*) CURSOR_LINE="" ;; esac
  case "$UNACKED"     in ''|*[!0-9]*) UNACKED="" ;; esac
fi
# The one-clause reminder appended to every delivery sentence. Deliberately states the PROOF
# ("acked≥N"), not an adjective — a caller that repeats this line downstream then repeats a checkable
# fact instead of a reassurance.
READ_NOTE=""
[ -n "$CURSOR_LINE" ] && READ_NOTE=" · unread=${UNACKED:-?} in this box — DELIVERED IS NOT READ: proof is acked≥${CURSOR_LINE} (cc-notify --receipt $uuid $CURSOR_LINE), never this send"

# --mailbox-only: caller explicitly wants a pure record, no liveness verdict.
if [ "$MAILBOX_ONLY" = 1 ]; then
  verdict mailbox-only reason=requested
  echo "cc-notify 📤 peer mail ▶ [$uuid] recorded to inbox ($MAILBOX_DIR/$uuid.md; --mailbox-only)${READ_NOTE}" >&2
  _echo_sent
  exit 0
fi

# --- liveness classification: does a LIVE session exist to drain this inbox? ---
# LIVE  → the drain hook (or the target's armed cc-await-ping watcher) WILL surface it → delivered.
# not-live (closed/recycled pane, dead pid) → enqueued but no drain will run → "mailbox only" (the
#   cc-announce alarm path; a dead inbox is not a delivery).
# unknown (no liveness oracle available) → degrade to "mailbox only", never a false "delivered".
target_live() {
  local u="$1"
  # self is always live (it is us)
  [ "$u" = "$own_uuid" ] && [ -n "$own_uuid" ] && return 0
  # registered? Decide from the REGISTRY DIRECTLY (v4) — this used to shell to `cc-sessions --json`,
  # i.e. into the same it2 IPC that hangs, so even a full-UUID send (the "reliable" address) blocked
  # here. It only ever LOOKED reliable because the enqueue above already happened.
  # `kill -0` is cc-sessions' own authoritative liveness signal, so a registered row decides outright:
  #   dead pid → not-live · live pid → live. The one behaviour change is a pid that outlives its pane
  #   (a transient window at close): formerly not-live via it2, now live — and the verdict below still
  #   says "NO watcher armed → drains on its NEXT turn", so nothing claims a wake that will not happen.
  local n p ruuid
  if registry_load; then
    while IFS="$(printf '\t')" read -r n p ruuid; do
      if [ -n "$ruuid" ] && [ "$ruuid" = "$u" ]; then
        pid_live "$p" && return 0
        return 1
      fi
    done <<EOF
$REG_ROWS
EOF
  fi
  # else a live (possibly unregistered) iTerm2 pane — read-only `session list`, never `session send`,
  # and BOUNDED so a slow iTerm2 degrades to "unknown" instead of hanging the send.
  # A VALID JSON array (even []) means the list is READABLE → membership is authoritative (a `[]` means
  # zero live panes → not-live, NOT "unknown"). Only a non-array / errored / TIMED-OUT output is unknown.
  local raw; raw="$(it2_list_bounded || true)"
  if [ -n "$raw" ] && printf '%s' "$raw" | jq -e 'type=="array"' >/dev/null 2>&1; then
    printf '%s' "$raw" | jq -r '.[].id // empty' 2>/dev/null | grep -qxF "$u" && return 0
    return 1       # list readable AND uuid absent → authoritatively not-live
  fi
  return 2         # it2 unavailable / errored / timed out → no liveness oracle → unknown
}

# F5: a WAKE PATH — not mere registered-liveness — is what makes a delivery a wake. A fresh cc-await-ping
# heartbeat (<uuid>.watching) means the target's watcher wakes it within a poll; its ABSENCE means the
# target only drains on its NEXT turn (fine for a routine ping, but NOT a guaranteed wake for a terminal
# announce — cc-announce treats no-watcher as a degrade, never "wake confirmed"). Never equate live+idle
# with a wake (that WAS the W5 incident).
#
# PROVEN, not merely CLAIMED: freshness alone cannot falsify the claim. cc-await-ping removes its marker
# from an EXIT trap, which SIGKILL does not run — so a killed watcher left a marker that stayed "fresh"
# for a full WATCH_FRESH_S, cc-notify reported "wake-path armed", and cc-announce stamped VERIFIED on a
# wake that could not happen. The marker therefore carries the watcher's pid, and the claim is only
# honored while that pid is ALIVE. A legacy/empty marker (no pid recorded) falls back to freshness-only,
# so an older watcher still reads as armed rather than being wrongly downgraded.
#
# SSOT: the predicate itself now lives ONCE, as mailbox_wake_armed in hooks/lib/mailbox-pending.sh —
# a third consumer (the wake FLOOR in hooks/session-continue.sh) is what made two copies untenable.
# The body below is retained ONLY as the lib-absent fallback, per this file's standing rule that a
# missing lib degrades a feature and never hard-fails the send path. Both read CC_WATCH_FRESH_S.
WATCH_FRESH_S="${CC_WATCH_FRESH_S:-90}"
wake_path_armed() {
  if command -v mailbox_wake_armed >/dev/null 2>&1; then mailbox_wake_armed "$1"; return $?; fi
  local u="$1" wf mt now wpid
  wf="$MAILBOX_DIR/$u.watching"; [ -f "$wf" ] || return 1
  mt="$(stat -f %m "$wf" 2>/dev/null || stat -c %Y "$wf" 2>/dev/null || echo 0)"
  now="$(date +%s 2>/dev/null || echo 0)"; case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
  [ "$(( now - mt ))" -le "$WATCH_FRESH_S" ] || return 1
  wpid="$(sed -n 's/^pid=\([0-9][0-9]*\).*/\1/p' "$wf" 2>/dev/null | head -n1)"
  [ -n "$wpid" ] || return 0                  # legacy marker: freshness is all there is to go on
  kill -0 "$wpid" 2>/dev/null                 # a dead watcher cannot wake anyone — NOT armed
}

target_live "$uuid"; _lv=$?
case "$_lv" in
  0)
    if [ "$uuid" = "$own_uuid" ] || wake_path_armed "$uuid"; then
      verdict delivered reason=wake-path-armed
      echo "cc-notify 📤 peer mail ▶ delivered to inbox [$uuid] (live session, wake-path armed — its cc-await-ping watcher wakes it within a poll)${READ_NOTE}" >&2
      _echo_sent
    else
      verdict delivered reason=no-watcher
      echo "cc-notify 📤 peer mail ▶ delivered to inbox [$uuid] (live session, NO watcher armed — drains on its NEXT turn; delivered but not a guaranteed instant wake)${READ_NOTE}" >&2
      _echo_sent
    fi
    exit 0 ;;
  1)
    verdict mailbox-only reason=target-not-live
    echo "cc-notify 📤 peer mail ▶ [$uuid] mailbox only — target is NOT a live session (closed/recycled pane); no drain will run. The message is recorded but unread until/unless that pane returns.${READ_NOTE}" >&2
      _echo_sent
    # D3 REROUTE — a dead target is the silent-loop class (570 pages into one dead box for three days).
    # The line stays in the original box (forensics are never moved), and a COPY goes to the desk role
    # tagged [for:<orig>] so a human/triager actually sees it. Only a self-tee is skipped.
    #
    # REACHABILITY (2026-08-01). This block used to be gated on `[ "$uuid" = "$ORIG_UUID" ]` — i.e.
    # skipped entirely whenever a forward had been followed, on the reasoning that "the chain already
    # re-addressed it". Backwards: we are INSIDE the not-live arm, so reaching here means the chain
    # HEAD is dead too — the re-addressing FAILED and the successor's box has no reader either. The
    # gate turned that into total silence: the caller got a bare "mailbox only" with no word that the
    # triager was gone. That is the exact shape found on disk (role → self-closed pane → .forward → a
    # successor that is also gone; ~1446 lines, no cursor). The gate is removed; the tee is tagged with
    # $ORIG_UUID — the addressee the SENDER named — in both shapes.
    desk_uuid="$(role_uuid "$DESK_ROLE" 2>/dev/null || true)"
    desk_uuid_role="$desk_uuid"   # the role file's OWN value, BEFORE any forward-following
    # The reroute target gets the SAME forward-chain treatment as the primary target. Without this
    # a reroute could tee into a desk box that has itself self-closed — re-creating, in the very
    # mechanism built to end stranding, the stranding class this whole change exists to kill. (The
    # role file is normally repointed at succession, but a stale role + a live forward is exactly
    # the window this covers.)
    if [ -n "$desk_uuid" ] && command -v mailbox_forward_of >/dev/null 2>&1; then
      _dfwd="$(mailbox_forward_of "$desk_uuid" 2>/dev/null || true)"
      [ -n "$_dfwd" ] && desk_uuid="$_dfwd"
    fi
    if [ -z "$desk_uuid" ]; then
      echo "cc-notify: no reroute — the '$DESK_ROLE' role is unset ($ROLES_DIR/$DESK_ROLE), so there is no triager to receive it; the message sits in a box nothing drains" >&2
    elif [ "$desk_uuid" = "$uuid" ] || [ "$desk_uuid" = "$ORIG_UUID" ] \
      || [ "$desk_uuid_role" = "$uuid" ] || [ "$desk_uuid_role" = "$ORIG_UUID" ]; then
      # The dead target IS the desk — in EITHER form, the role file's own value or its chain head, and
      # matched against the target in EITHER form too. Comparing only the FORWARDED desk against the
      # FORWARDED target let the pre-forward identity slip through into the reroute arm below, which
      # then claimed "the desk is the standing triager" about a pane that had just failed target_live.
      # Teeing would copy the line into the same dead box; say so plainly rather than reporting a
      # reroute that changed nothing (the desk-is-down case the desk-invariant replacement exists for).
      echo "cc-notify: no reroute — the '$DESK_ROLE' role still points at THIS dead address (role=[$desk_uuid_role], chain head=[$desk_uuid]); the triager itself is down (desk-invariant fires a replacement). Message recorded, undrained." >&2
    elif printf '%s [%s] [for:%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$FROM" "$ORIG_UUID" "$MSG_1LINE" \
           >> "$MAILBOX_DIR/$desk_uuid.md" 2>/dev/null; then
      # HONESTY GATE. The tee landed — but "the desk is the standing triager" is a claim about a
      # READER, and a box is not a reader. Assert it ONLY for a desk that passes target_live; a desk
      # that is itself dead (or unverifiable) gets the sentence that is actually true — recorded, no
      # proven reader — because a false reroute claim is precisely how mail rotted unnoticed before.
      target_live "$desk_uuid"; _dlv=$?
      if [ "$_dlv" -eq 0 ]; then
        echo "cc-notify: rerouted to desk [$desk_uuid] tagged [for:$ORIG_UUID] — the original addressee is gone; the desk is the standing triager. NOT a delivery to the original target." >&2
      else
        echo "cc-notify: NO triager — copied to the '$DESK_ROLE' box [$desk_uuid] tagged [for:$ORIG_UUID], but that box is NOT a live session either: recorded with NO proven reader, so this is not a reroute to a triager (desk-invariant fires a replacement). NOT a delivery to the original target." >&2
      fi
    else
      echo "cc-notify: reroute to desk FAILED (inbox $MAILBOX_DIR/$desk_uuid.md unwritable) — the message is recorded in the dead box only" >&2
    fi
    exit 0 ;;
  *) verdict unverified reason=liveness-unverifiable
     echo "cc-notify 📤 peer mail ▶ delivered to inbox [$uuid] (liveness UNVERIFIABLE — no session registry/pane list; recorded, will drain if the pane is live)${READ_NOTE}" >&2; exit 0 ;;
esac
