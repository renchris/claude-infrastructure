#!/bin/bash
# cc-backlog — durable, append-only work-ledger for the desk mission (Program D).
#
# The ledger is EVIDENCE (one-artifact-one-role): every status change is an
# APPEND-ONLY record; the current status of an item is the FOLD of its record
# trail (last transition wins). Nothing is ever rewritten in place EXCEPT the
# `compact` verb, which may drop ONLY terminal (done) items that have aged past a
# threshold — open work is never touched. Malformed lines are reported, never
# silently dropped.
#
# Store: JSONL at ${CC_BACKLOG_FILE:-~/.claude/autonomy/backlog.jsonl}
# IDs are event-keyed (hash of project+title+source) → re-`add` is idempotent.
# `--condition <slug>` re-keys that hash to project+condition instead (see CONDITION KEY below),
# for work whose trigger is a recurring STATE rather than a one-off event.
#
# Verbs:
#   add     --title T [--project P] [--dod-ref R] [--source S] [--condition SLUG]  → echoes the id
#   list    [--open | --all | --blocked | --project P] [--json]  (default: --open, table)
#   claim   <id> --by <sid> [--venue local|cloud] [--force]      → LEASE: refused if held & live
#                                                                  (claimer OR its worktree), or if
#                                                                  the item is done-latched, or if a
#                                                                  SIBLING sharing its condition is
#                                                                  held & live (see CONDITION LEASE),
#                                                                  or — on --venue cloud ONLY — if
#                                                                  the work cannot run off-box
#                                                                  (see OFF-BOX ELIGIBILITY)
#   link    <id> --condition <slug> [--force]                    → join an EXISTING row to a
#                                                                  condition group (the lease's
#                                                                  population); --force to re-key
#   dups    [--project P] [--json]                               → REPORT candidate duplicate rows
#                                                                  (same project+dodRef, live, not
#                                                                  already linked). Gates nothing.
#   reclaim <id> --by <worker-identity>                          → re-key a live claim to its WORKER
#   done    <id> --evidence <ref>
#   reopen  <id> [--by <sid>] [--force]
#           [--self-release spawn-fail|compose-fail|worktree-fail]  → the CLAIMER releasing a claim
#                                                                  it never started work on; NOT
#                                                                  counted as thrash (see SELF-RELEASE)
#   block   <id> --needs "<operator-only step>"                  → status "blocked"
#   unblock <id>                                                 → back to "open"
#   needs   "<step>" [--run C] [--project P] [--session S]       → file it ALREADY blocked; echoes the id
#   reap    [--dry-run]                                          → stale-claim maintenance sweep
#   compact [--older-than-days N]                                (default N=30)
#
# ── VENUE (2026-08-07, backlog 191d4d056c98) ────────────────────────────────────────────────────
# A claim may carry `--venue local|cloud`. It names WHERE the worker runs, and it exists for exactly
# one reason: it decides WHICH ORACLES ARE ENTITLED TO A VERDICT about that claim.
#
# Both liveness oracles read host-local state — `kill -0` against this kernel's pid table plus the
# cc-sessions pane registry (claimer_live), and `lsof -d cwd` / `pgrep -f` over a local worktree
# (owned_wait). A worker in an Anthropic-managed VM is in none of those populations. The failure
# that follows is NOT the missing-instrument case rc 2 was designed for: the local instruments are
# all perfectly healthy, they simply have no cloud rows, so they ANSWER — and the answer is
# "absent", which the code reads as rc 1, PROVEN NOT-LIVE. A confident wrong verdict clears every
# rc-2 safety net and reaches `reopen`, which is cc-dispatch's fire predicate.
#
# Measured 2026-08-07, hermetic store, claim aged past the stale gate, `reap --dry-run`:
#     claimer "cloudvm-4242"                        → WOULD-REOPEN [dead-worker]
#     claimer "6c135981-cacf-4527-acd2-0000...0000" → WOULD-REOPEN [dead-worker]
#     claimer "<this-host>-<live-pid>"              → WOULD-BLOCK  [wedged live worker]   ← control
# Every cloud claim shape convicts; no spelling abstains. The third line is the positive control
# that makes the first two a fact about the VENUE and not about the probe.
#
# The rule, then: an oracle that cannot SEE a population must not RETURN A VERDICT about it. On a
# non-local venue both oracles return rc 2 (UNRESOLVED). No new machinery follows — `reap` already
# abstains on rc 2 and the lease already refuses to displace on anything but rc 1 — so an
# unobservable cloud worker STRANDS VISIBLY (bounded by CC_BACKLOG_UNRESOLVED_MAX_S, then BLOCKs to
# a human) instead of being silently double-dispatched. That is the asymmetry the whole stack is
# built on: stranding is visible and recoverable, double-dispatch is neither.
#
# Three properties keep this from blunting local detection:
#   · EXPLICIT, never inferred. An absent field folds to "local", so all pre-existing records and
#     every local claim behave exactly as before. Inferring the venue from "the registry didn't
#     list it" would BE the bug — that is how a dead local worker is correctly detected.
#   · CLOSED-SET. `--venue clod` is rc 2 at the door, not free text that falls back to local.
#   · RESET ON CLAIM, carried by `reclaim`. The venue keys to the record that names the holder.
#
# Cloud liveness cannot be read from this box's process table at all; it is read from the repo side
# and the control plane. The observable set, the channel taxonomy and the producer contract a cloud
# dispatch must satisfy before it is fired: docs/research/cloud-observability-2026-08-07.md.
#
# ── OFF-BOX ELIGIBILITY (2026-08-08, gate G8) ───────────────────────────────────────────────────
# `--venue cloud` says WHERE the worker runs. This asks the prior question: may this WORK go there
# at all? CONCURRENCY_PROGRAM.md §S5 settles it in a sentence — "repo-only work ✅ · visual design ❌
# (needs the local browser + dev server) · anything about this box ❌ · branch banking ⚠️" — measured
# in docs/research/concurrency-census-2026-08-07.md §5, and until G8 enforced NOWHERE. A conclusion
# that reaches only a plan file is behind a diode: nothing re-reads it when a claim is taken.
#
# The predicate lives in `bin/cc-eligible` (ONE implementation, shared by the gate and the census,
# so a report and a refusal cannot drift) and is called from guard (5b). Contract, mirroring
# cc-premise exactly: `verdict=<token>` on line 1, exit 3 iff INELIGIBLE, fail-OPEN on everything
# it cannot read. Only exit 3 blocks; the claim then returns rc 4 with `verdict=cloud-ineligible`.
#
# Off-switch `CC_BACKLOG_ELIGIBLE_GATE=off`, helper override `CC_BACKLOG_ELIGIBLE_BIN`. A LOCAL
# claim never reaches the block — it is gated on `[ "$venue" = cloud ]` — so nothing about local
# claiming changed, which is what tests/cc-backlog-venue.bats' same-item local control pins.
#
# ── SELF-RELEASE (2026-08-07, backlog 98e0e325b3ed) ─────────────────────────────────────────────
# `reopen --self-release <token>` marks a reopen the CLAIMER issued because it could not START the
# work: cc-dispatch rolling back its own uncommenced claim after the fire was refused, the brief
# failed to compose, or the worktree could not be provisioned. It exists for exactly one reason:
# REAP'S RULE B MUST NOT COUNT IT.
#
# Rule B blocks an item after MAX_THRASH fast claim→reopen pairs, and it is the only rule in `reap`
# that fires on TRAIL SHAPE ALONE — no oracle, no abstention. That was survivable while the shape
# meant "a worker keeps bouncing off this item". It does not. cc-dispatch takes the claim BEFORE it
# fires and self-releases on every failure path, so a refused fire writes the identical shape while
# no worker has been anywhere near the item.
#
# Measured 2026-08-07 over the live store, with the control that makes it a fact about the mechanism
# and not about the probe:
#     items blocked "persistent thrash — the worker cannot land"            228
#       …of those, every counted pair authored by ONE identity on both sides 228   (self-release)
#       …of those, that would STILL block once self-releases are excluded      0
#       …that never held a claim for even the 90 s window (no worker ran)    182
#     fast claim→reopen pairs across the WHOLE ledger: same-author 691 / different-author 14
#     cc-dispatch verdicts in one 2 h window: `spawn rc=9 (reopened)` 36  vs  `fired` 5
# rc 9 is the FIRE CAPACITY GATE, whose own refusal text is "Shed load first … then re-fire" — a
# condition the producer explicitly asks the caller to retry. Rule B converted two of those, 90 s
# apart, into `blocked`: the OPERATOR-ONLY state, which cc-dispatch excludes from the wave by
# construction. So a transient load spike permanently removed work from the autonomous queue, and
# 64% of everything blocked in this store got there that way.
#
# That is CONCURRENCY_PROGRAM.md §0's bootstrap cycle with its engine finally named — and the engine
# is not the landing gate the plan blamed. No land was involved in 182 of the 228; there was no
# worker to land anything.
#
# Three properties, each the same doctrine the rest of this file already follows:
#   · POSITIVE EVIDENCE, never inference. Only a reopen that ASSERTS `selfRelease` is skipped. The
#     authorship correlation above is what made the diagnosis; it is deliberately NOT the predicate,
#     because `by` is ambiguous (a bare `cc-backlog reopen` writes none) and a predicate that guesses
#     would suppress the one shape rule B exists to see.
#   · CLOSED-SET + CLAIMER-AUTHENTICATED. This flag SUPPRESSES a guard, so a typo must be rc 2 at the
#     door, and only the identity the ledger folds as the current claimer may assert it (rc 4).
#   · REPORTED, NEVER ACTED ON. A large self-release count says nothing about any item and a great
#     deal about the machine, so `reap` prints it every sweep instead of blocking on it.
#
# The historical rows carry no flag — the recovery of items already blocked this way is
# scripts/thrash-block-recover.sh, which re-derives the verdict per item and never hardcodes a list.
#
# ── CONDITION KEY (2026-08-06, backlog 0b3a8b19d4d4) ────────────────────────────────────────────
# The event key is project+title+source, so a title carrying a LIVE MEASUREMENT re-keys itself every
# time it is measured. One standing condition — "this project's memory index is over its loader
# budget" — therefore minted 21 separate items between 2026-07-25 and 2026-08-06 (15 for
# claude-infrastructure, 6 for reso-management-app) instead of deduping to one: `…21.2KB…`,
# `…22.1KB…`, `…23.3KB…`, `…24.1KB…`, `…20.5KB…`, `…20.6KB…`, each a different hash of the same fact.
# The ledger did not merely fail to dedupe them — its own DONE-GUARD could not fire either, because a
# re-file of finished work only reads as a re-file when it lands on the SAME key: 004502cf59ab was
# closed at 21:28:01Z and 0fc2ae0d0140 was CLAIMED at 21:34:01Z, six minutes later, same condition,
# no code change in between, and the ledger reported two pieces of work. This is `deploy-live`'s
# sha-keyed host-RED item (fixed in 8035ea63, MEMORY.md per-event-key-defeats-per-finding-dedupe)
# arriving through a title instead of a sha.
#
# `--condition <slug>` keys the id on project+condition and DROPS title and source from the hash.
# The measurement stays in the --title, which is where a human reads it; it simply stops being
# identity. One condition, one item — whichever session observes it, and whatever it measured.
#
# THE SLUG MAY NOT CONTAIN A DIGIT, and that is the guard, not a style rule. A flag that accepted
# `--condition memory-index-over-budget-20.5KB` would reproduce one layer down the exact defect it
# exists to kill. The rule is written against the CLASS, not a list of spellings (MEMORY.md
# denylist-enumerates-spellings-not-the-class): every measurement — a size, a count, a percentage, a
# timestamp, a sha — is a number, and a condition is a STATE, which needs none. The cost of the
# over-strictness is spelling a numeral (`opus-five-routing-drift`); the refusal names that, and
# names --title as where the number belongs.
#
# OPT-IN, NEVER INFERRED. Most work IS per-event and MUST re-key: `postland-verify` puts the culprit
# sha in its title on purpose ("sha defeats wasDone" — a new RED at a new commit is new work), and
# collapsing distinct items onto one key would silently destroy one of them. Nothing here reads the
# title to guess, because the same ledger holds SIX more MEMORY.md-titled items that are different
# work (index a topic file · capture a lesson · fix the nudge hook's cardinality blindness · fix
# compact-memory.md's orphan sweep), and no pattern separates those from the 21 above. The caller
# knows which channel it is in; a regex does not.
#
# ── CONDITION LEASE (2026-08-07, backlog 0bded74c6fa2) ─────────────────────────────────────────
# The block above dedupes at `add`. It cannot dedupe what `add` never saw: two SESSIONS filing one
# piece of work in two wordings mint two ids, and nothing downstream re-joins them. Measured
# 2026-08-07 — 97f16b6709fa (08:47:44Z) and 6078392359ac (08:47:54Z), same project, same dodRef,
# ten seconds apart, a session and its successor, NEITHER carrying a condition. Both were claimed,
# both dispatched, and two worktrees built the same mechanism to completion. 97f16b6709fa's own
# closing evidence records it: "faces 3-4 proper were landed by DUPLICATE-DISPATCH sibling
# 6078392359ac; this item delivered the surviving delta."
#
# So the lease must be taken on the CONDITION, not the row — and two things had to change for that
# sentence to mean anything.
#
# (1) A CONDITION MUST BE ATTACHABLE TO A ROW THAT ALREADY EXISTS (`link`). Note what the block
#     above implies: `mk_cond_id` hashes project+condition into the ID, so two rows sharing a
#     condition ARE one row, and the ledger contains ZERO groups with >1 distinct id per
#     (project, condition) — verified over all 1257 add events. A lease keyed on `.condition` alone
#     therefore governs an EMPTY POPULATION and could never fire on any ledger. `--condition` is
#     settable only at `add`, by the filer, who by construction has not seen the sibling row; the
#     actor who CAN see both rows is a later reader of the ledger, and until `link` there was no
#     verb for it to speak. (memory: work-item-citation-refutes-its-own-remedy.)
#
# (2) NO AUTOMATIC KEY IS SOUND, and dodRef is the one that looks it. Both incident rows share a
#     dodRef, so it is the obvious inference. Replaying every claim INTERVAL in the ledger and
#     counting same-dodRef pairs whose claims overlapped in time — exactly the dispatches such a
#     lease would have deferred — gives 81 overlaps across 7 groups, of which ONE is the incident:
#     70 are ORCHESTRATOR_DESK_24X7_PLAN.md, a 22-item plan whose phases are DESIGNED to run in
#     parallel. ~1 true positive in 81. The incident's own doc refutes it hardest: that dodRef holds
#     THREE items, and the third (8e8a306f6dc0, "postland auto-revert actuator is 12% effective") is
#     unrelated work that overlapped both duplicates — so dodRef groups the duplicate WITH the
#     non-duplicate even in the single case it was derived from. It ships as `dups` (a REPORT that
#     gates nothing, where a 98% false-positive rate costs only reading) and never as a predicate.
#
# The lease itself is claim guard (6) below. It lives HERE, in the actuator, and not in cc-dispatch
# where the item filed it: the item is right that dedupe belongs at DISPATCH TIME rather than at
# `add`, but a sibling check inside the dispatcher would read the ledger and then claim, and a
# concurrent pass slips between the read and the append. `claim` already holds the fold one step
# before the append (memory: make-the-actuator-the-arbiter, and cc-dispatch's own step 5a: "THE
# ACTUATOR IS THE ARBITER … this caller must not re-implement").
#
# KICK ON WRITE (S5): a successful `add` fires ONE debounced, detached `cc-dispatch --decide` pass
# so new work gets a decision in seconds instead of waiting out the launchd interval. Strictly
# best-effort — it can never change `add`'s exit code, its stdout (the id) or the ledger record.
# Switches: CC_BACKLOG_KICK=off · CC_DISPATCH_KICK_DEBOUNCE_S (30) · CC_BACKLOG_KICK_MARKER ·
# CC_BACKLOG_KICK_BIN. The launchd timer remains the backstop that guarantees the bound.
#
# REOPEN GUARDS (added 2026-07-20 after a60d62a215f1 → 6488617 burned a peer session). `reopen`
# was the ONE transition with no status check at all: it would resurrect a terminal item and it
# would yank an item out from under a worker that was still running. Both put the item back at
# status "open", which is exactly cc-dispatch's fire predicate — so the next tick claimed and
# spawned on it. Two guards, both overridable by an explicit `--force`:
#
#   (1) TERMINAL — `reopen` of a `done` item is REFUSED (rc 4). Re-doing landed work is a pure
#       waste of a worker session. A genuine regression / premature `done` is re-opened
#       DELIBERATELY with `--force`, which is recorded in the trail as `force:true`.
#   (2) LIVE CLAIM — `reopen` of a `claimed` item whose claimer is PROVABLY live (the same
#       `claimer_live` oracle `reap` uses) and is not the caller is REFUSED (rc 4). This is the
#       mechanism that actually fired: the item was reopened 33 min into a live claim, and the
#       next dispatch tick claimed + spawned a second peer 15 s later.
#       Deliberately NOT refused: a claimer releasing its OWN claim (pass `--by <its sid>` — this
#       is cc-dispatch's spawn-fail rollback), and a claim whose owner is dead or unattributable
#       (that is `reap`'s dead-worker path — stranding the work is the worse failure).
#
# THE CLAIM IS A LEASE (2026-08-05, backlog 1cb7724b2ed9) — the SYMMETRIC half of guard (2) above.
# `reopen` could not yank a live claim, but `claim` could OVERWRITE one: cmd_transition appended the
# event from any status, so a second `claim` on a held item simply advanced `by` to the new claimer.
# The fold then named worker B while worker A was still running — the ledger did not merely fail to
# refuse the duplicate, it FORGOT the incumbent, which is why `list` reads "open work, one worker"
# through the entire overlap. Guarding `reopen` alone was never enough: `reopen` is the release
# path, `claim` is the ACQUIRE path, and only the acquire path can be raced by two dispatchers.
#
# THE INCIDENT (item b0b4ec40d63a, verified from this ledger + the IDL). 08:35:12 cc-dispatch claims
# and spawns; 08:46:16 the spawn returns rc=1 and dispatch SELF-RELEASES (`reopen --by $SID`, exempt
# above and correctly so); a worker was meanwhile running in `.worktrees/wt-handoff-kitty-daemon` —
# a hand-named worktree, so session-register's reclaim gate (which requires `wt-<12-hex>`) abstained
# and it held NO claim at all; 09:04:29 a second claim `--by wt-b0b4ec40d63a` succeeded against the
# now-open item and a second worker ran ~10 h on work the first landed at 12:34. Cost: one worker
# slot, and a near-miss worse than the cost — B was ~30 min from landing a WEAKER duplicate fix on
# top of A's. The lease cannot un-cause an unclaimed worker, but it is what makes the second
# acquisition REFUSABLE, whatever spawned it: dispatcher, desk, or a worker claiming by hand.
#
# THE PREDICATE IS INVERTED vs guard (2), deliberately — do not "fix" it to match. Both call the
# same three-valued `claimer_live`, but the dangerous act is on opposite sides: `reopen`'s action is
# the safe default and only a PROVEN-LIVE claimer (rc 0) stops it, whereas `claim`'s action is the
# one that mints a duplicate worker, so only a PROVEN-DEAD claimer (rc 1) may be displaced. rc 2 —
# UNRESOLVED — therefore REFUSES here and PROCEEDS there, and that is the same rule ("abstain, never
# convict") read through each verb's own risk: abstaining from a claim means leaving the incumbent
# alone. Our own unresolvable probe must never mint the evidence that hands live work to a second
# worker (memory: claimed-outcome-vs-checked-outcome). The cost is bounded and in the direction this
# file already chose everywhere else — a claim refused on a non-verdict strands the item VISIBLY
# until `reap`'s abstention ceiling blocks it out to a human; double-dispatch is neither visible
# nor bounded.
#
# …AND ONE ORACLE IS NOT ENOUGH TO DISPLACE (2026-08-06, backlog 9887dbe5ef5c). The paragraph above
# is right about the DIRECTION and was wrong about the EVIDENCE: it let a single proven-dead verdict
# from `claimer_live` displace an incumbent, and a `<host>-<pid>` claim names a SHELL, not the work.
# Shells rotate; the work does not. Item e1ce92772859 was claimed 08:03:52Z by
# `Chriss-MacBook-Pro-3-33510`, that pid was gone by 09:01:47Z while the worker ran `cc-bats` on the
# item's own suite in `.worktrees/wt-e1ce92772859`, the lease GRANTED (rc 0), and a second session
# duplicated ~20 min of work before spotting the live sibling by lsof — the incumbent landed the
# better fix (66871b9b) six minutes later and the duplicate commit was discarded. So a duplicate was
# the DEFAULT outcome for any worker whose shell pid rotated, which is precisely what `reclaim`
# existing as a MANUAL repair had been admitting all along.
#
# `reap` never had this hole: since 2026-07-26 it RE-VERIFIES a dead claimer against the item's
# worktree (`owned_wait`) before any dead-worker path, because a dispatched claim's `by` is a spent
# pid that cannot see the worker. The two verbs therefore disagreed about what "live" means, and the
# verb with the weaker predicate was the one that mints a duplicate. `claim` now asks the SAME
# oracle, called and not restated (memory: sibling-auditors-must-share-the-state-model,
# make-the-actuator-the-arbiter) — displacement requires oracle 1 AND oracle 2 to say not-live, the
# exact conjunction `reap` requires to reopen. The stored `by` is deliberately left a pid: the
# durable identity that fixes this is the WORKTREE (memory: argv-is-sampling-cwd-is-durable), and
# keying the PREDICATE on it costs one call where re-keying every writer's identity would be a schema
# change across every claim producer for no additional safety. Full rationale at guard (5) below.
#
# WHAT IT IS NOT. Not a lock: nothing is held, nothing must be released, and no path can wedge on
# it. The lease IS the fold — a CAS against the item's current `(status, by)` at append time — so it
# inherits the store's append-only concurrency properties unchanged and adds no new resolution
# surface (its `kill -0` and worktree-occupancy branches are the two `reap` already runs — that
# sameness is the point of guard (5), not a coincidence). The EXPIRY half needs no new
# mechanism either: `reap` Rule A already reopens a dead-worker claim past STALE_CLAIM_S, bounded by
# MAX_ATTEMPTS — a lease whose worker died is exactly the case it was built for.
#
# WHERE THE REFUSAL LANDS. cc-dispatch already branches on the claim's exit code (`claim failed` →
# no spawn, next item), so the actuator needed no new predicate of its own and none was added — the
# gate is enforced where the write happens, never re-implemented by a caller that could drift from
# it (memory: make-the-actuator-the-arbiter). [AMENDED 2026-08-05, backlog dadc3c2410aa: rc 4 gained
# a SECOND cause (the done latch below) whose correct journalling is the opposite — skip, not fail —
# so cc-dispatch now reads the `verdict=` token this file emits on line 1. That is still not a
# predicate of its own: it consumes THIS verb's verdict rather than re-deriving one, so there is
# nothing to drift. A lease refusal carries no token and keeps its `failed` classification exactly.]
#
# The DONE latch also survives the fold as `wasDone`, which cc-dispatch reads to keep completed
# work out of the wave even if something re-opened it by hand. `--force` is what clears it.
#
# CLAIM DONE-GUARD (2026-08-05, backlog dadc3c2410aa) — the residual race in guard (1)'s remedy, and
# the THIRD `claim`-side refusal alongside the lease above. The two are complementary, not variants:
# the lease answers "is someone else ALREADY ON this?" (status `claimed`), this answers "is this
# work already FINISHED?" (the `wasDone` latch). A done-latched item folds `done` or `open`, never
# `claimed`, so the lease cannot see it — and it landed hours apart from this, on a separate item.
# cc-dispatch's `wasDone` filter is PULL-TIME ONLY: it reads a snapshot at step 1 and claims at
# step 5, and the gap between them is the documented 7-45 s wave-plan PLUS the admission tail
# (warm_worktree + handoff-fire). A `done` landing anywhere inside that gap is invisible to the
# snapshot, so the claim fires against stale truth. MEASURED live: item 5690b9d11bee recorded
# `event:"done"` at 20:20:52Z and `event:"claim"` at 20:26:15Z — 5 m 23 s later, on the same id —
# and the spawned worker burned a whole session re-verifying work that had already landed.
#
#   (3) DONE LATCH — `claim` of an item whose fold carries `wasDone == true` is REFUSED (rc 4),
#       showing the prior evidence and naming the override. `--force` claims it anyway and is
#       recorded as `force:true` (it does NOT clear the latch — only `reopen --force` does, so a
#       forced claim cannot silently make landed work permanently re-dispatchable).
#
# THE ACTUATOR IS THE ARBITER, which is why this lives here and not as a second pull-time re-check
# in cc-dispatch. A re-read before the claim would only NARROW the window — the read and the append
# are still two steps — and it would leave every OTHER caller of `claim` unguarded. Folding the
# predicate into the transition that actually takes the claim means no caller can race it beyond
# the fold→append instant. cc-dispatch still keeps its step-1b filter: that one is the cheap fence
# that stops a done-latched item consuming a wave-plan slot and a quota placement at all; this one
# is the backstop for what lands DURING the tail.
#
# RC 4 NOW HAS TWO CAUSES, and its consumer must tell them apart, so this refusal states
# `verdict=done-latched` on LINE 1 (the only line `cc-dispatch`'s head-biased `claim_excerpt`
# keeps). cc-dispatch records a done-latch refusal as `skipped` — a raced landing is not a
# dispatcher fault and nothing needs a human — while a LEASE refusal keeps its existing `failed`
# classification untouched. Parsed as a token, never prose-matched, and POSITIVE on the skip-worthy
# cause: were the token ever lost, a done-latch refusal would degrade to the lease's `failed` path,
# i.e. to the incumbent behaviour rather than to a new hole.
#
# DELIBERATELY NOT guarded: `reclaim`, which only re-KEYS an already-`claimed` item to the worker
# actually doing the work and can never create a claim on an open one (it refuses any other status
# — verdict `noop-status`). Guarding it would strand a live claim under the wrong identity, which
# is strictly worse and buys nothing.
#
# BLOCKED-ON-OPERATOR: an item whose DoD needs an operator-only step (a key, a
# `launchctl bootout`, any human action) is `block`ed with the pending step in
# `--needs`. `blocked` folds distinctly from `open`, so cc-dispatch EXCLUDES it
# from the wave (no re-dispatch loop), while `list --open`/`--blocked` and the desk
# digest still SURFACE it + its `needs`. The operator `unblock`s once the step is
# done → back to `open` → dispatchable again.
#
# `needs` is the ONE-LINE front door to that state, and exists because the two-command
# path (`add` then `block`) is what made an agent PROSE the step instead of filing it:
# an operator-only step that lives nowhere on disk cannot be rendered by
# hooks/operator-readout.sh, which builds the close block BY CONSTRUCTION from disk truth,
# so it gets buried in prose and missed. `needs "<step>"` appends the SAME two records
# (`add` then `block`, via cmd_add + cmd_transition — no third writer) and echoes the id.
# It deliberately does NOT fire dispatch_kick: the item is born `blocked`, which is
# excluded from the wave by construction, so a kick is pure waste AND risks spawning a
# worker onto a human-only step. `--source needs` keys it apart from a same-titled `add`.
# Two extra fields ride the `block` record for the renderers (frozen contract, carried
# through the fold to `list --blocked --json`):
#   run     — the EXACT runnable command (`--run`), so cc-do can offer it verbatim rather
#             than the operator reconstructing it from prose. Omitted when absent.
#   session — the filing session (`--session` > $CLAUDE_SESSION_ID > $CC_SESSION_ID),
#             so a step can be attributed back to the close that raised it. Omitted when
#             none resolves.
# Both are OMITTED, never emitted empty: a consumer must be able to tell "no command" from
# "an empty command".
#
# REAP (stale-claim maintenance — the dead-worker/thrash sweep): `block` above covers only
# OPERATOR-gated items and cc-reconcile heals only the SESSION registry — neither touches a
# CLAIM whose worker DIED. A `claim`ed item whose worker is gone (limit-killed, crashed, or
# self-closed without transitioning) stays `claimed` forever — cc-dispatch fires only
# status=="open", so the work STRANDS; a spawn-fail / land-conflict item THRASHES the wave
# (claim→reopen→claim…). `reap` folds the trail and, append-only + idempotent: (B, priority)
# BLOCKS an item with >= MAX_THRASH fast claim→reopen cycles (the spawn-fail / rebase-exit-5
# signature) so it leaves the wave for a human; (A) REOPENS a dead-worker claim idle past
# STALE_CLAIM_S whose claimer is not live — BOUNDED, so after MAX_ATTEMPTS dispatch claims a
# still-stale item is BLOCKED instead (never a slow-reopen loop). cc-reaper calls it each
# --reap sweep. All thresholds env-tunable (see the reap body).
#
# WORKER-KEYED CLAIMS (`reclaim`, 2026-07-29, backlog a13fb1d41044) — the fix for the defect the
# whole owned_wait apparatus below exists to WORK AROUND. cc-dispatch claims with `--by <host>-$$`,
# its OWN pid, and then exits: within seconds the claim names a dead process, so past the stale gate
# `claimer_live` is false BY CONSTRUCTION for every dispatched item and Rule A degrades to an
# age-only heuristic (audit synthesis §V1 S2: a live 91-minute worker gets reopened → double-dispatch;
# a worker dead at minute 5 strands 85 min). V1 could not fix it at the source — the spawned session
# has no identity until it exists — so liveness was keyed on the worktree instead (oracle 2).
#
# `reclaim` closes it from the WORKER's side, where the identity does exist: the dispatched session
# re-keys its own claim to a handle that lives exactly as long as the work. The bug was never the
# `<host>-<pid>` FORM — it was WHOSE pid, so the fix reuses the existing `kill -0` path verbatim and
# adds no new resolution surface. Actuated by hooks/session-register.sh at SessionStart (an
# already-registered hook — no settings.json activation gate, hence live on land rather than staged
# inert); deliberately a MECHANISM at process start, not a model instruction "on engagement", because
# the pid is authoritative from the instant the process exists and a session that never engages must
# still be reapable (memory: feature-durability-mechanism-not-memory).
#
# Recorded as `event:"claim"` + `reclaim:true` — the FOLD is deliberately unchanged (status stays
# "claimed", `by` advances to the worker), so no existing consumer of the trail needs to learn a new
# state (memory: named-failure-vs-no-verdict). The marker exists because two things must NOT count a
# re-key as a dispatch attempt: reap's `totalClaims` bound (see MAX_ATTEMPTS) and dispatch-assert's
# discharge predicate.
#
# DISPATCHER HAND-OVER (`claim --role dispatcher`, 2026-08-09, backlog b922dde5567b) — what made the
# above ACTUALLY WORK. The paragraph two up says cc-dispatch "claims with its OWN pid and then
# exits". The second half is false often enough to matter: a `--once` pass holds its claim for the
# whole pass, and the worker's SessionStart hand-over runs INSIDE that window — so the incumbent is
# a LIVE `<host>-<pid>`, `reclaim`'s anti-steal guard refused, and the worker was then refused on its
# own first write by scripts/lib/worker-claim-gate.sh as a "duplicate" of its own dispatcher. Measured
# live 2026-08-09: dispatcher pid 49310 claimed at 14:46:44, the worker's re-key was refused at
# 14:49:41, its first Edit was denied at 14:53. Since session-register re-keys exactly ONCE, at
# process start, a dispatcher that outlives its worker's SessionStart STRANDS that worker outright;
# the item's own thrash counter had already recorded two claim→reopen cycles, and cycle 3 completed
# only because that pass happened to exit first. The deadlock was resolving on TIMING LUCK.
#
# The discriminator cannot be liveness — a dispatcher is alive by construction and does no work — so
# the CLAIM RECORD CARRIES WHAT THE CLAIMER IS. `claim --role dispatcher` (cc-dispatch, G6) marks a
# PLACEHOLDER lease held for a worker that does not exist yet; `reclaim` may re-key past such a claim
# regardless of liveness, and past nothing else. It is one-shot: the re-key writes no role and fold()
# RESETS role on every claim record, so the item becomes worker-held immediately and a second worker
# racing it meets the ordinary live-claimer refusal. Full safety argument at cmd_reclaim.
#
# DEAD-WORKER EVIDENCE — the rule the whole sweep turns on: a dead verdict is keyed on PROCESS
# LIVENESS, never on elapsed claim time or attempt count. Elapsed time only GATES when to ask; it is
# never itself the answer. Under contention a healthy worker legitimately sits 5000s+ inside one
# full-suite gate, so a long claim is a signal of CONTENTION, not of death. Three oracles, and a
# reopen requires that one of them actually returned the verdict "not live":
#   1. CLAIMER  `kill -0` on a <host>-<pid> claim, else the cc-sessions registry (claimer_live).
#      Authoritative only once the claim names the WORKER (see WORKER-KEYED CLAIMS above). A claimer
#      that reads LIVE is KEPT — but bounded by LIVE_CLAIM_MAX_S, because worker-keying makes this
#      the normal path for every dispatched item and an unbounded "live ⇒ keep" would let one
#      never-engaged pane pin its item forever (memory: universalizing-a-mechanism-promotes-its-
#      latent-leak — the lifecycle guard ships in the same change as the universalization). Past the
#      ceiling it BLOCKS out to a human, exactly like a wedged owned wait, and never reopens.
#   2. WORKTREE  "not live" is asked of the CLAIMER, and a dispatched claim's `by` is cc-dispatch's
#      own spent pid — so before any dead verdict, reap re-verifies against the item's WORKTREE: a
#      live process tree there — named in a process's argv (a running gate / ship-land / queued
#      land-lock) OR occupying it as a process's CWD (the dispatched worker itself, whose launcher
#      carried the path and exited) — or the land lock held for its branch, is an OWNED WAIT: alive,
#      merely slow, and never called dead. A wait still present past OWNED_WAIT_MAX_S is a WEDGE:
#      blocked (never reopened — its worktree is occupied) and named as such. See the owned_wait body
#      for the full rationale and the incident it came from.
#   3. ABSTENTION  an oracle that produced NO ANSWER is a NON-VERDICT, not a death: the item is KEPT
#      and the abstention is printed. Bounded by UNRESOLVED_MAX_S, past which it BLOCKS out to a
#      human — it still never reopens, because an unanswered probe is not proof of death at any age.
#      This covers BOTH oracles, and it has to. The claimer probe abstains when the registry is
#      absent, wedged, or unparseable. The WORKTREE probe abstains when lsof is missing, disabled, or
#      times out, or when CC_BACKLOG_WT_ROOT itself is unreadable — and that leg was missing until
#      2026-07-30 (backlog 9efae9e3cfc1). It mattered more than the claimer's: a dispatched claim's
#      `by` is a spent pid, so oracle 1 returns a REAL not-live verdict and only oracle 2 can speak
#      for the worker. With its silence folded into "worktree empty", a starved probe read as a dead
#      worker and reopened it — and the starvation is load-correlated (a full-system lsof exceeding
#      its cap), so one starved sweep reopened a BATCH of live workers whose duplicate peers then
#      raised the load that starved the next sweep. TOTAL starvation now fails toward KEEP.
# Why the asymmetry is not merely tidy: `reopen` sets status=open, which is exactly cc-dispatch's
# fire predicate, so a false dead verdict SPAWNS A DUPLICATE PEER onto live work (a60d62a215f1 →
# 6488617). A missed dead worker only strands an item, visibly, until the next sweep.
#
# THE DECISION JOURNAL — every verdict above (KEEP / BLOCK / REOPEN / abstain) appends one record to
# the autonomy IDL (${CC_BACKLOG_IDL:-~/.claude/autonomy/idl.jsonl}), carrying the ORACLE EVIDENCE it
# turned on. Live mode only: `--dry-run` writes nothing, journal included. See idl_verdict.
set -uo pipefail

BACKLOG="${CC_BACKLOG_FILE:-$HOME/.claude/autonomy/backlog.jsonl}"
IDL="${CC_BACKLOG_IDL:-$HOME/.claude/autonomy/idl.jsonl}"

usage() {
  sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'
}

now_iso()  { date -u +%Y-%m-%dT%H:%M:%SZ; }

# cutoff_iso <days-ago> → an ISO-8601 UTC timestamp N days in the past (BSD + GNU).
cutoff_iso() {
  local d="$1"
  date -u -v-"${d}"d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u -d "-${d} days" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null
}

# mk_id <project> <title> <source> → 12-hex event key (US-separated, collision-safe).
mk_id() { printf '%s\037%s\037%s' "$1" "$2" "$3" | shasum -a 256 | cut -c1-12; }

# mk_cond_id <project> <condition> → 12-hex CONDITION key (see CONDITION KEY in the header).
#
# FOUR \037-separated fields against mk_id's THREE, and that field count is the domain separation —
# not the `cc-backlog-condition` tag, which by itself separates nothing. Both --title and --source
# are free-form, so a literal tag placed in any of mk_id's three slots is simply a string a caller
# can also type: the first cut of this function put `condition` in the third slot, and
# `add --project P --title memory-index-over-budget --source condition` hashed to the identical
# bytes. A three-field input can now only reproduce a four-field one by CONTAINING a literal US
# byte, which no shell caller produces by accident. tests/cc-backlog-condition.bats pins the
# non-collision against exactly the add that used to hit it.
mk_cond_id() {
  printf '%s\037%s\037%s\037%s' 'cc-backlog' 'condition-v1' "$1" "$2" | shasum -a 256 | cut -c1-12
}

# valid_condition <slug> → 0 when the slug can serve as a STABLE key, 1 otherwise.
# Lowercase letters and hyphens, starting and ending on a letter, at most 64 chars. The digit ban is
# the substantive rule and the header explains it; the rest is just keeping the key legible in a
# `list` table and in a shell argument.
valid_condition() {
  local c="$1"
  [ -n "$c" ] || return 1
  [ "${#c}" -le 64 ] || return 1
  case "$c" in
    *[!a-z-]*) return 1 ;;        # anything but lowercase + hyphen — digits land here
    -*|*-)     return 1 ;;
    *--*)      return 1 ;;
  esac
  return 0
}

ensure_file() {
  mkdir -p "$(dirname "$BACKLOG")" 2>/dev/null || true
  [ -f "$BACKLOG" ] || : > "$BACKLOG"
}

# ── compact-only mutex (a15/D2) ────────────────────────────────────────────────────────────────
# Serializes compact against ANOTHER compact — two concurrent rewriters of one file cannot be made
# safe by retry alone, because each would validate against the other's half-written state. It is
# deliberately NOT taken by the append verbs: bare O_APPEND is atomic for these line lengths and
# keeping ~14 writers coordination-free is a design property of this store, not an oversight. What
# protects compact from appenders is the optimistic re-check in cmd_compact, not this lock.
#
# Owner-token verified for the same reason as every other lock in this change: reaping on age alone
# lets a slow holder have its lock stolen and then delete the thief's, admitting a third. A live,
# identity-confirmed holder is never reclaimed; a dead one is reclaimed at once.
# Env (tests): CC_BACKLOG_LOCK_DIR · CC_BACKLOG_LOCK_STALE_S.
_bl_lock_dir() { printf '%s' "${CC_BACKLOG_LOCK_DIR:-$BACKLOG.compact.lock.d}"; }

_bl_compact_lock() {
  local ld tok="" stale="${CC_BACKLOG_LOCK_STALE_S:-300}" age
  ld="$(_bl_lock_dir)"
  mkdir "$ld" 2>/dev/null && { printf '%s\n' "$$" > "$ld/owner" 2>/dev/null || true; return 0; }
  [ -f "$ld/owner" ] && { read -r tok < "$ld/owner" 2>/dev/null || tok=""; }
  case "$tok" in
    ''|*[!0-9]*)
      # untokened: a holder mid-acquire, or pre-fix debris. Age decides, so a peer milliseconds from
      # writing its token is never robbed.
      age=$(( $(date +%s) - $(stat -f %m "$ld" 2>/dev/null || stat -c %Y "$ld" 2>/dev/null || echo 0) ))
      [ "$age" -ge "$stale" ] || return 1 ;;
    *) kill -0 "$tok" 2>/dev/null && return 1 ;;   # live holder → never steal
  esac
  rm -rf "$ld" 2>/dev/null || return 1
  mkdir "$ld" 2>/dev/null || return 1              # lost the reclaim race → correctly held
  printf '%s\n' "$$" > "$ld/owner" 2>/dev/null || true
  return 0
}

_bl_compact_unlock() {
  local ld tok=""
  ld="$(_bl_lock_dir)"
  [ -f "$ld/owner" ] && { read -r tok < "$ld/owner" 2>/dev/null || tok=""; }
  if [ -z "$tok" ] || [ "$tok" = "$$" ]; then
    rm -rf "$ld" 2>/dev/null || true
  fi
  return 0
}

# ── TSV field-collapse guard — docs/research/TSV_FIELD_COLLAPSE_2026-07-25.md ──────────────────
# Tab is IFS-*whitespace*, so `IFS=$'\t' read` collapses a RUN of tabs: ANY empty cell shifts every
# later field one position LEFT, silently and with a zero exit status. Here `.needs` is "" on every
# non-blocked item and `.project`/`.title` are attacker-free but not schema-guaranteed, so the row
# is padded at the `@tsv` EMITTER (the only durable fix — the read side cannot be repaired).
# `//` alone is NOT enough: it substitutes for null/false, never for a present-but-empty string.
# Board columns take a VISIBLE placeholder; `.needs` takes $'\037' because the reader needs the
# empty back (`[ -n "$needs" ]` is the blocked-row predicate) — see un-pad below.
CELL='def cell(ph): (if . == null then "" else . end) | tostring
      | gsub("[\\t\\r\\n]"; " ") | if . == "" then ph else . end; '
TSV_PAD=$'\037'

# Emit only well-formed records (must have id+event) to stdout; REPORT malformed
# lines to stderr (fail-loud). Never removes them from the file.
valid_records() { # [--strict] → rc 1 on a short read (default: warn on stderr and return 0, as before)
  # --strict makes the INCOMPLETE verdict below REACHABLE. The check has always existed and has
  # always been right; it just had nowhere to go — stderr prose that no caller parses, then
  # `return 0`. A consumer therefore could not tell "the ledger holds nothing" from "the ledger
  # could not be read", which is the one shape this whole file is built to refuse. Opt-in, so every
  # existing bare call site keeps its exact behaviour and only a caller that has decided what to do
  # with the answer has to handle it (today: cmd_compact, on the empty-drop path).
  local strict=0
  if [ "${1:-}" = --strict ]; then strict=1; shift; fi
  [ -f "$BACKLOG" ] || return 0
  # ONE jq pass, not one fork PER RECORD. jq startup (~6 ms) × a 1552-line APPEND-ONLY ledger was ~9 s
  # of every `cc-reaper --reap` tick — the second-largest cost in that sweep after the inbox guard —
  # and being append-only it could only ever grow. Contract is unchanged: well-formed lines VERBATIM
  # on stdout, malformed ones reported BY LINE NUMBER on stderr, nothing ever removed from the file.
  #
  # The line number is counted HERE rather than taken from jq's input_line_number, which counts
  # newlines CONSUMED — a final line with no trailing newline would share its predecessor's number.
  # One tag per input record (E/G/B) keeps the count exact and keeps a blank line "skipped", never
  # "malformed", exactly as the per-line loop did.
  local tagged n=0 bad=0 want
  while IFS= read -r tagged; do
    n=$((n + 1))
    case "$tagged" in
      G*) printf '%s\n' "${tagged#G}" ;;
      E*) : ;;                       # blank line — skipped silently, still counted (as before)
      *)  printf 'cc-backlog: malformed line %d skipped (still in file)\n' "$n" >&2; bad=$((bad + 1)) ;;
    esac
  done < <(jq -Rr 'if . == "" then "E"
                   elif (try (fromjson | (has("id") and has("event"))) catch false) then "G" + .
                   else "B" end' "$BACKLOG")
  # Fail LOUD on a short read. One jq covering the whole file means a jq failure would otherwise
  # report an EMPTY ledger — a silent "nothing to reap" instead of an error. Per-line forking could
  # not fail this way, so the check is what buys back that safety.
  # NB `grep -c ''` prints 0 and EXITS 1 on an empty file, so `|| echo 0` would append a second 0 and
  # make `want` the two-word "0 0" — which fails the -eq and cries INCOMPLETE on every empty ledger.
  want="$(grep -c '' "$BACKLOG" 2>/dev/null || true)"
  case "$want" in ''|*[!0-9]*) want=0 ;; esac
  local incomplete=0
  if ! [ "$n" -eq "$want" ] 2>/dev/null; then
    incomplete=1
    printf 'cc-backlog: record scan INCOMPLETE — %s of %s line(s) read; ledger NOT fully reported\n' "$n" "$want" >&2
  fi
  [ "$bad" -eq 0 ] || printf 'cc-backlog: %d malformed line(s) reported above\n' "$bad" >&2
  if [ "$strict" -eq 1 ] && [ "$incomplete" -eq 1 ]; then return 1; fi
  return 0
}

# Fold the trail → a JSON ARRAY of one object per id (latest status + carried meta).
fold() { # [--strict] — handed to valid_records; `set -o pipefail` carries its rc out to the caller
  local -a vr=(valid_records)
  if [ "${1:-}" = --strict ]; then vr+=(--strict); shift; fi
  "${vr[@]}" | jq -s '
    reduce .[] as $r ({};
      .[$r.id] = ((.[$r.id] // {}) as $p | {
        id:       $r.id,
        project:  ($r.project  // $p.project  // ""),
        title:    ($r.title    // $p.title    // ""),
        dodRef:   ($r.dodRef   // $p.dodRef   // ""),
        source:   ($r.source   // $p.source   // ""),
        # The CONDITION this item is keyed on, "" for an ordinary event-keyed item. Named here for
        # the same reason `run`/`session` are: this fold is a WHITELIST, so an un-named field is
        # dropped on the way to `list --json` — and a consumer that cannot see the key an item was
        # deduped on cannot tell a recurring state from a one-off event.
        condition: ($r.condition // $p.condition // ""),
        by:       ($r.by       // $p.by       // ""),
        evidence: ($r.evidence // $p.evidence // ""),
        needs:    ($r.needs    // $p.needs    // ""),
        # `run` + `session` ride the `block` record from the `needs` verb. This fold
        # WHITELISTS fields, so anything not named here is dropped silently on the way to
        # `list --blocked --json` — that silent drop is the whole reason they are spelled
        # out. Carried as ""-default like every sibling; cmd_list re-omits an empty one so a
        # consumer can still tell "no command" from "an empty command".
        run:      ($r.run      // $p.run      // ""),
        session:  ($r.session  // $p.session  // ""),
        # VENUE — where the CURRENT holder runs, which decides which liveness oracles can see it
        # (see VENUE in the header). Note the shape: unlike every sibling above, a `claim` RESETS
        # it rather than carrying forward. `$r.venue // $p.venue` would be wrong in a way that
        # only ever fails CLOSED-then-STUCK: a cloud claim, a reopen, then a plain local re-claim
        # writes no venue field, so the carry-forward would keep "cloud" while `by` correctly
        # became the local worker — and that worker would then be permanently unobservable to
        # oracles that can see it perfectly well. Reset-on-claim keys the venue to the same record
        # that names the holder, which is exactly what the reap fold does.
        #
        # (No apostrophes in this block: the whole fold is a single-quoted shell string, so one
        # would close it and the next brace reads as bash. That failed loudly here — `bash -n`
        # pointed at this very line — but a quote landing inside a jq STRING would not.)
        venue: (if $r.event == "claim" then ($r.venue // "local") else ($p.venue // "local") end),
        # ROLE — WHAT the current holder is, which decides whether a `reclaim` may re-key past a
        # LIVE claimer (see DISPATCHER HAND-OVER in the header). "dispatcher" means the holder is a
        # cc-dispatch pass holding a placeholder lease for a worker it has not spawned yet; ""
        # (the default, and every pre-existing record) means an ordinary worker claim.
        #
        # RESET ON CLAIM, exactly like venue above and for a STRONGER reason. `reclaim` writes no
        # role field, so reset-on-claim CLEARS it the instant a worker re-keys — which is what makes
        # the hand-over exemption ONE-SHOT and self-extinguishing: the first worker takes the claim,
        # the item becomes worker-held, and a second worker racing it meets an ordinary live-claimer
        # refusal. A future reader will be tempted to "fix" this into `$r.role // $p.role` to match
        # the carry-forward siblings above. DO NOT: that makes an item dispatcher-roled FOREVER, so
        # every later worker could re-key past a live incumbent, and the exemption stops being a
        # hand-over and becomes a standing hole in the lease.
        role: (if $r.event == "claim" then ($r.role // "") else ($p.role // "") end),
        status: (
          if   $r.event == "done"    then "done"
          elif $r.event == "block"   then "blocked"
          elif $r.event == "unblock" then "open"
          elif $r.event == "claim"   then "claimed"
          elif $r.event == "reopen"  then "open"
          else ($p.status // "open") end),
        # wasDone — the DONE LATCH (not the same thing as status=="done"). It sticks once the
        # item has EVER been completed and is cleared ONLY by a deliberate `reopen --force`, so
        # a re-opened-by-hand item still reads "this was already finished once". cc-dispatch
        # fires on `status=="open" and wasDone != true`, which is what keeps landed work out of
        # the wave after any reopen path (guarded, forced, or a hand-appended JSONL line).
        wasDone: (
          if   $r.event == "done"                            then true
          elif ($r.event == "reopen" and ($r.force // false)) then false
          else ($p.wasDone // false) end),
        lastTs:   ($r.ts // $p.lastTs // "")
      })
    ) | [ .[] ]'
}

# item_json <id> → the folded object for <id> (compact JSON), or "" when the id is unknown.
# stderr is dropped: callers here are GUARDS, and a malformed-line report belongs to the verb
# the user actually ran (list/reap), not to a status peek inside a transition.
item_json() { fold 2>/dev/null | jq -c --arg i "$1" 'map(select(.id == $i)) | first // empty' 2>/dev/null; }

has_id() {
  [ -f "$BACKLOG" ] || return 1
  valid_records 2>/dev/null | jq -e -s --arg id "$1" 'any(.[]; .id == $id)' >/dev/null 2>&1
}

# project_default → the ledger's short project NAME for $PWD; rc 2 when none is derivable.
#
# The old default was a bare `$(pwd)`, which minted labels that are not projects and can therefore
# never be dispatched (item f7abcbdee98c — cc-dispatch filters on the project NAME):
#   · a caller under launchd has cwd=/ → project "/"          (5 live items, undrained 8 days)
#   · a caller inside a dispatch worktree → "wt-closeout", "/tmp/wt-autonomy-100"
# Both classes are in the live ledger. Two normalizations and one refusal:
#   (a) the git TOPLEVEL's basename, not $PWD's — a subdirectory is not a project;
#   (b) inside a WORKTREE the toplevel basename is the worktree's own name (wt-<id>), so resolve
#       through the shared git dir to the MAIN checkout — a worker files under the real project;
#   (c) a degenerate result ("/", ".", "..", empty) REFUSES instead of storing it. An id is keyed on
#       the project, so a phantom label is not a mislabel that someone later notices — it is an item
#       that no dispatcher can ever see. Failing the `add` loudly is strictly better than a silent
#       write to a project that does not exist.
project_default() {
  local top common d
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ]; then
    common="$(git -C "$top" rev-parse --git-common-dir 2>/dev/null || true)"
    case "$common" in
      ""|.git|"$top/.git") d="$top" ;;
      /*)                  d="$(dirname "$common")" ;;
      *)                   d="$(dirname "$top/$common")" ;;
    esac
  else
    d="$(pwd)"
  fi
  d="$(basename "$d" 2>/dev/null || true)"
  case "$d" in ""|"/"|"."|"..") return 2 ;; esac
  printf '%s' "$d"
}

cmd_add() {
  local project="" title="" dod="" source="" condition=""
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --project)   project="${1:-}";   [ $# -gt 0 ] && shift ;;
      --title)     title="${1:-}";     [ $# -gt 0 ] && shift ;;
      --dod-ref)   dod="${1:-}";       [ $# -gt 0 ] && shift ;;
      --source)    source="${1:-}";    [ $# -gt 0 ] && shift ;;
      --condition) condition="${1:-}"; [ $# -gt 0 ] && shift ;;
      *) printf 'cc-backlog add: unknown arg %s\n' "$key" >&2; return 2 ;;
    esac
  done
  [ -n "$title" ] || { echo "cc-backlog add: --title is required" >&2; return 2; }
  # A malformed condition REFUSES the whole add rather than degrading to a title key. Falling back
  # would hand the caller the very per-event id it asked not to have, silently — and a caller that
  # passed --condition is one whose retry loop mints a fresh item every pass.
  if [ -n "$condition" ] && ! valid_condition "$condition"; then
    { printf 'cc-backlog add: --condition "%s" is not a stable key.\n' "$condition"
      printf '  A condition names a recurring STATE, so it must hold still: lowercase letters and\n'
      printf '  hyphens only (<=64, no leading/trailing/doubled hyphen), and NO DIGITS — a size, a\n'
      printf '  count, a percentage, a timestamp and a sha are all numbers, and any of them in the\n'
      printf '  key re-mints one item per measurement. That is the bug --condition exists to fix.\n'
      printf '  Put the measurement in --title (it is displayed, it just stops being identity);\n'
      printf '  spell out a numeral a condition genuinely needs (opus-five-routing-drift).\n'
    } >&2
    return 2
  fi
  if [ -z "$project" ]; then
    project="$(project_default)" \
      || { echo "cc-backlog add: cannot resolve a project from $(pwd) — pass --project <name>" >&2; return 2; }
  fi
  ensure_file
  local id
  if [ -n "$condition" ]; then id=$(mk_cond_id "$project" "$condition")
  else                         id=$(mk_id "$project" "$title" "$source"); fi
  if has_id "$id"; then                            # idempotent: no duplicate add
    # DONE-GUARD (add side): the event key (project+title+source) resolves to an item that is
    # already TERMINAL — this `add` is a re-file of completed work. The id is still echoed with
    # rc 0 (the idempotency contract `cc-discover` and every other caller depends on) and the
    # item is deliberately NOT re-opened, but the collision is announced LOUD so a stale re-file
    # can never read as fresh work.
    local ex; ex="$(item_json "$id")"
    if [ "$(printf '%s' "$ex" | jq -r '.status // ""' 2>/dev/null)" = "done" ]; then
      { printf 'cc-backlog add: WARNING — this event-key is already DONE; NOT re-opened.\n'
        printf '  id %s · done %s\n' "$id" "$(printf '%s' "$ex" | jq -r '.lastTs // "?"')"
        printf '  evidence: %s\n' "$(printf '%s' "$ex" | jq -r 'if (.evidence // "") == "" then "<none>" else .evidence end')"
        # A condition key reaching a done item means the STATE came back, which is a different fact
        # from a stale re-file of an event — and telling the caller to "use a distinct title" there
        # would be advice to re-create the 21-item defect. Both paths still refuse to auto-reopen:
        # a state that re-enters minutes after its own close (004502cf59ab → 0fc2ae0d0140, six
        # minutes) is thrash, and only a deliberate --force should put a worker back on it.
        if [ -n "$condition" ]; then
          printf '  This is a CONDITION key (%s), so the state RECURRED rather than being re-filed.\n' "$condition"
          printf '  Do NOT vary the condition to get a new id — that is the defect it prevents.\n'
          printf '  If it genuinely holds again:  cc-backlog reopen %s --force\n' "$id"
        else
          printf '  Genuinely new work needs a distinct title/source (the id is a hash of\n'
          printf '  project+title+source). If THIS work regressed:  cc-backlog reopen %s --force\n' "$id"
        fi
      } >&2
    fi
    echo "$id"; return 0
  fi
  jq -nc --arg id "$id" --arg ts "$(now_iso)" --arg project "$project" \
     --arg title "$title" --arg dod "$dod" --arg source "$source" --arg condition "$condition" \
     '{id:$id, ts:$ts, event:"add", project:$project, title:$title, dodRef:$dod, source:$source}
      + (if $condition == "" then {} else {condition:$condition} end)' \
     >> "$BACKLOG"
  echo "$id"
}

cmd_transition() {
  local event="$1"; shift
  local id="${1:-}"; [ $# -gt 0 ] && shift
  local by="" evidence="" needs="" run="" session="" venue="" force=0 selfrel="" role=""
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --by)       by="${1:-}";       [ $# -gt 0 ] && shift ;;
      --evidence) evidence="${1:-}"; [ $# -gt 0 ] && shift ;;
      --needs)    needs="${1:-}";    [ $# -gt 0 ] && shift ;;
      # --self-release names a reopen the CLAIMER issued because it could not START the work (see
      # SELF-RELEASE in the header). Reopen-only, closed-set, and only the claimer may assert it.
      --self-release) selfrel="${1:-}"; [ $# -gt 0 ] && shift ;;
      # --venue names WHERE the worker runs, which decides WHICH ORACLES CAN SEE IT (see VENUE in
      # the header). Claim-only: on any other event it is an error, never silently ignored.
      --venue)    venue="${1:-}";    [ $# -gt 0 ] && shift ;;
      # --role names WHAT the claimer is, which decides whether a `reclaim` may re-key past it while
      # it is still LIVE (see DISPATCHER HAND-OVER in the header). Claim-only, same as --venue.
      --role)     role="${1:-}";     [ $# -gt 0 ] && shift ;;
      # `run` + `session` ride a `block` record (see the `needs` verb in the header). Accepted
      # here rather than in a third writer so the ONE transition writer stays the ONE writer.
      --run)      run="${1:-}";      [ $# -gt 0 ] && shift ;;
      --session)  session="${1:-}";  [ $# -gt 0 ] && shift ;;
      --force)    force=1 ;;
      *) printf 'cc-backlog %s: unknown arg %s\n' "$event" "$key" >&2; return 2 ;;
    esac
  done
  [ -n "$id" ] || { printf 'cc-backlog %s: <id> is required\n' "$event" >&2; return 2; }
  # `block` MUST carry the pending operator step — that IS the desk-surfaced payload.
  if [ "$event" = block ] && [ -z "$needs" ]; then
    printf 'cc-backlog block: --needs "<operator-only step>" is required\n' >&2; return 2
  fi
  # --force overrides the reopen guards, the claim LEASE and the claim DONE-GUARD, and nothing else
  # — on any other event it is an ERROR, never silently ignored (a flag that no-ops reads as though
  # it worked).
  if [ "$force" -eq 1 ] && [ "$event" != reopen ] && [ "$event" != claim ]; then
    printf 'cc-backlog %s: --force applies only to reopen and claim\n' "$event" >&2; return 2
  fi
  # --venue is claim-only and CLOSED-SET. Both halves matter. Claim-only, because the venue is a
  # property of the worker that took the item, and the only record naming a worker is the claim.
  # Closed-set, because this string SELECTS WHICH ORACLES MAY CONVICT: a typo'd `--venue clod`
  # accepted as free text would fall through every venue test back onto the local oracles and
  # re-arm the exact false-dead this exists to stop — a mislabel that reads as a verdict (memory:
  # default-path-hardening-is-blind-to-the-explicit-argument). Unknown venue is rc 2, never a
  # silent local default.
  if [ -n "$venue" ]; then
    if [ "$event" != claim ]; then
      printf 'cc-backlog %s: --venue applies only to claim\n' "$event" >&2; return 2
    fi
    case "$venue" in
      local|cloud) ;;
      *) printf 'cc-backlog claim: unknown --venue %s (expected: local, cloud)\n' "$venue" >&2; return 2 ;;
    esac
  fi
  # --role is claim-only and CLOSED-SET, for exactly the reasons --venue is, with the failure
  # direction inverted and therefore worse: this string decides whether `reclaim` may re-key past a
  # LIVE claimer. A typo'd `--role dispatchr` accepted as free text folds to a role no reclaim ever
  # matches, so the hand-over silently never fires and cc-dispatch is back to deadlocking its own
  # workers — a mislabel that reads as though it worked (memory:
  # default-path-hardening-is-blind-to-the-explicit-argument). Unknown role is rc 2.
  #
  # `worker` is accepted and is a NO-OP by construction: it folds to the same "" that every
  # pre-existing record and every plain claim folds to, so there is exactly ONE representation of
  # "ordinary worker claim" and no second spelling for a reader to have to know about.
  if [ -n "$role" ]; then
    if [ "$event" != claim ]; then
      printf 'cc-backlog %s: --role applies only to claim\n' "$event" >&2; return 2
    fi
    case "$role" in
      dispatcher) ;;
      worker) role="" ;;
      *) printf 'cc-backlog claim: unknown --role %s (expected: dispatcher, worker)\n' "$role" >&2; return 2 ;;
    esac
  fi
  # --self-release is REOPEN-ONLY and CLOSED-SET, for the same two reasons --venue is, sharpened by
  # what this flag does: it SUPPRESSES a guard (reap's rule B), so a typo accepted as free text would
  # be a silent un-suppression that reads as though it worked. Unknown token is rc 2, never a silent
  # pass-through (memory: default-path-hardening-is-blind-to-the-explicit-argument).
  if [ -n "$selfrel" ]; then
    if [ "$event" != reopen ]; then
      printf 'cc-backlog %s: --self-release applies only to reopen\n' "$event" >&2; return 2
    fi
    case "$selfrel" in
      spawn-fail|compose-fail|worktree-fail) ;;
      *) printf 'cc-backlog reopen: unknown --self-release %s (expected: spawn-fail, compose-fail, worktree-fail)\n' \
           "$selfrel" >&2; return 2 ;;
    esac
    # REQUIRES --by, because the whole claim of the flag is "the CLAIMER released its own claim".
    # An anonymous self-release is unattributable, and an unattributable suppression of a guard is
    # exactly the assertion a third party could make about somebody else's work.
    if [ -z "$by" ]; then
      printf 'cc-backlog reopen: --self-release requires --by <the claimer that is releasing>\n' >&2; return 2
    fi
  fi
  ensure_file
  has_id "$id" || { printf 'cc-backlog %s: unknown id %s\n' "$event" "$id" >&2; return 3; }
  # The claimer check runs OUTSIDE the reopen-guard block below, and therefore also under --force:
  # --force exists to override the reopen guards, and this is not one of them. It is the flag's own
  # authenticity condition — without it any caller could stamp `selfRelease` onto a reopen of work a
  # real worker was doing, and reap would then decline to count the one trail shape it exists to see.
  if [ -n "$selfrel" ]; then
    local sr_cur sr_status sr_by
    sr_cur="$(item_json "$id")"
    sr_status="$(printf '%s' "$sr_cur" | jq -r '.status // ""' 2>/dev/null)"
    sr_by="$(    printf '%s' "$sr_cur" | jq -r '.by     // ""' 2>/dev/null)"
    if [ "$sr_status" != claimed ] || [ "$sr_by" != "$by" ]; then
      { printf 'cc-backlog reopen: REFUSED — --self-release %s claims to release %s'"'"'s own claim on %s,\n' \
          "$selfrel" "$by" "$id"
        printf '  but the ledger folds status=%s claimer=%s. Only the live claimer may self-release:\n' \
          "${sr_status:-<none>}" "${sr_by:-<none>}"
        printf '  a self-release SUPPRESSES reap'"'"'s thrash counter, so asserting one over another\n'
        printf '  worker'"'"'s claim would hide the exact trail shape that counter exists to see.\n'
        printf '  Reopen it without the flag:  cc-backlog reopen %s --by %s\n' "$id" "$by"
      } >&2
      return 4
    fi
  fi
  # REOPEN GUARDS (see the header block) — refuse a resurrection of terminal work and a yank of a
  # live claim. Both are rc 4 and both name the exact `--force` escape in the refusal.
  if [ "$event" = reopen ] && [ "$force" -eq 0 ]; then
    local cur cstatus cby cev cts
    cur="$(item_json "$id")"
    cstatus="$(printf '%s' "$cur" | jq -r '.status   // ""' 2>/dev/null)"
    cby="$(    printf '%s' "$cur" | jq -r '.by       // ""' 2>/dev/null)"
    if [ "$cstatus" = "done" ]; then
      cev="$(printf '%s' "$cur" | jq -r 'if (.evidence // "") == "" then "<none>" else .evidence end' 2>/dev/null)"
      cts="$(printf '%s' "$cur" | jq -r '.lastTs // "?"' 2>/dev/null)"
      { printf 'cc-backlog reopen: REFUSED — %s is TERMINAL (done %s)\n' "$id" "$cts"
        printf '  evidence: %s\n' "$cev"
        printf '  Re-opening completed work puts it back in the dispatch wave and burns a worker\n'
        printf '  session re-doing what already landed (incident 2026-07-20, a60d62a215f1).\n'
        printf '  If the work genuinely regressed, or the completion was premature, say so explicitly:\n'
        printf '      cc-backlog reopen %s --force\n' "$id"
      } >&2
      return 4
    fi
    local cvenue; cvenue="$(printf '%s' "$cur" | jq -r '.venue // "local"' 2>/dev/null)"
    if [ "$cstatus" = claimed ] && [ -n "$cby" ] && [ "$cby" != "$by" ] && claimer_live "$cby" "${cvenue:-local}"; then
      { printf 'cc-backlog reopen: REFUSED — %s is claimed by %s, which is still LIVE\n' "$id" "$cby"
        printf '  A live claim returned to "open" is re-dispatchable: the next cc-dispatch tick\n'
        printf '  claims it and spawns a SECOND worker onto work already in progress. That is the\n'
        printf '  2026-07-20 incident exactly (reopened 33 min into a live claim, re-claimed 15 s later).\n'
        printf '  The claimer releases its own claim with:  cc-backlog reopen %s --by %s\n' "$id" "$cby"
        printf '  A DEAD claimer needs no force — cc-backlog reap reopens it once it goes stale.\n'
        printf '  To override deliberately:  cc-backlog reopen %s --force\n' "$id"
      } >&2
      return 4
    fi
  fi
  # CLAIM GUARDS — the DONE LATCH (3) then the LEASE (4). Both are `claim`-side, both rc 4, and they
  # share ONE `item_json` fold deliberately: the fold is a `valid_records | jq -s` pass over the whole
  # ledger, so two blocks each taking their own would double the cost of every claim for nothing.
  #
  # THE DONE LATCH GOES FIRST because the two predicates are disjoint on the common paths (a
  # done-latched item folds `done` or `open`, never `claimed`) but OVERLAP on one: an item that was
  # force-claimed after landing folds `claimed` AND `wasDone`. There "this already landed" is the
  # more fundamental fact and the more useful refusal — the lease would send the reader chasing an
  # incumbent worker for work that is finished.
  if [ "$event" = claim ] && [ "$force" -eq 0 ]; then
    local lcur lstatus lby lrc ldone lev lts lowned lowrc lall
    # ONE fold for all three guards, for the reason stated above — guard (6) needs the SIBLING rows
    # as well as this one, and `item_json` would re-walk the whole ledger to find them. Folding once
    # and selecting twice keeps the claim at exactly the cost it had before the sibling lease existed.
    lall="$(fold 2>/dev/null)"
    lcur="$(printf '%s' "$lall" | jq -c --arg i "$id" 'map(select(.id == $i)) | first // empty' 2>/dev/null)"
    lstatus="$(printf '%s' "$lcur" | jq -r '.status  // ""'    2>/dev/null)"
    lby="$(    printf '%s' "$lcur" | jq -r '.by      // ""'    2>/dev/null)"
    ldone="$(  printf '%s' "$lcur" | jq -r '.wasDone // false' 2>/dev/null)"
    # (3) DONE LATCH (see CLAIM DONE-GUARD in the header) — the ACTUATOR arbitrates the latch, so no
    # caller can race it with a stale snapshot. Read here, one step before the append, rather than by
    # any puller: cc-dispatch's step-1b filter samples ~7-45 s + an admission tail before this point.
    #
    # Keyed on `wasDone`, not on `status == "done"`, and that is strictly stronger: the latch is set
    # by every `done` and cleared ONLY by `reopen --force`, which also sets status back to "open" —
    # so `status == done` implies `wasDone == true`, while the converse catches the hand-reopened
    # item that folds to "open" and is exactly cc-dispatch's fire predicate.
    #
    # An unreadable fold cannot fail-open here: `has_id` above already ran the same `valid_records`
    # read and returned rc 3 if the ledger or jq were broken, so reaching this line means the ledger
    # IS readable — an empty `item_json` for an id `has_id` just confirmed is not a state the fold
    # can produce (both reduce over the same records).
    #
    # `verdict=done-latched` rides LINE 1 because rc 4 now has two causes and its consumer must tell
    # them apart: cc-dispatch treats a raced landing as a SKIP and healthy lease contention as a
    # FAILURE, and it can only see this refusal through `claim_excerpt` (head -1, 200 chars). A
    # parseable token, never prose-matching — the same shape `reclaim` already emits. The
    # discriminator is POSITIVE on the skip-worthy cause on purpose: if the token ever went missing,
    # a done-latch refusal would read as the lease's FAILED path — the incumbent behaviour, not a
    # new hole.
    if [ "$ldone" = true ]; then
      lev="$(printf '%s' "$lcur" | jq -r 'if (.evidence // "") == "" then "<none>" else .evidence end' 2>/dev/null)"
      lts="$(printf '%s' "$lcur" | jq -r '.lastTs // "?"' 2>/dev/null)"
      { printf 'cc-backlog claim: REFUSED verdict=done-latched — %s is DONE (last transition %s)\n' "$id" "$lts"
        printf '  evidence: %s\n' "$lev"
        printf '  Claiming completed work spawns a worker onto what already landed. A pull-time\n'
        printf '  filter cannot prevent this: the landing can happen AFTER the snapshot and BEFORE\n'
        printf '  the claim (measured 2026-08-05, item 5690b9d11bee — done 20:20:52Z, claimed\n'
        printf '  20:26:15Z, one burned worker session).\n'
        printf '  If the work genuinely regressed, re-open it deliberately — that clears the latch:\n'
        printf '      cc-backlog reopen %s --force\n' "$id"
        printf '  To take the claim WITHOUT clearing the latch:  cc-backlog claim %s --force\n' "$id"
      } >&2
      return 4
    fi
    # (4) LEASE (see THE CLAIM IS A LEASE in the header) — the acquire-side mirror of guard (2).
    # Same oracle, same rc 4, same self/dead exemptions; the PREDICATE IS INVERTED on purpose.
    # `[ "$lby" != "$by" ]` keeps a re-claim by the SAME holder idempotent — a dispatcher retrying
    # its own claim is not contention, and cc-dispatch's rollback path depends on being able to
    # re-take what it released. An EMPTY `by` cannot be the incumbent (nothing to be live).
    if [ "$lstatus" = claimed ] && [ -n "$lby" ] && [ "$lby" != "$by" ]; then
      # The INCUMBENT's venue, not the caller's — this asks "can I see the holder?", and the caller
      # claiming `--venue local` says nothing about where the holder runs. Without it a cloud
      # incumbent reads rc 1 (proven dead) and this lease GRANTS: the same false-dead as the reap
      # path, on the acquire side, where the consequence is immediate rather than deferred.
      local lvenue; lvenue="$(printf '%s' "$lcur" | jq -r '.venue // "local"' 2>/dev/null)"
      claimer_live "$lby" "${lvenue:-local}"; lrc=$?
      # ONLY rc 1 (PROVEN not-live) may be displaced. Do NOT rewrite this as the reopen guard's
      # `&& claimer_live` (rc 0 only) — that inverts it into fail-open and restores the defect.
      if [ "$lrc" -ne 1 ]; then
        { if [ "$lrc" -eq 0 ]; then
            printf 'cc-backlog claim: REFUSED — %s is already claimed by %s, which is LIVE\n' "$id" "$lby"
          else
            printf 'cc-backlog claim: REFUSED — %s is already claimed by %s, whose liveness is UNRESOLVED\n' "$id" "$lby"
            printf '  An unanswered probe is not proof the holder is gone, and this verb HANDS OUT the\n'
            printf '  work: abstaining means leaving the incumbent alone, never minting a second worker.\n'
          fi
          printf '  Claiming it anyway overwrites the incumbent in the fold: "list" would name the new\n'
          printf '  claimer while the first worker is still running, which is how one item was worked\n'
          printf '  twice to completion for ~10 h (b0b4ec40d63a, 2026-08-05).\n'
          printf '  A DEAD claimer needs no force — cc-backlog reap reopens it once it goes stale.\n'
          printf '  The holder releases its own claim with:  cc-backlog reopen %s --by %s\n' "$id" "$lby"
          printf '  To override deliberately:  cc-backlog claim %s --by %s --force\n' "$id" "${by:-<sid>}"
        } >&2
        return 4
      fi
      # (5) SECOND ORACLE — the item's WORKTREE, asked exactly as `reap` asks it. Oracle 1 has just
      # returned a REAL not-live verdict, but for a `<host>-<pid>` claim that verdict is about a
      # SHELL, and shells rotate while the work does not. MEASURED 2026-08-06 on item e1ce92772859:
      # claimed 08:03:52Z by `Chriss-MacBook-Pro-3-33510`; by 09:01:47Z that pid was gone while the
      # worker was running `cc-bats` on the item's own suite inside .worktrees/wt-e1ce92772859.
      # `kill -0` said dead, this lease GRANTED (rc 0), a second session duplicated ~20 min of work,
      # and the incumbent landed the better fix (66871b9b) six minutes later — the duplicate commit
      # was thrown away. `reclaim` existing as the manual repair was the standing admission that
      # nothing re-keys automatically, i.e. that a duplicate is the DEFAULT outcome of a rotated pid.
      #
      # THE TWO VERBS DISAGREED ABOUT WHAT "LIVE" MEANS, and the weaker one was the dangerous one.
      # `reap` has required BOTH oracles to convict since 2026-07-26 — it re-verifies a dead claimer
      # against the worktree before any dead-worker path, precisely because a dispatched claim's `by`
      # cannot see the worker (see owned_wait). This verb asked oracle 1 alone, so the ACQUIRE path —
      # the only one that can MINT a duplicate — convicted on strictly weaker evidence than the
      # release path. One oracle now governs both, and it is `owned_wait` CALLED, never restated
      # (memory: sibling-auditors-must-share-the-state-model, make-the-actuator-the-arbiter).
      #
      # Keying liveness on the WORKTREE rather than re-keying every writer's stored `by` is the fix
      # that fits: the worktree is the durable handle that outlives the shell (memory:
      # argv-is-sampling-cwd-is-durable) and `reap` already trusts it, whereas a stored-identity
      # schema change would touch every claim writer for no extra safety. Within owned_wait it is S1b
      # (cwd occupancy) that carries this, not S1: measured the same day against a live dispatch
      # worktree, `pgrep -f <wt>` read 0 processes while cwd occupancy read 13 — the launcher's argv
      # is spent and only the cwd survives, exactly as owned_wait's own header predicts.
      #
      # rc 1 ONLY may proceed, mirroring oracle 1 above and for the same asymmetry: rc 0 is positive
      # evidence of life and rc 2 means a probe that COULD have seen the worker never ran. Abstaining
      # leaves the incumbent alone; convicting on a non-verdict hands live work to a second worker.
      # No ceiling here on purpose — a wedged-but-occupied worktree is `reap`'s to escalate at
      # OWNED_WAIT_MAX_S, and a second ceiling on the acquire path would be one policy in two places,
      # free to drift apart exactly as these two liveness predicates already did.
      #
      # COST is gated by position, not by a flag: reached only for an item already `claimed`, by
      # somebody else, whose claimer probe returned PROVEN-DEAD — i.e. only when we are about to take
      # work off a holder. An ordinary open-item claim never reaches it, and `owned_wait`
      # short-circuits on an absent wt-<id> before it forks lsof at all. No `verdict=` token is
      # emitted: rc 4's only machine consumer discriminates POSITIVELY on `verdict=done-latched`
      # (cc-dispatch:968) and correctly reads every other rc 4 as the lease — which this is, reached
      # by a second oracle (memory: new-enum-member-falls-into-fail-closed-default).
      lowned="$(owned_wait "$id" "${lvenue:-local}")"; lowrc=$?
      if [ "$lowrc" -ne 1 ]; then
        { if [ "$lowrc" -eq 0 ]; then
            printf 'cc-backlog claim: REFUSED — %s is claimed by %s, whose process is gone but whose WORKTREE IS LIVE\n' "$id" "$lby"
            printf '  evidence: %s\n' "$lowned"
          else
            printf 'cc-backlog claim: REFUSED — %s is claimed by %s, and its worktree occupancy is UNRESOLVED\n' "$id" "$lby"
            printf '  %s\n' "$lowned"
            printf '  The claimer probe answered "not live", but that answers for a SHELL; the only oracle that\n'
            printf '  can see the WORKER never ran. No oracle has spoken about the worker, and this verb HANDS\n'
            printf '  OUT the work — abstaining leaves the incumbent alone, never mints a second one.\n'
          fi
          printf '  A <host>-<pid> claim names a shell, and shells rotate while the work does not: on\n'
          printf '  e1ce92772859 (2026-08-06) the pid was dead, the worker was mid-suite in its own worktree,\n'
          printf '  and the granted claim cost ~20 min of duplicated work. reap re-verifies a dead claimer\n'
          printf '  against the worktree before it will reopen; claim asks that same oracle, so the two\n'
          printf '  verbs cannot disagree about what "live" means.\n'
          printf '  If YOU are that worker and only need the claim re-keyed to your own identity:\n'
          printf '      cc-backlog reclaim %s --by %s\n' "$id" "${by:-<worker-identity>}"
          printf '  To override deliberately:  cc-backlog claim %s --by %s --force\n' "$id" "${by:-<sid>}"
        } >&2
        return 4
      fi
    fi
    # (5) PREMISE CHECK (CONCURRENCY_PROGRAM.md §S3) — the third `claim`-side refusal, and the only
    # one that asks about the WORLD rather than about the ledger's own bookkeeping. (3) asks "is this
    # finished?", (4) asks "is someone already on it?"; this asks "is the reason it was filed STILL
    # TRUE?" A work item's premise is a CLAIM: written out of context, in imperative voice that reads
    # as settled, about facts that decay. 359 items sit non-done here, 89 filed in one five-day jam
    # window, and releasing them into an unattended dispatcher is what §S3 exists to make safe.
    #
    # AT THE ACTUATOR, for the reason the DONE LATCH is: cc-dispatch already ships a premise gate,
    # but it is dispatcher-side and scoped to `source=="plan-open"` — 14 of 359 non-done items, 4%.
    # Every other claimer (the desk, a peer session, a worker claiming by hand) bypasses it entirely.
    # Folding the predicate into the transition that actually takes the claim is what makes it total.
    #
    # IT ALMOST NEVER REFUSES, and that is deliberate rather than timid. cc-premise separates an item
    # whose WHOLE reason for existing is gone (`superseded`, `self-duplicate` → exit 3 → refuse here)
    # from one where a SUB-CLAIM was corrected but real work remains (`corrected` → exit 0 → the
    # contract rides the worker's brief instead). The distinction is not academic: §S3's own flagship
    # example, 23eccae755a9, has one refuted sub-claim and a live ~20x auth-error regression beside
    # it — refusing that claim would strand the work the item exists to do. Measured over the store
    # at 359 non-done: 12 refuse (4 superseded · 8 self-duplicate), 78 carry an advisory (2
    # corrected · 76 suspect).
    #
    # ⚠️ That advisory figure read 164 until the sensor behind it was fixed, and the gap is the more
    # useful fact. cc-premise's git arms resolved a cited path with a helper that returns the same
    # value for "git answered: absent" and "git could not be asked" — and since NEITHER caller sets
    # CC_PREMISE_REPO, the could-not-ask branch was the shipping path. It convicted every cited path
    # containing a slash: 80 fabricated findings, each a false sentence about a file that never
    # moved, riding a real worker's brief. The suite could not see it because it unset the same
    # variable. Fixed by a positive control (`_git_usable`) plus a default repo, both in cc-premise.
    #
    # FAIL-OPEN, like cc-dispatch's plan-open gate and for the same reason: this premise lives
    # OUTSIDE the ledger fold (in other items' prose, in git), so every way of failing to read it —
    # absent helper, unreadable ledger, timeout, a jq/python that is not there — must let the claim
    # through. ONLY exit 3 blocks; every other exit code, including a crash, proceeds. Starving the
    # queue on a sensor failure is the worse error (I6).
    if [ "${CC_BACKLOG_PREMISE_GATE:-on}" != off ]; then
      local pself pbin prc pout
      pself="$0"; [ -L "$pself" ] && pself="$(readlink "$pself")"
      pbin="${CC_BACKLOG_PREMISE_BIN:-$(cd "$(dirname "$pself")" 2>/dev/null && pwd)/cc-premise}"
      if [ -x "$pbin" ]; then
        pout="$("$pbin" check "$id" 2>&1)"; prc=$?
        if [ "$prc" -eq 3 ]; then
          # `verdict=premise-refuted` rides LINE 1: rc 4 now has FOUR causes and cc-dispatch can
          # only see this through `claim_excerpt` (head -1, 200 chars). It discriminates POSITIVELY
          # on each skip-worthy token, so a missing token degrades to the lease's FAILED path — the
          # incumbent behaviour, never a new hole (memory: new-enum-member-falls-into-fail-closed).
          { printf 'cc-backlog claim: REFUSED verdict=premise-refuted — %s\n' "$id"
            printf '%s\n' "$pout" | sed 's/^/  /'
            printf '  This item was not refused for being in progress or finished — its PREMISE no\n'
            printf '  longer holds. THE DISPROOF IS THE DELIVERABLE: file it (cc-backlog add, naming\n'
            printf '  this id) and close this item citing that, rather than silently closing it.\n'
            printf '  If the premise does still hold:  cc-backlog claim %s --force\n' "$id"
          } >&2
          return 4
        fi
      fi
    fi
    # (5b) OFF-BOX ELIGIBILITY — fires ONLY on `--venue cloud`, so a local claim is byte-for-byte
    # what it was. The question it asks is prior to every other guard here: not "is this finished",
    # "is someone on it" or "is its premise standing", but CAN THE WORK BE DONE WHERE THE WORKER IS.
    #
    # It exists because the answer was PROSE. CONCURRENCY_PROGRAM.md §S5 settles it in one sentence
    # — "repo-only work ✅ · visual design ❌ (needs the local browser + dev server) · anything about
    # this box ❌ · branch banking ⚠️" — measured in docs/research/concurrency-census-2026-08-07.md
    # §5, correct, and enforced NOWHERE. A conclusion that reaches only a plan file sits behind a
    # diode: nothing re-reads it at the moment a claim is taken, so it changes no behaviour at all
    # (memory: conclusion-must-reach-the-enforcing-store). This block is that sentence's exit code.
    #
    # AT THE ACTUATOR, for guard (5)'s reason verbatim: the dispatcher is not the only claimer. A
    # desk, a peer session, a worker claiming by hand all reach this transition, and only this
    # transition. Folding the predicate in here is what makes it total rather than dispatcher-scoped.
    #
    # WHY A WRONG *ELIGIBLE* IS THE EXPENSIVE DIRECTION, which is why the classifier is allowed to
    # be conservative about what it READ while still failing open on what it could not read. A
    # worker in an Anthropic-managed VM has no ~/.claude, no pane registry, no keychain, no browser,
    # no dev server, and none of this box's 199 unpushed branches — but it has a plausible-looking
    # EMPTY version of most of them, so it does not error, it improvises. A wrong refusal, by
    # contrast, leaves the item exactly where it is today: open, and claimable locally by the very
    # next pass. Stranding is recoverable; a confident worker against invisible state is not.
    #
    # FAIL-OPEN, like the premise gate above and for the same reason: this predicate lives OUTSIDE
    # the ledger fold, so every way of failing to read it — absent helper, unreadable store, a
    # python3 that is not there, a crash — must let the claim through. ONLY exit 3 blocks.
    if [ "$venue" = cloud ] && [ "${CC_BACKLOG_ELIGIBLE_GATE:-on}" != off ]; then
      local eself ebin erc eout
      eself="$0"; [ -L "$eself" ] && eself="$(readlink "$eself")"
      ebin="${CC_BACKLOG_ELIGIBLE_BIN:-$(cd "$(dirname "$eself")" 2>/dev/null && pwd)/cc-eligible}"
      if [ -x "$ebin" ]; then
        eout="$("$ebin" check "$id" 2>&1)"; erc=$?
        if [ "$erc" -eq 3 ]; then
          # `verdict=cloud-ineligible` rides LINE 1 — rc 4 now has FIVE causes and cc-dispatch can
          # only see this through `claim_excerpt` (head -1, 200 chars). ONE token at this level, not
          # one per class: the classes ride the body, where a human reads them, while the machine
          # gets a single string it can discriminate on positively (memory:
          # new-enum-member-falls-into-fail-closed-default).
          { printf 'cc-backlog claim: REFUSED verdict=cloud-ineligible — %s\n' "$id"
            printf '%s\n' "$eout" | sed 's/^/  /'
            printf '  This item was not refused for being finished, held, or premise-dead — it is\n'
            printf '  work a CLOUD VM cannot do: the state it operates on exists only on this box.\n'
            printf '  Claim it LOCALLY and it proceeds untouched:  cc-backlog claim %s --by %s\n' "$id" "${by:-<sid>}"
            printf '  If the classification is wrong, fix the spelling list in bin/cc-eligible so the\n'
            printf '  next item of this shape is classified right too, rather than forcing past it.\n'
            printf '  To override deliberately:  cc-backlog claim %s --by %s --venue cloud --force\n' "$id" "${by:-<sid>}"
          } >&2
          return 4
        fi
      fi
    fi
    # (6) SIBLING-CONDITION LEASE — the row lease above asks "is THIS ROW held?"; this asks "is this
    # WORK held?", which is a different question the moment one piece of work has two rows. See
    # CONDITION LEASE in the header for the incident and for why no automatic key is sound.
    #
    # POSITION GATES COST, exactly as the SECOND ORACLE's does (referred to by name, not number:
    # two blocks above are both labelled "(5)" since the premise check landed): an item with no
    # condition exits on the `-z` below before any jq runs, which is 1238 of 1257 rows in the live
    # ledger. The scan itself is a select over the fold already in hand — no second ledger walk.
    #
    # LAST, after the row lease, because the refusals answer different questions and the more
    # specific one should win: if THIS row is already held, "your own row is taken" is the fact the
    # reader needs, not "a sibling is taken". Reaching here means this row is claimable and only the
    # work is spoken for.
    #
    # THE ORACLE CONTRACT IS GUARD (4)+(5)'s, CALLED not restated: `claimer_live` then `owned_wait`,
    # and ONLY rc 1 from BOTH (proven not-live, proven unoccupied) releases the lease. rc 0 is
    # positive life and rc 2 is a probe that never ran; both leave the sibling alone. Note which way
    # that asymmetry points here — abstaining STRANDS this row for a tick (visible, self-healing:
    # the claim appends nothing, so the item stays `open` and the next pass retries), while
    # convicting mints the second worker the whole mechanism exists to prevent. Stranding is
    # recoverable, double-dispatch is not.
    #
    # A DEAD sibling must NOT hold the lease, or a duplicate pair whose first worker died would
    # strand both rows forever — that is what the second control in
    # tests/cc-backlog-condition-lease.bats pins.
    local lcond lproj
    lcond="$(printf '%s' "$lcur" | jq -r '.condition // ""' 2>/dev/null)"
    lproj="$(printf '%s' "$lcur" | jq -r '.project   // ""' 2>/dev/null)"
    if [ -n "$lcond" ]; then
      local sibid sibby sibvenue sibrc sibowned sibowrc
      while IFS=$'\037' read -r sibid sibby sibvenue; do
        [ -n "$sibid" ] || continue
        # An empty `by` cannot be an incumbent — nothing to be live — mirroring guard (4).
        [ -n "$sibby" ] || continue
        claimer_live "$sibby" "${sibvenue:-local}"; sibrc=$?
        if [ "$sibrc" -ne 1 ]; then
          { printf 'cc-backlog claim: REFUSED verdict=sibling-held — %s shares condition "%s" with %s, which is claimed by %s and %s\n' \
              "$id" "$lcond" "$sibid" "$sibby" \
              "$([ "$sibrc" -eq 0 ] && echo LIVE || echo 'whose liveness is UNRESOLVED')"
            printf '  These are two ledger rows naming ONE piece of work (joined by cc-backlog link),\n'
            printf '  so dispatching this one puts a second worker onto work already in progress. That\n'
            printf '  is the 2026-08-07 incident exactly: 97f16b6709fa and 6078392359ac were filed ten\n'
            printf '  seconds apart in two wordings, both dispatched, and two worktrees built the same\n'
            printf '  mechanism to completion.\n'
            printf '  Nothing is lost by waiting: this claim appended NOTHING, the item is still open,\n'
            printf '  and the next dispatch pass retries once %s releases.\n' "$sibid"
            printf '  If they are NOT the same work, unjoin this row:  cc-backlog link %s --condition <other> --force\n' "$id"
            printf '  To override deliberately:  cc-backlog claim %s --by %s --force\n' "$id" "${by:-<sid>}"
          } >&2
          return 4
        fi
        # Oracle 1 says the sibling's SHELL is gone. Ask the same second oracle guard (5) asks,
        # about the SIBLING's worktree — a <host>-<pid> claim names a shell, and shells rotate
        # while the work does not.
        sibowned="$(owned_wait "$sibid" "${sibvenue:-local}")"; sibowrc=$?
        if [ "$sibowrc" -ne 1 ]; then
          { printf 'cc-backlog claim: REFUSED verdict=sibling-held — %s shares condition "%s" with %s, whose claimer %s is gone but whose WORKTREE is %s\n' \
              "$id" "$lcond" "$sibid" "$sibby" \
              "$([ "$sibowrc" -eq 0 ] && echo LIVE || echo UNRESOLVED)"
            printf '  evidence: %s\n' "$sibowned"
            printf '  Two rows, one piece of work: dispatching this one duplicates a worker that is\n'
            printf '  still in its worktree (the e1ce92772859 shape, 2026-08-06 — pid dead, worker\n'
            printf '  mid-suite, ~20 min of duplicated work).\n'
            printf '  This claim appended nothing; the next pass retries once %s releases.\n' "$sibid"
            printf '  To override deliberately:  cc-backlog claim %s --by %s --force\n' "$id" "${by:-<sid>}"
          } >&2
          return 4
        fi
      done < <(printf '%s' "$lall" | jq -r --arg i "$id" --arg c "$lcond" --arg p "$lproj" '
        .[] | select(.id != $i and (.condition // "") == $c and (.project // "") == $p
                     and .status == "claimed")
        | [.id, (.by // ""), (.venue // "local")] | join("\u001f")' 2>/dev/null)
    fi
  fi
  jq -nc --arg id "$id" --arg ts "$(now_iso)" --arg event "$event" \
     --arg by "$by" --arg evidence "$evidence" --arg needs "$needs" \
     --arg run "$run" --arg session "$session" --arg venue "$venue" --argjson force "$force" \
     --arg selfrel "$selfrel" --arg role "$role" \
     '{id:$id, ts:$ts, event:$event}
      + (if $by != ""       then {by:$by}             else {} end)
      + (if $evidence != "" then {evidence:$evidence} else {} end)
      + (if $needs != ""    then {needs:$needs}       else {} end)
      + (if $run != ""      then {run:$run}           else {} end)
      + (if $session != ""  then {session:$session}   else {} end)
      + (if $venue != ""    then {venue:$venue}       else {} end)
      + (if $role != ""     then {role:$role}         else {} end)
      + (if $force == 1     then {force:true}         else {} end)
      + (if $selfrel != ""  then {selfRelease:true, releaseReason:$selfrel} else {} end)' \
     >> "$BACKLOG"
  echo "$id"
}

# cmd_needs "<operator-only step>" [--run "<cmd>"] [--project P] [--session SID]
#
# One-line filing of a step ONLY THE OPERATOR can do — see the `needs` paragraph in the header for
# why this verb exists at all. Composition, not a third writer: cmd_add mints the item, then
# cmd_transition writes the `block`, so both records are byte-identical to what the two-command
# path would have produced and every guard on those paths still applies.
#
# Two deliberate departures from `add`:
#   · NO dispatch_kick. `add` kicks so new OPEN work gets decided in seconds; this item is born
#     `blocked`, which cc-dispatch excludes from the wave by construction, so a kick could only
#     burn a pass — and, on any future widening of the fire predicate, spawn a worker onto a step
#     no worker can perform. The `needs)` dispatch line below therefore does NOT call it.
#   · `--source needs`, so an operator step and an ordinary `add` of the same title in the same
#     project do not collide on the event key (the id is a hash of project+title+source).
#
# The positional step is BOTH the item title and the `--needs` prose: they are the same sentence,
# and asking the caller to write it twice is the friction this verb removes.
cmd_needs() {
  local step="" run="" project="" session=""
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --run)     run="${1:-}";     [ $# -gt 0 ] && shift ;;
      --project) project="${1:-}"; [ $# -gt 0 ] && shift ;;
      --session) session="${1:-}"; [ $# -gt 0 ] && shift ;;
      --*) printf 'cc-backlog needs: unknown arg %s\n' "$key" >&2; return 2 ;;
      *)
        # Exactly one positional. A second is far more likely an unquoted step than a real
        # second argument, and silently keeping the first would file a truncated sentence.
        if [ -z "$step" ]; then step="$key"
        else
          { printf 'cc-backlog needs: unexpected extra argument %s\n' "$key"
            printf '  the step is ONE quoted argument:  cc-backlog needs "authenticate motion-plus in /mcp"\n'
          } >&2
          return 2
        fi ;;
    esac
  done
  [ -n "$step" ] || {
    { printf 'cc-backlog needs: "<operator-only step>" is required\n'
      printf '  usage: cc-backlog needs "<step>" [--run "<cmd>"] [--project P] [--session SID]\n'
    } >&2
    return 2
  }
  # Session resolution order is a CONTRACT (--session > CLAUDE_SESSION_ID > CC_SESSION_ID > omitted):
  # an explicit flag beats the ambient env so a caller filing on another session's behalf can say so.
  [ -n "$session" ] || session="${CLAUDE_SESSION_ID:-}"
  [ -n "$session" ] || session="${CC_SESSION_ID:-}"

  # cmd_add's stdout is the id and must NOT reach ours twice — capture it, echo once at the end.
  # Its stderr (the already-DONE warning) is deliberately left flowing to the caller.
  local id rc
  if [ -n "$project" ]; then
    id="$(cmd_add --project "$project" --title "$step" --source needs)"; rc=$?
  else
    id="$(cmd_add --title "$step" --source needs)"; rc=$?
  fi
  [ "$rc" -eq 0 ] || return "$rc"
  [ -n "$id" ] || { printf 'cc-backlog needs: add returned no id\n' >&2; return 2; }

  # Built as an array so a step or command containing spaces survives — an unquoted
  # ${run:+--run "$run"} would word-split the command back apart.
  local -a targs
  targs=(block "$id" --needs "$step")
  [ -n "$run" ]     && targs=("${targs[@]}" --run "$run")
  [ -n "$session" ] && targs=("${targs[@]}" --session "$session")
  cmd_transition "${targs[@]}" >/dev/null; rc=$?
  [ "$rc" -eq 0 ] || return "$rc"

  echo "$id"
}

# cmd_reclaim <id> --by <worker-identity> — re-key an EXISTING claim to the worker that is actually
# doing the work (see WORKER-KEYED CLAIMS in the header). Appends `event:"claim"` + `reclaim:true`.
#
# It is deliberately NOT `claim` with a flag: the guards are the opposite way round. `claim` may take
# an item from any status; `reclaim` may ONLY re-key an item that is already `claimed`, because every
# other status belongs to someone else — `open` is the dispatcher's (or reap's) to hand out, and
# `done`/`blocked` are terminal-or-parked, where an unsolicited claim from a hook would resurrect work
# into the wave. So a non-`claimed` status is a NO-OP, not an error.
#
# IDEMPOTENT: a re-key to the identity that already holds the claim writes NOTHING. Without this,
# SessionStart firing again (resume, /compact) would append a record and RESET claimAgeS on every
# fire, letting one session's restarts hold the stale gate open indefinitely.
#
# cmd_link <id> --condition <slug> [--force]
#
# Join a row that ALREADY EXISTS to a condition group — the verb that gives claim guard (6) a
# non-empty population to govern (see CONDITION LEASE in the header). `add --condition` cannot do
# this: it derives the id FROM the condition, so it can only ever produce one row per condition,
# and the two rows that need joining were minted from their titles before anyone knew they were
# the same work.
#
# NOT a transition. The record carries no `by`/`evidence` and the fold's status arm has no `link`
# branch, so it falls to `($p.status // "open")` and the item's status is untouched — linking a
# claimed item does not release it, and linking a done item does not resurrect it. The condition
# itself needs no fold change at all: `condition: ($r.condition // $p.condition // "")` already
# carries any record that names one.
#
# Three guards:
#   · SAME DIGIT RULE as `add --condition`, enforced by the SAME `valid_condition` (called, never
#     restated — memory: sibling-auditors-must-share-the-state-model). A slug carrying a
#     measurement re-mints one group per measurement, which is the defect one layer down.
#   · RE-KEY NEEDS --force. Silently moving a row from one condition group to another would
#     release a lease that is holding a live worker off duplicated work, and nothing would say so.
#   · IDEMPOTENT on the same slug: writes nothing, exits 0. A desk pass that re-links every tick
#     must not grow the ledger.
cmd_link() {
  local id="${1:-}"; [ $# -gt 0 ] && shift
  local condition="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --condition) shift; condition="${1:-}"; [ $# -gt 0 ] && shift ;;
      --force)     force=1; shift ;;
      *) printf 'cc-backlog link: unknown arg %s\n' "$1" >&2; return 2 ;;
    esac
  done
  [ -n "$id" ]        || { printf 'cc-backlog link: <id> is required\n' >&2; return 2; }
  [ -n "$condition" ] || { printf 'cc-backlog link: --condition <slug> is required\n' >&2; return 2; }
  if ! valid_condition "$condition"; then
    { printf 'cc-backlog link: --condition "%s" is not a stable key.\n' "$condition"
      printf '  A condition names a recurring STATE, so it must hold still: lowercase letters and\n'
      printf '  hyphens only, no digits. A slug carrying a measurement mints one GROUP per\n'
      printf '  measurement, which is the same defect one layer down. Spell out a numeral a\n'
      printf '  condition genuinely needs (opus-five-routing-drift).\n'
    } >&2
    return 2
  fi
  ensure_file
  has_id "$id" || { printf 'cc-backlog link: unknown id %s\n' "$id" >&2; return 3; }
  local cur prev
  cur="$(item_json "$id")"
  prev="$(printf '%s' "$cur" | jq -r '.condition // ""' 2>/dev/null)"
  if [ "$prev" = "$condition" ]; then echo "$id"; return 0; fi
  if [ -n "$prev" ] && [ "$force" -eq 0 ]; then
    { printf 'cc-backlog link: REFUSED — %s is already on condition "%s"\n' "$id" "$prev"
      printf '  Re-keying it to "%s" moves it out of a group whose lease may be holding a live\n' "$condition"
      printf '  worker off duplicated work, and nothing downstream would report the move.\n'
      printf '  To re-key deliberately:  cc-backlog link %s --condition %s --force\n' "$id" "$condition"
    } >&2
    return 4
  fi
  jq -nc --arg id "$id" --arg ts "$(now_iso)" --arg condition "$condition" \
     --argjson force "$force" \
     '{id:$id, ts:$ts, event:"link", condition:$condition}
      + (if $force == 1 then {force:true} else {} end)' >> "$BACKLOG"
  echo "$id"
}

# cmd_dups [--project P] [--json] — REPORT candidate duplicate rows. Gates nothing.
#
# The detector half of the condition lease, and deliberately only a detector. Same-project +
# same-dodRef is the strongest automatic signal available (both incident rows carried it), and it
# is far too weak to gate on: replayed over the ledger's claim intervals it produces 81 concurrent
# pairs for ~1 real duplicate, because a plan doc's Phase-0 items SHOULD run in parallel (the
# measurement is in the CONDITION LEASE header block). As a gate that is a 98% false-refusal rate;
# as a report the same rows are the exact review queue, and `link` is the one-line answer.
#
# Scoped to LIVE rows (open/claimed). A done item shares its dodRef with its siblings forever, so
# including terminal work would make every finished plan a permanent standing group — an alarm that
# always fires carries no bits (memory: alarm-polarity-and-attention-budget). Rows that ALREADY
# share a condition are excluded for the same reason: they are answered, and re-reporting an
# answered group trains the reader to skip the list.
cmd_dups() {
  local project="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) shift; project="${1:-}"; [ $# -gt 0 ] && shift ;;
      --json)    json=1; shift ;;
      *) printf 'cc-backlog dups: unknown arg %s\n' "$1" >&2; return 2 ;;
    esac
  done
  ensure_file
  local groups
  groups="$(fold | jq -c --arg p "$project" '
    [ .[]
      | select((.status == "open") or (.status == "claimed"))
      | select((.dodRef // "") != "")
      | select($p == "" or .project == $p) ]
    | group_by([.project, .dodRef])
    | map(select(length > 1))
    # A group whose members already share ONE non-empty condition is answered — drop it. Mixed or
    # absent conditions still report: that is precisely the un-joined case.
    | map(select([ .[] | .condition // "" ] | unique | (length > 1 or .[0] == "")))
    | map({project: .[0].project, dodRef: .[0].dodRef,
           items: [ .[] | {id, status, condition: (.condition // ""), title} ]})')"
  if [ "$json" -eq 1 ]; then printf '%s\n' "$groups"; return 0; fi
  local n; n="$(printf '%s' "$groups" | jq 'length')"
  if [ "$n" -eq 0 ]; then echo "cc-backlog dups: no candidate duplicate groups."; return 0; fi
  printf '%s' "$groups" | jq -r '.[]
    | "── \(.project)  \(.dodRef)",
      (.items[] | "   \(.id)  \(.status)\(if .condition == "" then "" else "  [" + .condition + "]" end)  \(.title[0:96])"),
      ""'
  printf 'cc-backlog dups: %s candidate group(s) — same project+dodRef, live, not joined.\n' "$n"
  printf '  These are CANDIDATES, not duplicates: a plan doc'"'"'s parallel phases share a dodRef too.\n'
  printf '  If two rows ARE one piece of work, join them so only one can be dispatched:\n'
  printf '      cc-backlog link <id> --condition <slug>   # both rows, same slug\n'
}

# Every path prints a structured `verdict=<token>`: the caller is a fail-open hook whose exit code
# cannot carry the outcome, and a silent no-op is indistinguishable from an inert mechanism
# (memory: claimed-outcome-vs-checked-outcome, feature-durability-mechanism-not-memory). rc is 0 for
# every real verdict (reclaimed / noop-*), 2 for usage, 3 for an unknown id.
cmd_reclaim() {
  local id="${1:-}"; [ $# -gt 0 ] && shift
  local by=""
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --by) by="${1:-}"; [ $# -gt 0 ] && shift ;;
      *) printf 'cc-backlog reclaim: unknown arg %s\n' "$key" >&2; return 2 ;;
    esac
  done
  [ -n "$id" ] || { printf 'cc-backlog reclaim: <id> is required\n' >&2; return 2; }
  [ -n "$by" ] || { printf 'cc-backlog reclaim: --by <worker-identity> is required\n' >&2; return 2; }
  ensure_file
  has_id "$id" || {
    printf 'cc-backlog reclaim: verdict=unknown-id %s\n' "$id" >&2; return 3
  }
  local cur cstatus cby
  cur="$(item_json "$id")"
  cstatus="$(printf '%s' "$cur" | jq -r '.status // ""' 2>/dev/null)"
  cby="$(    printf '%s' "$cur" | jq -r '.by     // ""' 2>/dev/null)"
  if [ "$cstatus" != claimed ]; then
    printf 'cc-backlog reclaim: verdict=noop-status %s status=%s (only a claimed item is re-keyed)\n' \
      "$id" "${cstatus:-?}"
    return 0
  fi
  if [ "$cby" = "$by" ]; then
    printf 'cc-backlog reclaim: verdict=noop-already-ours %s by %s\n' "$id" "$by"
    return 0
  fi
  # ANTI-STEAL: refuse when the incumbent claimer is PROVABLY live, is not us, and is a WORKER.
  # What it blocks is a second session opened in the same worktree (a hand /ship, a GC pass) taking
  # the claim away from the worker that is still running: two live claimants is precisely the
  # double-ownership this ledger exists to prevent, and the FIRST one is the rightful owner. An
  # UNRESOLVED incumbent (rc 2 — no registry answer) proceeds deliberately: refusing there would make
  # worker-keying inert exactly when the registry is wedged, and occupancy of the item's own worktree
  # is the better evidence of who is doing the work.
  #
  # THE `role` TERM IS NOT A CONVENIENCE — WITHOUT IT THIS GUARD DEADLOCKS ITS OWN HARNESS.
  # This comment used to read "the intended case is a dead incumbent — cc-dispatch's own spent pid —
  # so this costs one `kill -0` and never blocks it." That premise is FALSE, and it was false by
  # construction, not by accident: cc-dispatch claims under `<host>-$$` (its own bash pid) and then
  # spawns the worker, so the dispatcher is ALIVE at the exact instant its worker's SessionStart runs
  # the hand-over. `kill -0` cannot tell that dispatcher from a competing peer worker — both are a
  # live `<host>-<pid>` — so the guard fired on the very harness it exists to serve (memory:
  # guard-refusal-fires-on-its-own-harness).
  #
  # MEASURED 2026-08-09 on item b922dde5567b, live, twice over:
  #     14:46:44  pid 49310 = `/bin/bash .../cc-dispatch --once` claims the item
  #     14:49:41  the worker's session-register reclaim → verdict=noop-live-claimer
  #     14:53     worker-claim-gate → rc 9 REFUSE on the worker's FIRST Edit, holder=...-49310
  # The write gate then tells that worker — the one cc-dispatch fired for this very item — that it is
  # a duplicate and must STAND DOWN. It stands down or reopens, the dispatcher re-claims, and the
  # next worker hits the same wall: the "persistent thrash - 2 fast claim->reopen cycle(s)" already
  # recorded in the item's own needs field. It resolved ONLY when a `--once` dispatcher happened to
  # exit first — i.e. on TIMING LUCK, and a dispatcher that outlives its worker's SessionStart (this
  # one did, by 3 minutes) strands that worker completely, because session-register re-keys ONCE at
  # process start and never retries.
  #
  # So the question that separates a hand-over from a steal was never "is the incumbent alive?" —
  # a dispatcher is alive by construction and does no work — it is "is the incumbent a WORKER?".
  # That fact is not derivable from the identity string, so the CLAIM RECORD CARRIES IT (`--role
  # dispatcher`, written by cc-dispatch at bin/cc-dispatch step 5a).
  #
  # WHY THIS IS NOT A HOLE IN THE LEASE — four independent bounds, and the exemption needs all four:
  #   1. `reclaim` ONLY. `claim` and `reopen` keep their live-claimer guards verbatim; nothing here
  #      widens the verbs that can displace a live worker.
  #   2. EXPLICIT, never inferred. Only a claim the dispatcher itself labelled is exempt. An absent
  #      role (every pre-existing record, every hand claim) behaves exactly as before.
  #   3. ONE-SHOT. The re-key below writes NO role field, and fold() RESETS role on every claim
  #      record — so the item becomes worker-held the instant the first worker takes it, and a second
  #      worker racing it meets an ordinary live-claimer refusal. The exemption consumes itself.
  #   4. WORKTREE-SCOPED CALLERS. Both production callers (hooks/session-register.sh,
  #      scripts/lib/worker-claim-gate.sh) refuse to call at all unless cwd is `wt-<the item's own
  #      12-hex id>`, so the exemption is reachable only from inside the item's own dispatch worktree.
  # A dispatcher holds a PLACEHOLDER lease for a worker it has not spawned yet; handing that lease to
  # the worker that arrived in the item's own worktree is the designed transaction, not a steal.
  local crole; crole="$(printf '%s' "$cur" | jq -r '.role // ""' 2>/dev/null)"
  # The incumbent's venue governs both the anti-steal probe AND the record written below. A reclaim
  # is a re-KEY, never a re-VENUE: the worker is naming itself, not moving hosts. The fold RESETS
  # venue on every `claim` record (see fold()), and a reclaim IS one — so omitting it here would
  # silently demote a cloud worker to "local" the instant it re-keyed, handing the local oracles
  # back a population they cannot see and re-arming the false-dead this whole change removes. The
  # value is carried forward explicitly rather than left to a default (memory:
  # default-path-hardening-is-blind-to-the-explicit-argument).
  local rvenue; rvenue="$(printf '%s' "$cur" | jq -r '.venue // "local"' 2>/dev/null)"
  [ -n "$rvenue" ] || rvenue=local
  if [ "$crole" != dispatcher ] && [ -n "$cby" ] && claimer_live "$cby" "$rvenue"; then
    printf 'cc-backlog reclaim: verdict=noop-live-claimer %s is held by %s, which is LIVE\n' "$id" "$cby"
    return 0
  fi
  # NO role field is written — see bound (3) above. This is the line that makes the exemption
  # one-shot; it is a deliberate omission, not an oversight.
  jq -nc --arg id "$id" --arg ts "$(now_iso)" --arg by "$by" --arg venue "$rvenue" \
     '{id:$id, ts:$ts, event:"claim", by:$by, reclaim:true}
      + (if $venue != "local" then {venue:$venue} else {} end)' >> "$BACKLOG"
  # The `[dispatcher hand-over]` suffix rides the SAME `verdict=reclaimed` token both consumers
  # already glob-match (`*verdict=reclaimed*` — hooks/session-register.sh, worker-claim-gate.sh), so
  # it changes no branch. It exists so the hand-over is COUNTABLE in production: without it, a
  # deadlock cured and a deadlock that never occurred emit identical lines, and the fix would be
  # unfalsifiable in the field (memory: claimed-outcome-vs-checked-outcome).
  if [ "$crole" = dispatcher ]; then
    printf 'cc-backlog reclaim: verdict=reclaimed %s by %s (was %s) [dispatcher hand-over]\n' \
      "$id" "$by" "${cby:-<none>}"
  else
    printf 'cc-backlog reclaim: verdict=reclaimed %s by %s (was %s)\n' "$id" "$by" "${cby:-<none>}"
  fi
}

cmd_list() {
  local mode="open" projfilter="" fmt="table"
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --open)    mode="open" ;;
      --all)     mode="all" ;;
      --blocked) mode="blocked" ;;
      --project) projfilter="${1:-}"; [ $# -gt 0 ] && shift ;;
      --json) fmt="json" ;;
      *) printf 'cc-backlog list: unknown arg %s\n' "$key" >&2; return 2 ;;
    esac
  done
  # mode → status predicate (`keep`, shared by json + table): all=every item ·
  # blocked=only blocked · open(default)=every non-done item (so `blocked` items STILL
  # surface in the desk's --open view, but cc-dispatch's exact status=="open" filter
  # excludes them). `needs` (the pending operator step) is carried in both branches.
  # --json: the SAME filtered fold as the table, as a compact JSON array (one object per
  # item, full carried meta incl. `needs`) for machine consumers (cc-dispatch, the desk
  # digest). The default (table) branch is byte-unchanged for non-blocked rows.
  #
  # `run` + `session` (the `needs`-verb fields) are OMITTED when empty rather than emitted
  # as "". The fold carries them ""-defaulted like every sibling field, but a renderer must
  # be able to distinguish "this step has no runnable command" from "its command is the
  # empty string" — an empty `run` handed to cc-do would be a blank line the operator is
  # invited to paste. Deleted here, at the one place machine consumers read. `condition`
  # follows the same rule for the same reason: `has("condition")` is then the exact test for
  # "this item is keyed on a recurring state", with no empty-string special case to get wrong.
  # The TABLE branch is deliberately untouched — the condition is identity, not status, and a
  # new column would change every row for every reader to say what the id already encodes.
  if [ "$fmt" = json ]; then
    fold | jq -c --arg mode "$mode" --arg proj "$projfilter" '
      def keep: if $mode=="all" then true elif $mode=="blocked" then .status=="blocked" else .status!="done" end;
      sort_by(.project, .title)
      | map( select(keep)
           | select($proj == "" or .project == $proj)
           | (if (.run     // "") == "" then del(.run)     else . end)
           | (if (.session // "") == "" then del(.session) else . end)
           | (if (.condition // "") == "" then del(.condition) else . end) )'
    return 0
  fi
  fold | jq -r --arg mode "$mode" --arg proj "$projfilter" --arg pad "$TSV_PAD" "$CELL"'
    def keep: if $mode=="all" then true elif $mode=="blocked" then .status=="blocked" else .status!="done" end;
    sort_by(.project, .title) | .[]
    | select(keep)
    | select($proj == "" or .project == $proj)
    | [ (.status | cell("?")), (.id | cell("?")), (.project | cell("?")),
        (.title | cell("?")), (.needs | cell($pad)) ] | @tsv
  ' | while IFS=$'\t' read -r st id proj title needs; do
      [ "$needs" = "$TSV_PAD" ] && needs=""      # un-pad: "" is the not-blocked signal
      if [ "$st" = blocked ] && [ -n "$needs" ]; then
        printf '%-8s | %s | %-28s | %s  ⟵ needs: %s\n' "$st" "$id" "$proj" "$title" "$needs"
      else
        printf '%-8s | %s | %-28s | %s\n' "$st" "$id" "$proj" "$title"
      fi
    done
}

cmd_compact() {
  local days="30"
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --older-than-days) days="${1:-30}"; [ $# -gt 0 ] && shift ;;
      *) printf 'cc-backlog compact: unknown arg %s\n' "$key" >&2; return 2 ;;
    esac
  done
  ensure_file
  local cutoff; cutoff=$(cutoff_iso "$days")
  [ -n "$cutoff" ] || { echo "cc-backlog compact: could not compute cutoff" >&2; return 2; }
  # Drop set: terminal (done) items whose last event is older than the cutoff.
  #
  # AN EMPTY DROP SET HAS TWO CAUSES AND THIS VERB MAY NOT CONFLATE THEM. Either the ledger really
  # holds nothing aged out, or the READ FAILED and every item is invisible — a fold whose jq dies
  # (machine pressure, a fork that could not be made, an unreadable file) emits nothing, which is
  # byte-identical to the honest answer. valid_records has always DETECTED that case — it counts the
  # records it read against the lines in the file for exactly this reason, in its own words "a jq
  # failure would otherwise report an EMPTY ledger — a silent 'nothing to reap' instead of an error"
  # — but the verdict was stderr prose behind `return 0`, so it never reached a caller. This site
  # then consumed the empty result as "nothing aged out" and returned SUCCESS: the one fail-OPEN
  # left in a verb whose every other branch is fail-closed, and invisible in production, because a
  # compact that silently no-ops looks exactly like a compact that had no work to do. It is also a
  # live failure mode of tests/cc-backlog-compact-race.bats::4, which asserts the lock is released
  # afterwards and sees it left behind — this path returns before the lock is ever taken.
  #
  # The rc is consulted ONLY when the answer is empty. A short read that still named aged items is
  # not acted on differently: those ids are real (the fold cannot invent one), the rewrite re-reads
  # the file itself rather than trusting the fold, and the n0/n1 optimistic guard below still covers
  # the commit. Narrowing it here keeps the strict read from shadowing the concurrent-append abort
  # that test 2 exercises — a guard that pre-empts the guard it is helping is a vacuous test.
  local drop drc=0
  drop=$(fold --strict | jq -r --arg c "$cutoff" \
    '.[] | select(.status == "done" and .lastTs != "" and .lastTs < $c) | .id') || drc=$?
  if [ -z "$drop" ] && [ "$drc" -ne 0 ]; then
    echo "cc-backlog compact: the ledger could not be read completely — ABORTED (read rc $drc)." >&2
    echo "  NOTHING was rewritten. An unreadable ledger folds to the same empty drop set as a" >&2
    echo "  ledger with no aged records, and calling that success hides a compaction that never ran." >&2
    return 5
  fi
  if [ -z "$drop" ]; then
    printf 'cc-backlog compact: nothing aged out (cutoff %s)\n' "$cutoff" >&2
    return 0
  fi
  # ── LOST-APPEND SAFETY (a15/D2) ───────────────────────────────────────────────────────────────
  # compact is the ONE verb that rewrites this store; every other writer appends. It read the whole
  # file into $tmp and then `mv`'d $tmp over it, with no lock and no re-check, so ANY record appended
  # between the read loop and the mv was silently discarded by the overwrite. The record that gets
  # lost is not hypothetical: a cc-dispatch `claim` landing in that window vanishes, the item folds
  # back to status "open", and the next dispatch tick claims and spawns a SECOND worker on in-flight
  # work — the exact double-dispatch class the reopen guards above were added to stop, reintroduced
  # through the compaction door.
  #
  # WHY NOT SIMPLY "TAKE A LOCK": the appenders are deliberately lock-free. Bare O_APPEND of a
  # sub-PIPE_BUF line is atomic and is what makes this store safe for ~14 concurrent writers without
  # coordination. Putting a mutex on that hot path to protect a manual, once-a-month verb would be
  # the wrong trade. So the lock here serves only to serialize compact against ANOTHER compact, and
  # correctness against appenders comes from optimistic concurrency instead:
  #
  #   1. snapshot the line count n0 and consume exactly n0 lines;
  #   2. carry lines n0+1..EOF through VERBATIM (late arrivals are preserved, never judged);
  #   3. immediately before the mv, re-read the count. If it changed, our snapshot is stale → retry.
  #   4. after RETRY_MAX stale rounds, ABORT WITHOUT REWRITING.
  #
  # Fail-closed is the whole point: a skipped compaction costs some disk, a lost claim costs a
  # double-dispatched worker. When we cannot PROVE the file is unchanged we do not touch it.
  local RETRY_MAX=3 attempt=1
  _bl_compact_lock || {
    echo "cc-backlog compact: another compact holds the lock — skipping (nothing was rewritten)" >&2
    return 5
  }
  while :; do
    local tmp n=0 kept=0 dropped=0 malformed=0 line lid n0 late
    n0=$(grep -c '' "$BACKLOG" 2>/dev/null || echo 0)
    tmp=$(mktemp)
    while IFS= read -r line || [ -n "$line" ]; do
      n=$((n + 1))
      [ "$n" -gt "$n0" ] && break                 # beyond the snapshot — handled verbatim below
      [ -z "$line" ] && continue
      lid=$(printf '%s' "$line" | jq -r 'if (has("id") and has("event")) then .id else "__BAD__" end' 2>/dev/null || echo "__BAD__")
      if [ "$lid" = "__BAD__" ]; then
        printf '%s\n' "$line" >> "$tmp"; malformed=$((malformed + 1))   # preserve, never drop
        printf 'cc-backlog compact: preserved malformed line %d\n' "$n" >&2
        continue
      fi
      if printf '%s\n' "$drop" | grep -qxF -- "$lid"; then
        dropped=$((dropped + 1)); continue
      fi
      printf '%s\n' "$line" >> "$tmp"; kept=$((kept + 1))
    done < "$BACKLOG"
    # Late arrivals ride through untouched — they are by definition newer than the cutoff, so no
    # filtering decision applies to them, and preserving them verbatim is what makes a concurrent
    # append survive compaction instead of being erased by it.
    #
    # The BOUND is fixed BEFORE the read and the copy is clamped to it (`head -n "$late"`). Measuring
    # `late` after the tail instead — the first version of this — is itself a lost-append bug: growth
    # between the read and the measurement inflates `late`, the guard below then compares against the
    # inflated number and PASSES, and the lines the tail never reached are dropped by the mv. Caught
    # by test 2 of tests/cc-backlog-compact-race.bats, which is why that test exists.
    local n1
    n1=$(grep -c '' "$BACKLOG" 2>/dev/null || echo 0)
    late=$(( n1 - n0 ))
    [ "$late" -lt 0 ] && late=0
    if [ "$late" -gt 0 ]; then
      tail -n "+$((n0 + 1))" "$BACKLOG" 2>/dev/null | head -n "$late" >> "$tmp" 2>/dev/null || true
    fi
    # THE GUARD: the file must still be exactly the length we just consumed (n1). Any append that
    # landed after the bound was fixed makes this fail, and the attempt is retried rather than
    # committing a rewrite that would erase it.
    if [ "$(grep -c '' "$BACKLOG" 2>/dev/null || echo 0)" -eq "$n1" ]; then
      # COMMIT BY RENAME-ASIDE, NOT OVERWRITE. The guard above still leaves one irreducible gap: an
      # append landing between the check and the commit. `mv "$tmp" "$BACKLOG"` DESTROYS the old inode,
      # so such a record is unrecoverable — and this is not a theoretical gap, it is what test 1 of
      # tests/cc-backlog-compact-race.bats reproduces deterministically.
      #
      # Renaming the original ASIDE first makes the window recoverable instead of fatal. The appenders
      # open by name per write (`>> "$BACKLOG"`), so a writer racing the swap lands in exactly one of
      # two files, and we still hold BOTH: anything that arrived in the stash beyond our snapshot is
      # appended to the new ledger afterwards. The recovery repeats while the stash keeps growing, so
      # a burst is drained rather than sampled once.
      #
      # RESIDUAL, stated rather than hidden: a writer that opened the stash inode after the final
      # recovery read still loses its line. Closing that completely requires the appenders to take the
      # lock, which is deliberately rejected above — bare O_APPEND is what keeps ~14 writers
      # coordination-free. This narrows the window from "the whole commit" to "after the last drain of
      # a file nothing is supposed to be opening any more", and never widens it.
      local stash="$BACKLOG.compacting.$$" rec=0 spins=0 sn
      if mv "$BACKLOG" "$stash" 2>/dev/null; then
        mv "$tmp" "$BACKLOG" 2>/dev/null || { mv "$stash" "$BACKLOG" 2>/dev/null || true; rm -f "$tmp" 2>/dev/null || true; _bl_compact_unlock; echo "cc-backlog compact: commit failed — ledger left untouched" >&2; return 5; }
        while :; do
          sn=$(grep -c '' "$stash" 2>/dev/null || echo 0)
          [ "$sn" -gt "$(( n1 + rec ))" ] || break
          tail -n "+$(( n1 + rec + 1 ))" "$stash" 2>/dev/null | head -n "$(( sn - n1 - rec ))" >> "$BACKLOG" 2>/dev/null || true
          rec=$(( sn - n1 ))
          spins=$((spins + 1)); [ "$spins" -ge 5 ] && break
        done
        rm -f "$stash" 2>/dev/null || true
      else
        rm -f "$tmp" 2>/dev/null || true; _bl_compact_unlock
        echo "cc-backlog compact: could not rename the ledger aside — nothing was rewritten" >&2
        return 5
      fi
      _bl_compact_unlock
      printf 'cc-backlog compact: kept %d, dropped %d aged-terminal, preserved %d malformed' \
        "$kept" "$dropped" "$malformed" >&2
      [ "$late" -gt 0 ] && printf ', carried %d concurrent append(s)' "$late" >&2
      [ "$rec" -gt 0 ] && printf ', recovered %d append(s) from the commit window' "$rec" >&2
      printf '\n' >&2
      return 0
    fi
    rm -f "$tmp" 2>/dev/null || true
    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$RETRY_MAX" ]; then
      _bl_compact_unlock
      echo "cc-backlog compact: the ledger is being appended to concurrently; ABORTED after $RETRY_MAX attempts." >&2
      echo "  NOTHING was rewritten — a skipped compaction is cheap, a lost claim record is not." >&2
      echo "  Re-run when the dispatcher/reaper timers are quiet." >&2
      return 5
    fi
    printf 'cc-backlog compact: ledger changed under us — retrying (%d/%d)\n' "$attempt" "$RETRY_MAX" >&2
  done
}

# _resolve_sessions_bin → path to cc-sessions (the live-registry liveness oracle), or "" (rc 0).
# Env override wins (tests), then sibling, then ~/.claude/bin, then PATH (launchd bare-PATH safe).
_resolve_sessions_bin() {
  if [ -n "${CC_BACKLOG_SESSIONS_BIN:-}" ]; then printf '%s' "$CC_BACKLOG_SESSIONS_BIN"; return 0; fi
  local c
  for c in "$(dirname "$0")/cc-sessions" "$HOME/.claude/bin/cc-sessions" "$(command -v cc-sessions 2>/dev/null || true)"; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  printf ''
}

# claimer_live <by> — is the claim's owner still live? A `<host>-<pid>` claimer (cc-dispatch and
# most manual claims) is authoritatively checked with `kill -0` (same user across accounts); a
# session-id / UUID / name claimer against the live cc-sessions registry. Our own reap marker is
# never "live".
#
# THREE outcomes, not two — the distinction is the whole point (memory: gate-never-ran-vs-gate-red,
# claimed-outcome-vs-checked-outcome — one exit code for two outcomes forces every caller to lie):
#   rc 0  LIVE       proven: `kill -0` succeeded, or the registry ANSWERED and lists this claimer.
#   rc 1  NOT-LIVE   proven: `kill -0` failed on a well-formed <host>-<pid>, or the registry ANSWERED
#                    and does not list the claimer, or there is no owner to check at all (empty `by`,
#                    our own reap marker). A real verdict — the dead-worker path may act on it.
#   rc 2  UNRESOLVED the PROBE produced no answer: no registry binary, the call timed out (a wedged
#                    it2), empty output, or unparseable output. A NON-VERDICT — the absence of an
#                    answer, not the answer "dead". Callers must ABSTAIN on this, never convict: our
#                    own timeout must not forge the kill evidence.
#
# rc 2 used to be folded into rc 1 ("an unresolved oracle reads NOT-live — stranding the work is the
# worse failure"). That trade was wrong in the direction it was made: `reopen` sets status=open,
# which is cc-dispatch's fire predicate, so convicting on a non-verdict does not merely strand work —
# it SPAWNS A SECOND WORKER onto work that may well be live. Stranding is visible, bounded and
# recoverable (the abstention ceiling below blocks it out to a human); double-dispatch is neither.
claimer_live() {
  local by="$1" venue="${2:-local}"
  [ -n "$by" ] && [ "$by" != cc-backlog-reap ] || return 1
  # VENUE GATE — an oracle that cannot SEE a population must not RETURN A VERDICT about it.
  #
  # Both oracles below read host-local state: `kill -0` against this kernel's pid table, and the
  # cc-sessions registry, which is a list of iTerm2/kitty panes ON THIS BOX. A worker in an
  # Anthropic-managed VM appears in neither — not because it is dead, but because neither
  # instrument's population includes it. Without this gate the registry branch ANSWERS (it is
  # perfectly healthy; it simply has no cloud rows) and jq's `any(...)` returns false ⇒ rc 1 =
  # PROVEN NOT-LIVE. That is the worst of the three outcomes: not the abstention rc 2 was built
  # for, but a CONFIDENT WRONG VERDICT, which sails past every rc-2 safety net downstream and
  # reaches `reopen` — cc-dispatch's fire predicate — i.e. a second worker onto live work.
  #
  # MEASURED, not reasoned (2026-08-07, backlog 191d4d056c98). Against a hermetic store with the
  # claim aged past the stale gate, `reap --dry-run` said:
  #     claimer "cloudvm-4242"                        → WOULD-REOPEN [dead-worker]
  #     claimer "6c135981-cacf-4527-acd2-0000...0000" → WOULD-REOPEN [dead-worker]
  #     claimer "<this-host>-<live-pid>"              → WOULD-BLOCK  [wedged live worker]
  # The third line is the positive control: the harness CAN tell live from dead, so the first two
  # are a property of the venue and not of the probe (memory: positive-control-the-denominator).
  # Every cloud claim shape lands on "dead" — there is no spelling that abstains.
  #
  # rc 2 and not rc 1 is the whole change, and it needs no new machinery: `reap` already abstains
  # on rc 2, bounded by CC_BACKLOG_UNRESOLVED_MAX_S, past which it BLOCKS out to a human rather
  # than reopening. So an unobservable cloud worker strands VISIBLY instead of being double-
  # dispatched silently — the asymmetry this whole oracle stack is built around.
  #
  # This does NOT blunt local dead-worker detection: the venue is EXPLICIT (an absent field folds
  # to "local", so all 4,837 pre-existing records and every local claim behave exactly as before).
  # Inferring the venue from "the registry didn't list it" would have been the bug — that is the
  # normal, correct way a dead local worker is detected.
  if [ "$venue" != local ]; then
    return 2
  fi
  local host; host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo localhost)"
  local pid="${by##*-}"
  if [ "$by" = "$host-$pid" ] && [[ "$pid" =~ ^[0-9]+$ ]]; then
    if kill -0 "$pid" 2>/dev/null; then return 0; fi
    return 1
  fi
  local sb; sb="$(_resolve_sessions_bin)"
  [ -n "$sb" ] || return 2          # no registry to ask ⇒ UNRESOLVED, not "dead"
  # TIME-CAP the registry fork. cc-sessions resolves pane liveness through `it2 session list --json`
  # (cc-sessions:57) with no timeout of its own, and a WEDGED it2 API hangs that call indefinitely —
  # measured 2026-07-26 during a machine-wide wedge: `timeout 60 cc-sessions --json` → rc 124, and a
  # bare `it2 session list --json` → rc 124 with no output. Unwrapped, one session-shaped claimer
  # would hang `reap` forever and take the whole `cc-reaper --reap` sweep down with it — and the
  # owned-wait re-verify below would never be REACHED, leaving this fix inert by construction in
  # exactly the incident where correct stall verdicts matter most (memory:
  # feature-durability-mechanism-not-memory). A cap composes cleanly with the rc contract above: a
  # timed-out probe is UNRESOLVED (rc 2, a non-verdict) — it is NOT evidence of death, precisely
  # because the timeout is OURS. Our own `timeout` must never be allowed to forge the kill evidence
  # (memory: gate-never-ran-vs-gate-red).
  local sessions_json
  if command -v timeout >/dev/null 2>&1; then
    sessions_json="$(timeout "${CC_BACKLOG_ORACLE_TIMEOUT_S:-10}" "$sb" --json 2>/dev/null || true)"
  else
    sessions_json="$("$sb" --json 2>/dev/null || true)"
  fi
  [ -n "$sessions_json" ] || return 2          # no output (timeout / crash) ⇒ UNRESOLVED
  # jq's own rc carries the third state for free: 0 = listed (LIVE), 1 = answered-and-absent (a real
  # NOT-LIVE verdict), anything else = jq could not parse/evaluate the registry ⇒ UNRESOLVED.
  #
  # `.session_id` is the REAL key — `.sessionId` never matched anything. session-register.sh writes
  # the row as {paneUUID, name, cwd, account, pid, startedAt, session_id} (session-register.sh:88)
  # and 0 of the live rows carry a camelCase `sessionId` (measured 2026-07-29), so a claim keyed on a
  # session id resolved to answered-and-absent = rc 1 = PROVEN NOT-LIVE — the one verdict that lets
  # Rule A reopen, i.e. a false dead verdict on a demonstrably live session (RED-proved against this
  # session's own registry row: `reap` said WOULD-REOPEN "dead-worker" for its session_id and "LIVE"
  # for its paneUUID and its pid). It survived because the only test to exercise the registry branch
  # stubbed a fixture emitting `paneUUID`, so the camelCase predicate was never contrasted with the
  # real producer's emission (memory: fixture-shape-parity-with-real-producer). The dead spelling is
  # kept alongside: it costs one `or` and forgiving both spellings is strictly safer here, where a
  # miss is a false DEATH.
  printf '%s' "$sessions_json" \
    | jq -e --arg b "$by" 'any(.[]?; (.paneUUID==$b) or (.name==$b) or (.session_id==$b) or (.sessionId==$b))' >/dev/null 2>&1
  local jrc=$?
  case "$jrc" in 0) return 0 ;; 1) return 1 ;; *) return 2 ;; esac
}

# item_worktree <id> → the dispatch worktree an item's worker runs in, by the SAME convention
# cc-wave-plan builds its --cwd from ($WTROOT/wt-<id>, cc-wave-plan:45). Env seam mirrors that name.
item_worktree() { printf '%s/wt-%s' "${CC_BACKLOG_WT_ROOT:-$HOME/Development/.worktrees}" "$1"; }

# procs_cwd_under <dir> → pids of live processes whose CWD is at or below <dir>, one per line.
# macOS has no /proc, so a process's cwd is only readable through lsof(8) — a SYSTEM binary
# (/usr/sbin/lsof), present under the bare PATH a launchd sweep runs with. `-d cwd -F pn` is the terse
# form: a `p<pid>` line, then the `n<path>` for that process's cwd. The PREFIX match lives in awk
# rather than in an lsof path argument because passing the path makes lsof match it EXACTLY — which
# misses a worker that has cd'd into a subdirectory (measured: such a process was invisible to the
# path-argument form and visible to this one, at an identical 0.22s).
#
# BOUNDED: lsof can block indefinitely on an unresponsive mount, and this runs inside the
# `cc-reaper --reap` sweep — an unbounded probe would hang that sweep exactly as the wedged it2
# registry call did (see claimer_live).
#
# THREE-VALUED, like claimer_live and for the same reason (memory: gate-never-ran-vs-gate-red — one
# exit code for two outcomes forces every caller to lie):
#   rc 0  ANSWERED    the probe RAN; the pids it found (possibly NONE) are on stdout. A real verdict.
#   rc 2  UNRESOLVED  the probe could not be run at all — no binary, the seam disabled it, it timed
#                     out, or it produced no output. A NON-VERDICT: callers must ABSTAIN.
# It used to return rc 0 on every one of those paths, and the comment here claimed "the signal
# abstains and the next one is consulted". It does not: an empty stdout is INDISTINGUISHABLE from
# "asked, nobody there", and there is no next signal that can see the worker (S2 is a land lock, held
# only while landing). So the abstention never reached the caller, `owned_wait` returned "no
# evidence", and reap read that as a licence to REOPEN a live worker (see the owned_wait rc contract).
# Empty output is UNRESOLVED and not "nobody home" because a full-system `lsof -d cwd` always reports
# at least this very process's own cwd — a truly empty read means the probe did not complete.
# A bound must cost a slower path, never a false verdict in EITHER direction.
#
# PATH FORM: lsof reports a cwd PHYSICALLY RESOLVED — a process sitting in /var/… is reported under
# /private/var/… (measured 2026-07-26). A prefix match against the RAW path therefore sees NOTHING
# whenever any component of the worktree root is a symlink: the probe reads "no processes", the
# oracle abstains, and reap convicts a live worker — the exact false-dead this signal exists to
# remove, reintroduced one level down. Match BOTH the raw path and its `pwd -P` resolution; they are
# identical when nothing is symlinked, so this only ever ADDS a match and can never drop one.
#
# Seam: CC_BACKLOG_LSOF_BIN — UNSET ⇒ resolve one. SET, including set to EMPTY ⇒ honored verbatim, so
# `CC_BACKLOG_LSOF_BIN=` genuinely disables S1b. `${VAR:-}` cannot tell unset from set-empty, and a
# seam that cannot turn a thing OFF is not a seam (memory: claimed-outcome-vs-checked-outcome).
procs_cwd_under() {
  local dir="$1" bin out pdir
  pdir="$(cd "$dir" 2>/dev/null && pwd -P 2>/dev/null)" || pdir=""
  if [ -n "${CC_BACKLOG_LSOF_BIN+set}" ]; then
    bin="$CC_BACKLOG_LSOF_BIN"
  else
    bin=/usr/sbin/lsof
    [ -x "$bin" ] || bin="$(command -v lsof 2>/dev/null || true)"
  fi
  [ -n "$bin" ] && [ -x "$bin" ] || return 2      # no probe to run ⇒ UNRESOLVED, not "nobody there"
  if command -v timeout >/dev/null 2>&1; then
    out="$(timeout "${CC_BACKLOG_ORACLE_TIMEOUT_S:-10}" "$bin" -a -d cwd -w -F pn 2>/dev/null || true)"
  else
    out="$("$bin" -a -d cwd -w -F pn 2>/dev/null || true)"
  fi
  [ -n "$out" ] || return 2                       # timed out / crashed ⇒ UNRESOLVED (see the header)
  printf '%s\n' "$out" | awk -v d="$dir" -v pd="$pdir" '
    function under(n, base) { return base != "" && (n == base || index(n, base "/") == 1) }
    /^p/ { p = substr($0, 2); next }
    /^n/ { n = substr($0, 2); if (under(n, d) || under(n, pd)) print p }' | sort -u
  # EXPLICIT, not the pipeline's rc: under `set -o pipefail` a hiccup in awk/sort would otherwise
  # surface as rc 1 or 2 and be misread as a liveness verdict. The probe ran; that is what rc 0 means.
  return 0
}

# owned_wait <id> — is the item's WORKER in an OWNED WAIT (alive, merely slow) rather than DEAD?
#
# THREE-VALUED, matching claimer_live (oracle 1) and team-orphan-reaper.sh's `team_occupied`, which
# already models exactly these states for the same probe (team-orphan-reaper.sh:159-167):
#   rc 0  OWNED       positive evidence of life; a short reason is echoed.
#   rc 1  NOT-OWNED   every probe RAN and none of them found anyone. A real verdict — the only one
#                     the dead-worker path may act on.
#   rc 2  UNRESOLVED  a probe that COULD have seen the worker never ran (no lsof, seam disabled,
#                     timed out; or the worktree root itself is unreadable). A NON-VERDICT — a reason
#                     is echoed and the caller must ABSTAIN, exactly as it does for an unresolved
#                     claimer.
#
# WHY rc 2 EXISTS (2026-07-30, backlog 9efae9e3cfc1, found by the v2 verifier 2026-07-28). Oracle 1
# was made three-valued on 2026-07-26; oracle 2 never was, and it is the oracle that actually decides
# a DISPATCHED item — a dispatcher-keyed claim is proven-dead by construction (`kill -0` on a spent
# pid ⇒ rc 1, a REAL verdict), so `claimer_live` cannot abstain on its behalf and this function is the
# only thing standing between a live worker and `reopen`. With rc 2 folded into rc 1, every way the
# probe could FAIL TO RUN read as "the worktree is empty" ⇒ dead-worker ⇒ reopen ⇒ cc-dispatch's fire
# predicate ⇒ a second peer onto live work. The failure mode is worst exactly when it is most likely:
# under load a full-system lsof legitimately exceeds the 10s cap (measured 2026-07-28 at load ~11.8 —
# the same starvation that forced this suite's own fixture barrier up to 10s, tests/cc-backlog.bats),
# and load is when the most items are simultaneously past STALE_CLAIM_S. So one starved sweep reopens
# a BATCH of live workers, each reopen spawns a duplicate peer, and the duplicates raise the load that
# starves the next sweep. That is an amplifier, not an isolated false verdict.
#
# The direction is not a new judgement: the asymmetry at the top of this file already settles it — a
# false dead verdict SPAWNS a duplicate peer, a missed dead worker only STRANDS an item, visibly and
# recoverably. Fail-toward-KEEP is what that asymmetry means when the oracles go silent; the caller
# bounds it at UNRESOLVED_MAX_S and then BLOCKS out to a human, never reopens (memory:
# universalizing-a-mechanism-promotes-its-latent-leak — the lifecycle bound ships in the same change).
#
# WHY THIS EXISTS (2026-07-26, backlog 2d36e63d16a2). `claimer_live` alone cannot see a dispatched
# worker: cc-dispatch claims with `--by $SID` where SID is its OWN `$$` (cc-dispatch:58), then spawns
# the session and EXITS. Its pid is gone within seconds while the worker it spawned runs for hours —
# so past STALE_CLAIM_S, `claimer_live` is false BY CONSTRUCTION for every dispatched item and Rule A
# degrades to a pure idle-time verdict. Three items with live gates were blocked "dead-worker stall
# … not auto-completable" that way (02ba4e52389a / 761a546f939c / 6cab0ab3cb2f), which is not benign:
# a false dead verdict pulls the item OFF the auto-drive path and feeds dispatcher re-spawn. This is
# the same class as memory desk-wave-monitor-lead-idle-is-owned-wait (a lead's JSONL freeze during a
# wave is waiting on teammates, not a stall) and desk-verify-fresh-before-mutating-backlog (the claim
# `by` is the DISPATCHER, not the worker — check WORKTREE liveness). Dead-evidence must read whether
# a wait is OWNED, never merely how long it has been quiet.
#
# The claim's `by` cannot be fixed at the source instead: cc-dispatch has no worker identity to claim
# with (the spawned session's sid does not exist until it registers), so liveness has to be keyed on
# the worktree — the one durable handle that outlives the dispatcher.
#
# Signals (any ⇒ owned):
#   S1  a live process whose command line names the item's worktree — the full-suite gate
#       (bats-exec-suite/-file/-test), ship-land, a queued land-lock, a task-output wait loop.
#   S1b a live process whose CWD is at or below the worktree. S1 alone CANNOT see the worker itself
#       (measured 2026-07-26 against a live dispatched session, backlog b1b7a425e169): cc-wave-plan
#       fires `handoff-fire.sh --cwd $WTROOT/wt-<id>` (cc-wave-plan:287), so the worktree path lives
#       in the LAUNCHER's argv — and the launcher exits once the pane is up. The surviving `claude`
#       inherits only the cwd, so `pgrep -f "$wt"` returned 0 while SIX live processes (the session,
#       its shells, its crash watchdog, caffeinate) sat in that worktree. That is the SAME
#       one-level-down defect S1 was written to fix: the handle that names the worktree belongs to a
#       process that is already spent. Keying on cwd reads the worker directly.
#       NOT a bare-id `pgrep -f <id>`: a session's argv embeds its task brief, so the id alone also
#       matches the desk merely DISCUSSING the item (memory: effect-read-predicate-red-proof — a
#       positive is not execution). CWD is occupancy, not mention.
#       Matched by PREFIX, not equality: a worker that has cd'd into a subdirectory is still working
#       (exact-path lsof missed such a process in the same measurement).
#   S2  the machine-wide land lock held for THIS item's branch by a live holder. Distinct from S1,
#       not redundant: a land re-run from the shared checkout (or any other cwd) on branch wt-<id>
#       names no worktree path in its argv, yet is the most owned wait there is.
#
# Deliberately NOT filtered: reap's own process tree — by argv (S1) or by cwd (S1b). A process inside
# wt-<id> is evidence that work in wt-<id> is live — including a worker session that ran
# `cc-backlog reap` itself. The real hazard is an ORPHANED wait pinning an item forever, and the
# caller's OWNED_WAIT_MAX_S ceiling is what bounds that (a 6h "gate" is pathological, not owned). In
# production the reaper resolves cc-backlog through ~/.claude/bin → the shared checkout, so neither
# its argv nor its cwd carries a wt-<id> path at all.
#
# S2 lives in `land_lock_owner` below purely so this function has ONE exit point for "no signal
# found" — the point at which rc 1 and rc 2 are told apart. Inlined, each of S2's eight early
# `return 1`s would have needed the same three-valued decision repeated, which is how the two states
# got collapsed in the first place.
owned_wait() {
  local id="$1" venue="${2:-local}" wt; wt="$(item_worktree "$id")"

  # VENUE GATE — the same rule as claimer_live's, applied to the OTHER oracle, and it must be here
  # too or the pair disagrees about what the population is (memory:
  # sibling-auditors-must-share-the-state-model — two checks over one population diverged because
  # only ONE of them modelled "absent BY DESIGN", and the other convicted the subject for obeying
  # the design). A cloud worker has no local worktree BY CONSTRUCTION, so `[ -d "$wt" ] || return 1`
  # below would report the ordinary, truthful-for-local answer "no worktree, nobody home" — a real
  # rc 1 verdict — about an item whose worker was never going to have one. Distinct from the
  # missing-ROOT case immediately below, which is starvation of a convention that SHOULD be there;
  # here the convention correctly does not apply at all.
  if [ "$venue" != local ]; then
    printf 'worker runs off-box (venue %s) — the worktree occupancy oracle does not cover that venue' "$venue"
    return 2
  fi

  # ABSENCE vs STARVATION, at the root. A missing wt-<id> UNDER AN EXISTING ROOT is a real answer
  # (the item is worked in place, or its worktree was torn down) and stays rc 1 — that is what keeps
  # the dead-worker path reachable at all. A missing or unreadable ROOT is not an answer about any
  # item: the convention this oracle reads through is simply not there, so EVERY dispatched item
  # would report "no worktree" at once — precisely the batch false-dead this rc contract exists to
  # stop (a mistyped/unmounted CC_BACKLOG_WT_ROOT, or a launchd sweep with no HOME).
  local root="${CC_BACKLOG_WT_ROOT:-$HOME/Development/.worktrees}"
  if [ ! -d "$root" ]; then
    printf 'worktree root %s is absent — the occupancy oracle could not be asked at all' "$root"
    return 2
  fi
  [ -d "$wt" ] || return 1

  # S1 — live process tree in the worktree. `pgrep -f` excludes itself; one fork, only ever reached
  # for a claim already past the stale gate, so this costs nothing on a healthy ledger.
  local procs; procs="$(pgrep -f "$wt" 2>/dev/null | wc -l | tr -d ' ')"
  if [ -n "$procs" ] && [ "$procs" -gt 0 ] 2>/dev/null; then
    printf 'live process tree in %s (%s proc)' "$wt" "$procs"; return 0
  fi

  # S1b — live process whose CWD is at or below the worktree (see the header: this is the signal
  # that actually sees a dispatched worker; S1 sees only the spent launcher's argv). Its rc is
  # CAPTURED, not discarded: rc 2 means the probe never ran, and S1 answering "no" is no consolation
  # because S1 is structurally blind to the dispatched shape. Note the ordering — a starved S1b does
  # NOT short-circuit; S2 is an affirmative signal and still gets its chance to absolve.
  local cwdout cwdrc cwdprocs=0 starved=""
  cwdout="$(procs_cwd_under "$wt")"; cwdrc=$?
  [ -z "$cwdout" ] || cwdprocs="$(printf '%s\n' "$cwdout" | wc -l | tr -d ' ')"
  if [ "$cwdprocs" -gt 0 ] 2>/dev/null; then
    printf 'live process cwd in %s (%s proc)' "$wt" "$cwdprocs"; return 0
  fi
  [ "$cwdrc" -ne 2 ] || starved="the worktree occupancy probe (lsof) never ran or never answered for $wt"

  # S2 — land lock held for this item's branch.
  local locked; locked="$(land_lock_owner "$id" "$wt")" || locked=""
  if [ -n "$locked" ]; then printf '%s' "$locked"; return 0; fi

  # No signal found — and WHICH kind of "no" this is turns on whether every probe actually RAN.
  if [ -n "$starved" ]; then printf '%s' "$starved"; return 2; fi
  return 1
}

# land_lock_owner <id> <wt> → echoes a reason + rc 0 when the machine-wide land lock is held for THIS
# item's branch by a live holder; rc 1 (silent) otherwise. Distinct from S1, not redundant: a land
# re-run from the shared checkout (or any other cwd) on branch wt-<id> names no worktree path in its
# argv, yet is the most owned wait there is.
#
# The lock dir is a hash of the repo's common git dir, so ask land-lock.sh itself
# (`--print-lock-dir` is its documented pure read) from inside the worktree rather than duplicating
# the hash. Holder liveness uses the pid+lstart rule land-lock uses, because a dead holder's pid can
# be RECYCLED (memory: periodic-job-self-overlap).
#
# Deliberately NOT three-valued: an absent land-lock.sh or an unheld lock is a real "this item is not
# landing", not a starved probe — and S2 is an AFFIRMATIVE signal, so its silence never decides
# anything on its own. Only S1b's silence can be mistaken for evidence, which is why only S1b carries
# the abstention.
land_lock_owner() {
  local id="$1" wt="$2"
  local ll="$wt/scripts/land-lock.sh"
  [ -x "$ll" ] || return 1
  local lockdir; lockdir="$(cd "$wt" && "$ll" --print-lock-dir 2>/dev/null)" || return 1
  [ -n "$lockdir" ] || return 1
  local lock="$lockdir/lock.d"
  [ "$(cat "$lock/branch" 2>/dev/null)" = "wt-$id" ] || return 1
  local holder; holder="$(cat "$lock/pid" 2>/dev/null)"
  [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null || return 1
  local rec_lstart cur_lstart
  rec_lstart="$(cat "$lock/lstart" 2>/dev/null || true)"
  cur_lstart="$(ps -o lstart= -p "$holder" 2>/dev/null || true)"
  [ -z "$rec_lstart" ] || [ "$rec_lstart" = "$cur_lstart" ] || return 1
  printf 'land lock held for wt-%s by live pid %s' "$id" "$holder"
}

# ── the reap DECISION JOURNAL (backlog ab52bfd8c958) ─────────────────────────────────────────────
# idl_verdict <id> <keep|block|reopen> <reason> <acted true|false> <by> <ageS> <claims> <fast>
#             <claimer_rc|-> <worktree|-> <detail>
#
# ONE append-only IDL record per verdict — the retained EVIDENCE behind every reap decision. Until
# now a verdict survived only as (a) a line of stdout, which the caller may or may not keep — under
# `cc-reaper --reap` it lands in ~/.claude/logs/cc-reaper.log, rotated by SIZE, and under any other
# caller (a hand-run sweep, a future one) it is simply gone — and (b) for a block, the prose `needs`
# string, which names the REMEDY but not the oracles that produced the verdict. So a `blocked` item
# the operator meets an hour later answered none of the only questions that matter: which oracle
# spoke, what did it say, how stale was the claim, how many workers had already been fired at it.
# That is the undiagnosable case this closes, and it is the worst one precisely for `block`, whose
# whole point is to leave the wave and wait for a human.
#
# SHAPE — deliberately the {actor, action} row cc-dispatch's `idl_decision` writes (same ledger
# family, same consumers), NOT the {hook, disposition} hook row. idl-abstain-alarm.sh selects exactly
# on `.hook` + `.disposition`, so a hook-shaped row would silently enroll reap in a PAGING population
# against whose blind/dormant reason vocabulary it had never been calibrated — manufacturing 3am
# pages as a side effect of adding a journal (memory: alarm-polarity-and-attention-budget).
#
# THAT CALIBRATION IS NOW DONE, and it did NOT change this shape (backlog 420b9cb2166c). The alarm
# PROJECTS these rows at the READER: it classifies the four `keep` reasons below — `claimer-live` and
# `owned-wait` DORMANT (an oracle answered), `claimer-unresolved` and `worktree-unresolved` BLIND
# (rc 2, no answer at all) — and pages only on 100%-blind. Projecting at the reader rather than
# hook-shaping here is what keeps the enrollment to ONE consumer: `.hook` + `.disposition` are also
# read by cc-audit, cc-digest, cc-discover, desk-invariant, desk-recycle-invariant and subagent-stop,
# and adding those keys would enroll reap in all of them at once. So this row stays actor-only, and
# tests/cc-backlog.bats still pins it that way. ⚠️ A NEW `keep` REASON MUST BE CLASSIFIED THERE — an
# unclassified one defaults to DORMANT and can never page; `idl-abstain-alarm.sh --vocab-lint` fails
# the suite if this function's keep-vocabulary and that classification ever disagree.
#
# ORACLE PROVENANCE — `claimer_rc` and `worktree` are JSON `null` when the oracle was NOT CONSULTED,
# never a carried-over value. `clrc` is FUNCTION-scoped and assigned only inside the stale branch, so
# at the thrash site it still holds the PREVIOUS item's answer; journaling that would fabricate
# evidence about an item no oracle ever looked at (memory: synthesis-loses-provenance). Read them as:
#   claimer_rc  null = never asked · 0 = LIVE · 1 = proven not-live · 2 = asked, NO ANSWER
#   worktree    null = never asked · "none" = probe answered, nobody there · any other string = the
#               probe's own words, either the owned wait it found or why it could not look
# The three-valued oracles are the whole basis of the KEEP/REOPEN asymmetry, so an evidence row that
# collapsed "never asked" into "no answer" would misdiagnose the exact bug class it exists to serve.
#
# `acted` is the transition, not the verdict: false on every `keep` BY CONSTRUCTION (a keep directs
# no transition), and on a `block`/`reopen` ONLY when cmd_transition REFUSED it. That row is new
# evidence in itself — a refused transition contributed nothing to stdout and nothing to the
# counters, and stdout is the only stream the production caller keeps (cc-reaper runs `reap
# 2>/dev/null`, discarding the guard's own prose). The summary then reads "0 reopened, 0 blocked",
# which does not merely omit that verdict — it asserts that nothing happened.
#
# BEST-EFFORT, BOUNDED BLAST RADIUS: a side-car must fail no wider than itself (memory:
# addon-failure-exceeds-its-blast-radius) — a write failure never changes reap's transitions, its
# stdout verdicts, its counters or its exit code. It is NOT silent, though: failures are counted and
# named in the summary line, because a silently-dropped evidence row is the precise defect this
# journal exists to fix (memory: claimed-outcome-vs-checked-outcome).
#
# VOLUME: one row per verdict per sweep, undamped. A long owned wait re-KEEPs every sweep (~10 rows/h
# at the ~6-min cadence — the shape already in the reaper log). Damping it would be wrong: the
# SEQUENCE of KEEPs is what diagnoses a wedge, and the IDL is size-rotated.
idl_verdict() {
  # DRY-RUN GATE, once, here rather than at nine call sites: `--dry-run` classifies and writes
  # NOTHING, and a journal is a write. Gating centrally makes that contract structural instead of a
  # rule nine future edits have to remember. `dry` is cmd_reap's local, visible by dynamic scope;
  # defaulted so a stray caller cannot trip `set -u`.
  if [ "${dry:-0}" = 1 ]; then return 0; fi
  local id="$1" verdict="$2" reason="$3" acted="$4" by="$5" ageS="$6" claims="$7" fast="$8" \
        clrc="$9" wt="${10}" detail="${11}"
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  # `2>/dev/null` FIRST: a failed `>>` open is reported by the shell to whatever stderr is current at
  # that point, so the ordering decides whether an unwritable IDL leaks noise into reap's stderr.
  jq -cn --arg ts "$(now_iso)" --arg id "$id" --arg verdict "$verdict" --arg reason "$reason" \
     --argjson acted "$acted" --arg by "$by" --argjson age "$ageS" --argjson claims "$claims" \
     --argjson fast "$fast" --arg clrc "$clrc" --arg wt "$wt" --arg detail "$detail" \
     '{ts:$ts, actor:"cc-backlog-reap", action:"verdict", id:$id, verdict:$verdict, reason:$reason,
       acted:$acted, claim_by:$by, claim_age_s:$age, attempts:$claims, fast_fail:$fast,
       claimer_rc:(if $clrc=="-" then null else ($clrc|tonumber) end),
       worktree:(if $wt=="-" then null else $wt end),
       detail:$detail}' 2>/dev/null >> "$IDL" || journal_fail=$((journal_fail + 1))
  return 0
}

# cmd_reap — the stale-claim maintenance sweep (see the REAP header block). Append-only, idempotent,
# and safe to run every cc-reaper sweep. Terminal (done) and already-blocked items are never touched.
# --dry-run classifies + prints WOULD-* and writes NOTHING.
#
# Thresholds (all env-tunable; defaults calibrated from 75 real claim→done items — p50 33min / p90
# 55min, so a live worker under p90 is never double-dispatched by the 90-min stale gate):
#   CC_BACKLOG_STALE_CLAIM_S    (5400)  claimed idle past this ⇒ dead-worker candidate → reopen
#   CC_BACKLOG_MAX_THRASH       (2)     >= this many fast claim→reopen cycles ⇒ thrash → block
#   CC_BACKLOG_MAX_ATTEMPTS     (3)     >= this many total dispatch claims on a still-stale item ⇒ block
#   CC_BACKLOG_THRASH_WINDOW_S  (90)    a claim→reopen within this gap counts as one fast-fail cycle
#   CC_BACKLOG_OWNED_WAIT_MAX_S (21600) ceiling past which even a live worktree wait stops absolving
#                                       — an orphaned watcher must not pin an item forever (6h; a
#                                       full ~1630-test suite is 25-40min nominal, hours under the
#                                       load-20 contention that produced the false verdicts)
#   CC_BACKLOG_UNRESOLVED_MAX_S (=OWNED_WAIT_MAX_S) ceiling past which an UNRESOLVED claimer (rc 2 —
#                                       registry absent/wedged) stops absolving and is BLOCKED out to
#                                       a human. Abstention must be bounded for the same reason the
#                                       owned wait is: a permanently-broken registry would otherwise
#                                       pin every session-shaped claim as "undecidable" forever. Past
#                                       the ceiling the item still never REOPENS — an unanswered
#                                       probe is not proof of death at any age.
#   CC_BACKLOG_LIVE_CLAIM_MAX_S (=OWNED_WAIT_MAX_S) ceiling past which a PROVABLY LIVE claimer stops
#                                       absolving and is BLOCKED out to a human (never reopened — it
#                                       is alive). Needed only once claims are WORKER-keyed, which
#                                       turns "claimer LIVE" from an unreachable branch into the
#                                       normal one; see the Rule A body.
#   CC_BACKLOG_WT_ROOT          (~/Development/.worktrees)  dispatch worktree parent (see owned_wait)
#   CC_BACKLOG_NOW              (now)   epoch "now" seam (deterministic age/window math in tests)
#   CC_BACKLOG_IDL              (~/.claude/autonomy/idl.jsonl)  the verdict journal (see idl_verdict)
cmd_reap() {
  local dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1 ;;
      *) printf 'cc-backlog reap: unknown arg %s\n' "$1" >&2; return 2 ;;
    esac
    shift
  done
  ensure_file
  local stale="${CC_BACKLOG_STALE_CLAIM_S:-5400}"
  local maxthrash="${CC_BACKLOG_MAX_THRASH:-2}"
  local maxattempts="${CC_BACKLOG_MAX_ATTEMPTS:-3}"
  local window="${CC_BACKLOG_THRASH_WINDOW_S:-90}"
  local ownedmax="${CC_BACKLOG_OWNED_WAIT_MAX_S:-21600}"
  local unresolvedmax="${CC_BACKLOG_UNRESOLVED_MAX_S:-$ownedmax}"
  local liveclaimmax="${CC_BACKLOG_LIVE_CLAIM_MAX_S:-$ownedmax}"
  local now="${CC_BACKLOG_NOW:-$(date +%s)}"

  # Per non-terminal id → TSV [id, status, claimBy, claimAgeS, totalClaims, fastFailCycles].
  # status = last-event fold; claimBy/claimTs from the LAST claim (not our reap-reopen); fastFail =
  # adjacent claim→reopen pairs within $window (the intervening-done/block case can't be adjacent).
  local analysis
  analysis="$(valid_records | jq -s -r --argjson now "$now" --argjson window "$window" '
    def st($e): if $e=="done" then "done" elif $e=="block" then "blocked"
      elif $e=="unblock" then "open" elif $e=="claim" then "claimed"
      elif $e=="reopen" then "open" else "open" end;
    group_by(.id)
    | map(
        (sort_by(.ts)) as $g
        # Thrash window resets at the LATEST block/unblock record: fastFail counts only claim→reopen
        # pairs occurring AFTER it. Without this, a deliberate `unblock` (status→open) is re-blocked by
        # the very next reap on pre-unblock history that still folds ≥ MAX_THRASH — the dispatcher-
        # starvation bug (unblock never survives cc-reaper). A genuinely NEW post-unblock thrash still
        # blocks (the counter only ever narrows here, never widens what the blocker acts on). Default
        # cut = -1 (no block/unblock in trail) preserves the original whole-trail fold.
        | ([ range(0; ($g|length)) as $j
             | select($g[$j].event=="unblock" or $g[$j].event=="block") | $j ] | last // -1) as $cut
        | ($g[-1]) as $last
        | { id: $last.id,
            status: st($last.event),
            claimBy: ([$g[] | select(.event=="claim")] | last | .by // ""),
            claimTs: ([$g[] | select(.event=="claim")] | last | .ts // ""),
            # VENUE rides the LAST claim, exactly like claimBy/claimTs — it is a property of the
            # worker that currently holds the item, so a `reclaim` re-key carries it too. Absent ⇒
            # "local", which is what makes this change inert for every pre-existing record.
            venue: ([$g[] | select(.event=="claim")] | last | .venue // "local"),
            # totalClaims counts DISPATCH ATTEMPTS — how many times a worker was fired at this item —
            # so a worker re-keying its own claim (reclaim:true) must not increment it. Counting them
            # would halve the MAX_ATTEMPTS bound the moment worker-keying went live: one dispatch
            # would post two claim records, and the "3 attempts ⇒ block" ceiling would fire after 1½
            # real attempts (memory: exoneration-bound-must-fit-what-it-bounds). claimBy/claimTs
            # deliberately DO take the re-key — that is the whole point: the latest claim names the
            # live worker, and the age clock starts when the worker actually took the work.
            totalClaims: ([$g[] | select(.event=="claim" and (.reclaim // false) != true)] | length),
            # A SELF-RELEASE IS NOT A THRASH CYCLE. selfRelease marks a reopen the CLAIMER issued
            # because it could not START the work — cc-dispatch rolling back its own uncommenced
            # claim after the fire was refused (capacity gate rc 9), the brief failed to compose, or
            # the worktree could not be provisioned. Those are facts about THE MACHINE AT THAT
            # INSTANT, and every one of them is a condition whose producer explicitly asks the caller
            # to retry ("Shed load first … then re-fire"). Counting them convicts the ITEM of a
            # failure no worker was ever present for, and the rule-B verdict is DURABLE: blocked is
            # the operator-only state, which cc-dispatch excludes from the wave by construction, so
            # one transient load spike permanently removes work from the autonomous queue.
            #
            # Measured 2026-08-07 before the flag existed: 228 items sat blocked as "persistent
            # thrash — the worker cannot land"; 475 counted pairs, EVERY one authored by the same
            # identity on both sides (the dispatcher self-releasing), and 182 of the 228 had never
            # held a claim for even the 90 s window — no worker had run at all. In the same 2 h the
            # live journal carried 36 spawn-rc-9 reopens against 5 successful fires. That is the
            # section-0 bootstrap cycle with its engine named, and it never touched the landing gate.
            #
            # Excluded rather than counted-and-forgiven so the exclusion is EVIDENCE-BASED: only a
            # reopen that positively asserts selfRelease (closed-set, claimer-authenticated at the
            # CLI) is skipped. An unflagged fast pair still counts, so a genuine thrash — a worker
            # that really does take the item and bounce off it — still blocks exactly as before.
            #
            # NOTE FOR EDITORS: this comment lives INSIDE a single-quoted jq program. An apostrophe
            # here silently ends the quote and hands the rest of the program to the shell (caught in
            # development: the first draft wrote "rule B-apostrophe-s" and the fold collapsed to a
            # jq compile error whose reap then scanned 5 items and blocked none — a green-looking
            # no-op). Keep this block apostrophe-free and backtick-free.
            fastFail: ([ range(0; ($g|length)-1) as $i
                | select($i > $cut
                         and $g[$i].event=="claim" and $g[$i+1].event=="reopen"
                         and (($g[$i+1].selfRelease // false) != true)
                         and (($g[$i+1].ts|fromdateiso8601) - ($g[$i].ts|fromdateiso8601)) <= $window) ]
              | length),
            # Counted for the JOURNAL only — never a block predicate. A self-release says nothing
            # about the item, but a large count says a great deal about the machine, and a number
            # nobody can see is a number nobody acts on.
            selfRel: ([ range(0; ($g|length)-1) as $i
                | select($i > $cut
                         and $g[$i].event=="claim" and $g[$i+1].event=="reopen"
                         and (($g[$i+1].selfRelease // false) == true)
                         and (($g[$i+1].ts|fromdateiso8601) - ($g[$i].ts|fromdateiso8601)) <= $window) ]
              | length) }
        | .claimAgeS = (if .claimTs=="" then -1 else ($now - (.claimTs|fromdateiso8601)) end)
      )
    | .[]
    | select(.status != "done" and .status != "blocked")
    | [.id, .status, .claimBy, (.claimAgeS|floor|tostring), (.totalClaims|tostring), (.fastFail|tostring), .venue, (.selfRel|tostring)]
    | join("\u001f")
  ')"

  # Split on US (\037), NOT tab: an open item with no claim has an EMPTY claimBy field, and bash
  # `read` COALESCES consecutive whitespace-IFS chars (tab included) — two adjacent tabs would drop
  # the empty field and shift every later column left (fast → empty → "integer expression" error).
  # A non-whitespace IFS preserves empty fields positionally.
  # `venue` is APPENDED, never inserted: a new column in the middle would shift every later field
  # and silently re-point the numeric ones. Absent (a pre-venue producer) ⇒ the read leaves it empty
  # ⇒ normalised to "local" in the body, which is the same default the jq fold already applies.
  local reopened=0 blocked=0 scanned=0 journal_fail=0 id status by ageS claims fast venue selfrel clrc=0
  local selfrel_total=0 selfrel_items=0
  while IFS=$'\037' read -r id status by ageS claims fast venue selfrel; do
    [ -n "$id" ] || continue
    [ -n "$venue" ] || venue=local
    # APPENDED column ⇒ a pre-selfRel producer leaves it empty; normalise exactly as venue does, so
    # the arithmetic below can never see "" (memory: negative-array-slice-empties-the-diagnostic —
    # a field that expands to nothing must be given its value, not left to an implicit one).
    [ -n "$selfrel" ] || selfrel=0
    scanned=$((scanned + 1))
    if [ "$selfrel" -gt 0 ]; then
      selfrel_total=$((selfrel_total + selfrel)); selfrel_items=$((selfrel_items + 1))
    fi
    # Rule B (priority): persistent thrash → block (out of the wave, surfaced to the desk).
    if [ "$fast" -ge "$maxthrash" ]; then
      local bmsg="persistent thrash — ${fast} fast claim→reopen cycle(s) (spawn-fail / land-conflict rebase-exit-5); the worker cannot land. Investigate the root cause, then \`cc-backlog unblock ${id}\`."
      if [ "$dry" = 1 ]; then
        printf 'cc-backlog reap: WOULD-BLOCK %s [thrash x%s]\n' "$id" "$fast"
      elif cmd_transition block "$id" --needs "$bmsg" --by cc-backlog-reap >/dev/null; then
        blocked=$((blocked + 1)); printf 'cc-backlog reap: BLOCK %s [thrash x%s]\n' "$id" "$fast"
        # Both oracles are `-` (never asked): rule B fires on the TRAIL SHAPE alone, before any
        # liveness probe runs. Passing $clrc here would journal the PREVIOUS item's answer.
        idl_verdict "$id" block thrash true "$by" "$ageS" "$claims" "$fast" - - "$bmsg"
      else
        idl_verdict "$id" block thrash false "$by" "$ageS" "$claims" "$fast" - - "$bmsg"
      fi
      continue
    fi
    # Rule A: dead-worker stale claim → reopen (bounded → block after MAX_ATTEMPTS).
    if [ "$status" = claimed ] && [ "$ageS" -gt "$stale" ]; then
      # rc is THREE-valued (see claimer_live): 0 LIVE, 1 proven NOT-LIVE, 2 UNRESOLVED (non-verdict).
      # Captured, not tested inline, because only rc 1 may ever reach the reopen path.
      claimer_live "$by" "$venue"; clrc=$?
      if [ "$clrc" -eq 0 ] && [ "$ageS" -le "$liveclaimmax" ]; then
        # Printed in BOTH modes, like the owned-wait and UNRESOLVED keeps below and for the same
        # reason — it used to be dry-run-only, which was defensible while this branch was ~unreachable
        # for dispatched items. Worker-keying makes it the NORMAL absolve, so a silent one would make
        # the entire mechanism invisible in operation: if the identity ever stopped resolving (a host
        # derivation drifting apart from the writer's, say), reap would quietly fall through to the
        # dead-worker paths and nothing would show that oracle 1 had stopped answering LIVE (memory:
        # feature-durability-mechanism-not-memory — an inert mechanism must be loud, not silent).
        printf 'cc-backlog reap: KEEP %s [claimer %s LIVE; claimed %ss]\n' "$id" "$by" "$ageS"
        idl_verdict "$id" keep claimer-live false "$by" "$ageS" "$claims" "$fast" "$clrc" - \
          "claimer ${by:-<none>} is LIVE (claimed ${ageS}s, under the ${liveclaimmax}s ceiling)"
        continue
      fi
      # A LIVE claimer past LIVE_CLAIM_MAX_S is a WEDGED WORKER — the mirror of the wedged owned wait
      # below, and it BLOCKS rather than falling through to the dead-worker paths. Before worker-keyed
      # claims this branch was unreachable in practice (a dispatched claim's `by` was the dispatcher's
      # spent pid, so clrc was ~never 0) and "live ⇒ keep" needed no ceiling; worker-keying makes it
      # the NORMAL path, which promotes that missing bound from a curiosity to a fleet property —
      # e.g. a pane that came up and never engaged (the cold-worktree auto-submit race) holds a live
      # pid and would pin its item forever, where V1's owned-wait path would at least have surfaced it
      # at OWNED_WAIT_MAX_S. Same reasoning as the wedge below: never reopened (the worker is NOT
      # dead), never silently kept — escalated to a human, named for what it is.
      if [ "$clrc" -eq 0 ]; then
        local lmsg="wedged live worker past the ${liveclaimmax}s ceiling — claimer ${by} is still LIVE after ${claims} dispatch attempt(s) (claimed ${ageS}s) but the item never completed. NOT reopened: the worker is alive, so a reopen would fire a SECOND peer onto live work. Find what it is stuck on (or close the pane), then \`cc-backlog unblock ${id}\`."
        if [ "$dry" = 1 ]; then
          printf 'cc-backlog reap: WOULD-BLOCK %s [wedged live worker — %s, claimed %ss]\n' "$id" "$by" "$ageS"
        elif cmd_transition block "$id" --needs "$lmsg" --by cc-backlog-reap >/dev/null; then
          blocked=$((blocked + 1))
          printf 'cc-backlog reap: BLOCK %s [wedged live worker — %s, claimed %ss]\n' "$id" "$by" "$ageS"
          idl_verdict "$id" block wedged-live-worker true "$by" "$ageS" "$claims" "$fast" "$clrc" - "$lmsg"
        else
          idl_verdict "$id" block wedged-live-worker false "$by" "$ageS" "$claims" "$fast" "$clrc" - "$lmsg"
        fi
        continue
      fi
      # RE-VERIFY before any dead verdict: the claim's `by` is the dispatcher's spent pid, so
      # claimer_live cannot see the worker (see owned_wait). Ask the WORKTREE whether the wait is
      # OWNED. Printed in BOTH modes on purpose — a silent absolve is indistinguishable from an
      # inert oracle (memory: feature-durability-mechanism-not-memory).
      # rc CAPTURED for the same reason clrc is (owned_wait is three-valued too): rc 2 means the
      # occupancy probe never ran, which must reach the abstain path below and never the reopen path.
      # `starved` is kept SEPARATE from `owned` so every existing `-n "$owned"` test below keeps
      # meaning "positive evidence of life" exactly as before.
      local owned owrc starved=""
      owned="$(owned_wait "$id" "$venue")"; owrc=$?
      if [ "$owrc" -eq 2 ]; then starved="$owned"; owned=""; fi
      if [ -n "$owned" ] && [ "$ageS" -le "$ownedmax" ]; then
        printf 'cc-backlog reap: KEEP %s [owned wait — %s; claimed %ss]\n' "$id" "$owned" "$ageS"
        idl_verdict "$id" keep owned-wait false "$by" "$ageS" "$claims" "$fast" "$clrc" "$owned" \
          "owned wait — ${owned} (claimed ${ageS}s, under the ${ownedmax}s ceiling)"
        continue
      fi
      # ABSTAIN on a non-verdict. Every oracle has now spoken and none of them said "dead": the
      # claimer probe gave NO ANSWER (rc 2) and the worktree shows nothing. That is ignorance, not
      # evidence — and the transition it would otherwise feed is `reopen`, i.e. cc-dispatch's fire
      # predicate. Printed in BOTH modes: a silent abstain is indistinguishable from an inert oracle
      # (memory: feature-durability-mechanism-not-memory).
      if [ -z "$owned" ] && [ "$clrc" -eq 2 ] && [ "$ageS" -le "$unresolvedmax" ]; then
        printf 'cc-backlog reap: KEEP %s [claimer UNRESOLVED — %s; no answer is not proof of death, abstaining; claimed %ss]\n' \
          "$id" "${by:-<none>}" "$ageS"
        # worktree = "none": the occupancy probe RAN and found nobody. That is an answer, and it is
        # what distinguishes this abstention (one oracle silent) from the starved one below (both).
        idl_verdict "$id" keep claimer-unresolved false "$by" "$ageS" "$claims" "$fast" "$clrc" none \
          "claimer ${by:-<none>} UNRESOLVED (registry absent/wedged/unparseable) and the worktree probe found nobody — abstaining; no answer is not proof of death (claimed ${ageS}s, under the ${unresolvedmax}s ceiling)"
        continue
      fi
      # TOTAL ORACLE STARVATION — the same abstention, one oracle down. Here the claimer DID answer
      # ("not live"), but for a dispatched item that answer is about the DISPATCHER's spent pid and
      # says nothing about the worker; the only oracle that can see the worker is the occupancy probe,
      # and it never ran. So no oracle has produced evidence about the WORKER, and the transition on
      # offer is `reopen` — cc-dispatch's fire predicate. Abstain, bounded by the same ceiling as an
      # unresolved claimer, and say which probe went dark: a silent abstain is indistinguishable from
      # an inert oracle (memory: feature-durability-mechanism-not-memory).
      if [ -n "$starved" ] && [ "$ageS" -le "$unresolvedmax" ]; then
        printf 'cc-backlog reap: KEEP %s [worktree oracle UNRESOLVED — %s; no answer is not proof of death, abstaining; claimed %ss]\n' \
          "$id" "$starved" "$ageS"
        idl_verdict "$id" keep worktree-unresolved false "$by" "$ageS" "$claims" "$fast" "$clrc" "$starved" \
          "worktree oracle UNRESOLVED — ${starved}; the claimer read not-live but for a dispatched item that is the DISPATCHER's spent pid, so no oracle has spoken about the WORKER — abstaining (claimed ${ageS}s, under the ${unresolvedmax}s ceiling)"
        continue
      fi
      # A WEDGED owned wait (live worktree, but past the ceiling) BLOCKS regardless of the attempt
      # count — it never reopens. Reopening would fire a second worker into a worktree the first one
      # still occupies, which is the very double-dispatch this oracle exists to prevent; and the
      # verdict is a wedge to diagnose, not a death to re-run. An UNRESOLVED claimer past its own
      # ceiling blocks for the mirror-image reason: still not proof of death, so still never reopened
      # — but the abstention itself has to end somewhere, and it ends at a human.
      local why="stall, $claims attempts"
      # rtoken/wtev shadow why/smsg for the JOURNAL: `why` is prose that has already been reworded
      # once, and a reason field consumers group by must be a STABLE token. wtev carries the
      # worktree oracle's own words, or "none" when it answered and found nobody.
      local rtoken="dead-worker-stall" wtev="none"
      if [ "$claims" -ge "$maxattempts" ] || [ -n "$owned" ] || [ "$clrc" -eq 2 ] || [ -n "$starved" ]; then
        local smsg="dead-worker stall after ${claims} dispatch attempt(s) (idle ${ageS}s) — not auto-completable. Investigate, then \`cc-backlog unblock ${id}\`."
        if [ -n "$owned" ]; then
          why="wedged owned wait"
          rtoken="wedged-owned-wait"; wtev="$owned"
          smsg="wedged owned wait past the ${ownedmax}s ceiling — ${owned} — after ${claims} dispatch attempt(s) (claimed ${ageS}s). The worker is NOT dead and its worktree is still occupied, so this was NOT reopened: find what the wait is blocked on, then \`cc-backlog unblock ${id}\`."
        elif [ -n "$starved" ]; then
          why="unresolvable worktree oracle"
          rtoken="unresolvable-worktree-oracle"; wtev="$starved"
          smsg="the worktree occupancy oracle could not be RESOLVED past the ${unresolvedmax}s ceiling — ${starved} — after ${claims} dispatch attempt(s) (claimed ${ageS}s). The claimer read not-live, but for a dispatched item that is the DISPATCHER's spent pid, so nothing here is evidence about the worker. NOT reopened: reopening on a probe that never ran would fire a second peer at possibly-live work. Restore the probe (lsof / CC_BACKLOG_WT_ROOT) or establish by hand whether the worker is alive, then \`cc-backlog unblock ${id}\`."
        elif [ "$clrc" -eq 2 ]; then
          why="unresolvable claimer"
          rtoken="unresolvable-claimer"
          smsg="claimer ${by:-<none>} could not be RESOLVED past the ${unresolvedmax}s ceiling — the liveness registry gave no answer (absent, wedged, or unparseable) and the worktree shows no live work, after ${claims} dispatch attempt(s) (claimed ${ageS}s). NOT reopened: an unanswered probe is a non-verdict, never proof of death, and reopening would fire a second worker at possibly-live work. Establish whether the worker is alive (or repair the registry), then \`cc-backlog unblock ${id}\`."
        fi
        if [ "$dry" = 1 ]; then
          printf 'cc-backlog reap: WOULD-BLOCK %s [%s]\n' "$id" "$why"
        elif cmd_transition block "$id" --needs "$smsg" --by cc-backlog-reap >/dev/null; then
          blocked=$((blocked + 1)); printf 'cc-backlog reap: BLOCK %s [%s]\n' "$id" "$why"
          idl_verdict "$id" block "$rtoken" true "$by" "$ageS" "$claims" "$fast" "$clrc" "$wtev" "$smsg"
        else
          idl_verdict "$id" block "$rtoken" false "$by" "$ageS" "$claims" "$fast" "$clrc" "$wtev" "$smsg"
        fi
      elif [ "$dry" = 1 ]; then
        printf 'cc-backlog reap: WOULD-REOPEN %s [dead-worker, claimed %ss, %s attempt(s)]\n' "$id" "$ageS" "$claims"
      elif cmd_transition reopen "$id" --by cc-backlog-reap >/dev/null; then
        reopened=$((reopened + 1)); printf 'cc-backlog reap: REOPEN %s [dead-worker, claimed %ss]\n' "$id" "$ageS"
        # The one verdict that ACTS on a death, so it is the one whose evidence must be recoverable:
        # a false dead verdict fires a duplicate peer onto live work (a60d62a215f1 → 6488617), and
        # after the fact the only way to tell that apart from a genuine reap is which oracle said what.
        idl_verdict "$id" reopen dead-worker true "$by" "$ageS" "$claims" "$fast" "$clrc" none \
          "dead-worker reopen — claimer proven not-live and the worktree probe answered with nobody there (claimed ${ageS}s, ${claims} dispatch attempt(s), under the ${maxattempts}-attempt bound)"
      else
        idl_verdict "$id" reopen dead-worker false "$by" "$ageS" "$claims" "$fast" "$clrc" none \
          "dead-worker reopen REFUSED by the ledger (claimed ${ageS}s, ${claims} dispatch attempt(s))"
      fi
    fi
  done <<< "$analysis"

  # SELF-RELEASES ARE REPORTED, NEVER ACTED ON. They are excluded from the block predicate because
  # they are evidence about the machine and not about the item — but a number nobody can see is a
  # number nobody acts on, and the machine-side condition they measure (a fire the capacity gate
  # keeps refusing) is real work for the desk even though it is not this item's fault. Printed in
  # BOTH modes for the same reason every abstention above is: a silent exclusion is indistinguishable
  # from an inert one (memory: feature-durability-mechanism-not-memory).
  if [ "$selfrel_total" -gt 0 ]; then
    printf 'cc-backlog reap: %s self-release(s) across %s item(s) NOT counted as thrash — the dispatcher could not FIRE them (capacity/compose/worktree); that is a machine condition, not the items\n' \
      "$selfrel_total" "$selfrel_items"
  fi
  if [ "$dry" = 1 ]; then
    printf 'cc-backlog reap (dry-run): %s non-terminal item(s) scanned — no writes\n' "$scanned"
  else
    printf 'cc-backlog reap: %s reopened, %s blocked (%s non-terminal scanned)\n' "$reopened" "$blocked" "$scanned"
    # A dropped evidence row is the exact defect the journal exists to fix, so its failure is never
    # `|| true`-silent (memory: claimed-outcome-vs-checked-outcome). An `if` block, NOT a trailing
    # `[ … ] && printf`: that would make the FALSE test the function's exit status on every clean
    # sweep and hand rc 1 to cc-reaper (memory: blanket-remedy-inverts-guards).
    if [ "$journal_fail" -gt 0 ]; then
      printf 'cc-backlog reap: WARNING — %s verdict(s) could NOT be journalled to %s; those decisions have no retained evidence\n' \
        "$journal_fail" "$IDL" >&2
    fi
  fi
}

# ── S5 KICK-ON-WRITE (AUTONOMY_DISPATCH_V2 §3 S5) ────────────────────────────────────────────────
# `add` is the ONLY moment new work enters the ledger, so the writer kicking one decision pass is
# what removes the average wait from the 5-minute decision bound (§7 A2). The launchd timer
# (StartInterval 300) is the BACKSTOP and it, not this, is what GUARANTEES the bound — which is
# precisely why every failure mode here is silent. A kick that never fires costs latency the
# backstop already covers; a kick that is noisy, slow, or fd-holding BREAKS ITS CALLER. `cc-discover`
# runs `id="$(cc-backlog add …)"` in a loop, so a background child inheriting the caller's stdout
# keeps the command substitution's pipe OPEN and hangs the whole discovery pass — the child is
# therefore spawned inside `( … & )` (reparented immediately, never waited on) with all three fds
# redirected. `add`'s exit code, its stdout (exactly the id — callers parse it) and its ledger
# record are untouched on every path below, including every failure path.
#
# ORDER IS LOAD-BEARING: debounce-check → stamp the marker → spawn. Stamping BEFORE the spawn means
# a kick whose binary is missing or which exits non-zero still consumes the debounce window (the
# backstop covers the lost pass), and it is what makes "the kick was attempted" observable at all.
# An unwritable marker degrades to no-debounce rather than to no-kick: silently disabling the
# mechanism is the failure class this whole rebuild exists to end (F7), and cc-dispatch's own
# singleton (S6, skip-not-queue) bounds the blast radius of a burst that slips through.
kick_bin() {
  local b="${CC_BACKLOG_KICK_BIN:-}"
  [ -n "$b" ] || b="$(command -v cc-dispatch 2>/dev/null || true)"
  [ -n "$b" ] || b="$HOME/.claude/bin/cc-dispatch"
  printf '%s' "$b"
}

dispatch_kick() {
  local marker deb now marker_ts bin
  [ "${CC_BACKLOG_KICK:-on}" = "off" ] && return 0            # kill switch (§6)
  deb="${CC_DISPATCH_KICK_DEBOUNCE_S:-30}"
  case "$deb" in ''|*[!0-9]*) deb=30 ;; esac
  marker="${CC_BACKLOG_KICK_MARKER:-$HOME/.claude/autonomy/.dispatch-kick}"
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac            # no clock ⇒ no kick; backstop covers
  marker_ts="$(stat -f %m "$marker" 2>/dev/null || true)"     # BSD stat; absent ⇒ 0 ⇒ never debounced
  case "${marker_ts:-}" in ''|*[!0-9]*) marker_ts=0 ;; esac
  [ "$((now - marker_ts))" -lt "$deb" ] && return 0           # a burst of adds collapses to one pass
  mkdir -p "$(dirname "$marker")" 2>/dev/null || true
  : > "$marker" 2>/dev/null || true
  bin="$(kick_bin)"
  [ -x "$bin" ] || return 0
  ( "$bin" --decide >/dev/null 2>&1 </dev/null & ) >/dev/null 2>&1 || true
  return 0
}

command -v jq >/dev/null 2>&1 || { echo "cc-backlog: jq is required" >&2; exit 1; }

case "${1:-}" in
  # rc is captured and re-exited so the kick can never become `add`'s verdict.
  add)     shift; cmd_add "$@"; _add_rc=$?; [ "$_add_rc" -eq 0 ] && dispatch_kick; exit "$_add_rc" ;;
  list)    shift; cmd_list "$@" ;;
  claim)   shift; cmd_transition claim "$@" ;;
  reclaim) shift; cmd_reclaim "$@" ;;
  # NO dispatch_kick on either. `link` writes no status, so it cannot make an item newly
  # dispatchable — and a kick would in fact be backwards here: the whole point of a link is to make
  # ONE of the joined rows undispatchable. `dups` is a pure read.
  link)    shift; cmd_link "$@" ;;
  dups)    shift; cmd_dups "$@" ;;
  done)    shift; cmd_transition "done" "$@" ;;
  reopen)  shift; cmd_transition reopen "$@" ;;
  block)   shift; cmd_transition block "$@" ;;
  unblock) shift; cmd_transition unblock "$@" ;;
  # NO dispatch_kick — unlike `add` above. The item is born `blocked`, i.e. already outside the
  # dispatch wave, so a kick is pure waste and risks a worker on a human-only step (header § needs).
  needs)   shift; cmd_needs "$@" ;;
  reap)    shift; cmd_reap "$@" ;;
  compact) shift; cmd_compact "$@" ;;
  ""|-h|--help|help) usage ;;
  *) printf 'cc-backlog: unknown verb %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
