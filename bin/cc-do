#!/usr/bin/env bash
# cc-do — ONE command that discharges the operator's whole close board.
#
# THE DEFECT it closes: the silver-platter Stop block (hooks/operator-readout.sh) renders up to nine
# numbered steps, and each one is a full `CONFIRM=1 bash ~/.claude/autonomy/pending-activation/05-x.sh
# && touch ~/.claude/autonomy/pending-activation/05-x.sh.done` line that wraps to four terminal lines
# at 100 cols. The board was CORRECT and unreadable: the operator's actual next action was to
# hand-transcribe nine long commands, in the right order, without dropping the `&& touch`. So the
# readout now emits `▶ cc-do` as its headline and `▶ cc-do <stem>` per activation, and this script is
# what those point AT. The wall of commands becomes one word.
#
# ── THE PRODUCERS ARE THE READOUT'S ── this script and the hook read the SAME four stores through
#   the SAME env seams (CC_ACTIVATION_DIR · CC_DECISIONS_DIR · CC_BACKLOG_FILE+CC_BACKLOG_BIN ·
#   CC_SHARED_CHECKOUT+CC_DEPLOY_SCRIPT). That is deliberate and load-bearing: a platter command that
#   disagrees with the board it was printed on is worse than no platter — it teaches the operator
#   that the board lies. Two surfaces, one truth; the seams are how the suites prove they agree.
#
# ── RUNNABLE vs JUDGMENT ── the split IS the design. `deploy` and `activation` are RUNNABLE: a
#   machine step with one correct outcome. `decision` and `backlog --blocked` are JUDGMENT: they wait
#   on a human ruling, so cc-do NEVER runs them — it prints the exact command that resolves them and
#   stops. Judgment classes collapse to ONE COUNTED line in the default view (191 blocked items is
#   the wall we are removing, not a list to reprint); `--list`/`--json` still itemize every one, so
#   nothing is lost, it is only moved one keystroke away.
#
# ── ⊘ HELD ── a THIRD state, and it is neither of the above: a runnable class whose own actuator
#   says it would refuse right now. `deploy` is the case (§2.6 D5): this board platterd
#   `bash ~/.claude/scripts/deploy-live.sh` as RUN 1 while that command had refused 534 consecutive
#   times. A held row is NAMED with the actuator's own reason and never numbered, never counted into
#   NRUN, never executed — but never dropped either, because the underlying lag is real information.
#   It is not JUDGMENT: nothing is being asked of the operator, the state clears itself.
#
# ── ORDER IS IRREVERSIBILITY ── deploy first (an activation run against a stale checkout is an
#   activation run against the wrong code), then CONFIRM-gated activations (effect-bearing: cp, lint,
#   bootstrap), then plain ones (they print instructions). Execution STOPS at the first failure and
#   names it: a half-run board the operator cannot see the seam of is how a fleet drifts.
#
# ── THE .done MARKER IS EARNED ── `touch <f>.done` happens on EXIT 0 ONLY. A failed activation that
#   marked itself done would vanish from every board forever — silent loss, the one outcome worse
#   than a visible failure.
#
# Usage:
#   cc-do              print the board, then ONE prompt; Enter runs the runnable steps in order
#   cc-do <stem>       run exactly ONE pending activation whose filename starts with <stem>
#   cc-do --list       print the board, itemizing judgment items too. Runs nothing.
#   cc-do --run        skip the prompt, run the runnable set (scripted/non-interactive use)
#   cc-do --json       one JSON array of {class,mark,cmd,label}. Runs nothing.
#   cc-do -h|--help    this block
#
# NON-INTERACTIVE SAFETY: with stdin not a TTY and none of --run/--list/CC_DO_ASSUME_YES=1, cc-do
# prints the board, says plainly that NOTHING RAN, and exits 3. It never blocks a scripted caller on
# a `read` that can never answer — and never reports a no-op as success: an empty board still exits
# 0, so 0 means "nothing outstanding" and 3 means "steps outstanding, no channel to confirm them".
#
# Env seams (tests): CC_ACTIVATION_DIR · CC_DECISIONS_DIR · CC_BACKLOG_FILE · CC_BACKLOG_BIN ·
#   CC_SHARED_CHECKOUT · CC_DEPLOY_SCRIPT · CC_DO_ASSUME_YES
# Exit: 0 ok / nothing to do / list · 1 a step FAILED (named, nothing after it ran) · 2 usage or
#   unresolvable stem · 3 runnable steps pending and NOTHING RAN because stdin is not a terminal
#   (see NON-INTERACTIVE SAFETY). bash 3.2 (macOS) clean — no associative arrays, no mapfile, no
#   ${x^^}.
set -uo pipefail

CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
ACT_DIR="${CC_ACTIVATION_DIR:-$HOME/.claude/autonomy/pending-activation}"
DEC_DIR="${CC_DECISIONS_DIR:-$HOME/.claude/autonomy/decisions}"
BLG_FILE="${CC_BACKLOG_FILE:-$HOME/.claude/autonomy/backlog.jsonl}"
SHARED="${CC_SHARED_CHECKOUT:-$HOME/Development/claude-infrastructure}"
DEPLOY_SCRIPT="${CC_DEPLOY_SCRIPT:-$HOME/.claude/scripts/deploy-live.sh}"
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
# The placeholder shape (hooks/lib/placeholder.sh) — SSOT shared with hooks/operator-readout.sh and
# completion-assert D5. THIS board prints a blocked row's own `run` as the row's PASTE TARGET, so a
# stored command with a hole in it is handed over here exactly as it was in the close block that
# started this (operator, 2026-08-22: *"never give us spoon-fed commands if it's not ready for us to
# actually run"*). Resolve through $0's symlink first (the live copy is ~/.claude/bin/cc-do -> the
# checkout; a brand-new lib has no live symlink until install.sh runs). Missing ⇒ defs that answer
# `false`, i.e. today's behaviour — never an empty $ph, which jq's `test("")` makes true for EVERY
# row.
_PH_LIB=""
for _c in "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/../hooks/lib/placeholder.sh" \
          "$SCRIPT_DIR/../hooks/lib/placeholder.sh" \
          "$CFG/hooks/lib/placeholder.sh" "$HOME/.claude/hooks/lib/placeholder.sh"; do
  [ -f "$_c" ] && { _PH_LIB="$_c"; break; }
done
# shellcheck source=../hooks/lib/placeholder.sh
# shellcheck disable=SC1090,SC1091
{ [ -n "$_PH_LIB" ] && . "$_PH_LIB" 2>/dev/null; } || {
  CC_PLACEHOLDER_RE=''; CC_PH_JQ='def ph_hit($ph): false; def ph_toks($ph): "";'; }
TABC="$(printf '\t')"
# TSV empty-field placeholder. A single tab in IFS is still IFS *whitespace*, so a run of two tabs
# collapses into one delimiter and every later field shifts one position LEFT — silently, exit 0.
# (tests/tsv-field-collapse.bats is this repo's standing scar on that.) So no field is EVER empty on
# the wire; `-` rides in place of one and is un-padded on read.
PAD='-'

usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'; }
tildify() { printf '%s' "${1/#$HOME/~}"; }   # display+paste-safe: the shell re-expands ~

MODE=default; STEM=""
while [ $# -gt 0 ]; do
  case "$1" in
    --list) MODE=list ;;
    --run)  MODE=run ;;
    --json) MODE=json ;;
    -h|--help) usage; exit 0 ;;
    -*) printf 'cc-do: unknown option %s\n' "$1" >&2; exit 2 ;;
    *)  [ -z "$STEM" ] || { printf 'cc-do: one stem at a time (got %s and %s)\n' "$STEM" "$1" >&2; exit 2; }
        STEM="$1" ;;
  esac
  shift
done
if [ -n "$STEM" ] && [ "$MODE" != default ]; then
  printf 'cc-do: <stem> takes no mode flag (got --%s)\n' "$MODE" >&2; exit 2
fi

STEPS="$(mktemp "${TMPDIR:-/tmp}/ccdo.XXXXXX")" || { printf 'cc-do: mktemp failed\n' >&2; exit 1; }
trap 'rm -f "$STEPS"' EXIT
# one step per line — class<TAB>mark<TAB>name<TAB>cmd<TAB>label<TAB>path
#   class ∈ {deploy,activation,decision,backlog}, emitted in that (irreversibility) order
#   mark  ▶ = cc-do runs it · ◆ = yours to rule on, cc-do never runs it · ✎ = the row's stored
#         command still has a placeholder in it, so it is NOT a paste target and its paste line is
#         suppressed; the label names the value that is missing (hooks/lib/placeholder.sh)
#   path  the script to exec (runnable classes only; `-` otherwise) — kept as its OWN field so
#         execution never has to re-parse `cmd`, i.e. never needs eval
emit() { printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "${6:-$PAD}" >> "$STEPS"; }

# ── producers (mirror hooks/operator-readout.sh §152-258 exactly) ─────────────────────────────────
collect() {
  local sbr behind dscript f b act_c="" act_p="" blg c

  # 1 · deploy-lag: shared checkout on trunk but behind its already-fetched origin.
  if [ -d "$SHARED" ] && git -C "$SHARED" rev-parse --git-dir >/dev/null 2>&1; then
    sbr="$(git -C "$SHARED" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ "$sbr" = "main" ] || [ "$sbr" = "master" ]; then
      behind="$(git -C "$SHARED" rev-list --count "HEAD..origin/$sbr" 2>/dev/null || echo 0)"
      case "$behind" in ''|*[!0-9]*) behind=0 ;; esac
      # EXISTENCE-CHECK THE PLATTER (readout I11): ~/.claude/scripts/deploy-live.sh did not exist for
      # the whole window in which com.claude.deploy-live logged 59 `No such file` failures. Fall back
      # to the repo copy — which is what the symlink points AT — so the platter runs in both states.
      dscript="$DEPLOY_SCRIPT"
      [ -e "$dscript" ] || dscript="$SHARED/scripts/deploy-live.sh"
      if [ "$behind" -gt 0 ]; then
        # ── RUNNABILITY-CHECK IT TOO (DEPLOY_LANE_GROUND_UP §2.6 D5 / V9) ─────────────────────────
        # Existence was only half of I11. This row platterd `bash ~/.claude/scripts/deploy-live.sh`
        # as RUN 1 while that exact command had refused 534 consecutive times — a command that
        # EXISTS and cannot SUCCEED teaches the operator the board lies just as effectively as one
        # that is missing. "The platter must either carry a command that can succeed under the
        # current state, or name the blocker instead of offering a fix its own gate rejects."
        #
        # ASK THE LANE; never re-derive its ladder here. deploy-live.sh's T1/T2/T3 tier logic is the
        # arbiter of whether an advance is possible, and a second copy of that predicate living in a
        # renderer would drift from it silently (memory make-the-actuator-the-arbiter). `--offline`
        # exists for exactly this call: same decision, no network, so the probe cannot manufacture
        # the refusal it reports. DEPLOY_REPO is pinned to $SHARED so the probe and the `behind`
        # count above are answering about the SAME checkout.
        #
        # Gated on `behind > 0`, i.e. only when there is something to deploy at all. Measured cost
        # 0.86s against a 2.19s `cc-do --list` baseline.
        dout="$(DEPLOY_REPO="$SHARED" bash "$dscript" --dry-run --offline 2>&1)"; drc=$?
        if [ "$drc" -eq 0 ]; then
          emit deploy '▶' "$(basename "${dscript%.sh}")" \
            "bash $(tildify "$dscript")" "live layer $behind behind origin/$sbr" "$dscript"
        else
          # NAMED, NOT DROPPED. The lag is real information even when the fix is not runnable —
          # silently omitting the row would hide a stale fleet, which is the failure one level up.
          # The mark is ⊘, so NRUN does not count it and run_steps never executes it: every gate in
          # this script keys on ▶.
          dwhy="$(printf '%s\n' "$dout" | tail -1 | tr -d '\t')"
          dwhy="${dwhy#deploy-live: }"; dwhy="${dwhy#REFUSED — }"
          [ "${#dwhy}" -gt 110 ] && dwhy="$(printf '%.107s...' "$dwhy")"
          emit deploy '⊘' "$(basename "${dscript%.sh}")" \
            "bash $(tildify "$dscript")" \
            "live layer $behind behind origin/$sbr — the lane REFUSES: ${dwhy:-exit $drc}" "$dscript"
        fi
      fi
    fi
  fi

  # 2 · activations: staged, un-run (no .done sibling). CONFIRM-gated FIRST — that flag is the one
  #     effect-bearing signal already in hand, and filename order buried `18-fleet` (12 dark launchd
  #     labels) under `04-page-channel` at every close.
  if [ -d "$ACT_DIR" ]; then
    for f in "$ACT_DIR"/*.sh; do
      [ -f "$f" ] || continue
      [ -f "$f.done" ] && continue
      b="$(basename "$f" .sh)"
      if grep -q 'CONFIRM' "$f" 2>/dev/null; then
        act_c="${act_c}activation${TABC}▶${TABC}${b}${TABC}CONFIRM=1 bash $(tildify "$f")${TABC}activation${TABC}${f}"$'\n'
      else
        act_p="${act_p}activation${TABC}▶${TABC}${b}${TABC}bash $(tildify "$f")${TABC}activation${TABC}${f}"$'\n'
      fi
    done
    [ -n "$act_c$act_p" ] && printf '%s' "$act_c$act_p" >> "$STEPS"
  fi

  # 3 · open decisions (JUDGMENT), oldest first. A packet that can NEVER auto-resolve is human-gated
  #     whatever its class FIELD says: `cc-decide open` refuses class-B without BOTH a default and a
  #     deadline, so a B carrying neither came in the back door and is a hard block wearing the wrong
  #     label. Class A is deliberately NOT folded — it is a post-hoc audit trail with nothing to do.
  if [ -d "$DEC_DIR" ]; then
    for f in "$DEC_DIR"/*.json; do
      [ -e "$f" ] || continue
      # jq -r renders \t in a string literal as a REAL tab. Sort on the `created` prefix (FIFO), then
      # cut it off. Never @tsv — it \t-escapes the fields instead of emitting delimiters.
      jq -r '
        select((.status // "" | if . == "" then "open" else . end) == "open"
               and ((.class // "") == "C"
                    or ((.class // "") == "B"
                        and (.default_if_no_veto // "") == ""
                        and (.veto_deadline // "") == "")))
        | (.id // "?" | if length > 24 then .[0:24] else . end) as $id
        | (.what_plain // "" | gsub("[\n\t]"; " ") | split(". ")[0]) as $s0
        | ($s0 | if length > 90 then .[0:90] + "…" elif . == "" then "(no summary)" else . end) as $sent
        | "\(.created // "?")\tdecision\t◆\t\($id)\tcc-decide list --open\tdecision \(.class // "?"): \($sent)\t-"
      ' "$f" 2>/dev/null      # malformed packet → jq exits nonzero, emits nothing, board survives
    done | sort | cut -f2- >> "$STEPS"
  fi

  # 4 · blocked backlog (JUDGMENT): each carries the operator-only step that unblocks it.
  #
  # THE ROW'S OWN COMMAND GOES IN THE `cmd` SLOT (2026-08-17, O2 of MASTER_OPERATOR_GATED.md).
  # `cc-backlog needs --run "<cmd>"` exists so the filer can record the exact command that
  # discharges the step, it survives the fold (tests/cc-backlog-needs.bats pins that as a
  # fold-whitelist regression), and it reaches `list --blocked --json` intact — and then this
  # emitter threw it away, hardcoding the generic pointer `cc-backlog list --blocked` for all of
  # them. Measured 2026-08-17: 51 of 130 blocked rows carry a command, and the board rendered every
  # one as "go read a list". That is the operator's own complaint about this surface, verbatim —
  # *"I had to comb through the entire return body to fish out which is the command to copy and
  # paste"* — reproduced by the renderer built to end it.
  #
  # STILL JUDGMENT, AND THAT IS NOT A COMPROMISE — it is what the population requires. `mark` stays
  # ◆ and `path` stays `-`, so these are never counted into NRUN, never reached by the bulk Enter,
  # and structurally unexecutable (execution reads `path`, never `cmd`, precisely so it never needs
  # eval). The doctrine at the top of this file says RUNNABLE means "a machine step with one correct
  # outcome"; a backlog `run` is nothing so uniform. Today's 51 include
  # `turso auth api-tokens revoke reso-provisioning`, `rm -i …`, `brew services stop postgresql@14`,
  # `/ship` and `/compact-memory` (slash commands, not shell at all), and a bare `sed -n '78,82p'`
  # that is a READ someone filed as a step. Promoting that set to RUN would put a production-token
  # revoke one Enter away from an operator answering a prompt about activations. The gap was never
  # that these should run — it is that the operator could not SEE the command without going to
  # fish for it.
  #
  # Absent `run` ⇒ the generic pointer exactly as before, so a row with nothing to show is unchanged.
  blg="${CC_BACKLOG_BIN:-}"
  if [ -z "$blg" ]; then
    for c in "$SCRIPT_DIR/cc-backlog" "$CFG/bin/cc-backlog" "$HOME/.claude/bin/cc-backlog"; do
      [ -x "$c" ] && { blg="$c"; break; }
    done
  fi
  if [ -n "$blg" ] && [ -f "$BLG_FILE" ]; then
    "$blg" list --blocked --json 2>/dev/null \
      | jq -r --arg ph "$CC_PLACEHOLDER_RE" "$CC_PH_JQ"'
      .[]?
      | (.title // "" | gsub("[\n\t]"; " ") | .[0:60]) as $t
      | (.needs // "" | gsub("[\n\t]"; " ") | .[0:90]) as $n
      # Same gsub as $t/$n: a tab inside `run` would shift every later column and silently re-point
      # the fields (memory: tsv-field-collapse). NOT truncated — a half command is worse than none.
      | ((.run // "") | gsub("[\n\t]"; " ")) as $r
      # A `run` that still carries a placeholder is NOT a paste target (2026-08-22). Putting the
      # GENERIC pointer in `cmd` is what suppresses the paste line — itemize_class prints that line
      # only when `cmd` differs from the class pointer, so the one mechanism already there does the
      # work and there is no fifth field to keep in sync. The mark drops to ✎ and the label NAMES
      # the missing value, matching hooks/operator-readout.sh row-for-row.
      | ($r != "" and ($r | ph_hit($ph))) as $hole
      | (if $r == "" or $hole then "cc-backlog list --blocked" else $r end) as $cmd
      | (if $hole then "✎" else "◆" end) as $mk
      | (if $hole then "backlog: SUPPLY \($r | ph_toks($ph)) — \($n)"
         else "backlog: \($t) — needs: \($n)" end) as $label
      | "backlog\t\($mk)\t\(.id // "?")\t\($cmd)\t\($label)\t-"
    ' 2>/dev/null >> "$STEPS"
  fi
}

cls_count() { grep -c "^$1$TABC" "$STEPS" 2>/dev/null || true; }

# ── rendering ─────────────────────────────────────────────────────────────────────────────────────
itemize_class() {
  # $2 (optional) = the class's GENERIC pointer. A row whose `cmd` differs from it carries its OWN
  # command, and that command is printed under the row — the whole point of recording it. Compared
  # against the pointer rather than flagged with a field so there is no fifth thing to keep in sync:
  # the emitter already decides this by choosing what to put in `cmd`.
  local want="$1" generic="${2:-}" cls mark name cmd label path
  while IFS="$TABC" read -r cls mark name cmd label path; do
    [ "$cls" = "$want" ] || continue
    [ "$path" = "$PAD" ] && path=""
    printf '         %s %-22s %s\n' "$mark" "$name" "$label"
    # No marker glyph and no `$` prompt on this line: it is the row's paste target, and both would
    # land inside a click-drag selection and corrupt the command.
    [ -n "$generic" ] && [ "$cmd" != "$generic" ] && printf '           %s\n' "$cmd"
  done < "$STEPS"
}

render() { # $1 = "list" → also itemize judgment classes and show each runnable's exact command
  local itemize="${1:-}" cls mark name cmd label path i=0
  if [ "$((NRUN + NJUDG + NHELD))" -eq 0 ]; then printf 'cc-do — nothing outstanding.\n'; return 0; fi
  printf 'cc-do — %d runnable · %d judgment\n' "$NRUN" "$NJUDG"
  while IFS="$TABC" read -r cls mark name cmd label path; do
    [ "$mark" = '▶' ] || continue
    i=$((i + 1))
    printf '  RUN  %d. %-22s [%s]\n' "$i" "$name" "$label"
    [ "$itemize" = list ] && printf '         %s\n' "$cmd"
  done < "$STEPS"
  # ⊘ HELD — present, named, and deliberately NOT numbered: the numbers are what the operator pastes
  # after, and a held row has nothing to paste. It carries the actuator's own refusal so the board
  # states WHY rather than offering a command the lane will reject (§2.6 D5).
  while IFS="$TABC" read -r cls mark name cmd label path; do
    [ "$mark" = '⊘' ] || continue
    printf '  HELD    %-22s [%s]\n' "$name" "$label"
  done < "$STEPS"
  # count + text share the RUN lines' name column, so the two kinds of row align at 10 chars in
  [ "$NDEC" -gt 0 ] && printf '  YOURS   %-22s %s\n' "$NDEC open decision(s)" 'cc-decide list --open'
  [ "$itemize" = list ] && itemize_class decision 'cc-decide list --open'
  [ "$NBLG" -gt 0 ] && printf '  YOURS   %-22s %s\n' "$NBLG blocked backlog" 'cc-backlog list --blocked'
  [ "$itemize" = list ] && itemize_class backlog 'cc-backlog list --blocked'
  return 0
}

json_out() {
  local cls mark name cmd label path
  while IFS="$TABC" read -r cls mark name cmd label path; do
    [ -n "$cls" ] || continue
    [ "$path" = "$PAD" ] && path=""
    jq -nc --arg c "$cls" --arg m "$mark" --arg x "$cmd" --arg l "$label" \
      '{class:$c, mark:$m, cmd:$x, label:$l}'
  done < "$STEPS" | jq -s '.'
}

# ── execution ─────────────────────────────────────────────────────────────────────────────────────
# Children get stdin </dev/null: the loop's stdin IS $STEPS, and one script that reads a line would
# eat the rest of the board. The `.done` touch is EARNED (exit 0 only) — see the header.
run_one() { # $1=path $2=cmd $3=class $4=name → 0 ok, 1 failed (named)
  local rc
  if [ "${2#CONFIRM=1 }" != "$2" ]; then CONFIRM=1 bash "$1" </dev/null; rc=$?
  else bash "$1" </dev/null; rc=$?; fi
  if [ "$rc" -ne 0 ]; then
    # A DEPLOY refusal is a STEADY STATE, not an error — and it must not halt the run.
    # deploy-live is fail-closed on a background verifier's green stamp ("the live layer is FROZEN
    # until a tree verifies green"), and this box's trunk has been PERSISTENT-RED for reasons no
    # operator action clears. Deploy sorts FIRST (irreversibility order), so treating its refusal as
    # fatal meant the ONE COMMAND ran nothing at all: every pending activation sat behind a step
    # that cannot succeed today. Deploy is idempotent and self-gating, so skipping it is safe.
    # ACTIVATION failures still halt: those are sequential machine mutations, and after one fails
    # the state the next assumes is no longer known to hold.
    if [ "$3" = deploy ]; then
      printf 'cc-do: SKIPPED — %s (exit %s). Deploy is gated on a green verifier stamp; it will\n' "$4" "$rc" >&2
      printf 'cc-do:   advance on its own once trunk verifies. Continuing with the rest.\n' >&2
      return 0
    fi
    printf 'cc-do: FAILED — %s (exit %s): %s\n' "$4" "$rc" "$2" >&2
    printf 'cc-do: stopped here; nothing after it was run, and no .done marker was written.\n' >&2
    return 1
  fi
  [ "$3" = activation ] && touch "$1.done"
  printf '  ✓ %s\n' "$4"
  return 0
}

run_steps() {
  local cls mark name cmd label path i=0
  while IFS="$TABC" read -r cls mark name cmd label path; do
    [ "$mark" = '▶' ] || continue
    i=$((i + 1))
    printf '▶ [%d/%d] %s\n' "$i" "$NRUN" "$cmd"
    run_one "$path" "$cmd" "$cls" "$name" || return 1
  done < "$STEPS"
  printf 'cc-do — %d step(s) done.\n' "$i"
  return 0
}

run_stem() { # $1=stem → exactly one pending activation, or exit 2
  local stem="$1" f b matches="" n=0 hit="" hitb="" pre=""
  for f in "$ACT_DIR"/*.sh; do
    [ -f "$f" ] || continue
    [ -f "$f.done" ] && continue
    b="$(basename "$f" .sh)"
    # "$stem" quoted so the STEM cannot act as a glob — only the trailing * is a wildcard
    case "$b" in "$stem"*) matches="${matches}  $b"$'\n'; n=$((n + 1)); hit="$f"; hitb="$b" ;; esac
  done
  if [ "$n" -eq 0 ]; then
    printf 'cc-do: no pending activation starts with "%s".\n' "$stem" >&2
    printf 'cc-do: run "cc-do --list" to see what is pending.\n' >&2
    return 2
  fi
  if [ "$n" -gt 1 ]; then
    printf 'cc-do: "%s" is ambiguous — %d matches:\n' "$stem" "$n" >&2
    printf '%s' "$matches" >&2
    return 2
  fi
  grep -q 'CONFIRM' "$hit" 2>/dev/null && pre="CONFIRM=1 "
  local cmd
  cmd="${pre}bash $(tildify "$hit")"
  printf '▶ %s\n' "$cmd"
  run_one "$hit" "$cmd" activation "$hitb" || return 1
  return 0
}

# ── main ──────────────────────────────────────────────────────────────────────────────────────────
if [ -n "$STEM" ]; then run_stem "$STEM"; exit $?; fi

collect
NRUN="$(grep -c "${TABC}▶${TABC}" "$STEPS" 2>/dev/null || true)"
# HELD rows are neither runnable nor judgment: they are a machine state that clears itself. Counted
# separately so they can keep the board from printing "nothing outstanding" over a stale fleet,
# without inflating NRUN (which run_steps and the prompt both key on).
NHELD="$(grep -c "${TABC}⊘${TABC}" "$STEPS" 2>/dev/null || true)"
NDEC="$(cls_count decision)"; NBLG="$(cls_count backlog)"
case "$NRUN"  in ''|*[!0-9]*) NRUN=0 ;; esac
case "$NHELD" in ''|*[!0-9]*) NHELD=0 ;; esac
case "$NDEC" in ''|*[!0-9]*) NDEC=0 ;; esac
case "$NBLG" in ''|*[!0-9]*) NBLG=0 ;; esac
NJUDG=$((NDEC + NBLG))

case "$MODE" in
  json) json_out; exit 0 ;;
  list) render list; exit 0 ;;
esac

render
[ "$NRUN" -gt 0 ] || exit 0

if [ "$MODE" = run ] || [ "${CC_DO_ASSUME_YES:-0}" = 1 ]; then run_steps; exit $?; fi
# ── NO CONFIRM CHANNEL ────────────────────────────────────────────────────────────────────────────
# A scripted caller must never be silently blocked on a read that can never be answered — but it
# must not be told "0, all good" either, and that is what this branch used to do. Claude Code's `!`
# prefix runs the command with stdin closed, so `!cc-do` printed the whole board and exited 0 having
# executed NOTHING — byte-for-byte the same verdict as a board with nothing on it. The operator (and
# the agent relaying the block verbatim) read a successful run off a no-op. Silent inaction wearing
# success's exit code is the one failure mode this whole driver exists to remove.
# So: still never block, still never run un-confirmed effect-bearing steps — but SAY nothing ran,
# and exit 3 so a caller can tell "nothing to do" (0) from "something to do and no way to ask" (3).
if [ ! -t 0 ]; then
  printf 'cc-do: NOTHING RAN — stdin is not a terminal, so the confirm prompt cannot be asked.\n' >&2
  printf 'cc-do:   %d runnable step(s) are still pending, exactly as listed above.\n' "$NRUN" >&2
  printf 'cc-do:   Run them from a terminal with "cc-do", or non-interactively with "cc-do --run".\n' >&2
  exit 3
fi

printf 'Run the %d runnable step(s) now? [Y/n] ' "$NRUN"
read -r ans || ans=""
case "${ans:-Y}" in
  [Nn]*) printf 'cc-do: nothing run. "cc-do --list" keeps the board; "cc-do" re-offers it.\n'; exit 0 ;;
esac
run_steps
exit $?
