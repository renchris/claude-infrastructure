#!/bin/bash
# cc-sessions — list live Claude Code sessions in the cross-session comms registry.
#
# Part of the two-way session-comms feature (with cc-notify / cc-await-ping).
# Reads $HOME/.claude/cc-registry/<paneUUID>.json entries written by the
# session-register.sh SessionStart hook, and lazily SWEEPS stale ones on read:
#   - owning process dead      (`kill -0 <pid>` fails — authoritative, same user
#                               across accounts), OR
#   - iTerm2 pane gone         (UUID absent from `it2 session list --json`, but
#                               ONLY when that list is readable — a transient it2
#                               error never triggers a sweep; fail-safe).
#
# Usage:
#   cc-sessions            pretty table: NAME  UUID  ACCOUNT  AGE  CWD
#                          UUID is the FULL 36-char paneUUID, because this column's job is to be
#                          PASTEABLE: it was truncated to 8 chars, which cc-notify's own input then
#                          rejected as "not a live session name or a pane UUID" — a listing that does
#                          not round-trip into the tool that prints it. (cc-notify also accepts an
#                          unambiguous prefix now, so an 8-char string copied from the old output
#                          still resolves.)
#   cc-sessions --json     JSON array of live entries (cc-notify uses this to
#                          resolve a friendly name → pane UUID)
#   cc-sessions --names    one friendly name per line
#   cc-sessions --offbox   ONLY the off-box (cloud) sessions; composes with --json/--names
#   cc-sessions -h         this help
#
# ── OFF-BOX SESSIONS (docs/plans/CLOUD_OBSERVABILITY.md §9.3) ─────────────────────────────────────
# This lister enumerates ~/.claude/cc-registry with `kill -0` on a LOCAL pid, which makes it
# structurally unable to represent a session running in an Anthropic-managed VM — §5.2 names it as
# one of the three local oracles that convert "not on this box" into "dead". Off-box rows therefore
# come from `cc-cloud`, NEVER from the registry, and are rendered as a SEPARATE block with a
# distinct `kind=offbox` so nothing about them can be read as a local pane:
#   · NEVER a pid/UUID column and never `kill -0` — a blank pid beside live local pids reads as
#     "dead" to a human scanning the column. State comes from cc-cloud's state function, whose arms
#     are total, via `cc-cloud list --json --state`. This file does NOT re-derive that verdict:
#     re-implementing another tool's arbiter outside it is a defect this repo has already paid for.
#   · U0 UNKNOWN renders as the literal word UNKNOWN, never as a gap. An empty cell in a table of
#     live sessions is read as absence, and absence is exactly the ambiguity §4 exists to remove.
#     So a probe that could not run degrades to UNKNOWN rows, never to silence.
#   · The recover action is `open <url>`, never a kill — there is no local process to signal.
# `--json` and `--names` stay LOCAL-ONLY by default, deliberately: they are the ADDRESSING views
# (cc-notify resolves a friendly name → pane UUID through them, and the teammate/shutdown hooks
# select on registry keys), so a row that cannot be delivered to locally must never resolve there.
# `--offbox` is the explicit machine surface, and the default TABLE — the operator's view, the one
# §9.3 is about — shows both. With zero declarations every byte of every mode is unchanged.
#
# Env overrides (for tests): CC_REGISTRY_DIR, IT2_BIN, CC_CLOUD_BIN, CC_CLOUD_LIST_TIMEOUT_S.
# Read-only except for the lazy stale-sweep. Always exit 0 (empty registry too).
set -uo pipefail

REG_DIR="${CC_REGISTRY_DIR:-$HOME/.claude/cc-registry}"
IT2="${IT2_BIN:-$HOME/.claude/bin/it2}"

usage() {
  sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
}

MODE=table; ALL=0; OFFBOX=0
# --all = the FORENSIC view (live + retained-dead rows). The default stays the ADDRESSING view
# (live only), so cc-notify can never resolve a friendly name onto a dead pane.
for a in "$@"; do
  case "$a" in
    --json)     MODE=json ;;
    --names)    MODE=names ;;
    --all)      ALL=1 ;;
    --offbox)   OFFBOX=1 ;;
    -h|--help)  usage; exit 0 ;;
    '')         ;;
    *)          echo "cc-sessions: unknown option '$a'" >&2; usage >&2; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "cc-sessions: jq required" >&2; exit 1; }

_TO=""; for _c in timeout gtimeout; do command -v "$_c" >/dev/null 2>&1 && { _TO="$_c"; break; }; done

# ── off-box rows, from cc-cloud only (§9.3) ───────────────────────────────────────────────────────
# Resolution order mirrors cc-notify's sibling-first search: the tool beside this one is the
# deterministic choice under a test PATH, and $HOME/.claude/bin is where the live layer symlinks it.
CLOUD_BIN="${CC_CLOUD_BIN:-}"
if [ -z "$CLOUD_BIN" ]; then
  for _c in "$(dirname "$0")/cc-cloud" "$HOME/.claude/bin/cc-cloud"; do
    if [ -x "$_c" ]; then CLOUD_BIN="$_c"; break; fi
  done
fi
[ -n "$CLOUD_BIN" ] || CLOUD_BIN="$(command -v cc-cloud 2>/dev/null || true)"
CLOUD_TIMEOUT_S="${CC_CLOUD_LIST_TIMEOUT_S:-25}"

# NDJSON — one object per LINE, not an array. `cc-cloud list` emits it that way and every consumer
# here reads it line-wise; a `jq '.[]'` over this would break on the first row.
offbox_ndjson() {
  local out rc
  [ -n "$CLOUD_BIN" ] && [ -x "$CLOUD_BIN" ] || return 0
  if [ -n "$_TO" ]; then
    out="$("$_TO" "$CLOUD_TIMEOUT_S" "$CLOUD_BIN" list --json --state 2>/dev/null)"; rc=$?
  else
    out="$("$CLOUD_BIN" list --json --state 2>/dev/null)"; rc=$?
  fi
  # A verdict that could not be obtained must not delete the ROW. Fall back to the probe-free
  # inventory, whose `state` is then absent and renders as the literal UNKNOWN below — the U0
  # discipline: "could not look" is a non-verdict, never an absence.
  if [ "$rc" -ne 0 ]; then out="$("$CLOUD_BIN" list --json 2>/dev/null)" || out=""; fi
  [ -n "$out" ] || return 0
  printf '%s\n' "$out"
}

# KIND \t SESSION \t STATE \t AGE \t ACTION — no pid, no UUID, no kill, and no empty cell.
offbox_tsv() {
  local nd; nd="$(offbox_ndjson)"
  [ -n "$nd" ] || return 0
  printf '%s\n' "$nd" | jq -r '
    select(.retired != true) |
    ((.age_s // 0) | floor) as $age |
    ( if   $age < 60    then "\($age)s"
      elif $age < 3600  then "\(($age / 60)    | floor)m"
      elif $age < 86400 then "\(($age / 3600)  | floor)h"
      else                   "\(($age / 86400) | floor)d" end ) as $ago |
    ( if (.state // "") == "" then "UNKNOWN" else .state end ) as $state |
    ( if (.url   // "") == "" then "https://claude.ai/code" else .url end ) as $url |
    [ "offbox", .id, $state, $ago, "open " + $url ] | @tsv
  ' 2>/dev/null
}

offbox_json() {
  local nd; nd="$(offbox_ndjson)"
  if [ -z "$nd" ]; then echo '[]'; return 0; fi
  printf '%s\n' "$nd" | jq -s '[ .[] | select(.retired != true) |
    ( if (.url // "") == "" then "https://claude.ai/code" else .url end ) as $url | {
      kind:   "offbox",
      id:     .id,
      name:   .id,
      branch: (.branch // ""),
      item:   (.item // ""),
      state:  (if (.state // "") == "" then "UNKNOWN" else .state end),
      detail: (.detail // ""),
      age_s:  (.age_s // 0),
      url:    $url,
      action: ("open " + $url)
    } ]'
}

offbox_table() { # the block appended under the local table; silent when nothing is declared
  local rows; rows="$(offbox_tsv)"
  [ -n "$rows" ] || return 0
  printf '\nOFF-BOX — no local process; state is cc-cloud'\''s, and the action is the URL\n'
  {
    printf 'KIND\tSESSION\tSTATE\tAGE\tACTION\n'
    printf '%s\n' "$rows"
  } | { if command -v column >/dev/null 2>&1; then column -t -s "$(printf '\t')"; else cat; fi; }
}

if [ "$OFFBOX" = 1 ]; then
  case "$MODE" in
    json)  offbox_json ;;
    names) offbox_tsv | cut -f2 ;;
    table)
      _rows="$(offbox_tsv)"
      if [ -z "$_rows" ]; then
        echo "(no off-box sessions declared — nothing is firing off-box)"
      else
        offbox_table
      fi
      ;;
  esac
  exit 0
fi

if [ ! -d "$REG_DIR" ]; then
  [ "$MODE" = json ] && echo '[]'
  if [ "$MODE" = table ]; then echo "(no sessions registered)"; offbox_table; fi
  exit 0
fi

# BOUNDED it2 (2026-07-25) — `it2 session list --json` is an IPC call into iTerm2's Python API and is
# the MEASURED hang: >120s under pane load 13-16, at 2% CPU (blocked, not computing), which made this
# whole lister — and therefore `cc-notify --list`, the very thing an operator reaches for when mail is
# not landing — unusable at exactly the moment it was needed. A timeout now lands in the have_panes=0
# branch below, which this script ALREADY treats fail-safe (pane signal unknown → sweep on dead-pid
# only). Duplicated rather than shared with cc-notify on purpose: a brand-new tracked file is not
# symlinked into the live ~/.claude layer, so a shared helper would ship broken until someone noticed.
IT2_TIMEOUT_S="${CC_IT2_TIMEOUT_S:-5}"
it2_list_bounded() {
  [ -n "$IT2" ] && [ -x "$IT2" ] || return 1
  if [ -n "$_TO" ]; then "$_TO" "$IT2_TIMEOUT_S" "$IT2" session list --json 2>/dev/null; return $?; fi
  local tmp bpid rc ticks=0 max=$(( IT2_TIMEOUT_S * 5 ))
  tmp="$(mktemp 2>/dev/null)" || return 1
  "$IT2" session list --json >"$tmp" 2>/dev/null & bpid=$!
  while kill -0 "$bpid" 2>/dev/null; do
    if [ "$ticks" -ge "$max" ]; then
      kill -TERM "$bpid" 2>/dev/null; wait "$bpid" 2>/dev/null; rm -f "$tmp"; return 1
    fi
    sleep 0.2 2>/dev/null || sleep 1; ticks=$(( ticks + 1 ))
  done
  wait "$bpid" 2>/dev/null; rc=$?
  cat "$tmp" 2>/dev/null; rm -f "$tmp"; return "$rc"
}

# Authoritative live pane-UUID set (best-effort). have_panes=0 means "unknown" —
# we then never sweep on the pane signal, only on dead-pid.
live_panes=""
have_panes=0
if pl=$(it2_list_bounded) && [ -n "$pl" ]; then
  lp=$(printf '%s' "$pl" | jq -r 'if type=="array" then .[].id // empty else empty end' 2>/dev/null)
  if [ -n "$lp" ]; then live_panes="$lp"; have_panes=1; fi
fi

# PRESENCE MUST NOT ENCODE LIVENESS (P8, 2026-07-14). This loop used to `rm -f` a row the moment
# its pid died or its pane vanished — i.e. it DELETED EXACTLY THE ROWS THAT PROVE HOW A SESSION
# DIED. A pane that comes up and dies at spawn (D8 trigger 1) would register, die, and have its
# evidence erased on the next read: the spawn-death detector P8 exists to provide would report
# nothing, and the blind spot would persist while LOOKING fixed. Same class as cc-context deleting
# a live stall's telemetry (93720eb) and cc-notify's verifier that could only abstain (3b12107):
# a reaper keyed on DEADNESS erases the forensics.
#
# Cleanup and forensics want opposite things from one record, so they are now separated:
#   LIVENESS  -> the `pid` field (kill -0). Readers decide; presence says nothing.
#   VIEW      -> this lister still emits LIVE rows only, so cc-notify never resolves a name to a
#                dead pane (addressing semantics UNCHANGED — that path is load-bearing for W4).
#   RETENTION -> deletion is now an AGE decision, never a liveness one: corrupt rows go
#                immediately; dead rows are kept for CC_REG_RETAIN_H (default 24h) so a
#                spawn-death is still investigable, then reaped for hygiene.
# `cc-sessions --all` exposes the dead rows (cc-board joins them against telemetry).
# ── {pid,lstart} DIALECT LADDER ───────────────────────────────────────────────────────────────
# `ps -o lstart=` renders through LC_TIME *and* TZ, and the two axes are independent. One live pid
# at one instant, measured on this box:
#
#   canonical (TZ=UTC LC_ALL=C)   `Fri Aug 21 16:29:03 2026`   ← what the writer records from now on
#   TZ=UTC + ambient LC           `Fri 21 Aug 16:29:03 2026`   ← every row written before that pin
#   bare ambient                  `Fri 21 Aug 09:29:03 2026`
#   LC_ALL=C at local TZ          `Fri Aug 21 09:29:03 2026`
#
# The WRITE is pinned canonical (hooks/session-register.sh); the READ accepts every dialect this
# store is measured to hold, because the corpus predating the pin cannot be rewritten — 15 of 18
# live rows are in the second dialect, and a canonical-only comparison would call all 15 strangers
# at once. That is not a hypothetical: the two axes diverge for any launchd-started reader, which
# has no LANG and therefore renders in C. Measured on an isolated copy of the live store, same
# instant — at the writer's locale 10 rows resolve LIVE, under LC_ALL=C only 3.
#
# 🚨 The comparison NORMALISES the recorded string; it does NOT try to re-render the writer's
# dialect. Re-rendering is the obvious fix and it does not work: a reader running under an exported
# `LC_ALL=C` (every launchd job) cannot get the ambient rendering back, because `TZ=UTC ps` overrides
# only TZ and LC_ALL still outranks whatever else it sets. A reader does not know the writer's
# environment and cannot restore it — so the writer's environment must not be part of the question.
#
# Both dialects in this store share TZ=UTC (that axis was pinned from the field's first commit);
# they differ ONLY in field ORDER — `Fri Aug 21` vs `Fri 21 Aug`. Canonicalising the order makes the
# compare locale-independent by construction, and costs ONE `ps` fork, not four.
#
# BOUND, stated honestly: this normalises ORDER, not month NAMES. Both locales measured in this
# fleet (C and en_CA.UTF-8) render English abbreviations; a non-English LC_TIME would still differ,
# and it is the canonical WRITE above — not this reader — that removes that class going forward.
reg_lstart_norm() { # <lstart rendering> -> "Dow Mon DD HH:MM:SS YYYY", whitespace already squeezed
  # Word-splitting is the POINT here — it is how the five fields are separated. The caller has
  # already squeezed whitespace, and an lstart rendering contains no glob character, so the two
  # hazards SC2086 warns about cannot arise. Quoting would pass the whole string as $1 and the
  # function would silently become the identity.
  # shellcheck disable=SC2086
  set -- $1
  [ "$#" -eq 5 ] || { printf '%s' "$*"; return 0; }
  case "$2" in
    ''|*[!0-9]*) printf '%s %s %s %s %s' "$1" "$2" "$3" "$4" "$5" ;;  # already month-first
    *)           printf '%s %s %s %s %s' "$1" "$3" "$2" "$4" "$5" ;;  # day-first -> swap
  esac
}
# FAIL-OPEN is preserved exactly as documented below: an unreadable `ps` returns MATCH, because a
# hiccup is not proof of death. Only a start time READ and differing after normalisation convicts.
reg_lstart_matches() { # <recorded> <pid> — rc 0 = same process (or unprovable), 1 = differs
  local want="$1" pid="$2" now
  [ -n "$want" ] || return 0
  now="$(TZ=UTC LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null | tr -s ' ' | sed 's/^ *//;s/ *$//')"
  [ -n "$now" ] || return 0
  [ "$now" = "$want" ] && return 0
  [ "$(reg_lstart_norm "$now")" = "$(reg_lstart_norm "$want")" ]
}

RETAIN_S=$(( ${CC_REG_RETAIN_H:-24} * 3600 ))
now=$(date +%s)
live=()
dead=()
for f in "$REG_DIR"/*.json; do
  [ -e "$f" ] || continue
  uuid=$(jq -r '.paneUUID // empty' "$f" 2>/dev/null)
  if [ -z "$uuid" ]; then rm -f "$f" 2>/dev/null; continue; fi   # corrupt → sweep (not a liveness call)
  pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)

  stale=0
  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then stale=1; fi
  # PID-REUSE GUARD (write side: hooks/session-register.sh, field `lstart`). `kill -0` answers "is
  # SOME process holding this pid", never "is THAT process still this session" — and a row is
  # retained for CC_REG_RETAIN_H (24h) after its session dies, so the recycled-pid window IS the
  # retention window. Re-read the pid's own start time and require it to match what the writer
  # recorded; this is `bin/cc-pane-headless:86-92` is_live() and `hooks/session-beat.sh:72-82`,
  # which have keyed identity on (pid,lstart) all along — cc-registry was simply not reached by it.
  #
  # It matters most for the row DIRECTLY BELOW: a pane row has the live-pane cross-check as a second
  # opinion, but a `surface:headless` row deliberately skips that check (a pane list can only MISS a
  # headless address), so without this field its liveness rests on `kill -0` alone.
  #
  # FAIL-OPEN TWICE, and the two cases are different facts: a row with no `lstart` predates the
  # writer's field and must behave exactly as it did before (never convict on a value nobody wrote);
  # an unreadable `ps` is not proof of death either, so a hiccup must not reap a live session. Only a
  # start time that is READ and DIFFERS convicts. The fork is paid only for a row whose pid is still
  # alive — a dead-pid row already short-circuited above — so it costs at most one `ps` per live
  # session, on a lister that already spends 2-3 `jq` forks per row.
  if [ "$stale" = 0 ] && [ -n "$pid" ]; then
    rec_lstart=$(jq -r '.lstart // ""' "$f" 2>/dev/null)
    if [ -n "$rec_lstart" ] && ! reg_lstart_matches "$rec_lstart" "$pid"; then stale=1; fi
  fi
  # The pane cross-check is asked ONLY of rows a terminal can enumerate. A headless row's address
  # is never in `it2 session list` — that list can only ever MISS it — so applying the check would
  # mark every headless session stale the instant it registered and hide it from the addressing
  # view, which is the same false death the registration fix removed, one layer down
  # (backlog 4b9d5e93b40a; fleet memory: lookup-miss-is-not-absence). `surface` is recorded by the
  # writer, which is the only party that knows it; an old or provisional row carries no such field
  # and reads as "pane" here, i.e. unchanged behaviour. Liveness for a headless row therefore rests
  # on `kill -0` above, exactly as it does for a pane row whose terminal is unreadable.
  # The membership test is a HERESTRING, not `printf … | grep -q`. Under `set -o pipefail` the -q
  # exits on the first hit, the producer takes SIGPIPE, and the pipeline adopts that status — the
  # verdict inverts on exactly the input it matched (fleet memory:
  # grep-q-under-pipefail-inverts-the-verdict; scripts/pipefail-sigpipe-lint.sh grandfathered this
  # one site). It is removed here rather than merely moved: adding the surface guard as a line
  # continuation had pushed the producer off the statement head, where the lint's detector could no
  # longer see it — the census read 0 while the hazard was still in the file, and lowering the
  # allowlist to match would have made a live site permanently invisible.
  surface=$(jq -r '.surface // "pane"' "$f" 2>/dev/null)
  if [ "$surface" != headless ] && [ "$have_panes" = 1 ] \
     && ! grep -qxF -- "$uuid" <<<"$live_panes"; then stale=1; fi

  if [ "$stale" = 1 ]; then
    # RETENTION, not liveness: keep the evidence for the investigation window, then reap.
    started=$(jq -r '.startedAt // 0' "$f" 2>/dev/null); started=$(( ${started:-0} / 1000 ))
    if [ "$started" -gt 0 ] && [ $(( now - started )) -gt "$RETAIN_S" ]; then
      rm -f "$f" 2>/dev/null
    else
      dead+=("$f")
    fi
    continue
  fi
  live+=("$f")
done
# --all → live + retained-dead (the forensic view). Default → live only (addressing view).
if [ "${ALL:-0}" = 1 ]; then live+=("${dead[@]+"${dead[@]}"}"); fi

if [ "${#live[@]}" -eq 0 ]; then
  case "$MODE" in
    json)  echo '[]' ;;
    table) echo "(no live sessions registered)"; offbox_table ;;
    names) : ;;
  esac
  exit 0
fi

case "$MODE" in
  json)  jq -s '.' "${live[@]}" ;;
  names) jq -r '.name' "${live[@]}" ;;
  table)
    {
      printf 'NAME\tUUID\tACCOUNT\tAGE\tCWD\n'
      for f in "${live[@]}"; do
        jq -r --argjson now "$now" '
          (($now - ((.startedAt // 0) / 1000)) | floor) as $age |
          ( if   $age < 60    then "\($age)s"
            elif $age < 3600  then "\(($age / 60)    | floor)m"
            elif $age < 86400 then "\(($age / 3600)  | floor)h"
            else                   "\(($age / 86400) | floor)d" end ) as $ago |
          [ .name, .paneUUID, .account, $ago, .cwd ] | @tsv
        ' "$f"
      done
    } | { if command -v column >/dev/null 2>&1; then column -t -s "$(printf '\t')"; else cat; fi; }
    offbox_table
    ;;
esac
exit 0
