#!/usr/bin/env python3
"""kitty-pane-menu — iTerm2-parity "Move Session to…" via right-click, for kitty.

WHY THIS EXISTS
    iTerm2's session right-click menu offers "Move Session to Split Pane" / "Move Session to
    Window" — point-and-click relocation, no drag required. kitty has no built-in equivalent:
    its own right-click is a single fixed action (paste_from_selection), and there is no config
    option that turns it into a menu. So the menu is built outside kitty entirely, driven over the
    remote-control socket, bound in place of the default right-click.

TWO TIERS, cursor-anchored NSMenu first, centered dialog as the fallback
    kitty-pane-menu-native (compiled from the sibling .swift file by kitty-setup.sh) pops a REAL
    NSMenu at the cursor — the actual iTerm2-style dropdown. Whether that renders when launched
    via kitty's `launch --type=background` was unverified when written (see the .swift header),
    so `choose_native()` below only trusts it if the round trip took long enough for a human to
    have actually seen and dismissed it — see NATIVE_MIN_MS. Missing/crashed/suspiciously-instant
    falls back to `choose()`, the AppleScript "choose from list" centered dialog (same technique
    as kitty-confirm-close's), which is guaranteed to work but is not the shape being asked for.

WHY cmd+right, NOT PLAIN right-click
    Most panes on this box run Claude Code, which enables mouse reporting — kitty's default
    right-click mapping is `ungrabbed`-only, so inside a live session the click is delivered to
    the app, never to kitty (same root cause as the cmd+left link fix in kitty.conf §6b: "DOES
    NOTHING" is the grabbed-mouse case, not a broken handler). cmd+right is bound
    `grabbed,ungrabbed` so it fires everywhere, mirrors the already-verified-free cmd+left, and
    leaves kitty's own plain-right-click paste intact for the panes where it still works.

WHAT THE MENU OFFERS (and where it routes)
    Paste                       kitty @ action paste_from_selection  — parity with the binding
                                 this replaces, so nothing is lost by adding the rest.
    Move to New Window           kitty @ detach-window (no --target-tab -> new OS window; this is
                                 kitty's own documented behaviour for an unspecified target).
    <what it is> — N panes,     kitty @ detach-window --target-tab id:<repr-window-of-that-tab>
      <desktops left|right>      for every OTHER os-window's active tab. --match on `id:` falls
                                 back from tab to the window's OWNING tab (kitty docs), so a
                                 representative window id is enough to name the tab.
                                 The ROW WORDING is the subject of describe_os_window() below and
                                 was rebuilt 2026-09-05 on an operator report that the old
                                 `Move to Window 36 — sevenrooms-bridge (claude) +4` was
                                 unpickable: `(claude)` was the tag on 17 of 18 live panes,
                                 `claude-infrastructure` was the cwd of three OS windows at once,
                                 and `+N` counted an arbitrary tab. Nothing in the row identified
                                 the window. It now leads with the string macOS itself paints on
                                 the Mission Control tile and ends with the swipe to reach it.
    Close Pane                   shells out to kitty-confirm-close (same busy-check + native
                                 dialog as ⌘W — this menu must not open a SECOND, weaker close
                                 path next to the one that already protects live Claude sessions).

    Split Right / Split Below are deliberately NOT offered here: cmd+d / cmd+shift+d already do
    this in one keystroke, and duplicating them in the menu is a second place for that binding to
    drift out of sync with the real one.

SOCKET PLUMBING is copied verbatim from kitty-confirm-close: a `--type=background` launch does
    not inherit KITTY_LISTEN_ON (measured), so the socket is re-derived from kitty.conf's own
    `listen_on` with PPID supplying the {kitty_pid}. `--check` prints that derivation and the menu
    it would have offered, and touches nothing.

WHY --self IS NOT ENOUGH FOR "MOVE TO WINDOW N"
    `kitty @ launch --self` anchors a NEW split to the calling pane's TAB — proven fix for the
    2026-08-05 crash-recovery bug (resumed sessions landing in kitty's globally-active tab instead
    of the caller's). `detach-window --target-tab` solves the DIFFERENT problem this menu exists
    for: relocating an EXISTING pane to an ARBITRARY other tab, which --self cannot express (it
    only ever means "my own tab"). Two different anchors for two different operations — see
    bin/kitty-split-launch.sh for the --self-based one.
"""

from __future__ import annotations

import glob
import json
import os
import plistlib
import re
import stat
import subprocess
import sys
import time
import unicodedata
from collections import Counter

HERE = os.path.dirname(os.path.abspath(__file__))
KITTY_ICON = "/Applications/kitty.app/Contents/Resources/kitty.icns"


def log_pane_spawn(surface: str, backend: str, pane: str, detail: str) -> None:
    """One row per pane this menu CREATES (item 1467ea1dad4f).

    Shells out to scripts/lib/pane-spawn-log.sh's CLI mode rather than re-implementing the row
    here: the log has exactly one writer, so a schema change cannot land on the bash sites and
    miss this one. CC_SPAWN_CALLER attributes the row to this file, not to the logger.

    Best-effort and bounded: a menu action must never fail on its own bookkeeping, and this runs
    under kitty's `launch --type=background` where a hang would be invisible.
    """
    for cand in (
        os.path.join(HERE, "..", "scripts", "lib", "pane-spawn-log.sh"),
        os.path.join(
            os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude")),
            "scripts", "lib", "pane-spawn-log.sh",
        ),
        os.path.expanduser("~/.claude/scripts/lib/pane-spawn-log.sh"),
    ):
        if not os.path.isfile(cand):
            continue
        env = dict(os.environ, CC_SPAWN_CALLER="kitty-pane-menu")
        try:
            subprocess.run(
                ["/bin/bash", cand, "log", surface, backend, pane, os.getcwd(), detail],
                env=env, timeout=10,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
            )
        except Exception:
            pass
        return

# The compiled Swift helper (bin/kitty-pane-menu-native.swift, built by kitty-setup.sh) pops a
# REAL NSMenu at the cursor — the actual iTerm2-style dropdown, not this file's AppleScript
# "choose from list" centered dialog. Whether it renders at all when spawned via kitty's
# `launch --type=background` (as opposed to a synthetic test invocation) was UNVERIFIED at write
# time — see the .swift file's header for why. _NATIVE_UNAVAILABLE is the sentinel for "couldn't
# even try it, or good reason to believe it silently failed" — distinct from `None`, which means
# the native menu genuinely DID show and the user dismissed it without picking (a legitimate
# no-op, not a reason to fall back to the dialog).
_NATIVE_UNAVAILABLE = object()
NATIVE_BIN = os.path.join(HERE, "kitty-pane-menu-native")
# A human cannot see a menu, decide, and click (or hit Escape) in under this many milliseconds —
# so a faster round trip means the menu never actually rendered, not that it was dismissed
# instantly. This is the ONLY signal available from outside the process: NSMenu.popUp's own
# return value is NO for both "dismissed without a pick" and "never shown", so it cannot
# discriminate the two cases itself (see the .swift file's `shown=` diagnostic, which is
# informational only for the same reason).
NATIVE_MIN_MS = 150


# ── the control-socket address ───────────────────────────────────────────────────────────────────
#
# Still copied verbatim from kitty-confirm-close — read that file's block for the full argument.
# The short version: the TEMPLATE comes from kitty.conf's `listen_on`, because that is the SSOT for
# where the socket is and a hardcoded `/tmp/kitty-<pid>` agrees with the shipped conf right up until
# it is retuned. PPID still supplies the {kitty_pid}; the conf supplies the directory and the name.
# The duplication is deliberate (bin/ is per-file symlinks; a brand-new shared module is the one
# file class observed to rot out of the live layer) and is held in agreement BEHAVIOURALLY by
# tests/kitty-socket-address.bats, which drives this file, kitty-confirm-close and cc-url-open
# through one table of confs.
KITTY_PID = "{kitty_pid}"
DEFAULT_LISTEN_ON = "unix:/tmp/kitty-{kitty_pid}"
_LISTEN_ON = re.compile(r"[ \t]*listen_on[ \t]+([^#]*)")


def kitty_conf() -> str:
    return os.environ.get("CC_KITTY_CONF") or os.path.expanduser("~/.config/kitty/kitty.conf")


def listen_on_template() -> str:
    """kitty.conf's `listen_on`, last value winning (kitty's own option semantics), trailing comment
    dropped, whitespace stripped — or the string this file used to hardcode, so an absent or
    unreadable conf leaves it no less capable than before it read confs at all."""
    tmpl = ""
    try:
        with open(kitty_conf(), encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = _LISTEN_ON.match(line)
                if m:
                    value = "".join(m.group(1).split())
                    if value:
                        tmpl = value
    except OSError:
        pass
    return tmpl or DEFAULT_LISTEN_ON


def _socket(path: str) -> str | None:
    try:
        if stat.S_ISSOCK(os.stat(path).st_mode):
            return f"unix:{path}"
    except OSError:
        pass
    return None


def socket_address() -> str | None:
    env = os.environ.get("KITTY_LISTEN_ON", "")
    if env and not env.startswith("fd:"):
        return env

    tmpl = listen_on_template()

    # `tcp:` and a Linux abstract `unix:@name` have no socket FILE; the mode test is structurally
    # blind to them and would reject a LIVE address. `kitty @` is the arbiter for those.
    if not tmpl.startswith("unix:/"):
        return tmpl

    path = tmpl[len("unix:") :]
    found = _socket(path.replace(KITTY_PID, str(os.getppid())))
    if found:
        return found

    if KITTY_PID not in path:
        return None  # one literal path, already tried — nothing left to search

    shape = re.compile(re.escape(path).replace(re.escape(KITTY_PID), r"\d+"))
    addrs = [
        addr
        for addr in (
            _socket(p)
            for p in sorted(glob.glob(path.replace(KITTY_PID, "*")))
            if shape.fullmatch(p)
        )
        if addr
    ]
    return addrs[0] if len(addrs) == 1 else None


ADDRESS = socket_address()


def kitty(*args: str) -> subprocess.CompletedProcess:
    cmd = ["kitty", "@", *args]
    if ADDRESS:
        cmd += ["--to", ADDRESS]
    return subprocess.run(cmd, capture_output=True, text=True)


def load(*match: str) -> list:
    r = kitty("ls", *match)
    if r.returncode != 0 or not r.stdout.strip():
        return []
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return []


def focused_window_id(tree: list) -> int | None:
    # Same two-pass fallback as kitty-confirm-close: `recent:0` is kitty's own answer for "the
    # window that was just focused" (the click focuses its window before the mapping runs), the
    # full-tree is_focused/is_active scan is the backstop when kitty is not the frontmost app.
    for src in (load("--match", "recent:0"), tree):
        for osw in src:
            for tab in osw.get("tabs", []):
                for w in tab.get("windows", []):
                    if w.get("is_focused"):
                        return w["id"]
        for osw in src:
            if src is tree and not osw.get("is_active"):
                continue
            for tab in osw.get("tabs", []):
                for w in tab.get("windows", []):
                    if w.get("is_active"):
                        return w["id"]
    return None


def owning_os_window_id(tree: list, wid: int) -> int | None:
    for osw in tree:
        for tab in osw.get("tabs", []):
            for w in tab.get("windows", []):
                if w["id"] == wid:
                    return osw["id"]
    return None


# ── IDENTITY: what a window IS, in the words the operator is already reading ─────────────────────
# The row's job is to match a string ALREADY in the operator's visual field. On this box that
# string is the OS-window title: macOS paints it on the Mission Control tile, and kitty paints it
# in the tab bar. The old label used neither — it used basename(cwd) + the foreground process, and
# `claude` is the process tag on 17 of 18 live panes while `claude-infrastructure` is the cwd of
# three OS windows at once, so most rows rendered the same two tokens. That is the operator's
# complaint (2026-09-05) reduced to its cause: the row carried almost no bits.
#
# `+N` is deleted rather than fixed. It counted "panes in tabs[0] minus one", and the tab it picked
# was arbitrary: `tab.is_focused` is False for EVERY tab in a `kitty @ ls` tree unless that OS
# window is the frontmost one, so the `next(... is_focused ...)` selector fell through to tabs[0]
# on 100% of targets. Absolute panes across all tabs replaces it.

_SPINNER = re.compile(r"^(?:[^\x00-\x7F\w]\s*)+")
# Claude Code's own busy/idle glyphs. Matched by SHAPE, never by an enumerated ✳ ◐ ◑ list — that
# set belongs to Claude Code and a hardcoded list rots on its next frame. Stripping matters for
# more than looks: `◐ X` and `◑ X` are ONE pane sampled seconds apart, so an unstripped title
# manufactures spurious distinct strings and defeats the collision check below. The pattern
# deliberately does not eat a leading `~` or `/`, which the path test still needs to see.
_DEGEN = {"claude code", "claude", ""}
_IDENT_BUDGET = 34


def _title_body(raw: str) -> str:
    """Title with control characters dropped, the spinner run stripped, whitespace collapsed."""
    s = "".join(c for c in (raw or "") if unicodedata.category(c)[0] != "C")
    return re.sub(r"\s+", " ", _SPINNER.sub("", s)).strip()


def _usable_title(raw: str, cwd: str = "") -> str:
    """'' when the title carries no bits, else the cleaned title.

    Three exclusions, all exact rather than heuristic: the degenerate values Claude Code shows
    before it has a task, a path-shaped title (what shell integration writes when no command is
    running), and a title that merely restates its own directory — the last one stops a row from
    saying the same thing twice. A real command title (`pnpm test`) is kept; it is information."""
    b = _title_body(raw)
    if b.casefold() in _DEGEN or b.startswith(("/", "~", ".")):
        return ""
    stem = (cwd or "").rstrip("/")
    if b == stem or b == os.path.basename(stem):
        return ""
    return b


def _clip(s: str, n: int = _IDENT_BUDGET) -> str:
    """Word-aware clip, ellipsis charged against the budget. Tail-truncated because these are
    natural-language task summaries whose FIRST words carry the topic."""
    if len(s) <= n:
        return s
    cut = s[: n - 1]
    sp = cut.rfind(" ")
    if sp >= n // 2:
        cut = cut[:sp]
    return cut.rstrip(" /,.;:-—·") + "…"


def _true_cwd(w: dict) -> str:
    """The CLAUDE process's cwd, not the shell's. They diverge in worktree panes — kitty reports
    the directory the pane was launched in, the registry reports where the session actually is."""
    try:
        reg = os.path.expanduser(f"~/.claude/cc-registry/{w['id']}.json")
        with open(reg) as fh:
            return json.load(fh).get("cwd") or ""
    except Exception:
        return w.get("cwd") or ""


def _dir_set(panes: list, limit: int = 2) -> list[str]:
    """Unique directory basenames in the window, oldest pane first."""
    seen: set[str] = set()
    out: list[str] = []
    for w in sorted(panes, key=lambda w: w.get("created_at") or 0):
        b = os.path.basename((_true_cwd(w) or "").rstrip("/"))
        if b and b not in seen:
            seen.add(b)
            out.append(b)
    return out[:limit]


def describe_os_window(osw: dict, mc_name: str) -> tuple[str, str]:
    """(ident, source). The ladder, in order, every rung verified against the live tree:

    1. The Mission Control name — kCGWindowName for this window, exactly what macOS paints on the
       tile. Usually byte-identical to kitty's own title, but NOT always: bin/cc-resume-layout.sh
       launches crash-recovery windows with --os-window-title, which overrides the app permanently,
       and for those macOS says `CC-RESUME-W1` where kitty still says the app's stale task summary.
       The tile is what the operator looked at, so the tile wins.
    2. No probe (SPI gone, timeout, crash) — the active pane's own kitty title. Same string in the
       normal case, and it costs nothing because the tree is already loaded.
    3. Degenerate title — the OLDEST pane that has a usable one. Oldest, not active, because the
       first pane in a window is the one whose task the operator named the window after; the newest
       is whatever they just split off. This is the rung that separates two windows both showing
       `Claude Code`, which is the exact case being guessed at today.
    4. Nothing usable anywhere — the SET of directories in the window, oldest first, capped at two.
       Last content-bearing discriminator, and safe as a fallback precisely because there is no
       directory column for it to duplicate.
    5. Nothing at all — the literal `new session`, which is true and says so.
    """
    panes = [w for t in osw.get("tabs", []) for w in t.get("windows", [])]

    u = _usable_title(mc_name)
    if u:
        return _clip(u), "kCGWindowName"
    for w in sorted(panes, key=lambda w: w.get("created_at") or 0):
        u = _usable_title(w.get("title") or "", w.get("cwd") or "")
        if u:
            return _clip(u), f"oldest-usable pane {w['id']}"
    dirs = _dir_set(panes)
    if dirs:
        return _clip(" / ".join(dirs)), "dir set"
    return "new session", "literal"


# ── WHERE: the swipe, in desktops, relative to the pane you right-clicked ────────────────────────
# Deliberately NOT an absolute `Desktop N`. Two measurements killed that: the one Mission Control
# tile actually captioned `Desktop` on this box holds no kitty window (six of seven Spaces are
# type=4 fullscreen tiles captioned with the window title), so `Desktop 4` would name a tile
# captioned something else entirely; and macOS INSERTS new fullscreen Spaces mid-array rather than
# appending, which renumbered three of five windows inside 40 minutes untouched. A relative
# direction needs no caption to exist and is recomputed at pop time, so it is correct at the only
# instant that matters — the click.


_PROBE_MARKER = b"KPM-WINDOWS-MODE-V1"


def native_supports_windows() -> bool:
    """True when the COMPILED helper on disk has --windows.

    Not a nicety. This file is a symlink into the checkout and goes live the instant a land
    fast-forwards; the helper beside it is a build artifact that only moves when
    scripts/kitty-setup.sh recompiles it. In that gap a new caller handing `--windows` to an old
    binary would get a one-item NSMenu reading "--windows" popped at the cursor on every
    right-click — the binary has no such mode and treats argv as titles. Grepping the marker out
    of the Mach-O costs one 57 KB read, needs no subprocess, and cannot be fooled by timing."""
    try:
        with open(NATIVE_BIN, "rb") as fh:
            return _PROBE_MARKER in fh.read()
    except OSError:
        return False


def reap_probe(proc) -> tuple[dict[int, tuple[int, int]], dict[int, str], str]:
    """Collect the Popen started before the tree fetch. (places, names, source). Bounded and
    fail-quiet: a cosmetic label may never hold the menu open, and a wrong SPI signature would
    segfault the CHILD — which arrives here as a non-zero exit and a dropped label, never a dead
    menu. That containment is the reason the probe is a subprocess at all."""
    if proc is None:
        return {}, {}, "none"
    try:
        out, _err = proc.communicate(timeout=0.4)
    except subprocess.TimeoutExpired:
        proc.kill()
        return {}, {}, "none"
    except OSError:
        return {}, {}, "none"
    if proc.returncode != 0:
        return {}, {}, "none"  # 2 = DLSYM-MISS: a future macOS dropped the SPI. Checkable.
    places: dict[int, tuple[int, int]] = {}
    names: dict[int, str] = {}
    for line in (out or "").splitlines():
        parts = line.split("\t", 4)
        if len(parts) < 5:
            continue
        try:
            pwid = int(parts[0])
        except ValueError:
            continue
        names[pwid] = parts[4]
        # A window with no Space is still NAMED — the two facts fail independently, and the name
        # is the one carrying the identification.
        if parts[2] != "-":
            try:
                places[pwid] = (int(parts[1]), int(parts[2]))
            except ValueError:
                pass
    return places, names, "cgs" if places else "none"


def space_probe_plist() -> dict[int, tuple[int, int]]:
    """Same map, from ~/Library/Preferences/com.apple.spaces.plist. In-process, 0.7 ms, no
    subprocess and no SPI — but it is a CACHE, not the live layout: measured 42 minutes stale, with
    three of five ordinals wrong against the live truth. Insertions preserve relative ORDER though,
    so every SIGN still matched. Hence the caller renders a direction word and never a count off
    this source. Monitors are enumerated separately: this box reports 14 monitor entries, and a
    flattened index would hand two windows the same ordinal the moment a second one holds Spaces."""
    try:
        path = os.path.expanduser("~/Library/Preferences/com.apple.spaces.plist")
        with open(path, "rb") as fh:
            data = plistlib.load(fh)
        monitors = data["SpacesDisplayConfiguration"]["Management Data"]["Monitors"]
    except Exception:
        return {}
    out: dict[int, tuple[int, int]] = {}
    for di, mon in enumerate(monitors, 1):
        for si, space in enumerate(mon.get("Spaces") or [], 1):
            tiles = (space.get("TileLayoutManager") or {}).get("TileSpaces") or []
            for tile in tiles:
                wid = tile.get("TileWindowID")
                if isinstance(wid, int):
                    out[wid] = (di, si)
    return out


def vector(target: tuple[int, int] | None, own: tuple[int, int] | None, exact: bool) -> str:
    """The direction clause. '' means 'say nothing', which the caller then applies to EVERY row —
    a half-numbered menu is a wrong swipe, and a wrong swipe is the failure being fixed."""
    if target is None or own is None or target[0] != own[0]:
        return ""  # different display: the ordinals are per-display and not comparable
    d = target[1] - own[1]
    if d == 0:
        return "here"
    side = "right" if d > 0 else "left"
    if not exact:
        return f"to the {side}"  # plist source: the sign survives staleness, the count does not
    n = abs(d)
    return f"{n} desktop{'' if n == 1 else 's'} {side}"


def other_targets(tree: list, self_osw_id: int, places: dict, mc_names: dict, exact: bool) -> list[tuple[int, str, str]]:
    """One row per OTHER os-window: (representative window id, label, ident source).

    The label is `<what it is> — <N panes>[, <direction>]`. There is no `Move to ` verb and no
    `Window N` head: both were 100% identical ink on every target row, and deleting them moves the
    first recognisable word to character 0, where the eye lands. The fixed items above still say
    `Move to New Window`, so the menu still reads as a move.

    ROUTE AND LABEL ARE SEPARATE and stay that way — the label describes the destination window,
    the route names the tab the pane actually lands in.
    """
    raw: list[tuple[int, dict, dict]] = []  # (osw_id, representative window, os-window)
    for osw in tree:
        if osw["id"] == self_osw_id:
            continue
        tabs = osw.get("tabs", [])
        # is_active before is_focused: `is_focused` is True only inside the frontmost OS window, so
        # on every OTHER window — i.e. every window this menu offers — the old is_focused-first
        # selector fell through to tabs[0] unconditionally. Verified against a live tree: all five
        # target tabs read focused=False.
        tab = next(
            (t for t in tabs if t.get("is_active")),
            next((t for t in tabs if t.get("is_focused")), tabs[0] if tabs else None),
        )
        if not tab or not tab.get("windows"):
            continue
        wins = tab["windows"]
        repr_w = next((w for w in wins if w.get("is_focused") or w.get("is_active")), wins[0])
        raw.append((osw["id"], repr_w, osw))

    own_place = places.get(next((o.get("platform_window_id") for o in tree
                                 if o["id"] == self_osw_id), None))

    rows: list[list] = []  # [osw_id, repr_wid, ident, panes clause, vector, source, panes]
    for osw_id, repr_w, osw in raw:
        panes = [w for t in osw.get("tabs", []) for w in t.get("windows", [])]
        ntabs = len(osw.get("tabs", []))
        ident, source = describe_os_window(osw, mc_names.get(osw.get("platform_window_id"), ""))
        clause = f"{len(panes)} pane" + ("" if len(panes) == 1 else "s")
        # `detach-window --target-tab` RAISES the destination tab, so a multi-tab destination
        # changes shape on arrival and the row has to say so. Latent while every window holds one.
        if ntabs > 1:
            clause += f" in {ntabs} tabs"
        rows.append([osw_id, repr_w["id"], ident, clause,
                     vector(places.get(osw.get("platform_window_id")), own_place, exact),
                     source, panes])

    # If ANY offered row could not be placed, the direction clause comes off ALL of them. A menu
    # where some rows carry a swipe and some do not reads as "the unmarked ones are here", which is
    # a wrong swipe — the failure this whole change exists to prevent.
    if any(not r[4] for r in rows):
        for r in rows:
            r[4] = ""

    def render(r: list) -> str:
        return f"{r[2]} — {r[3]}" + (f", {r[4]}" if r[4] else "")

    # Dispatch is exact-string first-match, so two identical labels are not a cosmetic problem —
    # they are a silent move to the wrong window. Two mechanical stages, both AFTER truncation, so
    # a clip can never create a misroute.
    counts = Counter(render(r) for r in rows)
    for r in rows:
        # Never when the ident already IS the directory set, or the row renders the same
        # directory twice.
        if counts[render(r)] > 1 and r[5] != "dir set":
            d = _dir_set(r[6], 1)
            if d and d[0] not in r[2]:
                r[2] = f"{r[2]} · {d[0]}"
    counts = Counter(render(r) for r in rows)
    for r in rows:
        if counts[render(r)] > 1:
            r[2] = f"{r[2]} · w{r[0]}"

    return [(r[1], render(r), r[5]) for r in rows]


def choose_native(items: list[str]):
    """Try the real NSMenu popup. Returns a picked title, None (shown + genuinely dismissed),
    or _NATIVE_UNAVAILABLE (missing/crashed/suspiciously-instant — caller should fall back)."""
    if not (os.path.isfile(NATIVE_BIN) and os.access(NATIVE_BIN, os.X_OK)):
        return _NATIVE_UNAVAILABLE
    start = time.monotonic()
    try:
        r = subprocess.run([NATIVE_BIN, *items], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return _NATIVE_UNAVAILABLE
    elapsed_ms = (time.monotonic() - start) * 1000
    if r.returncode != 0 or elapsed_ms < NATIVE_MIN_MS:
        return _NATIVE_UNAVAILABLE
    out = r.stdout.strip()
    return out or None


def choose(items: list[str]) -> str | None:
    applescript_list = ", ".join(
        '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"' for s in items
    )
    script = (
        'tell application "kitty" to activate\n'
        f'set r to (choose from list {{{applescript_list}}} '
        'with title "kitty" with prompt "Move pane to…")\n'
        'if r is false then return ""\n'
        "return item 1 of r"
    )
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    out = r.stdout.strip()
    return out or None


def refocus() -> None:
    subprocess.run(["osascript", "-e", 'tell application "kitty" to activate'], capture_output=True)


USAGE = "usage: kitty-pane-menu [--check]"


def main() -> int:
    # --check is the only safe way to inspect this on a REAL pane: it reports the socket derivation
    # and the menu the click would have raised, and pops nothing. Without it the sole diagnostic is
    # a stderr line from a `--type=background` child, i.e. a line on no screen at all.
    args = sys.argv[1:]
    check = "--check" in args
    if [a for a in args if a != "--check"]:
        print(USAGE, file=sys.stderr)
        return 2

    # Printed before the call that depends on it: a --check against a retuned or unreadable conf
    # must be able to explain the refusal it is about to report.
    if check:
        print(f"conf      : {kitty_conf()}")
        print(f"listen_on : {listen_on_template()}")
        print(f"address   : {ADDRESS}")

    # Fired BEFORE the tree fetch and reaped after it: the probe's 60-80 ms and `kitty @ ls`'s
    # 72-95 ms overlap almost entirely, so the marginal cost of the whole labelling change on the
    # menu's pop latency is far below either number on its own.
    probe = None
    if os.path.isfile(NATIVE_BIN) and os.access(NATIVE_BIN, os.X_OK) and native_supports_windows():
        try:
            probe = subprocess.Popen(
                [NATIVE_BIN, "--windows"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
            )
        except OSError:
            probe = None

    tree = load()
    if not tree:
        print(f"kitty-pane-menu: no reply from kitty (address={ADDRESS})", file=sys.stderr)
        return 3

    wid = focused_window_id(tree)
    if wid is None:
        print("kitty-pane-menu: no focused window — refusing to guess", file=sys.stderr)
        return 0

    places, mc_names, place_src = reap_probe(probe)
    if not places:
        # The plist is a stale CACHE of the same layout: insertions preserve relative ORDER but not
        # the counts, so this source yields a direction word and never a number.
        places = space_probe_plist()
        place_src = "plist" if places else "none"

    self_osw = owning_os_window_id(tree, wid)
    targets = (
        other_targets(tree, self_osw, places, mc_names, place_src == "cgs")
        if self_osw is not None
        else []
    )

    items = ["Paste", "Move to New Window"] + [label for _, label, _ in targets] + ["Close Pane"]

    if check:
        print(f"window    : {wid}")
        print(
            f"desktops  : {place_src} ({len(places)} window(s) placed)"
            + ("" if native_supports_windows() else "  [helper predates --windows; run kitty-setup.sh --apply]")
        )
        srcs = {label: src for _, label, src in targets}
        for item in items:
            print(f"item      : {item}" + (f"   [ident: {srcs[item]}]" if item in srcs else ""))
        return 0

    choice = choose_native(items)
    if choice is _NATIVE_UNAVAILABLE:
        choice = choose(items)
    if not choice:
        return 0  # cancelled (native: genuinely dismissed; dialog: Cancel/Escape)

    if choice == "Paste":
        kitty("action", "--match", f"id:{wid}", "paste_from_selection")
    elif choice == "Move to New Window":
        # `detach-window` with NO --target-tab CREATES an OS window, so this is a pane-spawn and it
        # gets a row like every other one (item 1467ea1dad4f). The --target-tab branch below only
        # RE-HOMES an existing window and deliberately does not log: one row per surface CREATED.
        log_pane_spawn("os-window", "kitty", str(wid), "kitty-pane-menu detach-window (new window)")
        kitty("detach-window", "--match", f"id:{wid}")
    elif choice == "Close Pane":
        subprocess.run([os.path.join(HERE, "kitty-confirm-close"), "window"])
    else:
        for target_wid, label, _src in targets:
            if label == choice:
                # The return code was discarded here. A destination that died between the pop and
                # the pick is real — the window population churns — and kitty reports it as
                # `No matching tabs for expression: id:N`, rc 1, which rendered as a pane that
                # simply did not move and no reason anywhere.
                r = kitty("detach-window", "--match", f"id:{wid}", "--target-tab", f"id:{target_wid}")
                if r.returncode != 0:
                    print(
                        f"kitty-pane-menu: move failed (rc {r.returncode}): "
                        f"{(r.stderr or '').strip() or 'no message'}",
                        file=sys.stderr,
                    )
                break

    refocus()
    return 0


if __name__ == "__main__":
    sys.exit(main())
