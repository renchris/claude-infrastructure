#!/bin/bash
# cc-cannot — three-valued answer to "can only a HUMAN run this command?"
#
# WHAT IT IS FOR. An agent about to hand the operator a copy-paste command is making a claim —
# "I cannot run this" — and until now that claim had no verifier. Every other load-bearing close
# claim on this machine has one: wrap-ledger will not take a session's word for "landed",
# completion-assert will not take it for "done", cc-backlog will not take `needs-human` without a
# conviction number. This is that producer for the hand-off claim.
#
# THREE VALUES, NEVER TWO.
#   HUMAN       an affirmation matched. A human at the keyboard is genuinely required.
#   REFUTED     a lookup contradicts the claim. Something that is not a human runs this.
#   UNRESOLVED  no lookup reached it. NOT a soft HUMAN and NOT a soft REFUTED — silence.
#
# POLARITY: every failure, every missing dependency, every unreadable file resolves to
# UNRESOLVED. A false REFUTED nags the operator over a real blocker and, per
# anti-deference-nudge.sh, "a nagging hook trains the model to route around it". A false HUMAN
# launders the defect. Ignorance buys neither.
#
# ── THE FOUR AMENDMENTS, each answering a defect reproduced against the frozen corpus ──
#
# A1  AFFIRM BEFORE REFUTE. Every HUMAN arm runs before every refutation arm. `sudo bash x.sh` is
#     a different call from the `bash x.sh` a session already ran, and `--apply` is a different
#     call from `--dry-run`. Without this ordering the corpus's single largest hand-off —
#     approval-queue-drain.sh, 270 emissions, 20% of everything — is refuted by its own authoring
#     session's receipt, because the script is DESIGNED to be agent-run first (its no-TTY branch
#     is how an agent enumerates the queue). The receipt that would convict it is produced by
#     using it correctly.
#
# A2  DURABLE-BASENAME RESOLUTION, BEFORE ANY REFUTATION. The acquitting evidence for a script
#     lives in its body; the convicting evidence lives in the durable transcript. 74.9% of named
#     scripts are already deleted from /tmp when the marker is emitted, so decay is ONE-DIRECTIONAL
#     — age strips acquittals only, and the gate gets more confident as it gets more wrong. When
#     the literal path is gone, the basename is resolved against a small durable set before any
#     refutation is allowed to fire. No copy found ⇒ UNRESOLVED, never REFUTED: a missing body
#     means the acquitting evidence is UNREADABLE, not ABSENT.
#
# A3  THE SLASH-COMMAND TEST IS ANCHORED AND IS A REGEX. The prior form was a bash glob,
#     `/[a-z][a-z0-9_-]*`, in which `*` matches `/` and spaces — so `/usr/bin/env <anything>`
#     acquitted, a universal one-token bypass wrapper. A TUI slash-command has exactly one path
#     segment.
#
# A4  RECEIPTS REQUIRE ARGV EQUALITY, NEVER A SIGNATURE. Matching on head+subcommand let a prior
#     read-only `aws amplify list-jobs` license `aws amplify start-job … RELEASE`, turning a read
#     into a money-spending production deploy; let `gh auth status` refute `gh auth refresh` (a
#     browser OAuth flow — the genuinely-human case this exists to protect); and let any prior
#     `git show` refute the sha citation CLAUDE.md mandates in every close (4,147 executions
#     across 742 sessions, i.e. essentially every compliant close). A signature may RULE OUT a
#     match. It may never assert one.
#
# ── WHAT THE MEASUREMENT CHANGED — read this before adding an arm ───────────────────────────────
# The first build of this script had two more arms and scored 71.0% distinct / 89.0% emission
# precision against the 429-command gold set. Unshippable. The fix was SUBTRACTION, not tuning:
#
#   config                                    distinct        emission
#   all arms (the original design)            71.3%           89.0%
#   − the broad `self-runnable` refutation    84.5%           96.7%
#   − and body-descent bounded to the guard   95.2%           98.9%   <- shipped
#
# The deleted arm matched `cc-[a-z-]+` and so refuted `cc-do`, `cc-decide answer|veto` and
# `cc-escalations ack` — the exact CLI family whose PURPOSE is that a human must act. It was a rule
# written from the shape of a name. Every arm below is a lookup over a closed set or a read of a
# file; none of them guesses. THE RULE FOR ADDING AN ARM: score it against the gold set first, and
# if it lowers precision it does not ship however sensible it reads.
#
# Usage:  cc-cannot [--quiet] [--why] -- <command>      (also reads the command on stdin)
# Output: <VERDICT>\t<class>\t<evidence>
# Exit:   0 HUMAN · 1 REFUTED · 2 UNRESOLVED (and every internal failure)
set -uo pipefail

QUIET=0
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --quiet) QUIET=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
CMD="${*:-}"
[ -n "$CMD" ] || CMD="$(cat 2>/dev/null || true)"
CMD="$(printf '%s' "$CMD" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

say() { [ "$QUIET" -eq 1 ] || printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }
human()     { say HUMAN      "$1" "$2"; exit 0; }
refuted()   { say REFUTED    "$1" "$2"; exit 1; }
unresolved(){ say UNRESOLVED "$1" "$2"; exit 2; }

[ -n "$CMD" ] && [ "${#CMD}" -le 8192 ] || unresolved empty "no command"

# The executable part: everything before the first unquoted shell operator. A chained command is
# judged on its FIRST segment; a later segment cannot acquit the whole line.
HEAD_SEG="$(printf '%s' "$CMD" | sed 's/[[:space:]]*\(&&\|;\||\).*$//')"
# …but a HUMAN signature ANYWHERE in the line still binds: `x && sudo y` needs the password.

# ── R0 · READ-ONLY UNDER AN IMPERATIVE MARKER — the one arm measured at 100% ──────────────────
# THIS ARM ASKS A DIFFERENT QUESTION FROM EVERY OTHER ARM, AND THAT IS WHY IT WORKS.
# The rest of this script tries to answer "does a human have to run this?", which is a property of
# the world and is not visible in the command — measured 71.0% precision, unshippable. This arm
# asks "does this command CHANGE anything?", which is a property of a CLOSED SET and is trivially
# decidable. Scored against the full 429-command gold set: 42 distinct / 147 emissions matched,
# 147 gold-INADMISSIBLE, ZERO false positives.
#
# Why a read-only command under `▶ Run this:` is ALWAYS a defect, with no exception to carve:
#   · the marker means "run this" — CLAUDE.md § Manual-Command Delivery makes position, not
#     styling, the discriminator between an instruction and a reference;
#   · if the operator only needs the ANSWER, the agent could have run it and reported the answer;
#   · if it is a pointer for later, the same rule puts it in inline backticks mid-sentence.
#   There is no version of `cc-blockers` that needs the operator's hands.
# The set stays CLOSED and is extended only with a command proven non-mutating. `--web`, `--fix`,
# `--apply`, `--write`, `--execute`, a redirect, a pipe-to-shell or a chain disqualifies a match:
# `gh pr view --web` opens a browser and `git show … && rm …` is not a read.
RO_RE='^(cc-blockers|cc-mission[[:space:]]+next|cc-do[[:space:]]+--list|cc-[a-z-]+[[:space:]]+(list|status|show|view|next)([[:space:]]|$)|git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+(show|log|status|diff|ls-tree|rev-parse|branch|remote|cherry)([[:space:]]|$)|gh[[:space:]]+(pr|issue|run)[[:space:]]+(view|list|status)([[:space:]]|$)|(cat|head|tail|less|bat)[[:space:]]|(grep|rg|find|ls|jq)[[:space:]]|(cursor|code|subl)[[:space:]]+[^[:space:]]+$)'
RO_MUT='(--web|--fix|--apply|--write|--execute|>[[:space:]]*[^[:space:]]|\|[[:space:]]*(sh|bash)([[:space:]]|$)|&&)'
if printf '%s' "$CMD" | grep -Eq "$RO_RE" && ! printf '%s' "$CMD" | grep -Eq "$RO_MUT"; then
  refuted read-only "this command changes nothing — run it and report the answer, or cite it mid-sentence; the marker means 'run this'"
fi

# ── A3 · TUI slash-command: exactly one path segment, anchored ───────────────────────────────────
if printf '%s' "$CMD" | grep -Eq '^/[a-z][a-z0-9_-]*([[:space:]]|$)'; then
  human tui "a slash-command; the agent has no keystroke channel to its own composer"
fi

# ── sudo — but only where a password would actually be demanded ─────────────────────────────────
# NOTE — THIS ARM DELIBERATELY DOES NOT PROBE. The obvious refinement is `sudo -n true`, to tell a
# password gate from an existing NOPASSWD rule. It cannot work here and must not be attempted:
# `Bash(sudo:*)` is a permissions.deny rule on this machine, so the probe is refused before macOS
# ever evaluates it — it resolves nothing, and measured 2026-09-12 it HANGS this script under that
# gate. The answer is the same either way: a password prompt and a policy denial are both gates the
# agent cannot clear. The policy arm is undetermined BY CONSTRUCTION and must not be resolved by
# the one route that would work — editing our own allowlist — which three independent arms refuse.
if printf '%s' "$CMD" | grep -Eq '(^|[[:space:]]|\||&|;)sudo([[:space:]]|$)'; then
  human sudo "sudo — a password prompt or a policy denial; both are gates the agent cannot clear (probe deliberately omitted, see source)"
fi

# ── physical world ──────────────────────────────────────────────────────────────────────────────
printf '%s' "$CMD" | grep -Eq '^open[[:space:]]+(tel:|sms:|facetime:|mailto:)' \
  && human physical "places a call/message through a device app"

# ── interactive credential flows ────────────────────────────────────────────────────────────────
printf '%s' "$CMD" | grep -Eqi '(^|[[:space:]])(gcloud[[:space:]]+auth[[:space:]]+login|aws[[:space:]]+sso[[:space:]]+login|gh[[:space:]]+auth[[:space:]]+(login|refresh)|op[[:space:]]+signin|/login|claude[[:space:]]+/login)([[:space:]]|$)' \
  && human login "an interactive credential flow — browser and/or a second factor"

# ── A2 · script-body descent, and it runs BEFORE any refutation (A1) ────────────────────────────
# Signatures that make a body human-bound. Closed set, extended only with a measured case.
HC_BODY_RE='/dev/tty|read -s|read -r -s|read .*-p .*</dev/tty|stty -echo|sudo |osascript .*display dialog|security unlock-keychain'
DURABLE_DIRS=(
  "$HOME/.claude/autonomy" "$HOME/.claude/scripts" "$HOME/.claude/bin"
  "$HOME/Development/claude-infrastructure/scripts"
  "$HOME/Development/claude-infrastructure/bin"
  "$HOME/Development/claude-infrastructure/migrations"
)
SCRIPTS="$(printf '%s' "$CMD" | tr ' ;|&()' '\n' | grep -E '\.(sh|py)$' || true)"
if [ -n "$SCRIPTS" ]; then
  RESOLVED=""; MISSING=""
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    p="${s/#\~/$HOME}"
    if [ -f "$p" ]; then RESOLVED="$RESOLVED$p"$'\n'; continue; fi
    base="$(basename "$s")"; found=""
    for d in "${DURABLE_DIRS[@]}"; do
      [ -f "$d/$base" ] && { found="$d/$base"; break; }
    done
    if [ -n "$found" ]; then RESOLVED="$RESOLVED$found"$'\n'; else MISSING="$MISSING$base "; fi
  done <<< "$SCRIPTS"

  while IFS= read -r p; do
    [ -n "$p" ] || continue
    # A2b — THE SIGNATURE MUST BE A GATE, NOT AN INCIDENTAL MATCH. Measured: every
    # handoff-fire.sh --recycle in the corpus was wrongly called HUMAN because that 4,000-line
    # orchestrator contains /dev/tty handling for the panes it DRIVES. approval-queue-drain.sh is
    # the contrasting case: its /dev/tty is at :46, guarding its own entry. A guard runs before the
    # work, so it lives near the top; incidental terminal handling lives wherever the work is.
    if head -80 "$p" 2>/dev/null | grep -Eq "$HC_BODY_RE"; then
      hit="$(head -80 "$p" 2>/dev/null | grep -Eom1 "$HC_BODY_RE")"
      human tty "$(basename "$p") body carries '${hit}' — it needs a live terminal or a password"
    fi
  done <<< "$RESOLVED"

  # A2's refusal clause: a body we could not read is UNREADABLE evidence, never absent evidence.
  [ -n "$MISSING" ] && unresolved script-gone "cannot read ${MISSING%% } — no durable copy; acquitting evidence is unreadable, not absent"
fi

# ── refutation · scheduler-owned (composes with cc-owner, never duplicates it) ──────────────────
CC_OWNER="$HOME/.claude/bin/cc-owner"
[ -x "$CC_OWNER" ] || CC_OWNER="$HOME/Development/claude-infrastructure/bin/cc-owner"
if [ -x "$CC_OWNER" ]; then
  if owner="$("$CC_OWNER" "$CMD" 2>/dev/null)" && [ -n "$owner" ]; then
    refuted scheduler-owned "$(printf '%s' "$owner" | sed -n '2p' | sed 's/^[[:space:]]*//')"
  fi
fi

# ── refutation · opens a file the agent could simply read ───────────────────────────────────────
printf '%s' "$HEAD_SEG" | grep -Eq '^(cursor|code|subl|vim|nano)[[:space:]]+[^[:space:]]+$' \
  && refuted readable "opens a file in an editor; the agent can read that file directly"

unresolved no-lookup "no affirmation and no refutation reached this command"
