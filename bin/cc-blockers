#!/usr/bin/env bash
# cc-blockers — operator ONE-GLANCE view of SAFEGUARD-BLOCKED fired peers.
#
#   cc-blockers [--json]
#
# Reads the shared desk board ($CC_REAPER_IDL, default ~/.claude/autonomy/idl.jsonl) for the
# kind=="safeguard-blocked" rows cc-reaper writes when a fired peer is refused by model content-
# safeguards on arrival, and shows the LATEST row per pane: which slug, which account + blocked model,
# the refusal text, and the exact recovery command. READ-ONLY — it renders the board, never acts
# (recovery is cc-recover-safeguard, the operator's explicit call). Robust to the shared board's mixed
# actors + any malformed line (fromjson? skips non-object / unparseable rows).
#
# ALSO renders kind=="relogin-blocked" — the class-C row cc-relogin-poll raises when an account's
# login renewal escalates (T-48h with no k==0 window found). Same discipline: LATEST row per acct,
# read-only, and each row's recover_cmd is printed as the EXACT runnable command, never paraphrased.
# …with ONE drop rule: a relogin row whose .deadline is EARLIER than that account's LIVE
# login_expires_at is STALE BY CONSTRUCTION and is not rendered (see drop_stale_relogin below).
#
# ALSO renders three LAND-PIPELINE alarms (LAND_PIPELINE_V2 §4.4) that are NOT board rows: they are
# fact-bound DISK reads, computed here every invocation.
#   kind=="verifier-inert"  NEVER-ACTIVATED (no stamps dir has ever existed — an un-run C10 step)
#                           or STALE (stamps stopped while land.log kept moving)
#   kind=="trunk-red"       the verifier is ALIVE (stamping fresh, OR provably mid-run) and NOT ONE
#                           of the newest N verdicts is green, with no green in 24h. Two states, on
#                           the SAME predicate: PERSISTENT-RED when all N are literally red;
#                           PERSISTENT-NOT-GREEN when the window mixes red with non-verdicts (cut /
#                           hung). Deliberately a distinct kind, not a verifier state: nothing is
#                           wrong with the verifier, and the fix is the opposite one
#                           (partition/attribution).
#                           POLARITY (OPERATOR_SURFACE_V2 §4 M1, row 12's close addendum, ruled row
#                           10's). This used to test `red == seen`, i.e. equality against ONE named
#                           failure — so a single cut/hung stamp anywhere in the window DISABLED the
#                           alarm that exists to catch exactly this state. Live on 2026-07-29 the
#                           newest five were red/hung/red/red/red: seen=5, red=4, and the row was
#                           SUPPRESSED while 0 of 33 stamps had EVER been green. The campaign is
#                           right that a non-verdict is not a RED — that is a verdict vocabulary,
#                           row 1's, and it is untouched here. It INVERTS inside an alarm, because a
#                           hung run is WORSE than a red one for "is trunk persistently failing".
#                           For a VERDICT ask "is it red?"; for an ALARM ask "is it green?".
#                           Kill switch: CC_BLOCKERS_ALARM_POLARITY=legacy restores `red == seen`.
#   kind=="deploy-lag"      LAGGING — a GREEN-stamped commit has sat undeployed past the budget
#   kind=="deploy-stale"    NOT-ADVANCING — the live layer is behind trunk past
#                           CC_DEPLOY_MAX_LAG_COMMITS (25) or CC_DEPLOY_MAX_LAG_HOURS (6) and has
#                           not moved within that window. Keyed on the LAG ITSELF, never on which
#                           refusal fired, and — alone among the deploy rows — on nothing the stamp
#                           cursor does. deploy-lag and never-green cover the two ENDPOINTS of the
#                           cursor axis (a green AHEAD of live HEAD; no green EVER) and the state
#                           between them was covered by nothing: see deploy_stale_rows().
#   kind=="never-green"     NEVER-CERTIFIED — the BACKSTOP. The verifier runs and returns verdicts,
#                           but not one has EVER been green, so `last-green` was never written and
#                           deploy has no cursor at all. None of the three above can see this state
#                           (deploy-lag needs a green to call late, verifier-inert needs a dead job,
#                           trunk-red abstains on any non-red verdict in its window) — so the board
#                           was SILENT through 53 commits of halted deploy. Emitted only when no
#                           sharper row already claimed the reason.
# The three are mutually exclusive by construction on the verifier-ALIVE axis: STALE needs a stamp
# past the budget AND no run in progress, PERSISTENT-RED needs a fresh stamp OR a run in progress.
# Stamp age alone was the original axis and it was WRONG — a stamp is only written when a run ENDS,
# so a slow-but-healthy verifier read as inert and suppressed the red row (see verifier_running()).
# All exist because a launchd job dies
# SILENTLY: absence must be loud (R9), never assumed healthy. Every sensor failure — no stat(1), no
# git, an unparseable stamp, no clock — yields NO row (fail-OPEN): a board that invents blockers
# gets ignored exactly like one that hides them.
#
# ALSO renders the DISPATCH alarm (AUTONOMY_DISPATCH_V2 §3 S8) on the same law and the same two
# shapes as verifier-inert above — same idiom, deliberately not a new one:
#   kind=="dispatch-inert"  NOT-ACTIVATED (the label is unloaded, or loaded but sitting in launchd's
#                           disabled DB — an un-run C10 hand-step, an OPERATOR QUEUE ITEM and not a
#                           stall), STALE (the label IS loaded+enabled yet the newest cc-dispatch
#                           decision is older than CC_DISPATCH_STALE_H), or SATURATED (it is deciding
#                           on time, but has admitted NOTHING for CC_DISPATCH_SATURATED_H while
#                           deferring at the ceiling — §5 F16 / §7 A13).
# NOT-ACTIVATED is terminal for STALE: a job that is not running cannot be late. Both are gated on
# EXISTENCE EVIDENCE — >=1 actor=="cc-dispatch" record in the journal, i.e. the dispatcher has
# demonstrably run on this host — because "it stopped" is only an alarm where it was SUPPOSED to be
# running; without that gate this fires in every fixtured $HOME void and on every machine that never
# had the spine. It exists because both labels sat disabled for ~3 days, with no log files and no
# decision records, and nothing said so.
# ALSO renders two APPROVAL-REACHABILITY alarms (cc-backlog 1e16815bac51), same law again — both
# answer "can an approval request actually REACH an approver?", which the board could not ask before:
#   kind=="orphaned-approver"  LEAD-DEAD (the team's lead process is gone) or LEAD-RESTARTED (a live
#                              lead, but assignees OLDER than it — a resume restores the session and
#                              never the team channel), with >=1 LIVE assignee still running. Such an
#                              assignee's approval request routes to a process that cannot answer and
#                              waits FOREVER with no prompt ever rendered; this is the fail-OPEN to
#                              the operator. Predicate is process AGE, not lead liveness — see the
#                              function, where "is the lead alive" false-negatives the real incident.
#   kind=="beacon-inert"       NOT-WIRED (hooks/cc-permission-beacon.sh is registered in NO
#                              settings.json — an un-run C10 hand-step) or NEVER-FIRED (wired, yet
#                              the beacon dir has never existed). Without it an EMPTY beacon dir and
#                              a beacon that never ran are the same observation and the board reports
#                              all-clear for both — which is exactly what it did while a teammate sat
#                              blocked. NOT-WIRED is terminal for NEVER-FIRED.
#
# ALSO renders the FLEET alarm (DAEMON_FLEET_V2 §4.3) — the reconciler's rows, passed through:
#   kind=="fleet-inert"     one row per DECLARED launchd label that is not in its declared state
#                           (NOT-INSTALLED / DISABLED / NEVER-RAN / FAILING / STALLED / UNDECIDED),
#                           plus an UNDECLARED-SUMMARY for live labels the manifest never declared.
# This file does NOT compute those states: bin/cc-fleet owns the manifest and the reconcile, and its
# lines pass straight through (one board, ONE renderer). Overlap with a dispatch-inert row on the
# same label is intentional, not a bug to dedupe: the specific row carries meaning a generic
# reconciler cannot express (trunk-red is a TRUNK problem, not a daemon one), and the fleet row is
# the FLOOR that guarantees every declared label at least one honest verdict (R2). An absent,
# non-executable, failing or garbage-emitting cc-fleet yields NO rows and NO error (R5, fail-OPEN) —
# and, load-bearing, cannot take the land-pipeline or dispatch rows down with it.
#
# `--plist-parity` is a SEPARATE leg (DAEMON_FLEET_V2 §4.4), deliberately NOT part of the default
# board: it compares the repo SSOT launchd/com.claude.*.plist against the live
# ~/Library/LaunchAgents copies and emits kind=="plist-parity" rows in three classes —
#   LIVE-ONLY      installed but never committed: one `rm` from unrecoverable (5 calendar
#                  LaunchAgents were destroyed 2026-07-25 by a stray in-place rewrite)
#   REPO-ONLY      committed but never installed, so launchd never loads it
#   CONTENT-DRIFT  both exist, bytes differ — the copy launchd loads is not the committed SSOT
# Same three classes, the same `.local` live-only exemption and the same loud-not-silent law as
# hooks/activation-watch.sh's axis 2: an UNRESOLVABLE repo side is REPORTED as a row, never a silent
# pass (a sibling parity assert once resolved REPO=~/.claude and every leg exited 0 vacuously —
# backlog 816015ecb30b), which is why the repo side derefs BASH_SOURCE and gates on `.git`.
# Whole-file `cmp`, never plutil: `plutil -extract` without `-o -` REWRITES the plist in place.
# --json emits ONE array carrying all kinds (each row keeps its .kind), alarms first.
set -uo pipefail

IDL_FILE="${CC_REAPER_IDL:-$HOME/.claude/autonomy/idl.jsonl}"
POSTLAND_DIR="${CC_POSTLAND_DIR:-$HOME/.claude/autonomy/postland}"
STAMPS_DIR="$POSTLAND_DIR/stamps"
# The verifier's OWN mutex, read as a liveness sensor. Path and semantics are postland-verify.sh's
# $LOCK ("$STATE/run.lock.d" + a pid file) — deliberately the same oracle, not a second one: if
# these two disagreed about "is a run in progress", the board would contradict the subject it reports.
RUN_LOCK_PID="$POSTLAND_DIR/run.lock.d/pid"
# The green CURSOR — the only commit R3 lets the live layer advance to. Its absence is not a detail:
# scripts/deploy-live.sh refuses outright without one, so "this file has never existed" IS the
# halted-deploy condition, stated positively.
LAST_GREEN="$POSTLAND_DIR/last-green"
LANDLOG="${CC_LAND_LOG:-${LAND_LOG:-$HOME/.claude/land.log}}"
DEPLOY_REPO="${DEPLOY_REPO:-$HOME/Development/claude-infrastructure}"
ALARM_H="${CC_POSTLAND_ALARM_H:-3}"            # stamp staleness budget (hours)
DEPLOY_LAG_MIN="${CC_DEPLOY_LAG_MIN:-60}"      # green-cursor → deployed-HEAD lag budget (minutes)
# ── DEPLOY-STALE budget (DEPLOY_LANE_GROUND_UP §2.3 D2). SAME NAMES AND SAME DEFAULTS as
# scripts/deploy-live.sh, deliberately: two numbers for one policy would let the lane sit refusing
# inside a window the board still calls healthy, which is a slower version of the silence being fixed.
# A non-numeric override falls back to the default rather than crashing the sensor — a garbage budget
# must not be able to take an alarm down (R5), and a `[ n -le abc ]` under -u would do exactly that.
DEPLOY_MAX_LAG_COMMITS="${CC_DEPLOY_MAX_LAG_COMMITS:-25}"
DEPLOY_MAX_LAG_HOURS="${CC_DEPLOY_MAX_LAG_HOURS:-6}"
case "$DEPLOY_MAX_LAG_COMMITS" in ''|*[!0-9]*) DEPLOY_MAX_LAG_COMMITS=25 ;; esac
case "$DEPLOY_MAX_LAG_HOURS"   in ''|*[!0-9]*) DEPLOY_MAX_LAG_HOURS=6 ;; esac
REDRUN_N="${CC_POSTLAND_REDRUN_N:-5}"          # how many newest verdicts an all-red run must span
# ALARM POLARITY (§4 M1). `notgreen` = the alarm's own question ("is it green?"); `legacy` = the
# pre-fix `red == seen` equality against one named failure. A kill switch, never a revert plan.
ALARM_POLARITY="${CC_BLOCKERS_ALARM_POLARITY:-notgreen}"
ACTIVATE_SH="$HOME/.claude/autonomy/pending-activation/14-land-pipeline-v2-activate.sh"
DAY_S=86400
# ── DISPATCH alarm sensors (§3 S8). DISPATCH_IDL defaults to the board file itself — the desk
# journal and the dispatch journal ARE one file — so a suite that fixtures CC_REAPER_IDL fixtures
# this sensor too and cannot grow a phantom row from the operator's live state.
DISPATCH_IDL="${CC_DISPATCH_IDL:-$IDL_FILE}"
DISPATCH_LABEL="${CC_DISPATCH_LABEL:-com.claude.dispatcher}"
DISPATCH_STALE_H="${CC_DISPATCH_STALE_H:-2}"
# §5 F16 / §7 A13. Deferral is silent BY DESIGN (R2: backlog > concurrency is normal and must never
# page) — but *sustained total* deferral is a different claim, and only the second is an alarm. The
# window is hours of wall clock, not passes, so it cannot be gamed by a burst of cheap kick passes.
# 0 ⇒ off (the kill switch); the alarm is silent whenever the spine admitted anything at all.
DISPATCH_SATURATED_H="${CC_DISPATCH_SATURATED_H:-6}"
DISPATCH_LOG="${CC_DISPATCH_LOG:-/tmp/claude-dispatcher.stderr.log}"
# The REPO copy, not the ~/.claude mirror: nothing syncs docs/activation/pending-activation/ to
# ~/.claude/autonomy/pending-activation/ (checked: deploy-live.sh does not), and the mirror is the
# copy that is CONTENT-DRIFTED — it still bootstraps without enabling first, which is why the label
# is disabled today. Handing over the drifted script would reproduce the failure. Same idiom as
# scripts/deploy-live.sh:223, which also names the repo path.
DISPATCH_ACTIVATE_SH="${CC_DISPATCH_ACTIVATE_SH:-$DEPLOY_REPO/docs/activation/pending-activation/02-load-dispatcher-activate.sh}"
LAUNCHCTL_BIN="${CC_BLOCKERS_LAUNCHCTL_BIN:-/bin/launchctl}"   # READ-ONLY subcommands only
# ── APPROVAL-REACHABILITY sensors (cc-backlog 1e16815bac51) ──────────────────────────────────────
# Every path here is a SEAM, and that is not decoration: without them these two alarms would read
# the operator's live settings/teams/process table from inside the suite, and the verdict would flip
# by machine (memory hermetic-suite-leaks-caller-identity).
PERMPEND_DIR="${CC_PERMPEND_DIR:-/tmp/cc-permission-pending}"   # MUST match hooks/cc-permission-beacon.sh + lead-supervisor.sh
BEACON_HOOK="${CC_BEACON_HOOK:-$HOME/.claude/hooks/cc-permission-beacon.sh}"
REAP_ALARM_SH="${CC_REAP_ALARM_SH:-$HOME/.claude/scripts/teammate-reap-alarm.sh}"
# The cross-session comms registry, keyed by paneUUID and carrying `session_id` — the join that lets
# a pending beacon name an ACTUAL iTerm2 pane instead of an opaque uuid. Same file cc-sessions reads.
CC_REGISTRY_DIR="${CC_REGISTRY_DIR:-$HOME/.claude/cc-registry}"
BEACON_CONFIG_DIRS="${CC_BEACON_CONFIG_DIRS:-$HOME/.claude $HOME/.claude-secondary $HOME/.claude-next $HOME/.claude-tertiary $HOME/.claude-quaternary}"
# The LIVE queue copy, NOT the repo path — the opposite choice from DISPATCH_ACTIVATE_SH above, for
# the opposite reason. That one names the repo because its mirror is content-DRIFTED; this one is
# byte-identical in both places, and the repo copy is unreachable exactly when this alarm fires: the
# shared checkout ~/.claude symlinks was 33 commits behind origin/main at land time, so
# $DEPLOY_REPO/docs/…/17-… did not exist on disk while the row was already telling the operator to
# run it. A recover command that cannot run is a broken platter (memory
# silver-platter-exact-commands, deploy-lag-checkout-behind-origin). ~/.claude/autonomy/
# pending-activation IS the operator's queue and is where the activation-queue reminder points.
BEACON_ACTIVATE_SH="${CC_BEACON_ACTIVATE_SH:-$HOME/.claude/autonomy/pending-activation/17-permission-beacon-wire-activate.sh}"
TEAM_ROOTS="${CC_TEAM_ROOTS:-$HOME/.claude/teams $HOME/.claude-secondary/teams $HOME/.claude-tertiary/teams}"
WATCHDOG_DIR="${CC_WATCHDOG_DIR:-$HOME/.claude/watchdog}"
# Absorbs ps's 1-second etime granularity. Biased so the ONLY thing a wrong grace can do is stay
# quiet: a healthy assignee is spawned AFTER its lead, so its elapsed time is strictly SMALLER.
ORPHAN_GRACE_S="${CC_ORPHAN_GRACE_S:-5}"
# NOTE: argument parsing lives in ONE place, the `while` loop below. A second `case "${1:-}"` block
# used to sit here; when the fleet work merged with the approval work, both survived and the earlier
# one ran first, so `--plist-parity` exited 2 as an unknown arg before the loop that accepts it was
# ever reached. Two parsers for one argv is always a bug — the first one wins silently.
# ── FLEET sensor (DAEMON_FLEET_V2 §4.3). The producer is bin/cc-fleet in the DEPLOY_REPO checkout,
# not the ~/.claude/bin mirror, and that is a correctness choice on two counts:
#   (1) In production they are the SAME FILE — install.sh globs bin/cc-* into ~/.claude/bin/ as
#       per-file symlinks INTO this checkout (verified: ~/.claude/bin/cc-blockers is such a link) —
#       so naming the repo path costs nothing and cannot read a stale copy. Same idiom as
#       DISPATCH_ACTIVATE_SH two lines above, and as scripts/deploy-live.sh:223.
#   (2) DEPLOY_REPO is a seam every existing cc-blockers suite ALREADY fixtures to an absent dir,
#       so this sensor is fixtured wherever they are and cannot grow a phantom row from the
#       operator's live fleet. Keyed on $HOME/.claude/bin/cc-fleet it would read the real fleet from
#       inside tests/cc-blockers.bats (which fixtures every sensor but NOT $HOME) the moment the
#       binary deployed — the exact phantom-row defect the verifier alarm (:99) and the dispatch
#       alarm (:184) each had to fix, twice, in this same file.
CC_FLEET_BIN="${CC_BLOCKERS_FLEET_BIN:-$DEPLOY_REPO/bin/cc-fleet}"
# ── plist SSOT parity sensors (§4.4). Both overridable so the suite is hermetic; the repo side is
# resolved from BASH_SOURCE when unset (see resolve_plist_repo) and NEVER from $HOME.
LIVE_AGENTS_DIR="${CC_BLOCKERS_LAUNCHAGENTS_DIR:-$HOME/Library/LaunchAgents}"
PLIST_REL="launchd"                            # the repo-side SSOT dir, relative to a checkout root
ALARMS_JSON='[]'                               # bound early: alarm_table's default source under -u
JSON=0
PARITY=0
# A LOOP, not a single `case "$1"`: --plist-parity composes with --json. Every previously-accepted
# invocation still parses identically; the only behaviour delta is that trailing junk after a good
# flag is now the same exit 2 it always was as $1, instead of being silently ignored.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json)         JSON=1 ;;
    --plist-parity) PARITY=1 ;;
    # Range is DERIVED from the file, never a literal line number: the hardcoded `2,69p` silently
    # stopped mid-header and `--help` omitted every alarm family documented past it (the fleet rows
    # and the whole --plist-parity leg) — a documented-but-invisible surface, this row's own bug
    # class one layer out. Same idiom as hooks/operator-readout.sh's --help.
    -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'; exit 0 ;;
    "")        ;;
    *)         echo "cc-blockers: unknown arg $1 (usage: cc-blockers [--json] [--plist-parity])" >&2; exit 2 ;;
  esac
  shift
done
command -v jq >/dev/null || { echo "cc-blockers: jq required" >&2; exit 2; }

# ── LAND-PIPELINE alarms ─────────────────────────────────────────────────────────────────────────
mtime() { stat -f %m "$1" 2>/dev/null || true; }   # BSD stat; empty ⇒ sensor unreadable ⇒ fail open
hrs()   { printf '%s' "$(( ($1 + 1800) / 3600 ))"; }

# Is a verification run IN PROGRESS right now? Oracle copied from postland-verify.sh:try_acquire —
# a lock whose pid file names a LIVE process is a held mutex; a dead pid is a crashed run's residue.
#
# WHY THE BOARD NEEDS THIS AT ALL. Every sensor below infers verifier health from STAMP AGE, but a
# stamp is written only when a run FINISHES, and a run legitimately outlives the staleness budget:
# measured on this host 2026-07-29, run_s was 5321 / 5437 / 8852 / 9620 / 10051 / 10112 s against an
# ALARM_H of 3h (10800s). So a HEALTHY verifier, mid-run, reads as inert — and because STALE and
# PERSISTENT-RED are mutually exclusive on that same axis, the red alarm that would name the real
# fault ("every verdict is red, deploy cannot advance") is SUPPRESSED for exactly as long as the
# runs are slow. Live proof: 34 stamps, 0 green, deploy halted 53 commits, and the only row the
# board offered was "verifier-inert/STALE — go look at launchctl" while pid 94251 was 3h into a run.
#
# DIRECTION OF FAILURE IS DELIBERATE. Only a positive, validated read sets this true. An unreadable
# or absent lock, a non-numeric pid, no `kill` — all leave it FALSE, i.e. exactly today's behaviour.
# Guessing "running" would HIDE a genuinely dead verifier, which is the one outcome worse than the
# misdiagnosis being fixed here.
verifier_running() {
  local holder
  holder="$(cat "$RUN_LOCK_PID" 2>/dev/null || true)"
  holder="${holder%%[[:space:]]*}"
  case "${holder:-}" in ''|*[!0-9]*) return 1 ;; esac    # no holder / unparseable ⇒ not running
  kill -0 "$holder" 2>/dev/null                          # ALIVE ⇒ a run is in progress
}

alarm_rows() { # → one JSON object per line (possibly none)
  local now newest_ts=0 f t v land_ts stamps="" gcommit="" green_ts=0 head_sha
  local seen=0 red=0 green_24h=0 lands_24h=0 emitted=0
  # notgreen  — the ALARM's counter (§4 M1). red stays, and is still read: it is what distinguishes
  #             the two STATES, and it is the whole predicate under CC_BLOCKERS_ALARM_POLARITY=legacy.
  # life/life_g — LIFETIME denominators (§4 F3). `seen` is capped at REDRUN_N, so the board used to
  #             say "5 verdicts, 0 green EVER" against a real history of 33 — understating its own
  #             evidence 6.6x in the one cell the operator reads to size the problem.
  local notgreen=0 life=0 life_g=0 behind="" astate fcount dtl
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac                    # no clock ⇒ no alarms

  # (a) VERIFIER-INERT / NEVER-ACTIVATED. The net was never activated — no stamps dir has ever
  # existed, i.e. an un-run C10 hand-step. Terminal for every later alarm: with no stamps there is
  # nothing to be stale, red, or lagging, so this returns rather than stacking derived noise.
  # EVIDENCE GATE: only where a landing pipeline demonstrably EXISTS (a land.log or the deploy
  # checkout). Keyed on stamps-absence alone this fired in every fixtured-$HOME void — 4 tests in
  # tests/cc-relogin-status.bats seeded 2 board rows and got a third, phantom alarm row — and would
  # fire on any machine that never had the infra at all. "The net never ran" is only an alarm where
  # a net was supposed to run; a void satisfies the letter and not the premise (found landing v2:
  # the bootstrap land's own smoke caught it).
  if [ ! -d "$STAMPS_DIR" ]; then
    if [ -e "$LANDLOG" ] || [ -d "$DEPLOY_REPO" ]; then
      # ASCII-only in the DETAIL cell: printf pads by BYTES, so one em-dash silently shifts the column.
      printf '{"kind":"verifier-inert","state":"NEVER-ACTIVATED","detail":"no stamps dir; the net has never run","subject":"%s","recover_cmd":"CONFIRM=1 bash %s","ts":%s}\n' \
        "$STAMPS_DIR" "$ACTIVATE_SH" "$now"
    fi
    return 0    # with no stamps there is nothing to be stale, red, or lagging — evidence or not
  fi

  # ONE ordered pass over the stamps (newest first) feeds all three remaining shapes — they differ
  # only in which slice of the same sorted list they read, so they can never disagree about it.
  # NO `case` inside this $( ): macOS /bin/bash is 3.2, whose command-substitution parser counts
  # parens and takes a case PATTERN's `)` as the closing one — the substitution dies with a syntax
  # error on stderr (swallowed here) and yields garbage. `bash -n` and shellcheck both pass it; it
  # only shows at runtime, and it showed as a FALSE verifier-inert alarm (newest_ts fell back to 0
  # ⇒ "newest stamp 495906h old"), i.e. exactly the invented blocker this file must never emit.
  # Numeric validation therefore happens in the read loop below, which is not inside a $( ).
  stamps="$(for f in "$STAMPS_DIR"/*.json; do
              [ -f "$f" ] || continue
              t="$(mtime "$f")"
              [ -n "$t" ] && printf '%s\t%s\n' "$t" "$f"
            done | sort -rn)"
  newest_ts="$(printf '%s\n' "$stamps" | head -1 | cut -f1)"
  case "${newest_ts:-}" in ''|*[!0-9]*) newest_ts=0 ;; esac
  land_ts="$(mtime "$LANDLOG")"; case "${land_ts:-}" in ''|*[!0-9]*) land_ts="" ;; esac
  [ -n "$land_ts" ] && [ "$((now - land_ts))" -lt "$DAY_S" ] && lands_24h=1

  while IFS=$'\t' read -r t f; do
    [ -n "${f:-}" ] || continue
    case "${t:-}" in ''|*[!0-9]*) continue ;; esac        # safe here: not inside a $( )
    v="$(jq -r '.verdict // empty' "$f" 2>/dev/null || true)"
    # An EMPTY verdict is a SENSOR failure (unreadable/malformed stamp), not a non-verdict, and the
    # distinction is load-bearing in BOTH directions: counted as not-green it would let one corrupt
    # file fabricate a PERSISTENT-NOT-GREEN row (R5 fail-OPEN — a board that invents blockers is
    # ignored exactly like one that hides them); counted as green it would silence a real alarm.
    # Excluded from every counter INCLUDING `seen`, so it can neither raise nor dilute the window.
    case "${v:-}" in '') continue ;; esac        # safe here: not inside a $( ) — see the note above
    life=$((life + 1))
    if [ "$seen" -lt "$REDRUN_N" ]; then
      seen=$((seen + 1))
      [ "$v" = "red" ]   && red=$((red + 1))
      [ "$v" != "green" ] && notgreen=$((notgreen + 1))
    fi
    if [ "$v" = "green" ]; then
      life_g=$((life_g + 1))
      [ -z "$gcommit" ] && { green_ts="$t"; gcommit="$(jq -r '.commit // empty' "$f" 2>/dev/null || true)"; }
      [ "$((now - t))" -lt "$DAY_S" ] && green_24h=1
    fi
  done <<EOF
$stamps
EOF

  # (a') VERIFIER-INERT / STALE — stamping stopped WHILE trunk kept moving. A stale stamp with no
  # recent land is not inertness, it is an idle box, so land.log's own mtime is the second sensor.
  # THIRD sensor, and the one that makes the other two honest: a run IN PROGRESS is not inertness.
  # Without it this branch accuses the verifier of being dead on the strength of a stamp it has not
  # had the chance to write yet (see verifier_running for the measured run times that make that the
  # NORMAL case, not an edge one).
  if [ -n "$land_ts" ] && [ "$land_ts" -gt "$newest_ts" ] \
     && [ "$((now - newest_ts))" -gt "$((ALARM_H * 3600))" ] && ! verifier_running; then
    # shellcheck disable=SC2016  # $(id -u) is EMITTED, not evaluated: it must expand in the
    # operator's shell when they paste it, which is also what keeps the command uid-portable.
    printf '{"kind":"verifier-inert","state":"STALE","detail":"newest stamp %sh old; a land landed %sh ago","subject":"%s","recover_cmd":"tail -20 %s/runner.log ; launchctl print gui/$(id -u)/com.claude.postland-verify","ts":%s}\n' \
      "$(hrs "$((now - newest_ts))")" "$(hrs "$((now - land_ts))")" "$STAMPS_DIR" "$POSTLAND_DIR" "$now"
    emitted=1
  fi

  # (b) TRUNK-RED / PERSISTENT-RED — the inverse failure: the verifier is ALIVE and stamping fresh,
  # and every one of the newest N verdicts is red with no green in 24h while lands keep arriving.
  # That is not a dead job, it is a trunk (or a partition/attribution) problem, and it blocks deploy
  # just as hard — R3 pins the live layer to a green stamp that never comes. Freshness is required,
  # which is what keeps this mutually exclusive with STALE. Floor of 2 verdicts: one red stamp is
  # an ordinary red land, not a persistent state, and a board that cries on n=1 gets ignored.
  # FRESHNESS, or a run in flight. "Fresh stamp" was only ever a proxy for "the verifier is alive",
  # and it is a proxy that goes false precisely when runs get slow — the state in which an all-red
  # trunk matters MOST, because every slow run ends in another red stamp and deploy stays pinned.
  # Reading the mutex directly answers the real question, and keeps this mutually exclusive with
  # STALE above by construction: STALE now requires NOT running, this admits running. Four cells,
  # one alarm each — {fresh,stale} x {running,idle} — verified in tests/cc-blockers.bats.
  # POLARITY (§4 M1): the count compared against the window is NOT-GREEN, so a cut/hung stamp
  # STRENGTHENS the case instead of silencing it. `fcount` is the one line the kill switch moves.
  fcount="$notgreen"
  [ "$ALARM_POLARITY" = legacy ] && fcount="$red"
  if { [ "$((now - newest_ts))" -le "$((ALARM_H * 3600))" ] || verifier_running; } \
     && [ "$seen" -ge 2 ] && [ "$fcount" -eq "$seen" ] && [ "$green_24h" -eq 0 ] && [ "$lands_24h" -eq 1 ]; then
    # STATE, not a second alarm: the operator's action is identical (partition the failures), but
    # "4 red + 1 hung" and "5 red" are different facts and the board must not claim the stronger one.
    # Under legacy the predicate only passes when red==seen, so this is always PERSISTENT-RED there —
    # byte-identical to the pre-fix row.
    # Firing was already decided above by `fcount -eq seen` on the NOT-GREEN count; all this asks is
    # the verdict-shaped question "are all N literally red?", where equality against a failure name is
    # exactly right. If it were wrong the operator would read a slightly weaker LABEL, never silence.
    # scripts/alarm-polarity-lint.sh flags the shape and demands this justification — which is the
    # point of it. The marker must sit on the line ABOVE the code it excuses, never at the top of a
    # prose block: adjacency is what makes it unambiguous WHICH line was reviewed.
    # alarm-polarity-ok: names the STATE, does not gate the ALARM (see the four lines above)
    if [ "$red" -eq "$seen" ]; then astate="PERSISTENT-RED"; else astate="PERSISTENT-NOT-GREEN"; fi
    # DETAIL is padded to 44 BYTES and ASCII-only (printf pads by bytes; one em-dash shifts the
    # column). Both variants carry the LIFETIME denominator, which is the number that sizes the
    # problem — `seen` is capped at REDRUN_N and reads as the whole history to a human.
    if [ "$astate" = "PERSISTENT-RED" ]; then
      dtl="$(printf 'newest %s all red, %s green of %s ever' "$seen" "$life_g" "$life")"
    else
      dtl="$(printf 'newest %s: %s red %s nonverdict, 0 green' "$seen" "$red" "$((seen - red))")"
    fi
    # --arg (not a "red" literal) so the emitted command carries NO double quote: one less escaping
    # layer between here, the JSON, the table cell and the operator's paste buffer.
    # shellcheck disable=SC2016  # $v is jq's --arg binding, EMITTED for the operator's jq to read.
    printf '{"kind":"trunk-red","state":"%s","detail":"%s","subject":"%s","recover_cmd":"jq -r --arg v red %sselect(.verdict==$v).failing[]?%s %s/*.json | sort | uniq -c | sort -rn | head","ts":%s}\n' \
      "$astate" "$dtl" "$STAMPS_DIR" "'" "'" "$STAMPS_DIR" "$now"
    emitted=1
  fi

  # (c) DEPLOY-LAG. The green cursor is the only thing the live layer may advance to, so a green
  # commit sitting undeployed past the budget means the deploy lane — not the verifier — is stuck.
  # The ancestor test is load-bearing: a green stamp BEHIND the deployed HEAD is history, not lag.
  # (d) NEVER-GREEN — the BACKSTOP, and the reason the board had nothing to say while deploy sat
  # halted for 53 commits. This bare `return 0` on "no green stamp exists" WAS the hole: every alarm
  # above explains a SPECIFIC fault, and none of them covers the state that actually pins the live
  # layer — the verifier runs, returns verdicts, and not ONE has ever been green, so `last-green`
  # never gets written and deploy-live has no cursor to advance to. deploy-lag structurally cannot
  # cover it (it needs a green in order to call one late), verifier-inert cannot (the job is alive),
  # and trunk-red abstains the moment a single non-red verdict lands in its window — which is exactly
  # what the live host looked like: 30 red, 2 cut, 1 hung, 0 green, `last-green` absent, and silence.
  #
  # Emitted ONLY when no sharper row already claimed the reason (`emitted`), so the operator never
  # gets two rows pointing at one fault. Same EXISTENCE-EVIDENCE gate as its siblings — a fixtured
  # $HOME void has no greens either, and "the pipeline never certified" is only an alarm where a
  # pipeline was supposed to certify. The n>=2 floor keeps a brand-new install quiet.
  if [ -z "$gcommit" ]; then
    if [ "$emitted" -eq 0 ] && [ "$seen" -ge 2 ] && [ ! -e "$LAST_GREEN" ] \
       && { [ -e "$LANDLOG" ] || [ -d "$DEPLOY_REPO" ]; }; then
      # MAGNITUDE, not just cause (§4 F4). "deploy has no cursor" is the reason; the number of
      # commits of landed work sitting inert behind it is what sizes the exposure, and it was
      # nowhere on the board — row 3 spent a whole rebuild measuring a mechanism that had never
      # executed for exactly this reason. Computed HERE, inside the emit branch, so the common
      # (silent) path pays no fork. `@{u}` not a hardcoded origin/main: the general form, and it
      # simply fails to resolve — empty, clause omitted — in a fixture with no upstream (R5).
      behind="$(git -C "$DEPLOY_REPO" rev-list --count 'HEAD..@{u}' 2>/dev/null || true)"
      case "${behind:-}" in ''|*[!0-9]*|0) behind="" ;; esac
      if [ -n "$behind" ]; then
        dtl="$(printf '0 green in %s EVER; live layer %s behind' "$life" "$behind")"
      else
        dtl="$(printf '0 green in %s EVER; deploy has no cursor' "$life")"
      fi
      printf '{"kind":"never-green","state":"NEVER-CERTIFIED","detail":"%s","subject":"%s","recover_cmd":"tail -40 %s/runner.log ; jq -r .verdict %s/*.json | sort | uniq -c","ts":%s}\n' \
        "$dtl" "$LAST_GREEN" "$POSTLAND_DIR" "$STAMPS_DIR" "$now"
    fi
    return 0
  fi
  head_sha="$(git -C "$DEPLOY_REPO" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$head_sha" ] || return 0                                       # not a checkout ⇒ fail open
  [ "$gcommit" != "$head_sha" ] || return 0                            # already deployed
  git -C "$DEPLOY_REPO" merge-base --is-ancestor "$head_sha" "$gcommit" >/dev/null 2>&1 || return 0
  [ "$((now - green_ts))" -gt "$((DEPLOY_LAG_MIN * 60))" ] || return 0
  printf '{"kind":"deploy-lag","state":"LAGGING","detail":"green %.12s unshipped for %sh","subject":"%s","recover_cmd":"bash %s/.claude/scripts/deploy-live.sh ; tail -20 %s/deploy.log","ts":%s}\n' \
    "$gcommit" "$(hrs "$((now - green_ts))")" "$DEPLOY_REPO" "$HOME" "$POSTLAND_DIR" "$now"
}

# ── DEPLOY-STALE (DEPLOY_LANE_GROUND_UP §2.3 D2) ─────────────────────────────────────────────────
# NOT-ADVANCING: the live layer is behind trunk past the budget and has not moved within it.
#
# THE GAP THIS CLOSES. Every deploy alarm above is conditioned on where the STAMP CURSOR sits, and
# the cursor's position is precisely what broke. Measured 2026-08-07: the live layer was 91 commits
# and 33h stale, scripts/deploy-live.sh had emitted 534 identical refusals, and `cc-blockers`
# rendered ZERO deploy rows —
#   deploy-lag  (above) needs the newest green to be a DESCENDANT of the deployed HEAD, under its own
#               comment "a green stamp BEHIND the deployed HEAD is history, not lag". Ours was
#               behind, so the ancestor test returned SILENTLY.
#   never-green (above) needs NO green to have EVER existed. Two existed.
# Those are the two ENDPOINTS of one axis, and the state between them — a green exists but none is a
# descendant of live HEAD — was covered by nothing. never-green's own comment already conceded the
# shape ("deploy-lag structurally cannot cover it (it needs a green in order to call one late)");
# it was written about the no-green endpoint, and the mirror case fell into the identical hole.
#
# WHY A SEPARATE FUNCTION, NOT A FIFTH BRANCH OF alarm_rows(). Inside it this would inherit the very
# axis it exists to escape: three `return 0`s above are taken on stamp state alone (no stamps dir; no
# green cursor), so its independence from $gcommit would be a property of statement ORDER — one
# refactor away from being false, and silently. Composed as its own row source at the ALARMS_JSON
# line, it CANNOT read the cursor, which is the whole claim rather than a convention.
#
# REASON-AGNOSTIC BY CONSTRUCTION. The predicate is the LAG ITSELF, never which refusal fired.
# deploy-live.sh pages the TRANSIENT no-green refusal and pages nothing for the PERMANENT
# anti-rollback one, so the failure that lasts is the silent one (measured: 0 pages across 534
# refusals). An alarm keyed on a refusal string also goes quiet the moment the diagnosis changes
# shape while the freeze continues — a change of message read as a recovery is how the last filing
# of this class was closed.
#
# DELIBERATELY DOES NOT DEFER to deploy-lag, unlike never-green's `emitted` gate. Those two answer
# ONE question ("why is deploy not certified") and must not both answer it; this one answers a
# different question ("is the layer moving at all"), and it is true both where deploy-lag is false
# AND where it is true. Two rows there is two facts, not one fault twice.
#
# Same fail-OPEN law as every sensor in this file (R5): no checkout, no origin/main, an unreadable
# count or an unreadable commit date all yield NO row. A board that invents blockers is ignored
# exactly like one that hides them.
deploy_stale_rows() { # → one JSON object per line (possibly none)
  local now behind head_ts age_s over_h=0 dtl cmd dlog
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac                     # no clock ⇒ no alarms
  [ -d "$DEPLOY_REPO" ] || return 0                                    # not a checkout ⇒ fail open
  # origin/main, NOT `@{u}`: it is the same ref scripts/deploy-live.sh walks to choose its target, and
  # a second oracle here would let the board and the lane disagree about how far behind the layer is
  # (the law at RUN_LOCK_PID above, applied to the deploy side).
  behind="$(git -C "$DEPLOY_REPO" rev-list --count HEAD..origin/main 2>/dev/null || true)"
  case "${behind:-}" in ''|*[!0-9]*) return 0 ;; esac                  # unreadable ⇒ no row
  [ "$behind" -gt 0 ] || return 0                                      # current ⇒ nothing to be late for
  # HOURS is the age of the LIVE HEAD COMMIT, and it is gated on behind>0 above for a reason: on a
  # quiet trunk a perfectly-deployed layer has an old HEAD too, and firing there would be an alarm
  # that cannot tell "frozen" from "nothing to do". Unreadable ⇒ the hours leg simply cannot fire;
  # degrading a sensor may only make this quieter, never louder.
  head_ts="$(git -C "$DEPLOY_REPO" log -1 --format=%ct HEAD 2>/dev/null || true)"
  case "${head_ts:-}" in ''|*[!0-9]*) head_ts="" ;; esac
  age_s=""
  if [ -n "$head_ts" ] && [ "$now" -ge "$head_ts" ]; then age_s="$((now - head_ts))"; fi
  [ -n "$age_s" ] && [ "$age_s" -gt "$((DEPLOY_MAX_LAG_HOURS * 3600))" ] && over_h=1
  # EITHER leg is sufficient: commits and hours measure the same freeze through different windows,
  # and a burst-then-stop trips the first while a slow permanent stall trips the second.
  [ "$behind" -gt "$DEPLOY_MAX_LAG_COMMITS" ] || [ "$over_h" -eq 1 ] || return 0
  # ASCII-only and MAGNITUDE-carrying (§4 F4): both numbers ship regardless of which leg fired, because
  # the pair is what sizes the exposure. printf pads by BYTES, so one em-dash would shift the column.
  #
  # FLOOR, NOT hrs(). hrs() rounds to nearest (`($1 + 1800) / 3600`), so a 5h45m layer renders "6h old"
  # beside a 6h budget — telling the operator the HOURS leg tripped when this row actually fired on the
  # COMMITS leg. Misattributing which leg fired is this rebuild's own defect class one level down:
  # deploy-lag's ancestor test at :425 was CORRECT and its rendering is what hid the state for 33h.
  # Floor makes the cell agree with the predicate by construction — `age_s/3600 >= budget` exactly when
  # `age_s >= budget*3600` — so the number can never imply a leg that did not fire.
  # hrs() itself is NOT touched: it has three other callers (:351, :444, :584) whose rows are unrelated
  # to this threshold, and rounding is right for them.
  if [ -n "$age_s" ]; then dtl="$(printf 'live layer %s behind, HEAD %sh old' "$behind" "$(( age_s / 3600 ))")"
  else                     dtl="$(printf 'live layer %s behind, HEAD age unreadable' "$behind")"; fi
  # I11 — EXISTENCE-CHECK THE PLATTER (hooks/operator-readout.sh:238-246). deploy-lag platters
  # `bash ~/.claude/scripts/deploy-live.sh`, and in THIS state that exact command is what has refused
  # 534 consecutive times — a board offering a fix its own gate rejects teaches the operator that the
  # board lies. So the platter here is the DIAGNOSTIC that shows why, and every clause is proven
  # runnable at emit time: the git half by the rev-list that just succeeded against these same two
  # refs in this same repo, the tail half by the `-e` below. Advancing the layer is the operator's
  # call and stays off the platter.
  cmd="$(printf 'git -C %s log --oneline -5 HEAD..origin/main' "$DEPLOY_REPO")"
  dlog="$POSTLAND_DIR/deploy.log"
  [ -e "$dlog" ] && cmd="$(printf 'tail -20 %s ; %s' "$dlog" "$cmd")"
  printf '{"kind":"deploy-stale","state":"NOT-ADVANCING","detail":"%s","subject":"%s","recover_cmd":"%s","ts":%s}\n' \
    "$dtl" "$DEPLOY_REPO" "$cmd" "$now"
}

# ── DISPATCH alarm (AUTONOMY_DISPATCH_V2 §3 S8) ──────────────────────────────────────────────────
# Mirrors alarm_rows() above deliberately: same NEVER/NOT-ACTIVATED-is-terminal shape, same
# fail-OPEN-on-sensor-failure law, same ASCII-only DETAIL cell (printf pads by BYTES, so one
# em-dash silently shifts the column). What differs is only the sensor set.
#
# EXISTENCE EVIDENCE FIRST (memory absence-alarm-needs-existence-evidence). Keyed on the launchd
# label alone this alarm fires on any host that never had a dispatcher and inside every fixtured
# $HOME void — the identical phantom-row defect the verifier alarm above had to fix after it
# invented a third row in tests/cc-relogin-status.bats. The premise of "it stopped" is that it once
# ran, so the gate is >=1 actor=="cc-dispatch" record in the journal. A host staged but never once
# activated is covered by the pending-activation operator queue, not by an alarm that cannot tell
# "never wired here" from "died".
#
# WHY launchctl AT ALL, rather than inferring from the journal gap: the two states have DIFFERENT
# OWNERS and different fixes. `disabled`/unloaded is a hand-step nobody ran (operator, one command);
# loaded-but-silent is a job that died or wedged (investigate the log). Reporting the first as a
# stall sends the operator to debug a process that was never started — the exact wrong action, and
# what "3 days inert with zero alarm" would otherwise have degraded into once an alarm existed.
# READ-ONLY subcommands only (`list`, `print-disabled`): this tool never mutates launchd, and the
# tests stub the binary through CC_BLOCKERS_LAUNCHCTL_BIN rather than touching real launchd.
dispatch_alarm_rows() { # → one JSON object per line (possibly none)
  local now uid newest listing disabled_db stale_h activated=1
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac                    # no clock ⇒ no alarms
  stale_h="$DISPATCH_STALE_H"
  case "${stale_h:-}" in ''|*[!0-9]*) stale_h=2 ;; esac

  [ -f "$DISPATCH_IDL" ] || return 0
  # jq owns the ISO-8601 → epoch conversion (fromdateiso8601): one parser, and `fromjson?` keeps a
  # malformed line from taking the whole read down, exactly as the board reader below does.
  newest="$(jq -Rn --arg a cc-dispatch '[ inputs | fromjson? | select(type=="object")
              | select(.actor == $a) | (.ts // empty) | tostring
              | (try fromdateiso8601 catch empty) ] | max // empty' "$DISPATCH_IDL" 2>/dev/null || true)"
  case "${newest:-}" in ''|*[!0-9]*) return 0 ;; esac                 # never ran here ⇒ no premise

  [ -x "$LAUNCHCTL_BIN" ] || return 0                                 # no sensor ⇒ no verdict
  uid="$(id -u 2>/dev/null || true)"
  case "${uid:-}" in ''|*[!0-9]*) return 0 ;; esac
  listing="$("$LAUNCHCTL_BIN" list 2>/dev/null)" || return 0          # sensor error ⇒ fail open
  disabled_db="$("$LAUNCHCTL_BIN" print-disabled "gui/$uid" 2>/dev/null || true)"
  # LOADED: `launchctl list` prints "PID\tSTATUS\tLABEL", so the label is the LAST field — matched
  # whole, never as a substring (com.claude.dispatcher-foo must not satisfy com.claude.dispatcher).
  printf '%s\n' "$listing" | awk -v l="$DISPATCH_LABEL" '$NF == l { f = 1 } END { exit !f }' || activated=0
  # ENABLED: absence from the override DB means enabled (it records overrides, not memberships), so
  # only an explicit "=> disabled" counts against the label.
  printf '%s\n' "$disabled_db" | grep -q "\"$DISPATCH_LABEL\" => disabled" && activated=0

  if [ "$activated" -eq 0 ]; then
    # DETAIL is padded to 44 BYTES by the renderer, so it is written to fit: an over-long cell is
    # truncated mid-word and the operator reads a sentence that stops.
    printf '{"kind":"dispatch-inert","state":"NOT-ACTIVATED","detail":"launchd label disabled or unloaded (C10)","subject":"%s","recover_cmd":"CONFIRM=1 bash %s","ts":%s}\n' \
      "$DISPATCH_LABEL" "$DISPATCH_ACTIVATE_SH" "$now"
    return 0    # terminal: a job that is not running cannot be late
  fi

  if [ "$((now - newest))" -gt "$((stale_h * 3600))" ]; then
    # shellcheck disable=SC2016  # $(id -u) is EMITTED, not evaluated: it must expand in the operator's
    # shell when they paste it, which is also what keeps the command uid-portable.
    printf '{"kind":"dispatch-inert","state":"STALE","detail":"loaded+enabled but no decision in %sh","subject":"%s","recover_cmd":"tail -20 %s ; launchctl print gui/$(id -u)/%s","ts":%s}\n' \
      "$(hrs "$((now - newest))")" "$DISPATCH_LABEL" "$DISPATCH_LOG" "$DISPATCH_LABEL" "$now"
    return 0    # terminal for SATURATED: a spine that is not deciding cannot be judged on its admits
  fi

  # ── SATURATED (§5 F16 / §7 A13) ────────────────────────────────────────────────────────────────
  # The failure mode S2's own mid-build correction revealed, and the ONLY one of this family that a
  # correct-and-quiet dispatcher can reach. R2 makes deferral silent on purpose; a `live_workers`
  # that never decreases therefore yields a spine that fires nothing and SAYS nothing — strictly
  # worse than the false cliff this rebuild removed, because a false cliff at least pages.
  #
  # POLARITY (memory alarm-polarity-and-attention-budget): the alarm asks "is it GREEN?" — did it
  # admit ANYTHING in the window — and counts NOT-success. It never asks "is some named failure
  # present?", so no single unusual record can silence it.
  # PREMISE GATE: at-ceiling deferrals must actually appear in the window. Without that, a spine
  # that is merely idle (empty backlog ⇒ nothing to admit) or one whose window holds only cheap
  # single-item kick passes would read as saturated — an alarm that fires on health gets ignored.
  local sat_h counts atceil admits
  sat_h="$DISPATCH_SATURATED_H"
  case "${sat_h:-}" in ''|*[!0-9]*) sat_h=6 ;; esac
  [ "$sat_h" -gt 0 ] || return 0                                      # 0 ⇒ kill switch, alarm off
  # One jq pass emits "<at-ceiling> <admits>"; `fromjson?` keeps a malformed line from taking the
  # whole read down, exactly as the newest-record read above does.
  # -r is load-bearing: the program emits a STRING, and without raw output jq wraps it in literal
  # double quotes, so both fields fail the is-a-number guard below and the alarm silently fails open.
  counts="$(jq -Rrn --arg a cc-dispatch --argjson cut "$((now - sat_h * 3600))" '
      [ inputs | fromjson? | select(type=="object")
        | select(.actor == $a) | select(.action == "decision")
        | select( ((.ts // empty) | tostring | (try fromdateiso8601 catch empty)) > $cut ) ] as $w
      | "\([ $w[] | select(.reason == "at-ceiling") ] | length) \([ $w[] | select(.verdict == "admit") ] | length)"
    ' "$DISPATCH_IDL" 2>/dev/null || true)"
  atceil="${counts%% *}"; admits="${counts##* }"
  case "${atceil:-}" in ''|*[!0-9]*) return 0 ;; esac                 # unreadable ⇒ no verdict
  case "${admits:-}" in ''|*[!0-9]*) return 0 ;; esac                 # (fail OPEN, never invent)
  [ "$atceil" -gt 0 ] || return 0                                     # no ceiling pressure ⇒ silent
  [ "$admits" -eq 0 ] || return 0                                     # it admitted ⇒ healthy
  printf '{"kind":"dispatch-inert","state":"SATURATED","detail":"deciding but 0 admits in %sh (at ceiling)","subject":"%s","recover_cmd":"cc-backlog reap --dry-run","ts":%s}\n' \
    "$sat_h" "$DISPATCH_LABEL" "$now"
}

# ── APPROVAL-REACHABILITY alarms (cc-backlog 1e16815bac51) ───────────────────────────────────────
# Same law as the two families above — NOT-x-is-terminal, fail-OPEN on sensor failure, ASCII-only
# 44-byte DETAIL — and deliberately the same idiom rather than a new one. Both answer ONE question
# the board could not previously ask: can an approval request actually REACH an approver?
#
# THE INCIDENT (2026-07-29, ground-up row 5). A lead process died; its five assignees survived.
# `@gu5-decide` then parked on "Waiting for team lead approval" — a permission request routed to a
# process that no longer exists, with NO fallback to the operator. No prompt was ever rendered, so
# the pane looked like it was waiting on the human while the human had nothing to click, and it
# would have waited forever. The mechanism built for this (hooks/cc-permission-beacon.sh, landed
# b7db06c5) was INERT rather than missing: registered in ZERO settings.json, so it had never fired
# once. These two alarms are the two halves of that failure, and they are separate kinds because
# they have different owners: one is a live stuck process, the other is an un-run wiring step.

# etime_secs "[[dd-]hh:]mm:ss" → seconds. Empty (no verdict) on anything unparseable.
# `10#` on every field is load-bearing, NOT style: ps zero-pads, and bash reads a bare `08`/`09` as
# INVALID OCTAL — an arithmetic error at exactly 8 and 9 minutes/seconds past, i.e. an alarm that
# silently drops ~3% of the clock. Defined at top level so its `case` is parsed OUTSIDE any command
# substitution (memory bash32-case-in-substitution: bash 3.2 mis-parses a case pattern's `)` as the
# closing paren of a `$( )`, dying at RUNTIME while `bash -n` and shellcheck both pass).
etime_secs() {
  local e="${1:-}" d=0 hms h=0 m=0 s=0 n oldifs
  [ -n "$e" ] || return 0
  hms="${e#*-}"; [ "$hms" != "$e" ] && d="${e%%-*}"
  oldifs="$IFS"; IFS=:
  # shellcheck disable=SC2086  # the word split IS the parse: IFS=: turns "hh:mm:ss" into $1/$2/$3.
  # (Directive must sit on its OWN line above the `set` — on a `a; b; set -- $x` one-liner it binds
  # to the FIRST command and shellcheck still reports the third.)
  set -- $hms
  IFS="$oldifs"; n=$#
  if   [ "$n" -eq 3 ]; then h="$1"; m="$2"; s="$3"
  elif [ "$n" -eq 2 ]; then m="$1"; s="$2"
  else return 0
  fi
  case "$d:$h:$m:$s" in *[!0-9:]*|*::*) return 0 ;; esac
  printf '%s' "$(( 10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s ))"
}

# (d) ORPHANED-APPROVER — a LIVE assignee whose approver cannot answer. This is the fail-OPEN half:
# a request whose approver cannot exist must never be a silent infinite wait, so it becomes an
# operator-visible row here instead of a pane parked forever.
#
# THE PREDICATE IS NOT "is the lead alive". That is the trap this alarm exists to avoid, and it
# false-negatives the very incident it was built for: the lead had ALREADY been resumed, so its pid
# was alive and healthy — but a resume restores the SESSION, never the TEAM CHANNEL. The assignees
# are bound to the PROCESS that spawned them, and the resumed lead's own words were "No agent named
# 'gu5-decide' is reachable." Measured on the live incident: lead pid 39471 elapsed 27:46, its five
# assignees elapsed 1:14-1:31 — every assignee had been running an HOUR longer than the "lead" they
# report to. So the predicate is PROCESS AGE: a healthy assignee is spawned BY its lead and is
# therefore strictly YOUNGER; an assignee OLDER than the live lead process belongs to a dead
# incarnation and its approvals go nowhere. Both times come from one ps snapshot — same clock, same
# source, same granularity — which is why this compares elapsed times and not file birth times.
#
# EXISTENCE EVIDENCE: a row needs >=1 LIVE assignee process. No live process ⇒ nothing is waiting ⇒
# no row, so an archived or finished team can never raise one (memory
# absence-alarm-needs-existence-evidence).
orphan_approver_rows() { # → one JSON object per line (possibly none)
  local now snap live teams team root cfg team_dir lead_sid lead_pid lead_e
  local name agent_id etime mem_e state orphans n cmd
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac

  # EXISTENCE EVIDENCE FIRST — and here it also drives the whole loop, which is both the correct
  # premise and the only affordable shape. The alarm's premise is a LIVE assignee process that is
  # waiting, so enumerating TEAM DIRS would be backwards: this host carries 80 of them, nearly all
  # long finished, and each would cost a jq on every cc-blockers run. Driving from the process table
  # visits only teams that still have something alive (measured: 1, not 80).
  # ONE ps + ONE awk yields every live agent as "<pid> <etime> <agentId>"; liveness and age then come
  # from the SAME instant, so a process cannot die between its own two reads.
  snap="$(ps -axo pid=,etime=,command= 2>/dev/null)" || return 0
  [ -n "$snap" ] || return 0                                          # no sensor ⇒ no verdict
  live="$(printf '%s\n' "$snap" | awk \
    '{ for (i = 3; i <= NF; i++) if ($i == "--agent-id" && (i + 1) <= NF) { print $1 " " $2 " " $(i + 1); break } }')"
  [ -n "$live" ] || return 0                                          # no agent alive ⇒ nothing waiting

  # Distinct team suffixes ("<name>@<team>"), deduped fork-free. Each $team is QUOTED in the case
  # patterns so it matches literally — an unquoted pattern would let a metacharacter in a team name
  # glob-match a different team.
  teams=""
  while read -r _ _ agent_id; do
    [ -n "$agent_id" ] || continue
    team="${agent_id#*@}"
    { [ -n "$team" ] && [ "$team" != "$agent_id" ]; } || continue     # no '@' ⇒ not a team agent id
    case " $teams " in *" $team "*) ;; *) teams="${teams:+$teams }$team" ;; esac
  done <<EOF
$live
EOF
  [ -n "$teams" ] || return 0

  for team in $teams; do
    # Direct path, never a glob: the team suffix IS the directory name.
    cfg=""; team_dir=""
    for root in $TEAM_ROOTS; do
      if [ -f "$root/$team/config.json" ]; then team_dir="$root/$team"; cfg="$team_dir/config.json"; break; fi
    done
    [ -n "$cfg" ] || continue                                         # live agent but no team state ⇒ no verdict
    lead_sid="$(jq -r '.leadSessionId // empty' "$cfg" 2>/dev/null || true)"
    [ -n "$lead_sid" ] || continue
    lead_pid="$(cat "$WATCHDOG_DIR/$lead_sid.pid" 2>/dev/null || true)"
    case "${lead_pid:-}" in ''|*[!0-9]*) lead_pid="" ;; esac
    lead_e=""
    if [ -n "$lead_pid" ] && kill -0 "$lead_pid" 2>/dev/null; then
      lead_e="$(printf '%s\n' "$snap" | awk -v p="$lead_pid" '$1==p {print $2; exit}')"
      lead_e="$(etime_secs "$lead_e")"
      # Alive but unreadable age ⇒ NO verdict for this team. Guessing either way is wrong: call it
      # dead and every healthy assignee becomes a phantom row; call it healthy and a real orphan is
      # swallowed.
      [ -n "$lead_e" ] || continue
      state="LEAD-RESTARTED"
    else
      state="LEAD-DEAD"
    fi

    orphans=""; n=0
    while read -r _ etime agent_id; do
      [ -n "$agent_id" ] || continue
      [ "${agent_id#*@}" = "$team" ] || continue                      # exact suffix, never a prefix match
      name="${agent_id%%@*}"
      [ "$name" = "team-lead" ] && continue
      if [ "$state" = "LEAD-RESTARTED" ]; then
        mem_e="$(etime_secs "$etime")"
        case "${mem_e:-}" in ''|*[!0-9]*) continue ;; esac             # unreadable age ⇒ no verdict
        [ "$mem_e" -gt "$((lead_e + ORPHAN_GRACE_S))" ] || continue    # younger than the lead ⇒ healthy
      fi
      # Dedupe by NAME. More than one process can carry the same --agent-id token — a stale duplicate
      # of the assignee, or merely another process whose argv MENTIONS it (a monitoring command, a
      # shell running a script that names it). Counting it twice inflates the headline number the
      # operator reads, and "5 live assignee(s)" has to mean five.
      case ",$orphans," in *",$name,"*) continue ;; esac
      orphans="${orphans:+$orphans,}$name"; n=$((n + 1))
    done <<EOF
$live
EOF
    [ "$n" -gt 0 ] || continue

    # The RECOVER command is an INVENTORY, deliberately not a reaper. Orphaned assignees are not
    # agent-reapable — cc-teardown holds no registry row for them and handoff-fire self-close
    # REFUSES them (an assignee has an originator, so it is not a fired peer; but that originator
    # is gone, so it is not an origin session either — a missing category, filed as 95281da714f0).
    # The one resolution that works is mapping the agent process's tty to its pane, so that is
    # exactly what this hands over. Single quotes keep it JSON-safe and paste-safe.
    cmd="ps -axo pid=,tty=,command= | grep -- '@$team' | grep -v grep"
    printf '{"kind":"orphaned-approver","state":"%s","detail":"%s live assignee(s) cannot reach their lead","subject":"%s","orphans":"%s","lead_session":"%s","recover_cmd":"%s","ts":%s}\n' \
      "$state" "$n" "$team_dir" "$orphans" "$lead_sid" "$cmd" "$now"
  done
}

# (e) BEACON-INERT — the positive control for the permission beacon. This is the "can we even SEE a
# blocked approval" half: without it, an empty beacon dir and a beacon that has never run are the
# same observation, and the board reports all-clear either way. That is not hypothetical — it is
# what happened: `cc-blockers` said "no safeguard-blocked sessions surfaced" while a teammate was
# demonstrably blocked, because the hook was registered nowhere and /tmp/cc-permission-pending/ had
# never been created.
#
# EXISTENCE EVIDENCE, twice over: the hook must be DEPLOYED here (a host that never had the feature
# is not a host where it "stopped"), and >=1 settings.json must exist among the config dirs (a
# fixtured $HOME void satisfies the letter of "wired nowhere" without the premise — the same phantom
# row the verifier alarm had to fix after inventing one in tests/cc-relogin-status.bats).
beacon_alarm_rows() { # → one JSON object per line (possibly none)
  local now d wired=0 have_settings=0
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac
  [ -e "$BEACON_HOOK" ] || return 0                                   # feature not deployed ⇒ no premise
  for d in $BEACON_CONFIG_DIRS; do
    [ -f "$d/settings.json" ] || continue
    have_settings=1
    grep -q 'cc-permission-beacon\.sh' "$d/settings.json" 2>/dev/null && wired=1
  done
  [ "$have_settings" -eq 1 ] || return 0                              # no settings anywhere ⇒ no premise

  if [ "$wired" -eq 0 ]; then
    printf '{"kind":"beacon-inert","state":"NOT-WIRED","detail":"registered in no settings.json; never fires","subject":"%s","recover_cmd":"CONFIRM=1 bash %s","ts":%s}\n' \
      "$BEACON_HOOK" "$BEACON_ACTIVATE_SH" "$now"
    return 0    # terminal: a hook registered nowhere cannot have fired, so NEVER-FIRED adds no news
  fi

  # The heartbeat's whole job: the dir exists after the FIRST hook call of any session, so its
  # absence means "never invoked" and never "nothing was pending".
  [ -d "$PERMPEND_DIR" ] && return 0
  printf '{"kind":"beacon-inert","state":"NEVER-FIRED","detail":"wired but has never run; no beacon dir","subject":"%s","recover_cmd":"printf %s | %s write ; ls -la %s","ts":%s}\n' \
    "$PERMPEND_DIR" "'{\\\"session_id\\\":\\\"smoke-1\\\"}'" "$BEACON_HOOK" "$PERMPEND_DIR" "$now"
}

# (h) TEAMMATE-REAP OUTCOME — the close path's own health, read from its OUTCOME and nothing else.
#
# WHY THIS ROW EXISTS AT ALL. Between 2026-07-25 and 2026-08-03 not one teammate pane self-closed,
# and nobody noticed for nine days while four investigations each found a real defect, fixed it, and
# honestly reported the class resolved. Reading REASONS could not tell four fixes from no fix: the
# close path is a chain of fail-closed gates over one question the member usually cannot answer, so
# clearing any gate's reason just hands the refusal to the next one and the log CHANGES while the
# outcome stays at zero. Only `✓ closed pane` separates them.
#
# WHY HERE AND NOT THE MAILBOX. The subsystem already pages: `⚑ SURFACE` fired 156 times and was
# read ZERO times — the desk role was repointed on 2026-07-26 and nothing has drained the new box
# since, so 156 pages produced 0 manual closes. A 157th unread line is not a backstop. cc-blockers
# is PULL-rendered from disk truth at close time and needs no live consumer to exist, which is the
# whole difference (memory: alarm-polarity-and-attention-budget).
#
# The subject owns its own thresholds, denominator and NOT-EXERCISED abstain; this row only relays
# its verdict. Two readers of one metric would drift, and the drift would be invisible.
teammate_reap_rows() { # → one JSON object per line (possibly none)
  local now v out
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac
  [ -x "$REAP_ALARM_SH" ] || return 0                                 # not deployed ⇒ no premise
  out="$("$REAP_ALARM_SH" --json 2>/dev/null || true)"
  [ -n "$out" ] || return 0
  v="$(printf '%s' "$out" | jq -r '.verdict // empty' 2>/dev/null || true)"
  # OK and NOT-EXERCISED are silence by design; NO-DATA asserts nothing and must not read as a
  # blocker either — an unreadable log is a gap in evidence, not a verdict about the fleet.
  case "$v" in ALARM|WARN) : ;; *) return 0 ;; esac
  printf '{"kind":"teammate-reap","state":"%s","detail":"%s","subject":"%s","recover_cmd":"%s","ts":%s}\n' \
    "$v" \
    "$(printf '%s' "$out" | jq -r '"\(.closes) close(s) in \(.idle_events) decisions over \(.window_d)d; last close \(.last_close)"' 2>/dev/null)" \
    "$REAP_ALARM_SH" "$REAP_ALARM_SH" "$now"
}

# (f) PERMISSION-PENDING — the READING half of the beacon, and the reason this exists is that it was
# missing. `beacon-inert` above only ever asked "is the beacon WIRED", answering with the presence of
# the directory: `[ -d "$PERMPEND_DIR" ] && return 0`. That was the ONLY consumption of PERMPEND_DIR
# in this file, so the board proved the sensor works and then never read what the sensor recorded.
# Measured 2026-07-31: three live beacons sat in that directory — one 18 HOURS old — while
# cc-blockers rendered LAND-PIPELINE and FLEET sections and not one word about a blocked approval.
# The incident quoted at the top of this file ("said no safeguard-blocked sessions surfaced while a
# teammate was demonstrably blocked") was therefore only half-closed: the wiring half was fixed, the
# reading half was not, and the board stayed silent for the same operator-visible reason.
#
# ADDRESSING is the whole value. A row saying "something is blocked" is barely better than silence at
# this fleet's size, so each row resolves its session to an iTerm2 pane through the cc-registry
# (which carries `session_id` alongside `paneUUID`) and hands over `it2 session focus <uuid>` — one
# command that puts the operator in front of the prompt. An UNRESOLVED session is reported as
# unresolved and still listed: dropping it would rebuild the silence this row exists to break.
permission_pending_rows() { # → one JSON object per line (possibly none)
  local now f sid age cmd cwd bts pane reg
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) return 0 ;; esac
  # Absence here is NOT this row's verdict to give — `beacon_alarm_rows` owns the never-ran case,
  # and a second implementation of that premise would be a second answer.
  [ -d "$PERMPEND_DIR" ] || return 0

  for f in "$PERMPEND_DIR"/*.json; do
    [ -e "$f" ] || continue                                   # the glob itself when nothing matches
    sid="$(basename "$f" .json)"
    bts="$(jq -r '.ts // empty' "$f" 2>/dev/null || true)"
    case "${bts:-}" in ''|*[!0-9]*) bts="$now" ;; esac         # unreadable ts ⇒ age 0, never negative
    age=$(( now - bts )); [ "$age" -lt 0 ] && age=0
    cmd="$(jq -r '(.tool_input.command? // .tool_input.file_path? // (.tool_input? | tostring) // "")
                  | gsub("[\n\r\t]"; " ") | .[0:60]' "$f" 2>/dev/null || true)"
    cwd="$(jq -r '.cwd // ""' "$f" 2>/dev/null || true)"

    # Join to the pane. Matching on the FILE CONTENT keyed by session_id, because the registry is
    # keyed by paneUUID — the two identifiers are different, and assuming otherwise is how a writer
    # and a reader end up addressing different boxes (memory mailbox-writer-reads-different-key).
    pane=""
    for reg in "$CC_REGISTRY_DIR"/*.json; do
      [ -e "$reg" ] || continue
      [ "$(jq -r '.session_id // empty' "$reg" 2>/dev/null || true)" = "$sid" ] || continue
      pane="$(jq -r '.paneUUID // empty' "$reg" 2>/dev/null || true)"
      [ -n "$pane" ] && break
    done

    jq -nc --arg sid "$sid" --arg cmd "$cmd" --arg cwd "${cwd##*/}" --arg pane "$pane" \
           --arg bf "$f" --argjson age "$age" --argjson now "$now" '
      { kind: "permission-pending",
        state: (if $age >= 3600 then "BLOCKED-\(($age / 3600) | floor)h"
                else "BLOCKED-\(($age / 60) | floor)m" end),
        subject: $sid,
        detail: (($cwd | if . == "" then "?" else . end) + ": " + $cmd),
        recover_cmd: (if $pane == "" then "jq . \($bf)"
                      else "it2 session focus \($pane)" end),
        ts: $now }' 2>/dev/null || true
  done
}

# ── FLEET alarm (DAEMON_FLEET_V2 §4.3) ───────────────────────────────────────────────────────────
# The ONLY consumer-side code for the fleet: bin/cc-fleet reads launchd/fleet.manifest, reconciles
# declared-vs-actual, and emits one kind=="fleet-inert" line per label that is not in its declared
# state. Nothing about that state function lives here — a second implementation is a second answer,
# and the whole point of the manifest is that there is exactly one.
#
# FAIL-OPEN, and specifically WITHOUT COLLATERAL. Three failure shapes are all one verdict (no rows,
# no error, exit unchanged): the producer is absent or not executable; it exits non-zero; it emits
# something that is not JSON. The third is why the filter runs HERE rather than letting the lines
# fall into the `jq -s '.'` composition below: one garbage line reaching that slurp fails the whole
# array, and `|| true` would then hand back '[]' — silently deleting the land-pipeline and dispatch
# rows too. A sensor's own failure must never blind the sensors beside it. `fromjson?` is this
# file's established malformed-line idiom (:253, :297) and skips exactly the bad line.
#
# Rows are otherwise passed THROUGH unmodified: cc-fleet owns .state/.detail/.recover_cmd, including
# the DETAIL cell's ASCII-only, <=44-byte contract (the renderer pads by BYTES, so one em-dash
# shifts the column). Filtering on .kind only — never on the .state enum — so a state the reconciler
# adds later still reaches the operator instead of being silently dropped by its consumer.
fleet_alarm_rows() { # → one JSON object per line (possibly none)
  local out
  [ -x "$CC_FLEET_BIN" ] || return 0                                  # absent/not-exec ⇒ no verdict
  out="$("$CC_FLEET_BIN" --json 2>/dev/null)" || return 0              # non-zero ⇒ fail open
  [ -n "$out" ] || return 0
  printf '%s\n' "$out" | jq -cRn 'inputs | fromjson? | select(type=="object")
                                  | select(.kind == "fleet-inert")' 2>/dev/null || true
}

# ── plist SSOT parity (DAEMON_FLEET_V2 §4.4) ─────────────────────────────────────────────────────
deref() { # <path> → the real file behind any symlink chain (readlink -f, BSD-safe fallback)
  local p="$1" t n=0
  readlink -f "$p" 2>/dev/null && return 0
  while [ -L "$p" ] && [ "$n" -lt 20 ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
    n=$(( n + 1 ))
  done
  printf '%s\n' "$p"
}

resolve_plist_repo() { # → the repo-side launchd/ dir, or rc 1. NEVER a vacuous ~/.claude "pass".
  local root
  if [ -n "${CC_BLOCKERS_PLIST_REPO:-}" ]; then
    [ -d "$CC_BLOCKERS_PLIST_REPO" ] || return 1
    printf '%s\n' "$CC_BLOCKERS_PLIST_REPO"; return 0
  fi
  # deref FIRST: invoked live we are ~/.claude/bin/cc-blockers, a symlink into the checkout, so a
  # bare dirname yields ~/.claude — which has no launchd/ and, worse, would be accepted as the SSOT
  # by a check that only tested for the directory. The `.git` gate is the anti-vacuous-pass guard:
  # a checkout has one (a dir, or a FILE in a linked worktree, hence -e not -d); ~/.claude does not.
  root="$(cd "$(dirname "$(deref "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)" || root=""
  if [ -n "$root" ] && [ -e "$root/.git" ] && [ -d "$root/$PLIST_REL" ]; then
    printf '%s\n' "$root/$PLIST_REL"; return 0
  fi
  [ -e "$DEPLOY_REPO/.git" ] && [ -d "$DEPLOY_REPO/$PLIST_REL" ] \
    && { printf '%s\n' "$DEPLOY_REPO/$PLIST_REL"; return 0; }
  return 1
}

# Whole-file `cmp -s`, and no plutil anywhere: `plutil -extract k json <file>` WITHOUT `-o -`
# rewrites the plist IN PLACE (it destroyed 5 LaunchAgents on 2026-07-25), and byte equality is the
# actual property under test — a semantic read would call two files "the same" while launchd loads
# different bytes than the ones in git.
plist_parity_rows() { # → one JSON object per line (possibly none)
  local repo now f b label
  now="$(date +%s 2>/dev/null || true)"
  case "${now:-}" in ''|*[!0-9]*) now=0 ;; esac
  if ! repo="$(resolve_plist_repo)"; then
    # LOUD, never a silent pass: a parity check that could not run is a finding of its own.
    printf '{"kind":"plist-parity","state":"UNRESOLVABLE","detail":"repo SSOT unresolved; parity DID NOT RUN","subject":"%s","recover_cmd":"CC_BLOCKERS_PLIST_REPO=%s/%s cc-blockers --plist-parity","ts":%s}\n' \
      "$PLIST_REL" "$DEPLOY_REPO" "$PLIST_REL" "$now"
    return 0
  fi
  if [ ! -d "$LIVE_AGENTS_DIR" ]; then
    printf '{"kind":"plist-parity","state":"UNRESOLVABLE","detail":"LaunchAgents dir absent; parity DID NOT RUN","subject":"%s","recover_cmd":"ls -la %s","ts":%s}\n' \
      "$LIVE_AGENTS_DIR" "$LIVE_AGENTS_DIR" "$now"
    return 0
  fi
  # LIVE side. An unmatched glob stays literal, hence the -f guard on every iteration.
  for f in "$LIVE_AGENTS_DIR"/com.claude.*.plist; do
    [ -f "$f" ] || continue
    b="${f##*/}"; label="${b%.plist}"
    # The SSOT may be committed at launchd/<name> OR launchd/staged/<name>. Both are COMMITTED; the
    # staged/ one is merely withheld from installation, so neither "never committed" nor the `cp into
    # launchd/` remedy is true of it. That remedy was actively harmful: install.sh:452 globs
    # launchd/*.plist and bootstraps each one, so pasting it would make a routine install
    # auto-activate whatever was staged — for com.claude.relogin, credentials automation, which is
    # precisely what staging it prevents (8a1e49ab). Resolving staged/ HERE, on the live side only,
    # keeps the REPO-side glob below non-recursive, so a staged plist is still never REPO-ONLY.
    ssot="$repo/$b"
    [ -f "$ssot" ] || ssot="$repo/staged/$b"
    # Mirrors activation-watch.sh's `.local` convention: an adjacent <name>.plist.local declares the
    # file intentionally live-only, so a legitimately un-committable plist does not train
    # alarm-fatigue on this channel. It exempts LIVE-ONLY only — drift still reports.
    if [ ! -f "$ssot" ]; then
      [ -f "$f.local" ] && continue
      printf '{"kind":"plist-parity","state":"LIVE-ONLY","detail":"installed but never committed to launchd/","subject":"%s","recover_cmd":"cp %s %s   # then commit it","ts":%s}\n' \
        "$label" "$f" "$repo/$b" "$now"
    elif ! cmp -s "$f" "$ssot"; then
      printf '{"kind":"plist-parity","state":"CONTENT-DRIFT","detail":"live bytes differ from the committed SSOT","subject":"%s","recover_cmd":"diff %s %s","ts":%s}\n' \
        "$label" "$ssot" "$f" "$now"
    fi
  done
  # REPO side. Only the top-level launchd/*.plist are declared installable — launchd/staged/ is the
  # existing convention for a committed-but-deliberately-uninstalled plist, and this glob is not
  # recursive, so a staged plist is out of scope by construction rather than by exemption.
  for f in "$repo"/com.claude.*.plist; do
    [ -f "$f" ] || continue
    b="${f##*/}"; label="${b%.plist}"
    [ -f "$LIVE_AGENTS_DIR/$b" ] && continue
    printf '{"kind":"plist-parity","state":"REPO-ONLY","detail":"committed but not installed in LaunchAgents","subject":"%s","recover_cmd":"cp %s %s","ts":%s}\n' \
      "$label" "$f" "$LIVE_AGENTS_DIR/$b" "$now"
  done
}

# ── the shared renderer ──────────────────────────────────────────────────────────────────────────
# CELL and alarm_table() are DEFINITIONS ONLY and sit above the sensor composition so the
# --plist-parity leg below can reach the same renderer without first running the land-pipeline and
# dispatch sensors it has nothing to do with (which would also make that leg read the operator's
# live disk from inside a suite). Bodies are unchanged from where they used to live; only the
# position moved, plus alarm_table's optional source argument.
#
# Every @tsv cell is padded to a NON-EMPTY, tab/newline-free value before it reaches `read`.
# Load-bearing, not cosmetic: tab is IFS-*whitespace*, so `IFS=$'\t' read` collapses a run of
# tabs and ANY empty field shifts every later field LEFT — a row with no .refusal used to slide
# recover_cmd into the refusal variable and render the RECOVER column blank, i.e. the operator's
# one-glance board silently dropping the exact command it exists to hand over. (A non-whitespace
# IFS is NOT the fix — $'\001' does not split at all on macOS bash 3.2.) `//` alone is not enough
# either: it substitutes for null/false, never for an empty string, so the ""-default on .refusal
# was the live case. Placeholder is chosen per column so the rendered table is unchanged for every
# row that HAS the field.
CELL='def cell(ph): (. // "") | tostring | gsub("[\\t\\r\\n]"; " ") | if . == "" then ph else . end; '

# <jq-select> [json-source] [subject-col-width] — every alarm family shares ONE renderer, never two.
#
# A non-zero third arg inserts a SUBJECT column between STATE and DETAIL; the default 0 keeps the
# LAND and DISPATCH tables byte-identical to what they have always printed. WHY the column exists at
# all, and why it is opt-in rather than always-on: measured against the real bin/cc-fleet on this box,
# the fleet family emits 13 rows of which 6 are identical in KIND, STATE, DETAIL *and* RECOVER —
# `DISABLED / disabled at the domain level (C10) / CONFIRM=1 bash …18-fleet-activate.sh` three times
# over. Those rows are per-LABEL and the label IS their identity, so without it the board hands the
# operator a verdict they cannot attribute to a job, which is not an honest verdict (§4.3's floor).
# The land and dispatch families do not want it: their .subject is a PATH (a stamps dir, a deploy
# checkout) that would be truncated into noise, and their KIND already varies row to row.
# ONE jq program either way — .subject is always selected (with CELL's non-empty placeholder, so the
# @tsv field count never changes and the field-collapse trap above cannot reopen) and simply unread
# in the 4-column branch. A second printf pair is not a second renderer; a second jq+read+loop would
# be, which is what this avoids.
alarm_table() {
  local src="${2:-$ALARMS_JSON}" sw="${3:-0}"
  if [ "$sw" != 0 ]; then printf "%-15s %-16s %-${sw}s %-44s %s\n" KIND STATE SUBJECT DETAIL RECOVER
  else                     printf '%-15s %-16s %-44s %s\n' KIND STATE DETAIL RECOVER; fi
  printf '%s' "$src" | jq -r "$CELL"'.[] | '"$1"' | [
      (.kind        | cell("?")),
      (.state       | cell("?")),
      (.subject     | cell("-")),
      (.detail      | cell("-")),
      (.recover_cmd | cell("?"))
    ] | @tsv' | while IFS=$'\t' read -r kind state subject detail cmd; do
      if [ "$sw" != 0 ]; then
        printf "%-15s %-16s %-${sw}s %-44s %s\n" \
          "${kind:0:15}" "${state:0:16}" "${subject:0:$sw}" "${detail:0:44}" "$cmd"
      else
        printf '%-15s %-16s %-44s %s\n' "${kind:0:15}" "${state:0:16}" "${detail:0:44}" "$cmd"
      fi
    done
}

# ── the --plist-parity leg (§4.4) — its own leg, and terminal. It is deliberately NOT folded into
# the default board: the parity sensors are $HOME-rooted, and every suite that renders the default
# board fixtures the board sensors but not $HOME, so folding it in would make those suites read the
# operator's real ~/Library/LaunchAgents. Exits here, before any land-pipeline sensor is touched.
if [ "$PARITY" = 1 ]; then
  PARITY_JSON="$(plist_parity_rows 2>/dev/null | jq -s '.' 2>/dev/null || true)"
  [ -n "$PARITY_JSON" ] || PARITY_JSON='[]'
  if [ "$JSON" = 1 ]; then printf '%s\n' "$PARITY_JSON"; exit 0; fi
  np="$(printf '%s' "$PARITY_JSON" | jq 'length' 2>/dev/null || echo 0)"
  PARITY_REPO="$(resolve_plist_repo || true)"
  if [ "${np:-0}" = 0 ]; then
    echo "plist SSOT parity: 0 drift — ${PARITY_REPO:-$PLIST_REL} and $LIVE_AGENTS_DIR agree"
    exit 0
  fi
  echo "PLIST-SSOT PARITY — $np drift(s): repo ${PARITY_REPO:-unresolved} vs live $LIVE_AGENTS_DIR (run the RECOVER command; declare an intentional live-only with: touch $LIVE_AGENTS_DIR/<label>.plist.local):"
  # Subject column: the parity rows are per-LABEL too, and three CONTENT-DRIFT rows read identically
  # without it. 34 matches the fleet table so the two boards line up.
  alarm_table 'select(.kind=="plist-parity")' "$PARITY_JSON" 34
  exit 0
fi

# Composed AFTER every alarm function is DEFINED, not merely after the ones that existed when
# this line was first written. Bash resolves a function name at CALL time in source order: with
# this line above `fleet_alarm_rows()`, the call hit `command not found`, went straight into the
# `2>/dev/null`, and the fleet family produced ZERO rows on a board that looked healthy. The
# fail-open that makes a dead sensor safe is the same one that makes a mis-ordered call silent.
ALARMS_JSON="$({ alarm_rows; deploy_stale_rows; dispatch_alarm_rows; orphan_approver_rows; beacon_alarm_rows; permission_pending_rows; fleet_alarm_rows; teammate_reap_rows; } 2>/dev/null | jq -s '.' 2>/dev/null || true)"

[ -n "$ALARMS_JSON" ] || ALARMS_JSON='[]'

BOARD_ABSENT=0
if [ ! -f "$IDL_FILE" ]; then BOARD_ABSENT=1; fi

# Latest blocked row per subject, newest-first, both kinds in ONE array: safeguard-blocked dedups
# per pane (the reaper appends one per surfacing sweep), relogin-blocked per acct (the poller
# appends one per escalated tick). group_by needs a total key, hence the // "?" on each.
if [ "$BOARD_ABSENT" = 1 ]; then
  ROWS='[]'
else
  ROWS="$(jq -Rn '[ inputs | fromjson? | select(type=="object") ] as $all
                  | ([ $all[] | select(.kind=="safeguard-blocked") ] | group_by(.pane // "?") | map(max_by(.ts)))
                  + ([ $all[] | select(.kind=="relogin-blocked")  ] | group_by(.acct // .account // "?") | map(max_by(.ts)))
                  | sort_by(.ts) | reverse' "$IDL_FILE" 2>/dev/null || echo '[]')"
  [ -n "$ROWS" ] || ROWS='[]'
fi

# ── the STALE-RELOGIN drop (this file's own latching defect, 2026-08-01) ─────────────────────────
# A relogin-blocked row LATCHES: cc-relogin-poll can never retract one. Its account loop skips any
# healthy account before it ever reaches the escalate block (bin/cc-relogin-poll:183 — `case
# "${state:-}" in REQUIRED|EXPIRING) ;; *) continue ;;`), so once the operator re-logs in, the
# account stops being iterated and NO retraction row is reachable by construction. This renderer then
# took the newest row per account and printed it as CURRENT state. Measured live: a row raised
# 2026-07-31 for deadline 2026-08-02 was still on the board after the deadline moved to 2026-08-28,
# and the exact command the board printed answered `cc-relogin next: REFUSED (2) — no re-auth needed
# — healthy`. A board whose own remedy refuses is trained-to-ignore, which is the defect this whole
# file exists to kill.
#
# THE RULE — timestamps only. A row is PINNED to the deadline it was raised for, so once the
# account's live login_expires_at is LATER than that deadline, the row is answering a question that
# no longer exists. This is not a new predicate: it is the poller's OWN rule at
# bin/cc-relogin-poll:257 (`if [ "$S_DL" != "$DL" ]; then S_ATT=0; S_ESC=""; fi` — a moved deadline
# starts a fresh cycle), applied to the row it left behind, so the two agree instead of drifting.
#
# DELIBERATELY NOT a re-auth predicate. `cc-relogin`'s need_relogin() (bin/cc-relogin:183-210) is the
# authoritative gate for "does this account need re-auth"; a second copy here would rot against it
# and the board would start contradicting the tool it dispatches to. We compare two TIMESTAMPS
# against the same claude-accounts SSOT both tools already read, and we never shell out to
# cc-relogin — it takes the heal lock and can ACT, and a renderer must not act.
#
# FAIL-OPEN IN EVERY UNCERTAIN CASE — the row is KEPT when: there is no relogin row to judge,
# claude-accounts is absent / errors / emits unparseable JSON, the account has no row or no
# login_expires_at, or either timestamp does not parse as UTC ISO-8601. A renderer must never be the
# reason a real class-C escalation goes unseen; a stale row is noise, a dropped live one is silence.
ACCOUNTS_BIN="${CC_BLOCKERS_ACCOUNTS_BIN:-claude-accounts}"
drop_stale_relogin() { # <rows-json> → the same rows, minus every relogin row the account has outlived
  local rows="$1" accts="" map="" out=""
  # Asked ONLY when there is something to ask about. With no relogin row the query is pure cost, and
  # — the reason this gate is load-bearing rather than an optimisation — every suite that fixtures
  # the board but not PATH would otherwise shell out to the operator's live accounts on every test.
  if ! printf '%s' "$rows" | jq -e 'any(.[]?; .kind=="relogin-blocked")' >/dev/null 2>&1; then
    printf '%s' "$rows"; return 0
  fi
  if command -v "$ACCOUNTS_BIN" >/dev/null 2>&1; then
    accts="$("$ACCOUNTS_BIN" --no-heal --json 2>/dev/null || true)"
  fi
  [ -n "$accts" ] || { printf '%s' "$rows"; return 0; }
  # acct → login_expires_at, built in its own pass so an unparseable payload fails open HERE rather
  # than half-way through the filter below.
  map="$(printf '%s' "$accts" | jq -c '
      [ .rows[]? | select(type=="object")
        | select((.acct? != null) and (.login_expires_at? != null))
        | {key: (.acct|tostring), value: (.login_expires_at|tostring)} ] | from_entries' 2>/dev/null || true)"
  [ -n "$map" ] || { printf '%s' "$rows"; return 0; }
  # epoch: UTC ISO-8601 → seconds, else null. The board writes `…:49Z`; claude-accounts writes
  # `…:10.065000+00:00`. Both normalise to the one shape jq's fromdateiso8601 accepts; ANY other
  # shape (a non-UTC offset, a truncated stamp, a non-string) yields null and the row is kept.
  out="$(printf '%s' "$rows" | jq -c --argjson live "$map" '
      def epoch:
        if type != "string" then null
        else (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | sub("-00:00$"; "Z"))
             | if test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")
               then (try fromdateiso8601 catch null) else null end
        end;
      map(select(
        (.kind != "relogin-blocked")
        or (((.deadline // null) | epoch) as $d
            | (($live[((.acct // .account // "") | tostring)] // null) | epoch) as $l
            | ($d == null or $l == null or $d >= $l))
      ))' 2>/dev/null || true)"
  [ -n "$out" ] || out="$rows"
  printf '%s' "$out"
}
ROWS="$(drop_stale_relogin "$ROWS")"
[ -n "$ROWS" ] || ROWS='[]'

# ONE array, alarms first: they are a STANDING state of the pipeline, not a per-pane event, and a
# JSON consumer that saw only the board rows would be blind to exactly the silent-death case the
# alarms exist for.
if [ "$JSON" = 1 ]; then
  printf '%s\n%s\n' "$ALARMS_JSON" "$ROWS" | jq -s 'add' 2>/dev/null || printf '%s\n' "$ROWS"
  exit 0
fi

n="$(printf '%s' "$ROWS" | jq '[.[] | select(.kind=="safeguard-blocked")] | length' 2>/dev/null || echo 0)"
nr="$(printf '%s' "$ROWS" | jq '[.[] | select(.kind=="relogin-blocked")] | length' 2>/dev/null || echo 0)"
na="$(printf '%s' "$ALARMS_JSON" | jq 'length' 2>/dev/null || echo 0)"
# The alarms ride in ONE --json array (a consumer must see them all) but render as SEPARATE tables:
# the families have different owners and different recovery paths, and a dispatch row printed under a
# "the landing net is degraded" heading sends the operator to the wrong subsystem. One renderer
# (alarm_table), N selectors — never a second renderer.
# A kind absent from this selector is EMITTED and then silently dropped from the table — it rides the
# --json array and vanishes from the one surface the operator reads. That is not hypothetical: the
# mirror bug has bitten this file before, which is why every kind here carries a render test.
LAND_SEL='select(.kind=="verifier-inert" or .kind=="trunk-red" or .kind=="deploy-lag" or .kind=="deploy-stale" or .kind=="never-green")'
DISP_SEL='select(.kind=="dispatch-inert")'
# ONE family for both approval kinds, on the same rule that splits LAND from DISPATCH: they share a
# subsystem and an owner. A stuck assignee and an unwired beacon are the SAME operator question —
# "an approval cannot reach an approver" — seen from the live end and the visibility end.
APPR_SEL='select(.kind=="orphaned-approver" or .kind=="beacon-inert" or .kind=="permission-pending")'
nl="$(printf '%s' "$ALARMS_JSON" | jq "[.[] | $LAND_SEL] | length" 2>/dev/null || echo 0)"
nd="$(printf '%s' "$ALARMS_JSON" | jq "[.[] | $DISP_SEL] | length" 2>/dev/null || echo 0)"
np="$(printf '%s' "$ALARMS_JSON" | jq "[.[] | $APPR_SEL] | length" 2>/dev/null || echo 0)"
FLEET_SEL='select(.kind=="fleet-inert")'
nf="$(printf '%s' "$ALARMS_JSON" | jq "[.[] | $FLEET_SEL] | length" 2>/dev/null || echo 0)"
# Its own family: the teammate close path's OUTCOME, kept apart from every other kind on purpose.
# Folding it into FLEET or DISPATCH would put a "did the work actually happen" signal in with
# "is the daemon in its declared state" — and the whole lesson of the nine-day outage is that those
# are different questions. Every mechanism in this path was in its declared state throughout.
REAP_SEL='select(.kind=="teammate-reap")'
# NOT `nr` — that name is already the RELOGIN-BLOCKED count at :1094, and taking it here
# silently emptied the relogin table and flipped the board to its all-clear line. An added
# alarm that suppresses an existing one is the worst possible version of this change.
ntr="$(printf '%s' "$ALARMS_JSON" | jq "[.[] | $REAP_SEL] | length" 2>/dev/null || echo 0)"
# ── the ALL-CLEAR line, and why it carries a SENSOR ROSTER (OPERATOR_SURFACE_V2 §4 M8) ───────────
# Every sensor family above fails OPEN by design (R5/I6: a board that invents blockers is ignored
# exactly like one that hides them). The cost is that a ZERO-ROW board means EITHER "everything is
# healthy" OR "every sensor is broken", and the operator cannot tell which. That is not hypothetical
# and it is not a new hazard — it is the incident quoted at the top of this file verbatim:
# `cc-blockers` said "no safeguard-blocked sessions surfaced" while a teammate was demonstrably
# blocked, because the beacon hook was registered nowhere. `beacon-inert` closed that ONE case; the
# aggregate line still could not distinguish nothing-to-report from nothing-could-be-read.
#
# WHAT THIS IS AND IS NOT, stated precisely because an over-claim here would be the same defect
# inverted. It reports SENSOR READABILITY — can each family's primary input be read at all — NOT
# "every family rendered a verdict". Anything stronger would need a second implementation of each
# family's premise logic, and a second implementation is a second answer.
#
# AND IT DOES NOT EDITORIALIZE, deliberately. The first cut of this appended "NOT a clean bill of
# health" whenever any sensor read `x` — which on a FRESH host (no board file yet, cc-fleet not
# installed) is the normal state, so it would have cried wolf on every clean install and trained the
# operator to skip the line. That is the mirror of the defect this whole rebuild is about. A COUNT is
# scannable and makes no claim: `sensors 3/5 readable (… fleet:x board:x)` lets the reader see that
# silence here is not evidence, without the board asserting an alarm it cannot justify.
# Printed ONLY on the all-clear path: when rows exist, the rows are the message.
sensor_roster() { # → "<n> <roster>" — readable count and the per-sensor detail, one pass
  local r="" k=0
  if [ -d "$STAMPS_DIR" ];         then r="stamps:ok";      k=$((k+1)); else r="stamps:x"; fi
  if [ -x "$LAUNCHCTL_BIN" ];      then r="$r launchctl:ok"; k=$((k+1)); else r="$r launchctl:x"; fi
  if ps -axo pid= >/dev/null 2>&1; then r="$r ps:ok";        k=$((k+1)); else r="$r ps:x"; fi
  if [ -x "$CC_FLEET_BIN" ];       then r="$r fleet:ok";     k=$((k+1)); else r="$r fleet:x"; fi
  if [ -f "$IDL_FILE" ];           then r="$r board:ok";     k=$((k+1)); else r="$r board:x"; fi
  printf '%s %s' "$k" "$r"
}

if [ "${n:-0}" = 0 ] && [ "${nr:-0}" = 0 ] && [ "${na:-0}" = 0 ]; then
  ROSTER="$(sensor_roster 2>/dev/null || true)"
  RK="${ROSTER%% *}"; RDETAIL="${ROSTER#* }"
  case "${RK:-}" in ''|*[!0-9]*) RK="?"; RDETAIL="unreadable" ;; esac
  if [ "$BOARD_ABSENT" = 1 ]; then MSG="no safeguard-blocked sessions (board $IDL_FILE absent)"
  else MSG="no safeguard-blocked sessions surfaced"; fi
  printf '%s — sensors %s/5 readable (%s)\n' "$MSG" "$RK" "$RDETAIL"
  exit 0
fi

if [ "${nl:-0}" != 0 ]; then
  echo "LAND-PIPELINE — $nl alarm(s): the landing net is degraded (run the RECOVER command):"
  alarm_table "$LAND_SEL"
fi

if [ "${nd:-0}" != 0 ]; then
  [ "${nl:-0}" != 0 ] && echo
  echo "DISPATCH — $nd alarm(s): autonomy work is not being decided (run the RECOVER command):"
  alarm_table "$DISP_SEL"
fi

if [ "${np:-0}" != 0 ]; then
  { [ "${nl:-0}" != 0 ] || [ "${nd:-0}" != 0 ]; } && echo
  echo "APPROVAL — $np alarm(s): an approval request cannot reach an approver (run the RECOVER command):"
  alarm_table "$APPR_SEL"
fi

# FLEET last of the four alarm families and deliberately its own table: these rows are the FLOOR
# (every declared label gets one honest verdict), so a label may legitimately appear both here and
# in the dispatch table above with a different, more specific diagnosis. Two rows for one label is
# the design, not a duplicate — dedup would delete exactly the specific one worth reading.
if [ "${nf:-0}" != 0 ]; then
  { [ "${nl:-0}" != 0 ] || [ "${nd:-0}" != 0 ] || [ "${np:-0}" != 0 ]; } && echo
  echo "FLEET — $nf label(s) not in their declared state (run the RECOVER command):"
  # 34 = the longest label the manifest declares today (com.claude.session-search-backfill). A label
  # is pasted verbatim into launchctl, so it is shown WHOLE rather than prefix-stripped or elided.
  alarm_table "$FLEET_SEL" "$ALARMS_JSON" 34
fi

# TEAMMATE-REAP — panes that finished and were never reaped. This is an OUTCOME row, so it says how
# many closes happened, never which gate refused: reasons rotate (dirty-tree -> WORKTREE-unresolved
# -> shared-cwd) while the outcome stays at zero, and reading them is what let four fixes ship
# against an unmoved metric. The subject owns the thresholds; this only relays.
if [ "${ntr:-0}" != 0 ]; then
  { [ "${nl:-0}" != 0 ] || [ "${nd:-0}" != 0 ] || [ "${np:-0}" != 0 ] || [ "${nf:-0}" != 0 ]; } && echo
  echo "TEAMMATE-REAP — the idle-close path is not closing panes (run the command to see why):"
  alarm_table "$REAP_SEL" "$ALARMS_JSON" 34
fi

if [ "${n:-0}" != 0 ]; then
  [ "${na:-0}" != 0 ] && echo
  echo "SAFEGUARD-BLOCKED — $n fired peer(s) refused by model safeguards (re-fire with the RECOVER command):"
  printf '%-22s %-18s %-9s %-40s %s\n' SLUG ACCT MODEL REFUSAL RECOVER
  printf '%s' "$ROWS" | jq -r "$CELL"'.[] | select(.kind=="safeguard-blocked") | [
      ((.name // .pane) | cell("?")),
      (.account       | cell("?")),
      (.blocked_model | cell("?")),
      (.refusal       | cell("-")),
      (.recover_cmd   | cell("?"))
    ] | @tsv' | while IFS=$'\t' read -r slug acct model refusal cmd; do
      printf '%-22s %-18s %-9s %-40s %s\n' "${slug:0:22}" "${acct:0:18}" "${model:0:9}" "${refusal:0:40}" "$cmd"
    done
fi

if [ "${nr:-0}" != 0 ]; then
  { [ "${n:-0}" != 0 ] || [ "${na:-0}" != 0 ]; } && echo
  echo "RELOGIN-BLOCKED — $nr account(s) escalated by cc-relogin-poll (run the RECOVER command):"
  printf '%-10s %-12s %-26s %s\n' ACCT STATE DEADLINE RECOVER
  printf '%s' "$ROWS" | jq -r "$CELL"'.[] | select(.kind=="relogin-blocked") | [
      ((.acct // .account)                     | cell("?")),
      ((.state // .reason)                     | cell("ESCALATED")),
      ((.login_expires_at // .deadline // .when) | cell("?")),
      (.recover_cmd                            | cell("?"))
    ] | @tsv' | while IFS=$'\t' read -r acct state when cmd; do
      printf '%-10s %-12s %-26s %s\n' "${acct:0:10}" "${state:0:12}" "${when:0:26}" "$cmd"
    done
fi
