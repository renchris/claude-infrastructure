#!/bin/bash
# shellcheck disable=SC2015  # file-wide: the selftest's `[ test ] && okp || badp` reporter idiom is
# intentional — okp/badp always return 0 (printf + arithmetic), so SC2015's "C runs when A true but B
# fails" cannot occur.
#
# cc-teardown — reliable, effect-verified, safety-gated teardown of a DONE Claude Code session.
#
# The orchestrator desk must autonomously + reliably close a FINISHED session: kill the claude process
# AND close its iTerm2 pane AND VERIFY both actually happened. Every primitive already exists — this is a
# COMPOSITION with a fail-closed safety gate and a re-observed effect-verify (the anti-keystroke-faith fix:
# a close that returns 0 is NOT a closed pane; we re-list and assert absence). It NEVER trusts a keystroke
# or an exit code as proof; only a re-observation counts.
#
#   cc-teardown <pane-uuid|name> --done-evidence <text>
#       exit 0  = torn down + BOTH legs effect-verified (or idempotent already-gone)
#       exit 10 = DEFER  (work-unsafe: dirty | committed-not-pushed | tty-busy | tty-indeterminate)
#       exit 2  = REFUSE (fail-closed: unknown target | self | --self literal | no done-evidence | operator-adopted)
#       exit 5  = FAIL LOUD (acted, but effect-verify says the pane/process SURVIVED — never a false success)
#   cc-teardown --selftest        (RED-proves every branch with mock panes/pids + temp git; no real session)
#
# THE VERDICT TOKEN (2026-07-31). Every decision branch prints ONE machine-parseable line to stderr —
#   cc-teardown: verdict=<DECISION> reason_kind=<kind> exit=<n> pane=<uuid|-> pid=<pid|->
# emitted by record(), so a branch cannot forget it (record() is already mandatory on every branch —
# the no-silent-teardown rule). Callers parse THIS, never the prose: an exit code alone cannot tell
# "a safety gate declined" from "the actuator could not see the target", and prose drifts. A run that
# exits WITHOUT a verdict line is itself a distinguishable state — a usage/precondition error (die()),
# never a decision. Why it was needed: a false `exit 0` is indistinguishable from a real reap to an
# automated caller, and lead-crash-watchdog's orphan-close leg became exactly that caller.
#
# THE SIX STEPS (brief-verbatim):
#   1. RESOLVE via cc-sessions --all --json. Refuse --self + unknown ids (fail-closed exit 2).
#   2. SAFETY GATE — delegate work-safe + positive-done to cc-teardown-safety-gate.sh (the standalone
#      decision module); ADD the runtime-only (c) tty-exclusivity guard here (no foreign live process on
#      the pane tty beyond the target claude tree). ALL hold else DEFER+record (exit 10) / REFUSE (exit 2).
#   3. ACT both legs: kill -TERM <pid> → confirm dead (escalate KILL) → it2 session close -f -s <paneUUID>.
#   4. EFFECT-VERIFY both legs, RE-OBSERVED: process gone AND pane absent from a FRESH it2 list. Success
#      ONLY if both verified; a surviving pane → FAIL LOUD (exit 5), never a false success.
#   5. RECORD every branch (teardown | defer | refuse | fail | already-gone) to ~/.claude/cc-teardown/.
#   6. IDEMPOTENT: already-gone pane + dead pid ⇒ success.
#
# 🚨 C10: cc-teardown is invoked BY A LIVE DESK SESSION (delegated work) OR by bin/cc-reaper — the one
# sanctioned PRE-GATED autonomous caller (it reaps ONLY cause∈{handed-off-lead,finished-teammate} that is
# work-landed + idle≥settle, checkpoint-first, and cc-teardown STILL re-runs its own gate = double-gate).
# It is NEVER wired RAW into any hook / settings.json / launchd (that would fire it with no gate in front =
# C10). cc-reaper's OWN launchd standing loop is itself a C10 operator step (docs/AUTONOMOUS-REAPER-
# ACTIVATION.md). The /tmp/cc-teardown-activate.sh runbook is the operator's OPTIONAL layer — never self-activated.
#
# Env (overridable for tests): CC_TEARDOWN_SESSIONS_BIN, IT2_BIN, CC_TEARDOWN_GATE_BIN, CC_TEARDOWN_PS_BIN,
#   CC_TEARDOWN_RECORDS_DIR, CC_TEARDOWN_SELF_UUID, CC_TEARDOWN_TERM_GRACE_S, CC_TEARDOWN_DIR
#   (the crash-watchdog MARKER dir — the READER's own env var, steered in lockstep for tests; distinct
#   from CC_TEARDOWN_RECORDS_DIR, which is this script's decision-record sink).
set -uo pipefail

# Bound every fork that reaches the iTerm2 API (machine-wide wedge, 2026-07-26: a bare
# `it2 session list --json` returned rc 124 with zero output while blocked forks piled up across
# ~110 sessions). The ~/.claude/bin/it2 shim self-bounds at 30s, but 30s of dead wait per call is
# still a stall this caller should not absorb — and teardown re-observes both legs, and
# an unreadable list is already INDETERMINATE (rc 2) rather than a "pane gone" verdict.
# timeout(1) is resolved by ABSOLUTE PATH as well as PATH: hooks and launchd jobs run with a
# minimal PATH excluding Homebrew, exactly where coreutils installs it, so a PATH-only lookup would
# leave the AUTOMATED callers unbounded while interactive shells stayed safe. No timeout(1) ⇒ run
# unbounded rather than break the call. Seams: CCT_IT2_TIMEOUT_S · CCT_IT2_TIMEOUT_BIN
# (set-but-EMPTY disables verbatim; `${VAR:-}` cannot tell unset from set-empty).
CCT_TIMEOUT_S="${CCT_IT2_TIMEOUT_S:-10}"
if [ -n "${CCT_IT2_TIMEOUT_BIN+set}" ]; then
  CCT_TIMEOUT_BIN="${CCT_IT2_TIMEOUT_BIN}"
else
  CCT_TIMEOUT_BIN=""
  for _c in "$(command -v timeout 2>/dev/null || true)" "$(command -v gtimeout 2>/dev/null || true)" \
            /opt/homebrew/bin/timeout /usr/local/bin/timeout \
            /opt/homebrew/bin/gtimeout /usr/local/bin/gtimeout; do
    [ -n "$_c" ] && [ -x "$_c" ] && { CCT_TIMEOUT_BIN="$_c"; break; }
  done
fi
cct_bounded() {
  if [ -z "$CCT_TIMEOUT_BIN" ] || [ ! -x "$CCT_TIMEOUT_BIN" ]; then "$@"; return $?; fi
  "$CCT_TIMEOUT_BIN" -k 3 "$CCT_TIMEOUT_S" "$@"
}


# Resolve $0 THROUGH symlinks (no readlink -f on macOS) so a `~/.claude/bin/cc-teardown` symlink still finds
# its cc-teardown-safety-gate.sh + cc-sessions siblings in the repo bin/ — deploy only this one file.
_src="${BASH_SOURCE[0]:-$0}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
HERE="$(cd -P "$(dirname "$_src")" && pwd)"
CC_SESSIONS="${CC_TEARDOWN_SESSIONS_BIN:-$HERE/cc-sessions}"
IT2="${IT2_BIN:-$HOME/.claude/bin/it2}"
GATE="${CC_TEARDOWN_GATE_BIN:-$HERE/cc-teardown-safety-gate.sh}"
PS_BIN="${CC_TEARDOWN_PS_BIN:-ps}"
RECORDS_DIR="${CC_TEARDOWN_RECORDS_DIR:-$HOME/.claude/cc-teardown}"
TERM_GRACE_S="${CC_TEARDOWN_TERM_GRACE_S:-5}"
_sid="${CC_TEARDOWN_SELF_UUID:-${ITERM_SESSION_ID:-}}"
SELF_UUID="${_sid##*:}"   # ITERM_SESSION_ID = "wNtMpK:<UUID>" → <UUID>; an injected bare UUID passes through

# ── operator-adoption belt config (2026-07-24; mirrors cc-classify 4.7 env family) ─────────────────
INTERACTIVE_HOLD_S="${CC_CLASSIFY_INTERACTIVE_HOLD_S:-21600}"   # a real operator prompt within this ⇒ ADOPTED pane
# ── DECISION-FRESHNESS LEASE (SESSION_REGISTRY_V2 §4.3, R1) ────────────────────────────────────────
# An autonomous reap decision is a SNAPSHOT. v1's reaper classified every session in one batch call
# and then acted on that frozen verdict up to 2,099s later (p99; max 55,659s measured over 1,872
# sweeps), so an operator who typed DURING the sweep was invisible to the decision that closed their
# pane — the 2026-07-24 live-conversation reaps. No amount of caller-side care fixes this: the whole
# failure class is "the caller's belief was correct when formed and wrong when used".
# So freshness is enforced HERE, at the actuator: a decision carries the epoch it was made, and one
# older than the lease is REFUSED. This converts staleness from a SAFETY failure into a LIVENESS
# failure — a slow sweep now reaps NOTHING instead of reaping wrongly, and the safe direction is the
# default. The lease is REQUIRED (not optional) for autonomous callers: an opt-in lease is not a
# lease. Autonomous = passes --done-evidence (every real reap does; cc-reaper:756 is the sole caller).
# Operator/manual closes are unaffected, and --force-adopted (operator-ONLY, no autonomous caller
# passes it) exempts. Kill switches: CC_REAP_LEASE=off · CC_REAP_DECISION_MAX_STALE_S=<n>.
DECIDED_AT=""
DECISION_MAX_STALE_S="${CC_REAP_DECISION_MAX_STALE_S:-60}"
DECISION_FUTURE_SKEW_S="${CC_REAP_DECISION_FUTURE_SKEW_S:-5}"   # a decision from the FUTURE is a bad clock/caller, not freshness
FIRE_PROMPT_SLACK_S="${CC_CLASSIFY_FIRE_PROMPT_SLACK_S:-300}"   # a prompt within spawn+this = the spawn brief, not adoption
PROJECT_ROOTS="${CC_CLASSIFY_PROJECT_ROOTS:-$HOME/.claude/projects $HOME/.claude-secondary/projects $HOME/.claude-tertiary/projects $HOME/.claude-quaternary/projects}"
INTERACTIVE_LIB="${CC_INTERACTIVE_LIB:-$HERE/../hooks/lib/cc-interactive.sh}"

command -v jq >/dev/null 2>&1 || { echo "cc-teardown: jq required" >&2; exit 2; }

# resolved-handle globals (populated by resolve / parse)
TARGET=""; paneUUID=""; pid=""; cwd=""; sname=""; done_ev=""; git_state=""
sess_id=""; started_ms=""          # 1c operator-adoption belt (2026-07-24): transcript + spawn source
EXPECT_PID=""; EXPECT_LSTART=""   # classify-time identity pin (a17 S-4); empty = no pin (back-compat)
ASSIGNEE_OF=""; ASSIGNEE_SID=""   # 1b-A unregistered-assignee adoption (2026-07-29); empty = off
ADOPT_OCCUPANTS=""                # pids proving an "absent" pane is still occupied (refusal evidence)

iso()  { date -u +%Y-%m-%dT%H:%M:%SZ; }
say()  { echo "cc-teardown: $*" >&2; }
die()  { say "$*"; exit 2; }
usage() {
  cat >&2 <<'U'
cc-teardown <pane-uuid|name> --done-evidence <text> [--force-adopted]
  0 torn-down+verified · 10 DEFER · 2 REFUSE · 5 FAIL(pane survived)
  every decision also prints: verdict=<D> reason_kind=<k> exit=<n> target=… pane=… pid=…
                             (parse THAT, not the prose; no verdict line = a usage error)
  --force-adopted   operator CLI ONLY — skip the operator-adoption belt (no autonomous caller passes it)
  --assignee-of <lead-sid>   target is an Agent-Team assignee of that (dead) lead: allow ADOPTION of a
                             pane that has no session-registry row, on positive it2+argv proof only.
                             The target MUST be the PANE UUID — an assignee has no registry row, so
                             there is no name to look up and an agent name is REFUSED
                             (reason_kind=target-not-a-pane-uuid), never reported as already-gone.
  --assignee-sid <own-sid>   the assignee's OWN session id — keeps the operator-adoption belt ARMED
cc-teardown --selftest
U
}

# R-c analog — NO silent teardown: every decision branch writes one outcome record.
#
# …and prints the VERDICT TOKEN (see header). Folded in HERE rather than added at ~15 exit sites for
# a durability reason this repo has been bitten by: a token a branch can forget is a token a caller
# cannot trust, and the branch that forgets it will be the rare one. record() is already mandatory on
# every decision branch, so binding the token to it makes coverage structural. The exit code is a
# PURE FUNCTION of the decision (the documented 0/10/2/5 contract), so the line can state the code
# the caller is about to see without record() being told it.
record() { # <decision> <reason_kind> <reason> <both_legs_verified 0|1> [exit_code]
  mkdir -p "$RECORDS_DIR" 2>/dev/null || true
  local ts vex; ts="$(date -u +%Y%m%dT%H%M%SZ)-$$-${RANDOM}"
  case "$1" in
    TEARDOWN|ALREADY-GONE) vex=0 ;;
    DEFER)                 vex=10 ;;
    FAILED)                vex=5 ;;
    *)                     vex=2 ;;   # REFUSE and anything unforeseen — fail-closed, never 0
  esac
  # The derivation holds wherever THIS file decides the exit. It does not at the one site where the
  # code comes from another program (the delegated safety gate), so that site passes it explicitly —
  # a token advertising an exit the caller will not get is the same defect class as a false success,
  # and here it would be introduced by a change to a DIFFERENT file's contract.
  case "${5:-}" in ''|*[!0-9]*) ;; *) vex="$5" ;; esac
  # `target` as well as `pane`: on every REFUSE that fires BEFORE resolution, paneUUID is still empty
  # — and a caller correlating verdicts to the panes it asked about needs the key it passed in.
  printf 'cc-teardown: verdict=%s reason_kind=%s exit=%s target=%s pane=%s pid=%s\n' \
    "$1" "$2" "$vex" "${TARGET:--}" "${paneUUID:--}" "${pid:--}" >&2
  jq -n \
    --arg decision "$1" --arg rk "$2" --arg reason "$3" --arg blv "${4:-0}" \
    --arg pane "$paneUUID" --arg pid "$pid" --arg cwd "$cwd" --arg name "$sname" \
    --arg target "$TARGET" --arg ev "$done_ev" --arg gs "$git_state" --arg at "$(iso)" \
    --arg vex "$vex" \
    '{kind:"cc-teardown", decision:$decision, reason_kind:$rk, reason:$reason,
      paneUUID:(if $pane=="" then null else $pane end),
      pid:(if $pid=="" then null else ($pid|tonumber? // null) end),
      name:(if $name=="" then null else $name end),
      cwd:(if $cwd=="" then null else $cwd end), target:$target,
      done_evidence:$ev, git_state:(if $gs=="" then null else $gs end),
      both_legs_verified:($blv=="1"), exit_code:($vex|tonumber), at:$at}' \
    > "$RECORDS_DIR/${ts}.json" 2>/dev/null || true
}

# ── teardown marker (MARKER CONTRACT v1; reader = hooks/lead-crash-watchdog.sh classify_death) ─────
# cc-teardown kills the TARGET's claude process and closes its pane — to that target's OWN crash
# watchdog the death is indistinguishable from a real CC crash, so every desk/reaper teardown logged a
# false CRASH (the same class that made handoff-fire self-closes read as crashes, incident 2026-07-23;
# handoff-fire got its marker then, the DELEGATED close never did). This writes the SAME contract-v1
# marker for the TARGET (its sid + its pane), so the reader classifies RECYCLE/deliberate-teardown.
# Dual-keyed: the reader checks <sid>.json directly and, via the session registry, <pane>.json — a
# torn-down session's registry row can be overwritten by a successor, so both keys are written and
# key_kind records each file's own key. Emission is byte-identical in shape to handoff-fire's writer
# (mode is the only discriminator: only cc-teardown ever writes mode=teardown). Self-contained (its
# own date, no iso() helper) so tests can source it VERBATIM and assert its literal emission.
# FULLY GUARDED — a marker write can NEVER block or fail a close. Writers never delete markers; the
# reader GCs them.
write_teardown_marker() { # $1=target pane-uuid  $2=target sid  $3=mode
  local _tm_pane="${1:-}" _tm_sid="${2:-}" _tm_mode="${3:-teardown}" _tm_dir _tm_ts
  _tm_dir="${CC_TEARDOWN_DIR:-$HOME/.claude/watchdog/teardown}"
  { [ -n "$_tm_sid" ] || [ -n "$_tm_pane" ]; } || return 0
  mkdir -p "$_tm_dir" 2>/dev/null || true
  _tm_ts="$(date -u +%FT%TZ)"
  if [ -n "$_tm_sid" ]; then
    printf '{"key_kind":"sid","pane":"%s","sid":"%s","mode":"%s","ts":"%s"}\n' \
      "$_tm_pane" "$_tm_sid" "$_tm_mode" "$_tm_ts" > "$_tm_dir/$_tm_sid.json" 2>/dev/null || true
  fi
  if [ -n "$_tm_pane" ]; then
    printf '{"key_kind":"pane","pane":"%s","sid":"%s","mode":"%s","ts":"%s"}\n' \
      "$_tm_pane" "$_tm_sid" "$_tm_mode" "$_tm_ts" > "$_tm_dir/$_tm_pane.json" 2>/dev/null || true
  fi
  return 0
}

pid_alive()  { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
pid_lstart() { "$PS_BIN" -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ *//;s/ *$//'; }

# is_pane_uuid <s> → rc 0 iff <s> is a canonical iTerm2 session id (8-4-4-4-12 hex).
# The ONE question that makes "no pane has this id" mean anything. Ask a pane enumerator for a key
# that is not a pane key and the miss is guaranteed BY CONSTRUCTION — see resolve_assignee's guard.
is_pane_uuid() {
  [[ "${1:-}" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]
}

# pane_occupants <uuid> → prints occupant pids; rc 0 OCCUPIED · 1 provably VACANT · 2 blind oracle.
#
# The SECOND, INDEPENDENT presence oracle for a pane — and deliberately not another it2 call. iTerm2
# exports ITERM_SESSION_ID="<wNtNpN>:<pane-uuid>" into the pane's shell, and every process started
# there inherits it, so the kernel's own process table carries a pane→process binding that shares no
# code, no daemon and no failure mode with `it2 session list`. A pane whose processes are all gone is
# gone; a pane still hosting live processes is NOT gone, whatever the enumerator says. This is what
# turns "the lookup failed" into "absence was READ".
#
# TOKEN-EXACT, never substring (memory: pgrep-f-matches-agent-briefs / detector-matching-its-own-
# skill-description). `ps -E` prints argv AND the environment in one column, so a bare grep for the
# uuid also matches (a) any process carrying that uuid as an ARGUMENT — including cc-teardown's own
# `<pane-uuid> --done-evidence ...` argv and the watchdog's evidence prose — and (b) the scan's own
# awk. Measured on this machine: substring matching returned the scanning awk as an occupant; the
# token-exact form drops it and keeps the genuine ones. So the match must be a whole whitespace-
# delimited token that IS an ITERM_SESSION_ID assignment whose value ENDS in ":<uuid>". Compared
# upper-cased: iTerm2 emits uppercase on both sides, and a lowercase target would otherwise miss
# every occupant and read as VACANT — a silent false "gone", the exact bug class this closes.
#
# TRI-STATE with a POSITIVE CONTROL. "Zero occupants" is only evidence when the scan could see
# occupancy AT ALL: if the whole process table yields no ITERM_SESSION_ID token, `ps -E` is not
# reporting environments (restricted context, foreign owner, mock) and the read is BLIND, not vacant.
# Without that control this oracle would answer "vacant" most confidently exactly when it is broken —
# and broken-oracle and empty-pane both measure zero (memory: structural-gates-are-blind-to-zero-ink).
pane_occupants() {
  local uuid out res tok pids
  uuid="$(printf '%s' "${1:-}" | tr '[:lower:]' '[:upper:]')"
  [ -n "$uuid" ] || return 2
  out="$(cct_bounded "$PS_BIN" -E -Ao pid=,command= 2>/dev/null)" || return 2
  [ -n "$out" ] || return 2
  res="$(printf '%s\n' "$out" | awk -v u=":$uuid" '
    { for (i = 2; i <= NF; i++)
        if (index($i, "ITERM_SESSION_ID=") == 1) {
          tok++
          if (substr(toupper($i), length($i) - length(u) + 1) == u) pids[$1] = 1
        } }
    END { printf "tok=%d\n", tok + 0; for (p in pids) print p }' 2>/dev/null)" || return 2
  tok="$(printf '%s\n' "$res" | sed -n '1s/^tok=//p')"
  case "${tok:-}" in ''|*[!0-9]*) return 2 ;; esac
  [ "$tok" -eq 0 ] && return 2                       # no env visible anywhere ⇒ blind, never "vacant"
  pids="$(printf '%s\n' "$res" | sed 1d | tr '\n' ' ' | sed 's/  */ /g;s/^ //;s/ $//')"
  [ -n "$pids" ] && { printf '%s' "$pids"; return 0; }
  return 1
}

# pane_present <uuid> → rc 0 present · 1 absent · 2 list-unreadable (fail-safe: never assume absent).
# The real it2 CLI walks ONLY app.windows and returns a VALID but EMPTY array `[]` at exit 0
# when that model is blind — detached desk / different GUI login / restoration-pending / buried
# sessions (the "it2 ls returned 0" incident, L3-L4-AUTONOMY-ROADMAP.md:20-22). A machine running
# cc-teardown always holds >=1 pane (the invoking one), so ZERO enumerated == blind enumerator,
# NOT "no panes exist" — return 2 (indeterminate), never 1 (absent). Otherwise a spurious 0-list
# would read as a false ALREADY-GONE (line ~180) or a false TEARDOWN-verified success (line ~239).
pane_present() {
  local uuid="$1" lst n ids
  lst="$(cct_bounded "$IT2" session list --json 2>/dev/null)" || return 2
  [ -n "$lst" ] || return 2
  n="$(printf '%s' "$lst" | jq -r 'if type=="array" then length else -1 end' 2>/dev/null)" || return 2
  { [ -z "$n" ] || [ "$n" = -1 ]; } && return 2   # non-array / unparseable ⇒ unreadable
  [ "$n" -eq 0 ] && return 2                        # zero enumerated ⇒ blind enumerator ⇒ indeterminate
  ids="$(printf '%s' "$lst" | jq -r '.[].id // empty' 2>/dev/null)" || return 2
  printf '%s\n' "$ids" | grep -qxF "$uuid" && return 0
  return 1
}

# resolve_assignee <pane-uuid> <lead-sid> → rc 0 ADOPTED (globals set) · 1 pane provably ABSENT
#                                          · 2 REFUSE (indeterminate or identity unproven)
#                                          · 3 REFUSE (target is not a pane uuid — unanswerable)
#                                          · 4 REFUSE (absence CONTRADICTED — the pane is occupied)
#                                          · 5 REFUSE (absence UNCORROBORATED — occupancy read blind)
#
# ── THE FALSE-SUCCESS FIX (2026-07-31, backlog 99f87bf7a6f7) ───────────────────────────────────────
# As first written this function inferred rc 1 ("provably absent") from a single failed lookup:
# `.[] | select(.id == $target)` matching nothing in a readable it2 list. Two ways that inference was
# wrong, both reproduced hermetically against the pre-fix tree:
#
#   (i)  THE TARGET WAS NEVER A PANE KEY. $1 was used as a pane uuid with no check. Given an agent
#        NAME — `cc-teardown gu2-seams --assignee-of a8e72ae5` — no pane can ever have `.id ==
#        "gu2-seams"`, so the miss is guaranteed by construction and says NOTHING about the pane. It
#        returned 1 ⇒ ALREADY-GONE ⇒ **exit 0** while pid 44938 was alive at 6h48m and the pane sat
#        in the registry with that exact pid. The tool's own contract has 5 = FAIL(pane survived) for
#        precisely that state; it was booked as SUCCESS instead. The tell that it was a coin flip and
#        not a verdict: the IDENTICAL command for the sibling gu2-archaeology returned REFUSE
#        assignee-unproven (exit 2) — same state, same flags, opposite answers, differing only in
#        whether the it2 call happened to be readable at that instant.
#   (ii) THE ENUMERATOR CAN BE PARTIALLY BLIND. `it2 session list` walks only app.windows. The
#        all-blind case (0 panes) was already handled; a list that enumerates SOME windows and omits
#        the target's is readable, non-empty, and still wrong — and that one IS reachable by the
#        automated caller, which always passes a real uuid.
#
# So absence is no longer INFERRED from a failed lookup; it is READ, positively, on two independent
# oracles that must AGREE — the it2 enumeration and the kernel process table (pane_occupants). Either
# one unable to answer ⇒ REFUSE. This matters more since 2026-07-31: LCW_ORPHAN_CLOSE=1 gave
# --assignee-of its first autonomous caller, and to that caller a false 0 is indistinguishable from a
# real reap — the orphan survives forever while the log reads "TORN DOWN + effect-verified".
#
# The process-table leg is keyed on ITERM_SESSION_ID rather than on `--agent-id …@session-<lead>`
# argv, which is the other obvious reading of "no argv match". Argv keys on the LEAD, and a lead has
# many assignees: with siblings still alive it would refuse a genuinely-gone pane forever, and with
# the target the only survivor it would prove no more than the env leg does. ITERM_SESSION_ID keys on
# the PANE — the exact thing whose absence is in question.
#
# THE MISSING CATEGORY (backlog 95281da714f0 leg b, 2026-07-29). resolve() above knows exactly one
# oracle — the session registry — and an Agent-Team assignee is NEVER in it: measured 134 of 134
# member panes across all 50 team dirs on this machine had NO registry row. An assignee is not a
# launched session; it is a `claude.exe --agent-id <name>@session-<lead>` child, so nothing ever
# registers it. Consequence before this function existed: the lead-crash watchdog's close leg
# enumerated the right panes, harvested them, called cc-teardown — and got REFUSE unknown-target
# every single time, which it counted as a *trusted* policy refusal. 100% abstain BY CONSTRUCTION:
# built, tested, landed, and incapable of ever closing one pane (memory:
# feature-durability-mechanism-not-memory). Its suite passed only because the spy returned 0 —
# a fixture whose shape did not match the real producer (memory: fixture-shape-parity).
#
# STRICTLY OPT-IN: consulted ONLY when resolve() has already MISSED and the caller passed
# --assignee-of. No existing caller changes behaviour, and no resolvable target ever reaches here.
#
# POSITIVE EVIDENCE ONLY, three independent legs — any one unproven ⇒ REFUSE, never a guess:
#   1. PANE LIVENESS from a FRESH it2 list, TRI-STATE via the same rule pane_present encodes: a
#      zero-length/unparseable list is a BLIND enumerator, never "absent". This is not theoretical
#      — an ad-hoc probe written while diagnosing this very bug called all six live panes ABSENT
#      because its it2 call timed out under load and it read empty as gone. Absence of evidence is
#      not evidence of absence; that read is the one this repo has been bitten by most.
#   2. PANE→TTY from that same list object (one call, not two: it2 is slow under fleet load).
#   3. TTY→PID with the identity PROVEN from argv, not from text. Requirements: comm is exactly
#      `claude.exe` (the assignee binary) AND a real `--agent-id` argv token whose value matches
#      `<name>@session-<lead-sid>`. Both guards are load-bearing: a sibling session on ttys029 had
#      the literal string "--agent-id <name>@session-8891c11f" inside a prose TASK argument, and a
#      substring match would have adopted — then killed — an unrelated live session
#      (memory: detector-matching-its-own-skill-description — text is never evidence).
resolve_assignee() {
  local uuid="$1" lead="$2" lst n obj _tty base rpid rcomm rargs agid occ orc
  [ -n "$uuid" ] && [ -n "$lead" ] || return 2

  # ── leg 0: is the target even a pane key? ──
  # Cheapest and most load-bearing guard in the function. Every leg below asks the world about a PANE
  # UUID; asked about anything else they can only return "not found", which is a fact about the
  # question, never about the pane. Refuse rather than answer an unanswerable question — an
  # unresolvable target is a caller error to be REPORTED, never an idempotent success.
  is_pane_uuid "$uuid" || return 3

  # ── leg 1: pane liveness, tri-state (see pane_present for why zero ⇒ indeterminate) ──
  # A LONGER bound than the 10s default, for a measured reason: `it2 session list --json` took
  # 10.59s at 33 panes on a loaded machine, so the default clipped it and this resolver refused
  # every real pane with "indeterminate". A lead crashing with 8 live assignees IS the high-pane,
  # high-load moment — a bound that expires exactly when the feature is needed is not a bound, it is
  # an off switch. 30s matches the it2 shim's own self-bound. Seam: CCT_ADOPT_TIMEOUT_S.
  local _cct_saved="$CCT_TIMEOUT_S"
  CCT_TIMEOUT_S="${CCT_ADOPT_TIMEOUT_S:-30}"
  lst="$(cct_bounded "$IT2" session list --json 2>/dev/null)" || lst=""
  CCT_TIMEOUT_S="$_cct_saved"
  [ -n "$lst" ] || return 2
  n="$(printf '%s' "$lst" | jq -r 'if type=="array" then length else -1 end' 2>/dev/null)" || return 2
  { [ -z "$n" ] || [ "$n" = -1 ]; } && return 2
  [ "$n" -eq 0 ] && return 2
  obj="$(printf '%s' "$lst" | jq -c --arg t "$uuid" '.[] | select(.id==$t)' 2>/dev/null | head -1)"
  if [ -z "$obj" ]; then
    # ── leg 1b: CORROBORATE the absence on the independent oracle before claiming it ──
    # One readable enumeration that omits the pane is a lookup MISS, and a miss is only an absence if
    # a second, unrelated oracle agrees. pane_occupants asks the kernel instead of iTerm2; it cannot
    # share the app.windows blindness that produced the miss. Only unanimous absence ⇒ rc 1.
    occ="$(pane_occupants "$uuid")"; orc=$?
    case "$orc" in
      1) return 1 ;;   # both oracles say gone — a READ absence, the only ALREADY-GONE we now allow
      0) ADOPT_OCCUPANTS="$occ"   # named in the refusal so an operator sees WHAT is still running.
         # Deliberately NOT assigned to `pid`: these processes were never identity-proven as the
         # target, and `pid` is what the ACT legs kill. Evidence for a refusal, never a kill list.
         return 4 ;;   # it2 says gone, the process table says occupied — refuse, never "success"
      *) return 5 ;;   # occupancy unreadable ⇒ absence unproven ⇒ refuse (fail-closed)
    esac
  fi

  # ── leg 2: pane → tty ──
  _tty="$(printf '%s' "$obj" | jq -r '.tty // empty' 2>/dev/null)"
  [ -n "$_tty" ] || return 2
  base="${_tty#/dev/}"

  # ── leg 3: tty → pid, identity proven from argv ──
  # argv[0], NOT `ps -o comm=`: macOS truncates comm to 16 chars, so the assignee's
  # `/Users/.../claude-code/bin/claude.exe` arrives as `/Users/chrisren/` and a basename test on it
  # can never match anything. Measured — this silently refused every real pane. argv[0] from `args=`
  # is never truncated, and it is the stronger check anyway: it is the binary actually exec'd.
  while read -r rpid rargs; do
    [ -n "$rpid" ] || continue
    case "$rpid" in *[!0-9]*) continue ;; esac
    rcomm="${rargs%% *}"                              # argv[0]
    [ "${rcomm##*/}" = "claude.exe" ] || continue      # the assignee binary, not a wrapper/prose host
    case " $rargs " in *" --agent-id "*) ;; *) continue ;; esac
    agid="${rargs#*--agent-id }"; agid="${agid%% *}"   # the token AFTER the real flag
    case "$agid" in
      *"@session-$lead") ;;                            # proves assignee OF THIS dead lead
      *) continue ;;
    esac
    case "$agid" in *[!A-Za-z0-9_.@-]*) continue ;; esac   # a shaped id, never a prose fragment
    paneUUID="$uuid"; pid="$rpid"
    sname="$agid"
    # cwd feeds the work-safety gate (dirty / committed-not-pushed). BOUNDED via cct_bounded, NOT a
    # bare `timeout`: hooks and launchd run with a minimal PATH excluding Homebrew (where coreutils
    # puts timeout), and this leg's only autonomous caller IS a hook-spawned watchdog — a PATH-only
    # lookup would leave exactly that caller broken, returning an empty cwd forever and re-inerting
    # the leg through the gate's fail-closed die. cct_bounded resolves by absolute path and runs
    # UNBOUNDED rather than breaking the call.
    # An unresolved cwd is still SAFE: the gate `die`s on an empty --cwd, so we REFUSE rather than
    # tear down a worktree whose dirty/unpushed state was never checked.
    cwd="$(cct_bounded lsof -a -d cwd -w -p "$rpid" -F n 2>/dev/null | sed -n 's/^n//p' | head -1)"
    sess_id="$ASSIGNEE_SID"
    started_ms=""
    return 0
  done < <("$PS_BIN" -t "$base" -o pid=,args= 2>/dev/null)
  return 2                                            # pane is live but hosts no provable assignee
}

# tty_foreign <pid> → count of FOREIGN live processes sharing the pane tty (not in the target tree, not an
# interactive shell). -1 = tty undeterminable (fail-closed). Descendants of <pid> and login shells are OK.
tty_foreign() {
  local p="$1" tty tbl marked changed q pp c base fp=0
  tty="$("$PS_BIN" -o tty= -p "$p" 2>/dev/null | tr -d ' ')"
  { [ -z "$tty" ] || [ "$tty" = "??" ]; } && { echo -1; return; }
  tbl="$("$PS_BIN" -t "$tty" -o pid=,ppid=,comm= 2>/dev/null)"
  marked=" $p "
  changed=1
  while [ "$changed" = 1 ]; do          # transitively mark the target's descendant tree within this tty
    changed=0
    while read -r q pp c; do
      [ -n "${q:-}" ] || continue
      case "$marked" in *" $q "*) continue ;; esac
      case "$marked" in *" $pp "*) marked="$marked$q "; changed=1 ;; esac
    done <<EOF
$tbl
EOF
  done
  while read -r q pp c; do               # anything left that is not an interactive shell is foreign
    [ -n "${q:-}" ] || continue
    case "$marked" in *" $q "*) continue ;; esac
    base="${c##*/}"
    case "$base" in -zsh|zsh|-bash|bash|-sh|sh|login|tmux|screen|gitstatusd*|caffeinate) continue ;; esac
    fp=$((fp+1))
  done <<EOF
$tbl
EOF
  echo "$fp"
}

resolve() { # <target> → sets paneUUID/pid/cwd/sname; rc1 = unknown. Matches paneUUID first, then name.
  local t="$1" obj
  obj="$("$CC_SESSIONS" --all --json 2>/dev/null | jq -c --arg t "$t" \
     '(map(select(.paneUUID==$t)) + map(select(.name==$t))) | .[0] // empty' 2>/dev/null)"
  [ -n "$obj" ] || return 1
  paneUUID="$(printf '%s' "$obj" | jq -r '.paneUUID // empty')"
  pid="$(printf '%s'      "$obj" | jq -r '.pid // empty')"
  cwd="$(printf '%s'      "$obj" | jq -r '.cwd // empty')"
  sname="$(printf '%s'    "$obj" | jq -r '.name // empty')"
  sess_id="$(printf '%s'   "$obj" | jq -r '(.session_id // .sessionId) // empty')"
  started_ms="$(printf '%s' "$obj" | jq -r '.startedAt // empty')"
  [ -n "$paneUUID" ] || return 1
  return 0
}

find_transcript() { # <sid> → its .jsonl (first match across the account project roots; mirror cc-classify)
  local sid="${1:-}" r f
  [ -n "$sid" ] || return 1
  for r in $PROJECT_ROOTS; do
    [ -d "$r" ] || continue
    f="$(find "$r" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null | head -1)"
    [ -n "$f" ] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

beat_or_refuse() { # <sid> <who_gap> → returns 0 to PROCEED; exits 2 (REFUSE) when presence is unprovable
  # The SECOND, INDEPENDENT presence oracle, consulted whenever the transcript WHO-oracle could not
  # answer. Two distinct gaps reach here and both mean the same thing — "we cannot prove this pane is
  # not a live operator conversation":
  #   (a) the who-LIB is absent (R3, SESSION_REGISTRY_V2 §4.3.5), and
  #   (b) the lib is present but its answer is "unreadable" or its transcript did not resolve
  #       (the 2026-07-29 C-SC-1 close — before it, (b) fell straight through the belt to the CLOSE,
  #       so a corrupt/unresolvable transcript licensed exactly the auto-close this belt exists to
  #       prevent; the ce_ backstop legs took the same split in 51521697).
  # Refusing outright on either gap would make the belt a single point of INERTNESS (a lib that fails
  # to deploy, or one bad transcript, would refuse every teardown forever), so the BEAT is asked first
  # — it cannot share a bug with the transcript scanner. Only when BOTH oracles are unavailable do we
  # refuse, and that refusal is loud + recorded (never a silent proceed).
  local _sid="${1:-}" _gap="${2:-the who-oracle could not answer}" _bage
  if type -t cb_operator_age >/dev/null 2>&1 && cb_system_live 2>/dev/null; then
    _bage="$(cb_operator_age "$_sid" 2>/dev/null || true)"
    case "${_bage:-}" in
      ''|*[!0-9]*)
        record REFUSE presence-unprovable "$_gap AND this session has no presence beat, inside a LIVE beat world — cannot prove the pane is not a live operator conversation; refusing (v1 proceeded here, which is how live conversations were closed)" 0
        say "REFUSE — cannot prove operator absence: $_gap and no beat for this session (exit 2)."
        exit 2 ;;
      *)
        if [ "$_bage" -lt "$INTERACTIVE_HOLD_S" ] 2>/dev/null; then
          record REFUSE operator-adopted "$_gap; the presence BEAT shows a real operator prompt ${_bage}s ago (< hold ${INTERACTIVE_HOLD_S}s) — refusing to auto-close a live operator conversation" 0
          say "REFUSE — operator-adopted per presence beat: prompt ${_bage}s ago (exit 2)."
          exit 2
        fi
        say "NOTE — $_gap; presence proven ABSENT by beat (${_bage}s > hold) — proceeding on the independent oracle"
        return 0 ;;
    esac
  fi
  record REFUSE presence-unprovable "$_gap and the beat system is not live — NO presence oracle is available, so the pane cannot be shown to be free of a live operator conversation; refusing (fail-closed, R3)" 0
  say "REFUSE — $_gap and no live beat system: no presence oracle available, refusing to close (exit 2)."
  exit 2
}

main() {
  local args=() FORCE_ADOPTED=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --done-evidence|--done) [ $# -ge 2 ] && { done_ev="$2"; shift 2; } || shift ;;
      --expect-pid)    [ $# -ge 2 ] && { EXPECT_PID="$2"; shift 2; } || shift ;;
      --expect-lstart) [ $# -ge 2 ] && { EXPECT_LSTART="$2"; shift 2; } || shift ;;
      --decided-at)    [ $# -ge 2 ] && { DECIDED_AT="$2"; shift 2; } || shift ;;
      --force-adopted) FORCE_ADOPTED=1; shift ;;
      --assignee-of)   [ $# -ge 2 ] && { ASSIGNEE_OF="$2"; shift 2; } || shift ;;
      --assignee-sid)  [ $# -ge 2 ] && { ASSIGNEE_SID="$2"; shift 2; } || shift ;;
      --self) TARGET="--self"
              record REFUSE self-literal "'--self' is never a valid teardown target — refusing self-teardown" 0
              say "REFUSE — '--self' is not a valid target (exit 2)"; exit 2 ;;
      -h|--help) usage; exit 0 ;;
      --*) die "unknown option '$1'" ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [ "${#args[@]}" -ge 1 ] || die "usage: cc-teardown <pane-uuid|name> --done-evidence <text>"
  TARGET="${args[0]}"

  # ── 1. RESOLVE (fail-closed on unknown) ────────────────────────────────────────────────────────────
  if ! resolve "$TARGET"; then
    paneUUID=""; pid=""; cwd=""; sname=""
    # 1b-A ASSIGNEE ADOPTION — the registry is not the only way a session can exist. An Agent-Team
    # assignee never has a row (134/134 measured), so for --assignee-of callers a registry miss is
    # NOT "no such session"; it is the wrong oracle. resolve_assignee re-proves the target from
    # positive it2 + argv evidence, and every downstream gate then runs UNCHANGED and fully armed.
    if [ -n "$ASSIGNEE_OF" ]; then
      local _ar=0
      resolve_assignee "$TARGET" "$ASSIGNEE_OF" || _ar=$?
      case "$_ar" in
        0) say "NOTE — adopted UNREGISTERED assignee pane $paneUUID (pid $pid, agent $sname of dead lead $ASSIGNEE_OF): no registry row, identity proven from it2 pane liveness + argv" ;;
        1) record ALREADY-GONE idempotent "assignee pane '$TARGET' is absent from a READABLE it2 enumeration AND hosts no live process carrying its ITERM_SESSION_ID — absence READ on two independent oracles, nothing to close" 1
           say "OK — assignee pane already gone (absence corroborated on it2 + process table; idempotent success, exit 0)"; exit 0 ;;
        3) # The target was never a pane key, so no enumerator could have answered — the miss was
           # guaranteed by construction. This is the refusal that replaces the false exit 0.
           record REFUSE target-not-a-pane-uuid "target '$TARGET' is not a pane UUID, and --assignee-of resolves ONLY by pane UUID (an assignee has no registry row to look a name up in). A pane enumerator asked for a non-pane key can only answer 'not found', which is a fact about the QUESTION and never about the pane — so this can never be reported as already-gone. Pass the pane UUID: cc-teardown <pane-uuid> --done-evidence ... --assignee-of $ASSIGNEE_OF" 0
           say "REFUSE reason_kind=target-not-a-pane-uuid — '$TARGET' is not a pane UUID; --assignee-of needs the pane UUID, not an agent name (exit 2)"; exit 2 ;;
        4) # Two oracles DISAGREE and the safe one wins: it2 omitted the pane, but live processes
           # still carry its ITERM_SESSION_ID. Never exit 0 on a contradiction.
           record REFUSE absence-contradicted "the it2 enumeration omitted pane '$TARGET', but the process table shows live process(es) [$ADOPT_OCCUPANTS] whose ITERM_SESSION_ID names that pane — the pane is NOT gone and the enumeration was partially blind; refusing to report a reap that did not happen" 0
           say "REFUSE reason_kind=absence-contradicted — it2 omits pane '$TARGET' but pid(s) [$ADOPT_OCCUPANTS] are still live in it; NOT gone (exit 2)"; exit 2 ;;
        5) record REFUSE absence-uncorroborated "the it2 enumeration omitted pane '$TARGET', but the independent occupancy oracle could not read process environments at all (no ITERM_SESSION_ID visible anywhere — restricted context or unavailable ps -E), so the absence rests on a single oracle that has been wrong before; refusing rather than claiming an unverified reap" 0
           say "REFUSE reason_kind=absence-uncorroborated — pane '$TARGET' looks absent but occupancy could not be read; absence unproven (exit 2)"; exit 2 ;;
        *) # INDETERMINATE or identity unproven. Fail-closed, and named distinctly from
           # unknown-target so a caller can tell "the actuator could not SEE the target" (a wiring
           # or load problem, retryable) from "a safety gate declined" (a verdict to respect).
           record REFUSE assignee-unproven "target '$TARGET' has no registry row and could not be adopted: either the it2 enumeration was unreadable/indeterminate, or the pane hosts no claude.exe with a real --agent-id token matching @session-$ASSIGNEE_OF; refusing to act without positive identity" 0
           say "REFUSE reason_kind=assignee-unproven — cannot prove pane '$TARGET' hosts an assignee of lead $ASSIGNEE_OF (exit 2)"; exit 2 ;;
      esac
    else
      record REFUSE unknown-target "target '$TARGET' resolves to no live-or-retained session (cc-sessions --all)" 0
      say "REFUSE reason_kind=unknown-target — unknown target '$TARGET' (exit 2)"; exit 2
    fi
  fi

  # SELF-GUARD — never tear down the invoking session's own pane.
  if [ -n "$SELF_UUID" ] && [ "$paneUUID" = "$SELF_UUID" ]; then
    record REFUSE self "target is the INVOKING session's own pane ($SELF_UUID) — refusing self-teardown" 0
    say "REFUSE — refusing to tear down the invoking session itself (exit 2)"; exit 2
  fi

  # ── 1b. IDENTITY PIN (a17 S-4) — refuse if the pane RECYCLED between classify and act ──────────────
  # cc-reaper classifies the fleet ONCE, then acts per-candidate later; in that window a pane can
  # /handoff --recycle in place — session-register OVERWRITES the per-pane row with the successor's
  # pid/sid. resolve() above re-read the pane FRESH and took whatever pid the row now holds, so without
  # this pin cc-teardown would kill the freshly-booted successor (both legs would even "verify"). When
  # cc-reaper passed the classify-time {pid,lstart}, REFUSE loudly on any mismatch — a dead expected pid
  # (empty now-lstart) is NOT a recycle (that is the idempotent path below), only a DIFFERENT live one is.
  if [ -n "$EXPECT_PID" ] || [ -n "$EXPECT_LSTART" ]; then
    local now_lstart; now_lstart="$(pid_lstart "$pid")"
    if { [ -n "$EXPECT_PID" ] && [ "$pid" != "$EXPECT_PID" ]; } || \
       { [ -n "$EXPECT_LSTART" ] && [ -n "$now_lstart" ] && [ "$now_lstart" != "$EXPECT_LSTART" ]; }; then
      record REFUSE identity-pin "pane recycled between classify and act — expected pid=$EXPECT_PID lstart='$EXPECT_LSTART', pane now holds pid=$pid lstart='$now_lstart'; refusing to kill the successor" 0
      say "REFUSE - identity-pin mismatch (pane recycled: pid ${EXPECT_PID}->${pid}) - never killing a stranger (exit 2)"; exit 2
    fi
  fi

  # ── 6. IDEMPOTENT short-circuit: dead pid AND already-absent pane ⇒ success (nothing to do) ─────────
  # DELIBERATELY NOT corroborated by pane_occupants, unlike the assignee absence path above — the two
  # are asymmetric and applying that check here would be a regression, not a hardening:
  #   · there, the TARGET IS A PANE (adoption resolves by pane uuid and nothing else), so "the pane
  #     still has live processes" means the thing we were asked to close is still there;
  #   · here, the target is a REGISTERED SESSION whose pid this branch has already proven dead by a
  #     direct kill -0. A pane can legitimately outlive it holding nothing but a login shell — and
  #     that shell inherits ITERM_SESSION_ID, so pane_occupants would report OCCUPIED and refuse
  #     every crashed-session cleanup forever.
  # The residue this branch can mis-read is an empty pane, never a live agent: materially not the
  # false-success class (backlog 99f87bf7a6f7), whose whole harm was a RUNNING assignee booked as reaped.
  if ! pid_alive "$pid"; then
    pane_present "$paneUUID"; local pp0=$?
    if [ "$pp0" = 1 ]; then
      record ALREADY-GONE idempotent "pid $pid already dead AND pane $paneUUID already absent — nothing to do" 1
      say "OK — already gone (pid dead + pane absent); idempotent success (exit 0)"; exit 0
    fi
  fi

  # ── 1c. OPERATOR-ADOPTION belt (2026-07-24; mirrors cc-classify 4.7 / hooks/lib/cc-interactive.sh) ──
  # A pane a human OPERATOR has typed real prompts into is ADOPTED — never auto-close it, even when it
  # looks work-safe + done: between prompts an interactive conversation is idle + clean + landed, the
  # exact "done" shape (cc-reaper closed two live operator conversations this way, 2026-07-24). The one
  # signal "done" cannot fake is WHO drove the last turn — ci_last_interactive_epoch returns the epoch
  # of the last REAL operator-typed prompt; newer than spawn+SLACK (the spawn brief is a user prompt
  # too) AND within the hold window ⇒ adopted → REFUSE (exit 2), joining the REFUSE family. Placed
  # before the work-safety gate so an adopted pane REFUSEs (never) rather than DEFERs (later). The
  # WHO-primitive is hooks/lib/cc-interactive.sh (lands separately) — absent ⇒ one WARN + skip
  # (graceful degradation). --force-adopted (operator command-line ONLY; NO autonomous caller — never
  # cc-reaper — passes it) skips just this belt. Kill switch: CC_CLASSIFY_INTERACTIVE_HOLD_DISABLE=1.
  local hold_on=1
  [ "$FORCE_ADOPTED" = 1 ] && hold_on=0
  [ "${CC_CLASSIFY_INTERACTIVE_HOLD_DISABLE:-0}" = 1 ] && hold_on=0
  case "$INTERACTIVE_HOLD_S" in ''|*[!0-9]*|0) hold_on=0 ;; esac
  if [ "$hold_on" = 1 ]; then
    # shellcheck source=/dev/null
    if [ -f "$INTERACTIVE_LIB" ]; then . "$INTERACTIVE_LIB" 2>/dev/null || true; fi
    # shellcheck source=/dev/null
    for _b in "$HERE/../hooks/lib/cc-beat.sh" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/lib/cc-beat.sh" \
              "$HOME/.claude/hooks/lib/cc-beat.sh"; do
      [ -f "$_b" ] && { . "$_b" 2>/dev/null || true; break; }
    done
    if ! type -t ci_last_interactive_epoch >/dev/null 2>&1; then
      # ── R3 (SESSION_REGISTRY_V2 §4.3.5): the WHO-oracle is missing, so this process CANNOT prove
      # the pane is not a live operator conversation. v1 answered that by proceeding to close —
      # "cannot prove present" treated as "proven absent", the inverse of this repo's own
      # absence-is-loud law, and the single most dangerous line in the subsystem (its own test
      # pinned the fail-open as correct, using a fixture carrying a REAL operator prompt).
      # v2 refuses instead — via beat_or_refuse, the shared second-oracle path (see its header for why
      # refusing outright would make this belt a single point of inertness).
      beat_or_refuse "$sess_id" "the who-oracle ($INTERACTIVE_LIB) is absent"
    else
      local atj="" iep="" irc=0 now_s="" spawn_s="" iage=""
      atj="$(find_transcript "$sess_id" 2>/dev/null || true)"
      # DELIBERATELY NOT a refusal: an UNRESOLVABLE transcript (no <sid>.jsonl under PROJECT_ROOTS) is
      # the ordinary state of a synthetic/short-lived sid and of any session whose transcript was
      # renamed out from under it (a handoff leaves <sid>.jsonl.handed-off), so gating the close on it
      # would refuse a large, legitimate population whenever the beat world is also down — a
      # fleet-wide teardown outage, the fail-closed-as-amplifier trap. RED-proved: routing this case
      # through beat_or_refuse turned 7 of the 17 --selftest checks into REFUSE. The narrow, evidenced
      # gap is the one below — a transcript that EXISTS and cannot be read.
      if [ -n "$atj" ]; then
        iep="$(ci_last_interactive_epoch "$atj" 2>/dev/null)" || irc=$?
        if [ "$irc" = 2 ]; then
          # THREE-VALUED contract (hooks/lib/cc-interactive.sh): "unreadable" — corrupt / truncated /
          # binary / empty / no jq. NOT "nobody typed". Only the rc-1 world (a transcript that parsed
          # and holds no operator turn) is a FACT that may license a close.
          beat_or_refuse "$sess_id" "the who-oracle read the target's transcript as UNREADABLE (corrupt/truncated/empty, or no jq) — 'cannot read' is not 'nobody typed'"
        fi
        case "${iep:-}" in ''|*[!0-9]*) iep="" ;; esac
        if [ -n "$iep" ]; then
          now_s="${CC_CLASSIFY_NOW:-$(date +%s)}"
          case "${started_ms:-}" in ''|*[!0-9]*) spawn_s=0 ;; *) spawn_s=$(( started_ms / 1000 )) ;; esac
          iage=$(( now_s - iep )); [ "$iage" -lt 0 ] && iage=0
          if [ "$iage" -lt "$INTERACTIVE_HOLD_S" ] && [ "$iep" -gt "$(( spawn_s + FIRE_PROMPT_SLACK_S ))" ]; then
            record REFUSE operator-adopted "target pane is operator-adopted — a REAL operator prompt ${iage}s ago (< hold ${INTERACTIVE_HOLD_S}s, past spawn+${FIRE_PROMPT_SLACK_S}s); refusing to auto-close a live operator conversation (pass --force-adopted to override)" 0
            say "REFUSE — operator-adopted pane: real prompt ${iage}s ago; refusing auto-close (exit 2). Pass --force-adopted to override."
            exit 2
          fi
        fi
      fi
    fi
  fi

  # ── 1d. DECISION-FRESHNESS LEASE (SESSION_REGISTRY_V2 §4.3 / R1) ────────────────────────────────
  # Ordered AFTER the adoption belt deliberately. Both refuse, so ordering cannot change safety —
  # only which truth gets RECORDED. "This pane holds a live operator conversation" is the more
  # fundamental fact than "your decision is stale", and it is the one an operator reading the
  # decision record needs to see. The lease then bites exactly the reaps that would otherwise have
  # proceeded, which is the population it exists to bound.
  if [ "${CC_REAP_LEASE:-on}" != off ] && [ "$FORCE_ADOPTED" = 0 ] && [ -n "$done_ev" ]; then
    local lease_now lease_age
    lease_now="${CC_CLASSIFY_NOW:-$(date +%s)}"
    case "$DECIDED_AT" in
      ''|*[!0-9]*)
        # MISSING is a refusal, not a pass. An autonomous caller that cannot say WHEN it decided
        # cannot be trusted that the decision is still true — and a lease a caller may omit is
        # not a lease. Names the exact fix so a caller is never left guessing.
        record REFUSE lease-missing "autonomous teardown carried no --decided-at; the decision-freshness lease (${DECISION_MAX_STALE_S}s) cannot be verified, so the close is refused. Callers must pass --decided-at \$(date +%s) taken immediately before the call" 0
        say "REFUSE — no --decided-at on an autonomous teardown: decision freshness unverifiable (exit 2). Pass --decided-at \$(date +%s) immediately before calling."
        exit 2 ;;
    esac
    lease_age=$(( lease_now - DECIDED_AT ))
    if [ "$lease_age" -lt "$(( 0 - DECISION_FUTURE_SKEW_S ))" ] 2>/dev/null; then
      record REFUSE lease-future "decision timestamp is ${lease_age}s in the FUTURE (beyond ${DECISION_FUTURE_SKEW_S}s skew) — a bad clock or a forged decision, never freshness" 0
      say "REFUSE — --decided-at is in the future (exit 2)."
      exit 2
    fi
    if [ "$lease_age" -gt "$DECISION_MAX_STALE_S" ] 2>/dev/null; then
      record REFUSE stale-decision "decision was made ${lease_age}s ago, past the ${DECISION_MAX_STALE_S}s freshness lease — the evidence it rests on may no longer hold (an operator can adopt a pane inside that window); refusing to act on a stale verdict" 0
      say "REFUSE — stale decision: made ${lease_age}s ago > ${DECISION_MAX_STALE_S}s lease (exit 2). Re-take the decision and retry."
      exit 2
    fi
  fi

  # ── 2. SAFETY GATE — (a) work-safe + (b) positive-done via the standalone module ────────────────────
  local gate_out grc gdec grk greason
  gate_out="$("$GATE" decide --cwd "$cwd" --done-evidence "$done_ev" 2>/dev/null)"; grc=$?
  git_state="$(printf '%s' "$gate_out" | jq -r '.git_state // empty' 2>/dev/null)"
  if [ "$grc" != 0 ]; then
    gdec="$(printf '%s'    "$gate_out" | jq -r '.decision // empty'    2>/dev/null)"
    [ -n "$gdec" ] || { [ "$grc" = 2 ] && gdec=REFUSE || gdec=DEFER; }
    grk="$(printf '%s'     "$gate_out" | jq -r '.reason_kind // "gate"' 2>/dev/null)"
    greason="$(printf '%s' "$gate_out" | jq -r '.reason // "safety gate blocked teardown"' 2>/dev/null)"
    record "$gdec" "$grk" "$greason" 0 "$grc"
    say "$gdec — $greason (exit $grc)"; exit "$grc"
  fi

  # ── 2c. tty-exclusivity — runtime-only guard, meaningful ONLY while the target is LIVE ──────────────
  if pid_alive "$pid"; then
    local fc; fc="$(tty_foreign "$pid")"
    if [ "$fc" = -1 ]; then
      record DEFER tty-indeterminate "cannot resolve the pane tty for pid $pid — cannot prove tty-exclusive; fail-closed" 0
      say "DEFER — pane tty indeterminate (exit 10)"; exit 10
    fi
    if [ "${fc:-0}" -gt 0 ] 2>/dev/null; then
      record DEFER tty-busy "$fc foreign live process(es) on the pane tty beyond the target claude tree — refusing collateral close" 0
      say "DEFER — $fc foreign process(es) share the pane tty (exit 10)"; exit 10
    fi
  fi

  # ── 2d. TEARDOWN MARKER — drop the deterministic evidence the TARGET's crash watchdog reads, at the
  # moment the close becomes inevitable: EVERY gate has passed and the first kill is the next statement.
  # Deliberately NOT written earlier: a REFUSE/DEFER leaves the target ALIVE, and a stale marker would
  # mask a genuine crash of that live session for the reader's whole 30-min freshness window.
  write_teardown_marker "$paneUUID" "$sess_id" teardown

  # ── 3. ACT both legs ───────────────────────────────────────────────────────────────────────────────
  local lstart_before; lstart_before="$(pid_lstart "$pid")"

  # leg 1 — process: TERM, poll, escalate KILL, confirm dead (lstart pin beats pid-recycling).
  if pid_alive "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 $((TERM_GRACE_S * 5))); do pid_alive "$pid" || break; sleep 0.2; done
    if pid_alive "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
      for _ in $(seq 1 15); do pid_alive "$pid" || break; sleep 0.2; done
    fi
  fi

  # leg 2 — pane: forced no-modal close (0 closed · 3 not-found/idempotent · 4 timeout · other = error).
  local close_rc; cct_bounded "$IT2" session close -f -s "$paneUUID" >/dev/null 2>&1; close_rc=$?

  # ── 4. EFFECT-VERIFY both legs, RE-OBSERVED (never trust the keystroke/exit code) ──────────────────
  local proc_gone=0 pane_gone=0 lstart_now
  if ! pid_alive "$pid"; then
    proc_gone=1
  else
    lstart_now="$(pid_lstart "$pid")"
    [ -n "$lstart_before" ] && [ -n "$lstart_now" ] && [ "$lstart_now" != "$lstart_before" ] && proc_gone=1  # recycled ⇒ original gone
  fi
  pane_present "$paneUUID"; local ppv=$?
  [ "$ppv" = 1 ] && pane_gone=1

  if [ "$proc_gone" = 1 ] && [ "$pane_gone" = 1 ]; then
    record TEARDOWN "done" "both legs effect-verified (re-observed): process gone AND pane absent; close_rc=$close_rc" 1
    say "OK — torn down + effect-verified: process gone AND pane absent (exit 0)"; exit 0
  fi
  # ── 5(fail). LOUD — acted but a leg SURVIVED. Never a false success. ───────────────────────────────
  record FAILED not-verified "effect-verify FAILED (re-observed): proc_gone=$proc_gone pane_gone=$pane_gone close_rc=$close_rc — LOUD, never a false success" 0
  say "FAIL — teardown NOT verified: proc_gone=$proc_gone pane_gone=$pane_gone close_rc=$close_rc (exit 5)"; exit 5
}

# ── selftest: SEE every branch fire. Mock cc-sessions/it2/ps + temp git repos + REAL killable sleeps. ──
PASS=0; FAIL=0
okp()  { printf '  ok   %-66s\n' "$1"; PASS=$((PASS+1)); }
badp() { printf '  FAIL %-66s\n' "$1"; FAIL=$((FAIL+1)); }

selftest() {
  local d SELF GATE_SELF P U rc blv present_after
  d="$(mktemp -d "${TMPDIR:-/tmp}/ccteardown.XXXXXX")" || die "mktemp"
  # shellcheck disable=SC2064,SC2046
  trap "rm -rf '$d'; kill \$(jobs -p) 2>/dev/null || true" EXIT
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  GATE_SELF="$(cd "$(dirname "$0")" && pwd)/cc-teardown-safety-gate.sh"
  mkdir -p "$d/bin" "$d/state" "$d/rec"
  U="AAAA1111-2222-3333-4444-555566667777"
  P=""

  mkrepo() { # <dir> — clean shipped repo (origin/main == HEAD), no network
    local r="$1"; mkdir -p "$r"
    git -C "$r" init -q; git -C "$r" config user.email t@t; git -C "$r" config user.name t
    echo a > "$r/f"; git -C "$r" add f; git -C "$r" commit -qm c1
    git -C "$r" update-ref refs/remotes/origin/main HEAD
    git -C "$r" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
  }

  # mock cc-sessions — prints $d/state/sessions.json (valid JSON always; '[]' if empty/missing)
  cat > "$d/bin/cc-sessions" <<EOF
#!/bin/bash
[ -s "$d/state/sessions.json" ] && cat "$d/state/sessions.json" || echo '[]'
EOF
  # mock it2 — session list reads the panes file; session close removes the uuid iff IT2_CLOSE_REMOVES=1
  cat > "$d/bin/it2" <<'EOF'
#!/bin/bash
PF="${IT2_PANES_FILE:?}"
if [ "$1" = session ] && [ "$2" = list ]; then
  # IT2_BLIND=1 simulates a blind app.windows enumerator (detached desk / restoration-pending):
  # a VALID but EMPTY [] at exit 0 — the "it2 ls returned 0" incident shape.
  if [ "${IT2_BLIND:-0}" = 1 ]; then echo '[]'; exit 0; fi
  # Reality: cc-teardown always runs FROM a live pane, so the desk's own pane is ALWAYS enumerated.
  # Append a persistent non-target desk pane so an emptied panes-file lists as [desk] (target
  # genuinely absent → rc 1), NOT [] (blind → rc 2). Without this the mock is a fictional
  # single-pane world that no real desk is ever in.
  jq -n --slurpfile a "$PF" '($a[0] + ["DESK-PANE-PERSIST-0000"]) | unique | map({id: .})'; exit 0
fi
if [ "$1" = session ] && [ "$2" = close ]; then
  shift 2; sid=""
  while [ $# -gt 0 ]; do case "$1" in -s|--session) sid="${2:-}"; shift 2 ;; *) shift ;; esac; done
  if [ "${IT2_CLOSE_REMOVES:-1}" = 1 ] && [ -n "$sid" ]; then
    jq --arg u "$sid" 'map(select(. != $u))' "$PF" > "$PF.t" && mv "$PF.t" "$PF"
  fi
  exit "${IT2_CLOSE_RC:-0}"
fi
exit 0
EOF
  chmod +x "$d/bin/cc-sessions" "$d/bin/it2"

  # mock ps — real lstart passthrough; tty faked to a fixed line; tty process-table read from <table-file>
  # PS_ENV serves the `-E -Ao pid=,command=` occupancy scan (pane_occupants), verbatim in `ps -E`
  # shape: `pid argv0 argv... KEY=v KEY=v`. DEFAULT EMPTY = a BLIND oracle, deliberately: a scenario
  # that forgets to pose one must refuse loudly, never fall through to the real machine's process
  # table and decide a teardown branch on whatever panes happen to be open right now.
  make_ps() { # <dest> <table-file>
    cat > "$1" <<EOF
#!/bin/bash
case "\$*" in
  *"-o tty="*) echo "ttys900" ;;
  *"-E "*)     printf '%s\n' "\${PS_ENV:-}" ;;
  *"-t "*)     cat "$2" 2>/dev/null ;;
  *)           exec /bin/ps "\$@" ;;
esac
EOF
    chmod +x "$1"
  }
  printf '99999 1 -zsh\n'               > "$d/state/tty_clean"     # only an interactive shell → exclusive
  printf '99999 1 -zsh\n88888 1 vim\n'  > "$d/state/tty_foreign"  # a foreign vim → tty-busy
  make_ps "$d/bin/ps_clean"   "$d/state/tty_clean"
  make_ps "$d/bin/ps_foreign" "$d/state/tty_foreign"

  # atomic writes (temp + mv) so a reader NEVER sees a half-written / truncated file; numeric-safe pid.
  set_session() { printf '[{"paneUUID":"%s","name":"test-sess","pid":%s,"cwd":"%s","session_id":"s","startedAt":0}]\n' \
    "$U" "${1:-0}" "$2" > "$d/state/sessions.json.t" && mv "$d/state/sessions.json.t" "$d/state/sessions.json"; }
  set_panes() { printf '%s' "$1" > "$d/state/panes.json.t" && mv "$d/state/panes.json.t" "$d/state/panes.json"; }
  # An EMPTY registry — the measured condition of every Agent-Team assignee pane (134/134 had no
  # row). Mandatory for the adoption scenarios: leave a prior scenario's row in place and resolve()
  # succeeds, the run never enters the adoption path, and the scenario passes on a branch it is not
  # testing (which is exactly how 16 first went green while proving nothing).
  no_session() { printf '[]\n' > "$d/state/sessions.json.t" && mv "$d/state/sessions.json.t" "$d/state/sessions.json"; }
  spawn()     { /bin/sleep 300 & P=$!; }
  reap()      { [ -n "${P:-}" ] && { kill "$P" 2>/dev/null; wait "$P" 2>/dev/null; }; P=""; }

  run_td() { # <ps-mock> -- then the cc-teardown argv; extra env via IT2_CLOSE_* set by caller
    local psbin="$1"; shift
    CC_TEARDOWN_SESSIONS_BIN="$d/bin/cc-sessions" IT2_BIN="$d/bin/it2" \
    CC_TEARDOWN_GATE_BIN="$GATE_SELF" CC_TEARDOWN_PS_BIN="$psbin" \
    CC_TEARDOWN_RECORDS_DIR="$d/rec" CC_TEARDOWN_SELF_UUID="SELF-0000" \
    IT2_PANES_FILE="$d/state/panes.json" CC_TEARDOWN_TERM_GRACE_S=2 \
    CC_TEARDOWN_DIR="$d/tdmark" \
    "$@" --decided-at "$(date +%s)"
  }
  # Every selftest scenario stands in for the AUTONOMOUS caller (cc-reaper), so it must carry the
  # decision-freshness lease exactly as that caller does — appended here rather than at 20 call sites.
  # Without it every scenario would refuse `lease-missing` and the selftest would be measuring the
  # lease instead of the branch each scenario exists to prove. The lease itself is proven separately
  # and adversarially in tests/reap-freshness.bats (incl. its RED-proof against the pristine tree).
  # each scenario rm's records first + every cc-teardown run writes exactly one → find gives that record.
  last_record()   { find "$d/rec" -name '*.json' 2>/dev/null | head -1; }
  last_decision() { local f; f="$(last_record)"; [ -n "$f" ] && jq -r '.decision' "$f"; }
  last_blv()      { local f; f="$(last_record)"; [ -n "$f" ] && jq -r '.both_legs_verified' "$f"; }

  echo "cc-teardown --selftest — every teardown RED-proof must fire (mock panes/pids + temp git; NO real session):"

  # 1. clean+shipped + done-evidence + pane closes → TEARDOWN, BOTH legs effect-verified (exit 0)
  rm -f "$d/rec"/*.json; rm -rf "$d/tdmark"; mkrepo "$d/r1"; spawn; set_session "$P" "$d/r1"; set_panes "[\"$U\"]"
  rc=0; IT2_CLOSE_REMOVES=1 IT2_CLOSE_RC=0 run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "shipped d283997" >/dev/null 2>&1 || rc=$?
  blv="$(last_blv)"
  [ "$rc" = 0 ] && [ "$(last_decision)" = TEARDOWN ] && [ "$blv" = true ] \
    && okp "clean+shipped + done → TEARDOWN, BOTH legs effect-verified (exit 0)" \
    || badp "clean+shipped teardown failed (rc=$rc dec=$(last_decision) blv=$blv; want 0/TEARDOWN/true)"
  # 1b. …and it dropped the contract-v1 crash-watchdog marker for the TARGET, dual-keyed (sid "s" +
  #     pane $U). Without it the target's OWN watchdog logs this deliberate close as a CRASH.
  [ -f "$d/tdmark/s.json" ] && [ -f "$d/tdmark/$U.json" ] \
    && [ "$(jq -r '.mode' "$d/tdmark/s.json" 2>/dev/null)" = teardown ] \
    && [ "$(jq -r '.key_kind' "$d/tdmark/s.json" 2>/dev/null)" = sid ] \
    && [ "$(jq -r '.key_kind' "$d/tdmark/$U.json" 2>/dev/null)" = pane ] \
    && okp "TEARDOWN wrote the dual-keyed marker (mode=teardown) — no false CRASH downstream" \
    || badp "TEARDOWN left NO valid marker (sid=$(jq -r '.mode' "$d/tdmark/s.json" 2>/dev/null) pane=$(jq -r '.key_kind' "$d/tdmark/$U.json" 2>/dev/null)) — the close reads as a crash"
  reap

  # 2. pane SURVIVES the close → FAIL LOUD (exit 5), never a false success  [the anti-keystroke-faith proof]
  rm -f "$d/rec"/*.json; mkrepo "$d/r2"; spawn; set_session "$P" "$d/r2"; set_panes "[\"$U\"]"
  rc=0; IT2_CLOSE_REMOVES=0 IT2_CLOSE_RC=0 run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 5 ] && [ "$(last_decision)" = FAILED ] \
    && okp "pane SURVIVES close → FAIL LOUD (exit 5), never a false success" \
    || badp "a surviving pane was not caught (rc=$rc dec=$(last_decision); want 5/FAILED)"
  reap

  # 3. dirty tree → DEFER (exit 10), pane left intact
  rm -f "$d/rec"/*.json; rm -rf "$d/tdmark"; mkrepo "$d/r3"; echo change >> "$d/r3/f"; spawn; set_session "$P" "$d/r3"; set_panes "[\"$U\"]"
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 10 ] && [ "$(last_decision)" = DEFER ] \
    && okp "dirty tree → DEFER (exit 10)" \
    || badp "dirty tree not deferred (rc=$rc dec=$(last_decision); want 10/DEFER)"
  present_after="$(jq -r --arg u "$U" 'index($u)!=null' "$d/state/panes.json" 2>/dev/null)"
  [ "$present_after" = true ] && okp "DEFER left the pane intact (a deferred close has NO side effect)" \
    || badp "DEFER still closed the pane (panes.json lost $U)"
  # …and wrote NO marker: the target is still ALIVE, so a marker would mask a genuine crash of it for
  # the reader's whole 30-min freshness window. Markers are written ONLY once a close is inevitable.
  [ -z "$(ls -A "$d/tdmark" 2>/dev/null)" ] \
    && okp "DEFER wrote NO marker (a LIVE pane is never masked from its crash watchdog)" \
    || badp "DEFER dropped a teardown marker on a LIVE pane — would mask a genuine crash for 30 min"
  reap

  # 4. committed-not-pushed → DEFER (exit 10)
  rm -f "$d/rec"/*.json; mkrepo "$d/r4"; echo more >> "$d/r4/f"; git -C "$d/r4" commit -aqm c2
  spawn; set_session "$P" "$d/r4"; set_panes "[\"$U\"]"
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 10 ] && [ "$(last_decision)" = DEFER ] \
    && okp "committed-not-pushed → DEFER (exit 10)" \
    || badp "unpushed not deferred (rc=$rc dec=$(last_decision); want 10/DEFER)"
  reap

  # 5. missing done-evidence → REFUSE (exit 2)
  rm -f "$d/rec"/*.json; mkrepo "$d/r5"; spawn; set_session "$P" "$d/r5"; set_panes "[\"$U\"]"
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "$U" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ] && [ "$(last_decision)" = REFUSE ] \
    && okp "missing done-evidence → REFUSE (exit 2) — done never inferred" \
    || badp "missing done-evidence not refused (rc=$rc dec=$(last_decision); want 2/REFUSE)"
  reap

  # 6. unknown target → REFUSE (exit 2)
  rm -f "$d/rec"/*.json; set_session 99999 "$d/r5"; set_panes "[]"
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "NOPE-0000" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ] && [ "$(last_decision)" = REFUSE ] \
    && okp "unknown target → REFUSE (exit 2)" \
    || badp "unknown target not refused (rc=$rc dec=$(last_decision); want 2/REFUSE)"

  # 7. self target (resolved UUID == self) → REFUSE (exit 2)
  rm -f "$d/rec"/*.json
  jq -n '[{paneUUID:"SELF-0000",name:"me",pid:99999,cwd:"/tmp",session_id:"s",startedAt:0}]' > "$d/state/sessions.json"
  set_panes '["SELF-0000"]'
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "SELF-0000" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ] && [ "$(last_decision)" = REFUSE ] \
    && okp "self target → REFUSE (exit 2) — never self-teardown" \
    || badp "self not refused (rc=$rc dec=$(last_decision); want 2/REFUSE)"

  # 8. --self literal → REFUSE (exit 2)
  rm -f "$d/rec"/*.json
  rc=0; run_td "$d/bin/ps_clean" "$SELF" --self --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ] && [ "$(last_decision)" = REFUSE ] \
    && okp "'--self' literal → REFUSE (exit 2)" \
    || badp "--self literal not refused (rc=$rc dec=$(last_decision); want 2/REFUSE)"

  # 9. IDEMPOTENT: dead pid + absent pane → success (exit 0). A fixed pid > kern.maxproc is guaranteed
  #    unassigned (kill -0 → ESRCH → dead) — deterministic, with no spawn/kill/wait pid-reuse race.
  rm -f "$d/rec"/*.json; mkrepo "$d/r9"
  set_session 4000000 "$d/r9"; set_panes "[]"
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 0 ] && [ "$(last_decision)" = ALREADY-GONE ] \
    && okp "idempotent: dead pid + absent pane → success (exit 0)" \
    || badp "idempotent path failed (rc=$rc dec=$(last_decision); want 0/ALREADY-GONE)"

  # 10. tty-busy: a foreign process on the pane tty → DEFER (exit 10)
  rm -f "$d/rec"/*.json; mkrepo "$d/r10"; spawn; set_session "$P" "$d/r10"; set_panes "[\"$U\"]"
  rc=0; run_td "$d/bin/ps_foreign" "$SELF" "$U" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 10 ] && [ "$(last_decision)" = DEFER ] \
    && okp "foreign process on pane tty → DEFER (exit 10) — no collateral close" \
    || badp "tty-busy not deferred (rc=$rc dec=$(last_decision); want 10/DEFER)"
  reap

  # 12. BLIND ENUMERATOR: live pane, but it2 returns a 0-list ([]) → pane_present INDETERMINATE →
  #     verify can never read false-gone → FAIL LOUD (exit 5). RED-proof of the app.windows-blind fix:
  #     before it, a spurious [] read as "pane absent" ⇒ a FALSE TEARDOWN success on a live pane.
  rm -f "$d/rec"/*.json; mkrepo "$d/r12"; spawn; set_session "$P" "$d/r12"; set_panes "[\"$U\"]"
  rc=0; IT2_BLIND=1 run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 5 ] && [ "$(last_decision)" = FAILED ] \
    && okp "blind enumerator (0-list) → INDETERMINATE, never a false teardown; FAIL LOUD (exit 5)" \
    || badp "blind enumerator produced a false result (rc=$rc dec=$(last_decision); want 5/FAILED)"
  reap

  # 13. IDENTITY PIN (a17 S-4): the pane RECYCLED between classify and act — the registry now resolves a
  #     DIFFERENT live pid than cc-reaper pinned at classify-time. cc-teardown must REFUSE (exit 2) and
  #     leave the (successor) process ALIVE — never a collateral kill of the freshly-booted successor.
  rm -f "$d/rec"/*.json; mkrepo "$d/r13"; spawn; set_session "$P" "$d/r13"; set_panes "[\"$U\"]"
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" --expect-pid 4000000 >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ] && [ "$(last_decision)" = REFUSE ] \
    && okp "identity-pin mismatch (pane recycled: pid differs) → REFUSE (exit 2), never the successor" \
    || badp "identity-pin mismatch not refused (rc=$rc dec=$(last_decision); want 2/REFUSE)"
  kill -0 "$P" 2>/dev/null \
    && okp "identity-pin REFUSE left the pinned process ALIVE (no collateral kill of the successor)" \
    || badp "identity-pin REFUSE still killed the process — collateral kill"
  reap

  # ── 14-16. THE FALSE-SUCCESS CLASS (backlog 99f87bf7a6f7). An "already gone" that was INFERRED from
  #    a failed lookup rather than READ is the one wrong answer an automated caller cannot catch: it
  #    is byte-identical to a real reap. Pre-fix, `cc-teardown gu2-seams --assignee-of <lead>` exited 0
  #    while that pane's pid was alive at 6h48m. Adoption needs no registry row, so these pose only a
  #    lead id; the exhaustive matrix (incl. adoption + lowercase + argv-not-env) is in
  #    tests/cc-teardown-assignee-adopt.bats, RED-proved against the pre-fix tree via CCT_UNDER_TEST.
  local LEAD_SELFTEST=a8e72ae5

  # 14. target is an AGENT NAME, not a pane uuid → no enumerator can answer → REFUSE (exit 2).
  rm -f "$d/rec"/*.json; set_panes "[]"
  rc=0; run_td "$d/bin/ps_clean" "$SELF" "gu2-seams" --done-evidence "x" --assignee-of "$LEAD_SELFTEST" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ] && [ "$(jq -r '.reason_kind' "$(last_record)")" = target-not-a-pane-uuid ] \
    && okp "agent-name target (not a pane uuid) → REFUSE (exit 2), never a false already-gone" \
    || badp "a non-pane-uuid target was not refused (rc=$rc rk=$(jq -r '.reason_kind' "$(last_record)" 2>/dev/null); want 2/target-not-a-pane-uuid)"

  # 15. pane absent from a READABLE list, but live processes still carry its ITERM_SESSION_ID: the
  #     enumerator was partially blind. Two oracles disagree ⇒ the SAFE one wins ⇒ REFUSE (exit 2).
  rm -f "$d/rec"/*.json; set_panes "[]"; no_session
  rc=0; PS_ENV="31337 claude.exe --agent-id a@session-$LEAD_SELFTEST ITERM_SESSION_ID=w0t0p1:$U" \
    run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" --assignee-of "$LEAD_SELFTEST" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ] && [ "$(jq -r '.reason_kind' "$(last_record)")" = absence-contradicted ] \
    && okp "pane 'absent' but still OCCUPIED → REFUSE (exit 2) — a reap that did not happen is never 0" \
    || badp "an occupied pane was reported gone (rc=$rc rk=$(jq -r '.reason_kind' "$(last_record)" 2>/dev/null); want 2/absence-contradicted)"

  # 16. …and the converse, so the fix cannot be "refuse everything": both oracles agree the pane is
  #     vacant (a live UNRELATED pane supplies the positive control) → ALREADY-GONE (exit 0).
  rm -f "$d/rec"/*.json; set_panes "[]"; no_session
  rc=0; PS_ENV="777 -zsh ITERM_SESSION_ID=w9t9p9:D0D0D0D0-1111-2222-3333-444455556666" \
    run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" --assignee-of "$LEAD_SELFTEST" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 0 ] && [ "$(last_decision)" = ALREADY-GONE ] \
    && okp "absence agreed by BOTH oracles → ALREADY-GONE (exit 0) — corroborated, not inferred" \
    || badp "a corroborated absence was not accepted (rc=$rc dec=$(last_decision); want 0/ALREADY-GONE)"

  # 11. NO-SILENT-RECORD: the just-run branch wrote an auditable outcome record
  [ -n "$(last_decision)" ] && okp "no-silent-record: every decision branch writes an outcome record" \
    || badp "a decision was SILENT (no record) — an unauditable teardown"

  # 17. VERDICT TOKEN: the branch that just ran printed one machine-parseable verdict line whose
  #     advertised exit code matches the contract. A caller must never parse prose or guess from rc.
  rm -f "$d/rec"/*.json; set_panes "[]"; no_session
  local vout
  vout="$(PS_ENV="777 -zsh ITERM_SESSION_ID=w9t9p9:D0D0D0D0-1111-2222-3333-444455556666" \
    run_td "$d/bin/ps_clean" "$SELF" "$U" --done-evidence "x" --assignee-of "$LEAD_SELFTEST" 2>&1 >/dev/null)"
  case "$vout" in
    *"verdict=ALREADY-GONE reason_kind=idempotent exit=0 target=$U"*)
      okp "verdict token: one parseable 'verdict=… reason_kind=… exit=… target=…' line per decision" ;;
    *) badp "no parseable verdict token on stderr (got: $(printf '%s' "$vout" | head -1))" ;;
  esac

  echo "cc-teardown --selftest: $PASS passed, $FAIL failed"
  [ "$FAIL" -eq 0 ] || exit 1
  echo "cc-teardown --selftest: GREEN — teardown(both-legs-verified), pane-survives→FAIL-LOUD(5), dirty/unpushed/tty-busy→DEFER(10), missing-done/unknown/self/--self/identity-pin-recycle/non-pane-uuid-target/absence-contradicted→REFUSE(2), idempotent + corroborated-absence(0), no-silent-record, verdict-token all fire."
  exit 0
}

case "${1:-}" in
  --selftest)   selftest ;;
  -h|--help|"") usage; exit 0 ;;
  *)            main "$@" ;;
esac
