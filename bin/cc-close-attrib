#!/usr/bin/env bash
# cc-close-attrib — session close-attribution capture (exec-wrapper).
#
#   cc-close-attrib <real-claude-binary> [args...]
#
# WHY THIS EXISTS: a 7-day forensics sweep found 0 organic CC crashes — but ALSO that
# if one ever happens it is UNATTRIBUTABLE. No launcher path captures an exit code or
# stderr; every stderr log is 0 bytes; the crash watchdog records claude_version:"?" and
# stderr_log:"". This wrapper closes that gap: it runs the real binary unchanged, tees its
# stderr to a per-run capture file (while stderr still reaches the terminal), and on exit
# writes a small JSON close-record keyed by the binary's PID. The crash watchdog
# (hooks/lead-crash-watchdog.sh) joins that record to the dead PID and finally attributes
# the death (clean-exit vs killed-oom-or-force vs binary-crash vs error-exit).
#
# PID SEMANTICS (load-bearing): the watchdog keys on LEAD_PID = PPID of the SessionStart
# hook = the claude binary's PID. To make the record's filename PID match, we CANNOT exec
# the binary (we'd lose the exit code) and we CANNOT run it in the plain foreground (bash
# never exposes a foreground child's PID). Instead we background a brace-group that execs
# the binary: `{ exec "$bin" ...; } &`. Backgrounding forks the group; `exec` then replaces
# that fork WITHOUT changing its PID, so `$!` IS the binary's PID — exactly LEAD_PID — and
# `wait` still yields the true exit status (128+n on signal). exec-chain PID preservation
# also means wrapping `claude-latest` (which itself execs the versioned node binary) still
# lands the SAME PID the watchdog sees.
#
# DURABLE STDERR LOG (eval-track crash forensics). The close-record's stderr_tail is a
# 40-line, secret-filtered SUMMARY written at exit — so it is absent in exactly the case that
# matters most: a group SIGKILL (OOM killer, force-quit) takes this wrapper down with its
# child and write_record never runs. The eval track has only ever had that summary, because
# claude-next / -2/-3/-4, claude-fable*, claude-desk* and every handoff-fire spawn exec the
# versioned binary through THIS wrapper and never through bin/claude-latest (which does write
# a durable log). Result, measured 2026-07-29: 0 of 52 rows in claude-crashes.jsonl ever
# carried a stderr_log, and that day's three eval-track deaths landed as "abrupt-unknown"
# with no close-record either. So the capture is ALSO hard-linked into
# ~/.claude/logs/stderr/<ts>-<pid>.log — byte-identical to the namespace bin/claude-latest
# writes and lead-crash-watchdog.sh:821 already globs (`*-<pid>.log`), so both tracks join
# through one unchanged consumer. A hard link, never a rename: `tee`'s own path must stay
# fixed or it would race the rename and re-create the old name (O_CREAT) under us.
# The log is RAW stderr — untruncated and NOT secret-filtered (same as claude-latest's), but
# 0600 via mktemp's inode rather than tee's umask. The record's tail stays the filtered,
# parseable summary; the log is the local full evidence.
#
# HARD RULE — FAIL OPEN EVERYWHERE. Capture must never delay or break a session. There is
# no `set -e`; every capture step is individually guarded; the worst case is a plain exec
# with no record. Kill switch: export CC_CLOSE_ATTRIB_DISABLED=1 (⇒ plain exec, no capture).
#
# NO HARD DEPENDENCIES beyond bash + coreutils. JSON is emitted with printf (never jq) so a
# minimal launcher PATH cannot break it. jq is neither called nor required.

REAL_BIN="${1:-}"
if [[ -z "$REAL_BIN" ]]; then
  echo "usage: cc-close-attrib <real-claude-binary> [args...]" >&2
  exit 64
fi
shift
BIN_ARGV=("$@")   # the real binary's args (for argv[first 3] in the record)

RECORDS_DIR="${CC_CLOSE_RECORDS_DIR:-$HOME/.claude/logs/close-records}"
# Same $HOME-derived path bin/claude-latest writes and lead-crash-watchdog.sh:821 globs.
STDERR_DIR="${CC_STDERR_LOG_DIR:-$HOME/.claude/logs/stderr}"
STDERR_KEEP="${CC_STDERR_LOG_KEEP:-200}"   # defensive bound; crashes are rare

# ── best-effort setup — none of this may ever be fatal ──────────────────────────────────
mkdir -p "$RECORDS_DIR" 2>/dev/null || true
# self-GC: drop close-records >30 days and any orphaned stderr temp >1 day (a temp is only
# leaked when the wrapper itself was force-killed before it could unlink one). Best-effort.
#
# DAILY-STAMPED (2026-08-16). These two sweeps walk the whole directory — 1,348 files / 5.0 MB
# today, and it only grows — on EVERY launch, to collect litter that accrues once a day. That is
# ~30 ms on 100% of launches, on the pre-exec critical path, for work that cannot possibly have
# anything new to do since the last launch seconds earlier. Gate them behind a daily stamp using
# this file's own idiom (see the $VER_CACHE block two blocks below): one `find` against a single
# stamp file instead of two full-directory walks. Retention is unchanged — >30 d and >1 d still
# go, just checked daily rather than per-launch. Fail-open like everything else here: if the
# stamp cannot be written the sweeps simply run again next launch.
GC_STAMP="$RECORDS_DIR/.gc_stamp"
if [[ ! -e "$GC_STAMP" ]] || [[ -n "$(find "$GC_STAMP" -mtime +1 2>/dev/null)" ]]; then
  find "$RECORDS_DIR" -maxdepth 1 -type f -name '*.json'   -mtime +30 -delete 2>/dev/null || true
  find "$RECORDS_DIR" -maxdepth 1 -type f -name '.stderr.*' -mtime +1  -delete 2>/dev/null || true
  : > "$GC_STAMP" 2>/dev/null || true
fi

# version — best-effort, CACHED, and NEVER blocking start. Fire `--version` fully detached
# and only when the cache is missing or stale (>1 day); the record reader picks up whatever
# landed. CLAUDE_SKIP_UPDATE guards against a launcher's --version triggering a self-update.
VER_KEY="$(printf '%s' "$REAL_BIN" | tr -c 'A-Za-z0-9' '_')"
VER_CACHE="$RECORDS_DIR/.ver_$VER_KEY"
if [[ ! -e "$VER_CACHE" ]] || [[ -n "$(find "$VER_CACHE" -mtime +1 2>/dev/null)" ]]; then
  (
    if CLAUDE_SKIP_UPDATE=1 "$REAL_BIN" --version >"$VER_CACHE.tmp.$$" 2>/dev/null; then
      mv -f "$VER_CACHE.tmp.$$" "$VER_CACHE" 2>/dev/null || rm -f "$VER_CACHE.tmp.$$" 2>/dev/null
    else
      rm -f "$VER_CACHE.tmp.$$" 2>/dev/null
    fi
  ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
fi

START_EPOCH="$(date +%s 2>/dev/null || echo 0)"
STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '')"
# local-time stamp for the durable log's name — same format bin/claude-latest uses, so both
# tracks' logs sort together in one directory listing.
STARTED_STAMP="$(date +%Y%m%dT%H%M%S 2>/dev/null || printf '%s' "$START_EPOCH")"

# ── capability gate: kill-switch, bash, and a runtime process-substitution probe. Any doubt
#    ⇒ plain exec (fail-open). The probe confirms /dev/fd `>(...)` actually works here. ─────
PROCSUB_OK=0
if [[ -z "${CC_CLOSE_ATTRIB_DISABLED:-}" && -n "${BASH_VERSION:-}" ]]; then
  if ( : 2> >(cat >/dev/null) ) 2>/dev/null; then PROCSUB_OK=1; fi
fi
[[ "$PROCSUB_OK" -eq 1 ]] || exec "$REAL_BIN" "$@"

# per-run stderr capture file (kept out of the *.json GC namespace)
CAPTURE="$(mktemp "$RECORDS_DIR/.stderr.XXXXXX" 2>/dev/null)" || CAPTURE=""
[[ -n "$CAPTURE" ]] || exec "$REAL_BIN" "$@"

# ── JSON string escaper: stdin → JSON-safe body (no surrounding quotes), pure sed/tr/awk.
#    Strips ANSI CSI + control bytes (claude writes color codes to stderr → invalid JSON),
#    escapes \ and ", then joins lines with \n. Tab preserved as \t. ───────────────────────
_json_escape() {
  LC_ALL=C sed "s/$(printf '\033')\[[0-9;?]*[A-Za-z]//g" 2>/dev/null \
    | LC_ALL=C tr -d '\000-\010\013-\037\177' 2>/dev/null \
    | LC_ALL=C sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' 2>/dev/null \
    | awk 'BEGIN{ORS=""} NR>1{printf "\\n"} {printf "%s",$0}' 2>/dev/null
}

# ── write the close-record atomically (tmp+mv). Fully guarded — returns 0 no matter what so
#    it can never affect the session's exit path. ──────────────────────────────────────────
write_record() {
  local rpid="$1" rcode="$2"
  local rsig=""
  [[ "$rcode" =~ ^[0-9]+$ && "$rcode" -gt 128 ]] && rsig=$(( rcode - 128 ))

  local rver=""
  if [[ -s "$VER_CACHE" ]]; then
    rver="$(grep -oE '[0-9]+\.[0-9]+\.[0-9]+' "$VER_CACHE" 2>/dev/null | head -1)"
    [[ -z "$rver" ]] && rver="$(head -1 "$VER_CACHE" 2>/dev/null | _json_escape)"
  fi

  local a0 a1 a2
  a0="$(printf '%s' "$REAL_BIN"          | _json_escape)"
  a1="$(printf '%s' "${BIN_ARGV[0]:-}"   | _json_escape)"
  a2="$(printf '%s' "${BIN_ARGV[1]:-}"   | _json_escape)"

  # stderr tail: last 40 lines, secret-bearing lines dropped first, then escaped. grep -v
  # exits 1 on an all-stripped/empty tail → `|| true` so it never trips the pipeline.
  local tail_json=""
  if [[ -s "$CAPTURE" ]]; then
    tail_json="$( { tail -n 40 "$CAPTURE" 2>/dev/null \
      | grep -ivE '(key|token|authorization|bearer|secret|password)' \
      || true; } | _json_escape )"
  fi

  # stderr_log — the durable, untruncated companion to stderr_tail. Appended LAST: every
  # reader is name-keyed (close_record_field), so a new trailing field is additive.
  local log_json=""
  [[ -n "$STDERR_LOG" && -s "$STDERR_LOG" ]] && log_json="$(printf '%s' "$STDERR_LOG" | _json_escape)"

  local out="$RECORDS_DIR/${rpid:-0}-${START_EPOCH}.json"
  local tmp="$out.tmp.$$"
  if printf '{"pid":%s,"ppid":%s,"argv":["%s","%s","%s"],"started_at":"%s","ended_at":"%s","exit_code":%s,"signal":"%s","stderr_tail":"%s","version":"%s","stderr_log":"%s"}\n' \
    "${rpid:-0}" "$$" "$a0" "$a1" "$a2" "$STARTED_AT" "$ENDED_AT" "${rcode:-0}" "$rsig" "$tail_json" "$rver" "$log_json" \
    > "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$out" 2>/dev/null || rm -f "$tmp" 2>/dev/null
  else
    rm -f "$tmp" 2>/dev/null
  fi
  return 0
}

# ── run the real binary as a backgrounded exec (see PID SEMANTICS). <&0 keeps the child's
#    stdin on the terminal (bash otherwise reassigns an async command's stdin to /dev/null);
#    job control is off in a script, so the child stays in the foreground process group and
#    reads/writes the tty without SIGTTIN/SIGTTOU. Traps forward terminal signals to the
#    child and keep the wrapper alive to reap + record. ─────────────────────────────────────
child=""
# shellcheck disable=SC2329  # invoked indirectly by the traps below (shellcheck can't see it)
_forward() { [[ -n "$child" ]] && kill -"$1" "$child" 2>/dev/null || true; }
trap '_forward INT'  INT
trap '_forward TERM' TERM
trap '_forward HUP'  HUP

# The tee is created HERE, as an ordinary background job reading an explicit FIFO — not as the
# inline `2> >(tee …)` procsub. Two load-bearing properties the procsub form lacked (both
# measured 2026-08-07, the load-781 incident):
#   (a) A HANDLE. The tee must DIE when this wrapper is done: its stdin is inherited by every
#       process the session ever backgrounds, so a binary that dies leaving even one orphan
#       keeps tee EOF-less forever — 43 of 59 wrappers were lingering beside their dead session
#       (S+ up to 10h), each pinning a tee + its pipeline's zombies via the capture chain. A
#       procsub's pid is unreachable: it forks under the background brace-group (a pid that
#       exec's away, so `pkill -P $$` misses — tried), and `$!` after `exec 9> >(tee …)` names
#       the previous job, not the tee (also tried — the tee survived both). A plain `tee … &`
#       makes `$!` unambiguous, and the exact-pid kill after write_record (below) is the reap.
#   (b) PARSE SAFETY. This spelling is plain POSIX fds + mkfifo, so /bin/bash 3.2 (the launchd
#       minimal-PATH resolution of `env bash`) parses the file and still reaches the fail-open
#       gates above.
# FIFO open order is deadlock-free by construction: tee's `< FIFO` blocks for a writer, our
# `exec 9>` blocks for a reader, and each is the other's counterpart. The name is unlinked the
# moment both ends are open — the pipe then lives purely on fds, so a hard-killed wrapper
# leaves no filesystem litter.
#
# ⚠️ THAT RENDEZVOUS OPEN IS INTERRUPTIBLE, AND ITS FAILURE USED TO KILL THE SESSION (backlog
# 6a7eb069e703, fixed 2026-08-17). `exec 9> "$TEE_FIFO"` is a BLOCKING open(2); bash's SIGCHLD
# handler is not SA_RESTART and bash does not retry the open, so a background child dying inside
# that window aborts the redirection with EINTR and fd 9 is never created. This wrapper has two
# such children BY CONSTRUCTION — the disowned `--version` probe above, and the tee on the line
# before — so the window is structural, not exotic. Measured (QoS-starved, tight loop): 3 of ~100
# runs printed `Interrupted system call` here and then `9: Bad file descriptor` at the child
# spawn, because `2>&9` against an unopened fd kills that subshell BEFORE it can exec anything —
# so the real binary never ran, `wait` handed back 1, and the wrapper exited 1 for a session that
# had not started. Off-box it was 3 of 12 hermetic CI runs of tests/cc-close-attrib.bats.
#
# So the open is RETRIED, and — the load-bearing half — an open that still fails FALLS BACK to the
# /dev/null sink instead of leaving fd 9 absent. This file's hard rule is that the worst case is a
# plain exec with no record; a lost capture obeys that rule and a lost session does not. The retry
# is not merely defensive: after EINTR the tee is still blocked on its own open, so the next
# attempt pairs up immediately. `{ exec 9> …; } 2>/dev/null` is deliberate — a bare
# `exec 9> f 2>/dev/null` would redirect the wrapper's real stderr to /dev/null PERMANENTLY,
# whereas the brace group's redirection is unwound while fd 9's stays (verified on bash 3.2).
TEE_PID=""
TEE_FIFO="$(mktemp -u "${CAPTURE}.fifo.XXXXXX" 2>/dev/null)" || TEE_FIFO=""
if [[ -n "$TEE_FIFO" ]] && mkfifo -m 600 "$TEE_FIFO" 2>/dev/null; then
  tee -a "$CAPTURE" >&2 < "$TEE_FIFO" &
  TEE_PID=$!
  FIFO_OK=0
  for _try in 1 2 3 4 5; do
    if { exec 9> "$TEE_FIFO"; } 2>/dev/null; then FIFO_OK=1; break; fi
  done
  rm -f "$TEE_FIFO" 2>/dev/null || true
  if [[ "$FIFO_OK" -ne 1 ]]; then
    # Reap the tee we can no longer feed — it is blocked on an open that will never get a writer,
    # and the exact-pid reap at the bottom of this file is unreachable once TEE_PID is cleared.
    [[ -n "$TEE_PID" ]] && kill -TERM "$TEE_PID" 2>/dev/null
    TEE_PID=""
    exec 9> /dev/null
  fi
else
  # No FIFO ⇒ no capture (fail-open, the file's hard rule) — fd 9 still must be a sink so the
  # child spawn below is shape-identical on both branches.
  exec 9> /dev/null
fi

{ exec "$REAL_BIN" "$@" 2>&9; } <&0 &
child=$!
# Drop the wrapper's own copy of the write end at once: the holders of record are the child and
# whatever it spawns — exactly the procsub form's fd topology, minus an fd this process never uses.
exec 9>&-

# ── hard-link the live capture to its durable, watchdog-joinable name. Only now is $child
#    (== LEAD_PID) known, and `ln` leaves tee's own path untouched, so there is no race: both
#    names are the same inode and tee keeps writing to it. Guarded end-to-end — if the link
#    cannot be made (e.g. a cross-device $STDERR_DIR) the session is unaffected and behaviour
#    falls back to the record's tail alone. ───────────────────────────────────────────────────
STDERR_LOG=""
if mkdir -p "$STDERR_DIR" 2>/dev/null; then
  _cand="$STDERR_DIR/${STARTED_STAMP}-${child}.log"
  if ln "$CAPTURE" "$_cand" 2>/dev/null; then
    STDERR_LOG="$_cand"
  fi
fi

code=0
# WAIT FIRST, THEN TEST LIVENESS — never the reverse. bash reaps a background child as soon as it
# handles SIGCHLD, and a reaped pid is gone from the process table, so `kill -0` reads FALSE for a
# child that has already exited. As the loop's GUARD that skipped the body entirely on any fast
# exit, leaving `code` at its initial 0: measured 8/60 runs of an `exit 1` child exiting 0, and
# 5/5 once the window is widened. Nothing was ever lost — bash holds a background job's status
# until it is waited for (verified: `kill -0` GONE, `wait` still rc=1) — the ORDER was the whole
# bug. Live impact, not merely a red suite: this wrapper carries every eval-track session's exit
# code, so a crash that lost the race was written "exit_code":0 and attributed clean-exit — the
# one misattribution the wrapper exists to prevent.
# The loop still has to exist: a trapped signal makes `wait` return early, so keep waiting while
# the child is genuinely still alive.
while :; do
  wait "$child"; code=$?
  kill -0 "$child" 2>/dev/null || break
done
trap - INT TERM HUP

ENDED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '')"

write_record "$child" "$code" || true

# ── dispose of the capture. The temp NAME always goes (the record now carries the secret-safe
#    tail); the durable per-pid link survives only if it holds actual evidence — an empty log
#    is clean-exit litter, exactly as bin/claude-latest treats its own. Then bound the
#    directory. Both are best-effort and must never affect the exit path. ────────────────────
rm -f "$CAPTURE" 2>/dev/null || true
if [[ -n "$STDERR_LOG" ]]; then
  [[ -s "$STDERR_LOG" ]] || rm -f "$STDERR_LOG" 2>/dev/null || true
  # Cap to the newest $STDERR_KEEP. ls -1t is safe on this pattern: names are wrapper- and
  # launcher-controlled (<ts>-<pid>.log, no spaces/newlines) and macOS find has no -printf
  # for an mtime sort. This also collects logs leaked by a hard-killed wrapper, which never
  # reaches this line — the next session's exit bounds them.
  # shellcheck disable=SC2012
  { ls -1t "$STDERR_DIR"/*.log 2>/dev/null | tail -n +$((STDERR_KEEP + 1)) \
      | while IFS= read -r _old; do rm -f "$_old" 2>/dev/null || true; done; } || true
fi

# ── reap our own tee BEFORE exiting (see the spawn block for why we hold its exact pid). The
#    record is written and the capture disposed above; anything the dead session's orphans write
#    to fd2 after this point is noise by definition. Exact-pid, never a pattern; best-effort —
#    an empty TEE_PID (bash 3.2) costs a lingering tee, exactly the pre-fix behaviour. ─────────
[[ -n "$TEE_PID" ]] && kill -TERM "$TEE_PID" 2>/dev/null || true
exit "$code"
