#!/bin/bash
# cc-await-ping — block until a NEW line lands in this session's mailbox, print it,
# and exit. The modal-safe PULL complement to cc-notify's push.
#
# Launch it via Bash(run_in_background) before going idle after a `--notify-back`
# handoff: when the fired peer pings (a mailbox write), this exits and the harness's
# task-completion notification re-invokes you — even if the peer's composer injection
# mislanded because you were at a permission/modal prompt. The mailbox write is the
# wake; the injection is the interrupt. Both paths, one loop closed.
#
#   cc-await-ping [<uuid>]          default uuid = own pane ($ITERM_SESSION_ID)
#
# Options:
#   --role <name>   watch the ROLE's mailbox (~/.claude/cc-roles/<name>), re-resolved
#                   EVERY poll cycle — follows a recycle that re-points the role file.
#                   On a mid-wait switch the new mailbox baselines at 0 (never miss the
#                   ping; a rare replay-wake is benign). Mutually exclusive with <uuid>.
#   --timeout <s>   give up after S seconds (default 1800; exit 2)
#   --interval <s>  poll cadence in seconds (default 15)
#   -h, --help
#
# Watches EVERY key of its inbox, not just the one it was handed: cc-notify writes the PANE box and
# mailbox-drain.sh reads the SESSION box, so a single-key watcher can sit deaf beside a delivered line
# (lib → mailbox_keyset). Hence the no-arg form is the one to advertise — it derives the same key
# cc-notify resolves, then covers the rest.
#
# Exit: 0 = new line(s) arrived (printed to stdout); 2 = timed out — the DESIGNED end of a watch that
#           ran its term, echoed as `verdict=timeout` on stderr because the harness labels every
#           non-zero background exit "failed" (see the exit path at the foot of this file);
#       3 = no uuid/role;
#       4 = line(s) DELIVERED but the shared cursor could not be advanced (F9 — you WILL see this mail
#           again; that is a dup, not a loss). Loud on purpose: a cursor-write failure that exits 0 is
#           indistinguishable from a clean take.
#       5 = ORPHANED — the session that armed this watcher is provably gone. Exits WITHOUT consuming,
#           leaving the mail unacked (see the owner guard below for why that is the whole point).
#
# CODES THE HARNESS SYNTHESIZES — NOT OURS, AND NOT 128+signal. If you see this watcher reported as
# `failed with exit code 143` or `144`, it never reached any exit above; it was SIGTERMed, and the
# number tells you WHAT was hit, because the harness's child is the zsh wrapper, not this script:
#   143 = the WATCHER process was TERMed; zsh survived and exited with its own 128+15 status.
#   144 = the whole process GROUP was TERMed (the wrapper died) — a harness *sentinel*, not arithmetic.
# 144 also proves the SIGTERM came from OUTSIDE the harness: every harness-initiated kill resolves the
# task with its own code BEFORE signalling, so it can never surface as 144. Do NOT read 144 as 128+16
# ⇒ SIGURG — that reading is arithmetically tempting, self-refuting (SIGURG's default action is IGNORE,
# so bash cannot die from it), and it cost one investigation its suspect. An exit code cannot name a
# sender; capture one with an SA_SIGINFO recorder (si_pid). Measured 2026-08-07, CC 2.1.220 —
# docs/research/await-ping-exit-144-2026-08-07.md.
# Env overrides (tests): CC_MAILBOX_DIR, CC_ROLES_DIR, CC_COMMS_ALARM_DIR, CC_REGISTRY_DIR.
set -uo pipefail

MAILBOX_DIR="${CC_MAILBOX_DIR:-$HOME/.claude/mailbox}"
ROLES_DIR="${CC_ROLES_DIR:-$HOME/.claude/cc-roles}"
TIMEOUT=1800
INTERVAL=15
UUID=""
ROLE=""

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
  case "$1" in
    --role)     ROLE="${2:?--role needs a value}"; shift 2 ;;
    --timeout)  TIMEOUT="${2:?--timeout needs a value}"; shift 2 ;;
    --interval) INTERVAL="${2:?--interval needs a value}"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    --*)        echo "cc-await-ping: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    *)          if [ -z "$UUID" ]; then UUID="$1"; shift; else echo "cc-await-ping: too many arguments" >&2; exit 2; fi ;;
  esac
done

if [ -n "$ROLE" ] && [ -n "$UUID" ]; then
  echo "cc-await-ping: --role and <uuid> are mutually exclusive" >&2; exit 2
fi

resolve_uuid() {
  # role mode: re-read the role file each call (follows recycles); else the fixed uuid.
  if [ -n "$ROLE" ]; then
    local rf="$ROLES_DIR/$ROLE"
    [ -f "$rf" ] || { echo ""; return; }
    tr -d '[:space:]' < "$rf"
  else
    echo "$UUID"
  fi
}

if [ -z "$ROLE" ] && [ -z "$UUID" ]; then
  _it="${CC_PANE_ID:-${ITERM_SESSION_ID:-}}"; UUID="${_it##*:}"
fi
CUR_UUID="$(resolve_uuid)"
[ -n "$CUR_UUID" ] || { echo "cc-await-ping: no uuid given and no \$ITERM_SESSION_ID (or role file '$ROLES_DIR/$ROLE' missing)" >&2; exit 3; }

# ── cursor lib (critique F6a, amended by F-3 2026-08-09): SEED off the `.seen` cursor the drain/fold
#    use, so mail ALREADY pending when we arm fires IMMEDIATELY — the old `wc -l` arm-time baseline
#    missed exactly that line. But seed ONCE and then track a PRIVATE cursor: polling `.seen` live is
#    what let the drain starve this watcher (see the F-3 block above the main loop). On fire,
#    mailbox_take_from advances seen+acked without regressing them (our stdout rides the harness
#    task-completion notification → a reliable delivery the model reads). Lib absent → the standalone
#    grep -c '' fallback, which is arrival-based and therefore un-starvable too.
_bd="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
_mbxlib="$_bd/../hooks/lib/mailbox-pending.sh"
[ -f "$_mbxlib" ] || _mbxlib="$HOME/.claude/hooks/lib/mailbox-pending.sh"
_have_lib=0
if [ -f "$_mbxlib" ] && command -v jq >/dev/null 2>&1; then
  # mailbox_take_from is REQUIRED, not optional: it is what makes this watcher's trigger private (F-3
  # below). An older deployed lib without it degrades to the standalone line-count baseline — which is
  # arrival-based and therefore also un-starvable, merely blind to mail already pending at arm time —
  # rather than calling a function that does not exist.
  # shellcheck source=/dev/null
  . "$_mbxlib" 2>/dev/null && command -v mailbox_take_from >/dev/null 2>&1 && _have_lib=1
fi

# comms-alarm chokepoint lib. $0 is resolved THROUGH its symlinks first: ~/.claude/bin/cc-await-ping
# is a per-file symlink into the checkout, so a bare dirname "$0" finds only the DEPLOYED hooks/lib,
# which does not hold a brand-new tracked file until install.sh re-globs it.
_ca_self="$0"
while [ -L "$_ca_self" ]; do
  _ca_l="$(readlink "$_ca_self")"
  if [ "${_ca_l#/}" != "$_ca_l" ]; then _ca_self="$_ca_l"; else _ca_self="$(dirname "$_ca_self")/$_ca_l"; fi
done
_ca_root="$(cd "$(dirname "$_ca_self")/.." 2>/dev/null && pwd || true)"
for _ca_lib in "$_ca_root/hooks/lib/comms-alarm.sh" "$_bd/../hooks/lib/comms-alarm.sh" "$HOME/.claude/hooks/lib/comms-alarm.sh"; do
  if [ -f "$_ca_lib" ]; then
    # shellcheck source=/dev/null
    . "$_ca_lib" 2>/dev/null && command -v comms_alarm_write >/dev/null 2>&1 && break
  fi
done

MBOX="$MAILBOX_DIR/$CUR_UUID.md"
_lc() { if [ -f "$MBOX" ]; then grep -c '' "$MBOX" 2>/dev/null; else echo 0; fi; }   # grep -c '' — matches the lib (F1)
baseline="$(_lc)"
echo "cc-await-ping: watching $CUR_UUID inbox ($([ "$_have_lib" = 1 ] && echo 'private cursor, seeded from .seen' || echo "from line $baseline"); timeout ${TIMEOUT}s, every ${INTERVAL}s)" >&2

# Wake-path HEARTBEAT (critique F5): touch <uuid>.watching each poll so cc-notify/cc-announce can tell a
# live session that WILL be woken (a fresh watcher heartbeat) from a live-but-idle one that only drains on
# its next turn. Cleaned on exit. Works for uuid- AND role-watchers (both resolve to a concrete uuid).
#
# PROVEN WAKE (not merely a claimed one): the heartbeat now carries the WATCHER'S PID, so the claim it
# makes is FALSIFIABLE by its readers. An empty marker asserted "a watcher exists" and could only be
# checked for freshness — so a watcher killed by SIGKILL (no EXIT trap, marker left behind) kept earning
# "wake-path armed" for a full CC_WATCH_FRESH_S window, and cc-announce stamped VERIFIED on a wake that
# could not happen. Recording the pid lets cc-notify / mailbox-drain require it to be ALIVE. Format is
# one `pid=<n>` line; a legacy/empty marker still reads as armed-by-freshness, so nothing regresses.
#
# BEATEN UNDER EVERY KEY OF THE INBOX (2026-07-31), for the same reason the take below reads every
# key: the two hooks that ask "is this session armed?" ask about DIFFERENT keys — mailbox-drain.sh
# passes its session id (:170) and session-continue.sh passes the canonicalised key (:412) — so a
# single-key marker answers one of them and not the other, and the hook that misses re-nudges a
# session that is in fact armed. One marker per key makes the question key-agnostic.
_keys() {   # every physical key of this logical inbox (see the lib's mailbox_keyset)
  if [ "$_have_lib" = 1 ] && command -v mailbox_keyset >/dev/null 2>&1; then
    mailbox_keyset "$CUR_UUID" 2>/dev/null || printf '%s\n' "$CUR_UUID"
  else
    printf '%s\n' "$CUR_UUID"   # no lib ⇒ no alias to resolve ⇒ exactly the single-key behaviour
  fi
}
BEAT_KEYS="$CUR_UUID"
#
# ONE MARKER, MANY WATCHERS (backlog def25802babf, measured 2026-08-08). The marker is a SINGLE FILE
# per key with ONE owner slot, but a session may legitimately have TWO watchers armed on that key at
# once — the ordinary re-arm, where a fresh watcher is started near the term-end of the old one. The
# exiting one used to `rm` the key unconditionally, so a live sibling's heartbeat vanished and the
# "is this session armed?" hooks reported DEAF while a watcher was genuinely beating: watcher A timed
# out at 18:44 and cleared key …843 while B (pid 58128) was alive and re-stamping the marker every
# 15s. A false DEAF downgrades a real wake path in cc-notify / cc-announce for up to one full poll.
#
# WHY A pid==$$ GUARD ALONE IS NOT THE FIX — it is only the fallback layer below. Both watchers write
# the SAME file every poll, so at A's exit the slot holds whichever of them beat MOST RECENTLY, which
# is arbitrary. In the half of the overlaps where it holds A's pid, both readings are wrong: deleting
# blanks B's claim, and keeping leaves a marker naming a pid that is about to be DEAD — and
# mailbox_wake_armed reads a dead pid as NOT armed (that is the whole point of recording it). Either
# way the session reads deaf until B's next beat. The ownership question the slot cannot answer is
# "does another live watcher exist for this key?", so each watcher also stakes a per-pid CLAIM file
# and the exiting one HANDS THE SLOT OVER to a live claimant instead of deleting it.
#
# Claims are trusted only while FRESH (a live watcher re-stamps its claim every poll), on the same
# CC_WATCH_FRESH_S window its readers judge the marker by — so a stale claim cannot resurrect a
# marker its readers would already call dead, and a recycled pid cannot inherit a dead watcher's
# claim. A sibling running a version with no claim file still survives via the pid guard.
WATCH_CLAIM_DIR="$MAILBOX_DIR/.watchers"
_claim_live() {   # <key> → print the pid of a LIVE OTHER watcher beating this key; rc 1 = none
  local k="$1" c p mt now
  now="$(date +%s 2>/dev/null || echo 0)"
  for c in "$WATCH_CLAIM_DIR/$k".*; do
    [ -e "$c" ] || continue                       # unmatched glob expands to itself — never a claim
    p="${c##*.}"
    case "$p" in ''|*[!0-9]*) continue ;; esac
    [ "$p" = "$$" ] && continue                   # my own claim proves nothing about a survivor
    mt="$(stat -f %m "$c" 2>/dev/null || stat -c %Y "$c" 2>/dev/null || echo 0)"
    case "$mt" in ''|*[!0-9]*) mt=0 ;; esac
    if [ "$(( now - mt ))" -le "${CC_WATCH_FRESH_S:-90}" ] && kill -0 "$p" 2>/dev/null; then
      printf '%s\n' "$p"; return 0
    fi
    kill -0 "$p" 2>/dev/null || rm -f "$c" 2>/dev/null || true   # its watcher is gone: claims nothing
  done
  return 1
}
_beat() {
  local k
  BEAT_KEYS="$(_keys)"
  mkdir -p "$WATCH_CLAIM_DIR" 2>/dev/null || true
  for k in $BEAT_KEYS; do
    printf 'pid=%s\n' "$$" > "$MAILBOX_DIR/$k.watching" 2>/dev/null || true
    : > "$WATCH_CLAIM_DIR/$k.$$" 2>/dev/null || true
  done
}
# Clears exactly the markers this process still OWNS — never a key it merely resolved once, and never
# one a live sibling is maintaining. bash 3.2, default IFS: the unquoted expansion splits the
# newline-separated set (this file is #!/bin/bash, not zsh).
_unbeat() {
  local k sib owner
  for k in $BEAT_KEYS; do
    rm -f "$WATCH_CLAIM_DIR/$k.$$" 2>/dev/null || true
    if sib="$(_claim_live "$k")"; then
      # HAND OVER, do not delete: the survivor keeps the wake path, and the slot names a LIVE pid
      # immediately rather than after up to one of its poll intervals.
      printf 'pid=%s\n' "$sib" > "$MAILBOX_DIR/$k.watching" 2>/dev/null || true
      continue
    fi
    owner="$(sed -n 's/^pid=\([0-9][0-9]*\).*/\1/p' "$MAILBOX_DIR/$k.watching" 2>/dev/null | head -n1)"
    # No pid recorded ⇒ legacy/empty marker ⇒ unchanged behaviour (removed), exactly as before: an
    # empty marker still reads as armed-by-freshness, so leaving one behind would advertise a wake
    # path nobody provides — the stale claim this file's PROVEN WAKE note exists to prevent.
    if [ -n "$owner" ] && [ "$owner" != "$$" ] && kill -0 "$owner" 2>/dev/null; then continue; fi
    rm -f "$MAILBOX_DIR/$k.watching" 2>/dev/null || true
  done
}
trap '_unbeat' EXIT

# ── A KILLED WATCHER MUST NOT DIE SILENT (G10, backlog 5b77e20d9db6) ──────────────────────────────
# The EXIT trap above was the ONLY trap in this file, so an external SIGTERM ended the watch with no
# word at all: the wake path this session was relying on simply stopped existing, and the reader's
# whole account of it was the harness's `failed with exit code 143` / `144`.
#
# THIS DOES NOT PREVENT THE KILL, AND CANNOT. The sender is NOT recoverable from an exit code (see
# the header: 143 = this process alone was TERMed, 144 = the harness's sentinel for the process
# GROUP; an SA_SIGINFO recorder is the only thing that yields si_pid, and 144 proves only that the
# signal came from outside the harness). What it fixes is the SILENCE and the STALE CLAIM: the
# marker is cleared before dying, so a dead watcher stops advertising an armed wake path to
# cc-notify / mailbox-drain / cc-announce, and a `verdict=killed` line rides the stderr that the
# harness's task-completion notification actually carries — the same convention the timeout verdict
# at the foot of this file uses, and for the same reason.
#
# NOTE: backlog 5b77e20d9db6 reads 144 as 128+16 ⇒ SIGURG. That is WRONG on the signal (SIGURG's
# default action is IGNORE, so bash cannot die from it) though right in its conclusion that this is
# an external group-kill rather than a designed exit. Measured: `kill -TERM <inner pid>` → 143;
# `kill -TERM -<pgid>` → 144 with si_pid captured showing sig=15.
#
# Exits 128+signal deliberately: that is the number the harness already reports for the
# watcher-alone case, so the trap adds a verdict without inventing a code its readers must learn.
# Caveat kept honest — bash defers a trap until the current foreground command returns, so a TERM
# aimed at this process alone can be up to --interval seconds late. A group-TERM (the measured 144)
# also kills the `sleep`, so the trap fires promptly in exactly the case that produced the defect.
# shellcheck disable=SC2329  # invoked indirectly — the three `trap` lines below are its only callers.
_sig_verdict() {   # <signame> <signum>
  trap - TERM HUP INT EXIT
  _unbeat
  echo "cc-await-ping: verdict=killed signal=SIG$1 uuid=${CUR_UUID} — this watcher was TERMINATED from outside; it did NOT time out and no ping was consumed. The wake path for [$CUR_UUID] is now DOWN and its .watching marker has been cleared, so nothing is still claiming it. The sender is not recoverable from an exit code. If you are going idle, RE-ARM." >&2
  exit $(( 128 + $2 ))
}
trap '_sig_verdict TERM 15' TERM
trap '_sig_verdict HUP 1'   HUP
trap '_sig_verdict INT 2'   INT

# ── OWNER GUARD — a watcher must never outlive the session it wakes ───────────────────────────────
# MEASURED (2026-07-29): a watcher whose owner dies is reparented to pid 1 and keeps polling. When
# mail arrives it takes it with ack_now=1 — advancing BOTH cursors — and prints the body to a stdout
# no model will ever read. The line is then marked PROVABLY CONSUMED for a session that no longer
# exists: cc-inbox-guard sees unacked=0 and never alarms, a read receipt reports `read`, and the
# successor's SessionStart adoption (which migrates from .acked) inherits nothing. A silent loss
# wearing the costume of a successful delivery — the exact failure this whole channel exists to end,
# re-created by the thing that closes it. The wake floor arms EVERY session, so this went from a rare
# hand-armed case to the fleet default; the guard has to land with it.
#
# THE OWNER ORACLE IS THE REGISTRY PID, NOT $PPID. Reparenting is NOT evidence: a legitimate
# `run_in_background` arm has its launching shell exit immediately, so a healthy watcher's ppid
# becomes 1 exactly like an orphan's (verified 2026-07-29). Keying on that would disarm the entire
# fleet. The registry row is what cc-notify already treats as authoritative for the same question.
#
# THAT PREMISE HAS SINCE INVERTED — AND THE CONCLUSION SURVIVES ANYWAY. Re-measured 2026-08-07 on CC
# 2.1.220: 9 of 9 live watchers across the fleet had a LIVE `/bin/zsh -c source <snapshot>` parent, so
# a healthy watcher's ppid is now the wrapper, not 1. Both readings are dated and both were true when
# taken; what does not change is that ppid answers a question we are not asking. It was once a false
# POSITIVE for death (healthy watchers looked orphaned) and is now a false NEGATIVE (a genuinely
# orphaned watcher can keep a live wrapper), so the registry-pid oracle is right for a strictly
# stronger reason than when it was written. Left as a worked example of why a "(verified)" claim in a
# comment needs its date carried with it. See docs/research/await-ping-exit-144-2026-08-07.md §6.
#
# FAIL-SAFE DIRECTION: only a PRESENT row naming a DEAD pid proves death. No row (an unregistered
# pane is legitimate), an unreadable row, or a live pid → keep watching. So the guard can strand a
# watcher it cannot adjudicate, but it can never kill a live session's wake path — and an
# unadjudicable watcher is still bounded by --timeout, which is the case that was always true.
#
# ── A CACHED PID IS NOT ENOUGH: EXIT 5 NOW NEEDS A SECOND, INDEPENDENT ORACLE (G10, 2026-08-08) ───
# MEASURED (backlog a116d60af388): this guard exited 5 announcing pane 700 was GONE while pane 700
# was demonstrably alive and typing. The pane id had been renumbered underneath the registry, so
# `<uuid>.json` named a pid that really was dead while the session it addressed was not — and a
# sibling `handoff-fire self-close` saw the SAME cwd under a DIFFERENT pane id. Nothing about the
# fail-safe direction above was wrong; the fault is that ONE cached field carried a verdict this
# destructive on its own. Exit 5 abandons a live session's wake path and leaves it deaf.
#
# So the pid oracle is now necessary and NOT sufficient. Once it fires, a corroborator must
# independently agree, and it must not be a second reader of the same row — that would prove nothing
# beyond what the first read already said. Two are consulted, in order:
#
#   B1  PANE LIVENESS — is $CUR_UUID in `it2 session list --json`? iTerm2's OWN answer about its own
#       panes, which touches the registry not at all. Catches the in-place case: the pane is right
#       there and only the recorded pid has been superseded.
#   B2  CWD OCCUPANCY — is the row's cwd held by a LIVE pid in a DIFFERENT registry row? That is the
#       renumbering signature the incident actually recorded, and it is the case B1 cannot see:
#       when the id itself changed, the old id is genuinely absent from iTerm2 while the session
#       that owned it is alive under the new one. Different field, different rows, different pids.
#
# FAIL-CLOSED ON UNKNOWN, exactly as cc-reconcile's prune is (:258): a transport that cannot answer
# means pane liveness is UNKNOWN, never "every pane is gone". So where it2 is absent or wedged, exit
# 5 becomes unreachable and the watcher falls back to being bounded by --timeout — the same
# unadjudicable-but-safe state the paragraph above already accepted. This change only ever makes
# exit 5 HARDER to reach; there is no input for which it now fires and previously did not.
#
# COST: the corroborators run ONLY after the pid oracle has fired, which is rare — and a veto is
# remembered for CC_AWAIT_OWNER_RECHECK_S so a permanently-stale row cannot turn a 15s poll into a
# 15s it2 IPC loop. The it2 call is wall-clock bounded for the reason cc-reconcile bounds its own:
# on the 2026-07-26 machine-wide wedge a bare `it2 session list --json` returned rc 124 with zero
# output while blocked forks piled up across ~110 sessions.
REG_DIR="${CC_REGISTRY_DIR:-$HOME/.claude/cc-registry}"
# `${VAR-}` not `${VAR:-}`: set-but-EMPTY means "no pane transport" and is honored verbatim, so a
# test can run the UNKNOWN branch. A test that cannot turn the transport off cannot prove the
# fail-closed direction differs from the confirming one.
IT2_BIN="${CC_AWAIT_IT2_BIN-$HOME/.claude/bin/it2}"
IT2_TIMEOUT_S="${CC_AWAIT_IT2_TIMEOUT_S:-5}"
OWNER_RECHECK_S="${CC_AWAIT_OWNER_RECHECK_S:-120}"
_TO_BIN=""
for _c in "$(command -v timeout 2>/dev/null || true)" "$(command -v gtimeout 2>/dev/null || true)" \
          /opt/homebrew/bin/timeout /usr/local/bin/timeout \
          /opt/homebrew/bin/gtimeout /usr/local/bin/gtimeout; do
  [ -n "$_c" ] && [ -x "$_c" ] && { _TO_BIN="$_c"; break; }
done
unset _c

_it2_panes() {   # echo the live pane-id set; rc 1 = the transport could not answer (UNKNOWN)
  [ -n "$IT2_BIN" ] && [ -x "$IT2_BIN" ] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  local out ids
  if [ -n "$_TO_BIN" ]; then out="$("$_TO_BIN" -k 3 "$IT2_TIMEOUT_S" "$IT2_BIN" session list --json 2>/dev/null)"
  else                       out="$("$IT2_BIN" session list --json 2>/dev/null)"; fi
  [ -n "$out" ] || return 1
  ids="$(printf '%s' "$out" | jq -r 'if type=="array" then .[].id // empty else empty end' 2>/dev/null)"
  [ -n "$ids" ] || return 1
  printf '%s\n' "$ids"
}

_pane_gone() {   # 0 = CONFIRMED absent · 1 = PRESENT (alive) · 2 = cannot answer (UNKNOWN)
  local ids
  ids="$(_it2_panes)" || return 2
  printf '%s\n' "$ids" | grep -qxF "$CUR_UUID" && return 1
  return 0
}

_cwd_occupied() {  # 0 iff the row's cwd is held by a LIVE pid in some OTHER registry row
  local rf="$REG_DIR/$CUR_UUID.json" cwd f p
  command -v jq >/dev/null 2>&1 || return 1
  cwd="$(jq -r '.cwd // empty' "$rf" 2>/dev/null)"
  [ -n "$cwd" ] || return 1
  for f in "$REG_DIR"/*.json; do
    [ -e "$f" ] || continue
    [ "$f" = "$rf" ] && continue
    [ "$(jq -r '.cwd // empty' "$f" 2>/dev/null)" = "$cwd" ] || continue
    p="$(jq -r '.pid // empty' "$f" 2>/dev/null)"
    case "$p" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$p" 2>/dev/null && return 0
  done
  return 1
}

_corrob_ok_until=0
_veto() {  # remember an ALIVE corroboration, say it once per window, and keep watching
  local now; now="$(date +%s 2>/dev/null || echo 0)"
  _corrob_ok_until=$(( now + OWNER_RECHECK_S ))
  echo "cc-await-ping: registry pid for [$CUR_UUID] is dead, but $1 — NOT exiting 5, still watching (re-checking in ${OWNER_RECHECK_S}s)" >&2
  return 1
}

_owner_dead() {  # 0 iff the watched pane is PROVABLY gone — pid oracle AND an independent corroborator
  local rf="$REG_DIR/$CUR_UUID.json" p now pg
  [ -f "$rf" ] || return 1
  p="$(jq -r '.pid // empty' "$rf" 2>/dev/null)"
  case "$p" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$p" 2>/dev/null && return 1
  # ORACLE A has fired. It is necessary, not sufficient — corroborate or keep watching.
  now="$(date +%s 2>/dev/null || echo 0)"
  [ "$now" -lt "$_corrob_ok_until" ] && return 1        # a recent corroborator said ALIVE; don't re-ask
  _pane_gone; pg=$?
  case "$pg" in
    1) _veto "iTerm2 still lists that pane as LIVE (a superseded pid, not a dead session)"; return $? ;;
    2) _veto "pane liveness is UNKNOWN (no readable it2 transport) — an unreadable transport is not 'every pane is gone'"; return $? ;;
  esac
  if _cwd_occupied; then
    _veto "its cwd is held by a LIVE session under a DIFFERENT pane id (the id was renumbered underneath the registry — a116d60af388)"
    return $?
  fi
  return 0
}

# ── F-3: THE TRIGGER IS PRIVATE, BECAUSE A SHARED CURSOR IS A STARVABLE ONE ───────────────────────
# MEASURED 2026-08-09 (docs/plans/TWO_WAY_SESSION_COMMS_PLAN.md § F-3). This watcher used to poll
# `mailbox_has_pending`, i.e. `lines - .seen`, and hooks/mailbox-drain.sh advances that SAME `.seen`
# on every delivery (its :13). So the two consumers raced for one cursor and whichever ran first
# starved the other. A peer executed the protocol perfectly — landed content-verified, pinged, then
# self-closed — the drain surfaced the ping at a UserPromptSubmit and advanced `.seen` past it, and
# the lead's armed watcher then polled an empty delta forever: `886.seen=3`, `886.acked=3`, 3 lines,
# alive and armed and permanently silent. It would have waited 4 hours for a ping already delivered.
#
# WHY "THE DRAIN ALREADY DELIVERED IT" IS NOT A FIX, and why this is not paranoia about a dup: a
# delivered message and a woken reader are DIFFERENT EVENTS. The drain's delivery is passive context
# inside an already-running turn; this watcher's delivery is an event that re-invokes an IDLE lead. A
# lead that goes idle after a drain-consumed ping is unreachable by both paths at once — the drain has
# nothing left to emit and the watcher has nothing left to see. That is the forever-hang.
#
# REJECTED ALTERNATIVES, both weaker than a private cursor:
#   • poll `.acked` instead — refuted by the post-mortem's own numbers: `.acked` was ALSO at EOF (3 of
#     3), so this watcher would have been equally deaf. It swaps coupling-to-the-drain for
#     coupling-to-the-Stop-fold rather than removing the coupling.
#   • have the drain signal a live `.watching` watcher — the drain only ever runs INSIDE the lead's own
#     session, so if it ran the lead is by definition already awake; and it buys a pid-signalling path
#     (with a recycled-pid hazard) to do what needs no IPC at all.
#
# So the watcher keeps its OWN cursor, seeded from `.seen` the first time it sees a key, and thereafter
# advanced only by ITS OWN takes. The seed is what preserves F6a (mail already pending when we arm
# still fires immediately); the privacy is what makes the drain unable to starve us. Dup-biased in the
# same direction the drain declares for itself: a duplicate wake is cheap, a lost wake is a 4-hour hang.
#
# bash 3.2 (macOS /bin/bash) has no associative arrays, so this is a newline-delimited "<key> <cursor>"
# string with a linear scan. The set is at most a couple of keys (lib → mailbox_keyset) and a mailbox
# key is validated to [A-Za-z0-9._-], so a space is an unambiguous separator. `while … done <<HEREDOC`
# does NOT subshell in bash, so _woke_set really does mutate the caller's WOKE_MAP.
WOKE_MAP=""
_woke_get() {   # <key> → print its cursor on stdout; rc 1 = not yet seeded
  local k="$1" line
  while IFS= read -r line; do
    case "$line" in "$k "*) printf '%s' "${line#* }"; return 0 ;; esac
  done <<WOKEEOF
$WOKE_MAP
WOKEEOF
  return 1
}
_woke_set() {   # <key> <cursor>
  local k="$1" v="$2" line out=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in "$k "*) continue ;; esac
    out="$out$line
"
  done <<WOKEEOF
$WOKE_MAP
WOKEEOF
  WOKE_MAP="$out$k $v"
}

elapsed=0
while [ "$elapsed" -lt "$TIMEOUT" ]; do
  next_uuid="$(resolve_uuid)"
  if [ -n "$next_uuid" ] && [ "$next_uuid" != "$CUR_UUID" ]; then
    _unbeat
    CUR_UUID="$next_uuid"; MBOX="$MAILBOX_DIR/$CUR_UUID.md"; baseline="$(_lc)"
    # A re-pointed role is a DIFFERENT logical inbox: drop the private cursors so the new key set
    # re-seeds from its own .seen on the next poll (same first-poll behaviour as a fresh arm).
    WOKE_MAP=""
    echo "cc-await-ping: role re-pointed → now watching $CUR_UUID" >&2
  fi
  mkdir -p "$MAILBOX_DIR" 2>/dev/null || true; _beat                                     # heartbeat

  # BEFORE any take: consuming is irreversible, so the orphan check has to gate it, not follow it.
  if _owner_dead; then
    echo "cc-await-ping: the session that armed me [$CUR_UUID] is GONE (registry pid dead) — exiting WITHOUT consuming its mail, so the lines stay unacked for cc-inbox-guard to alarm on and for the successor's adoption to inherit" >&2
    exit 5
  fi

  if [ "$_have_lib" = 1 ]; then
    # FIRST key of the set that has anything — not just our own. cc-notify writes the PANE box while
    # the drain reads the SESSION box (lib → mailbox_keyset), so checking one key is how a watcher
    # ends up deaf to a delivery sitting one filename away.
    _HIT=""; _FROM=0
    for _k in $(_keys); do
      # Seed this key's PRIVATE cursor from .seen the first time we see it — that is the F6a
      # behaviour (already-pending mail fires at once) and it is the ONLY time .seen is consulted.
      if ! _woke_get "$_k" >/dev/null 2>&1; then _woke_set "$_k" "$(mailbox_seen "$_k")"; fi
      _w="$(_woke_get "$_k")"; case "$_w" in ''|*[!0-9]*) _w=0 ;; esac
      if [ "$(mailbox_lines "$_k")" -gt "$_w" ]; then _HIT="$_k"; _FROM="$_w"; break; fi
    done
    if [ -n "$_HIT" ]; then
      # Window opens at OUR cursor, never at .seen — so a drain that already advanced .seen past this
      # line cannot turn our fire into an empty print (which is exactly what F-3 was).
      mailbox_take_from "$_HIT" "$_FROM" 1
      _trc=$?
      _woke_set "$_HIT" "$(mailbox_lines "$_HIT")"
      # F9: rc 2 = the body WAS printed but the cursor write FAILED — "the caller must escalate + still
      # deliver, never silently drop". This caller used to exit 0 regardless, so the lib's one escalation
      # contract had no honorer: a broken cursor looked exactly like a clean take. Deliver, alarm, exit loud.
      if [ "$_trc" = 2 ]; then
        # Through the comms-alarm chokepoint (stamps test_origin, diverts a fixture-context write out
        # of the operator's live root — see hooks/lib/comms-alarm.sh). Lib absent → the original
        # inline write, so this backstop never gets weaker than before the chokepoint existed.
        if command -v jq >/dev/null 2>&1; then
          _ca_rec="$(jq -nc --arg u "$_HIT" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" \
            '{kind:"cursor-write-failed", uuid:$u, actor:"cc-await-ping", reason:"mailbox_take delivered the body but could not advance .seen — the same mail will be re-delivered (dup, not loss); the guard cannot key on a cursor that is not moving", ts:$ts}' 2>/dev/null)"
          if command -v comms_alarm_write >/dev/null 2>&1; then
            comms_alarm_write cursor-fail "$_ca_rec" || true
          else
            _adir="${CC_COMMS_ALARM_DIR:-$HOME/.claude/autonomy/comms-alarms}"
            if mkdir -p "$_adir" 2>/dev/null; then
              printf '%s\n' "$_ca_rec" \
                > "$_adir/cursor-fail-$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null)-$$-${RANDOM}.json" 2>/dev/null || true
            fi
          fi
        fi
        echo "cc-await-ping: ⚠ delivered, but the shared cursor could NOT be advanced for $_HIT — you will see this mail again (a dup, never a loss); alarm recorded" >&2
        exit 4
      fi
      exit 0
    fi
  else
    cur="$(_lc)"
    if [ "$cur" -gt "$baseline" ]; then tail -n +"$((baseline + 1))" "$MBOX"; exit 0; fi
  fi
  sleep "$INTERVAL"
  elapsed=$((elapsed + INTERVAL))
done

# ── THE TIMEOUT IS A VERDICT, NOT A FAULT — SAY SO IN THE STREAM THAT SURVIVES ──────────────────
# rc 2 here means "the full watch elapsed with no ping", which is the NORMAL end of a healthy 14400 s
# arm. Its READER cannot tell: the Claude Code background-task classifier is `isError: exitCode !== 0`
# with a hardcoded per-basename exemption table compiled into the binary (grep's rc 1 is in it; there
# is no user-extensible entry), so the harness renders this as `failed with exit code 2` / status
# `failed` / telemetry `task_local_shell_failed`. A model re-invoked by that notification has triaged
# a clean timeout as a fault. We cannot change the classifier — but the notification carries STDERR
# (stdout is dropped; docs/research/mechanical-wake-asyncrewake-2026-07-29.md), so the discrimination
# can ride the stream the reader actually gets. Same `verdict=<token>` convention cc-notify (:294) and
# cc-announce use for exactly this reason: the exit code is for shells, the token is for readers.
#
# NOT remapped to exit 0. rc 2 is load-bearing for cc-wait (:138 branches on it) and is already
# overloaded with the usage errors at :46-52 — collapsing it would invert a contract and lose a
# distinction, to satisfy a classifier that would still be wrong about rc 3/4/5.
echo "cc-await-ping: verdict=timeout elapsed=${TIMEOUT}s uuid=${CUR_UUID} — no ping arrived. This is the DESIGNED outcome of a watch that ran its full term, not a failure: exit 2 here means 'nothing came', and the harness labels every non-zero exit 'failed'. Nothing is wrong and nothing needs debugging — if you are still going idle, RE-ARM (the watcher clears its own heartbeat on exit, so you are deaf until you do)." >&2
exit 2
