#!/usr/bin/env bash
# cc-lr — ONE command for the limit-recovery surface: find · recover · status · repair.
# (LIMIT_RECOVER_100P W5-D, from D2 §1.2/§4 C1. This front end COMPOSES the shipped tools; it
# re-implements none of them.)
#
# WHY A FRONT END AND NOT A FIFTH ACTUATOR. Measured 2026-09-19 (U11 §2), recovering five sessions
# cost 98.7 minutes of which 24.4 were the LEAD's own foreground polling. The parts that do the
# work were already correct and already fast — `cc-find` resolves a session in 0.18 s, `lr-fleet.sh
# --one … --detach` returns in ≤3 s and mails its verdict. What was missing was a surface that puts
# them in one order, and three REFUSALS that live nowhere else:
#
#   RULE 0 — a TEAMMATE is never a recovery target. cc-find already CLASSES one (column 7) and
#   excludes it from every ranked result, but `lr-fleet.sh --one <sid>` has NO teammate guard at
#   all: handed a teammate's sid directly it will recover it. Verified 2026-09-20 on the tree — the
#   only precondition `--one` checks is "already TRANSPLANTED" (lr-fleet.sh:800-803, :828).
#   RULE 1 — an AMBIGUOUS ref is refused, never resolved by coin flip (cc-find's rc 2 is the fact;
#   this tool's job is to STOP on it rather than pass the first row down).
#   RULE 2 — a session that is not actually LIMITED is not recovered. `--one` does not check.
#
# None of the three is enforced downstream, so they are enforced HERE, and each refuses with rc 2
# BEFORE any mutex is created — a refusal that leaves a lock behind is a refusal that blocks the
# next correct attempt.
#
# WHAT THIS TOOL MAY NEVER DO. It is reached from a screenshot, i.e. from the one moment an
# operator can least audit what happens next (the same argument tests/cc-lr.bats:270-276 makes for
# cc-find). It never types into a pane, never kills a process, and never touches git. `repair`
# WRITES A REQUEST and kicks the daemon; the daemon is the only thing that acts. The one exception
# to "no launchctl" is `kickstart` with NO `-k`, which starts an idle job and leaves a running one
# alone — never `load`/`unload`/`bootout`/`bootstrap`. tests/cc-lr-front.bats ratchets all of it.
#
#   cc-lr find <ref…>                 exec into bin/cc-find, verbatim argv
#   cc-lr recover <ref> [--target A] [--source-pane P]
#   cc-lr switch [--target A|auto] [--dry-run]
#                                     move THIS pane's session to another account, in place
#   cc-lr switch (--pane P | --sid S | --from A --all-idle) --target A [--dry-run] [--wait S|--no-wait]
#                [--until-idle S]     ask ANOTHER idle session to move itself (the driver form);
#                                     --until-idle waits out a busy one for up to S seconds (default off)
#   cc-lr status [ref | --all]
#   cc-lr status --cohort [cid]       the reconciler's cohorts, one line per member
#   cc-lr repair <bundle|ref> [--mode relaunch|prompt] [--target A] [--source-pane P]
#   cc-lr repair-markers [--sid S] [--dry-run]
#                                     set aside STALE handoff markers (via the drainer; never renames itself)
#   cc-lr upgrade (--all | <pane|sid8>) [--dry-run] [--wait S | --no-wait] · cc-lr upgrade --report
#   cc-lr accounts --limited          the reconciler's unexpired limit facts, grouped by account
#   cc-lr cohort refire <sid|sid8|pane>
#                                     ask the reconciler to reset one member's retry budget
#
# WHILE THE RECONCILER IS LIVE (recon.on + a fresh heartbeat), `recover` and `switch` do not act:
# they write requests/<sid>.cc-lr.json and the reconciler — the one actuator for that sid — drives
# it (LIMIT_RECOVER_FLEET_V2 §C2, §C10).
#
# rc 0 ok · 1 nothing matched · 2 REFUSED (and nothing was created) · 3 usage
set -uo pipefail

# ── the store ──────────────────────────────────────────────────────────────────────────────────
# `${LR_STATE_DIR:-…}` is the spelling lr-fleet.sh:69, lr-fire-resume.sh:244, lr-lib.sh:511 and
# bin/cc-limited:88 all use, so it is the one honoured here. TWO CONSUMERS DISAGREE WITH IT and the
# divergence is real, not a bug this file may fix (both are outside this wave's file set):
# lr-handoff.sh:479 mints `$HOME/.reso/limit-recover/$SID/bundle-$TS` and lr-reset-poller.sh:127
# sets `STATE="$HOME/.reso/limit-recover"`, both hardcoded. So under a NON-default LR_STATE_DIR the
# bundles and the request lane are written where this tool does not look. Stated rather than
# papered over: a front end that silently scanned two roots would hide a split store.
STATE="${LR_STATE_DIR:-$HOME/.reso/limit-recover}"
MUTEX_DIR="$STATE/runs/by-sid"
REQ_DIR="$STATE/requests"
POLLER_LABEL="${CC_LR_POLLER_LABEL:-com.reso.lr-reset-poller}"

# ── who we are, and the siblings we call ───────────────────────────────────────────────────────
# READLINK FIRST. `~/.claude/bin/cc-lr` is a PER-FILE symlink into the checkout, so a `$0`-relative
# sibling lookup that skips readlink resolves against the LINK's directory and finds nothing (the
# shape bin/cc-find:60-61 already uses, and the repo lesson symlinked-$0-splits-sibling-sources).
_CL_SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
_CL_BIN="$(cd "$(dirname "$_CL_SELF")" && pwd)"
FIND_BIN="${CC_LR_FIND_BIN:-$_CL_BIN/cc-find}"
FLEET_BIN="${CC_LR_FLEET_BIN:-}"
if [ -z "$FLEET_BIN" ]; then
  for _cl_f in "$_CL_BIN/../scripts/limit-recover/lr-fleet.sh" \
               "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/limit-recover/lr-fleet.sh" \
               "$HOME/.claude/scripts/limit-recover/lr-fleet.sh"; do
    [ -f "$_cl_f" ] && { FLEET_BIN="$_cl_f"; break; }
  done
fi
# `switch` calls lr-handoff.sh DIRECTLY, not lr-fleet.sh, and that is the mirror of the note above
# cmd_switch: lr-fleet is the DETACHED fleet driver whose whole shape is "the subject cannot act".
# A voluntary switch is foreground and self-driven, so it composes the one tool that does the move.
HANDOFF_BIN="${CC_LR_HANDOFF_BIN:-}"
if [ -z "$HANDOFF_BIN" ]; then
  for _cl_h in "$_CL_BIN/../scripts/limit-recover/lr-handoff.sh" \
               "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/limit-recover/lr-handoff.sh" \
               "$HOME/.claude/scripts/limit-recover/lr-handoff.sh"; do
    [ -f "$_cl_h" ] && { HANDOFF_BIN="$_cl_h"; break; }
  done
fi
# `upgrade` composes lr-upgrade.sh for its read-only census, and hands the ACT to the poller.
UPGRADE_BIN="${CC_LR_UPGRADE_BIN:-}"
if [ -z "$UPGRADE_BIN" ]; then
  for _cl_u in "$_CL_BIN/../scripts/limit-recover/lr-upgrade.sh" \
               "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/limit-recover/lr-upgrade.sh" \
               "$HOME/.claude/scripts/limit-recover/lr-upgrade.sh"; do
    [ -f "$_cl_u" ] && { UPGRADE_BIN="$_cl_u"; break; }
  done
fi
# The account map, for the `from=` field of a verdict line and NOTHING else. OPTIONAL and
# fail-quiet: an unreachable map degrades `from=` to the config dir's basename, which is still a
# true statement about where the session lives — it is never allowed to refuse a switch.
for _cl_am in "${CC_ACCOUNT_MAP:-}" "$_CL_BIN/../lib/account-map.generated.sh" \
              "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/lib/account-map.generated.sh" \
              "$HOME/.claude/lib/account-map.generated.sh"; do
  # shellcheck disable=SC1090  # runtime-resolved library ladder, same shape as the two below
  [ -n "$_cl_am" ] && [ -f "$_cl_am" ] && { . "$_cl_am" 2>/dev/null || true; break; }
done

# lr-lib.sh is OPTIONAL here and is loaded for exactly one function: `lr_state_current`, the
# SSOT spelling of "the last recorded state of a run". It is the per-file FALLBACK of the status
# reader below — the fast path is one bulk jq, because one fork per bundle blows the 0.1 s budget
# at 20 bundles. Re-deriving the predicate instead of calling it is how two readers of one store
# end up disagreeing (repo lesson: sibling-auditors-must-share-the-state-model).
for _cl_lib in "$_CL_BIN/../scripts/limit-recover/lr-lib.sh" \
               "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/limit-recover/lr-lib.sh" \
               "$HOME/.claude/scripts/limit-recover/lr-lib.sh"; do
  # shellcheck disable=SC1090  # runtime-resolved library ladder, same shape as cc-find:62-68
  [ -f "$_cl_lib" ] && { . "$_cl_lib"; break; }
done

# THE §C10 FENCE. It answers two questions this file asks: is the reconciler live (then queue, never
# act), and — when it is not — does it still own this sid through a process it started (then
# refuse). Unreachable ⇒ the legacy world keeps working: never live, always act, one line at the act.
for _cl_fence in "$_CL_BIN/../scripts/limit-recover/lr-recon-fence.sh" \
                 "$HOME/.claude/scripts/limit-recover/lr-recon-fence.sh"; do
  # shellcheck disable=SC1090  # runtime-resolved library ladder, same shape as the one above
  [ -f "$_cl_fence" ] && { . "$_cl_fence"; break; }
done
command -v lr_recon_may_act >/dev/null 2>&1 || {
  lr_recon_live() { return 1; }
  lr_recon_may_act() { echo "cc-lr: lr-recon-fence.sh unreachable — acting on ${1:0:8} unfenced (legacy)" >&2; return 0; }
  lr_recon_act_done() { :; }
}
# The reconciler's own tree: the same default lr-recon-fence.sh and lr_recon.types.Paths derive.
RECON_ROOT="${LR_RECON_ROOT:-$STATE/recon}"

usage() {
  cat >&2 <<'USAGE'
cc-lr — find · recover · status · repair, for a limit-blocked session.

  cc-lr find <ref…>          exec bin/cc-find (pane id | sid8 | --tuple | --kw | --limited)
  cc-lr recover <ref> [--target A] [--source-pane P]
                             refuse a teammate / an ambiguous ref / a non-limited session,
                             else take the mutex and fire lr-fleet --one … --detach
  cc-lr recover --limited [--account next|next2|next3|next4] [--target A]
                             every LIMITED session (optionally one account's), each through
                             the single-ref path above, so each keeps its own refusals. With
                             --account, when that account is at a 5-hour or weekly cap, also
                             queues its IDLE sessions (the `switch --from A --all-idle` census)
                             for --target, or the best other account when auto
  cc-lr switch [--target A|auto] [--dry-run]
                             move THIS pane's session to another account, in place: same
                             window, same uuid, new account. SELF only — no ref, no
                             --source-pane, no --detach; foreground. `auto` picks the
                             soonest-resetting account that is safe on BOTH the 5-hour and
                             weekly limits, never this one; if none is safe it stays put
                             (verdict=NOTMOVED, rc 1).
  cc-lr switch (--pane P | --sid S | --from A --all-idle) --target A [--dry-run] [--wait S | --no-wait]
                             the DRIVER form: move ANOTHER idle session. Judged by lr-upgrade's idle
                             oracle (--dry-run: one row per candidate + disposition); each `move`
                             row becomes a poller request, re-judged at drain time, and the idle
                             subject is asked — marked [operator-ruling cc-lr-switch] — to run the
                             SELF verb itself. Verdict: the registry flip (SWITCHED · NOTMOVED ·
                             FAILED), also mailed. An explicit --target is required. A target the
                             router does not rank is refused before anything is queued.
                             --until-idle S: a BUSY subject (mid-turn, subagents, background job,
                             composer) is queued too and re-judged every poller tick until it is
                             idle or S seconds pass; the verdict is mailed. Default off.
  cc-lr status [ref|--all]   one row per run's events.jsonl, with CAUSE / NEXT
  cc-lr status --cohort [cid] [--root DIR]
                             the reconciler's cohorts: the DoD line, then per member the phase, age, attempt,
                             last error class, next action and ETA
  cc-lr accounts --limited   the reconciler's unexpired limit facts, grouped by account
  cc-lr cohort refire <sid|sid8|pane>
                             ask the reconciler to reset one member's retry budget (writes a
                             ctl request; the daemon acts on it)
  While the reconciler is live, recover and switch QUEUE a request for it instead of acting.
  cc-lr repair <bundle|ref> [--mode relaunch|prompt] [--target A] [--source-pane P]
                             write a poller request and kick the daemon — NEVER types
  cc-lr repair-markers [--sid S] [--dry-run]
                             a store holding a session's LIVE transcript beside an OLDER handoff
                             marker pointing away, while the other store's NEWER marker points
                             back, blocks every prompt there (handed-off-session-guard). Prints
                             STALE/KEEP per marker; without --dry-run queues one drainer request per
                             STALE sid (the drainer re-judges, then renames to .stale-<ts>, never
                             deletes) and waits for each verdict (CC_LR_MARKERS_WAIT_S, default 120)
  cc-lr upgrade (--all | <pane|sid8>) [--dry-run] [--wait S | --no-wait] [--scrub-composer TEXT]
  cc-lr upgrade --report     move IDLE live sessions onto the current binary + model, in place
                             (same pane, uuid, account, effort). --dry-run prints one row per
                             live session and changes nothing; otherwise one request per
                             candidate goes to the poller, which relaunches them ONE AT A TIME
                             and re-checks each first. An Agent Team moves TEAMMATES FIRST
                             (identity flags kept), then its lead (team dir held across the
                             exit, adopted on relaunch). Never: a session mid-turn, in-flight
                             subagents, a real background job, a non-empty composer, a
                             duplicate row. Fable stays Fable (binary-only move).

rc 0 ok · 1 no match (upgrade: ≥1 failed) · 2 REFUSED (nothing created) · 3 usage
USAGE
}

cl_die() { echo "cc-lr: $1" >&2; exit "${2:-2}"; }

# ── the reconciler's request lane (§C2 origin `cc-lr`) ─────────────────────────────────────────
# While the reconciler is live it is the ONE actuator for every sid it can see, so a direct
# recover/switch here would be a second typer racing it into one pane. The request carries what the
# direct path would have acted on; the reconciler re-judges it at ingest. tmp is a dotfile that does
# not end in .cc-lr.json, so neither drainer can read it half-written.
cl_recon_queue() { # <sid> <mode> <pane> <config_dir> [target] → rc 0 queued (dies rc 2 otherwise)
  local sid="$1" mode="$2" pane="$3" cfg="$4" target="${5:-}" dest tmp
  case "$pane" in -) pane="" ;; esac
  command -v jq >/dev/null 2>&1 || cl_die "the reconciler is live but jq is not on PATH, so nothing was queued and nothing was started" 2
  mkdir -p "$REQ_DIR" 2>/dev/null || cl_die "cannot create $REQ_DIR; nothing was queued and nothing was started" 2
  dest="$REQ_DIR/$sid.cc-lr.json"
  tmp="$REQ_DIR/.$sid.cc-lr.$$.tmp"
  if jq -nc --arg sid "$sid" --argjson at "$(date +%s)" --arg mode "$mode" --arg pane "$pane" \
        --arg cfg "$cfg" --arg target "$target" \
        '{sid:$sid, at:$at, requested_by:"cc-lr", mode:$mode, pane:$pane, config_dir:$cfg}
         + (if $target != "" then {target:$target} else {} end)' > "$tmp" 2>/dev/null \
     && mv -f "$tmp" "$dest" 2>/dev/null; then
    printf 'cc-lr: QUEUED for the reconciler %s → %s\n' "${sid:0:8}" "$dest"
    return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  cl_die "the reconciler is live but $dest could not be written; nothing was queued and nothing was started" 2
}

# The direct path's fence. Not live, but the reconciler may still own the sid through a process it
# started (a relaunch mid-flight): acting now would put two actuators in one pane. On ACT the launch
# lock this may take is exported as LR_LAUNCH_LOCK — lr-fleet's lf_one and lr-handoff inherit it —
# and released by the EXIT trap on every exit path, the subshells of `recover --limited` included.
# The fence's own lines carry a `verdict=` token, and this file's consumers grep `verdict=` for
# cc-lr's OWN outcome; so they go to a scratch file (never `$( )`, which would drop the exported
# lock with the subshell) and only a refusal quotes the reason from them.
cl_fence_or_refuse() { # <sid> → returns on ACT; exits 2 on DEFER
  local errf why="" rc=0
  errf="$(mktemp "${TMPDIR:-/tmp}/cc-lr-fence.XXXXXX" 2>/dev/null)" || errf=/dev/null
  lr_recon_may_act "$1" cc-lr 2>"$errf" || rc=$?
  if [ "$errf" != /dev/null ]; then
    why="$(sed -nE 's/.*reason=([^ ]+).*/\1/p; s/.*gate=defer.* lock=(held|cannot).*/launch-lock-\1/p' "$errf" | tr '\n' ' ')"
    grep -v 'lr-recon-fence: ' "$errf" >&2
    rm -f "$errf"
  fi
  if [ "$rc" -ne 0 ]; then
    echo "cc-lr: REFUSED — the reconciler still owns ${1:0:8} (${why% }): a process it started for this session is alive, or another actuator holds its launch lock. Nothing was started and no mutex was created." >&2
    exit 2
  fi
  trap 'lr_recon_act_done' EXIT
}

# THE REQUESTER, ratcheted. CC_PANE_ID FIRST and ITERM_SESSION_ID only as the fallback — copied
# from lr-fleet.sh:757-762, whose class-B cases name the failure: a STALE ITERM_SESSION_ID can sit
# beside a live CC_PANE_ID after a transplant, and preferring the stale one addresses the WRONG
# pane. The `##*:` strip is safe for either; a bare CC_PANE_ID carries no colon and survives it.
cl_this_pane() {
  local p
  p="${CC_PANE_ID:-${ITERM_SESSION_ID:-}}"
  p="${p##*:}"
  [ -n "$p" ] || p="${KITTY_WINDOW_ID:-}"
  printf '%s' "$p"
}

# ── the mutex: one actuator per session ────────────────────────────────────────────────────────
# ONE implementation, lr-lib.sh's lr_claim_take (D2, 2026-09-28) — shared with lr-fleet's pool and
# the reset poller, which each carried their own copy and disagreed about a claim with no holder
# file: this one waited out a 1800 s TTL on it, and on 2026-09-28 that refused a retry for a claim
# the poller had left behind a dead driver. The rules now live in lr-lib.sh and read:
#   holder pid ALIVE → REFUSE · holder pid DEAD → steal at once, loudly · no holder → steal once
#   no live recovery process names the sid (past a 10 s stamp window), never on a clock.
cl_mutex_take() { # <sid> <pane> → 0 taken (path on stdout), 2 refused
  command -v lr_claim_take >/dev/null 2>&1 || {
    echo "cc-lr: REFUSED — lr-lib.sh (lr_claim_take) is unreachable, so the one-actuator mutex cannot be taken. Nothing was started." >&2
    return 2; }
  local out rc=0
  out="$(lr_claim_take "$MUTEX_DIR" "$1" cc-lr "$2" "$$")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "cc-lr: REFUSED — ${1:0:8} is held by another recovery (mutex $MUTEX_DIR/$1.active). One actuator per session; nothing was started." >&2
    return 2
  fi
  printf '%s' "$out"
}

# ── resolve a ref to ONE session row, or refuse ────────────────────────────────────────────────
# cc-find is the resolver and its rc IS the verdict: 2 is AMBIGUOUS with every candidate printed,
# 1 is nothing matched. Re-deriving either here would be a second auditor over one population.
# ── RULE 2's refusal — a refusal bounds THIS TOOL, never the world ─────────────────────────────
# The text this replaces ended "so there is nothing to recover": a claim about the SESSION
# inferred from a predicate about QUOTA. On 2026-09-22 it was simply false. Pane 500 held a
# session killed by the CONTEXT ceiling ("Prompt is too long") — dead in place, unable to execute
# another turn, with 29 delegated units complete on disk — and the driver that read that sentence
# hand-rolled a whole recovery rather than being routed to one. Two repo lessons name the defect
# exactly: a refusal bounds the TOOL and gets believed as a fact about the WORLD
# (reference-a-refusal-bounds-the-tool-not-the-world), and a detector with no owner is not an
# actuator — a dead-end refusal is what makes a caller improvise.
#
# The cure is NOT to widen admission: that is `bin/cc-limited`'s census contract, which belongs to
# LIMIT_DETECT_100P and is an OPEN OPERATOR CALL (that plan is unowned; its lead died). This stays
# strictly a REFUSAL, admits nothing new, starts nothing, and takes no mutex. It only stops lying
# about why, and names the next command — which costs one classify call on the arm that was going
# to refuse anyway. Root diagnosis: docs/plans/LIMIT_RECOVER_100P.md sections 6a and 10.
# ── THE SECOND CORRECTION, 2026-09-22 (VOLUNTARY_ACCOUNT_SWITCH §4) ───────────────────────────
# The line below used to read "every downstream rail (recycle, transplant, tombstone, self-close)
# is gated on the quota predicate." It was FALSE, and it was the SAME defect as the one the header
# above corrects, one paragraph later: a refusal bounding THIS TOOL, written as a fact about the
# WORLD. Verified on the tree — lr-transplant.sh contains no limit predicate anywhere, and
# lr-handoff.sh's SELF arm deliberately DISCARDS the probe rc, its own comment naming a session
# "being moved to a fresher account" as the case it protects. The quota predicate lives in exactly
# two places, both of them admission: RULE 2 in this file, and cf_class == LIMITED in cc-find.
# Consequence the old sentence hid: a healthy session CAN move accounts in place, which is what
# `cc-lr switch` below does. What a context-dead session still lacks is not a gate but a driver.
cl_refuse_not_limited() { # <sid> <pane> <klass> <cfg> <cwd> → always rc 2
  local sid="$1" pane="${2:--}" klass="${3:-UNKNOWN}" cfg="$4" cwd="$5"
  local f tx="" row="" err="" kind=""
  # KILL SWITCH, never an ENABLE flag. A behaviour gated on a flag somebody must remember to pass
  # is the repo lesson "a branch gated on a flag no automation passes is permanent inaction" — the
  # default has to BE the correct behaviour, with the escape explicit and named. `=off` restores
  # the pre-2026-09-22 text byte-for-byte, which is what the negative control in
  # tests/cc-lr-front.bats pins, so the classify fork below can never wedge this refusal shut.
  if [ "${CC_LR_ROUTE_REFUSAL:-on}" = off ]; then
    echo "cc-lr: REFUSED — ${sid:0:8} (pane ${pane}) is class ${klass}, not LIMITED: its last assistant word is not a usage-limit error, so there is nothing to recover. No mutex was created and nothing was started." >&2
    return 2
  fi
  for f in "$cfg"/projects/*/"$sid".jsonl; do [ -f "$f" ] && { tx="$f"; break; }; done
  # FAIL-QUIET, never fail-wrong: an unreachable lr-lib or an unreadable transcript leaves row
  # empty and we fall to the generic arm, which claims nothing about the api error either way.
  if [ -n "$tx" ] && command -v lr_last_api_error >/dev/null 2>&1; then
    row="$(lr_last_api_error "$tx" 2>/dev/null || true)"
  fi
  [ -n "$row" ] && { err="$(printf '%s' "$row" | cut -f2)"; kind="$(printf '%s' "$row" | cut -f3)"; }

  if [ -n "$row" ] && [ "$kind" != limit ]; then
    { echo "cc-lr: REFUSED — ${sid:0:8} (pane ${pane}) is class ${klass}, not LIMITED. These rails admit a QUOTA limit only. No mutex was created and nothing was started."
      echo "cc-lr:   BUT IT IS NOT HEALTHY: its last assistant record IS a terminal api error — kind=${kind:-unknown}: ${err:-<no text>}"
      echo "cc-lr:   so that pane cannot execute another turn. 'Not recoverable by this command' is a different statement from 'nothing to recover', and the difference is the whole reason this line exists."
      echo "cc-lr:   WHAT IS GATED ON QUOTA IS THIS ADMISSION RULE AND NOTHING BELOW IT — RULE 2 here, plus cc-find's LIMITED class (cc-find:150-155); the transplant engine carries no limit predicate at all and lr-handoff.sh's SELF arm discards the probe rc on purpose, so the rails can move a session that is not limited. What that leaves missing for THIS class is not a gate but a DRIVER: the pane cannot type its own /exit. Do this instead:"
      echo "cc-lr:     python3 ~/.claude/scripts/limit-recover/lr-audit.py --config-dir ${cfg} --session ${sid} --cwd ${cwd:-<its cwd>}"
      echo "cc-lr:   read its gap ledger, fire a successor with scripts/handoff-fire.sh, and leave the source pane to the operator (it cannot be retired by the sanctioned path). Diagnosis: docs/plans/LIMIT_RECOVER_100P.md sections 6a, 10."
    } >&2
    return 2
  fi

  { echo "cc-lr: REFUSED — ${sid:0:8} (pane ${pane}) is class ${klass}, not LIMITED: its last assistant record is not an api error at all, so this session is live and working and there is nothing to recover. No mutex was created and nothing was started."
  } >&2
  return 2
}

cl_resolve() { # <ref> → the one TSV row on stdout; rc 0 ok · 1 no match · 2 refused
  local ref="$1" out rc n
  [ -x "$FIND_BIN" ] || [ -f "$FIND_BIN" ] || { echo "cc-lr: cannot reach cc-find at $FIND_BIN" >&2; return 2; }
  out="$(bash "$FIND_BIN" "$ref" 2>/dev/null)"; rc=$?
  case "$rc" in
    2) echo "cc-lr: REFUSED — '$ref' is AMBIGUOUS; cc-find named more than one session and this tool will not pick. Candidates:" >&2
       printf '%s\n' "$out" >&2
       echo "cc-lr: pass a pane id or the full sid. Nothing was started and no mutex was created." >&2
       return 2 ;;
    1) echo "cc-lr: '$ref' matched no live session." >&2; return 1 ;;
    0) ;;
    *) echo "cc-lr: cc-find exited $rc for '$ref'" >&2; return 2 ;;
  esac
  n="$(printf '%s\n' "$out" | grep -c '[^[:space:]]')"
  if [ "${n:-0}" -ne 1 ]; then
    echo "cc-lr: REFUSED — '$ref' resolved to ${n:-0} rows at rc 0; a recovery target must be exactly one. Nothing was started." >&2
    printf '%s\n' "$out" >&2
    return 2
  fi
  printf '%s\n' "$out"
}

# ── recover --limited: one command for "recover account N" ─────────────────────────────────────
# 2026-09-24: the operator typed "/limit-recover account 2s" beside a screenshot, and the only verb
# took ONE ref, so the panes were matched by hand from the picture. This enumerates with the same
# resolver `cc-lr find --limited` uses and runs the single-ref path per session in a subshell, so
# every refusal (TEAMMATE, AMBIGUOUS, not LIMITED, the mutex) applies unchanged to each one.
cl_acct_dirs() { # <label> → the config-dir basenames that account owns, space-separated; rc 1 unknown
  case "$1" in
    next|1|account1|claude|claude-next) echo ".claude .claude-next" ;;
    next2|2|account2|secondary|claude-secondary) echo ".claude-secondary" ;;
    next3|3|account3|tertiary|claude-tertiary) echo ".claude-tertiary" ;;
    next4|4|account4|quaternary|claude-quaternary) echo ".claude-quaternary" ;;
    *) return 1 ;;
  esac
}
cl_acct_name() { # <label> → the account-map NAME for cl_acct_dirs' labels; rc 1 unknown
  case "$1" in
    next|1|account1|claude|claude-next) echo next ;;
    next2|2|account2|secondary|claude-secondary) echo next2 ;;
    next3|3|account3|tertiary|claude-tertiary) echo next3 ;;
    next4|4|account4|quaternary|claude-quaternary) echo next4 ;;
    *) return 1 ;;
  esac
}
# Is the account at a 5-hour or weekly cap? The same read and the same >= 100 rule as
# lr-fleet.sh's lf_acct_has_headroom, so the two never disagree about one account.
cl_acct_cap() { # <name> → stdout "weekly 100%" / "5-hour 100%"; rc 0 capped · 1 headroom · 2 unreadable
  local ab="${CC_ACCOUNTS_BIN:-$HOME/bin/claude-accounts}"
  [ -x "$ab" ] || return 2
  "$ab" --json 2>/dev/null | /usr/bin/python3 -c '
import json, sys
try: rows = json.loads(sys.stdin.read()).get("rows", [])
except Exception: sys.exit(2)
for r in rows:
    if r.get("acct") == sys.argv[1]:
        w, s = r.get("weekly_pct") or 0, r.get("session_pct") or 0
        if w >= 100: print("weekly %d%%" % w); sys.exit(0)
        if s >= 100: print("5-hour %d%%" % s); sys.exit(0)
        sys.exit(1)
sys.exit(2)' "$1"
}
cmd_recover_limited() { # [--account A] [--target T]
  local acct_f="" target="auto" dirs="" out rc sid pane acct cfg cwd live klass base n=0 fired=0 refused=0
  local seen="" name cap cap_rc sw_target qrc=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) [ $# -ge 2 ] || { usage; exit 3; }; acct_f="$2"; shift 2 ;;
      --target)  [ $# -ge 2 ] || { usage; exit 3; }; target="$2"; shift 2 ;;
      *) echo "cc-lr recover --limited: unknown argument $1" >&2; usage; exit 3 ;;
    esac
  done
  if [ -n "$acct_f" ]; then
    dirs="$(cl_acct_dirs "$acct_f")" || { echo "cc-lr: unknown account '$acct_f' (next|next2|next3|next4, or 1-4)" >&2; exit 3; }
  fi
  [ -f "$FIND_BIN" ] || cl_die "cannot reach cc-find at $FIND_BIN" 2
  out="$(bash "$FIND_BIN" --limited 2>/dev/null)"; rc=$?
  [ "$rc" -le 1 ] || cl_die "cc-find --limited exited $rc" 2
  while IFS=$'\t' read -r sid pane acct cfg cwd live klass; do
    [ -n "$sid" ] || continue
    if [ -n "$dirs" ]; then
      base="${cfg%/}"; base="${base##*/}"
      case " $dirs " in *" $base "*) ;; *) continue ;; esac
    fi
    n=$((n + 1)); seen="$seen $sid"
    if ( cmd_recover "$sid" --target "$target" ${pane:+--source-pane "$pane"} ); then
      fired=$((fired + 1))
    else
      refused=$((refused + 1))
    fi
  done <<EOF_ROWS
$out
EOF_ROWS
  if [ "$n" -eq 0 ]; then
    echo "cc-lr: no LIMITED session${acct_f:+ on $acct_f} — nothing to recover."
  else
    echo "cc-lr: ${fired} fired, ${refused} refused of ${n} limited session(s)${acct_f:+ on $acct_f}. Verdicts arrive as mail; END THE TURN."
  fi

  # ── THE IDLE HALF (2026-09-27). "Recover account N" means every session on it, and at a cap an
  # IDLE session is only one turn from the same limit error: pane 754 sat idle on account 1 at 100%
  # weekly while this command found only pane 780, and the operator had to name it. So at a cap the
  # same command also queues the account's idle sessions through the switch driver's census
  # (`cc-lr switch --from <acct> --all-idle`), minus the sessions recovered above. With headroom it
  # does nothing more: an idle session there is healthy, and moving it would be a surprise.
  if [ -n "$acct_f" ] && name="$(cl_acct_name "$acct_f")"; then
    cap="$(cl_acct_cap "$name")"; cap_rc=$?
    case "$cap_rc" in
      0)
        if [ "$target" = auto ]; then
          sw_target="$(cl_switch_auto_target "$name")" || {
            echo "cc-lr: $name is at $cap — its idle sessions were NOT queued: $sw_target. Name one with --target <acct>."
            sw_target=""; }
        else
          sw_target="$target"
        fi
        if [ -n "$sw_target" ]; then
          echo "cc-lr: $name is at $cap — queueing its IDLE sessions for $sw_target (cc-lr switch --from $name --all-idle):"
          ( cmd_switch_driver "$sw_target" 0 "" "" "$name" 1 0 "$seen" ); qrc=$?
        fi ;;
      2) echo "cc-lr: could not read $name's usage — its idle sessions were NOT checked; if it is capped: cc-lr switch --from $name --all-idle --target <acct>" ;;
    esac
  fi
  [ "$fired" -gt 0 ] || [ "$qrc" -eq 0 ]
}

# ── recover ────────────────────────────────────────────────────────────────────────────────────
cmd_recover() {
  local ref="" target="auto" pane_arg="" row rc sid pane acct cfg cwd live klass mutex out fpid run
  case " $* " in *" --limited "*)
    local _a=() _x
    for _x in "$@"; do [ "$_x" = --limited ] || _a+=("$_x"); done
    cmd_recover_limited "${_a[@]}"; return $? ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --target) [ $# -ge 2 ] || { usage; exit 3; }; target="$2"; shift 2 ;;
      --source-pane) [ $# -ge 2 ] || { usage; exit 3; }; pane_arg="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "cc-lr recover: unknown option $1" >&2; usage; exit 3 ;;
      *) [ -z "$ref" ] || { echo "cc-lr recover: one ref, not two ('$ref' and '$1')" >&2; exit 3; }
         ref="$1"; shift ;;
    esac
  done
  [ -n "$ref" ] || { usage; exit 3; }

  row="$(cl_resolve "$ref")"; rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"
  IFS=$'\t' read -r sid pane acct cfg cwd live klass <<EOF
$row
EOF
  [ -n "$sid" ] || cl_die "cc-find returned a row naming no session for '$ref'" 2

  # RULE 0 FIRST, and named separately from RULE 2 even though TEAMMATE is also not LIMITED: the
  # two refusals mean different things to the operator and the teammate one is the unrecoverable
  # mistake (recovering a lead-owned session hands a driver someone else's pane).
  if [ "$klass" = TEAMMATE ]; then
    echo "cc-lr: REFUSED — ${sid:0:8} (pane ${pane}) is a TEAMMATE: lead-owned, nothing is owed by anyone on it. lr-fleet --one has no teammate guard, so this refusal is the only one. No mutex was created and nothing was started." >&2
    exit 2
  fi
  if [ "$klass" != LIMITED ]; then
    cl_refuse_not_limited "$sid" "$pane" "${klass:-UNKNOWN}" "$cfg" "$cwd"
    exit 2
  fi

  [ -n "$pane_arg" ] && pane="$pane_arg"
  # AFTER the three refusals (a teammate or a non-limited sid is no more the reconciler's to drive
  # than ours), BEFORE the mutex: a queued request takes no lock and fires nothing.
  if lr_recon_live; then
    cl_recon_queue "$sid" recover "${pane:--}" "$cfg" "$([ "$target" = auto ] || printf '%s' "$target")"
    return 0
  fi
  cl_fence_or_refuse "$sid"
  mutex="$(cl_mutex_take "$sid" "${pane:--}")" || exit 2

  [ -n "$FLEET_BIN" ] && [ -f "$FLEET_BIN" ] || {
    lr_claim_release "$MUTEX_DIR" "$sid" "$$"
    cl_die "cannot reach lr-fleet.sh (set CC_LR_FLEET_BIN); the mutex was released and nothing was started" 2; }

  set -- --one "$sid" --target "$target"
  case "${pane:--}" in -|'') ;; *) set -- "$@" --source-pane "$pane" ;; esac
  # The DETACHED driver outlives this process, so it must not inherit a launch lock that our EXIT trap
  # releases ~3 s from now — it would keep acting on a lock nobody holds. Release it here and let
  # lf_one take it under the driver's own pid (lr-fleet.sh fences lf_one); a racing actor that wins
  # the gap makes the driver defer, which is the one-actuator rule working, not a failure.
  lr_recon_act_done
  out="$(env -u LR_LAUNCH_LOCK bash "$FLEET_BIN" "$@" --detach 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    lr_claim_release "$MUTEX_DIR" "$sid" "$$"
    printf '%s\n' "$out" >&2
    cl_die "lr-fleet --one exited $rc; the mutex was released and nothing is running" 2
  fi
  fpid="$(printf '%s\n' "$out" | sed -n 's/.*driver pid \([0-9][0-9]*\).*/\1/p' | head -1)"
  run="$(printf '%s\n' "$out" | sed -n 's/^run=\([^ ]*\).*/\1/p' | head -1)"
  # Re-stamp the holder with the DRIVER's pid: this process is about to exit, and a mutex naming a
  # dead pid is stolen by the next caller (above) — which for a live recovery is the split brain.
  [ -n "$fpid" ] && { lr_claim_restamp "$MUTEX_DIR" "$sid" "$$" "$fpid" "lr-fleet --one --detach" "${pane:--}" \
    || echo "cc-lr: WARNING — could not re-stamp $mutex with driver pid $fpid; it names this (exiting) process and is stealable" >&2; }

  # THE THREE LINES (D2 §1.2). Line 3 names the ONE command to run next.
  #
  # THE ID IS THE BUNDLE, AND AT FIRE TIME THE BUNDLE DOES NOT EXIST YET. lr-handoff.sh:479 mints
  # `$HOME/.reso/limit-recover/$SID/bundle-$TS` with ITS OWN timestamp, inside the detached driver,
  # AFTER the precheck and the capacity park — which on a parked run is minutes later and on a
  # refused run never. Printing a path this process invented would be a guess the store never
  # confirms. So line 3 prints what IS known (the bundle ROOT, which is keyed on the sid alone, and
  # any bundle a previous attempt already left) and hands over `cc-lr status <sid8>`, which
  # resolves the newest bundle at READ time, when it exists.
  local broot bprev
  broot="$STATE/$sid"
  bprev="$(cl_newest_bundle "$sid" || true)"
  printf 'cc-lr: %s → %s (%s · %s · %s) class %s, liveness %s\n' \
    "$ref" "${sid:0:8}" "${acct:--}" "${cfg:--}" "${cwd:--}" "$klass" "${live:--}"
  printf 'cc-lr: target %s  pane %s  mutex %s  run %s\n' \
    "$target" "${pane:--}" "$mutex" "${run:-?}"
  printf 'cc-lr: fired  %s  → cc-lr status %s\n' \
    "${bprev:-$broot/bundle-* (the driver mints it; not on disk yet)}" "${sid:0:8}"
  return 0
}

# ── switch ─────────────────────────────────────────────────────────────────────────────────────
# THIS PANE MOVES ITSELF TO ANOTHER ACCOUNT, IN PLACE (VOLUNTARY_ACCOUNT_SWITCH §4, A01, 88%).
#
# THE MIRROR OF `recover`, AND THE MIRROR IS THE ENTIRE DESIGN. `recover`'s subject cannot execute
# a turn, so a DETACHED driver is right and the subject arrives as a REF. `switch`'s subject IS the
# actor — it is the session taking this turn — so the subject is this process's own identity and
# the run is FOREGROUND. Three consequences, each deliberate, none of them a shortcut:
#
#   NO REF, AND DELIBERATELY NOT THROUGH cc-find. cl_resolve routes every ref through cc-find,
#   which resolves only rows whose class is LIMITED and answers rc 2 for everything else
#   (cc-find:150-155, and RULE 2 above repeats it). A healthy session is BY DEFINITION not LIMITED,
#   so a `switch` routed through that gate would refuse exactly the sessions it exists for. The
#   subject is $CLAUDE_CODE_SESSION_ID plus cl_this_pane(), never a lookup — which is also the only
#   honest source, because the question being asked is "who am I".
#
#   (2026-09-23: the "driver form" deferred in the next paragraph now EXISTS — cmd_switch_driver
#   above, `--pane/--sid/--from --all-idle`, on lr-upgrade.sh's idle oracle. The paragraph is kept
#   as the record of why the SELF verb itself stays foreground and ref-less.)
#   NO --source-pane AND NO --detach. Moving somebody ELSE's HEALTHY session requires knowing it is
#   idle, and this subsystem has no idle oracle at all: pane_cc_state answers `cc` for mid-turn,
#   idle, modal and wedged alike. A session establishes it about ITSELF trivially — it is the one
#   taking the turn. So the driver form is a separate decision packet gated on that oracle existing
#   (plan §5 DEC-2), and the refusal below says so rather than pretending the flag is unimplemented.
#
#   NO WIDENING OF bin/cc-limited's CENSUS. The SELF path never enters the class filter, so no flag
#   threads cc-lr → lr-fleet → lr-handoff → probe and the open operator call the header above warns
#   about is left exactly as it stands. The census is an enumerator, not a gate.
#
# NO KILL SWITCH, and that is not an oversight: A07 item 7 governs a CHANGE to an existing
# behaviour, which needs a byte-for-byte escape. This is a new verb, and its `=off` is not passing
# it. The one behaviour change in this diff — RULE 2's corrected text — already has one
# (CC_LR_ROUTE_REFUSAL=off).
#
# WHICH LANE `--target auto` ASKS IS NOT SETTLED HERE. It is passed straight through to
# lr-handoff.sh, which asks `claude-accounts --route general` exactly as every other consumer does.
# Whether a VOLUNTARY move should instead ask the `interactive` lane (the operator's stated rule:
# soonest weekly reset with headroom) is an OPEN operator decision at 72% conviction — plan §5
# DEC-1, packet c616443c9616 — and this verb must not settle it by changing what it asks.
cl_from_acct() { # → the account name this session is running on, else the config dir's basename
  local cfg base name
  cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  base="${cfg%/}"; base="${base##*/}"
  if command -v cc_acct_name_for_dir_basename >/dev/null 2>&1; then
    name="$(cc_acct_name_for_dir_basename "$base" 2>/dev/null || true)"
  fi
  printf '%s' "${name:-${base:--}}"
}

# ── the verdict vocabulary, cc-lr's half (plan §6) ─────────────────────────────────────────────
# PARTITIONED ON ACTION, NEVER ON A RECOVERY WORD. Everything this file can emit is NOTMOVED: each
# of cmd_switch's refusals happens before lr-handoff is ever executed, so the source session is
# provably untouched — no bundle, no lock, no tombstone, no keystroke. The tokens that describe a
# move which HAS begun (SWITCHED · SWITCHED-UNPROVEN · STRANDED · FAILED) are lr-handoff.sh's to
# emit, because only it knows whether the transplant ran. `from=`/`to=`/`proven=` are mandatory on
# every token so a consumer never has to infer any of the three (memory: claimed-outcome-vs-checked
# -outcome — a parseable `verdict=` is what makes a claim checkable).
cl_verdict() { # <TOKEN> <to> <note>
  printf 'cc-lr: verdict=%s from=%s to=%s proven=no — %s\n' \
    "$1" "$(cl_from_acct)" "${2:--}" "$3" >&2
}

# ── `--target auto`: the desk rule, SAFE accounts only (operator ruling 2026-09-22) ─────────────
# Decision packet 25d3ac950a9e, which superseded c616443c9616. A voluntary switch moves a LONG-LIVED
# session the operator keeps typing into, which is the object the desk rule (`--rank interactive`)
# was built for; the general rule is built for short dispatched fires. On the 324-sweep replay in
# claude-accounts' score_interactive docstring the desk rule left a session near a 5-hour wall 0.6%
# of the time against 3.4% for the general rule, and it is the operator's own sentence: soonest
# weekly reset, low 5-hour use.
#
# ONLY TIER 2, NEVER A DEGRADED PICK. The desk rule's score is `tier + key` with the key in (0,1),
# so int(score) IS the tier: 2 = safe on both the 5-hour and weekly keys, 1 = 5-hour only, 0 =
# neither. For a fresh launch the desk must always land somewhere, so the rule degrades rather than
# answer "none". A switch is OPTIONAL — staying put is always available — so a degraded pick would
# move a healthy session onto a thin account, which is strictly worse than not moving. That is the
# whole difference from the rule as it stands, and why this is not `--route interactive`.
#
# The 60% 5-hour ceiling behind tier 2 is the same number `--recovery` uses (accounts.json:
# RECOVERY_S_CEIL "reuses DESK_5H_FLOOR's already-argued 0.60"), which is why skipping that
# modifier — which the desk rule refuses — loses no survival check.
#
# Three further choices, each deliberate:
#   --rank, not --route: --rank is diagnostic and writes nothing, where --route records a DESK
#     decision that the desk hysteresis later reads. A switch must not rewrite which account the
#     operator's own desk sticks to.
#   CC_ROUTE_DESK_HYST=off: that hysteresis exists to stop the operator's DESK flapping between
#     accounts. It answers a different question, and left on it would bias this pick toward the
#     desk's account instead of the soonest-resetting safe one.
#   The source account is dropped by NAME (cl_from_acct resolves through the same generated
#     account map the ranker prints from), and a pick equal to the source is refused again below
#     as a second fence. lr-handoff then re-checks the pick against the general rule's eligible
#     set (lrh_target_routable), so an account the desk rule admits but the stricter concurrency
#     count excludes is refused there, loudly, rather than moved onto.
CL_DESK_SAFE_TIER="${CL_SWITCH_SAFE_TIER:-2}"
# stdout carries the ACCOUNT on rc 0 and the REASON otherwise: it runs inside `$( … )`, so a global
# set in here would die with the subshell (memory: assignment-inside-command-substitution).
cl_switch_auto_target() { # [source acct, default this session's] → stdout: account (rc 0) · why (rc 1 none safe, rc 2 could not ask)
  local ab src="${1:-}" out rc=0 best
  ab="${CC_ACCOUNTS_BIN:-$HOME/bin/claude-accounts}"
  [ -x "$ab" ] || { printf 'the ranker is not executable at %s' "$ab"; return 2; }
  [ -n "$src" ] || src="$(cl_from_acct)"
  out="$(CC_ROUTE_DESK_HYST=off "$ab" --rank interactive 2>/dev/null)" || rc=$?
  # The ranker's own taxonomy: 2 = it answered and every account is excluded by POLICY, 3 = it has
  # no DATA. The first is a real "nothing is safe"; the second is our blindness, not a verdict.
  case "$rc" in
    0) ;;
    2) printf 'the ranker excludes every account'; return 1 ;;
    *) printf 'the ranker could not answer (rc %s)' "$rc"; return 2 ;;
  esac
  best="$(printf '%s\n' "$out" | awk -v src="$src" -v tier="$CL_DESK_SAFE_TIER" '
    NF == 2 && $2 ~ /^[0-9]+(\.[0-9]+)?$/ && $1 != src && int($2) >= tier {
      if (!seen || $2 + 0 > bs + 0) { b = $1; bs = $2; seen = 1 }
    }
    END { if (seen) print b }')"
  if [ -z "$best" ] || [ "$best" = "$src" ]; then
    printf 'no account other than %s is safe on both the 5-hour and weekly limits' "$src"
    return 1
  fi
  printf '%s' "$best"
}

# ── switch, THE DRIVER FORM: move ANOTHER idle session (2026-09-23) ─────────────────────────────
# `cc-lr switch --pane P --target A` · `--sid S --target A` · `--from F --all-idle --target A`.
# DEC-2 (VOLUNTARY_ACCOUNT_SWITCH §5) deferred this "gated on an idle oracle existing". The oracle
# now exists — lr-upgrade.sh's selection predicate (at rest, in-flight subagents, background job,
# composer, teammate/lead, duplicate, stale row, self) — and this form REUSES it through
# `lr-upgrade.sh --switch-census` rather than writing a second one.
#
# THE SAME SHAPE AS `upgrade`, AND FOR ITS REASON: acting on another live session from inside a
# session is refused by auto mode's classifier (the incident's attempt 3), so this verb only READS
# and WRITES REQUESTS. The launchd poller queues them for the one serial drainer, which re-judges
# each session at execution time and types ONE canonical line into the idle subject — marked
# `[operator-ruling cc-lr-switch …]` — telling it to run the SELF verb. The subject moves itself, so
# the SELF verb's own gates still run inside the subject (DEC-2's core argument, kept).
#
# ONLY AN EXPLICIT TARGET. `auto` is resolved from the SUBJECT's view by the SELF verb, so the
# driver could not know which account to confirm the flip against, and one --all-idle batch could
# scatter across accounts. The operator's ask names the account; so must the command.
cl_switch_line() { # <pane> <sid> <VERDICT> <from> <to> <reason>
  case "$3" in
    SWITCHED) printf '✓ %-5s %s  SWITCHED %s → %s — %s\n' "$1" "${2:0:8}" "$4" "$5" "$6" ;;
    queued)   printf '… %-5s %s  queued %s → %s — %s\n' "$1" "${2:0:8}" "$4" "$5" "$6" ;;
    skipped)  printf '· %-5s %s  NOTMOVED (%s) %s\n' "$1" "${2:0:8}" "$6" "$4" ;;
    *)        printf '✗ %-5s %s  %s %s → %s — %s\n' "$1" "${2:0:8}" "$3" "$4" "$5" "$6" ;;
  esac
}
# ── IS THE TARGET ONE A SUBJECT COULD MOVE ONTO? asked ONCE, before anything is queued (2026-09-27) ──
# The SELF verb refuses an unroutable target inside the subject (lr-handoff's lrh_target_routable),
# so a driver that queues without asking spends one full TURN per subject to learn what one read
# here already knew. Measured that day: `--from next2 --all-idle --target next3` queued 4 requests,
# each subject took a turn and answered "target not routable", 4 turns + 4 mails wasted while next3's
# keychain held no refresh token at all.
#
# THE SAME QUESTION AS THE ACTUATOR, NEVER A SECOND RULE: `--rank general`, membership on stdout,
# one `--fresh` re-read before refusing, and FAIL-OPEN on an instrument that cannot answer (any
# non-zero rc, or an empty ranking) — exactly lrh_target_routable's contract, so this can refuse only
# what the subject itself would refuse (memory: make-the-actuator-the-arbiter). The subject's gate
# stays the backstop. stdout carries the router's own reason on rc 1 (it runs inside `$( … )`).
cl_target_unroutable() { # $1=target → rc 0 excluded (reason on stdout) · rc 1 routable or unknown
  local t="$1" ab out rc errf reason="" fresh
  [ "${CC_LR_TARGET_ROUTABLE:-on}" = off ] && return 1
  ab="${CC_ACCOUNTS_BIN:-$HOME/bin/claude-accounts}"
  [ -x "$ab" ] || return 1
  errf="$(mktemp "${TMPDIR:-/tmp}/cc-lr-rank.XXXXXX")" || return 1
  for fresh in "" --fresh; do
    rc=0; out="$("$ab" --rank general ${fresh:+"$fresh"} 2>"$errf")" || rc=$?
    if [ "$rc" -ne 0 ] || [ -z "$out" ]; then rm -f "$errf"; return 1; fi
    case $'\n'"$(printf '%s\n' "$out" | awk 'NF{print $1}')"$'\n' in
      *$'\n'"$t"$'\n'*) rm -f "$errf"; return 1 ;;
    esac
  done
  # The router names its exclusions on stderr as `…excluded — a=why; b=why`; keep only the target's.
  reason="$(sed -n 's/.*excluded — //p' "$errf" | tr ';' '\n' | sed 's/^ *//' \
            | awk -v t="$t" 'index($0, t "=") == 1 { print substr($0, length(t) + 2); exit }')"
  rm -f "$errf"
  printf '%s' "${reason:-not ranked by the router}"
  return 0
}
# An AUTH exclusion has exactly one cure, and it is an operator step: name it with the mailbox and the
# Dia profile it signs in through, read from the identity block rather than restated here.
cl_relogin_hint() { # $1=account $2=router reason → one line on stdout, or nothing
  local ab info em dp
  case "$2" in *login*|*token*|*stale*|*auth*|*keychain*|*logged-out*) ;; *) return 0 ;; esac
  ab="${CC_ACCOUNTS_BIN:-$HOME/bin/claude-accounts}"
  info="$("$ab" --relogin-info "$1" 2>/dev/null || true)"
  em="$(printf '%s' "$info" | jq -r '.email // empty' 2>/dev/null || true)"
  dp="$(printf '%s' "$info" | jq -r '.dia_profile // empty' 2>/dev/null || true)"
  printf 'the cure is a login: cc-relogin %s --dia%s' "$1" \
    "${em:+ (signs in as $em${dp:+ through Dia profile $dp})}"
}

cmd_switch_driver() { # <target> <dry> <pane> <sid> <from> <all> <wait_s> [excluded sids, space-separated] [<until_idle_s>]
  local target="$1" dry="$2" pane="$3" sid="$4" from="$5" all="$6" wait_s="$7" excl="${8:-}" until_s="${9:-0}" census rc sel=""
  case "$wait_s" in ''|*[!0-9]*) echo "cc-lr switch: --wait takes whole seconds" >&2; exit 3 ;; esac
  case "$until_s" in ''|*[!0-9]*) echo "cc-lr switch: --until-idle takes whole seconds (a budget, e.g. 3600)" >&2; exit 3 ;; esac
  # EXACTLY ONE SUBJECT. A fleet-wide move by default is the accident this verb must not make easy,
  # so --all-idle needs --from, and --from alone is not a subject.
  local nsub=0
  [ -n "$pane" ] && nsub=$((nsub + 1))
  [ -n "$sid" ] && nsub=$((nsub + 1))
  [ "$all" -eq 1 ] && nsub=$((nsub + 1))
  if [ "$nsub" -ne 1 ] || { [ "$all" -eq 1 ] && [ -z "$from" ]; } || { [ -n "$from" ] && [ "$all" -ne 1 ]; }; then
    echo "cc-lr switch: name ONE subject — --pane <P>, --sid <S>, or --from <acct> --all-idle (--from alone is not a subject, and --all-idle needs --from)" >&2
    cl_verdict NOTMOVED "$target" "no single subject named; nothing was read or written"
    exit 3
  fi
  case "$target" in
    auto) echo "cc-lr switch: REFUSED — the driver form needs an explicit --target <acct>: 'auto' would be resolved by each SUBJECT from its own view, so this driver could not confirm the move against the account it expects. Nothing was read or written." >&2
          cl_verdict NOTMOVED auto "the driver form needs an explicit account; nothing was written"
          exit 3 ;;
    ''|-*|*[!A-Za-z0-9_-]*)
          echo "cc-lr switch: REFUSED — '$target' cannot be an account name. Nothing was read or written." >&2
          cl_verdict NOTMOVED "$target" "target is not a well-formed account name; nothing was written"
          exit 3 ;;
  esac
  # THE MAP IS THE ARBITER of which names are accounts (never an enumeration here — it perishes).
  if command -v cc_acct_dir_for_name >/dev/null 2>&1; then
    local a
    for a in "$target" ${from:+"$from"}; do
      cc_acct_dir_for_name "$a" >/dev/null 2>&1 || {
        echo "cc-lr switch: REFUSED — '$a' is not an account the account map knows. Nothing was read or written." >&2
        cl_verdict NOTMOVED "$target" "'$a' is not a known account; nothing was written"
        exit 3; }
    done
  fi
  [ -n "$from" ] && [ "$from" = "$target" ] && {
    echo "cc-lr switch: REFUSED — --from and --target are both '$target'; there is nothing to move. Nothing was read or written." >&2; exit 3; }
  command -v jq >/dev/null 2>&1 || cl_die "jq is not on PATH; nothing was read or written" 2
  [ -n "$UPGRADE_BIN" ] && [ -f "$UPGRADE_BIN" ] || cl_die "cannot reach lr-upgrade.sh (set CC_LR_UPGRADE_BIN); nothing was read or written" 2
  # ONCE, BEFORE ANY REQUEST. A real run refuses here; a dry run still shows its table, with every
  # would-be `move` row relabelled, so the rehearsal answers the same question the run would.
  local unroute="" hint=""
  if unroute="$(cl_target_unroutable "$target")"; then
    hint="$(cl_relogin_hint "$target" "$unroute")"
    if [ "$dry" -ne 1 ]; then
      echo "cc-lr switch: REFUSED — the router does not rank '$target' ($unroute), so every subject would take a turn only to refuse the move itself. Nothing was queued or typed.${hint:+ $hint}" >&2
      cl_verdict NOTMOVED "$target" "target-unroutable: $unroute; nothing was queued${hint:+ - $hint}"
      exit 2
    fi
  else
    unroute=""
  fi
  [ -n "$pane" ] && sel="--pane"
  [ -n "$sid" ] && sel="--sid"
  if [ -n "$sel" ]; then
    census="$(bash "$UPGRADE_BIN" --switch-census --target "$target" "$sel" "${pane:-$sid}")"; rc=$?
  else
    census="$(bash "$UPGRADE_BIN" --switch-census --from "$from" --target "$target")"; rc=$?
  fi
  case "$rc" in
    0) ;;
    1) echo "cc-lr switch: ${pane:+pane $pane}${sid:+sid $sid}${from:+no live session on $from} matched no live session" >&2
       cl_verdict NOTMOVED "$target" "no live session matched; nothing was written"
       return 1 ;;
    *) cl_die "the switch census failed (rc $rc); nothing was written" 2 ;;
  esac
  # Sessions the caller is already recovering (recover --limited's own set) are not switch subjects.
  if [ -n "$excl" ]; then
    census="$(printf '%s\n' "$census" | awk -F'\t' -v x=" $excl " 'index(x, " " $2 " ") == 0')"
    [ -n "$census" ] || { echo "cc-lr switch: no idle session on ${from:-the account} beyond the ones already being recovered"; return 1; }
  fi
  if [ -n "$sid" ] && [ "$(printf '%s\n' "$census" | grep -c .)" -gt 1 ]; then
    echo "cc-lr switch: REFUSED — sid '$sid' matched more than one live session; pass the pane id. Nothing was written. Candidates:" >&2
    printf '%s\n' "$census" | cut -f1,2 >&2
    return 2
  fi

  if [ "$dry" -eq 1 ]; then
    [ -z "$unroute" ] || census="$(printf '%s\n' "$census" | awk -F'\t' -v OFS='\t' 'NF { if ($7 == "move" || $7 == "bg-session") $7 = "target-unroutable"; print }')"
    printf '%-5s %-8s  %-18s %s\n' PANE SID 'ACCOUNT → TARGET' DISPOSITION
    printf '%s\n' "$census" | while IFS=$'\t' read -r p s ac _ _ _ d; do
      [ -n "$p" ] || continue
      printf '%-5s %-8s  %-18s %s\n' "$p" "${s:0:8}" "$ac → $target" "$d"
    done
    [ -z "$unroute" ] || printf 'target-unroutable: the router does not rank %s (%s)%s\n' "$target" "$unroute" "${hint:+ — $hint}"
    printf '%s to move · DRY RUN: nothing was written or typed\n' \
      "$(printf '%s\n' "$census" | awk -F'\t' -v a="$all" '$7 == "move" || ($7 == "bg-session" && a != 1)' | grep -c .)"
    printf '%s\n' "$census" | awk -F'\t' '$7 == "bg-split" { printf "bg-split %s: this conversation is live TWICE (a background job and an interactive session) - stop the idle copy before any move\n", substr($2, 1, 8) }'
    printf '%s\n' "$census" | awk -F'\t' '$7 == "bg-host" { printf "bg-host %s: pane %s shows a background session (the bg row on the same pane), not its own frozen transcript\n", substr($2, 1, 8), $1 }'
    return 0
  fi

  # ── one request per `move` row; every other row is reported NOTMOVED now ─────────────────────
  local by p s ac d req tmp dest pending="" nq=0 nbad=0 until_ts=0 note
  by="$(cl_this_pane)"
  # --until-idle (F5): a subject held by a hold that ENDS BY ITSELF is queued too, carrying a deadline;
  # the drainer parks it and re-judges it every poller tick until it is idle or the budget ends, then
  # mails the verdict. Which holds qualify is lr-upgrade's one list (--switch-waitable), never a copy.
  [ "$until_s" -gt 0 ] && until_ts=$(( $(date +%s) + until_s ))
  mkdir -p "$REQ_DIR" 2>/dev/null || cl_die "cannot create $REQ_DIR" 2
  while IFS=$'\t' read -r p s ac _ _ _ d; do
    [ -n "$p" ] || continue
    note="request"
    if [ "$d" = bg-session ] && [ "$all" -ne 1 ]; then
      # F4: a Claude Code background session, NAMED by --sid/--pane. It cannot run the SELF verb (it
      # has no composer), so the drainer moves it: stop the job, transplant, quit the hosting pane's
      # agent view, relaunch there. Never by --all-idle — a fleet sweep does not stop jobs.
      note="bg session: the drainer stops the job, transplants it and relaunches it in (or beside) pane $p; request"
    elif [ "$d" != move ]; then
      if [ "$d" = bg-session ]; then
        cl_switch_line "$p" "$s" skipped "$ac" "$target" "bg-session — a background job is moved only when named: cc-lr switch --sid $s --target $target"
        nbad=$((nbad + 1)); continue
      fi
      if [ "$until_s" -gt 0 ] && bash "$UPGRADE_BIN" --switch-waitable "$d" 2>/dev/null; then
        note="$d now; parked until idle (<= ${until_s}s), request"
      else
        cl_switch_line "$p" "$s" skipped "$ac" "$target" "$d"; nbad=$((nbad + 1)); continue
      fi
    fi
    req="${s:0:8}-$(date +%s)-$$"
    tmp="$REQ_DIR/.cc-lr-switch-$s.$$.tmp"; dest="$REQ_DIR/cc-lr-switch-$s.json"
    if jq -n --arg sid "$s" --arg pane "$p" --arg to "$target" --arg from "$ac" --arg by "${by:-?}" --arg req "$req" \
          --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson uts "$until_ts" --argjson us "$until_s" \
          '{kind:"switch", sid:$sid, source_pane:$pane, target:$to, from:$from, requested_by:$by, req_id:$req, ts:$ts, origin_class:"cc-lr-switch"}
           + (if $uts > 0 then {until_ts:$uts, until_idle_s:$us} else {} end)' \
          > "$tmp" 2>/dev/null && mv -f "$tmp" "$dest" 2>/dev/null; then
      pending="$pending$s"$'\t'"$req"$'\t'"$p"$'\t'"$ac"$'\n'; nq=$((nq + 1))
      cl_switch_line "$p" "$s" queued "$ac" "$target" "$note $dest"
    else
      rm -f "$tmp" 2>/dev/null || true
      cl_switch_line "$p" "$s" FAILED "$ac" "$target" "could not write the request into $REQ_DIR (nothing typed)"; nbad=$((nbad + 1))
    fi
  done <<EOF
$census
EOF
  printf 'cc-lr: %d switch request(s) queued for the poller (requested_by %s); verdicts also arrive as mail\n' "$nq" "${by:-?}"
  if [ "$nq" -gt 0 ]; then
    # `kickstart` with NO `-k` — the rule every request writer here follows (see cmd_repair).
    if command -v launchctl >/dev/null 2>&1; then
      launchctl kickstart "gui/$(id -u)/$POLLER_LABEL" >/dev/null 2>&1 \
        || echo "cc-lr: the kick failed — the poller's own interval will drain the queue" >&2
    fi
  fi

  # ── wait for the drainer's verdicts, bounded; it runs detached and outlives this process ─────
  local deadline left f rreq still fv ff ft fr
  deadline=$(( $(date +%s) + wait_s ))
  left="$pending"
  while [ -n "$left" ]; do
    still=""
    while IFS=$'\t' read -r s req p ac; do
      [ -n "$s" ] || continue
      f="$STATE/results/switch-$s.json"
      rreq="$(jq -r '.req_id // empty' "$f" 2>/dev/null || true)"
      if [ -n "$rreq" ] && [ "$rreq" = "$req" ]; then
        IFS=$'\t' read -r fv ff ft fr <<EOF2
$(jq -r '[.verdict // "FAILED", .from // "-", .to // "-", .reason // "-"] | @tsv' "$f" 2>/dev/null)
EOF2
        cl_switch_line "$p" "$s" "$fv" "$ff" "$ft" "$fr"
        [ "$fv" = SWITCHED ] || nbad=$((nbad + 1))
      else
        still="$still$s"$'\t'"$req"$'\t'"$p"$'\t'"$ac"$'\n'
      fi
    done <<EOF3
$left
EOF3
    left="$still"
    [ -n "$left" ] || break
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep "${CC_LR_SWITCH_POLL_S:-5}"
  done
  if [ -n "$left" ]; then
    printf '%s' "$left" | while IFS=$'\t' read -r s req p ac; do
      [ -n "$s" ] && printf '… %-5s %s  pending — queued; the drainer is still working (its verdict lands in %s and as mail)\n' "$p" "${s:0:8}" "$STATE/results/switch-$s.json"
    done
  fi
  [ "$nbad" -eq 0 ] || return 1
  return 0
}

cmd_switch() {
  local target="auto" dry=0 sid pane cfg rc
  local drv=0 d_pane="" d_sid="" d_from="" d_all=0 d_wait="${CC_LR_SWITCH_WAIT_S:-900}" d_until=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --target) [ $# -ge 2 ] || { usage; exit 3; }; target="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      # THE DRIVER FORM (2026-09-23): any of these names ANOTHER session, and hands the whole verb to
      # cmd_switch_driver below. Without them nothing on this path changes: plain `cc-lr switch` is
      # the SELF verb exactly as it was.
      --pane) [ $# -ge 2 ] || { usage; exit 3; }; d_pane="$2"; drv=1; shift 2 ;;
      --sid) [ $# -ge 2 ] || { usage; exit 3; }; d_sid="$2"; drv=1; shift 2 ;;
      --from) [ $# -ge 2 ] || { usage; exit 3; }; d_from="$2"; drv=1; shift 2 ;;
      --all-idle) d_all=1; drv=1; shift ;;
      --wait) [ $# -ge 2 ] || { usage; exit 3; }; d_wait="$2"; drv=1; shift 2 ;;
      --no-wait) d_wait=0; drv=1; shift ;;
      --until-idle) [ $# -ge 2 ] || { usage; exit 3; }; d_until="$2"; drv=1; shift 2 ;;
      # NAMED REFUSALS, not "unknown option". Both flags are things a reader of `cc-lr recover`
      # would reasonably try here, and a bare usage dump would leave them believing the verb is
      # merely unfinished. Each says what is missing and whose call it is.
      --source-pane)
        # REWORDED 2026-09-23: this refusal used to say the driver form did not exist because no
        # idle oracle did. Both are now false (DEC-2 resolved), so the refusal names the flag that
        # IS the driver form instead of a missing capability.
        { echo "cc-lr switch: REFUSED — --source-pane is not this verb's spelling. To move ANOTHER idle session, name it with --pane: cc-lr switch --pane <P> --target <acct> (or --from <acct> --all-idle). That form judges idleness with lr-upgrade.sh's idle oracle and asks the subject to move ITSELF through the poller — VOLUNTARY_ACCOUNT_SWITCH.md §5 DEC-2, resolved. Nothing was started."
          echo "cc-lr switch:   To move a session that is LIMIT-BLOCKED (which needs no idle oracle — it cannot take a turn), that is the other verb: cc-lr recover <ref> --source-pane <P>"
        } >&2
        cl_verdict NOTMOVED "$target" "--source-pane is not a flag of this verb; nothing was started"
        exit 3 ;;
      --detach)
        { echo "cc-lr switch: REFUSED — switch is FOREGROUND and has no --detach. The mover IS the subject here, so there is no second process for a driver to be: the /exit that starts the recycle ends this one."
          echo "cc-lr switch:   --detach is cc-lr recover's, where the subject cannot act and something else has to. Nothing was started."
        } >&2
        cl_verdict NOTMOVED "$target" "--detach is not a flag of this verb; nothing was started"
        exit 3 ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "cc-lr switch: unknown option $1" >&2; usage; exit 3 ;;
      *) echo "cc-lr switch: takes no ref — it moves THIS session, and '$1' names another one. For another IDLE session: cc-lr switch --pane <P> --target <acct>; for somebody else's limit-blocked session: cc-lr recover $1" >&2; exit 3 ;;
    esac
  done
  if [ "$drv" -eq 1 ]; then
    cmd_switch_driver "$target" "$dry" "$d_pane" "$d_sid" "$d_from" "$d_all" "$d_wait" "" "$d_until"
    return $?
  fi

  # THE SHAPE, NOT THE ROSTER. The set of account names is a PERISHABLE fact that lives in
  # lib/account-map.generated.sh and is re-derived from accounts.json; enumerating it here would
  # mint a second copy that goes stale silently. So this refuses only what cannot BE an account
  # name, and `lrh_target_routable` — which asks the router rather than re-deriving its rule — is
  # the arbiter of whether a well-formed name is one a session can actually take a turn on
  # (memory: make-the-actuator-the-arbiter).
  case "$target" in
    auto) ;;
    ''|-*|*[!A-Za-z0-9_-]*)
      echo "cc-lr switch: REFUSED — '$target' cannot be an account name (expected 'auto' or a bare name like next3). Nothing was started; no mutex was created." >&2
      cl_verdict NOTMOVED "$target" "target is not a well-formed account name; nothing was started"
      exit 3 ;;
    *) ;;
  esac

  # WHO AM I — and both halves must answer, because both are load-bearing and they fail apart.
  sid="${CLAUDE_CODE_SESSION_ID:-}"
  if [ -z "$sid" ]; then
    { echo "cc-lr switch: REFUSED — CLAUDE_CODE_SESSION_ID is unset, so this process cannot name the session it would move. switch takes its subject from this session's own identity and never from a ref lookup, so there is nothing to fall back to."
      echo "cc-lr switch:   Run it from inside the Claude Code session you want moved. Nothing was started; no mutex was created."
    } >&2
    cl_verdict NOTMOVED "$target" "no CLAUDE_CODE_SESSION_ID; the subject is unnamable"
    exit 2
  fi
  pane="$(cl_this_pane)"
  if [ -z "$pane" ]; then
    # NOT A DOWNGRADE TO A SPAWN. lr-handoff's NO-PANE fallback spawns a new pane, which is the one
    # thing this verb is defined not to do: `switch` means the pane IS the continuation. With no
    # pane there is no in-place move to make, so refuse and name the tool that does the other thing.
    { echo "cc-lr switch: REFUSED — no terminal pane holds this process (neither CC_PANE_ID, ITERM_SESSION_ID nor KITTY_WINDOW_ID is set), so there is no window to recycle in place. switch is an IN-PLACE move by definition; it will not quietly downgrade to spawning a new pane."
      echo "cc-lr switch:   For a fresh-context move to another account, that is the other rail: /handoff, or scripts/handoff-fire.sh --recycle --account <acct>. Nothing was started; no mutex was created."
    } >&2
    cl_verdict NOTMOVED "$target" "no pane holds this process; an in-place move has no subject window"
    exit 2
  fi
  # THE RECONCILER IS LIVE ⇒ it moves this session, not us. Before `auto` is resolved: the pick is
  # the reconciler's to make at act time, and an explicit target rides in the request.
  if lr_recon_live; then
    if [ "$dry" -eq 1 ]; then
      printf 'cc-lr: DRY RUN — the reconciler is live; a real run would QUEUE %s (pane %s) for it in %s. Nothing was written.\n' \
        "${sid:0:8}" "$pane" "$REQ_DIR/$sid.cc-lr.json"
      return 0
    fi
    cl_recon_queue "$sid" switch "$pane" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$([ "$target" = auto ] || printf '%s' "$target")"
    return 0
  fi
  [ -n "$HANDOFF_BIN" ] && [ -f "$HANDOFF_BIN" ] || {
    cl_die "cannot reach lr-handoff.sh (set CC_LR_HANDOFF_BIN); nothing was started and no mutex was created" 2; }

  # RESOLVED HERE, BEFORE the dry run and BEFORE the mutex: the dry run then shows the account a
  # real run would pick, and a "nothing is safe" answer leaves no lock behind to block the next try.
  if [ "$target" = auto ]; then
    local picked arc=0
    picked="$(cl_switch_auto_target)" || arc=$?
    if [ "$arc" -ne 0 ]; then
      echo "cc-lr switch: staying put — ${picked:-no safe account}. Nothing was started; no mutex was created. Name an account with --target to move anyway." >&2
      cl_verdict NOTMOVED auto "${picked:-no safe account}"
      [ "$arc" -eq 1 ] && exit 1
      exit 2
    fi
    target="$picked"
    echo "cc-lr switch: auto picked $target (soonest weekly reset among accounts safe on both limits)" >&2
  fi

  cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  set -- --sid "$sid" --config-dir "$cfg" --cwd "$PWD" --target "$target" \
         --launch --in-place --voluntary \
         --reason "cc-lr switch from pane $pane"

  # --dry-run PRINTS AND STOPS, AND IT STOPS *BEFORE* THE MUTEX. A dry run that left a lock behind
  # would block the real attempt it was rehearsing — the same argument the three refusals above the
  # mutex make (header: "a refusal that leaves a lock behind is a refusal that blocks the next
  # correct attempt"). It is also why the verdict here is NOTMOVED and not a fourth token: nothing
  # moved, and a dry run is not a distinct OUTCOME, it is the absence of one.
  if [ "$dry" -eq 1 ]; then
    printf 'cc-lr: DRY RUN — session %s (pane %s) would move %s → %s. Nothing was started; no mutex was created. The command:\n' \
      "${sid:0:8}" "$pane" "$(cl_from_acct)" "$target"
    printf '  bash %s' "$HANDOFF_BIN"
    printf ' %s' "$@"
    printf '\n'
    cl_verdict NOTMOVED "$target" "dry run: the command above was printed and nothing was executed"
    return 0
  fi

  # THE MUTEX IS TAKEN LAST, after every refusal that can be decided without it. One actuator per
  # session is the same invariant `recover` holds, and it binds harder here: two movers of ONE
  # session race a transcript copy against a /exit.
  local mutex
  cl_fence_or_refuse "$sid"
  mutex="$(cl_mutex_take "$sid" "$pane")" || exit 2

  # FOREGROUND, AND THE PROCESS IS EXPECTED TO DIE INSIDE THIS CALL. The recycle types /exit into
  # this pane's own TUI, and Claude Code reaps the whole process group of the in-flight tool call —
  # so lr-handoff's own `verdict=` MAIL, sent before it fires the recycle, is the durable record,
  # not this function's return. The mailbox is PANE-keyed (mailbox-drain.sh:36) and every account's
  # mailbox/ is a symlink to one directory, so the successor on the NEW account drains the same
  # inbox. Never key that lane on the sid — a recycle changes it by construction.
  printf 'cc-lr: switching %s (pane %s) %s → %s — in place: same window, same uuid. The verdict arrives as MAIL; do not poll.\n' \
    "${sid:0:8}" "$pane" "$(cl_from_acct)" "$target"
  rc=0
  bash "$HANDOFF_BIN" "$@" || rc=$?
  if [ "$rc" -ne 0 ]; then
    # RELEASE ON EVERY FAILURE PATH, exactly as cmd_recover does — but do NOT re-verdict here.
    # lr-handoff has already emitted the one that knows whether the transplant ran, and a second
    # token minted from an rc alone is a second auditor over one population. The message below
    # deliberately does not spell the `verdict=` token either: a consumer greps for it, so putting
    # it in PROSE mints a row that names no outcome (memory: claimed-outcome-vs-checked-outcome).
    lr_claim_release "$MUTEX_DIR" "$sid" "$$"
    cl_die "lr-handoff exited $rc; the mutex was released — read the verdict line it printed above for what actually moved" "$rc"
  fi
  lr_claim_release "$MUTEX_DIR" "$sid" "$$"
  return 0
}

# ── the run store's reader ─────────────────────────────────────────────────────────────────────
cl_bundles() { # [sid|sid8|bundle path] → one events.jsonl path per line, unsorted
  local ref="${1:-}" d
  if [ -n "$ref" ] && [ -d "$ref" ]; then
    [ -f "$ref/events.jsonl" ] && printf '%s\n' "$ref/events.jsonl"
    return 0
  fi
  if [ -n "$ref" ] && [ -f "$ref" ]; then printf '%s\n' "$ref"; return 0; fi
  # A sid8 is a PREFIX of a session directory; a bare `--all` is every session. Both are one glob,
  # and an unmatched glob expands to itself, which the `-f` test discards.
  for d in "$STATE"/"${ref:-}"*/bundle-*/events.jsonl; do
    [ -f "$d" ] && printf '%s\n' "$d"
  done
}

cl_newest_bundle() { # <sid|sid8> → the newest bundle DIR for it, rc 1 when none
  local f last=""
  while IFS= read -r f; do [ -n "$f" ] && last="$f"; done <<EOF
$(cl_bundles "$1" | LC_ALL=C sort)
EOF
  [ -n "$last" ] || return 1
  printf '%s' "$(dirname "$last")"
}

# ONE jq for the WHOLE set, not one per bundle. Measured shape copied from cc-find's cf_bulk
# (:180-186) and for the same reason: 20 bundles × (tail + jq) is ~40 forks and the budget is
# 0.1 s. The per-file ladder survives as the FALLBACK, through lr_state_current — jq aborts the
# whole invocation on ONE malformed document, and a corrupt run must cost its own row, never
# every row.
cl_events_bulk() { # <file…> → "file\tts\tstate\tstage\tdetail" per LINE
  jq -r '[input_filename, (.ts // "-"), (.state // "-"), (.stage // "-"), (.detail // "-")] | @tsv' "$@" 2>/dev/null
}

# ── the reconciler's cohorts (W4) ──────────────────────────────────────────────────────────────
# report.py's cohort_status is the ONE renderer of a member's state; its output is persisted as the
# `status` key of recon/cohorts/<cid>.json, so this only lays those fields out and derives none of
# them. One jq per file, so a cohort file caught mid-rewrite costs its own lines, never every line.
cl_status_cohort() { # [cid] → rc 0 (also for "none") · 1 the named cohort is absent · 2 unreadable
  local cid="${1:-}" dir="$RECON_ROOT/cohorts" f bad=0 files=()
  command -v jq >/dev/null 2>&1 || cl_die "jq is not on PATH; cannot read $dir" 2
  if [ -n "$cid" ]; then
    case "$cid" in */*|.*) cl_die "'$cid' cannot be a cohort id" 3 ;; esac
    [ -f "$dir/$cid.json" ] || { echo "cc-lr: no reconciler cohort '$cid' under $dir" >&2; return 1; }
    files=("$dir/$cid.json")
  else
    for f in "$dir"/*.json; do [ -f "$f" ] && files+=("$f"); done
  fi
  [ "${#files[@]}" -gt 0 ] || { echo "cc-lr: no reconciler cohorts"; return 0; }
  for f in "${files[@]}"; do
    jq -er '.status as $s | $s.cid | type == "string"' "$f" >/dev/null 2>&1 || {
      echo "cc-lr: $f has no readable status (the reconciler may be mid-write); skipped" >&2
      bad=$((bad + 1)); continue; }
    jq -r '.status as $s
      | "cohort \($s.cid)  \($s.acct // "?") \($s.scope // "?")  "
        + ([($s.tally // {}) | to_entries[] | select(.value > 0) | "\(.value) \(.key)"] | join(" · ")),
        (if $s.dod then "DoD: \($s.dod)" else empty end),
        ( ($s.members // [])[]
          | [ "  " + ((.sid // "?")[0:8]),
              "pane " + (if (.pane | type) == "array" then (.pane | map(tostring) | join(":")) else "-" end),
              (.phase // "-") + (if .substate then "/" + .substate else "" end),
              "age " + (if (.age_s | type) == "number" then "\(.age_s | floor)s" else "-" end),
              "attempt \(.attempt // 0)",
              "err " + (.last_error // "-"),
              "next: " + (.next_action // "-"),
              "eta " + (if (.eta | type) == "number" then (.eta | floor | todate) else "-" end) ]
          | join("  ") )' "$f" 2>/dev/null || bad=$((bad + 1))
  done
  [ "$bad" -lt "${#files[@]}" ] || return 2
  return 0
}

cmd_status() {
  local ref="" f n out mt st
  local FILES
  while [ $# -gt 0 ]; do
    case "$1" in
      --cohort) shift
        # `--cohort [cid] [--root DIR]`: --root reads another reconciler state tree (the W5 rig's
        # /tmp/lr-rig/state), in either order after --cohort.
        local cid=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --root) [ -n "${2:-}" ] || { echo "cc-lr status: --root needs a directory" >&2; exit 3; }
                    RECON_ROOT="$2"; shift 2 ;;
            *) cid="$1"; shift ;;
          esac
        done
        cl_status_cohort "$cid"; return $? ;;
      --root) [ -n "${2:-}" ] || { echo "cc-lr status: --root needs a directory" >&2; exit 3; }
              RECON_ROOT="$2"; shift 2 ;;
      --all) ref=""; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "cc-lr status: unknown option $1" >&2; usage; exit 3 ;;
      *) ref="$1"; shift ;;
    esac
  done
  # An ARRAY, never a word-split string: $HOME and $LR_STATE_DIR may hold a space, and a split on
  # IFS would hand jq two halves of one path and read neither.
  FILES=()
  while IFS= read -r f; do [ -n "$f" ] && FILES+=("$f"); done <<EOF
$(cl_bundles "$ref" | LC_ALL=C sort)
EOF
  n="${#FILES[@]}"
  if [ "$n" -eq 0 ]; then
    # shellcheck disable=SC2016  # the single quotes are DISPLAY characters inside a
    # double-quoted string; $ref does expand. Quoting the ref is what makes an empty or
    # space-bearing ref legible in the refusal.
    echo "cc-lr: no runs under $STATE${ref:+ for '$ref'}" >&2
    return 1
  fi
  # ONE stat for every file: the mtime of events.jsonl IS the time of the last transition, and a
  # `date` fork per row would cost more than the whole render.
  mt="$(stat -f '%m %N' "${FILES[@]}" 2>/dev/null || stat -c '%Y %n' "${FILES[@]}" 2>/dev/null || true)"
  out="$(cl_events_bulk "${FILES[@]}")"
  if [ -z "$out" ]; then
    # FALLBACK — the SSOT per-file reader. Reached when jq refused the bulk read (one malformed
    # line aborts it) or when a run holds no parsable record at all.
    command -v lr_state_current >/dev/null 2>&1 || {
      echo "cc-lr: could not read any run state and lr-lib.sh is not reachable for the per-file fallback" >&2; return 2; }
    out=""
    for f in "${FILES[@]}"; do
      st="$(lr_state_current "$(dirname "$f")" 2>/dev/null || true)"
      [ -n "$st" ] && out="$out$f"$'\t'"-"$'\t'"$st"$'\t'"-"$'\t'"(read through lr_state_current)"$'\n'
    done
    [ -n "$out" ] || { echo "cc-lr: $n run(s) found and none holds a readable state" >&2; return 2; }
  fi
  # LIVENESS FOR THE `NEXT` COLUMN. `cc-lr repair` re-types a prompt INTO A PANE, so it cannot
  # apply to a run whose session is gone — and a NEXT that names a doomed command is worse than an
  # empty one, because the operator spends a round trip discovering it. Measured 2026-09-21 on the
  # live store: run 83c4f1b8/bundle-20260920T224329Z sat at FAILED:submit for 5h42m with the
  # session DEAD, and status recommended repair anyway.
  # FAIL-OPEN, deliberately: when lr-lib is unreachable we cannot tell, and an instrument that
  # cannot tell must not SUPPRESS a suggestion that may well be right. Unknown ⇒ today's behaviour.
  cl_live=""
  if command -v lr_registry_live_rows >/dev/null 2>&1; then
    cl_live=$'\n'
    for _cl_f in "${FILES[@]}"; do
      _cl_bd="$(dirname "$_cl_f")"; _cl_sid="$(basename "$(dirname "$_cl_bd")")"
      case "$cl_live" in *$'\n'"$_cl_sid"$'\n'*) continue ;; esac
      lr_registry_live_rows "$_cl_sid" >/dev/null 2>&1 && cl_live="$cl_live$_cl_sid"$'\n'
    done
  fi
  printf '%s\n' "$out" | CL_NOW="$(date +%s)" CL_MT="$mt" CL_LIVE="$cl_live" \
    CL_LIVE_KNOWN="$(command -v lr_registry_live_rows >/dev/null 2>&1 && echo 1 || echo 0)" awk -F'\t' '
    function klass(s) {
      if (s == "RECOVERED" || s == "DONE" || s == "ENGAGED" || s == "engaged") return "ok"
      if (s ~ /^FAILED/ || s ~ /^REFUSED/ || s ~ /^STALE/ || s ~ /^INDETERMINATE/ || s ~ /^PARKED/) return "bad"
      return "run"
    }
    function age(sec,   m,h) {
      if (sec < 0) sec = 0
      if (sec < 60) return sec "s"
      if (sec < 3600) { m = int(sec/60); return m "m" (sec - m*60) "s" }
      h = int(sec/3600); m = int((sec - h*3600)/60); return h "h" (m<10?"0":"") m "m"
    }
    BEGIN {
      now = ENVIRON["CL_NOW"] + 0
      nmt = split(ENVIRON["CL_MT"], mtl, "\n")
      for (i = 1; i <= nmt; i++) { p = index(mtl[i], " "); if (p) mtime[substr(mtl[i], p+1)] = substr(mtl[i], 1, p-1) + 0 }
    }
    {
      f = $1
      if (!(f in seen)) { seen[f] = 1; order[++nf] = f }
      lastS[f] = $3; lastD[f] = $5
      # TERMINAL STICKINESS, the contract lr-lib.sh:393-394 states: readers take the LAST line, and
      # a terminal line is sticky against a later NON-terminal one from a stale writer. A later
      # TERMINAL line still replaces an earlier one — a run that failed and then recovered has
      # recovered.
      if (klass($3) != "run") { termS[f] = $3; termD[f] = $5 }
    }
    END {
      printf "%-36s %-18s %-7s %s\n", "RUN", "STATE", "AGE", "CAUSE / NEXT"
      for (i = nf; i >= 1; i--) {
        f = order[i]
        s = lastS[f]; d = lastD[f]
        if (klass(s) == "run" && (f in termS)) { s = termS[f]; d = termD[f] }
        bdir = f; sub("/events\\.jsonl$", "", bdir)
        base = bdir; sub(".*/", "", base)
        sid = bdir; sub("/[^/]*$", "", sid); sub(".*/", "", sid)
        id = substr(sid, 1, 8) "/" base
        k = klass(s)
        # A dead session cannot be repaired: repair TYPES, and there is nothing to type into.
        livek = (ENVIRON["CL_LIVE_KNOWN"] == "1")
        alive = (index(ENVIRON["CL_LIVE"], "\n" sid "\n") > 0)
        if (k != "bad")            nextcmd = ""
        else if (!livek || alive)  nextcmd = " → cc-lr repair " bdir
        else                       nextcmd = " → source session is gone; repair types into a pane and cannot apply"
        cause = (d == "-" || d == "") ? "—" : d
        a = (f in mtime) ? age(now - mtime[f]) : "?"
        printf "%-36s %-18s %-7s %s%s\n", id, s, a, cause, nextcmd
      }
      printf "%d run%s under the state store\n", nf, (nf == 1 ? "" : "s")
    }'
  return 0
}

# ── repair ─────────────────────────────────────────────────────────────────────────────────────
# WRITES A REQUEST. IT NEVER TYPES. The daemon (lr-reset-poller.sh § 0) is the only thing that
# acts, and it acts outside every session and every classifier — which is the whole reason the
# request lane exists.
#
# THE SCHEMA IS FIXED BY ITS CONSUMER, verified 2026-09-20 at lr-reset-poller.sh:674-679:
#   .sid          REQUIRED — absent, the file is renamed `<name>.malformed.json` into results/ and
#                 is LOST, not retried. So a request whose sid cannot be derived is REFUSED here.
#   .target       default "auto"      .requested_by  default "?"
#   .source_pane  optional for relaunch; REQUIRED for mode prompt (lr-reset-poller.sh:1148 parks a
#                 prompt request without one as malformed), so cmd_repair resolves it or refuses.
#   .mode         W5-A is adding the consumer this wave. NOT READ BY THE POLLER ON THIS TREE — it
#                 is written per the W5 spec so the field is there when W5-A's reader lands, and
#                 an unread extra key is inert to jq. Re-check lr-reset-poller.sh before relying
#                 on it: `grep -n "'\''.mode'\''" scripts/limit-recover/lr-reset-poller.sh`.
# WRITE-THEN-RENAME: the poller's drain globs `$REQUESTS/*.json` and would otherwise be free to
# read a half-written file. The temp name is a DOTFILE with a .tmp suffix, which that glob cannot
# match on either axis.
cmd_repair() {
  local bundle="" mode="relaunch" target="auto" pane="" sid tmp dest by rc
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) [ $# -ge 2 ] || { usage; exit 3; }; mode="$2"; shift 2 ;;
      --target) [ $# -ge 2 ] || { usage; exit 3; }; target="$2"; shift 2 ;;
      --source-pane) [ $# -ge 2 ] || { usage; exit 3; }; pane="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "cc-lr repair: unknown option $1" >&2; usage; exit 3 ;;
      *) [ -z "$bundle" ] || { echo "cc-lr repair: one bundle, not two" >&2; exit 3; }
         bundle="$1"; shift ;;
    esac
  done
  [ -n "$bundle" ] || { usage; exit 3; }
  case "$mode" in
    relaunch|prompt) ;;
    *) cl_die "REFUSED — --mode '$mode' is neither 'relaunch' nor 'prompt'; nothing was written" 2 ;;
  esac
  # A bare sid/sid8 is accepted and resolves to that session's NEWEST bundle (D2 §1.3: an
  # identifier a tool PRINTS must be one it ACCEPTS, and `cc-lr status` prints the sid8).
  if [ ! -d "$bundle" ]; then
    local resolved
    resolved="$(cl_newest_bundle "$bundle" || true)"
    [ -n "$resolved" ] || cl_die "REFUSED — '$bundle' is neither a bundle directory nor a sid with a run under $STATE; nothing was written" 2
    bundle="$resolved"
  fi
  # THE SID IS THE BUNDLE'S PARENT DIRECTORY NAME (lr-handoff.sh:479 — `<state>/$SID/bundle-$TS`).
  # Refuse anything that is not a full session uuid: a short or malformed sid produces a request
  # the poller cannot execute, and its failure mode is LOSS (renamed .malformed.json), not a retry.
  sid="$(basename "$(dirname "$bundle")")"
  case "$sid" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*-*-*-*) ;;
    *) cl_die "REFUSED — '$bundle' does not sit under a session-uuid directory (read '$sid'), so .sid cannot be derived. The poller DISCARDS a request with no sid (lr-reset-poller.sh:675), so nothing was written" 2 ;;
  esac
  command -v jq >/dev/null 2>&1 || cl_die "jq is not on PATH; a hand-built request risks a malformed line and nothing was written" 2
  # MODE PROMPT TYPES INTO A PANE, SO IT NEEDS ONE. The poller parks a prompt request with no
  # .source_pane as `.malformed.json` and never retries it (lr-reset-poller.sh:1148) — measured
  # 2026-10-01: three repairs queued without --source-pane were all lost that way while cc-lr
  # reported "queued". Resolve the pane from the registry; refuse when it cannot be named.
  if [ "$mode" = prompt ] && [ -z "$pane" ]; then
    local row
    row="$(cl_resolve "$sid" 2>/dev/null || true)"
    pane="$(printf '%s' "$row" | cut -f2)"
    case "$pane" in
      ''|-) cl_die "REFUSED — --mode prompt types into the session's pane and no live pane holds ${sid:0:8}; pass --source-pane <P>. The poller DISCARDS a prompt request with no pane (lr-reset-poller.sh:1148), so nothing was written" 2 ;;
    esac
  fi

  by="$(cl_this_pane)"
  mkdir -p "$REQ_DIR" 2>/dev/null || cl_die "cannot create $REQ_DIR" 2
  tmp="$REQ_DIR/.cc-lr-repair-$sid.$$.tmp"
  dest="$REQ_DIR/cc-lr-repair-$sid.json"
  jq -n --arg sid "$sid" --arg target "$target" --arg pane "$pane" --arg by "${by:-?}" \
        --arg mode "$mode" --arg bundle "$bundle" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     '{sid:$sid, target:$target, source_pane:$pane, requested_by:$by, mode:$mode, bundle:$bundle, ts:$ts, origin_class:"cc-lr-repair"}' \
     > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null || true; cl_die "could not write the request; nothing was queued" 2; }
  mv -f "$tmp" "$dest" 2>/dev/null || { rm -f "$tmp" 2>/dev/null || true; cl_die "could not place $dest; nothing was queued" 2; }
  echo "cc-lr: queued $dest  (sid ${sid:0:8} · mode $mode · target $target · requested_by ${by:-?})"

  # THE KICK IS NON-FATAL, AND IT IS A `kickstart` WITH NO `-k`. `-k` KILLS a running poller first,
  # and a tick that is mid-transplant is exactly the one a caller has just enqueued work for
  # (lr-fleet.sh:893-896 makes the same argument and only ECHOES the command; bin/cc-fleet:56 says
  # it deliberately holds no launchctl verb). The request is already on disk and the poller's
  # StartInterval will drain it regardless, so a failed kick delays the work, it does not lose it —
  # print the command and let the operator run it.
  if command -v launchctl >/dev/null 2>&1; then
    rc=0; launchctl kickstart "gui/$(id -u)/$POLLER_LABEL" >/dev/null 2>&1 || rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "cc-lr: the kick failed (rc $rc) — the request is queued and the poller's own interval will drain it. To run it now:" >&2
      echo "  launchctl kickstart gui/$(id -u)/$POLLER_LABEL" >&2
    fi
  else
    echo "cc-lr: launchctl(1) is unavailable — the request is queued; kick it with:" >&2
    echo "  launchctl kickstart gui/$(id -u)/$POLLER_LABEL" >&2
  fi
  return 0
}

# ── repair-markers ─────────────────────────────────────────────────────────────────────────────
# STALE HANDOFF MARKERS (2026-10-04). A store holding a session's LIVE transcript beside an OLDER
# `<sid>.HANDOFF.json` that points away, while the other store's NEWER marker points back: a round
# trip nothing swept. hooks/handed-off-session-guard.sh then refuses every prompt in that live pane
# (762a6daa, 8e18da3f, measured). THE RENAME IS NEVER THIS VERB'S: auto mode refuses an agent renaming
# files under ~/.claude*, so the launchd drainer does it (lr-upgrade.sh --drain, kind marker-setaside),
# re-judging each sid at execution time. This verb asks the ONE classifier (lr-upgrade.sh
# --stale-markers), prints it, and writes one request per STALE sid straight into the drainer's queue
# — the shape lr-upgrade --auto-enqueue already writes there; the poller kicks the drainer every tick
# the queue holds work — then waits for each verdict (results/markers-<sid>.json, matched by req_id).
# rc 0 every verdict SETASIDE/NOTHING (or nothing stale) · 1 any FAILED/KEPT/pending · 2 refused · 3 usage
cmd_repair_markers() {
  local sid="" dry=0 rows rc s st v why ret rv sids="" nst=0 nbad=0 by req tmp dest q pending="" note
  while [ $# -gt 0 ]; do
    case "$1" in
      --sid) [ $# -ge 2 ] || { usage; exit 3; }; sid="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) echo "cc-lr repair-markers: unknown argument $1" >&2; usage; exit 3 ;;
    esac
  done
  if [ -n "$sid" ]; then
    case "$sid" in ''|*[!0-9a-f-]*) cl_die "REFUSED — --sid '$sid' is neither a session uuid nor a sid8; nothing was written" 2 ;; esac
  fi
  command -v jq >/dev/null 2>&1 || cl_die "jq is not on PATH; nothing was read or written" 2
  [ -n "$UPGRADE_BIN" ] && [ -f "$UPGRADE_BIN" ] || cl_die "cannot reach lr-upgrade.sh (set CC_LR_UPGRADE_BIN); nothing was read or written" 2
  rows="$(bash "$UPGRADE_BIN" --stale-markers)"; rc=$?
  [ "$rc" -eq 0 ] || cl_die "the marker classifier failed (rc $rc); nothing was written" 2
  if [ -n "$sid" ]; then
    rows="$(printf '%s\n' "$rows" | awk -F'\t' -v p="$sid" 'NF && index($1, p) == 1')"
    if [ "$(printf '%s\n' "$rows" | awk -F'\t' 'NF { print $1 }' | sort -u | grep -c .)" -gt 1 ]; then
      echo "cc-lr repair-markers: REFUSED — '$sid' matches more than one session; pass the full uuid. Nothing was written. Candidates:" >&2
      printf '%s\n' "$rows" | awk -F'\t' 'NF { print "  " $1 }' | sort -u >&2
      return 2
    fi
  fi
  if [ -z "$(printf '%s' "$rows" | tr -d '[:space:]')" ]; then
    echo "cc-lr repair-markers: no handoff marker sits beside a live transcript${sid:+ for $sid}; nothing to repair"
    return 0
  fi
  while IFS=$'\t' read -r s st _ v why ret rv; do
    [ -n "$s" ] || continue
    case "$rv" in
      STALE-RETIRED) note=" · old retired copy is a prefix of the live one: set aside too" ;;
      KEPT) note=" · retired copy $ret kept (it holds bytes the live transcript lacks)" ;;
      *) note="" ;;
    esac
    printf '%-5s %s  %s · %s%s\n' "$v" "${s:0:8}" "$st" "$why" "$note"
    if [ "$v" = STALE ]; then
      case " $sids " in *" $s "*) ;; *) sids="$sids $s"; nst=$((nst + 1)) ;; esac
    fi
  done <<EOF
$rows
EOF
  if [ "$nst" -eq 0 ]; then echo "0 stale marker(s): nothing to set aside"; return 0; fi
  if [ "$dry" -eq 1 ]; then echo "$nst stale marker(s) · DRY RUN: nothing was written"; return 0; fi
  by="$(cl_this_pane)"
  q="$STATE/upgrade-queue"
  mkdir -p "$q" 2>/dev/null || cl_die "cannot create $q; nothing was queued" 2
  for s in $sids; do
    req="${s:0:8}-$(date +%s)-$$-markers"
    tmp="$q/.cc-lr-markers-$s.$$.tmp"; dest="$q/cc-lr-markers-$s.json"
    if jq -n --arg sid "$s" --arg by "${by:-?}" --arg req "$req" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         '{kind:"marker-setaside", sid:$sid, source_pane:"-", requested_by:$by, req_id:$req, ts:$ts, origin_class:"cc-lr-repair-markers"}' \
         > "$tmp" 2>/dev/null && mv -f "$tmp" "$dest" 2>/dev/null; then
      pending="$pending$s"$'\t'"$req"$'\n'
      echo "cc-lr: queued $dest (the drainer re-judges ${s:0:8} before it renames anything)"
    else
      rm -f "$tmp" 2>/dev/null || true
      echo "cc-lr: could not write $dest; ${s:0:8} was not queued" >&2; nbad=$((nbad + 1))
    fi
  done
  # `kickstart` with NO `-k` — the rule every request writer here follows (see cmd_repair).
  if [ -n "$pending" ] && command -v launchctl >/dev/null 2>&1; then
    launchctl kickstart "gui/$(id -u)/$POLLER_LABEL" >/dev/null 2>&1 \
      || echo "cc-lr: the kick failed — the poller's own interval will start the drainer" >&2
  fi
  local deadline left still f rreq fv fr
  deadline=$(( $(date +%s) + ${CC_LR_MARKERS_WAIT_S:-120} ))
  left="$pending"
  while [ -n "$left" ]; do
    still=""
    while IFS=$'\t' read -r s req; do
      [ -n "$s" ] || continue
      f="$STATE/results/markers-$s.json"
      rreq="$(jq -r '.req_id // empty' "$f" 2>/dev/null || true)"
      if [ -n "$rreq" ] && [ "$rreq" = "$req" ]; then
        fv="$(jq -r '.verdict // "FAILED"' "$f" 2>/dev/null)"; fr="$(jq -r '.reason // "-"' "$f" 2>/dev/null)"
        printf '%-8s %s  %s\n' "$fv" "${s:0:8}" "$fr"
        case "$fv" in SETASIDE|NOTHING) ;; *) nbad=$((nbad + 1)) ;; esac
      else
        still="$still$s"$'\t'"$req"$'\n'
      fi
    done <<EOF2
$left
EOF2
    left="$still"
    [ -n "$left" ] || break
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep "${CC_LR_MARKERS_POLL_S:-3}"
  done
  if [ -n "$left" ]; then
    printf '%s' "$left" | while IFS=$'\t' read -r s req; do
      [ -n "$s" ] && printf 'pending  %s  queued; the drainer has not answered yet (its verdict lands in %s and as mail)\n' "${s:0:8}" "$STATE/results/markers-$s.json"
    done
    nbad=$((nbad + 1))
  fi
  [ "$nbad" -eq 0 ] || return 1
  return 0
}

# ── upgrade ────────────────────────────────────────────────────────────────────────────────────
# MOVE IDLE LIVE SESSIONS ONTO THE CURRENT BINARY + MODEL, IN PLACE (2026-09-22). The mirror of
# `repair`'s shape, for the same reason: acting on ANOTHER live session from inside a session is
# refused by auto mode's classifier, so this verb never acts. It reads (the census is
# lr-upgrade.sh --census, one ps snapshot, no keystroke) and it WRITES REQUESTS; the launchd poller
# queues them and one detached drainer relaunches the sessions one at a time, re-judging each at
# execution time and probing capacity BEFORE the /exit. Then it waits for the drainer's verdicts
# (bounded) and renders one line per session. Design + the seven defects this closes:
# scripts/limit-recover/lr-upgrade.sh header; the verb's doc: commands/limit-recover.md § Mode: upgrade.
cl_short_bin() { # $1=binary path → ".claude-280"-style label, else its basename
  printf '%s\n' "$1" | awk -F/ '{ for (i = 1; i <= NF; i++) if ($i ~ /^\.claude-/) { print $i; exit } ; print $NF }'
}
cl_upgrade_line() { # <pane> <sid> <verdict> <reason> <command>
  case "$3" in
    upgraded) printf '✓ %-5s %s  upgraded — %s\n' "$1" "${2:0:8}" "$4" ;;
    skipped)  printf '· %-5s %s  skipped %s\n' "$1" "${2:0:8}" "$4" ;;
    *)        printf '✗ %-5s %s  failed %s\n' "$1" "${2:0:8}" "$4"
              [ -n "$5" ] && printf '          in that pane run: %s\n' "$5" ;;
  esac
}
cl_upgrade_result() { # <result json> → the fields cl_upgrade_line takes, TAB-separated
  jq -r '[.pane // "-", .sid // "-", .verdict // "failed", .reason // "-", .command // ""] | @tsv' "$1" 2>/dev/null
}
cmd_upgrade() {
  local all=0 ref="" dry=0 report=0 wait_s="${CC_LR_UPGRADE_WAIT_S:-1800}" census rc by scrub=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      --scrub-composer) [ $# -ge 2 ] || { usage; exit 3; }; scrub="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --report) report=1; shift ;;
      --no-wait) wait_s=0; shift ;;
      --wait) [ $# -ge 2 ] || { usage; exit 3; }; wait_s="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "cc-lr upgrade: unknown option $1" >&2; usage; exit 3 ;;
      *) [ -z "$ref" ] || { echo "cc-lr upgrade: one ref, not two ('$ref' and '$1')" >&2; exit 3; }
         ref="$1"; shift ;;
    esac
  done
  case "$wait_s" in ''|*[!0-9]*) echo "cc-lr upgrade: --wait takes whole seconds" >&2; exit 3 ;; esac
  command -v jq >/dev/null 2>&1 || cl_die "jq is not on PATH; nothing was read or written" 2
  if [ "$report" -eq 1 ]; then
    local f n=0 fields
    for f in "$STATE"/results/upgrade-*.json; do
      [ -f "$f" ] || continue
      [ -n "$(find "$f" -mmin -1440 2>/dev/null)" ] || continue
      fields="$(cl_upgrade_result "$f")"; [ -n "$fields" ] || continue
      IFS=$'\t' read -r _p _s _v _r _c <<EOF
$fields
EOF
      cl_upgrade_line "$_p" "$_s" "$_v" "$_r" "$_c"; n=$((n + 1))
    done
    [ "$n" -gt 0 ] || { echo "cc-lr: no upgrade verdicts in the last 24h under $STATE/results" >&2; return 1; }
    return 0
  fi
  # EXACTLY ONE SUBJECT: `--all` or a ref. A bare `cc-lr upgrade` relaunching the whole fleet by
  # default is the one accident this verb must not make easy.
  if { [ "$all" -eq 1 ] && [ -n "$ref" ]; } || { [ "$all" -eq 0 ] && [ -z "$ref" ]; }; then
    echo "cc-lr upgrade: name the subject — --all, or ONE pane id / sid8" >&2; usage; exit 3
  fi
  # --scrub-composer TEXT: the requester has READ the pane's composer and names its exact content as
  # a stray (an accidental keystroke blocking the move). It is honoured ONLY for one named pane and
  # ONLY while the composer still holds exactly that text, at census and again at drive time; any
  # other content is still somebody's draft. Never with --all: a fleet-wide scrub is the accident.
  if [ -n "$scrub" ] && [ -z "$ref" ]; then
    echo "cc-lr upgrade: --scrub-composer names ONE pane's exact composer text; it never applies to --all" >&2; exit 3
  fi
  [ -n "$UPGRADE_BIN" ] && [ -f "$UPGRADE_BIN" ] || cl_die "cannot reach lr-upgrade.sh (set CC_LR_UPGRADE_BIN); nothing was read or written" 2
  census="$(LRU_SCRUB_EXACT="$scrub" bash "$UPGRADE_BIN" --census "${ref:---all}")"; rc=$?
  case "$rc" in
    0) ;;
    1) echo "cc-lr: '${ref:-all}' matched no live session" >&2; return 1 ;;
    *) cl_die "the census failed (rc $rc); nothing was written" 2 ;;
  esac
  if [ -n "$ref" ] && [ "$(printf '%s\n' "$census" | grep -c .)" -gt 1 ]; then
    echo "cc-lr: REFUSED — '$ref' matched more than one live session; pass the pane id. Nothing was written. Candidates:" >&2
    printf '%s\n' "$census" | cut -f1,2 >&2
    return 2
  fi

  if [ "$dry" -eq 1 ]; then
    printf '%-5s %-8s  %-12s %-34s %s\n' PANE SID BINARY 'MODEL → TARGET' DISPOSITION
    printf '%s\n' "$census" | while IFS=$'\t' read -r p s b m t _ _ _ _ _ d; do
      [ -n "$p" ] || continue
      printf '%-5s %-8s  %-12s %-34s %s\n' "$p" "${s:0:8}" "$(cl_short_bin "$b")" "$m → $t" "$d"
    done
    printf 'target binary: %s · %s to upgrade · DRY RUN: nothing was written or typed\n' \
      "$(cl_short_bin "$("$_CL_BIN/cc-claude-bin" 2>/dev/null || echo '?')")" \
      "$(printf '%s\n' "$census" | awk -F'\t' '$11 ~ /^upgrade(-teammate|-lead)?$/' | grep -c .)"
    return 0
  fi

  # ── write one request per candidate; report every other row as skipped, now ────────────────
  local pending="" p s d req tmp dest nq=0 nfail=0 out=""
  by="$(cl_this_pane)"
  mkdir -p "$REQ_DIR" 2>/dev/null || cl_die "cannot create $REQ_DIR" 2
  while IFS=$'\t' read -r p s _ _ _ _ _ _ _ _ d; do
    [ -n "$p" ] || continue
    if [ "$d" = current ]; then continue; fi
    case "$d" in upgrade|upgrade-teammate|upgrade-lead) ;; *) out="$out$(cl_upgrade_line "$p" "$s" skipped "$d" "")"$'\n'; continue ;; esac
    req="${s:0:8}-$(date +%s)-$$"
    tmp="$REQ_DIR/.cc-lr-upgrade-$s.$$.tmp"; dest="$REQ_DIR/cc-lr-upgrade-$s.json"
    if jq -n --arg sid "$s" --arg pane "$p" --arg by "${by:-?}" --arg req "$req" \
          --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg scrub "$scrub" \
          '{kind:"upgrade", sid:$sid, source_pane:$pane, requested_by:$by, req_id:$req, ts:$ts, origin_class:"cc-lr-upgrade"} + (if $scrub == "" then {} else {scrub_composer:$scrub} end)' \
          > "$tmp" 2>/dev/null && mv -f "$tmp" "$dest" 2>/dev/null; then
      pending="$pending$s"$'\t'"$req"$'\t'"$p"$'\n'; nq=$((nq + 1))
    else
      rm -f "$tmp" 2>/dev/null || true
      out="$out$(cl_upgrade_line "$p" "$s" failed "could not write the request into $REQ_DIR" "")"$'\n'; nfail=$((nfail + 1))
    fi
  done <<EOF
$census
EOF
  printf 'cc-lr: %d upgrade request(s) queued for the poller (requested_by %s)\n' "$nq" "${by:-?}"
  if [ "$nq" -gt 0 ] && command -v launchctl >/dev/null 2>&1; then
    # `kickstart` with NO `-k` — the same rule as `repair`: a tick mid-flight is left to finish.
    launchctl kickstart "gui/$(id -u)/$POLLER_LABEL" >/dev/null 2>&1 \
      || echo "cc-lr: the kick failed — the poller's own interval will drain the queue" >&2
  fi
  printf '%s' "$out"

  # ── wait for the drainer's verdicts, bounded; it runs detached and outlives this process ───
  local deadline left f fields rs rreq
  deadline=$(( $(date +%s) + wait_s ))
  left="$pending"
  while [ -n "$left" ]; do
    local still=""
    while IFS=$'\t' read -r s req p; do
      [ -n "$s" ] || continue
      f="$STATE/results/upgrade-$s.json"
      rreq="$(jq -r '.req_id // empty' "$f" 2>/dev/null || true)"
      if [ -n "$rreq" ] && [ "$rreq" = "$req" ]; then
        fields="$(cl_upgrade_result "$f")"
        IFS=$'\t' read -r _p _s rs _r _c <<EOF2
$fields
EOF2
        cl_upgrade_line "$_p" "$_s" "$rs" "$_r" "$_c"
        [ "$rs" = failed ] && nfail=$((nfail + 1))
      else
        still="$still$s"$'\t'"$req"$'\t'"$p"$'\n'
      fi
    done <<EOF3
$left
EOF3
    left="$still"
    [ -n "$left" ] || break
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep "${CC_LR_UPGRADE_POLL_S:-5}"
  done
  if [ -n "$left" ]; then
    printf '%s' "$left" | while IFS=$'\t' read -r s req p; do
      [ -n "$s" ] && printf '… %-5s %s  pending — queued; the drainer is still working (cc-lr upgrade --report)\n' "$p" "${s:0:8}"
    done
  fi
  [ "$nfail" -eq 0 ] || return 1
  return 0
}

# ── accounts --limited: the reconciler's limit facts (W4) ──────────────────────────────────────
# facts.limited_rows is the one definition of "still limited" (a fact whose reset has not passed,
# with the grace the expiry uses), so it is CALLED, never re-derived here. The layout is cc-limited's:
# one header per account, its limited scopes beneath.
cl_recon_pkg() { # → the directory holding lr_recon/, script-relative first
  local d
  for d in "$_CL_BIN/../scripts/limit-recover" "$HOME/.claude/scripts/limit-recover"; do
    [ -f "$d/lr_recon/facts.py" ] && { (cd "$d" && pwd); return 0; }
  done
  return 1
}
cmd_accounts() {
  local lim=0 pkg
  while [ $# -gt 0 ]; do
    case "$1" in
      --limited) lim=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) echo "cc-lr accounts: unknown argument $1" >&2; usage; exit 3 ;;
    esac
  done
  [ "$lim" -eq 1 ] || { echo "cc-lr accounts: name what to list — --limited (the reconciler's limit facts); for quota use claude-accounts" >&2; exit 3; }
  pkg="$(cl_recon_pkg)" || cl_die "cannot reach scripts/limit-recover/lr_recon; nothing was read" 2
  LR_STATE_DIR="$STATE" LR_RECON_ROOT="$RECON_ROOT" PYTHONPATH="$pkg${PYTHONPATH:+:$PYTHONPATH}" python3 -c '
import sys, time
from lr_recon import facts as F
from lr_recon import types as T

now = time.time()
rows = F.limited_rows(F.load_facts(T.Paths.from_env()), now)
if not rows:
    print("cc-lr: no limited accounts in the reconciler facts")
    sys.exit(0)


def when(ts):
    if ts is None:
        return "no reset known"
    at = time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime(ts))
    left = int(ts - now)
    if left <= 0:
        return "resets %s (passed)" % at
    h, m = divmod(left // 60, 60)
    return "resets %s (in %dh%02dm)" % (at, h, m)


groups = {}
for r in rows:
    groups.setdefault(r["acct"], []).append(r)
for acct in sorted(groups):
    members = groups[acct]
    print("%-7s %d limited scope%s" % (acct, len(members), "" if len(members) == 1 else "s"))
    for r in members:
        flags = [k for k in ("contradicted", "untested") if r.get(k)]
        print("  %-12s %-38s src=%s%s" % (r["scope"], when(r["resets_at"]), r["src"] or "-",
                                          "  " + ",".join(flags) if flags else ""))
' || cl_die "could not read the reconciler facts under $RECON_ROOT/facts" 2
}

# ── cohort refire: reset ONE member's retry budget (W4) ────────────────────────────────────────
# The daemon owns the budget; this only drops a ctl request it watches (recon/ctl/ is in its kqueue
# set), so the verb stays inside this file's iron rule — it writes, and something else acts.
cl_recon_sid() { # <sid|sid8|pane> → the full sid on stdout; rc 1 no match · 2 ambiguous
  local ref="$1" f hits="" n=0 row
  for f in "$RECON_ROOT/sessions/$ref"*.json; do
    [ -f "$f" ] || continue
    hits="$(basename "$f" .json)"; n=$((n + 1))
  done
  if [ "$n" -eq 1 ]; then printf '%s' "$hits"; return 0; fi
  if [ "$n" -gt 1 ]; then echo "cc-lr: REFUSED — '$ref' names $n reconciler records; pass the full sid" >&2; return 2; fi
  # No record by that name: a bare number is a pane id, and cc-find is the pane resolver.
  case "$ref" in *[!0-9]*) echo "cc-lr: '$ref' names no reconciler record under $RECON_ROOT/sessions" >&2; return 1 ;; esac
  row="$(cl_resolve "$ref")" || return $?
  printf '%s' "$row" | cut -f1
}
cmd_cohort() {
  local sub="${1:-}" ref sid dir dest tmp
  [ $# -gt 0 ] && shift
  case "$sub" in
    refire) ;;
    -h|--help) usage; exit 0 ;;
    *) echo "cc-lr cohort: unknown or missing verb '${sub}' — expected: cc-lr cohort refire <sid|sid8|pane>" >&2; exit 3 ;;
  esac
  [ $# -eq 1 ] || { echo "cc-lr cohort refire: exactly one ref (sid, sid8 or pane id)" >&2; exit 3; }
  ref="$1"
  case "$ref" in ''|*[!0-9a-fA-F-]*) echo "cc-lr cohort refire: '$ref' is not a sid, sid8 or pane id" >&2; exit 3 ;; esac
  sid="$(cl_recon_sid "$ref")" || exit $?
  [ -n "$sid" ] || exit 1
  dir="$RECON_ROOT/ctl"
  mkdir -p "$dir" 2>/dev/null || cl_die "cannot create $dir; nothing was written" 2
  dest="$dir/$sid.refire.json"; tmp="$dir/.$sid.refire.$$.tmp"
  if printf '{"sid":"%s","at":%s,"by":"cc-lr"}\n' "$sid" "$(date +%s)" > "$tmp" 2>/dev/null \
     && mv -f "$tmp" "$dest" 2>/dev/null; then
    printf '%s\n' "$dest"
    return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  cl_die "could not write $dest; nothing was requested" 2
}

# ── argv ───────────────────────────────────────────────────────────────────────────────────────
[ $# -ge 1 ] || { usage; exit 3; }
CMD="$1"; shift
case "$CMD" in
  -h|--help) usage; exit 0 ;;
  # A PASSTHROUGH, verbatim argv. `exec` so there is no second process and no second copy of
  # cc-find's option semantics — this verb must never become a re-spelling of the resolver.
  find) [ -f "$FIND_BIN" ] || cl_die "cannot reach cc-find at $FIND_BIN" 3
        exec bash "$FIND_BIN" "$@" ;;
  recover) cmd_recover "$@"; exit $? ;;
  switch)  cmd_switch  "$@"; exit $? ;;
  status)  cmd_status  "$@"; exit $? ;;
  repair)  cmd_repair  "$@"; exit $? ;;
  repair-markers) cmd_repair_markers "$@"; exit $? ;;
  upgrade) cmd_upgrade "$@"; exit $? ;;
  accounts) cmd_accounts "$@"; exit $? ;;
  cohort)  cmd_cohort  "$@"; exit $? ;;
  *) echo "cc-lr: unknown subcommand '$CMD' — expected find | recover | switch | status | repair | repair-markers | upgrade | accounts | cohort (status --cohort, accounts --limited, cohort refire)" >&2
     usage; exit 3 ;;
esac
