#!/usr/bin/env bash
# cc-memory-rotate — the deterministic ACTUATOR for the MEMORY.md loader budget: when the
# auto-loaded index nears its read limit, move the least-load-bearing, closed-out index lines
# VERBATIM to the cold record, restoring headroom with no model and no human in the loop.
#
# ── WHY AN ACTUATOR, NOT A BETTER NAG ────────────────────────────────────────────────────────
# The loader reads MEMORY.md up to a hard limit (25,000 CHARS of the stripped, trimmed content —
# not the 24,985 raw bytes this file assumed until 2026-08-15; see THE UNIT below) and SILENTLY
# DROPS THE TAIL — the newest entries. Between 2026-07-25 and 2026-08-07 this index was hand-compacted at least
# TWELVE times (memory/archive/ holds every pre-compaction snapshot, size in the filename) and
# re-breached every time. The reason is arithmetic, not discipline: insertion is machine-speed
# (sessions mint 7–19 entries/day at ~244 B/line, through Edit AND through Bash `>>` appends
# the PreToolUse byte-gate never sees — one caught live 2026-08-10T07:51Z), while removal was
# human-speed (a /compact-memory pass with per-line judgment). At the measured ~0.5–2 KB/day
# growth, the sanctioned "done" of ~2.5 KB headroom is 1–5 DAYS of runway — the daily "index
# is full" nag was that arithmetic's steady state. No compaction can buy weeks of room under a
# fixed ~25 KB cap; the only durable quiet is a mechanism that restores headroom as fast as
# sessions consume it. `hooks/memory-nudge.sh` invokes this on every prompt (fleet-wide), so
# whichever door grew the file, the next prompt anywhere rotates it back under budget.
#
# ── WHAT IT DOES ─────────────────────────────────────────────────────────────────────────────
# Mechanizes the operator-approved cold split (2026-07-30, commands/compact-memory.md § the
# two-tier hot/cold split): at/over ROTATE_AT, move ELIGIBLE `- [...](file.md) — hook` lines,
# oldest-first by topic mtime, out of the index until it is at/under TARGET.
#
# 🚨 WHERE THEY GO CHANGED 2026-09-04. A selected line is now ROUTED to the project's
# always-loaded rules file when route_veto permits, and COLD-recorded only when it does not.
# Cold is a DEMOTION — archive/MEMORY_ARCHIVE_*-COLD.md does not auto-load, so holding the
# loader cap used to cost the reader the rule. The rules file has no cap of that size and loads
# unprompted, so a routed line is on a different SURFACE, not a colder one; the reader keeps it.
# route_veto is unchanged and is not weakened by this: PINNED, the feedback-/reference-/user-
# name convention and an operator-voice `type:` stamp still send a line to the cold record, so
# on an index whose entries are nearly all `reference-` this routes NOTHING — the correct
# outcome while "may the machine move a reference- lesson" remains an open operator decision.
# With no destination resolvable (no --rules-file, no MEMORY_RULES_FILE, no CLAUDE_PROJECT_DIR)
# every line takes the cold path exactly as before, and the verdict says `route=<reason>`.
#
# Either way lines move VERBATIM under a dated boundary comment; topic files
# are never touched; restore = paste the line back. This is the reversible, budget-
# authorized class — NOT the lossy PROPOSE-ONLY half of /compact-memory (shortening and
# dedupe stay human-gated there).
#
# TWO CAPS (2026-08-15). The loader reads "the first 200 lines or 25KB, whichever comes first",
# so ROTATE_AT/TARGET each have a line-counted twin (ROTATE_AT_LINES/TARGET_LINES) and the rotor
# arms on EITHER and stops only when BOTH are satisfied. Bytes alone was not a safe proxy: it
# holds only above 25000/200 = 125 B/line, and a terse index (200 lines at 100 B/line = 20 KB)
# sat under every byte threshold here while the loader dropped its tail. Rotation is the right
# actuator for both, and for the line cap it is the ONLY one — shortening a hook frees bytes and
# cannot free a line.
#
# ── WHAT IT REFUSES TO MOVE (protection, in evaluation order) ────────────────────────────────
#   the newest TAIL_GUARD index lines        — the tail is what the loader drops when over;
#                                              rotation must restore it, never eat it
#   unparseable lines · dangling links       — report, never touch (compact-memory: a dangling
#                                              link is reported, never auto-removed)
#   lines containing PINNED                  — explicit opt-out
#   type feedback|user|reference (topic      — operator directives + tooling entrypoints stay
#     frontmatter) or that name prefix         hot (selection rule, 2026-07-30). The frontmatter
#                                              stamp for feedback/reference YIELDS at breach
#                                              pressure (index >= LIMIT) — see the two-stage
#                                              note at protect_reason; the name convention and
#                                              user-type never yield.
#   live-pending markers (DEFERRED, NOT      — an open tail is live state (SAFE-AUTO marker
#     pushed, pending, gated on, BLOCKED,      list); over-matching PROTECTS, so the error
#     backlog, word-bounded open)              direction is keep
#   graph hubs: >=4 inbound [[links]]        — load-bearing in the graph
#   young: topic mtime < MIN_AGE_DAYS        — mtime, not birthtime: corrections bump mtime,
#                                              so an old-but-ACTIVE rule stays hot
#   MIN_KEEP floor on the remaining count
#
# ── SAFETY SHAPE ─────────────────────────────────────────────────────────────────────────────
# COLD is written idempotently (a line already present is not duplicated) and VERIFIED
# line-by-line BEFORE the index is rewritten, so a crash between the two leaves at worst a
# duplicate in the record, never a lost line. The index rewrite is temp+rename with a stat
# re-check and bounded retry — a sibling session's append between our read and our write
# restarts the cycle instead of being clobbered. The lock is mkdir-based (macOS has no
# flock(1)); stale locks (>180 s) are reclaimed. Every exit prints ONE parseable `verdict=`
# token on stdout (MEMORY.md claimed-outcome-vs-checked-outcome) and rotations append to
# archive/.rotate.log. A side-car must never fail wider than itself: any unexpected state is
# verdict=error with the index untouched.
#
# ── HOW TO BUILD A CONTROL FOR THIS PROGRAM, AND THE ONE THAT LOOKS RIGHT AND IS NOT ─────────
# `verdict=exhausted` UNDER the limit is the designed hold, not a stall: stage 2 arms only at
# breach (index >= LIMIT), so below it every entry is legitimately protected and moved=0. Proving
# that requires pushing a COPY past the cap — and the obvious copy is wrong.
#
# 🚨 `cp -R` IS A MUTATION OF THIS PROGRAM'S INPUT. The `young` rule reads TOPIC-FILE MTIME
# (line 54), so a copy without `-p` restamps every topic to now and re-classifies the corpus.
# Measured 2026-08-21 on the claude-infrastructure index: `cp -R` gave young=26 hub=0 where the
# live index gives young=11 hub=15, and at a real breach the rotor returned `exhausted moved=0` —
# which reads exactly like "the rotor cannot hold the breach line" and is purely the artifact.
# With `cp -Rp` the same breach returned `rotated moved=29 stage2=29`, 25873 -> 20949 units, i.e.
# back under the 25000 cap with 4051 units of headroom. The self-heal works.
#
# So the control's precondition is an EQUALITY, not a hope: run --dry-run on the untouched copy
# first and require its keep-classes (tail/type/hub/young/marker) to match the live index's
# verdict token exactly. If they differ, the copy is not the subject and no verdict from it counts.
#
# ── --drain-oversized: THE ROUTING MOVE, WHICH IS NOT AN EVICTION ────────────────────────────
# A SECOND, NARROW mode that shares this file's commit machinery and NONE of its selection policy.
# It moves index lines whose OWN unit length exceeds MEMORY_ENTRY_LIMIT (mim_entry_limit, 300) to
# the project's ALWAYS-LOADED rules file, verbatim, whole lines. Nothing is shortened, nothing is
# archived, and the destination still loads unprompted — so this is a change of surface, not a
# demotion. Restore = paste the line back.
#
# 🚨 WHY THE TAIL GUARD DOES NOT BIND HERE, AND WHY THAT IS NOT A HOLE. TAIL_GUARD exists for ONE
# reason: the loader drops the tail when the index is over, so a rotation that ate the newest
# entries would delete exactly what the cap was already hiding. That argument is about the
# DESTINATION being cold. Here it is not — the rules file is read on every session start with no
# cap this size — so the guard is protecting the newest entry from a harm this path cannot do. It
# has to yield, and not as a concession: a freshly written over-cap entry is ALWAYS inside the
# guard (it is the newest line by construction), so a drain that honoured it could never fire on
# the one case it exists for. The same reasoning retires `young`, `marker` and `hub` on this path:
# every one of them means "keep this on the hot surface", and the destination is the hot surface.
#
# WHAT STILL BINDS, ABSOLUTELY (route_veto below): PINNED, the feedback-/reference-/user- NAME
# convention, a frontmatter `type:` of user/feedback/reference, and unparseable/dangling lines.
# Those are not hot-surface protections — they are the operator's voice and the report-never-touch
# rule, and the plan carries the veto upstream to the routing gate on purpose. `reference-` is
# kept here even though a later phase may let it yield at breach: that yield is gated on operator
# ratification which has not been given, and the conservative direction is not to move it.
#
# Normal rotation is reached by a DIFFERENT code path that this mode never enters, so no threshold,
# no ordering and no floor in the selection loop below changes behaviour because this exists.
#
# Usage: cc-memory-rotate <index> [--rules-file <path>] [--dry-run] [--verbose]
#        cc-memory-rotate <index> --drain-oversized [--rules-file <path>] [--dry-run] [--verbose]
# Env:   MEMORY_ENTRY_LIMIT (300, drain mode only) · MEMORY_RULES_FILE (routing destination for
#        BOTH modes; also derived from CLAUDE_PROJECT_DIR) · MEMORY_RULES_HARD_CAP (4194304 — the
#        loader's SILENT-SKIP size, encoded not measured, see its declaration) ·
#        MEMORY_RULES_WARN_CAP (40000 — cosmetic, warns and writes) ·
#        MEMORY_INDEX_LIMIT (25000, in loader chars) · MEMORY_ROTATE_AT (LIMIT-1500) · MEMORY_ROTATE_TARGET
#        (LIMIT-4000) · MEMORY_INDEX_LINE_LIMIT (200) · MEMORY_ROTATE_AT_LINES (LINE_LIMIT-12) ·
#        MEMORY_ROTATE_TARGET_LINES (LINE_LIMIT-32) · MEMORY_ROTATE_MIN_KEEP (40) · MEMORY_ROTATE_TAIL_GUARD (15) ·
#        MEMORY_ROTATE_MIN_AGE_DAYS (7) · MEMORY_ROTATE_TEST_PRE_COMMIT (test seam, eval'd
#        before each commit attempt's stat re-check — lets a suite exercise the contended path)
# Exit:  0 noop/rotated/dry-run · 2 error · 3 locked/contended · 4 exhausted
set -euo pipefail
export LC_ALL=C   # byte semantics everywhere: ${#s}, wc -c, sort — self-consistent accounting,
                  # reconciled to the loader's char limit by the threshold shift (see THE UNIT)

VERBOSE=0; DRYRUN=0; INDEX=""; DRAIN=0; RULES_FILE=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRYRUN=1 ;;
    --verbose) VERBOSE=1 ;;
    --drain-oversized) DRAIN=1 ;;
    --rules-file) shift; RULES_FILE="${1:-}"
                  if [ -z "$RULES_FILE" ]; then
                    printf 'verdict=error reason=rules-file-needs-a-value\n'; exit 2
                  fi ;;
    --rules-file=*) RULES_FILE="${1#--rules-file=}" ;;
    -*) printf 'verdict=error reason=unknown-flag flag=%s\n' "$1"; exit 2 ;;
    *)  INDEX="$1" ;;
  esac
  shift
done

vlog() { if [ "$VERBOSE" -eq 1 ]; then printf '%s\n' "$*" >&2; fi; }

# Same discriminator as memory-index-budget.sh: only a loader-read project-memory index is in
# scope — a repo file merely named MEMORY.md has no read limit to protect.
case "$INDEX" in
  */memory/MEMORY.md) : ;;
  *) printf 'verdict=error reason=not-a-memory-index path=%s\n' "${INDEX:-<none>}"; exit 2 ;;
esac
if [ ! -f "$INDEX" ] || [ ! -r "$INDEX" ] || [ ! -w "$INDEX" ]; then
  printf 'verdict=error reason=unreadable-or-unwritable\n'; exit 2
fi
DIR=$(cd "$(dirname "$INDEX")" && pwd -P)
INDEX="$DIR/MEMORY.md"

# ── THE UNIT THIS FILE COUNTS IN, AND THE ONE THE LOADER COUNTS IN ───────────────────────────
# Everything below is BYTES (LC_ALL=C, `wc -c`, `${#s}`) and internally consistent: it decides
# which lines to move by their byte cost. The LOADER is not counting those bytes. It strips YAML
# frontmatter and block HTML comments, trims, then compares CHARACTERS against 25000 — including
# stripping the `<!-- cold tier: … -->` pointer THIS SCRIPT writes, so the rotor was budgeting
# against its own bookkeeping. Derivation: hooks/lib/memory-index-measure.sh (cc-backlog
# 7a56de4c54ab, read out of the 2.1.233 bundle).
#
# Rather than convert the per-line arithmetic — and risk a unit-mixed projection deciding how
# many of the operator's memories to archive — the THRESHOLDS move instead: raise each by the
# measured gap between what the file weighs and what the loader counts, and every comparison
# below becomes an effective-size comparison with the accounting untouched. The gap shrinks a
# little as lines leave, so holding it fixed across one rotation over-estimates the projection:
# the rotor archives a touch more than strictly needed, never less.
_ccmr_lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/../hooks/lib/memory-index-measure.sh"
# shellcheck source=/dev/null   # SC1091 suppression: this gate calls shellcheck without -x
if [ -r "$_ccmr_lib" ]; then . "$_ccmr_lib"; fi

LIMIT="${MEMORY_INDEX_LIMIT:-25000}"
case "$LIMIT" in ''|*[!0-9]*) printf 'verdict=error reason=non-numeric-limit\n'; exit 2 ;; esac
# The co-equal LINE cap. Anthropic documents the load as "the first 200 lines or 25KB, whichever
# comes first", so the rotor's job is to hold the index under BOTH — a rotor that only watched
# bytes left a terse index (200 lines at 100 B/line = 20 KB) permanently under every byte
# threshold here while the loader dropped its tail, and the gate could then refuse an append
# whose only mechanical remedy never fired. Sourced from the same lib the gate and the nudge
# read, so one knob cannot drift between the three enforcers.
if command -v mim_line_limit >/dev/null 2>&1; then
  LINE_LIMIT=$(mim_line_limit) || LINE_LIMIT="${MEMORY_INDEX_LINE_LIMIT:-200}"
else
  LINE_LIMIT="${MEMORY_INDEX_LINE_LIMIT:-200}"
fi
case "$LINE_LIMIT" in ''|*[!0-9]*) printf 'verdict=error reason=non-numeric-line-limit\n'; exit 2 ;; esac
ROTATE_AT="${MEMORY_ROTATE_AT:-$(( LIMIT - 1500 ))}"
TARGET="${MEMORY_ROTATE_TARGET:-$(( LIMIT - 4000 ))}"
# Same proportional bands as the byte thresholds (1500/25000 = 6%, 4000/25000 = 16%), so line
# pressure arms and clears on the same shape of runway the byte side already uses.
ROTATE_AT_LINES="${MEMORY_ROTATE_AT_LINES:-$(( LINE_LIMIT - 12 ))}"
TARGET_LINES="${MEMORY_ROTATE_TARGET_LINES:-$(( LINE_LIMIT - 32 ))}"
MIN_KEEP="${MEMORY_ROTATE_MIN_KEEP:-40}"
TAIL_GUARD="${MEMORY_ROTATE_TAIL_GUARD:-15}"
MIN_AGE_DAYS="${MEMORY_ROTATE_MIN_AGE_DAYS:-7}"
# ── THE DESTINATION'S TWO CEILINGS, and why only ONE of them refuses ─────────────────────────
# The routing destination is a `.claude/rules/*.md` file, which has no 25000-char cap — that is
# the whole point of routing to it. It has two other ceilings and they are NOT the same kind of
# thing, so conflating them would be the defect:
#
#   HARD (4 MiB): the loader SKIPS a rules file at/over this size — the file does not truncate,
#   it VANISHES, so the failure is total and silent. A guard here fails closed.
#
#   WARN (40,000 chars): a COSMETIC startup warning. Nothing is truncated and nothing is
#   dropped. It is the default tier budget to WARN on, never to refuse on.
#
# 🚨 THE 4 MiB NUMBER IS ENCODED HERE, NOT MEASURED HERE. The programme that specified this
# guard recorded the binary carve that produced the constant and a 419 KB untruncated positive
# control — about a tenth of it — but NO observation of a file at or over 4 MiB actually being
# skipped. So the threshold is a named, overridable variable rather than a literal at its use
# site: if the real ceiling is elsewhere, one env var moves the guard and no code changes.
# Hardcoding an unmeasured constant and calling the result a guard is the shape
# MEMORY.md reference-a-documented-kill-switch-is-a-claim records.
RULES_HARD_CAP="${MEMORY_RULES_HARD_CAP:-4194304}"
RULES_WARN_CAP="${MEMORY_RULES_WARN_CAP:-40000}"
for v in "$ROTATE_AT" "$TARGET" "$ROTATE_AT_LINES" "$TARGET_LINES" "$MIN_KEEP" "$TAIL_GUARD" "$MIN_AGE_DAYS" "$RULES_HARD_CAP" "$RULES_WARN_CAP"; do
  case "$v" in ''|*[!0-9]*) printf 'verdict=error reason=non-numeric-config\n'; exit 2 ;; esac
done
if [ "$TARGET" -ge "$ROTATE_AT" ]; then
  printf 'verdict=error reason=target-not-below-rotate-at\n'; exit 2
fi
if [ "$TARGET_LINES" -ge "$ROTATE_AT_LINES" ]; then
  printf 'verdict=error reason=line-target-not-below-rotate-at\n'; exit 2
fi

fsize() { wc -c <"$1" | tr -d ' '; }

# BSD-first with a GNU fallback, but the BSD attempt's STDOUT is captured and validated rather
# than let through. `stat -f` means "format" on BSD and "--file-system" on GNU, and GNU does not
# take a format operand: `stat -f '%m %z' -- f` treats the format as a missing filename, exits 1
# — so the `||` fallback fires as intended — while ALSO printing a filesystem block ("File: …",
# "Block size: …") to STDOUT, which 2>/dev/null does not touch. The old form concatenated that
# block with the GNU answer, so fmtime returned multiline junk and the caller's `$(( NOW - mt ))`
# died with `File: unbound variable` under set -u. Validating that the BSD attempt produced the
# EXPECTED SHAPE — digits, and two of them for fstat — is what makes this correct on both, and it
# leaves the BSD path byte-identical whenever it genuinely succeeds.
fstat() {
  local v
  v=$(stat -f '%m %z' -- "$1" 2>/dev/null) || v=""
  case "$v" in
    *[!0-9\ ]*|'') v="" ;;
  esac
  if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  stat -c '%Y %s' -- "$1" 2>/dev/null
}
fmtime() {
  local v
  v=$(stat -f %m -- "$1" 2>/dev/null) || v=""
  case "$v" in
    *[!0-9]*|'') v="" ;;
  esac
  if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  stat -c %Y -- "$1" 2>/dev/null || echo ""
}

# awk NR, not `wc -l`: NR counts a final unterminated line, which the loader still reads.
flines() { LC_ALL=C awk 'END{print NR+0}' "$1" 2>/dev/null || echo 0; }

# The threshold shift described above. An unresolvable lib leaves it at 0, which is exactly the
# pre-2026-08-15 behaviour: measuring raw bytes against the cap over-states the index and rotates
# EARLIER than needed. A side-car degrading to "too eager" is the direction to fail in.
OVERHEAD=0
if command -v mim_overhead >/dev/null 2>&1; then
  OVERHEAD=$(mim_overhead "$INDEX" 2>/dev/null) || OVERHEAD=0
  case "$OVERHEAD" in ''|*[!0-9]*) OVERHEAD=0 ;; esac
fi
if [ "$OVERHEAD" -gt 0 ]; then
  LIMIT=$(( LIMIT + OVERHEAD )); ROTATE_AT=$(( ROTATE_AT + OVERHEAD )); TARGET=$(( TARGET + OVERHEAD ))
  vlog "loader-vs-disk overhead ${OVERHEAD} B — thresholds shifted to limit=$LIMIT rotate_at=$ROTATE_AT target=$TARGET"
fi

SIZE=$(fsize "$INDEX")
NLINES=$(flines "$INDEX")
# The drain path is armed by a PER-ENTRY condition, so the whole-index thresholds cannot gate it:
# an index 8 KB under ROTATE_AT can still hold a 900-unit buffer line, which is exactly the write
# this mode exists to route. Every other caller keeps the early exit unchanged.
if [ "$DRAIN" -eq 0 ] && [ "$SIZE" -lt "$ROTATE_AT" ] && [ "$NLINES" -lt "$ROTATE_AT_LINES" ]; then
  printf 'verdict=noop size=%s rotate_at=%s lines=%s rotate_at_lines=%s\n' \
    "$SIZE" "$ROTATE_AT" "$NLINES" "$ROTATE_AT_LINES"; exit 0
fi

# Sanity bound: a dir this command was never designed for is a refusal, not a bigger job.
NMD=$(find "$DIR" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
if [ "$NMD" -gt 5000 ]; then printf 'verdict=error reason=dir-too-large n=%s\n' "$NMD"; exit 2; fi

LOCK="$DIR/.rotate.lock.d"
if ! mkdir "$LOCK" 2>/dev/null; then
  NOW=$(date +%s)
  LM=$(fmtime "$LOCK"); [ -n "$LM" ] || LM=$NOW
  if [ $(( NOW - LM )) -gt 180 ] && rmdir "$LOCK" 2>/dev/null && mkdir "$LOCK" 2>/dev/null; then
    vlog "reclaimed stale lock"
  else
    printf 'verdict=locked\n'; exit 3
  fi
fi
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

TAB=$(printf '\t')
NOW=$(date +%s)
MIN_AGE_S=$(( MIN_AGE_DAYS * 86400 ))

# The ONE definition of "an entry line", shared by the drain path and the rotation loop. Anchored,
# first `](…)` group; the full derivation of why it is narrow and why it lives in a variable is at
# its use site in the selection loop below.
ENTRY_RX='^- \[[^]]*\]\(([A-Za-z0-9][A-Za-z0-9._-]*\.md)\)'

# route_veto <line> <topicfile-or-empty> → a reason this line may NOT be routed, or nothing.
#
# DELIBERATELY NOT protect_reason WITH A THIRD STAGE. The two functions answer different questions:
# protect_reason asks "may this leave the hot surface", route_veto asks "may this MOVE BETWEEN two
# hot surfaces". Sharing one function would have meant a third `stage` value threading through
# every branch of the eviction predicate, i.e. editing the code path this wave is required not to
# alter. The overlap is four predicates, spelled identically in both.
#
# What is here and why: PINNED and the feedback-/reference-/user- name convention and the `type:`
# stamp are the OPERATOR'S VOICE — the plan carries that veto upstream to the routing gate on
# purpose, because a protection implemented downstream of the predicate that bypasses it is not a
# protection. unparseable/dangling keep the report-never-touch rule: a line whose topic file cannot
# be identified is not a line we know how to route.
#
# What is deliberately ABSENT: tail, young, marker, hub, MIN_KEEP. Every one of those means "keep
# this on the hot surface" and the destination IS a hot surface. See the header for why the tail
# guard in particular could not bind here without making the mode a permanent no-op.
route_veto() {
  local ln="$1" f="$2" nm t
  if [ -z "$f" ]; then echo unparseable; return 0; fi
  if [ ! -f "$DIR/$f" ]; then echo dangling; return 0; fi
  case "$ln" in *PINNED*) echo pinned; return 0 ;; esac
  nm="${f%.md}"
  case "$nm" in feedback-*|reference-*|user-*) echo type; return 0 ;; esac
  t=$(awk 'NR<=12 && /^[[:space:]]*type:[[:space:]]*/ {sub(/^[[:space:]]*type:[[:space:]]*/,""); print $1; exit}' "$DIR/$f" 2>/dev/null || true)
  case "$t" in user|feedback|reference) echo type; return 0 ;; esac
  return 0
}

# ── ROUTING: one destination resolver, one cap guard, one commit — shared by BOTH paths ──────
#
# `--drain-oversized` (the per-entry condition) and ordinary rotation (the whole-index caps) now
# both MOVE lines to an always-loaded rules file instead of demoting them to the cold record, so
# the resolve / cap-guard / create / append / verify step is written ONCE, here. A second copy
# would be a second definition of "routed", and the two would drift on exactly the property that
# makes the move non-lossy.

# route_paths_of <topicfile> → the value the topic file VOLUNTEERS on a `paths:` line, or nothing.
route_paths_of() {
  awk 'NR<=12 && /^[[:space:]]*paths:[[:space:]]*[^[:space:]]/ {
         sub(/^[[:space:]]*paths:[[:space:]]*/,""); print; exit }' "$DIR/$1" 2>/dev/null || true
}

# route_dest_for <topicfile> → the destination for ONE entry.
#
# 🚨 DEFAULT IS ALWAYS-LOADED, UNCONDITIONALLY. The only thing that can move an entry off it is
# the entry's own author VOLUNTEERING a `paths:` list in the topic frontmatter. No glob is ever
# inferred and nothing here classifies a rule's scope: measured 2026-09, 0 of 5,922 topic files
# fleet-wide declare `paths:`, and the destination file's own header says these lessons are
# "deliberately unscoped … they bear on any work here". Inventing a scope for a globally
# applicable rule is SILENT SEVERANCE — the failure `.claude/rules/replicache.md` records having
# suffered — and it is worse than not scoping at all, because a scoped file costs 0 tokens by
# never loading. So this function is a no-op on every entry that exists today, and that is the
# honest implementation of the item rather than a smaller version of it.
route_dest_for() {
  local f="$1"
  if [ -z "$f" ] || [ ! -f "$DIR/$f" ]; then printf '%s' "$RULES_FILE"; return 0; fi
  if [ -z "$(route_paths_of "$f")" ]; then printf '%s' "$RULES_FILE"; return 0; fi
  # The scoped sibling is NAMED for its topic file, which is what lets route_flush recover the
  # volunteered value at creation time without carrying it through the payload as a third field.
  printf '%s/scoped-%s' "${RULES_FILE%/*}" "$f"
}

# rules_cap_reason <dest> <added-bytes> → echoes a refusal reason, or nothing. Warns on stderr.
#
# The projection, not the current size, is what is judged: a destination one byte under the hard
# cap that this append would push over is exactly the case the guard exists for, and checking
# only the current size would let the file cross into the silent-skip regime and report success.
rules_cap_reason() {
  local dest="$1" add="$2" cur=0 proj
  if [ -f "$dest" ]; then cur=$(fsize "$dest"); fi
  case "$cur" in ''|*[!0-9]*) cur=0 ;; esac
  proj=$(( cur + add ))
  if [ "$proj" -ge "$RULES_HARD_CAP" ]; then echo dest-over-hard-cap; return 0; fi
  if [ "$proj" -ge "$RULES_WARN_CAP" ]; then
    # WARN, NEVER REFUSE. This ceiling is cosmetic — the loader prints a startup warning and
    # loads the file whole. Refusing here would re-create the very cap routing exists to escape.
    printf 'warn=dest-over-warn-cap dest=%s projected=%s warn_cap=%s (cosmetic startup warning — nothing is truncated; this is the tier budget, not a limit)\n' \
      "$dest" "$proj" "$RULES_WARN_CAP" >&2
  fi
  return 0
}

# resolve_rules_dest → 0 with RULES_FILE resolved to a real, writable path; else 1 with
# RESOLVE_REASON set. Extracted verbatim from the drain path so ordinary rotation resolves its
# destination through the same symlink and writability assertions rather than a second copy.
#
# The symlink resolution is load-bearing and is not tidiness: a symlink into `.claude/rules/` is
# the sanctioned cross-repo lever, and `Edit` refuses to write through one ("Resolve the symlink
# and pass the real target path explicitly"), so a path that works for a `>>` and fails for the
# compliant tool is the worst possible asymmetry.
resolve_rules_dest() {
  # Reason tokens are QUOTED, not bare: shellcheck reads an unquoted `X=a-b` as arithmetic
  # (SC2100) and the land gate runs it at default severity, not `-S error`.
  local rbase rdir rdir_p rtgt
  RESOLVE_REASON=""
  if [ -z "$RULES_FILE" ]; then RULES_FILE="${MEMORY_RULES_FILE:-}"; fi
  if [ -z "$RULES_FILE" ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    RULES_FILE="$CLAUDE_PROJECT_DIR/.claude/rules/agent-operating-lessons.md"
  fi
  if [ -z "$RULES_FILE" ]; then RESOLVE_REASON='no-rules-destination'; return 1; fi
  rbase="${RULES_FILE##*/}"
  rdir="${RULES_FILE%/*}"
  [ "$rdir" != "$RULES_FILE" ] || rdir="."
  mkdir -p "$rdir" 2>/dev/null || true
  if [ ! -d "$rdir" ]; then RESOLVE_REASON='dest-dir-unreachable'; return 1; fi
  rdir_p=$(cd "$rdir" 2>/dev/null && pwd -P) || rdir_p=""
  if [ -z "$rdir_p" ]; then RESOLVE_REASON='dest-dir-unreachable'; return 1; fi
  RULES_FILE="$rdir_p/$rbase"
  if [ -L "$RULES_FILE" ]; then
    rtgt=$(readlink -f "$RULES_FILE" 2>/dev/null) || rtgt=""
    if [ -z "$rtgt" ]; then
      rtgt=$(readlink "$RULES_FILE" 2>/dev/null) || rtgt=""
      case "$rtgt" in ''|/*) : ;; *) rtgt="$rdir_p/$rtgt" ;; esac
    fi
    [ -n "$rtgt" ] && RULES_FILE="$rtgt"
  fi
  if [ -e "$RULES_FILE" ]; then
    if [ ! -f "$RULES_FILE" ] || [ ! -w "$RULES_FILE" ]; then
      RESOLVE_REASON='dest-not-writable'; return 1
    fi
  elif [ ! -w "${RULES_FILE%/*}" ]; then
    RESOLVE_REASON='dest-not-writable'; return 1
  fi
  case "$RULES_FILE" in "$INDEX") RESOLVE_REASON='dest-is-the-index'; return 1 ;; esac
  return 0
}

# route_flush <payload> <provenance-comment> → 0, or 1 with ROUTE_ERR set. Sets ROUTE_DESTS.
#
# payload = one `<destination><TAB><index line>` row per routed entry, grouped here rather than
# by the caller so a volunteered `paths:` scope needs no second commit path.
#
# ORDER AND FAILURE SHAPE. Every destination's cap is judged BEFORE the first byte is appended
# anywhere, so a multi-destination flush cannot half-write and leave a line in a rules file AND
# in the cold record. Then each destination is created if missing, appended once, and finally
# EVERY routed line is verified present in its own destination — all of it before any caller
# rewrites the index, so a crash leaves at worst a duplicate line in the destination, never a
# lost one. Same invariant, same reason, as the cold write below.
route_flush() {
  local payload="$1" prov="$2" dests dest block d l cap base topic paths n
  ROUTE_ERR=""; ROUTE_DESTS=""
  [ -n "$payload" ] || return 0
  dests=$(printf '%s\n' "$payload" | cut -f1 | sort -u | grep -v '^$' || true)
  [ -n "$dests" ] || return 0

  # Pass 1 — cap every destination first, on an over-estimate (the whole payload). Conservative
  # in the one direction a guard may be conservative in: it can only refuse earlier, never later.
  while IFS= read -r dest; do
    [ -n "$dest" ] || continue
    cap=$(rules_cap_reason "$dest" "${#payload}")
    if [ -n "$cap" ]; then ROUTE_ERR="$cap"; return 1; fi
  done <<EOF
$dests
EOF

  # Pass 2 — build, create, append. Idempotent: a line already present is not duplicated.
  while IFS= read -r dest; do
    [ -n "$dest" ] || continue
    block=$(printf '\n%s' "$prov")
    n=0
    while IFS="$TAB" read -r d l; do
      [ -n "${l:-}" ] || continue
      [ "$d" = "$dest" ] || continue
      if [ -f "$dest" ] && grep -qxF -- "$l" "$dest"; then continue; fi
      block="$block
$l"
      n=$(( n + 1 ))
    done <<EOF
$payload
EOF
    cap=$(rules_cap_reason "$dest" "${#block}")
    if [ -n "$cap" ]; then ROUTE_ERR="$cap"; return 1; fi
    if [ ! -e "$dest" ]; then
      base="${dest##*/}"
      case "$base" in
        scoped-*)
          topic="${base#scoped-}"
          paths=$(route_paths_of "$topic")
          if ! printf -- '---\npaths: %s\n---\n\n# Scoped project rules — routed by cc-memory-rotate\n' "$paths" >"$dest" 2>/dev/null; then
            ROUTE_ERR='dest-create-failed'; return 1
          fi ;;
        *)
          if ! printf '%s\n' "# Always-loaded project rules" "" >"$dest" 2>/dev/null; then
            ROUTE_ERR='dest-create-failed'; return 1
          fi ;;
      esac
    fi
    if ! printf '%s\n' "$block" >>"$dest" 2>/dev/null; then
      ROUTE_ERR='dest-append-failed'; return 1
    fi
    ROUTE_DESTS="${ROUTE_DESTS:+$ROUTE_DESTS,}$dest"
  done <<EOF
$dests
EOF

  # Pass 3 — verify, per line, in its own destination.
  while IFS="$TAB" read -r d l; do
    [ -n "${l:-}" ] || continue
    if ! grep -qxF -- "$l" "$d"; then ROUTE_ERR='dest-verify-failed'; return 1; fi
  done <<EOF
$payload
EOF
  return 0
}

if [ "$DRAIN" -eq 1 ]; then
  # ── Destination: resolved, asserted reachable and writable BEFORE anything is read ───────────
  # The resolution itself now lives in resolve_rules_dest (above), shared with ordinary rotation.
  # The two callers differ ONLY in what a failure means: here the whole mode is routing, so an
  # unusable destination is a refusal; there, rotation still has the cold record and degrades.
  if ! resolve_rules_dest; then
    case "$RESOLVE_REASON" in
      no-rules-destination)
        printf 'verdict=error reason=no-rules-destination hint=--rules-file|MEMORY_RULES_FILE|CLAUDE_PROJECT_DIR\n' ;;
      dest-is-the-index)
        printf 'verdict=error reason=dest-is-the-index\n' ;;
      *)
        printf 'verdict=error reason=%s dest=%s\n' "$RESOLVE_REASON" "$RULES_FILE" ;;
    esac
    exit 2
  fi
  # Fail closed on the hard cap BEFORE reading the index. A destination already at/over the
  # loader's silent-skip size cannot receive anything, and finding that out after the index has
  # been rewritten would be the one failure this mode must not have.
  D_CAP=$(rules_cap_reason "$RULES_FILE" 1)
  if [ -n "$D_CAP" ]; then
    printf 'verdict=error reason=%s dest=%s hard_cap=%s\n' "$D_CAP" "$RULES_FILE" "$RULES_HARD_CAP"; exit 2
  fi

  ENTRY_LIMIT=""
  if command -v mim_entry_limit >/dev/null 2>&1; then ENTRY_LIMIT=$(mim_entry_limit) || ENTRY_LIMIT=""; fi
  if [ -z "$ENTRY_LIMIT" ] || ! command -v mim_oversized_lines >/dev/null 2>&1; then
    # No measure, no verdict. Guessing a per-entry size in bytes here would name a DIFFERENT line
    # than the loader's unit does on an index full of `—`/`⇒`/`·`.
    printf 'verdict=error reason=no-measure\n'; exit 2
  fi

  D_LINES=(); D_NL=0
  while IFS= read -r _l || [ -n "$_l" ]; do D_LINES[D_NL]="$_l"; D_NL=$(( D_NL + 1 )); done <"$INDEX"

  D_OVER=$(mim_oversized_lines "$INDEX" "$ENTRY_LIMIT") || {
    printf 'verdict=error reason=measure-failed\n'; exit 2; }

  D_MOVE=""; D_N=0; D_CAND=0; D_FILES=""; D_PAY=""
  V_PIN=0; V_TYPE=0; V_PARSE=0; V_DANGLING=0
  while IFS="$TAB" read -r _lno _units; do
    [ -n "${_lno:-}" ] || continue
    case "$_lno" in ''|*[!0-9]*) continue ;; esac
    [ "$_lno" -lt "$D_NL" ] || continue
    _ln="${D_LINES[$_lno]}"
    # Only an ENTRY line is routable. A long header sentence or a prose paragraph is over the
    # per-entry cap by the same arithmetic and is not a rule with a home to move to.
    case "$_ln" in "- ["*) : ;; *) continue ;; esac
    D_CAND=$(( D_CAND + 1 ))
    _f=""
    if [[ "$_ln" =~ $ENTRY_RX ]]; then _f="${BASH_REMATCH[1]}"; fi
    _v=$(route_veto "$_ln" "$_f")
    if [ -n "$_v" ]; then
      case "$_v" in
        pinned) V_PIN=$(( V_PIN + 1 )) ;;
        type) V_TYPE=$(( V_TYPE + 1 )) ;;
        unparseable) V_PARSE=$(( V_PARSE + 1 )) ;;
        dangling) V_DANGLING=$(( V_DANGLING + 1 )) ;;
      esac
      vlog "drain keep [$_v] ${_f:-<line $_lno>} (${_units} units)"
      continue
    fi
    D_MOVE="$D_MOVE $_lno"
    D_FILES="${D_FILES:+$D_FILES,}$_f"
    D_PAY="$D_PAY$(route_dest_for "$_f")$TAB$_ln
"
    D_N=$(( D_N + 1 ))
    vlog "drain move $_f (${_units} units)"
  done <<EOF
$D_OVER
EOF

  if [ "$D_N" -eq 0 ]; then
    if [ "$D_CAND" -eq 0 ]; then
      printf 'verdict=noop mode=drain-oversized entry_limit=%s oversized=0 size=%s lines=%s\n' \
        "$ENTRY_LIMIT" "$SIZE" "$NLINES"
      exit 0
    fi
    # Over-cap entries exist and every one is vetoed. Name which veto, in the census shape the
    # rotation path already uses: an actuator that says only "moved=0" sends its reader to the
    # wrong line of code, which is precisely what W1 fixed on the other path.
    printf 'verdict=exhausted mode=drain-oversized entry_limit=%s oversized=%s moved=0 vetoed: type=%s pinned=%s unparseable=%s dangling=%s\n' \
      "$ENTRY_LIMIT" "$D_CAND" "$V_TYPE" "$V_PIN" "$V_PARSE" "$V_DANGLING"
    exit 4
  fi

  D_DESTS=$(printf '%s\n' "$D_PAY" | cut -f1 | sort -u | grep -v '^$' | tr '\n' ',' | sed 's/,$//')
  [ -n "$D_DESTS" ] || D_DESTS="$RULES_FILE"

  if [ "$DRYRUN" -eq 1 ]; then
    printf 'verdict=dry-run mode=drain-oversized entry_limit=%s oversized=%s moved=%s files=%s dest=%s\n' \
      "$ENTRY_LIMIT" "$D_CAND" "$D_N" "$D_FILES" "$D_DESTS"
    exit 0
  fi

  # ── Destination first, verified, idempotent — then the index ────────────────────────────────
  # Same ordering and the same reason as the cold write below: a crash between the two leaves at
  # worst a duplicate line in the destination, never a lost one.
  D_SNAP=$(fstat "$INDEX")
  D_PROV=$(printf '<!-- routed %s by cc-memory-rotate --drain-oversized: %s index line(s) over the %s-unit buffer cap, moved VERBATIM off %s. Both surfaces load unprompted, so nothing was demoted and nothing was shortened; restore = paste the line back. -->' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$D_N" "$ENTRY_LIMIT" "$INDEX")
  if ! route_flush "$D_PAY" "$D_PROV"; then
    printf 'verdict=error reason=%s dest=%s hard_cap=%s\n' "$ROUTE_ERR" "$D_DESTS" "$RULES_HARD_CAP"; exit 2
  fi
  [ -n "$ROUTE_DESTS" ] && D_DESTS="$ROUTE_DESTS"

  D_TMP=$(mktemp "$DIR/.MEMORY.md.drain.XXXXXX")
  {
    _i=0
    while [ "$_i" -lt "$D_NL" ]; do
      case " $D_MOVE " in
        *" $_i "*) : ;;
        *) printf '%s\n' "${D_LINES[$_i]}" ;;
      esac
      _i=$(( _i + 1 ))
    done
  } >"$D_TMP"

  if [ -n "${MEMORY_ROTATE_TEST_PRE_COMMIT:-}" ]; then eval "$MEMORY_ROTATE_TEST_PRE_COMMIT"; fi
  if [ "$(fstat "$INDEX")" != "$D_SNAP" ]; then
    rm -f "$D_TMP"; printf 'verdict=contended mode=drain-oversized\n'; exit 3
  fi
  D_NEWSZ=$(fsize "$D_TMP")
  if [ "$D_NEWSZ" -ge "$SIZE" ]; then
    rm -f "$D_TMP"; printf 'verdict=error reason=would-not-shrink\n'; exit 2
  fi
  chmod 644 "$D_TMP"
  mv -f "$D_TMP" "$INDEX"
  D_NEWLINES=$(flines "$INDEX")
  printf 'verdict=drained mode=drain-oversized entry_limit=%s oversized=%s moved=%s files=%s before=%s after=%s lines_before=%s lines_after=%s dest=%s\n' \
    "$ENTRY_LIMIT" "$D_CAND" "$D_N" "$D_FILES" "$SIZE" "$D_NEWSZ" "$NLINES" "$D_NEWLINES" "$D_DESTS"
  mkdir -p "$DIR/archive" 2>/dev/null || true
  printf '%s verdict=drained moved=%s files=%s before=%s after=%s dest=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$D_N" "$D_FILES" "$SIZE" "$D_NEWSZ" "$D_DESTS" \
    >>"$DIR/archive/.rotate.log" 2>/dev/null || true
  exit 0
fi

# protect_reason <ordinal> <line> <topicfile-or-empty> [stage] → echoes a reason, or nothing
#
# TWO-STAGE PRESSURE MODEL for the type protection. The operator-approved rule protects
# "feedback operator-directives and reference tooling entrypoints" — but the frontmatter
# `type:` stamp is a session SELF-REPORT and measurably does not track that semantic:
# 2026-08-10, 76 of 105 live entries carried type feedback/reference while only 12 bore the
# deliberate feedback-/reference- NAME convention; the other 64 were agent-derived lessons
# (one kill(2)-semantics lesson was stamped `reference`). Honoring the stamp absolutely made
# the rotor verdict=exhausted on the exact index it was built to heal. So: stage 1 (normal
# pressure) honors the stamp; stage 2 — armed ONLY when the index is at/over the loader LIMIT,
# where the alternative is the loader silently dropping the NEWEST entries — lets the
# unprefixed stamp yield. The name convention, user type, PINNED, markers, hubs, young, tail
# and the floor never yield at any stage.
protect_reason() {
  local j="$1" ln="$2" f="$3" stage="${4:-1}" nm t inb mt
  if [ "$j" -ge "$TAIL_FROM" ]; then echo tail; return 0; fi
  if [ -z "$f" ]; then echo unparseable; return 0; fi
  if [ ! -f "$DIR/$f" ]; then echo dangling; return 0; fi
  case "$ln" in *PINNED*) echo pinned; return 0 ;; esac
  nm="${f%.md}"
  case "$nm" in feedback-*|reference-*|user-*) echo type; return 0 ;; esac
  t=$(awk 'NR<=12 && /^[[:space:]]*type:[[:space:]]*/ {sub(/^[[:space:]]*type:[[:space:]]*/,""); print $1; exit}' "$DIR/$f" 2>/dev/null || true)
  case "$t" in
    user) echo type; return 0 ;;
    feedback|reference) if [ "$stage" -eq 1 ]; then echo type; return 0; fi ;;
  esac
  # DRAINED, never `grep -q`: under pipefail a matching -q exits first, the producer takes SIGPIPE,
  # and the 141 is promoted to the `if` — see scripts/pipefail-sigpipe-lint.sh.
  if printf '%s' "$ln" | grep -iE 'DEFERRED|NOT pushed|pending|gated on|BLOCKED|backlog|(^|[^[:alnum:]])open([^[:alnum:]]|$)' >/dev/null; then
    echo marker; return 0
  fi
  mt=$(fmtime "$DIR/$f"); [ -n "$mt" ] || mt=$NOW
  if [ $(( NOW - mt )) -lt "$MIN_AGE_S" ]; then echo young; return 0; fi
  # HUB SCAN, WIDENED 2026-09-03. Two blind spots, and routing makes both worse:
  #   (1) it counted ONLY `[[wikilink]]` syntax. Measured on reso's always-loaded project rules
  #       file: 0 wikilinks, 31 bare `name.md` citations — 31 live consumers invisible to the very
  #       protection that exists to keep load-bearing rules hot.
  #   (2) it scanned ONLY the memory dir, while the routing phase moves consumers OUT of that dir
  #       by design — so every successfully routed rule would become hub=0 by construction.
  #
  # 🚨 THE INDEX AND THE DEMOTION RECORDS ARE EXCLUDED FROM THE BARE-FILENAME COUNT, and that
  # exclusion is load-bearing: MEMORY.md, MEMORY-ARCHIVE.md and every COLD/snapshot file carry a
  # `](name.md)` link for EVERY entry by construction. Counting them would put almost the whole
  # index at inb>=3 in one step, converting a targeted protection into a universal keep and this
  # actuator into a permanent no-op — the exact failure mode it was built to end.
  # Built at function level, NOT inside the command substitution: a `case … continue` nested in
  # `$( { … } | … )` is a parse error on bash 3.2 (`syntax error near unexpected token ';;'`).
  _hits=$(grep -lF -- "[[${nm}]]" "$DIR"/*.md 2>/dev/null || true)
  for _c in "$DIR"/*.md; do
    [ -f "$_c" ] || continue
    case "${_c##*/}" in MEMORY.md|MEMORY-ARCHIVE.md|MEMORY_ARCHIVE_*|MEMORY_INDEX_*) continue ;; esac
    if grep -lF -- "$f" "$_c" >/dev/null 2>&1; then
      _hits="$_hits
$_c"
    fi
  done
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -d "$CLAUDE_PROJECT_DIR/.claude/rules" ]; then
    _r=$(grep -lF -- "$f" "$CLAUDE_PROJECT_DIR"/.claude/rules/*.md 2>/dev/null || true)
    if [ -n "$_r" ]; then
      _hits="$_hits
$_r"
    fi
  fi
  inb=0
  if [ -n "$_hits" ]; then
    inb=$(printf '%s\n' "$_hits" | grep -v "/${f}\$" | sort -u | grep -c . || true)
  fi
  case "$inb" in ''|*[!0-9]*) inb=0 ;; esac
  if [ "$inb" -ge 4 ]; then echo hub; return 0; fi
  return 0
}

ATTEMPT=0
while :; do
  ATTEMPT=$(( ATTEMPT + 1 ))
  if [ "$ATTEMPT" -gt 3 ]; then printf 'verdict=contended attempts=3\n'; exit 3; fi

  SNAP=$(fstat "$INDEX")
  SIZE=$(fsize "$INDEX")
  NLINES=$(flines "$INDEX")
  if [ "$SIZE" -lt "$ROTATE_AT" ] && [ "$NLINES" -lt "$ROTATE_AT_LINES" ]; then
    printf 'verdict=noop size=%s rotate_at=%s lines=%s rotate_at_lines=%s\n' \
      "$SIZE" "$ROTATE_AT" "$NLINES" "$ROTATE_AT_LINES"; exit 0
  fi

  # Read the whole file (bash-3.2-safe: no mapfile). `|| [ -n ]` keeps a final
  # newline-less line; the rebuild below re-normalizes with one \n per line.
  LINES=(); NL=0
  while IFS= read -r _l || [ -n "$_l" ]; do LINES[NL]="$_l"; NL=$(( NL + 1 )); done <"$INDEX"

  # Census the entry lines. The link parse is ANCHORED at line start and takes the FIRST
  # `](...)` group — a greedy match extracts prose from any hook that contains parentheses
  # (measured on this live index: 42 of 105 lines would mis-parse; the trap
  # commands/compact-memory.md documents for E2 harvesting).
  #
  # THE REGEX LIVES IN A VARIABLE, AND THAT IS LOAD-BEARING (fixed 2026-08-15). Written inline
  # it matched NOTHING: inside `[[ ]]` an unescaped `(` is the shell's own expression-grouping
  # operator, so the capture group was consumed by the PARSER before the regex engine saw it and
  # `[[ $l =~ ^- \[…\]\(([A-Za-z0-9]…) ]]` was simply false for every well-formed entry. The
  # rotor therefore classified all N entries `unparseable` and returned verdict=exhausted on
  # every run — an actuator that could not act, reporting a protection reason for its own parse
  # bug. Measured on a 20-entry fixture: unparseable=19, tail=1, moved=0. An unquoted variable
  # expansion is the portable idiom (the pattern reaches the engine intact on every bash).
  # ENTRY_RX is assigned ONCE, above the lock, so the drain path and this loop parse an entry line
  # by the same rule — two spellings of this regex would be two definitions of "an entry".
  #
  # AND A SECOND, INDEPENDENT MECHANISM FOR THE SAME SYMPTOM (measured 2026-08-15). Written
  # inline and unquoted, its `\ ` (backslash-space) matches under bash 3.2 — the macOS system
  # bash this was authored against — and matches NOTHING under bash 5.2. Measured 2026-08-15 on
  # 5.2.21: the identical pattern hoisted to a variable resolves `e00.md` where the inline form
  # returns no match at all. The failure is silent and maximally misleading — every entry falls
  # to the `unparseable` keep class, so the rotor reports a healthy `verdict=exhausted` census
  # and rotates nothing, on every Linux host in the fleet including the cloud session containers.
  # tests/cc-memory-rotate.bats was 3-of-21 green there for exactly this reason.
  
  ENTRY_LNO=""; ENTRY_FILES=""; NENT=0
  i=0
  while [ "$i" -lt "$NL" ]; do
    case "${LINES[$i]}" in
      "- ["*)
        if [[ "${LINES[$i]}" =~ $ENTRY_RX ]]; then
          ENTRY_FILES="$ENTRY_FILES${BASH_REMATCH[1]}$TAB"
        else
          ENTRY_FILES="$ENTRY_FILES$TAB"
        fi
        ENTRY_LNO="$ENTRY_LNO$i$TAB"
        NENT=$(( NENT + 1 )) ;;
    esac
    i=$(( i + 1 ))
  done
  if [ "$NENT" -eq 0 ]; then printf 'verdict=error reason=no-entries\n'; exit 2; fi
  if [ "$NENT" -gt 1000 ]; then printf 'verdict=error reason=too-many-entries n=%s\n' "$NENT"; exit 2; fi
  TAIL_FROM=$(( NENT - TAIL_GUARD ))
  if [ "$TAIL_FROM" -lt 0 ]; then TAIL_FROM=0; fi

  # Does the header already point at the cold tier? (PROTECTED section of compact-memory.md:
  # archived topics must stay discoverable from the auto-loaded surface.)
  HAVE_PTR=0
  if grep -q 'archive/MEMORY_ARCHIVE' "$INDEX"; then HAVE_PTR=1; fi
  # UNIT: loader CHARS, not bytes. `${LIMIT} B` stood here until 2026-08-24 and was the dead
  # pre-2026-08-15 byte premise re-seeded into the one file the next observer measures — this
  # pointer is written INTO the index, so a stale unit label teaches every reader of it to size
  # the next cut in `wc -c` and mint another false "over budget" item (backlog c7bef93baca6).
  # KEEP THIS LINE SHORT. The loader strips block comments so it is free against the 25000-char
  # cap (test 9), but it is NOT free against the LINE cap or the disk the index costs everywhere
  # else — a first pass at this fix spelled the unit out in full and RED-ed tests 17 and 20 on
  # raw size. The explanation goes in this comment; the stamp gets the one corrected word.
  PTR_LINE="<!-- cold tier: archive/MEMORY_ARCHIVE_*-COLD.md — auto-rotated by cc-memory-rotate near the ${LIMIT}-char read limit; restore = paste the line back -->"

  # Classify → eligible list "mtime<TAB>lineno<TAB>file", oldest mtime first. Stage-1 type
  # keeps also record their ordinal, so breach pressure can re-judge exactly that set.
  K_TAIL=0; K_PARSE=0; K_DANGLING=0; K_PIN=0; K_TYPE=0; K_MARK=0; K_YOUNG=0; K_HUB=0
  ELIG=""; TYPEKEPT=""
  j=0
  # iterate the two parallel TAB-joined lists
  REST_LNO="$ENTRY_LNO"; REST_F="$ENTRY_FILES"
  while [ "$j" -lt "$NENT" ]; do
    li="${REST_LNO%%"$TAB"*}"; REST_LNO="${REST_LNO#*"$TAB"}"
    f="${REST_F%%"$TAB"*}";    REST_F="${REST_F#*"$TAB"}"
    r=$(protect_reason "$j" "${LINES[$li]}" "$f")
    if [ -n "$r" ]; then
      case "$r" in
        tail) K_TAIL=$((K_TAIL+1));; unparseable) K_PARSE=$((K_PARSE+1));;
        dangling) K_DANGLING=$((K_DANGLING+1));; pinned) K_PIN=$((K_PIN+1));;
        type) K_TYPE=$((K_TYPE+1))
              mt=$(fmtime "$DIR/$f"); [ -n "$mt" ] || mt=$NOW
              TYPEKEPT="$TYPEKEPT$mt$TAB$j$TAB$li$TAB$f
";;
        marker) K_MARK=$((K_MARK+1));;
        young) K_YOUNG=$((K_YOUNG+1));; hub) K_HUB=$((K_HUB+1));;
      esac
      vlog "keep [$r] ${f:-<line $li>}"
    else
      mt=$(fmtime "$DIR/$f"); [ -n "$mt" ] || mt=$NOW
      ELIG="$ELIG$mt$TAB${#LINES[$li]}$TAB$li$TAB$f
"
    fi
    j=$(( j + 1 ))
  done

  # Select oldest-first until the projected size reaches TARGET (the pointer line, if it must
  # be added, is part of the projection so the shrink guarantee stays honest).
  # Both budgets are projected together: every moved entry buys back its bytes AND exactly one
  # line, and the rotation is done only when BOTH are at/under target. Stopping at the byte
  # target alone would leave a line-pressured index still over its line cap while reporting
  # verdict=rotated, which reads as healed and is not.
  PROJ=$SIZE
  PROJ_L=$NL
  if [ "$HAVE_PTR" -eq 0 ]; then PROJ=$(( PROJ + ${#PTR_LINE} + 1 )); PROJ_L=$(( PROJ_L + 1 )); fi
  MOVE_LNOS=""; MOVED=0; REMAIN=$NENT
  # Why the selection loop stopped: `floor` = it hit MIN_KEEP, `pool` = it ran out of eligible
  # entries. That distinction is the whole diagnostic value of the exhausted census — see BOUND.
  STOP_REASON=pool
  # SIZE TERM ADDED 2026-09-03 (record is now mtime<TAB>size<TAB>lineno<TAB>file). Oldest-first
  # stays the PRIMARY key — that is the ratified eviction policy and this is not the phase that
  # changes it — but the tiebreak is now size DESCENDING rather than filename. Nothing anywhere
  # ordered by size, while the loop below decrements the projection by whatever each line happens
  # to weigh, so on a skewed index it drained cheap entries first and left the heavy ones. Filename
  # remains the final tiebreak, so the order is still total and deterministic.
  if [ -n "$ELIG" ]; then
    SORTED=$(printf '%s' "$ELIG" | sort -t "$TAB" -k1,1n -k2,2nr -k4,4)
  else
    SORTED=""
  fi
  while IFS="$TAB" read -r _mt _sz li f; do
    if [ -z "${li:-}" ]; then continue; fi
    if [ "$PROJ" -le "$TARGET" ] && [ "$PROJ_L" -le "$TARGET_LINES" ]; then break; fi
    if [ "$REMAIN" -le "$MIN_KEEP" ]; then STOP_REASON=floor; break; fi
    PROJ=$(( PROJ - ${#LINES[$li]} - 1 ))
    PROJ_L=$(( PROJ_L - 1 ))
    MOVE_LNOS="$MOVE_LNOS $li"
    MOVED=$(( MOVED + 1 )); REMAIN=$(( REMAIN - 1 ))
    vlog "move $f (mtime $_mt)"
  done <<EOF
$SORTED
EOF

  # ── Breach pressure: stage 2 ───────────────────────────────────────────────────────────────
  # Only when the index is at/over the loader LIMIT itself and the stage-1 pool could not reach
  # the target. The stage-1 pool always drains first; stage 2 re-judges only the stage-1 type
  # keeps (unprefixed self-stamped entries), and every other protection still binds there.
  # Breach on EITHER cap arms stage 2: an index past its line cap is having its newest entries
  # dropped just as surely as one past its byte cap, which is the whole justification for letting
  # a self-reported type stamp yield.
  STAGE2=0
  BREACHED=0
  if [ "$SIZE" -ge "$LIMIT" ] || [ "$NLINES" -gt "$LINE_LIMIT" ]; then BREACHED=1; fi
  SHORT=0
  if [ "$PROJ" -gt "$TARGET" ] || [ "$PROJ_L" -gt "$TARGET_LINES" ]; then SHORT=1; fi
  if [ "$SHORT" -eq 1 ] && [ "$BREACHED" -eq 1 ] && [ -n "$TYPEKEPT" ]; then
    ELIG2=""
    while IFS="$TAB" read -r mt j2 li f; do
      if [ -z "${li:-}" ]; then continue; fi
      r2=$(protect_reason "$j2" "${LINES[$li]}" "$f" 2)
      if [ -z "$r2" ]; then
        ELIG2="$ELIG2$mt$TAB${#LINES[$li]}$TAB$li$TAB$f
"
      fi
    done <<EOF
$TYPEKEPT
EOF
    if [ -n "$ELIG2" ]; then
      SORTED2=$(printf '%s' "$ELIG2" | sort -t "$TAB" -k1,1n -k2,2nr -k4,4)
      while IFS="$TAB" read -r _mt _sz li f; do
        if [ -z "${li:-}" ]; then continue; fi
        if [ "$PROJ" -le "$TARGET" ] && [ "$PROJ_L" -le "$TARGET_LINES" ]; then break; fi
        if [ "$REMAIN" -le "$MIN_KEEP" ]; then STOP_REASON=floor; break; fi
        PROJ=$(( PROJ - ${#LINES[$li]} - 1 ))
        PROJ_L=$(( PROJ_L - 1 ))
        MOVE_LNOS="$MOVE_LNOS $li"
        MOVED=$(( MOVED + 1 )); STAGE2=$(( STAGE2 + 1 )); REMAIN=$(( REMAIN - 1 ))
        vlog "move [stage2] $f (mtime $_mt)"
      done <<EOF
$SORTED2
EOF
    fi
  fi

  # ── ALL-OR-NOTHING (2026-09-03) ────────────────────────────────────────────────────────────
  # A PARTIAL move is strictly worse than no move, and it reports as SUCCESS. The loops above
  # decrement the projection by whatever each line happens to weigh and stop on REMAIN<=MIN_KEEP,
  # so on a skewed index they can move many cheap entries, never reach TARGET, and print
  # `moved=11` — which reads as healed while the breach persists AND eleven durable lessons have
  # left the hot surface for nothing. Demonstrated in a lab at the measured real-index skew.
  # If the projection does not reach BOTH targets, move NOTHING and fall through to the exhausted
  # census below, which now names what actually bound.
  # This is also the precondition for lowering the keep-floor: without it, that change converts
  # "the rotor does nothing" into "the rotor destroys the cheapest entries and still does nothing".
  if [ "$MOVED" -gt 0 ] && { [ "$PROJ" -gt "$TARGET" ] || [ "$PROJ_L" -gt "$TARGET_LINES" ]; }; then
    vlog "all-or-nothing: projection ${PROJ}/${TARGET} bytes ${PROJ_L}/${TARGET_LINES} lines after ${MOVED} candidate(s) — moving NOTHING"
    MOVE_LNOS=""; MOVED=0; STAGE2=0; SHORT_PARTIAL=1
  fi

  if [ "$MOVED" -eq 0 ]; then
    # BOUND names the true cause in one token. Three separate analyses — including
    # commands/compact-memory.md's own — read this census and went to the WRONG line of code,
    # because `min_keep=40` was the only number printed and it looked like the culprit. On the
    # index that motivated this, the real bound is `protections` (the feedback-*/reference-* name
    # keep covers 25 of 28 entries and never yields at any stage); the floor is never even reached.
    NELIG=0
    if [ -n "$ELIG" ]; then NELIG=$(printf '%s\n' "$ELIG" | grep -c . || true); fi
    BOUND=protections
    if [ "$NELIG" -gt 0 ] || [ "${SHORT_PARTIAL:-0}" -eq 1 ]; then
      # An eligible pool existed, so protections are NOT what bound this run. Name which of the
      # two real causes it was: the keep-floor cut the selection short, or the pool drained and
      # still could not reach TARGET.
      if [ "${STOP_REASON:-pool}" = floor ]; then BOUND=min_keep; else BOUND=target-unreachable; fi
    fi
    printf 'verdict=exhausted size=%s lines=%s entries=%s eligible=%s bound=%s kept: tail=%s type=%s hub=%s young=%s marker=%s dangling=%s pinned=%s unparseable=%s min_keep=%s\n' \
      "$SIZE" "$NLINES" "$NENT" "$NELIG" "$BOUND" \
      "$K_TAIL" "$K_TYPE" "$K_HUB" "$K_YOUNG" "$K_MARK" "$K_DANGLING" "$K_PIN" "$K_PARSE" "$MIN_KEEP"
    exit 4
  fi

  if [ "$DRYRUN" -eq 1 ]; then
    printf 'verdict=dry-run moved=%s stage2=%s before=%s after_projected=%s lines_before=%s lines_projected=%s\n' \
      "$MOVED" "$STAGE2" "$SIZE" "$PROJ" "$NLINES" "$PROJ_L"
    exit 0
  fi

  # ── ROUTE what may be routed; COLD is now the REMAINDER, not the destination ───────────────
  #
  # Rotation used to be a DEMOTION: every selected line went to archive/MEMORY_ARCHIVE_*-COLD.md,
  # which does not auto-load, so holding the loader cap cost the reader the rule. Routing is a
  # MOVE: the project rules file loads unprompted with no cap this size, so a line that goes
  # there is on a different surface, not on a colder one. Nothing is shortened either way.
  #
  # 🚨 route_veto APPLIES UNCHANGED AND IS NOT WEAKENED HERE. It is the operator's voice —
  # PINNED, the feedback-/reference-/user- name convention, a `type:` stamp of user/feedback/
  # reference, and the report-never-touch rule for unparseable/dangling lines. A vetoed line
  # still goes to the cold record exactly as before, which is what makes this change a strict
  # improvement rather than a re-routing of protected material. On an index whose entries are
  # nearly all `reference-` this partition therefore routes NOTHING, and that is the correct
  # outcome, not a bug to tune away: whether the machine may move a `reference-` lesson onto
  # another always-loaded surface is an operator decision that has not been given. A wave that
  # loosened a protection so its own diff would have a visible effect is the failure this
  # comment exists to prevent.
  #
  # Stage-2 (breach-pressure) selections are self-vetoing here by construction: the only entries
  # stage 2 adds are the ones whose frontmatter `type:` yields under breach, and route_veto has
  # no stages — so they take the cold path, which is the conservative direction.
  ROUTE_LNOS=""; COLD_LNOS=""; ROUTED=0; COLD_N=0; R_PAY=""; R_DESTS="-"; ROUTE_NOTE=""
  for li in $MOVE_LNOS; do
    _rf=""
    if [[ "${LINES[$li]}" =~ $ENTRY_RX ]]; then _rf="${BASH_REMATCH[1]}"; fi
    if [ -n "$(route_veto "${LINES[$li]}" "$_rf")" ]; then
      COLD_LNOS="$COLD_LNOS $li"; COLD_N=$(( COLD_N + 1 ))
    else
      ROUTE_LNOS="$ROUTE_LNOS $li"; ROUTED=$(( ROUTED + 1 ))
    fi
  done

  # The destination is resolved LAZILY — only once something is actually routable — so ordinary
  # rotation never creates a `.claude/rules/` directory in a project it had no reason to touch.
  if [ "$ROUTED" -gt 0 ]; then
    if resolve_rules_dest; then
      for li in $ROUTE_LNOS; do
        _rf=""
        if [[ "${LINES[$li]}" =~ $ENTRY_RX ]]; then _rf="${BASH_REMATCH[1]}"; fi
        R_PAY="$R_PAY$(route_dest_for "$_rf")$TAB${LINES[$li]}
"
      done
      R_PROV=$(printf '<!-- routed %s by cc-memory-rotate: %s index line(s) moved VERBATIM off %s to hold its loader cap (index %s B, target %s). Both surfaces load unprompted, so nothing was demoted and nothing was shortened; restore = paste the line back. -->' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ROUTED" "$INDEX" "$SIZE" "$TARGET")
      if route_flush "$R_PAY" "$R_PROV"; then
        R_DESTS="$ROUTE_DESTS"
      else
        # 🚨 A DESTINATION FAILURE DEGRADES TO COLD; IT DOES NOT FAIL THE ROTATION. Rotation is
        # the actuator that holds the loader cap, and the loader drops the NEWEST entries once
        # the index is over — refusing to rotate because the rules file is full or unwritable
        # would trade a recoverable surface change for live, silent data loss. The reason is
        # PRINTED in the verdict (route=<reason>), never swallowed: a silent fallback here would
        # be a demotion reported as a routing. Every destination's cap is judged before the
        # first byte is written, so the common failure cannot half-write; a later one (create /
        # append / verify) can leave a line in BOTH a rules file and the cold record, which is
        # this file's standing invariant — at worst a duplicate, never a lost line.
        ROUTE_NOTE="$ROUTE_ERR"
        COLD_LNOS="$COLD_LNOS$ROUTE_LNOS"; COLD_N=$(( COLD_N + ROUTED ))
        ROUTE_LNOS=""; ROUTED=0
        vlog "route unavailable ($ROUTE_NOTE) — $COLD_N line(s) take the cold path"
      fi
    else
      ROUTE_NOTE="$RESOLVE_REASON"
      COLD_LNOS="$COLD_LNOS$ROUTE_LNOS"; COLD_N=$(( COLD_N + ROUTED ))
      ROUTE_LNOS=""; ROUTED=0
      vlog "no routing destination ($ROUTE_NOTE) — $COLD_N line(s) take the cold path"
    fi
  fi

  # A pointer to a cold tier this rotation never wrote is a dangling pointer, written into the
  # always-loaded index. Suppress it when everything was routed. The PROJECTION above already
  # charged for it, so suppressing it only ever leaves the index SMALLER than projected — the
  # safe direction, and the shrink guarantee below still holds.
  if [ "$COLD_N" -eq 0 ]; then HAVE_PTR=1; fi

  # ── COLD first, verified, idempotent — then the index ──────────────────────────────────────
  YEAR=$(date +%Y); MON=$(date +%m)
  HALF=1; if [ "${MON#0}" -gt 6 ]; then HALF=2; fi
  COLD="$DIR/archive/MEMORY_ARCHIVE_${YEAR}-H${HALF}-COLD.md"
  mkdir -p "$DIR/archive"
  if [ "$COLD_N" -gt 0 ]; then [ -f "$COLD" ] || : >"$COLD"; fi
  # Stage the block first, append once: the idempotency greps must read a COLD that this
  # same rotation is not concurrently appending to (SC2094's hazard class).
  if [ "$COLD_N" -gt 0 ]; then
    BLOCK=$(printf '\n<!-- auto-rotated %s by cc-memory-rotate: %s entries, oldest-eligible-first by topic mtime; index %s B (rotate_at %s, target %s) -->' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$COLD_N" "$SIZE" "$ROTATE_AT" "$TARGET")
    for li in $COLD_LNOS; do
      if ! grep -qxF -- "${LINES[$li]}" "$COLD"; then
        BLOCK="$BLOCK
${LINES[$li]}"
      fi
    done
    printf '%s\n' "$BLOCK" >>"$COLD"
    for li in $COLD_LNOS; do
      if ! grep -qxF -- "${LINES[$li]}" "$COLD"; then
        printf 'verdict=error reason=cold-verify-failed\n'; exit 2
      fi
    done
  fi

  TMP=$(mktemp "$DIR/.MEMORY.md.rotate.XXXXXX")
  {
    i=0
    if [ "$HAVE_PTR" -eq 0 ]; then
      case "${LINES[0]}" in "- ["*) printf '%s\n' "$PTR_LINE" ;; esac
    fi
    while [ "$i" -lt "$NL" ]; do
      case " $MOVE_LNOS " in
        *" $i "*) : ;;
        *) printf '%s\n' "${LINES[$i]}" ;;
      esac
      if [ "$i" -eq 0 ] && [ "$HAVE_PTR" -eq 0 ]; then
        case "${LINES[0]}" in "- ["*) : ;; *) printf '%s\n' "$PTR_LINE" ;; esac
      fi
      i=$(( i + 1 ))
    done
  } >"$TMP"

  # Test seam: lets the suite mutate the index here and prove the contended path is real.
  if [ -n "${MEMORY_ROTATE_TEST_PRE_COMMIT:-}" ]; then eval "$MEMORY_ROTATE_TEST_PRE_COMMIT"; fi

  # A sibling wrote between our read and now → drop this attempt's tmp and re-run selection
  # on the fresh file rather than clobbering their append.
  if [ "$(fstat "$INDEX")" != "$SNAP" ]; then rm -f "$TMP"; continue; fi

  NEWSZ=$(fsize "$TMP")
  if [ "$NEWSZ" -ge "$SIZE" ]; then rm -f "$TMP"; printf 'verdict=error reason=would-not-shrink\n'; exit 2; fi
  chmod 644 "$TMP"
  mv -f "$TMP" "$INDEX"
  NEWLINES=$(flines "$INDEX")
  # `cold=` names a file, so it must name one that EXISTS: a fully-routed rotation writes no
  # cold record, and printing its would-be path there sends the reader to a missing file.
  COLD_DISP="-"; if [ "$COLD_N" -gt 0 ]; then COLD_DISP="$COLD"; fi
  printf 'verdict=rotated moved=%s stage2=%s before=%s after=%s lines_before=%s lines_after=%s cold=%s routed=%s dest=%s%s\n' \
    "$MOVED" "$STAGE2" "$SIZE" "$NEWSZ" "$NLINES" "$NEWLINES" "$COLD_DISP" "$ROUTED" "$R_DESTS" \
    "${ROUTE_NOTE:+ route=$ROUTE_NOTE}"
  printf '%s verdict=rotated moved=%s stage2=%s routed=%s before=%s after=%s attempt=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$MOVED" "$STAGE2" "$ROUTED" "$SIZE" "$NEWSZ" "$ATTEMPT" >>"$DIR/archive/.rotate.log" 2>/dev/null || true
  exit 0
done
