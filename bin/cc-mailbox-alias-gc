#!/usr/bin/env bash
# cc-mailbox-alias-gc — prune ~/.claude/mailbox/.alias, theft-free by construction.
#
# WHY THIS IS ITS OWN COMMAND, NOT A LINE IN A HOOK (red-team D5, 2026-08-16).
# `.alias` is not litter. It is the SOLE input to both `mailbox_alias_trail` (which panes did
# this session follow?) and `mailbox_session_is_current` (the liveness oracle that decides
# whether a predecessor's mail may be adopted). Delete the alias file for pane P and P's live
# session vanishes from the tip set; if that session appears in another pane's trail, the guard
# now reports it DEAD and its mail is adopted out from under it — the exact theft the guard
# exists to prevent. So this is a destructive, operator-visible action with a dry run by
# default, never a silent sweep bolted onto a SessionStart hook.
#
# THE ONE RULE THAT MAKES IT SAFE:
#   PROVE the tip session is DEAD before deleting its file. Never infer death from absence.
#
# Three candidate oracles, two of which are traps — recorded because each looks right:
#   • the TIP SET is circular and protects everything. It is built FROM every file's own last
#     line, so a file's own tip is a member by construction. Written that way first; this tool's
#     own dry run caught it (0 deletions, 1,297 "protected"), which is why dry-run is the default.
#   • the REGISTRY under-reports — measured 7 entries against 25 live processes — and an
#     under-reporting liveness oracle is precisely the one that causes theft.
#   • the TRANSCRIPT is sound: a session appends to its jsonl continuously while it runs, so "no
#     transcript touched in N days" is positive evidence of death. Anything not provably dead is
#     PROTECTED, so the failure mode is a file that outlives its usefulness — never a stolen box.
# Age alone is NOT a proxy either: a long-lived session's alias file is only touched at pane
# boundaries, so it ages while the session is very much alive. The age floor is applied only
# AFTER death is proven, as a second, independent brake.
#
# Verified with a controlled fixture (positive + negative control): a 60-day-old file whose tip
# has no transcript is deleted; an equally 60-day-old file whose tip is a LIVE session is kept.
#
# Cost context: the O(N) scan this file's growth used to make expensive was fixed separately
# (mailbox-pending.sh:548, one memoised awk pass — 5.5s -> 0.04s for 1,300 files), so this is
# HYGIENE, not a latency fix. At 0.04s/1,300 files the scan tolerates an order of magnitude more.
# Run it when the directory gets untidy, not on a schedule, and never in a hook.
#
# Usage:
#   cc-mailbox-alias-gc                 # dry run (default) — prints what WOULD go
#   cc-mailbox-alias-gc --apply         # actually delete
#   cc-mailbox-alias-gc --older-than N  # age floor in days (default 30)
set -uo pipefail

APPLY=0
DAYS=30
while [ $# -gt 0 ]; do
  case "$1" in
    --apply)      APPLY=1 ;;
    --older-than) shift; DAYS="${1:-30}" ;;
    -h|--help)    sed -n '1,30p' "$0"; exit 0 ;;
    *) echo "cc-mailbox-alias-gc: unknown arg '$1'" >&2; exit 2 ;;
  esac
  shift
done
case "$DAYS" in ''|*[!0-9]*) echo "cc-mailbox-alias-gc: --older-than needs an integer" >&2; exit 2 ;; esac

MBX="${CC_MAILBOX_DIR:-$HOME/.claude/mailbox}"
ALIAS="${MBX}/.alias"
[ -d "$ALIAS" ] || { echo "cc-mailbox-alias-gc: no alias dir at ${ALIAS} — nothing to do."; exit 0; }

# The tip set, computed exactly as mailbox_session_is_current computes it: last line's field 2,
# per file, in ONE awk pass. Deliberately re-derived here rather than sourced — this command must
# work standalone, and a divergence would be caught by the count printed below.
TIPS="$(find "$ALIAS" -maxdepth 1 -type f -print0 2>/dev/null \
  | xargs -0 awk '{ last[FILENAME] = $2 } END { for (f in last) if (last[f] != "") print last[f] }' 2>/dev/null \
  | sort -u)"
TIPCOUNT="$(printf '%s\n' "$TIPS" | grep -c . || true)"
TRANSCRIPT_INDEX="$(mktemp -t ccaliasgc)"
trap 'rm -f "$TRANSCRIPT_INDEX"' EXIT INT TERM
TOTAL="$(find "$ALIAS" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')"

echo "── mailbox .alias GC ──"
echo "   dir:   ${ALIAS}"
echo "   files: ${TOTAL}    current tips (protected, any age): ${TIPCOUNT}"
echo "   mode:  $( [ "$APPLY" -eq 1 ] && echo 'APPLY (deleting)' || echo 'DRY RUN (nothing will be deleted)' )   age floor: >${DAYS}d"
echo

> "$TRANSCRIPT_INDEX"
for _pd in "$HOME"/.claude "$HOME"/.claude-*; do
  [ -d "${_pd}/projects" ] || continue
  find "${_pd}/projects" -maxdepth 2 -name '*.jsonl' -mtime "-${DAYS}" 2>/dev/null \
    | sed 's|.*/||; s|\.jsonl$||' >> "$TRANSCRIPT_INDEX"
done
sort -u -o "$TRANSCRIPT_INDEX" "$TRANSCRIPT_INDEX"
RECENT="$(grep -c . "$TRANSCRIPT_INDEX" || true)"
echo "   sessions with a transcript touched in the last ${DAYS}d (treated as ALIVE): ${RECENT}"
echo

del=0; kept_live=0; kept_young=0; kept_unprovable=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  tip="$(awk '{ last = $2 } END { print last }' "$f" 2>/dev/null)"
  # RULE 1 — PROVE DEATH, never assume it. The tip set cannot serve here: it is built FROM every
  # file's own last line, so a file's own tip is in it by construction and the test would protect
  # everything (caught by this tool's own dry run, 2026-08-16). The registry cannot serve either —
  # measured 7 entries against 25 live processes, and an under-reporting liveness oracle is the
  # one failure mode that causes THEFT. A session's transcript is appended to continuously while
  # it runs, so "no transcript touched in ${DAYS} days" is positive evidence of death; anything we
  # cannot positively prove dead is PROTECTED (absence is loud).
  if [ -n "$tip" ] && grep -qxF "$tip" "$TRANSCRIPT_INDEX" 2>/dev/null; then
    kept_live=$(( kept_live + 1 )); continue
  fi
  # RULE 2 — age floor on the alias file itself, applied only after rule 1 passed.
  if [ -n "$(find "$f" -mtime "+${DAYS}" 2>/dev/null)" ]; then
    if [ "$APPLY" -eq 1 ]; then rm -f "$f" 2>/dev/null && del=$(( del + 1 ))
    else echo "   would delete: $(basename "$f")  (tip=${tip:-none}, no transcript in ${DAYS}d)"; del=$(( del + 1 )); fi
  else
    kept_young=$(( kept_young + 1 ))
  fi
done <<EOF
$(find "$ALIAS" -maxdepth 1 -type f 2>/dev/null)
EOF

echo
echo "   $( [ "$APPLY" -eq 1 ] && echo 'deleted' || echo 'would delete' ): ${del}"
echo "   kept — tip ALIVE (transcript touched <${DAYS}d): ${kept_live}"
echo "   kept — newer than ${DAYS}d:     ${kept_young}"
[ "$APPLY" -eq 1 ] || echo
[ "$APPLY" -eq 1 ] || echo "   re-run with --apply to delete."
exit 0
