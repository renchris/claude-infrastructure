#!/bin/bash
# desk-register — register the CURRENT pane as the machine-wide desk (P0-15 role indirection).
#
# The desk identity is a FILE: ${CC_ROLES_DIR:-~/.claude/cc-roles}/desk holds the pane UUID of
# whichever pane currently holds the role. Every role-addressed consumer follows it —
# cc-notify/cc-announce (ping routing), cc-await-ping (mailbox), cc-reaper (page target,
# CC_PAGE_TO_FILE), cc-classify (desk-role NEVER-REAP, a17 S-3), cc-dispatch (worker back-channel),
# hooks/waiting-recycle.sh (idle-recycle gate) and scripts/desk-invariant.sh (desk-existence sweep).
#
# handoff-fire.sh already writes this file on an `--as-role desk` fire, so a FIRED desk is
# registered automatically. This tool is the missing standalone primitive: it registers a desk that
# was started by HAND (`claude-desk`, or `/desk` in an already-open session), which handoff-fire
# never touched. Registration is the single activation trigger — hooks/desk-brief-inject.sh keys the
# canonical brief injection off this exact file.
#
# Usage:
#   desk-register [--role <name>] [--pane <uuid|sid|name>] [--print] [--quiet] [--force]
#
# Output (default):
#   registered <role> → <pane>              (exit 0, newly claimed)
#   already <role> → <pane>                 (exit 0, idempotent no-op — same pane)
#   reassigned <role>: <old> → <pane>       (exit 0, role moved to this pane)
#
# Pane resolution (first hit wins):
#   --pane <value>  → used VERBATIM (a caller passing an explicit target owns its shape; the role
#                     file legitimately holds a uuid, a session id, or a pane name).
#   $SESSION_ID     → used verbatim.
#   $ITERM_SESSION_ID ("w2t0p3:<UUID>") → the part after the last colon, SHAPE-CHECKED against the
#                     id space of the terminal we are actually in: an iTerm2 pane UUID, or — inside
#                     kitty, where the login shim synthesises "w0t0p0:$KITTY_WINDOW_ID" — that same
#                     integer window id, accepted only when cc-in-kitty confirms the ancestry AND the
#                     value equals $KITTY_WINDOW_ID.
# The shape check exists because `${VAR##*:}` on an unset/malformed variable silently yields garbage
# rather than empty — and a garbage role file breaks every consumer above SILENTLY (pings route to
# nowhere, the reaper pages a pane that does not exist, cc-classify stops protecting the real desk).
# Fail loud instead. --force skips the shape check (escape hatch; still refuses an empty value).
#
# Writes are atomic (tmp + mv, mirroring handoff-fire.sh write_role) so a concurrent reader never
# sees a half-written role file.
#
# ── CRASH-PATH SUCCESSION: a REASSIGNMENT also leaves a mailbox `.forward` ────────────────────────
# Repointing the role file only re-addresses ROLE-addressed mail. Every back-channel ping ever fired
# carries a RAW pane uuid, and those keep enqueuing into the predecessor's box — the class that
# stranded 631/206/155 unread lines in former-desk boxes. handoff-fire writes a `.forward` to close
# that, but ONLY on a graceful self-close (write_forward_for, its sole caller): a desk that CRASHES,
# OOMs or is hard-reaped never runs that chain, so its replacement inherited the role and none of the
# mail. This is where the crash path becomes observable — someone claiming a role another pane held —
# so the pointer is written here too, making the dead box a pointer and letting the successor's
# SessionStart adopt the predecessor's unconsumed tail. Best-effort by construction: a missing lib or
# an unwritable dir must NEVER fail a registration, and mailbox_write_forward itself refuses anything
# that is not a canonical uuid (a role holding a name/session-id simply gets no pointer).
#
# Env overrides (tests):
#   CC_ROLES_DIR   (default ~/.claude/cc-roles) · CC_MAILBOX_DIR (the forward pointer's dir)
#   CC_IN_KITTY_BIN (default `cc-in-kitty`) — the ancestry predicate for the kitty id space
set -uo pipefail

ROLES_DIR="${CC_ROLES_DIR:-$HOME/.claude/cc-roles}"

usage() { sed -n '2,42p' "$0" | sed 's/^# \{0,1\}//'; }

ROLE="desk" PANE="" QUIET=0 PRINT=0 FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --role)    ROLE="${2:?--role needs a value}"; shift 2 ;;
    --pane)    PANE="${2:?--pane needs a value}"; shift 2 ;;
    --print)   PRINT=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --force)   FORCE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         echo "desk-register: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

# --print: report the CURRENT holder without writing anything (the read half of the contract).
if [ "$PRINT" = 1 ]; then
  cur="$(head -n1 "$ROLES_DIR/$ROLE" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$cur" ] || { echo "desk-register: no '$ROLE' role registered" >&2; exit 1; }
  printf '%s\n' "$cur"; exit 0
fi

# --- resolve this pane ------------------------------------------------------------------------
explicit=1
if [ -z "$PANE" ]; then
  if [ -n "${SESSION_ID:-}" ]; then
    PANE="$SESSION_ID"
  else
    itsid="${CC_PANE_ID:-${ITERM_SESSION_ID:-}}"
    [ -n "$itsid" ] || {
      echo "desk-register: no \$ITERM_SESSION_ID and no --pane — cannot tell which pane to register." >&2
      echo "   Run this INSIDE the pane that should hold the '$ROLE' role, or pass --pane <uuid>." >&2
      exit 1
    }
    PANE="${itsid##*:}"
    explicit=0
  fi
fi
[ -n "$PANE" ] || { echo "desk-register: resolved an EMPTY pane id — refusing to write a role file that routes nowhere." >&2; exit 1; }

# ── THE SHAPE CHECK HAS TWO ID SPACES, NOT ONE (backlog 9002948eb52c, 2026-09-08) ───────────────
# This check shipped knowing only iTerm2's, and its refusal message says so: "Expected the iTerm2
# form 'w0t0p0:<UUID>'". Under kitty that sentence is false, and it made the primitive INOPERATIVE
# on the only terminal this fleet runs: scripts/kitty-setup.sh:290 exports a SYNTHETIC
# ITERM_SESSION_ID="w0t0p0:$KITTY_WINDOW_ID", so `${itsid##*:}` yields a bare integer, the UUID case
# never matches, and every hand-started desk was refused with rc 1. Measured 2026-09-08 —
# `ITERM_SESSION_ID=w0t0p0:618 desk-register` → "did not yield a pane UUID (got '618')", nothing
# written. The live cc-roles/ files disagreed with this check the whole time: desk=330,
# docs-lead=450, drain-lead=7, all written by handoff-fire's write_role via self_pane_id
# (handoff-fire.sh:1632), which returns $KITTY_WINDOW_ID verbatim under kitty. So the WRITER already
# spoke both id spaces and only this VALIDATOR did not — an inconsistency invisible from either side
# alone. scripts/limit-recover/lr-handoff.sh:402 states the rule this now mirrors: "in a kitty fleet
# a 'session uuid' IS the integer kitty window id."
#
# WHY IT IS NOT SIMPLY "ALSO ACCEPT DIGITS". The check's whole purpose is that a garbage role file
# breaks ping routing, the reaper's page target and cc-classify's never-reap SILENTLY, so a wider
# accept set must not widen the garbage that gets through. KITTY_WINDOW_ID and ITERM_SESSION_ID are
# both ordinary env vars that inherit transitively and permanently across terminal boundaries
# (bin/cc-in-kitty's header measures both directions), so a bare integer arriving here has three
# possible origins and only one of them is us. Two independent terms separate them:
#   1. bin/cc-in-kitty — ancestry, not environment. Fail-closed by construction (exit 2, "KITTY_*
#      present but UNVERIFIABLE", counts as no), so an iTerm2 pane carrying a polluted KITTY_* env
#      is refused here exactly as it is refused everywhere else in the tree.
#   2. PAIR AGREEMENT — the derived id must equal $KITTY_WINDOW_ID, the same assertion
#      scripts/kitty-setup.sh:468 makes ("want=w0t0p0:$KITTY_WINDOW_ID"). This is what catches a
#      STALE ITERM_SESSION_ID inherited from an iTerm2 ancestor INSIDE a genuine kitty window, which
#      term 1 alone cannot see. kitty reuses small window ids across restarts, so that collision is
#      structural rather than unlucky (handoff-fire.sh:1656).
# Both must hold. --pane/$SESSION_ID (explicit) and --force are unchanged: they were never checked.
CC_IN_KITTY_BIN="${CC_IN_KITTY_BIN:-cc-in-kitty}"
derived_is_kitty_window() { # → 0 iff $PANE is THIS kitty window's id, by ancestry AND pair agreement
  case "$PANE" in ''|*[!0-9]*) return 1 ;; esac
  [ -n "${KITTY_WINDOW_ID:-}" ] && [ "$PANE" = "$KITTY_WINDOW_ID" ] || return 1
  command -v "$CC_IN_KITTY_BIN" >/dev/null 2>&1 || return 1
  "$CC_IN_KITTY_BIN" >/dev/null 2>&1
}

# Shape-check ONLY the derived-from-$ITERM_SESSION_ID path (see header). An explicit --pane/$SESSION_ID
# is the caller's own contract and may legitimately be a session id or a pane name.
if [ "$explicit" = 0 ] && [ "$FORCE" = 0 ]; then
  case "$PANE" in
    [0-9A-Fa-f]*-[0-9A-Fa-f]*-[0-9A-Fa-f]*-[0-9A-Fa-f]*-[0-9A-Fa-f]*) : ;;
    *)
      if derived_is_kitty_window; then : ; else
      echo "desk-register: \$ITERM_SESSION_ID='${CC_PANE_ID:-${ITERM_SESSION_ID:-}}' did not yield a pane id for THIS terminal (got '$PANE')." >&2
      echo "   Expected the iTerm2 form 'w0t0p0:<UUID>', or — inside kitty — 'w0t0p0:<KITTY_WINDOW_ID>'" >&2
      echo "   matching \$KITTY_WINDOW_ID='${KITTY_WINDOW_ID:-unset}' with $CC_IN_KITTY_BIN confirming the ancestry." >&2
      echo "   A malformed role file breaks ping routing, the reaper page target and cc-classify's" >&2
      echo "   desk never-reap SILENTLY — refusing. Use --pane/--force." >&2
      exit 1
      fi ;;
  esac
fi

# --- idempotent atomic write ------------------------------------------------------------------
prev="$(head -n1 "$ROLES_DIR/$ROLE" 2>/dev/null | tr -d '[:space:]')"
if [ "$prev" = "$PANE" ]; then
  [ "$QUIET" = 1 ] || printf 'already %s → %s\n' "$ROLE" "$PANE"
  exit 0
fi

# The mailbox twin of the role repoint (see CRASH-PATH SUCCESSION above). Sourced lazily and guarded
# by a function-exists check, exactly as handoff-fire's write_forward_for does — a missing lib degrades
# to "no pointer written", never a failed registration.
write_forward() { # <old-pane> <new-pane> → 0 iff a pointer was written
  local old="$1" new="$2" lib
  [ -n "$old" ] && [ -n "$new" ] && [ "$old" != "$new" ] || return 1
  for lib in "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/hooks/lib/mailbox-pending.sh" \
             "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/lib/mailbox-pending.sh" \
             "$HOME/.claude/hooks/lib/mailbox-pending.sh"; do
    # shellcheck disable=SC1090,SC1091
    [ -f "$lib" ] && { . "$lib" 2>/dev/null || true; break; }
  done
  command -v mailbox_write_forward >/dev/null 2>&1 || return 1
  mailbox_write_forward "$old" "$new" 2>/dev/null || return 1
  return 0
}

mkdir -p "$ROLES_DIR" 2>/dev/null || { echo "desk-register: cannot create roles dir: $ROLES_DIR" >&2; exit 1; }
tmp="$ROLES_DIR/.$ROLE.$$"
if printf '%s\n' "$PANE" > "$tmp" 2>/dev/null && mv -f "$tmp" "$ROLES_DIR/$ROLE" 2>/dev/null; then
  fwd=""
  if [ -n "$prev" ]; then write_forward "$prev" "$PANE" && fwd=" (mail forwarded: $prev → $PANE)"; fi
  if [ "$QUIET" != 1 ]; then
    if [ -n "$prev" ]; then printf 'reassigned %s: %s → %s%s\n' "$ROLE" "$prev" "$PANE" "$fwd"
    else                    printf 'registered %s → %s\n' "$ROLE" "$PANE"; fi
  fi
  exit 0
fi
rm -f "$tmp" 2>/dev/null
echo "desk-register: failed to write $ROLES_DIR/$ROLE" >&2
exit 1
