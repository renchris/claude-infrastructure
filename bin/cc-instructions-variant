#!/usr/bin/env bash
# cc-instructions-variant — choose the machine's global instructions variant (slim, full, …).
#
# WHY. The always-loaded instructions (~/.claude/CLAUDE.md, 40.4k tokens on 2026-09-23) ride in every
# context on every account — main sessions, subagents, workflow agents, headless runs — so a slimmer
# variant is the largest single token lever on this box, and also the change most able to alter
# behaviour. It therefore ships behind this switch. HISTORY (2026-09-23 to 2026-10-03): an account
# listed in ~/.claude/instruction-variants read ~/.claude/CLAUDE.<variant>.md as its CLAUDE.md and
# ~/.claude/rules.<variant>/ as its rules/; the config mirror still honours such a legacy line
# (lib/config-mirror.zsh, _cc_instructions_variant_target) until migration 0053 removes it, and
# `reset <account>` is how it goes. A switch reaches NEW sessions
# only; running sessions keep what they loaded. Every switch is appended to the log, so a census can
# split sessions by the arm they started under. Design and test plan:
# docs/research/token-efficiency-2026-09-23/.
#
# RULING 2026-09-23 (operator): accounts are interchangeable ("all of our behavior, configuration,
# should be account agnostic"), so an arm must NOT be pinned to one account in production. Use this
# tool only on a throwaway/offline config dir, or for a fleet-wide switch (all accounts or none).
# Experiments assign the arm per session at launch or run headless offline; see TEST_PLAN.md.
#
# VARIANTS ARE GLOBAL SINCE 2026-10-03 (docs/plans/INSTRUCTION_BUDGET.md D2/D4). Claude Code's ancestor
# walk loads ~/.claude/CLAUDE.md and ~/.claude/rules/ for every cwd under $HOME, and dedupes them
# against the account's own CLAUDE.md/rules only by realpath. So an account whose CLAUDE.md resolves
# anywhere but ~/.claude/CLAUDE.md loads BOTH files — that is what 0042's per-account arm did to every
# session from 2026-09-25. The variant is therefore chosen once, for the machine: `set <variant>`
# records `global <variant>` in the registry and copies that variant into ~/.claude/CLAUDE.md (install.sh
# does the same from the repo on every deploy), and every account links to ~/.claude/CLAUDE.md.
# `set <account> <variant>` is refused; per-session A/B arms run only in /tmp fixtures.
#
# Usage:
#   cc-instructions-variant [status]          each account: arm, CLAUDE.md target, bytes; DUPLICATE rows
#   cc-instructions-variant set <variant>     the global variant: slim, full, or any deployed CLAUDE.<v>.md
#   cc-instructions-variant reset <account>   point one account back at the shared ~/.claude/CLAUDE.md
#   cc-instructions-variant log               the switch log
# <account> is an accounts.json name (next, next2, next3, next4) or a ~/.claude-* dir basename.
# Exit: 0 ok · 1 the change did not take (read back) · 2 usage error or refused.
set -euo pipefail

SRC="$HOME/.claude"
REG="$SRC/instruction-variants"
LOG="$SRC/autonomy/instruction-variants.jsonl"
MIRROR="$SRC/lib/config-mirror.zsh"

die() { printf 'cc-instructions-variant: %s\n' "$*" >&2; exit 2; }

account_dirs() {  # every account config dir: accounts.json first, the glob as a fallback
  if [ -r "$SRC/accounts.json" ] && command -v jq >/dev/null 2>&1; then
    jq -r '.accounts[]?.config_dir // empty' "$SRC/accounts.json" 2>/dev/null | sed "s|^~|$HOME|"
  else
    for d in "$HOME"/.claude-*; do [ -e "$d/CLAUDE.md" ] && printf '%s\n' "$d"; done
  fi
}

account_dir() {  # <account> → its config dir, or die
  local a="$1" d=""
  case "$a" in
    .claude-*) d="$HOME/$a" ;;
    "$HOME"/.claude-*) d="$a" ;;
    *) [ -r "$SRC/accounts.json" ] && d="$(jq -r --arg a "$a" \
         '.accounts[]? | select(.name == $a) | .config_dir // empty' "$SRC/accounts.json" 2>/dev/null | awk 'NR<=1')"
       d="${d/#\~/$HOME}" ;;
  esac
  [ -n "$d" ] && [ -d "$d" ] && [ "$d" != "$SRC" ] \
    || die "unknown account '$a' (an accounts.json name such as next3, or a ~/.claude-* dir)"
  printf '%s\n' "$d"
}

sha256_16() {  # <file> → first 16 hex of its sha256
  { shasum -a 256 "$1" 2>/dev/null || sha256sum "$1"; } | cut -c1-16
}

global_variant() {  # the machine's variant: the registry's `global` line, default slim (install.sh agrees)
  local v; v="$(registered global)"; printf '%s\n' "${v:-slim}"
}

realpath_of() {  # <path> → its fully resolved path, or nothing
  python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null || true
}

registered() {  # <dir-basename> → its variant, or nothing
  [ -r "$REG" ] && awk -v a="$1" '$1 == a { print $2; exit }' "$REG" || true
}

write_reg() {  # <dir-basename> [variant] — replace or drop that account's line, atomically
  local tmp="$REG.tmp.$$"
  { [ -r "$REG" ] && awk -v a="$1" '$1 != a' "$REG"; [ -n "${2:-}" ] && printf '%s %s\n' "$1" "$2"; } > "$tmp" || true
  mv -f "$tmp" "$REG"
}

log_event() {  # <dir-basename> <variant> <action>
  mkdir -p "${LOG%/*}"
  printf '{"ts":"%s","account":"%s","variant":"%s","action":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" >> "$LOG"
}

resync() {  # <dir> <want CLAUDE.md> <want rules>: re-run the mirror (race-safe mode), read both links back
  zsh -fc "source '$MIRROR'; _cc_sync_config_mirror '$1'" >/dev/null 2>&1 || true
  local entry want got
  for entry in "CLAUDE.md=$2" "rules=$3"; do
    want="${entry#*=}"
    got="$(readlink "$1/${entry%%=*}" 2>/dev/null || true)"
    if [ "$got" != "$want" ]; then
      printf 'cc-instructions-variant: %s/%s points at %s, expected %s\n' "${1##*/}" "${entry%%=*}" "${got:-nothing}" "$want" >&2
      exit 1
    fi
  done
  printf '%s/CLAUDE.md -> %s (%s bytes); rules/ -> %s. New sessions on this account load them.\n' \
    "${1##*/}" "${2/#$HOME/\~}" "$(wc -c < "$2" | tr -d ' ')" "${3/#$HOME/\~}"
}

cmd_status() {
  local d base arm tgt want_md want_rules got_md got_rules
  printf 'global variant: %s (~/.claude/CLAUDE.md, %s bytes)\n' "$(global_variant)" \
    "$(wc -c < "$SRC/CLAUDE.md" 2>/dev/null | tr -d ' ' || printf 0)"
  want_md="$(realpath_of "$SRC/CLAUDE.md")"; want_rules="$(realpath_of "$SRC/rules")"
  printf '%-20s %-8s %-28s %s\n' ACCOUNT ARM 'CLAUDE.md ->' BYTES
  while IFS= read -r d; do
    [ -e "$d/CLAUDE.md" ] || continue
    base="${d##*/}"; arm="$(registered "$base")"
    tgt="$(readlink "$d/CLAUDE.md" 2>/dev/null || printf '(real file)')"
    printf '%-20s %-8s %-28s %s\n' "$base" "${arm:-shared}" "${tgt/#$HOME/~}" "$(wc -c < "$d/CLAUDE.md" | tr -d ' ')"
    # The ancestor walk loads ~/.claude/CLAUDE.md and ~/.claude/rules/ on top of the account's own
    # files unless both resolve to the same realpath, so any other target is a double load.
    got_md="$(realpath_of "$d/CLAUDE.md")"
    got_rules=""; [ -e "$d/rules" ] && got_rules="$(realpath_of "$d/rules")"
    if [ "$got_md" != "$want_md" ]; then
      printf 'DUPLICATE: %s/CLAUDE.md resolves to %s, so its sessions also load ~/.claude/CLAUDE.md; migration 0053 re-points it\n' "$base" "${got_md/#$HOME/~}"
    fi
    if [ -n "$got_rules" ] && [ "$got_rules" != "$want_rules" ]; then
      printf 'DUPLICATE: %s/rules resolves to %s, so its sessions also load ~/.claude/rules/; migration 0053 re-points it\n' "$base" "${got_rules/#$HOME/~}"
    fi
  done < <(account_dirs)
  printf 'variants available: full'
  local f
  for f in "$SRC"/CLAUDE.*.md; do
    [ -f "$f" ] || continue
    f="${f##*/CLAUDE.}"; f="${f%.md}"
    [ "$f" = full ] || printf ' %s' "$f"
  done
  printf '\n'
  # A variant records which full text it was derived from (an HTML comment, which the loader strips,
  # so it costs no tokens). An operator edit to the full file after that makes the variant STALE: its
  # arm silently lacks the new rule until the variant is re-derived. The full text deploys to
  # CLAUDE.full.md; a box install.sh has not reached since 2026-10-03 still holds it in CLAUDE.md.
  local full_h var_h full="$SRC/CLAUDE.full.md"
  [ -f "$full" ] || full="$SRC/CLAUDE.md"
  full_h="$(sha256_16 "$full")"
  for f in "$SRC"/CLAUDE.*.md; do
    [ -f "$f" ] && [ "$f" != "$SRC/CLAUDE.full.md" ] || continue
    var_h="$(sed -n 's/.*derived-from CLAUDE\.global\.md sha256:\([0-9a-f]\{16\}\).*/\1/p' "$f" | awk 'NR<=1')"
    if [ -z "$var_h" ]; then
      printf '  %s: no derived-from record\n' "${f##*/}"
    elif [ "$var_h" = "$full_h" ]; then
      printf '  %s: in sync with the full text (%s)\n' "${f##*/}" "$full_h"
    else
      printf '  %s: STALE, derived from %s but the full text is now %s; re-derive the changed sections\n' "${f##*/}" "$var_h" "$full_h"
    fi
  done
}

cmd_set() {
  [ $# -eq 2 ] && die "refused: variants are global. An account CLAUDE.md that resolves anywhere but ~/.claude/CLAUDE.md loads both files (Claude Code's ancestor walk), so 'set $1 $2' would re-create the double load. Choose the machine's variant with 'set <variant>'; run per-session A/B arms in /tmp fixtures."
  [ $# -eq 1 ] || die "usage: set <variant>"
  local v="$1" src tmp
  [[ "$v" =~ ^[a-z0-9-]+$ ]] || die "variant names are [a-z0-9-]+"
  src="$SRC/CLAUDE.$v.md"
  [ -f "$src" ] || die "no $src — deploy it first (install.sh copies CLAUDE.global.md to CLAUDE.full.md and CLAUDE.global.<v>.md to CLAUDE.<v>.md)"
  write_reg global "$v"
  log_event global "$v" set
  # A regular file, never a symlink: a symlinked ~/.claude/CLAUDE.md still double-loads on 2.1.114.
  tmp="$SRC/CLAUDE.md.tmp.$$"
  cp "$src" "$tmp" && mv -f "$tmp" "$SRC/CLAUDE.md"
  if [ -L "$SRC/CLAUDE.md" ] || ! cmp -s "$src" "$SRC/CLAUDE.md"; then
    printf 'cc-instructions-variant: ~/.claude/CLAUDE.md does not read back as %s\n' "$src" >&2
    exit 1
  fi
  printf '%s/CLAUDE.md <- the %s variant (%s bytes). New sessions load it; install.sh keeps it.\n' \
    "$SRC" "$v" "$(wc -c < "$SRC/CLAUDE.md" | tr -d ' ')"
}

cmd_reset() {
  [ $# -eq 1 ] || die "usage: reset <account>"
  local d; d="$(account_dir "$1")"
  write_reg "${d##*/}"
  log_event "${d##*/}" shared reset
  resync "$d" "$SRC/CLAUDE.md" "$SRC/rules"
}

case "${1:-status}" in
  status) cmd_status ;;
  set) shift; cmd_set "$@" ;;
  reset) shift; cmd_reset "$@" ;;
  log) [ -r "$LOG" ] && cat "$LOG" || printf 'no switches logged\n' ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (status | set | reset | log)" ;;
esac
