#!/bin/bash
# cc-dispatch — the L4 dispatcher spine ("Claude kicks off Claude"; T-P7-4/5, Program D).
#
# Cron-woken (launchd → `cc-dispatch --once`): pull open backlog items → quota-place via
# cc-wave-plan → claim + spawn a worker session → log the decision to the IDL. It does NOT land
# work itself — the spawned session's lead lands via the existing ship-land rails.
#
# THE ABSTENTION LAW (mirrors cc-route RT-c): a quota-cliff PAGES and STOPS. It is never a silent
# fence and never a blind spawn — cc-dispatch fires ONLY on a live, quota-cleared placement.
#
#   cc-dispatch [--once] [--dry-run]     one cron pass: pull → decide → admit → claim + spawn
#   cc-dispatch --decide                 a DECIDE-ONLY pass: journal decisions, zero spawns
#   cc-dispatch selftest                 RED-proves every branch against stubbed actuators
#
# FLOW (each step is fail-LOUD / abstain, never fail-silent-open):
#   1. items  = `<backlog> list --open --json`, filtered dispatchable: status=="open" AND
#               project == CC_DISPATCH_PROJECT. Already-claimed items are skipped.
#   1b. DONE-GUARD: an item carrying the ledger's done latch (`wasDone`) is dropped from the wave
#               and recorded as IDL {action:"skipped"} — completed work is never re-dispatched by
#               a reopen. Cleared only by `cc-backlog reopen <id> --force`. (2026-07-20 incident.)
#   1d. STALE-PREMISE GUARD: an auto-generated `source=="plan-open"` item whose dodRef plan has
#               since gone `complete`/`superseded` is dropped AND retracted (`cc-backlog done`,
#               evidence `premise-retracted:`) — the item's only claim was "this plan is open".
#               Scoped to plan-open alone: a terminal dodRef says nothing about a human-filed item.
#               Fail-OPEN (the premise is a FILE, not the ledger fold). CC_DISPATCH_PREMISE_GATE=off.
#   2. no items                    → IDL {action:"passed", detail:"backlog empty"}, exit 0.
#   3. wave   = [{id, slot}]  (slot from an optional item hint; MVP default "lead")
#      plan   = `<wave-plan> --items <wave-json> --json`
#   4. wave-plan WALL → dispatch on its VERDICT (stderr `WALL[<v>]`, rc as fallback), never on rc alone:
#        capped  (4) → IDL {action:"abstained", detail:"quota-cliff"} + PAGE (/limit-recover), exit 0
#        capacity(4) → re-plan ONCE at the reported capacity=<n>; else DEFER, no page (not a cliff)
#        auth    (5) → IDL {action:"walled"} + PAGE (/relogin), exit 0 — an auth wall, not a quota one
#        unknown (6) → DEFER, no page, no failure: the oracle gave no answer, retry next pass
#                                    NEVER spawn on any wall.  (any rc OUTSIDE those four → exit 3)
#   5. per placement, up to CC_DISPATCH_MAX_SPAWN (default 2):
#        a. `<backlog> claim <id> --by $SID`
#        b. spawn `<spawn-bin> <fire_line...>`   (fire_line = an ARGV ARRAY, injection-safe)
#           non-zero → `<backlog> reopen <id>` + IDL {action:"failed"}
#        c. success  → IDL {action:"fired", detail:"<id> -> <account>"}
#   6. --dry-run  → steps 1-4 as READS only; PRINT the plan; NO IDL / page / claim / spawn.
#      --once     → a single pass (the cron entrypoint; default when no mode flag is given).
#   7. one run-summary IDL {action:"summary", fired:N, abstained:B, failed:F}.
#
# ── V2 — the DECISION/ADMISSION split (docs/plans/AUTONOMY_DISPATCH_V2.md §3 S1,S2,S6,S7) ─────────
# The v1 frame above cannot decide about an item without SPAWNING it: the wave was `.[0:MAX_SPAWN]`
# of the open backlog, so an item at queue position P waited ⌈P/2⌉ ticks (≈15 h at the measured
# N=121) for ANY decision; and with no fleet concurrency ceiling anywhere the dispatcher fired
# 2/tick unconditionally until it had exhausted the very quota it then paged about (50 fires in
# 17.5 h, then 12 `quota-cliff` abstentions = 28.6 % of passes). V2 splits the two steps:
#
#   DECISION — a pure read over the WHOLE backlog, every pass. For every non-blocked open item emit
#     ONE journal record {action:"decision", pass, id, verdict, position, reason, free_slots,
#     live_workers}; verdict ∈ admit | defer | skip. It costs no quota, no session and (below the
#     ceiling) no oracle call, so decision latency = pass cadence, independent of N.   S1 / F1
#   ADMISSION — the ONLY capacity-bound step. free_slots = max(0, CEILING − live_workers), with
#     live_workers = the ledger's `claimed` fold (workers dispatch has OUT) — never a session count.
#     The first free_slots items by the S7 key are admitted; every other item DEFERS with its queue
#     position. free_slots == 0 ⇒ ZERO wave-plan calls, ZERO claims, ZERO spawns, ZERO pages:
#     "backlog > concurrency" is a NORMAL, RECORDED state, never a cliff.                S2 / F2,F3
#   UNKNOWN ≠ 0 and ≠ cliff — an unresolvable/hung/unparseable oracle admits AT MOST 1, with
#     reason "live-count-unknown" and live_workers:null. Conservative, yet never 0-forever (a dead
#     oracle must not stall the queue) and never the full ceiling (never a blind fire).   S4 / R4
#   ORDER — thrash-count ASCENDING (this id's `failed` records in the IDL), then the DERIVED RANK
#     (land-rail > citation in-degree > recurrence), then oldest ts, so an item that repeatedly
#     fails to spawn SINKS instead of starving the queue head.                            S7 / F10
#   CLUSTER — a slot is spent per CLUSTER, not per ROW: the first member of a cluster admits and
#     every later member defers with reason "cluster-sibling", so N rows naming one root cause take
#     ONE worker and the freed slots go to different work. DEFER, never close.       M2 / 1b00d62958a6
#   FRESH TREE — a worker is never fired into a tree that provably predates the base: a reused
#     `wt-<id>` branch is fast-forwarded when it carries nothing and REFUSED when it carries commits,
#     and a pre-existing worktree directory is checked before the fire.               M2 / 1b00d62958a6
#     Both read three states — fresh | stale | unknown — and only a PROVEN-stale tree refuses.
#   SINGLETON — one ADMISSION at a time behind a `mkdir` lock pinned by pid|lstart (`kill -0` alone
#     wedges forever on a recycled pid). A pass that finds a LIVE holder still DECIDES (the journal
#     is a pure read), records {action:"skipped", reason:"pass-in-flight"} alongside its decisions,
#     and exits 0 having taken ZERO claims and fired ZERO spawns — skip-the-ADMISSION, never queue:
#     a queueing lock is how a pass that outruns its interval becomes five concurrent passes.
#     The lock gates ADMISSION ONLY — see THE LOCK COVERS ADMISSION, NOT DECISION below.  S6 / F8,F9
#
# ── THE LOCK COVERS ADMISSION, NOT DECISION (item de5e3e24be8f, AUTONOMY_DISPATCH_V2 §10 A2) ──────
# THE DEFECT. The singleton was acquired at step 0 and held to process exit, so ONE lock covered
# both phases — and the two have wildly different costs. Measured over the journal window
# 2026-07-30T19:35Z→2026-07-31T05:32Z: the DECISION phase over a full ~135-item backlog takes
# 7–45 s, but the ADMISSION tail (wave-plan → claim → warm worktree → handoff-fire) takes
# 414–833 s. A kick arriving during a tail therefore found a live holder, wrote a bare
# {skipped, pass-in-flight} and returned WITHOUT DECIDING ANYTHING. Pass gaps reached 1073 s
# (58 of 170 over 300 s, 21 skipped passes), so the 300 s launchd backstop could not hold the
# 5-minute bound: 3 of 18 in-window adds missed it (338/515/714 s) against a p50 of 8 s.
# That directly contradicts S1's own premise — "a decision is a pure read: it costs no quota, no
# session, no lock" — which the implementation violated by holding the decision lock through
# admission.
#
# THE FIX — narrow what the lock GATES, never what it PROTECTS. A pass that loses the lock no
# longer returns at step 0: it runs the whole decision phase, journals a verdict for every
# dispatchable item, and returns before the first capacity-consuming act. Decision latency is
# back to the pass cadence for EVERY pass, contended or not, and the {skipped, pass-in-flight}
# record is still written (A9's observable) — now alongside the decisions rather than instead of
# them.
#
# THE COST, STATED (this is a real trade, not a free win). A skipped pass used to append ONE record;
# it now appends one per dispatchable item (~135 live), so a spawn tail long enough to skip 2-3
# passes multiplies the IDL's growth over that span. That matters because the IDL is not write-only:
# `thrash_map` slurps the whole file (`jq -s`) every pass to build the S7 fairness key, so its size
# is inside the decision phase's own cost. It is bounded by scripts/rotate-autonomy-logs.sh (the
# live file was already 26 MB and has rotated four times, most recently 20260730T193526Z), and the
# extra records are exactly the product this change exists to produce — but if the decision phase's
# 7-45 s ever creeps, the IDL's size is the first place to look, not the item count.
#
# WHY NOT the two obvious alternatives, both of which look smaller and are wrong:
#   (a) "release the lock before the spawn tail, keep the pull inside." UNSAFE TWICE OVER when this
#       was written; ONE of the two reasons has since been closed, and the conclusion still holds on
#       the other. Reason 1 (RETIRED 2026-08-05, backlog 1cb7724b2ed9): `cc-backlog claim` had NO
#       already-claimed guard, so two passes whose pulls straddled a claim BOTH claimed the same id —
#       the 2026-07-20 double-worker incident exactly. `claim` is now a LEASE: a claim against an
#       item whose holder is not PROVEN dead is refused rc 4 (see THE CLAIM IS A LEASE in
#       cc-backlog's header), and a pass still inside its own tail is live by `kill -0`, so the
#       second pass is refused rather than duplicated. Reason 2 STILL BINDS and is why this stays as
#       it is: `warm_worktree` runs `git -C <repo> worktree add`, which races on .git/config.lock
#       when two tails run concurrently (GH #34645/#48927). The tail genuinely needs serialising —
#       the lease is a second line of defence BEHIND this lock, never a replacement for it.
#   (b) "a second, separate admission lock." Buys nothing here: the loser of an admission lock would
#       still have to decide lock-free to fix A2, and once it does, the FIRST lock has no remaining
#       job. One lock, acquired at the same instant as before, is strictly less mechanism.
# So the holder's path is BYTE-IDENTICAL to before — pull, order, count, admit and spawn all still
# happen under the one lock it always held. Only the LOSER's path changed, and only by adding reads.
#
# WHY THE CEILING CANNOT DOUBLE-ADMIT (the invariant this lock exists for; header note 2 below).
# It is not weakened, because it is not enforced by the lock's DURATION but by the lock's presence
# over [read live_workers … take claims]. A pass without the lock reaches neither: `admit_n` is
# forced to 0 before the journal is written, and the pass returns before wave-plan, before claim and
# before spawn. The claiming code is UNREACHABLE without the lock, so N concurrent passes still
# admit at most CEILING between them — RED-proved against the pristine pre-S6 tree, which double-
# claims the same id under the same fixture (tests/cc-dispatch-v2.bats).
#
# MAX_SPAWN vs CEILING — both survive, with distinct jobs: MAX_SPAWN is the PER-PASS spawn cap (an
# existing guard, kept verbatim at step 5); CEILING is the FLEET cap admission is computed from.
# With CEILING > MAX_SPAWN a pass admits more than it fires; the surplus takes NO claim (step 5
# breaks before the claim) and is simply re-admitted next pass. CEILING must stay <= cc-wave-plan's
# total concurrency (|accounts| × CC_WAVE_MAX_PER_ACCT = 8 today), else the admitted wave would trip
# that planner's own "never a partial" capacity guard — the false cliff `bef587ac` fixed.
#
# CONTRACT with cc-wave-plan (T-P7-6, its owner; consumed here purely through the env seam):
#   input : --items '[{"id":"<id>","slot":"lead"}, ...]' --json
#   stdout: a JSON ARRAY of placements, each {"id","account","fire_line":[argv...], ...}
#   exit  : 0 = placements emitted · 4 = capped | capacity · 5 = auth · 6 = unknown
#   stderr: `cc-wave-plan: … WALL[<verdict>] — …` on every wall, and `capacity=<n>` on the capacity
#           arm. The rc alone CANNOT separate capped from capacity, so the verdict token is the
#           discriminator and the rc is only its fallback map.
#   fire_line is an argv ARRAY so cc-dispatch passes it VERBATIM to the spawn bin — no eval,
#   no word-splitting (a plain-string fire_line is accepted too, as a single argument).
#
# Exit: 0 = normal (passed | abstained-cliff | fired/failed loop) · 3 = config-fail LOUD
#       (jq / a required actuator unresolvable, or wave-plan returned an rc OUTSIDE its four defined
#       verdicts — a defined non-verdict like `unknown` is a deferral, never a config-fail).
# Env (actuator seams — every external side-effect is overridable so bats can stub it):
#   CC_DISPATCH_BACKLOG_BIN  (default: cc-backlog on PATH / sibling)
#   CC_DISPATCH_WAVEPLAN_BIN (default: cc-wave-plan on PATH / sibling)
#   CC_DISPATCH_SPAWN_BIN    (default: $HOME/.claude/scripts/handoff-fire.sh)
#   CC_DISPATCH_PAGES_DIR    (default: $HOME/.claude/autonomy/pages)   — the desk page channel
#   CC_DISPATCH_IDL          (default: $HOME/.claude/autonomy/idl.jsonl)
#   CC_DISPATCH_PROJECT      (default: git toplevel, else $PWD)
#   CC_DISPATCH_MAX_SPAWN    (default: 2)          per-PASS spawn cap (unchanged)
#   CC_DISPATCH_SID          (default: <host>-<pid>)
#   CC_DISPATCH_CEILING      (default: 12)  ON-BOX concurrency ceiling (panes/worktrees/CPU); 0 ⇒
#                                           admit nothing (decisions are still journalled — a
#                                           pure-observation mode). Charged only for claims whose
#                                           venue is NOT cloud; see live_workers.
#
#                                           WAS 6 UNTIL 2026-08-12, AND 6 HAD BECOME A HARD STOP ON
#                                           THE WHOLE DRAIN. Measured 13:33Z: 70 passes in one hour,
#                                           316 rows, EVERY one verdict=defer reason=at-ceiling,
#                                           free_slots 0, live_workers 8. Not wedged — correctly
#                                           refusing over a real population — but the autonomous
#                                           drain fired NOTHING, while the operator's own stated
#                                           budget is ~15 concurrent sessions. At 6, any six
#                                           sessions the operator opens shut the drain off outright,
#                                           which is the opposite of "runs on the side".
#
#                                           WHY 12 IS SAFE NOW AND WAS NOT THIS MORNING. This
#                                           ceiling is a COARSE pre-filter, not the operator's
#                                           protection. The fine-grained guard is at the SPAWN:
#                                           cc-dispatch spawns through CC_DISPATCH_SPAWN_BIN =
#                                           handoff-fire.sh (see resolve_bin below), and
#                                           handoff-fire consults scripts/lib/spawn-presence.sh —
#                                           the presence beat plus the reserve floor autonomy may
#                                           never take. That library did not exist before 450a47c50
#                                           and did not reach the live layer until the 2026-08-12
#                                           06:19 converge, so until today this number WAS the only
#                                           thing between the operator and an unbounded drain. It no
#                                           longer is. 12 also keeps a wide margin under the 54 the
#                                           box was measured to sustain (10 consecutive green
#                                           samples of 14,321) and under the operator's own ~15.
#
#                                           🚨 Do NOT raise this without re-reading the spawn call
#                                           site to confirm it still consults spawn-presence. A grep
#                                           census is not enough: `grep reserve` matches `preserved`
#                                           and manufactured a false positive here on the first
#                                           attempt at exactly this check.
#   CC_DISPATCH_CLOUD_CEILING (default: 6)  OFF-BOX ceiling, charged for venue=cloud claims. A
#                                           separate resource (quota) from a separate bound — an
#                                           off-box session costs this box no pane and no worktree.
#   CC_DISPATCH_LOCK_DIR     (default: <dir of CC_DISPATCH_IDL>/dispatch.lock)  the S6 pass lock
#   CC_DISPATCH_DECIDE_ONLY  (default: off)  on ⇒ decisions only: zero claims/spawns/pages
#   CC_DISPATCH_LANE         (default: v2)   v1 ⇒ the incumbent path verbatim (whole-rebuild switch)
#   CC_DISPATCH_RANK         (default: on)   off ⇒ no derived rank; order reverts to thrash+oldest
#   CC_DISPATCH_CLUSTER      (default: on)   off ⇒ a slot per ROW again, not per cluster
#   CC_DISPATCH_WT_FRESH     (default: on)   off ⇒ reuse a wt- branch / pre-existing tree unchecked
#   CC_DISPATCH_WT_BASE      (default: the repo's own origin/HEAD, else origin/main)
#   CC_DISPATCH_VENUE_BIN    (default: co-versioned sibling cc-venue, else PATH / ~/.claude/bin)
#   CC_DISPATCH_READY_GATE   (default: advisory)  the READINESS precondition of admission (W1):
#                            advisory ⇒ journal the verdict and admit anyway (measure first);
#                            enforce  ⇒ a `void` item DEFERS (never a drop, never a done);
#                            off      ⇒ no verdict computed at all.
#   CC_DISPATCH_READY_MAX    (default: 6)     hard bound on readiness checks per pass — past it the
#                                             verdict is UNKNOWN, which never blocks
#   CC_DISPATCH_READY_SCAN   (default: 4000)  IDL tail lines scanned for a prior `readyAt`
#   CC_DISPATCH_VENUE_ONLY   (default: unset) cloud|local ⇒ admit ONLY items whose venuePlan is
#                                           this venue; everything else is PARKED and counted in
#                                           the IDL. The migration lever — DECIDE_ONLY stops every
#                                           spawn, this one stops all but one venue. An unrecognised
#                                           value REFUSES the pass (a filter matching nothing is a
#                                           total outage that reads as an empty queue).
#   CC_DISPATCH_VENUE_LABEL  (default: on)    off ⇒ no write-path venue labelling
#   CC_DISPATCH_VENUE_NEW_WINDOW_S (default: 900) how new a row must be to be labelled on the
#                                             add-kick; the bound is a POPULATION, never a count
#   CC_DISPATCH_VENUE_NEW_MAX (default: 2)    labels per decide pass
#   (CC_BACKLOG_FILE flows through to the backlog bin unchanged — tests point it at a temp jsonl.)
set -uo pipefail

PAGES_DIR="${CC_DISPATCH_PAGES_DIR:-$HOME/.claude/autonomy/pages}"
IDL="${CC_DISPATCH_IDL:-$HOME/.claude/autonomy/idl.jsonl}"
MAX_SPAWN="${CC_DISPATCH_MAX_SPAWN:-2}"
SID="${CC_DISPATCH_SID:-$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)-$$}"
PROJECT="${CC_DISPATCH_PROJECT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
# the ledger convention is the short project NAME (cc-backlog/cc-discover use basename), so a
# path-style value (env or pwd default) must normalize — unormalized it matches NOTHING and the
# cron pull reads "backlog empty" forever (found live 2026-07-19)
PROJECT="$(basename "$PROJECT")"

# ── THE DISPATCH SET (multi-project coverage; backlog f7abcbdee98c) ────────────────────────────────
# THE DEFECT. The pull filtered `.project == $PROJECT` for exactly ONE project — the one the launchd
# plist pins. An open item in any OTHER project was not deferred, not skipped, not decided: it was
# INVISIBLE. Not "deprioritised" — structurally undrained, with no record anywhere that it existed.
# Measured 2026-07-29: 19 such items (doc_classifier 7, reso-management-app 7, "/" 5), oldest 8 days
# old, and the 5 OLDEST open items in the whole ledger were among them.
#
# THE DECISION — one multi-project pass, NOT a second launchd instance per project. Four reasons,
# each independently sufficient:
#   1. THE SINGLETON LOCK IS SHARED. LOCK_DIR is `dirname($IDL)/dispatch.lock` — one path for every
#      instance, so N instances SERIALISE. Giving each its own IDL to dodge that fragments
#      thrash_map (the S7 fairness key reads the IDL) and breaks dispatch-acceptance.sh's single-IDL
#      group_by(.pass).
#      [AMENDED 2026-07-31, item de5e3e24be8f] This clause used to read "N instances mutually record
#      {skipped, pass-in-flight}, so coverage becomes INTERMITTENT BY CONSTRUCTION". That mechanism
#      is GONE: the lock now gates admission only, so N instances would each DECIDE about the whole
#      set every pass and coverage would not be intermittent at all. The conclusion is unchanged and
#      the cost is simply a different one — N instances would write N duplicate decision journals per
#      cadence over one shared IDL, N-folding its growth and making `group_by(.pass)` report N passes
#      that all cover the same items. Reasons 2-4 below are untouched and each remains independently
#      sufficient. Recorded rather than silently rewritten: a fix that falsifies a neighbouring
#      argument owes that argument an amendment, not a quiet deletion.
#   2. THE FLEET CEILING WOULD MULTIPLY. live_workers is the GLOBAL `claimed` fold, so N instances
#      each compute free_slots = CEILING − live independently and can each admit that many in the
#      same window → up to N×CEILING concurrent workers against cc-wave-plan's total concurrency of
#      8. Exceeding it is precisely the false cliff bef587ac fixed.
#   3. COVERAGE WOULD BECOME AN OPERATOR ACTION PER PROJECT. A new plist needs `launchctl bootstrap`
#      (C10, operator-only; 6 activations are already rotting >24 h) — the same silently-incomplete
#      wiring class this item IS. A conf row needs no activation.
#   4. CROSS-PROJECT FAIRNESS IS FREE IN ONE QUEUE. The existing S7 key (thrash ASC, then oldest ts)
#      sorts the 5 long-undrained doc_classifier items to positions 1-5 of the shared queue — they
#      drain FIRST. N independent queues cannot express "oldest across all projects".
# Widening cannot cause a spawn storm: the ceiling is global and ALREADY binding (measured
# free_slots=0 at live=6/ceiling=6), so this changes WHICH items are eligible, never HOW MANY fire.
#
# THE SET = {PROJECT} ∪ {conf rows with repo=}. One rule, no precedence puzzle, and CC_DISPATCH_PROJECT
# is unioned in unconditionally so a bad conf edit can never silently un-cover the pinned project.
# CC_DISPATCH_PROJECT is list-tolerant (comma/space separated); a single value with no conf file is
# byte-identical to the pre-change behaviour.

# CONF PATH — resolve $0's SYMLINK first. Production invokes this as $HOME/.claude/bin/cc-dispatch,
# which is a symlink into the checkout; the deployed `scripts/` dir is PER-FILE symlinks and a NEW
# file is never linked into it (memory: deploy-lag-checkout-behind-origin — and live proof:
# ~/.claude/scripts/growth-coverage.conf does not exist). A dirname($0)-relative read would resolve
# to ~/.claude/scripts/dispatch-projects.conf and find NOTHING, silently narrowing coverage back to
# the single pinned project — the exact defect, reintroduced by its own fix. Resolving the symlink
# makes ONE path correct, so there is no fallback ladder to collapse
# (memory: shared-lib-source-ladder-collapses-when-deployed).
_self="$0"
while [ -L "$_self" ]; do
  _lnk="$(readlink "$_self" 2>/dev/null)" || break
  case "$_lnk" in /*) _self="$_lnk" ;; *) _self="$(dirname "$_self")/$_lnk" ;; esac
done
PROJECTS_CONF="${CC_DISPATCH_PROJECTS_CONF:-$(cd "$(dirname "$_self")/.." 2>/dev/null && pwd)/scripts/dispatch-projects.conf}"

# conf_rows <verb> → the projects declared with that verb, one per line ("" when the conf is absent).
# Deliberately tolerant: an unreadable/malformed conf yields NO rows, which degrades to the pinned
# project alone — narrower coverage, never a wider blind fire.
conf_rows() {
  [ -r "$PROJECTS_CONF" ] || return 0
  awk -v verb="$1" '
    /^[[:space:]]*(#|$)/ { next }
    { key=$1; rest=$0; sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", rest)
      if (rest !~ "^" verb "=") next
      sub("^" verb "=", "", rest); sub(/[[:space:]]+#.*$/, "", rest)
      sub(/[[:space:]]+$/, "", rest)
      # a verb with an EMPTY value is not a declaration. Treating `repo=` as one would silently fall
      # through to the ~/Development/<project> convention, i.e. a typo would quietly dispatch a
      # project nobody declared; leaving it undeclared keeps it in the LOUD uncovered set instead.
      if (rest != "") print key }
  ' "$PROJECTS_CONF" 2>/dev/null || true
}

# conf_repo <project> → the repo path declared for it, "" when undeclared. `~` expands, and an inline
# `# comment` after the value is stripped (a human writes those; an unstripped one would become part
# of the path and fail the git-repo gate with a baffling message).
conf_repo() {
  [ -r "$PROJECTS_CONF" ] || return 0
  local r
  r="$(awk -v p="$1" '
    /^[[:space:]]*(#|$)/ { next }
    $1 == p { rest=$0; sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", rest)
              if (rest ~ /^repo=/) { sub(/^repo=/, "", rest); sub(/[[:space:]]+#.*$/, "", rest)
                                     sub(/[[:space:]]+$/, "", rest); print rest; exit } }
  ' "$PROJECTS_CONF" 2>/dev/null || true)"
  case "$r" in "~"/*) r="$HOME${r#\~}" ;; esac
  printf '%s' "$r"
}

# PROJECTS = the dispatch set, newline-separated and de-duplicated, pinned project FIRST.
PROJECTS="$(
  { printf '%s\n' "$PROJECT" | tr ',' '\n' | tr ' ' '\n'; conf_rows repo; } \
    | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | grep -v '^$' | awk '!seen[$0]++'
)"
# The jq-side membership test, built in pure shell: this runs at init, BEFORE the `command -v jq`
# guard, and a jq failure here would silently yield an empty filter that matches NOTHING — a
# total-coverage outage dressed as "backlog empty". A dispatchable project name is also VALIDATED
# to a plain ledger label: it names a directory under ~/Development by convention, it becomes part
# of a jq filter, and it must never be a path. This is what structurally refuses "/" and
# "/tmp/wt-autonomy-100" — the corrupt producer labels — as dispatch targets.
PROJECTS_JSON="["
_pj_sep=""; _pj_valid=""
while IFS= read -r _p; do
  [ -n "$_p" ] || continue
  case "$_p" in
    *[!A-Za-z0-9._-]*)
      echo "cc-dispatch: refusing a malformed dispatchable project label: '$_p' (expected a plain ledger name, not a path) — check $PROJECTS_CONF" >&2
      continue ;;
  esac
  PROJECTS_JSON="${PROJECTS_JSON}${_pj_sep}\"${_p}\""
  _pj_sep=","
  _pj_valid="${_pj_valid}${_p}
"
done <<EOF
$PROJECTS
EOF
PROJECTS_JSON="${PROJECTS_JSON}]"
# PROJECTS and PROJECTS_JSON must describe the SAME set: a label rejected above is dropped from
# BOTH, so no consumer can act on a project the filter will never match.
PROJECTS="${_pj_valid%$'\n'}"

# project_repo <project> → the git repo a worker for that project is provisioned FROM.
# Resolution: conf `repo=` → CC_DISPATCH_REPO (the pinned project ONLY — a single global override
# cannot speak for a foreign project) → the $HOME/Development/<project> convention (verified against
# every real project in the ledger 2026-07-29). NEVER a claude-infrastructure fallback: silently
# provisioning a foreign item's worktree from THIS repo would fire a worker into the wrong tree
# holding this repo's standing-land authorization.
project_repo() {
  local p="$1" r
  r="$(conf_repo "$p")"
  [ -n "$r" ] && { printf '%s' "$r"; return 0; }
  if [ "$p" = "$PROJECT" ] && [ -n "${CC_DISPATCH_REPO:-}" ]; then printf '%s' "$CC_DISPATCH_REPO"; return 0; fi
  printf '%s/Development/%s' "$HOME" "$p"
}

# ── V2 config ─────────────────────────────────────────────────────────────────────────────────────
CEILING="${CC_DISPATCH_CEILING:-12}"
# The OFF-BOX ceiling — a separate resource, therefore a separate bound (2026-08-12). It is a POLICY
# default, not a measurement: the off-box concurrency limit is recorded UNMEASURED
# (CONCURRENCY_PROGRAM.md §S5-CEILING, blocker named as create reliability rather than quota), so
# this number's job is only to stop the cloud lane becoming unbounded now that it no longer draws
# from CEILING. Raise it on evidence, never on optimism.
CLOUD_CEILING="${CC_DISPATCH_CLOUD_CEILING:-6}"
LANE="${CC_DISPATCH_LANE:-v2}"
# The pass lock lives in the SAME state dir as the IDL rather than at a second independent $HOME
# path: the production default is then byte-identical to ~/.claude/autonomy/dispatch.lock, AND every
# caller that already fixtures CC_DISPATCH_IDL (i.e. every test) fixtures the lock for free instead
# of silently mkdir-ing into the operator's live tree.
LOCK_DIR="${CC_DISPATCH_LOCK_DIR:-$(dirname "$IDL")/dispatch.lock}"
LOCK_HELD=0
# one id per PASS so a consumer can `group_by(.pass)` (acceptance A1 keys on it)
PASS_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
FREE_SLOTS=0    # admission budget for this pass  (set by the decision stage)
LIVE_RAW=""     # live-worker count as read, "" = UNKNOWN (never conflated with 0)

FIRED=0; ABSTAINED=0; FAILED=0; SKIPPED=0   # run counters → the summary record
ADMITTED=0; DEFERRED=0                      # v2 decision counters → the same summary

usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
die3() { echo "cc-dispatch: $*" >&2; exit 3; }   # config-fail is LOUD, never a silent no-op

# is_uint / is_on — bash 3.2 has no ${var,,}, so truthiness is an explicit set. Both keep their
# `case` inside a FUNCTION BODY: a literal `case` written inside $( ) is a runtime parse death on
# bash 3.2 that `bash -n` and shellcheck both pass (verified on this box), and these are called
# from command substitutions.
is_uint() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
is_on()   { case "${1:-}" in on|On|ON|1|true|True|TRUE|yes|Yes|YES) return 0 ;; *) return 1 ;; esac; }

is_uint "$CEILING"          || die3 "CC_DISPATCH_CEILING must be a non-negative integer (got '$CEILING')"
is_uint "$CLOUD_CEILING"    || die3 "CC_DISPATCH_CLOUD_CEILING must be a non-negative integer (got '$CLOUD_CEILING')"
case "$LANE" in v1|v2) ;; *) die3 "CC_DISPATCH_LANE must be v1 or v2 (got '$LANE')" ;; esac

# resolve_bin <override> <name> [fallback-abspath...] → echoes an executable path, or "" (rc 1)
resolve_bin() {
  local override="$1" name="$2"; shift 2
  if [ -n "$override" ]; then echo "$override"; return 0; fi
  if command -v "$name" >/dev/null 2>&1; then command -v "$name"; return 0; fi
  local f; for f in "$@"; do [ -x "$f" ] && { echo "$f"; return 0; }; done
  local sib; sib="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$name"
  [ -x "$sib" ] && { echo "$sib"; return 0; }
  echo ""; return 1
}

# idl <action> <detail> — one append-only decision record (best-effort; a cron sweep never
# hard-fails on log I/O). Shape mirrors the desk IDL: {ts, actor, action, detail}.
idl() {
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -cn --arg ts "$(now_iso)" --arg action "$1" --arg detail "$2" \
     '{ts:$ts, actor:"cc-dispatch", action:$action, detail:$detail}' >> "$IDL" 2>/dev/null || true
}

# ── S1: the decision journal ──────────────────────────────────────────────────────────────────────
# idl_decision <id> <verdict admit|defer|skip> <position> <reason> [project]
# ONE record per non-blocked open item per pass. This is the whole point of the v2 split: a DECISION
# is a pure read, so it can cover the ENTIRE backlog every pass and decision latency stops being
# O(backlog). `defer` is a REAL, RECORDED decision — the way "backlog > concurrency" is EXPRESSED —
# never an abstention and never a cliff. Field names are the CONSUMED contract of
# scripts/dispatch-acceptance.sh (A1 groups by .pass and counts distinct .id; A7 reads
# .live_workers on admit records) — renaming one silently breaks the acceptance read.
# `project` is the ITEM's project, not the pass's: with a multi-project dispatch set (see the
# DISPATCH SET header block) one pass decides about several projects, so a pass-level project field
# would mislabel every foreign record. Defaults to the pinned project when the caller omits it.
idl_decision() {
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -cn --arg ts "$(now_iso)" --arg pass "$PASS_ID" --arg id "$1" --arg verdict "$2" \
     --argjson position "$3" --arg reason "$4" --argjson free "$FREE_SLOTS" \
     --argjson ceiling "$CEILING" --arg live "$LIVE_RAW" --arg project "${5:-$PROJECT}" \
     '{ts:$ts, actor:"cc-dispatch", action:"decision", pass:$pass, project:$project, id:$id,
       verdict:$verdict, position:$position, reason:$reason, free_slots:$free, ceiling:$ceiling,
       live_workers:(if $live == "" then null else ($live|tonumber) end)}' \
     >> "$IDL" 2>/dev/null || true
}

# S6: a pass that found the singleton held records WHY it did nothing. Never a silent no-op — an
# unrecorded skip is indistinguishable from an inert dispatcher (the 3-day inertness this rebuild
# was measured against). `detail` rides along so detail-reading consumers see a string too.
idl_inflight() {
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -cn --arg ts "$(now_iso)" --arg pass "$PASS_ID" \
     '{ts:$ts, actor:"cc-dispatch", action:"skipped", pass:$pass, reason:"pass-in-flight",
       detail:"another pass holds the singleton lock"}' >> "$IDL" 2>/dev/null || true
}


# live_workers → how many workers DISPATCH currently has out, or "" for UNKNOWN.
#
# This is the ledger's `claimed` fold — NOT a live-session count, and the distinction decides
# whether this dispatcher works at all (AUTONOMY_DISPATCH_V2 §3 S2, landed 15cc1f4f). An earlier
# revision summed `.rows[].k` from `claude-accounts --json` on the reasoning that a FLEET ceiling
# should charge for the operator's panes too. Measured on live disk that sum was 12 while the
# claimed count was 0: at the default CEILING=6 it yields free_slots = max(0, 6−12) = 0
# PERMANENTLY. The dispatcher would admit nothing, ever — and because deferrals never page by
# design (R2), it would do so in total silence. Strictly worse than the false cliff this rebuild
# removes: a false cliff at least pages. Raising CEILING does not rescue it either; those 12 are
# leads, desk panes, teammates and sibling rebuilds, all fluctuating independently of dispatch, so
# any constant is either wedged or meaningless. Charging dispatch for human activity lets the
# operator silently throttle autonomy to zero.
#
# Three properties follow, and they are why this is the better design rather than merely a fix:
#   · no oracle is consulted — no timeout, no expiry path, no unknown-from-the-network;
#   · it SELF-HEALS: a dead worker's claim is reopened by cc-backlog's `reap` liveness oracles
#     (cc-backlog:52-84), so the ceiling cannot wedge at a stale count. Dispatch deliberately does
#     NOT implement its own liveness probe — duplicating reap would reintroduce the false-dead
#     verdict that spawns a duplicate peer onto live work;
#   · it is the honest unit: the ceiling exists to stop DISPATCH exhausting quota by its own
#     spawning, and dispatch only controls its own workers.
# A failure to read or parse the ledger still collapses to "" — UNKNOWN, which the caller must
# never read as 0 and never as a cliff. Absence of a verdict is a THIRD state.
#
# 🚨 THE FOLD IS VENUE-SCOPED, AND THAT IS THE WHOLE POINT OF THE CEILING (2026-08-12).
# Measured wedge: six OFF-BOX cloud sessions, fired by this dispatcher between 03:41Z and 07:15Z,
# were folded by a venue-BLIND `.status=="claimed"` into a ceiling of 6 → `free_slots:0,
# live_workers:6, deferred:318, fired:0` on every pass from 07:15Z onward. Cloud AND local both
# stopped. The bug is a category error in the denominator: this ceiling bounds what DISPATCH spawns
# ON THIS BOX — a pane, a worktree, local CPU — and an off-box session consumes none of the three.
# CLOUD_BACKLOG_PIPELINE.md:162 states it directly: routing to cloud is a CAPACITY decision, "what
# cloud uniquely spares is this box's CPU, RAM, pane and worktree". Charging it against the local
# ceiling spends the very slot the migration was made to free.
#
# So the resource and its bound are now named together, one ceiling per resource:
#   local slots  ← claims with venue != cloud, bounded by CEILING       (pane/worktree/CPU)
#   cloud slots  ← claims with venue == cloud, bounded by CLOUD_CEILING (quota + off-box concurrency)
# A cloud lane left UNBOUNDED would be the opposite defect — this fix must not turn a wedge into a
# runaway — and the off-box ceiling is recorded UNMEASURED (CONCURRENCY_PROGRAM §S5-CEILING), so
# CLOUD_CEILING is a policy default, not a measurement, and is named as such.
#
# `venue` is a FIELD READ, not an oracle: all three properties above survive unchanged — nothing is
# probed, nothing can time out, and `reap` still owns liveness. A row with no venue counts as LOCAL
# (absence of a plan is not evidence of off-box-ness — the same fail-CLOSED direction cc-venue takes).
live_workers() { # <backlog-bin> [venue] → count of workers dispatch has OUT there, or "" for UNKNOWN
  local b="$1" venue="${2:-local}" n filter
  [ -n "$b" ] || return 0
  case "$venue" in
    cloud) filter='.venue == "cloud"' ;;
    local) filter='(.venue // "local") != "cloud"' ;;
    any)   filter='true' ;;
    *)     return 0 ;;
  esac
  # $filter is interpolated into the jq PROGRAM, which is safe here and only here: it comes from the
  # closed case set above and never from a ledger value or an argument.
  n="$("$b" list --all --json 2>/dev/null \
       | jq -er 'if type=="array" then ([.[] | select(.status=="claimed") | select('"$filter"')] | length) else error("not an array") end' \
         2>/dev/null)" || return 0
  is_uint "$n" || return 0
  echo "$n"
}

# fire_excerpt <file> → a bounded, single-line tail of the fire's own output, or "" when there is
# none. ASCII-only and newline-free BY CONSTRUCTION: this is interpolated into a jq --arg, and a
# `tail -c` that split a multi-byte UTF-8 sequence would make jq fail — dropping the entire record,
# i.e. losing the evidence at precisely the moment it finally exists. The TAIL, not the head: a
# fire's diagnostic is on its exit path, never in its banner.
fire_excerpt() {
  { [ -n "${1:-}" ] && [ -s "$1" ]; } || return 0
  tr '\n\t' '  ' < "$1" 2>/dev/null | tr -cd '\40-\176' | tail -c 200
}

# fire_log_keep <id> <account> <rc> <file> — persist a fire's OWN output, success included.
#
# The excerpt functions above feed the IDL, which is a verdict journal: 200 bounded characters, one
# line, built to be greppable. That is the wrong shape for the thing an incident actually needs — the
# fire's narration of which pane it anchored to, whether focus came back, and what it closed. So the
# full stream is appended here instead, in its own file, and the IDL keeps its one-line verdict.
#
# Bounded three ways so a log cannot become the next outage: tail -c per fire, 0600, and a size-
# triggered single-generation rotation. Fail-open at every step — a dispatcher must never die because
# a log could not be written (memory: addon-failure-exceeds-its-blast-radius; a side-car must fail no
# wider than itself). Seam CC_DISPATCH_FIRE_LOG for the tests.
fire_log_keep() { # $1=item id $2=account $3=rc $4=captured-output file
  local _lf="${CC_DISPATCH_FIRE_LOG:-$HOME/.claude/logs/dispatch-fires.log}" _max=4194304
  { [ -n "${4:-}" ] && [ -s "$4" ]; } || return 0
  mkdir -p "$(dirname "$_lf")" 2>/dev/null || return 0
  # Single-generation rotation: one `.1`, never an unbounded chain.
  local _sz
  _sz="$(/usr/bin/stat -f %z "$_lf" 2>/dev/null || echo 0)"
  case "$_sz" in ''|*[!0-9]*) _sz=0 ;; esac
  [ "$_sz" -gt "$_max" ] && mv -f "$_lf" "$_lf.1" 2>/dev/null
  {
    printf '\n===== %s item=%s account=%s rc=%s pid=%s =====\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "${1:-?}" "${2:-?}" "${3:-?}" "$$"
    tail -c 8192 "$4" 2>/dev/null
  } >> "$_lf" 2>/dev/null || true
  chmod 600 "$_lf" 2>/dev/null || true
  return 0
}

# ---- G5: THE VENUE, and the declare that makes an off-box session observable ------------------
# `cc-backlog claim --venue local|cloud` shipped fully built and fully tested with ZERO PRODUCERS.
# This is the producer. It matters more than a label: the venue string SELECTS WHICH ORACLES MAY
# CONVICT the item (bin/cc-backlog § VENUE), so an off-box session claimed as `local` is judged by
# oracles that structurally cannot see it — and reads as DEAD while it is working.
#
# fire_venue <fire argv> → "cloud" | "local".
# Read off the argv that will ACTUALLY RUN — `$spawn "${fire_args[@]}"` — and not re-derived from
# the plan, because that argv is the one source which cannot disagree with what was launched. A
# venue label that disagrees with the fire is worse than no label at all: it is a mislabel that
# reads as a verdict.
#
# ELEMENT-EXACT, never a substring test. `--venue` is a closed set at the actuator for exactly this
# reason, and a loose match here would hand that actuator a well-formed string derived from the
# wrong fire — e.g. a payload or an --extra that merely MENTIONS --cloud.
fire_venue() {
  local a
  for a in "$@"; do
    if [ "$a" = "--cloud" ]; then printf cloud; return 0; fi
  done
  printf local
}

# fire_branch <fire argv> → the branch the fire targets, or "" when it names none.
# Needed because `cc-cloud declare` REQUIRES --branch (an undeclared session is unobservable, so it
# refuses to record a half-identified one). Two sources, in the order the fire itself resolves them:
# an explicit --worktree, else the basename of --cwd — which is not a guess but warm_worktree's own
# rule (`br="$(basename "$wt")"`), so the two can never answer this question differently.
# Prints NOTHING when neither is present: an unnameable branch is loud downstream, never invented.
fire_branch() {
  local prev="" a
  for a in "$@"; do
    if [ "$prev" = "--worktree" ]; then printf '%s' "$a"; return 0; fi
    prev="$a"
  done
  prev=""
  for a in "$@"; do
    if [ "$prev" = "--cwd" ]; then printf '%s' "${a##*/}"; return 0; fi
    prev="$a"
  done
  return 0
}

# cloud_declare <item id> <captured fire output> <branch> → prints a one-line verdict; 0 declared.
#
# CLOUD_OBSERVABILITY.md §8.1: a cloud session id DOES NOT EXIST until after the fire — it is a
# return value — so declare-before-fire is unsatisfiable and the id must be scraped from the fire's
# own output and declared immediately after.
#
# EVERY failure path returns 1 with UNDECLARED in the verdict, and the caller says so loudly. This
# is the failure worth being loud about: the fire returned 0, the session is LIVE and spending an
# account's quota, and only its observability is missing — so nothing on this box can see it, name
# it, or reap it, and nothing will ever report it absent either. A silent swallow here produces a
# session that exists only off-box (bin/cc-cloud:51 — "pushed nothing and was never declared leaves
# zero trace anywhere this box can read").
#
# cc-cloud is called as a CLI and is NEVER edited from here. (--account landed with W2; the routed
# account is now passed through, so the declaration records WHICH account's quota the off-box
# session is spending — the TODO this comment used to carry is resolved.)
#
# ── THE MANAGEMENT FIELDS (2026-08-11, the lead's first-fire integration find) ──────────────────
# cc-offload up records custody/notify-back on the declaration and opens the custody debt AT THE
# FIRE; this path — the dispatcher's cloud leg — declared bare. Consequence, measured on the very
# first producer-routed dispatch (session_01YcTifmgrKh3KFYuz45Rret, item 38de29ec5e59, fired
# 2026-08-11T20:30Z): cloud-return.sh's sweep population is "declarations carrying the W2
# management fields (notify_back or custody)", so a dispatcher-fired session was born UNMANAGED —
# no custody, no wake, no auto-land, exactly the §2 rows 1-4 state the rails were built to end,
# reachable through the OTHER door. The fields are recorded here at declare time because a
# fire-time fact cannot be reconstructed later (cc-offload's own rule):
#   notify-back → the DESK role's pane uuid, resolved NOW (~/.claude/cc-roles/desk). A cron pass
#                 has no pane of its own; the desk pane is the durable address (a recycle
#                 relaunches the SAME pane). Missing/empty role file ⇒ field omitted — --custody
#                 alone still admits the declaration to the sweep, so wake degrades before
#                 management does.
#   custody     → marker = the session id (cc-offload's convention), opened below keyed on this
#                 pass's own cwd. Best-effort: custody bookkeeping must never break a declared
#                 fire — but a failure is stated in the verdict, so the ledger records an
#                 armed-ness gap rather than a silent green.
cloud_declare() {
  local id="$1" cap="$2" branch="$3" acct="${4:-}" sid="" ccbin nb=""
  if [ -n "$cap" ] && [ -f "$cap" ]; then
    sid="$(/usr/bin/grep -Eo 'session_[A-Za-z0-9._-]+' "$cap" 2>/dev/null | head -1 || true)"
  fi
  if [ -z "$sid" ]; then
    printf 'UNDECLARED — the cloud fire for %s emitted no session id; it is unobservable AND reapable' "$id"
    return 1
  fi
  # ── ADOPT, NEVER RE-DECLARE (2026-08-11, fire-#1 forensics) ───────────────────────────────────
  # A re-declare here OVERWRITES the fire path's declaration — fire #1's correct record (branch
  # claude/fire-…, the branch the VM actually pushes) was replaced by one naming the WORKTREE, so
  # the reconcile watched a branch that could never appear. cc-cloud declare also RE-PROBES the
  # remote baseline, so a late re-declare after the VM pushes would poison push-detection too.
  # When the captured fire output shows the fire path already declared, this function's only jobs
  # are to ADOPT the sid for the journal and to close any management gap it can without touching
  # the declaration.
  if /usr/bin/grep -q 'anthropic_cloud VM, repo ATTACHED' "$cap" 2>/dev/null; then
    # cc-offload up: declared with the real branch AND managed (custody at fire, fields on the
    # declaration, brief delivered). Nothing to add.
    printf 'adopted %s — declared+managed by cc-offload up (real branch preserved)' "$sid"
    return 0
  fi
  if /usr/bin/grep -Eq 'declared session_[A-Za-z0-9._-]+ .*now observable' "$cap" 2>/dev/null; then
    # The legacy CLI leg: declared with the real branch, but bare — no management fields, no
    # custody, and NO BRIEF DELIVERED (the leg's own output offers the send as a next step).
    # Custody is openable from here; the item/notify-back fields need a declaration-amend verb
    # cc-cloud does not have yet, and the brief needs the caller to send it — both are stated in
    # the verdict rather than silently absent.
    local cust cbin
    cbin="$(resolve_bin "${CC_DISPATCH_CUSTODY_BIN:-}" cc-custody "$HOME/.claude/bin/cc-custody")" || cbin=""
    if [ -n "$cbin" ] && "$cbin" open --cwd "$PWD" --target "cloud:$sid" --marker "$sid" \
         --slug "cloud-$sid" >/dev/null 2>&1; then
      cust="custody OPEN"
    else
      cust="custody NOT OPENED"
    fi
    printf 'adopted %s — leg declaration preserved (real branch); %s · UNMANAGED FIELDS: no item/notify-back on the declaration and NO BRIEF DELIVERED — send it with: cc-notify --cloud %s <the composed brief text>' "$sid" "$cust" "$sid"
    return 0
  fi
  if [ -z "$branch" ]; then
    printf 'UNDECLARED — %s fired as %s but the fire names no branch (no --worktree/--cwd); cc-cloud declare requires one' "$id" "$sid"
    return 1
  fi
  ccbin="$(resolve_bin "${CC_DISPATCH_CLOUD_BIN:-}" cc-cloud "$HOME/.claude/bin/cc-cloud")" || ccbin=""
  if [ -z "$ccbin" ]; then
    printf 'UNDECLARED — %s fired as %s but cc-cloud is unresolvable (set CC_DISPATCH_CLOUD_BIN)' "$id" "$sid"
    return 1
  fi
  nb="$(cat "$HOME/.claude/cc-roles/desk" 2>/dev/null || true)"
  local -a dargs=(declare --id "$sid" --branch "$branch" --item "$id" --custody "$sid")
  [ -n "$acct" ] && dargs+=(--account "$acct")
  [ -n "$nb" ] && dargs+=(--notify-back "$nb")
  if ! "$ccbin" "${dargs[@]}" >/dev/null 2>&1; then
    printf 'UNDECLARED — %s fired as %s but cc-cloud declare --id %s --branch %s FAILED' "$id" "$sid" "$sid" "$branch"
    return 1
  fi
  local cust cbin
  cbin="$(resolve_bin "${CC_DISPATCH_CUSTODY_BIN:-}" cc-custody "$HOME/.claude/bin/cc-custody")" || cbin=""
  if [ -n "$cbin" ] && "$cbin" open --cwd "$PWD" --target "cloud:$sid" --marker "$sid" \
       --slug "cloud-$sid" ${nb:+--notify-back "$nb"} >/dev/null 2>&1; then
    cust="custody OPEN (marker $sid)"
  else
    cust="custody NOT OPENED — the close-integrity arm is NOT armed for it"
  fi
  printf 'declared %s (branch %s, managed: %s%s)' "$sid" "$branch" "$cust" "${nb:+ · wakes $nb}"
  return 0
}

# claim_excerpt <file> → a claim refusal's HEADLINE (first line, sanitized, bounded).
# HEAD-biased on purpose, unlike fire_excerpt: a lease refusal states its verdict in line 1 and
# spends the rest naming the escape hatches, so a tail-200 excerpt (right for a spawn log, whose
# error is at the END) would journal the boilerplate and drop the one line that says WHY.
# claim_excerpt <stderr-file> → the refusal's verdict line, PLUS the signal that produced it.
#
# WHY THE SECOND HALF EXISTS. Line 1 of a refusal is `cc-backlog claim: REFUSED verdict=<token>`,
# which names WHAT happened and is silent on WHY. For `verdict=premise-refuted` that silence is the
# whole question: the same token is written when a stored probe was RE-RUN and exited 0 (a
# measurement, made against today's tree) and when another item simply DECLARED this one obsolete
# (prose, written at filing time). Measured 2026-08-11 on the live ledger — 51 `premise refuted`
# rows, and not one of them says which. So the durable record could not answer the only question
# that decides whether to trust it, and the mechanism that re-runs probes was unobservable from the
# outside no matter how often it fired.
#
# The cause markers are the contract's own headline strings (bin/cc-premise). Matched with -oE so a
# marker is copied VERBATIM or not at all — never paraphrased into a third spelling that a reader
# would have to map back. Absent marker ⇒ absent clause, never a guess: a row that cannot name its
# cause must say nothing rather than assert the commonest one.
claim_excerpt() {
  { [ -n "${1:-}" ] && [ -s "$1" ]; } || return 0
  local line1 cause
  line1="$(head -1 "$1" 2>/dev/null | tr -cd '\40-\176' | cut -c1-200)"
  cause="$(grep -m1 -oE 'FALSIFIER PASSED|DERIVED FALSIFIER|DECLARES ITSELF A DUPLICATE|SUPERSEDED BY' "$1" 2>/dev/null | cut -c1-40)"
  printf '%s%s' "$line1" "${cause:+ · cause: $cause}"
}

# self_release <id> <token> → releases the claim we took but never started work on, and ECHOES the
# journal marker that is actually TRUE of the release (", self-release" or nothing).
#
# WHY IT EXISTS. This dispatcher claims BEFORE it fires and rolls the claim back on every failure
# path, so a refused fire writes `claim → reopen` seconds apart — the identical ledger shape a worker
# bouncing off an item twice would write. cc-backlog's reap rule B blocked 228 items on that
# collision, each with the sentence "the worker cannot land" attached to an item no worker had ever
# been fired at (bin/cc-backlog § SELF-RELEASE). `--self-release` is how the ledger tells them apart.
#
# WHY IT ECHOES INSTEAD OF JUST RUNNING. The flag is newer than this caller, and cc-backlog resolves
# through a symlink into a checkout that lands on its own schedule — so an older binary rejecting the
# unknown arg (rc 2) is a real, expected state, not a hypothetical. Two properties follow, and the
# second is the one that needs the helper:
#   · The claim must be released either way. A failed rollback strands the item `claimed` until reap
#     ages it out, which is strictly worse than the bug being fixed — hence the bare-reopen fallback.
#   · The journal must not CLAIM a self-release that was not recorded. Printing ", self-release"
#     unconditionally would make the verdict describe the attempt rather than the outcome, which is
#     the same un-evidenced-verdict defect §1(c) forbids, one layer up (memory:
#     claimed-outcome-vs-checked-outcome). So the marker is the RETURN VALUE of what succeeded.
self_release() {
  local id="$1" token="$2"
  if "$backlog" reopen "$id" --by "$SID" --self-release "$token" >/dev/null 2>&1; then
    printf ', self-release'
  else
    "$backlog" reopen "$id" --by "$SID" >/dev/null 2>&1 || true
  fi
}

# ── S7: fair ordering ─────────────────────────────────────────────────────────────────────────────
# thrash_map → {"<id>": <count of this id's `failed` records>} over the IDL, {} when unreadable.
# An item that keeps failing to spawn must SINK: at the head of a FIFO slice it re-burns the same
# slot every pass and nothing behind it is ever seen. cc-backlog's `reap` thrash-block stays the
# terminal guard; this is only the ordering floor beneath it.
thrash_map() {
  [ -s "$IDL" ] || { echo '{}'; return 0; }
  jq -s -c '[ .[] | select(.actor=="cc-dispatch" and .action=="failed")
                  | (.id // ((.detail // "") | split(":") | .[0]))
                  | select(type == "string" and . != "") ]
            | group_by(.) | map({key: .[0], value: length}) | from_entries' "$IDL" 2>/dev/null \
    || echo '{}'
}

# ── M2 FIRE GATE: DERIVED RANK + CLUSTER (backlog 1b00d62958a6) ───────────────────────────────────
# The ordering below used to be thrash-then-oldest, and that was not a poor choice among options: the
# backlog schema carries NO priority and NO severity field, so FIFO-oldest-first was the only order
# the store could express. Measured 2026-08-09, the cost of that: the six master items that FIX the
# ordering sat at queue positions 294-299 of 305, because they were the newest things filed. The fix
# for the ordering was last in the ordering, and the wave had to be fired by hand.
#
# So rank is DERIVED — read from the store's own shape every pass, never typed by a human and never
# stored. Nothing here can go stale, because nothing here is remembered. Three signals, and they are
# applied LEXICOGRAPHICALLY rather than as a weighted sum: a weighted sum needs coefficients nobody
# can defend, and the first reader to disagree with them has no way to tell a tuned weight from an
# arbitrary one. A strict precedence is arguable on its merits, one clause at a time.
#
#   1. thrash ASC      (unchanged, still first) — an item that keeps failing to spawn must SINK.
#   2. land-rail DESC  — `postland-verify` / `deploy-live` items mean the LAND RAIL ITSELF is red.
#                        Everything else in the queue lands through that rail, so a blocker on it
#                        dominates: work admitted ahead of it may not be landable at all. Measured
#                        live 2026-08-10: 5 of 259 open items. Deliberately keyed on the two machine
#                        generators' `source` and not on title prose — a generator's own name is a
#                        fact about which rail filed the row, and prose is what this whole effort
#                        exists to stop trusting.
#   3. in-degree DESC  — how many OTHER items in the ledger cite this item's 12-hex id. A measured
#                        proxy for "closing this retires or unblocks others". Measured live: 101
#                        edges differentiating 68 of 259 open items (26%), max in-degree 5.
#                        ⚠️ COUNTED OVER THE WHOLE LEDGER, not over the open set, and the difference
#                        decides whether this signal exists at all: restricted to open-vs-open the
#                        same store yields 20 edges over 16 items — a 5x collapse, because most
#                        citations are written INTO a `done` or `blocked` record ("supersedes X",
#                        "DUPLICATE of blocked Y"). An in-degree computed only over dispatchable
#                        rows would have been a near-flat signal that looked like it was working.
#   4. recurrence DESC — how many live rows share this item's cluster (below). A condition observed
#                        N times is a standing defect, not an incident.
#   5. oldest ts       — the incumbent key, kept LAST so equal-rank items are still drained FIFO.
#
# jq's sort_by is STABLE and every new term is 0 for a stub item with no citations, no cluster and no
# generator source, so a fixture fleet sorts exactly as it did before this change — which is what
# leaves the v1 assertions behaviourally intact.

# cluster_expr — the jq expression for an item's CLUSTER KEY, used by both the rank map and the
# ordering so the two can never disagree about what a cluster is.
#
# `condition` when the filer set one (that flag already exists and already re-keys the id — see
# cc-backlog's CONDITION KEY note), otherwise the title with every MEASUREMENT normalised out.
#
# ⚠️ THIS STRIPS SHAS AND `_norm_title` IN cc-premise DELIBERATELY DOES NOT, and the asymmetry is the
# load-bearing part. There, normalising a sha out MERGES ledger rows and destroys 17 of 18 distinct
# post-land findings. Here nothing is merged and nothing is closed: a cluster sibling is DEFERRED for
# one pass, keeps its row, keeps its evidence, and is admitted the moment the representative
# finishes. The cost of a false merge is one item waiting a tick; the cost of no merge is N workers
# firing at one root cause. Different blast radius, so a different rule.
#
# The hex run must contain at least one DIGIT. A bare `[0-9a-f]{7,40}` also matches ordinary English
# built from those letters — "defaced", "cabbage" — and a title that lost a word would cluster with
# unrelated work (memory: denylist-enumerates-spellings-not-the-class: write the rule against the
# CLASS). A sha carries digits; a word does not. Verified against both spellings before landing.
#
# ⚠️ AN EMPTY KEY MEANS "DOES NOT CLUSTER", and that guard is load-bearing rather than defensive. The
# first cut keyed every item on its normalised title unconditionally, which made two items with NO
# title — every stub in the fixtures, and any row filed with an empty one — share the key `p norm:` and
# collapse into one cluster. Eight existing v2 assertions went red, and they were right to: the
# absence of a discriminator is not evidence of sameness (memory: lookup-miss-is-not-absence), and a
# dispatcher reading it that way declines a slot to unrelated work for as long as the representative
# runs. So a title-derived key is minted only when something SURVIVES normalisation — at least three
# alphabetic tokens. A title whose every distinguishing token was a measurement normalises to `#`s
# and punctuation, discriminates nothing, and correctly clusters with nothing.
cond_expr='(if ((.condition // "") != "") then ((.project // "") + " cond:" + .condition) else "" end)'
# shellcheck disable=SC2016  # a jq PROGRAM, not a shell string: `$n` is jq's own variable
# binding, and shell expansion here would be the defect rather than the fix.
norm_expr='(((.title // "") | ascii_downcase
             | gsub("\\b(?=[0-9a-f]{7,40}\\b)[0-9a-f]*[0-9][0-9a-f]*\\b"; "#")
             | gsub("[0-9]+(\\.[0-9]+)?"; "#")
             | gsub("\\s+"; " ") | .[0:160]) as $n
            | (if (([$n | scan("[a-z]{2,}")] | length) >= 3)
               then ((.project // "") + " norm:" + $n) else "" end))'
# The LOOSE key — condition first, else the normalised title. This is what RECURRENCE counts, because
# recurrence only nudges an ordering. ADMISSION uses the stricter form built in order_dispatchable
# (see DISTINCT RAW TITLES there): a gate may refuse a slot, so it must clear a higher bar than a
# ranking term that can only move an item a few places.
cluster_expr="(( ${cond_expr} ) as \$c | (if \$c != \"\" then \$c else ( ${norm_expr} ) end))"

# rank_map <backlog-bin> <dispatchable-json> → {"<id>": {"land":0|1,"in":N,"recur":N}}, or {} when it
# cannot be computed. ALWAYS fail-open to {}: every term then reads 0 and the order collapses to the
# incumbent thrash-then-oldest, which is a working dispatcher, not a stalled one.
#
# THE SECOND `list --all` IS DELIBERATE. `live_workers` already makes one, and threading its JSON out
# would be cheaper — but that function's contract is "a count, or '' for UNKNOWN", the third state the
# whole ceiling rests on, and it is pinned by tests. Growing it a second product to save 1.7s inside a
# decision phase budgeted at 5 minutes trades a load-bearing contract for nothing.
rank_map() {
  local b="$1" all out
  [ -n "$b" ] || { echo '{}'; return 0; }
  all="$("$b" list --all --json 2>/dev/null)" || { echo '{}'; return 0; }
  out="$(printf '%s' "$all" | jq -c --argjson d "$2" '
      if type != "array" then error("not an array") else . end
    | . as $all
    # in-degree over EVERY record in the fold, open or not — see the comment block above.
    | ( [ $all[] | . as $it
          | ([$it.title, $it.evidence, $it.needs, $it.dodRef, $it.condition, $it.source]
             | map(. // "") | join(" "))
          | [ match("\\b[0-9a-f]{12}\\b"; "g").string ] | unique
          | map(select(. != $it.id)) | map({to: .}) ] | add // [] ) as $edges
    | ( [ $edges[].to ] | group_by(.) | map({key: .[0], value: length}) | from_entries ) as $indeg
    # recurrence counts the LIVE rows only (open + blocked + claimed): a condition whose every row
    # is `done` is not recurring, it is finished.
    | ( [ $all[] | select(.status != "done") | '"$cluster_expr"' | select(. != "") ]
        | group_by(.) | map({key: .[0], value: length}) | from_entries ) as $recur
    | [ $d[] | { key: .id, value: {
          land:  (if ((.source // "") == "postland-verify" or (.source // "") == "deploy-live")
                  then 1 else 0 end),
          in:    ($indeg[.id] // 0),
          recur: (($recur['"$cluster_expr"'] // 1) - 1) } } ]
    | from_entries' 2>/dev/null)" || out=""
  printf '%s' "$out" | jq -e 'type=="object"' >/dev/null 2>&1 || out='{}'
  printf '%s\n' "$out"
}

# order_dispatchable <items-json> <thrash-json> <rank-json> → the same array under the S7 key, now
# with the derived rank above interposed between thrash and timestamp, and each item carrying its
# `_cluster` key for the admission loop. `lastTs` is what cc-backlog's fold carries (an untouched
# item's lastTs IS its add ts); `.ts` is honored first for hand-authored/stub shapes.
order_dispatchable() {
  local rk="${3:-}"; [ -n "$rk" ] || rk='{}'
  printf '%s' "$1" | jq -c --argjson th "$2" --argjson rk "$rk" '
      [ .[] | . + {_thrash: ($th[.id] // 0),
                   _land:   ($rk[.id].land  // 0),
                   _in:     ($rk[.id].in    // 0),
                   _recur:  ($rk[.id].recur // 0),
                   _kc: '"$cond_expr"', _kn: '"$norm_expr"', _rawt: (.title // "")} ] as $items
    # ── DISTINCT RAW TITLES — the bar an INFERRED cluster must clear before it may cost a slot ─────
    # A `--condition` key is a filer DECLARING two rows to be one piece of work, and it is honoured
    # unconditionally. A title-derived key is this file INFERRING it, and the inference is only ever
    # licensed by one thing: a MEASUREMENT in the title moved, so the id hash (project+title+source)
    # minted a second row for one condition. That licence is absent when the raw titles are
    # byte-identical — then a measurement is NOT what separated them, something else did, and this
    # normaliser has no evidence about what. Two such rows cannot even exist in the live store (same
    # project+title+source ⇒ same hash ⇒ one id), so refusing to infer here costs nothing real and
    # removes the one way an inferred cluster could starve unrelated work.
    #
    # Found by the cross-project fairness assertion in tests/cc-dispatch-projects.bats, whose fixture
    # seeds every item of a project with the identical title `work for <proj>` — a pair the id rule
    # forbids, which collapsed to one cluster and admitted one item where the test wanted two. The
    # test was right and the key was too eager (memory: stale-assertion-becomes-an-inverted-guard —
    # check which side has the incident before assuming the assertion is the stale one).
    | ( [ $items[] | select(._kn != "") | {k: ._kn, t: ._rawt} ] | group_by(.k)
        | map({key: .[0].k, value: ([.[].t] | unique | length)}) | from_entries ) as $distinct
    # `_clusterSrc` rides alongside the key because the READINESS gate needs the two apart and the
    # key alone cannot tell them: a DECLARED (`--condition`) cluster is a filer saying these rows
    # are one piece of work — resolved, by the only authority that can resolve it — while an
    # INFERRED one is a guess by this normaliser that nobody has adjudicated. Derived in ONE
    # expression with the key it labels, so the two can never disagree about which branch fired.
    # (No apostrophes in here: this whole block is inside a single-quoted shell string.)
    | [ $items[] | (if   ._kc != ""                                   then {c: ._kc, s: "declared"}
                    elif ._kn != "" and (($distinct[._kn] // 0) >= 2) then {c: ._kn, s: "inferred"}
                    else {c: "", s: ""} end) as $cl
                 | . + {_cluster: $cl.c, _clusterSrc: $cl.s} ]
    | sort_by([._thrash, -._land, -._in, -._recur, (.ts // .lastTs // "")])
    | map(del(._thrash, ._land, ._in, ._recur, ._kc, ._kn, ._rawt))'
}

# ── READINESS — A PRECONDITION OF ADMISSION (W1; BACKLOG_CONSOLIDATION_2026-08-09 § READINESS) ────
# THE GENERATOR THIS CLOSES. Readiness has four properties and only ONE of them was checked at
# consumption: premise currency, re-run by the claim gate every time (cc-premise, M2). The other
# three — is this row's venue label current, is this one effort or five rows, is the probe
# trustworthy — were checked by a BATCH, and a batch over a growing stream must be re-run forever.
# That treadmill is the one-time triage that keeps being re-minted. The cure is not more effort, it
# is the shape: check it where the act happens (memory: enforcement-must-live-at-the-chokepoint).
#
# O(2) PER PASS, NEVER A SWEEP, and that is the whole reason it can be always-on. The admission set
# is bounded by free_slots, so readiness is evaluated only for the items ABOUT TO BE ADMITTED —
# never for the 300-row store. `CC_DISPATCH_READY_MAX` bounds it absolutely, including the enforce
# lane where a void item defers and the next candidate is tried in its place; past the bound an item
# is UNKNOWN, which never blocks. A readiness check costs one `cc-venue paths` (a python fold) plus
# two bounded git reads, against a decision phase budgeted at 5 minutes.
#
# ADVISORY FIRST, AND NOT AS TIMIDITY. Measured 2026-08-11, 219 of the open rows carried no venue
# label at all; a gate shipped ENFORCING on day one would have admitted nothing and the dispatcher
# would have read as dead. So the default lane JOURNALS the verdict and admits anyway, and the
# would-block rate rides the summary record — the flip to `enforce` is then a measurement someone
# reads, not a guess someone makes (the same ratchet discipline M2 used).
READY_GATE="${CC_DISPATCH_READY_GATE:-advisory}"
case "$READY_GATE" in advisory|enforce|off) ;; *)
  die3 "CC_DISPATCH_READY_GATE must be advisory, enforce or off (got '$READY_GATE')" ;; esac
READY_MAX="${CC_DISPATCH_READY_MAX:-6}"
is_uint "$READY_MAX" || die3 "CC_DISPATCH_READY_MAX must be a non-negative integer (got '$READY_MAX')"
READY_CHECKED=0; READY_VOID=0; READY_UNKNOWN=0   # → the summary record's would-block rate

# ready_trunk_sha <repo> → origin/main's sha, or "" when git could not be asked.
# NEVER a fabricated or defaulted value: every arm below treats this as a real point in history, and
# a made-up one would make "trunk moved under this item" answerable against nothing.
ready_trunk_sha() {
  local r="$1"
  [ -n "$r" ] && [ -d "$r" ] || { printf ''; return 0; }
  git -C "$r" rev-parse --verify origin/main 2>/dev/null || printf ''
}

# ready_last_sha <id> → the trunk sha this item's readiness basis was last established at, or "".
#
# THE DERIVED CACHE LIVES IN THE DECIDER, NOT ON THE LEDGER (R2). `readyAt` says what THIS
# dispatcher checked and against which trunk; the backlog ledger is the store of EVIDENCE, written
# by filers and workers. A derived field written there would be indistinguishable from a claim, and
# every other consumer would inherit a value it has no way to verify.
#
# BOUNDED TAIL READ. The IDL is append-only and unbounded. A verdict that has scrolled past the
# window reads as ABSENT, which VOIDS the item — the safe direction by construction, because a void
# is re-derived in place (one cc-venue call) and is eligible again next pass. It is never a drop.
# `fromjson?` per line, so one malformed record cannot take the whole read down with it.
ready_last_sha() {
  local id="$1" n="${CC_DISPATCH_READY_SCAN:-4000}"
  [ -f "$IDL" ] || { printf ''; return 0; }
  tail -n "$n" "$IDL" 2>/dev/null | jq -Rr --arg i "$id" '
      fromjson? | select(type=="object")
    | select(.action=="readiness" and .id==$i and ((.readyAt // "") != ""))
    | .readyAt' 2>/dev/null | tail -1
}

# ready_paths <repo> <id> → the item's usable cited path set on stdout. rc 0 = ANSWERED (zero lines
# is a real answer), rc 2 = COULD NOT ASK. The two are three states in one call and the caller keeps
# them apart — see the EMPTY SET rule at readiness_verdict.
#
# The extractor is cc-premise's, reached through cc-venue's `paths` verb, because bash cannot import
# a python predicate and a bash re-derivation of "what does this item cite" would be a SECOND
# implementation of the exact rule that decides whether a verdict survives.
ready_paths() {
  local r="$1" id="$2" vbin out rc
  vbin="${CC_DISPATCH_VENUE_BIN:-$(cd "$(dirname "$_self")" 2>/dev/null && pwd)/cc-venue}"
  [ -x "$vbin" ] || vbin="$(resolve_bin "" cc-venue "$HOME/.claude/bin/cc-venue")" || vbin=""
  [ -n "$vbin" ] && [ -x "$vbin" ] || return 2
  out="$(CC_PREMISE_REPO="$r" "$vbin" paths "$id" 2>/dev/null)"; rc=$?
  [ "$rc" -eq 0 ] || return 2
  printf '%s' "$out"
  return 0
}

# ready_moved <repo> <sha> <paths> → 0 trunk MOVED under a cited path · 1 it did not · 2 unaskable.
# Three states, never two: "the diff was empty" and "there was no diff to read" are opposite facts
# about an item's freshness (memory: lookup-miss-is-not-absence).
ready_moved() {
  local r="$1" sha="$2" paths="$3" out p; local -a ps=()
  [ -n "$r" ] && [ -n "$sha" ] || return 2
  git -C "$r" cat-file -e "${sha}^{commit}" 2>/dev/null || return 2
  while IFS= read -r p; do [ -n "$p" ] && ps+=("$p"); done <<< "$paths"
  [ "${#ps[@]}" -gt 0 ] || return 2
  out="$(git -C "$r" diff --name-only "$sha..origin/main" -- "${ps[@]}" 2>/dev/null)" || return 2
  [ -n "$out" ] && return 0
  return 1
}

# ready_relabel <id> — THE REPAIR, and cc-venue's second missing caller (W1 item 5b). A void venue
# verdict is RE-DERIVED IN PLACE: the producer re-runs its four questions against today's tree and
# rewrites `venuePlan`/`venueWhy` through `cc-backlog venue`, which is the one writer.
#
# NEVER A DROP AND NEVER A `done` (R3). The item keeps its row, its evidence and its queue position;
# all that changes is that its routing decision is current again, so it is eligible on the NEXT
# pass. A gate that silently shreds work is worse than the staleness it was built to prevent.
#
# Deliberately NOT re-checked in the same pass. Repairing and then admitting on the repaired verdict
# would make the would-block rate read 0 forever — the measurement the advisory lane exists to take
# would be destroyed by the repair it is measuring.
ready_relabel() {
  local id="$1" r="$2" vbin
  vbin="${CC_DISPATCH_VENUE_BIN:-$(cd "$(dirname "$_self")" 2>/dev/null && pwd)/cc-venue}"
  [ -x "$vbin" ] || vbin="$(resolve_bin "" cc-venue "$HOME/.claude/bin/cc-venue")" || vbin=""
  [ -n "$vbin" ] && [ -x "$vbin" ] || return 1
  CC_PREMISE_REPO="$r" "$vbin" label "$id" >/dev/null 2>&1
}

# readiness_verdict <id> <project> <venuePlan> <cluster-src> <may-repair 0|1>
#                                                   → "<state>\037<reason>\037<readyAt>"
#   state ∈ ready | void | unknown        readyAt = the sha the basis is established at ("" = none)
#
# ready = venue-current ∧ cluster-resolved ∧ sha-current. The FOURTH conjunct, premise currency, is
# deliberately NOT re-implemented here: `cc-backlog claim` runs cc-premise itself and REFUSES with
# verdict=premise-refuted, and this file already journals that refusal as a skip. Re-deriving an
# atomic gate's predicate in its caller is how a report and a refusal drift apart (memory:
# make-the-actuator-the-arbiter) — the conjunction holds because the actuator enforces its arm, not
# because this function re-asks the same question a second time.
#
# 🚨 AN EMPTY PATH SET IS ALWAYS VOID, NEVER ALWAYS-FRESH. This is the fail-open trap, and it is the
# one the naive reading walks straight into: with no cited paths the intersection with any diff is
# empty, so "trunk did not move under it" is TRUE and the item reads permanently ready. But that
# sentence is vacuous — an item citing nothing has proven nothing survived, and a verdict that can
# never be falsified is not a verdict. Void, and its repair is a citation, not a re-run.
#
# UNKNOWN IS A THIRD STATE AND NEVER BLOCKS. A missing cc-venue, an unreadable repo, a spent budget:
# none of those is an answer about the item, and a fail-closed reading of a dead sensor is how a
# gate stalls a queue it was supposed to protect (memory:
# sensor-default-off-makes-blindness-the-shipping-path).
readiness_verdict() {
  local id="$1" proj="$2" vplan="$3" csrc="$4" may_repair="${5:-1}"
  local repo cur prior paths rc basis state reason repaired=0
  repo="$(project_repo "$proj")"
  cur="$(ready_trunk_sha "$repo")"
  prior="$(ready_last_sha "$id")"
  state=ready; reason=""

  if [ -z "$vplan" ]; then
    state=void; reason="venue-unlabelled"
  elif [ "$csrc" = inferred ]; then
    # An INFERRED multi-row cluster: this dispatcher believes N rows are one effort and nobody has
    # declared it. `--condition` rows are the resolved case — a filer DECLARED them one piece of
    # work — and are not void. The repair is the consolidation actuator (R6), not this file.
    state=void; reason="cluster-unresolved"
  else
    paths="$(ready_paths "$repo" "$id")"; rc=$?
    if [ "$rc" -ne 0 ]; then
      state=unknown; reason="paths-unreadable"
    elif [ -z "$paths" ]; then
      state=void; reason="cites-nothing"
    elif [ -z "$cur" ]; then
      state=unknown; reason="trunk-unreadable"
    elif [ -z "$prior" ]; then
      # Nothing has ever certified this item against a trunk sha. VOID — and self-repairing: this
      # pass records today's sha as the basis, so the very next pass can actually ask the question.
      state=void; reason="no-prior-verdict"
    else
      ready_moved "$repo" "$prior" "$paths"; rc=$?
      case "$rc" in
        0) state=void;    reason="trunk-moved" ;;
        1) state=ready;   reason="" ;;
        *) state=unknown; reason="diff-unreadable" ;;
      esac
    fi
  fi

  # THE REPAIR RUNS ON THE TWO REASONS A RE-DERIVATION CAN ACTUALLY CURE. `cites-nothing` and
  # `cluster-unresolved` are not among them: re-running the producer cannot make an item cite a
  # file, and it cannot decide that five rows are one effort. Reporting a repair that could not have
  # worked is the claimed-vs-checked defect, so those two are journalled void and left alone.
  #
  # `may_repair` is 0 on a DRY pass, and that is load-bearing rather than tidy: `cc-venue label`
  # appends to the OPERATOR's live ledger, so a `--dry-run` that repaired would be a writing dry run
  # — the one thing every other branch in this file is careful not to be. A dry pass then reports
  # the void it FOUND, which is exactly what a reader of a dry run wants to see anyway.
  if [ "$may_repair" -eq 1 ]; then
    case "$reason" in
      venue-unlabelled|trunk-moved) ready_relabel "$id" "$repo" && repaired=1 ;;
    esac
  fi

  # readyAt is the sha the BASIS was established at, not the sha of the pass that read it. It is
  # pinned once set and reset only by a repair, which is what makes "void iff trunk moved under this
  # item SINCE its basis" literally true rather than a rolling window that can never catch a creep.
  basis="$prior"
  if [ -z "$basis" ] || [ "$repaired" -eq 1 ]; then basis="$cur"; fi
  # \037 again, for the reason the admission loop gives: `reason` is empty on a READY verdict, and a
  # tab-split would silently deliver the sha into it.
  printf '%s\037%s\037%s' "$state" "$reason" "$basis"
}

# idl_readiness <id> <state> <reason> <readyAt> <project> — the readiness record. Its own action, so
# a consumer counting decisions is untouched by it and `ready_last_sha` has an unambiguous key.
idl_readiness() {
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -cn --arg ts "$(now_iso)" --arg pass "$PASS_ID" --arg id "$1" --arg state "$2" \
     --arg reason "$3" --arg sha "$4" --arg project "${5:-$PROJECT}" --arg gate "$READY_GATE" \
     '{ts:$ts, actor:"cc-dispatch", action:"readiness", pass:$pass, project:$project, id:$id,
       ready:($state=="ready"), state:$state, reason:$reason, gate:$gate,
       readyAt:(if $sha == "" then null else $sha end)}' >> "$IDL" 2>/dev/null || true
}

# ── S6: singleton, skip-not-queue ─────────────────────────────────────────────────────────────────
# `mkdir` is the atomic primitive (no flock on this box). The holder is pinned by pid|lstart and
# NEVER by `kill -0` alone: pids recycle, and one recycled pid makes a dead holder read LIVE
# forever — a permanently wedged dispatcher, which is strictly worse than an overlap.
lock_write_owner() {
  printf '%s|%s\n' "$$" "$(ps -o lstart= -p $$ 2>/dev/null)" > "$LOCK_DIR/owner" 2>/dev/null || true
}
lock_holder_live() {
  local rec pid ls cur tries=0
  while [ "$tries" -lt 2 ]; do
    rec="$(cat "$LOCK_DIR/owner" 2>/dev/null || echo "")"
    [ -n "$rec" ] && break
    # The dir exists but the owner line is not there YET: the holder is between its mkdir and its
    # write. Re-read once after a beat instead of declaring it stale — breaking a lock that is being
    # TAKEN is exactly the double-claim this guard exists to prevent.
    tries=$((tries + 1)); [ "$tries" -lt 2 ] && sleep 1
  done
  [ -n "$rec" ] || return 1
  pid="${rec%%|*}"; ls="${rec#*|}"
  is_uint "$pid" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cur="$(ps -o lstart= -p "$pid" 2>/dev/null || echo "")"
  [ -n "$cur" ] || return 1
  [ "$cur" = "$ls" ]
}
lock_release() {
  [ "$LOCK_HELD" = 1 ] || return 0
  LOCK_HELD=0
  rm -f "$LOCK_DIR/owner" 2>/dev/null || true
  rmdir "$LOCK_DIR" 2>/dev/null || true
}
lock_take() {
  LOCK_HELD=1; lock_write_owner
  # release on EVERY exit path, signals included: the signal traps exit, which fires the EXIT trap.
  trap 'lock_release' EXIT
  trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
}
# lock_acquire → 0 acquired · 1 a LIVE pass is in flight (caller SKIPS, never queues)
lock_acquire() {
  mkdir -p "$(dirname "$LOCK_DIR")" 2>/dev/null || true
  if mkdir "$LOCK_DIR" 2>/dev/null; then lock_take; return 0; fi
  lock_holder_live && return 1
  rm -f "$LOCK_DIR/owner" 2>/dev/null || true      # stale (dead pid, or lstart mismatch ⇒ recycled)
  rmdir "$LOCK_DIR" 2>/dev/null || true
  if mkdir "$LOCK_DIR" 2>/dev/null; then lock_take; return 0; fi
  return 1                                          # lost the re-take race ⇒ treat as in-flight
}
# warm_worktree <abs-path> → 0 provisioned (branch + deps + secrets), 1 loud fail. Idempotent.
# "Warm" is the whole point: the fired pane must only `cd` and launch. Any install left for the pane
# to run at boot is exactly the cold path whose keystroke race this fix exists to avoid.
# warm_worktree <worktree-path> [project]
#
# THE REPO IS PER-ITEM, NOT PER-PROCESS (multi-project coverage, item f7abcbdee98c). This used to
# read a single `CC_DISPATCH_REPO:-$HOME/Development/claude-infrastructure`, which is the one thing
# that makes naive multi-project dispatch actively WRONG rather than merely incomplete: a
# doc_classifier item would have its worktree cut from THIS repo and a worker fired into it holding
# this repo's standing-land authorization, working a brief about another project's code. The repo is
# resolved from the item's own project (conf `repo=` → CC_DISPATCH_REPO for the pinned project only
# → the ~/Development/<project> convention) and an unresolvable one REFUSES — the caller reopens the
# item with a recorded failure, which is a visible thrash rather than a silent mis-fire.
# ── M2: A PROVABLY FRESH TREE (backlog 1b00d62958a6) ──────────────────────────────────────────────
# wt_base_state <repo> <ref> <base> → `fresh` | `stale` | `unknown`. Always exit 0; the WORD is the
# verdict, so a caller can never mistake a failed probe for an answer.
#
# THREE STATES, NOT TWO, and that is the whole reason this is a function rather than an inline
# `merge-base --is-ancestor`. `--is-ancestor` exits 0 for yes, 1 for no, and something else for "I
# could not evaluate that" — a missing ref, a corrupt object, no repo. Collapsing the third into `no`
# is exactly the failure cc-premise measured on its own path arm: a sensor that cannot READ reported
# ABSENT and fabricated 80 findings (memory: lookup-miss-is-not-absence). So both refs are resolved
# first as a positive control, and only rc 1 from a probe that ran convicts.
wt_base_state() {
  local repo="$1" ref="$2" base="$3" rc
  git -C "$repo" rev-parse --verify --quiet "$base" >/dev/null 2>&1 || { echo unknown; return 0; }
  git -C "$repo" rev-parse --verify --quiet "$ref"  >/dev/null 2>&1 || { echo unknown; return 0; }
  git -C "$repo" merge-base --is-ancestor "$base" "$ref" >/dev/null 2>&1; rc=$?
  case "$rc" in
    0) echo fresh ;;
    1) echo stale ;;
    *) echo unknown ;;
  esac
  return 0
}

warm_worktree() {
  local wt="$1" wproj="${2:-$PROJECT}" br repo base
  repo="$(project_repo "$wproj")"
  case "$wt" in /*) ;; *) echo "cc-dispatch: refusing a non-absolute worktree path: $wt" >&2; return 1 ;; esac
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || { echo "cc-dispatch: not a git repo: $repo (project '$wproj' — declare its repo= in $PROJECTS_CONF)" >&2; return 1; }
  # BASE per repo, not a global constant: `origin/main` is right for every project in the ledger
  # today, but it is the REPO's fact, so read the repo's own origin/HEAD and keep origin/main only as
  # the fallback for a repo whose remote HEAD is unset. An explicit CC_DISPATCH_WT_BASE still wins.
  base="${CC_DISPATCH_WT_BASE:-}"
  if [ -z "$base" ]; then
    base="$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    [ -n "$base" ] || base="origin/main"
  fi
  br="$(basename "$wt")"
  git -C "$repo" fetch origin -q 2>/dev/null || echo "cc-dispatch: fetch failed — basing off last-fetched $base" >&2
  # Reuse the branch if it already exists (a re-dispatch after a failed spawn must not hard-fail).
  #
  # ⚠️ THE REUSE PATH IGNORED THE BASE ENTIRELY, which made the fetch one line up buy nothing. It
  # checks out the OLD branch tip, so a `wt-<id>` branch left behind by a failed spawn days ago hands
  # the next worker a tree cut from a trunk that has since moved — and nothing says so. The worker
  # writes a correct change against a stale base and discovers it at LAND time, as a conflict, in
  # someone else's session. That is the "provably fresh tree" clause of this item.
  #
  # Two sub-cases, and they must not be treated alike:
  #   · the branch carries NO commits of its own ⇒ it is a leftover, not work. Fast-forward it onto
  #     the freshly-fetched base and proceed. Nothing can be lost: there is nothing on it.
  #   · the branch carries commits ⇒ that is somebody's work, possibly unlanded. REFUSE, and let the
  #     caller reopen the item with a recorded failure. This file's own doctrine, three comments up:
  #     a visible thrash rather than a silent mis-fire. Deleting or rebasing it here would be a
  #     destructive act taken by an unattended dispatcher over work it did not create.
  # `unknown` proceeds, like every other sensor failure in this file (I6): starving the queue on an
  # unreadable probe is the worse error. Kill switch CC_DISPATCH_WT_FRESH=off restores the incumbent.
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$br"; then
    local bstate uniq
    bstate=fresh
    [ "${CC_DISPATCH_WT_FRESH:-on}" != off ] \
      && bstate="$(wt_base_state "$repo" "refs/heads/$br" "$base")"
    if [ "$bstate" = stale ]; then
      uniq="$(git -C "$repo" rev-list --count "$base..refs/heads/$br" 2>/dev/null || echo unknown)"
      if [ "$uniq" = 0 ]; then
        if ! git -C "$repo" branch -f "$br" "$base" >/dev/null 2>&1; then
          # `branch -f` refuses a branch checked out in ANOTHER worktree — a stale registration for
          # this same id. Refusing here is right: we cannot make it fresh and must not fire into it.
          echo "cc-dispatch: refusing $wt — branch $br is behind $base and could not be fast-forwarded (checked out elsewhere?); \`git -C $repo worktree prune\` then retry" >&2
          return 1
        fi
        echo "cc-dispatch: $br was behind $base with no commits of its own — fast-forwarded to $base" >&2
      else
        echo "cc-dispatch: refusing $wt — branch $br is NOT based on $base and carries $uniq commit(s) of its own; land or delete it before re-dispatch (\`git -C $repo log $base..$br\`)" >&2
        return 1
      fi
    fi
    git -C "$repo" worktree add "$wt" "$br" >/dev/null 2>&1 || return 1
  else
    git -C "$repo" worktree add "$wt" -b "$br" "$base" >/dev/null 2>&1 || return 1
  fi
  [ -f "$repo/.env.local" ] && { cp "$repo/.env.local" "$wt/.env.local" 2>/dev/null; chmod 600 "$wt/.env.local" 2>/dev/null; }
  # Deps by DETECTED package manager, never pnpm-hardcoded (a hardcoded install broke every
  # non-Node project). Install failure does NOT fail provisioning — a launched session can self-heal
  # its deps; an unlaunched one can do nothing.
  ( cd "$wt" 2>/dev/null || exit 0
    if   [ -f pnpm-lock.yaml ];   then CI=true pnpm install --frozen-lockfile
    elif [ -f bun.lockb ] || [ -f bun.lock ]; then bun install
    elif [ -f package-lock.json ]; then npm ci
    elif [ -f yarn.lock ];        then yarn install --frozen-lockfile
    elif [ -f uv.lock ];          then uv sync --frozen || uv sync
    elif [ -f go.sum ];           then go mod download
    elif [ -f Cargo.lock ];       then cargo fetch
    fi ) >/dev/null 2>&1 || true
  return 0
}

# ready_rate → the WOULD-BLOCK rate as "<void>/<checked>", plus its percent, or "0/0" and null when
# nothing was checked. THE DENOMINATOR SHIPS WITH THE RATE, always: a bare percentage over an
# unstated population is how a figure survives long after the population it was true of stopped
# existing (memory: positive-control-the-denominator, published-figure-decays-with-its-source).
# `unknown` is counted SEPARATELY and is NOT in the numerator — an item the sensor could not read
# would not have been blocked, and folding it in would inflate the very number the flip to
# `enforce` is supposed to be decided on.
# ── cc-venue's FIRST MISSING CALLER: LABEL THE ROW THAT WAS JUST WRITTEN (W1 item 5a) ─────────────
# `cc-venue run` shipped with ZERO automatic callers — the only reader of `venuePlan` in the fleet
# was this file, and nothing ever wrote one, so the whole cloud lane was reachable only by hand and
# the label went stale the instant the batch that produced it finished.
#
# THE WRITE PATH IS ALREADY WIRED, so this needs no new timer: `cc-backlog add` kicks a debounced
# `cc-dispatch --decide` (bin/cc-backlog § S5 KICK-ON-WRITE), which is precisely the moment new work
# enters the ledger. This labels THAT row.
#
# 🚨 IT IS SCOPED BY POPULATION, NOT BY A COUNT, and the distinction is the whole anti-goal. "Label
# the newest unlabelled row, one per pass" looks bounded and is not: at a 300 s cadence it walks the
# entire store in a day — a full-store sweep wearing a clock, which is the batch this wave exists to
# delete. The window admits only rows WRITTEN IN THE LAST few minutes, so the ~219 legacy unlabelled
# rows can never enter it however long the dispatcher runs. Those are labelled at ADMISSION instead
# (the readiness gate's repair), which is where a label is actually consumed.
#
# Failure is a no-op by construction: an unlabelled row is exactly the incumbent state, its
# readiness verdict then reads `venue-unlabelled`, and the admission-time repair covers it.
venue_label_new() { # <open-items-json>
  local win="${CC_DISPATCH_VENUE_NEW_WINDOW_S:-900}" max="${CC_DISPATCH_VENUE_NEW_MAX:-2}" nid nproj n=0
  [ "${CC_DISPATCH_VENUE_LABEL:-on}" = off ] && return 0
  while IFS="$(printf '\t')" read -r nid nproj; do
    [ -n "$nid" ] || continue
    [ "$n" -lt "$max" ] || break
    n=$((n + 1))
    if ready_relabel "$nid" "$(project_repo "$nproj")"; then
      idl note "$nid: venue labelled on write — cc-venue ran at the add-kick, not in a sweep"
    else
      idl note "$nid: venue label FAILED on write — the admission-time repair covers it"
    fi
  done < <(printf '%s' "$1" | jq -r --argjson w "$win" '
      [ .[] | select((.status // "") == "open" and ((.venuePlan // "") == ""))
            | select((((.lastTs // .ts // "") | try fromdateiso8601 catch 0)) > (now - $w)) ]
    | .[] | "\(.id // "")\t\(.project // "")"' 2>/dev/null)
}

ready_rate_pct() {
  [ "$READY_CHECKED" -gt 0 ] || { printf 'null'; return 0; }
  printf '%s' "$(( READY_VOID * 100 / READY_CHECKED ))"
}

idl_summary() {
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -cn --arg ts "$(now_iso)" --argjson f "$FIRED" --argjson b "$ABSTAINED" --argjson x "$FAILED" \
     --argjson s "$SKIPPED" --argjson a "$ADMITTED" --argjson d "$DEFERRED" --arg pass "$PASS_ID" \
     --argjson rc "$READY_CHECKED" --argjson rv "$READY_VOID" --argjson ru "$READY_UNKNOWN" \
     --argjson rp "$(ready_rate_pct)" --arg rg "$READY_GATE" \
     '{ts:$ts, actor:"cc-dispatch", action:"summary", fired:$f, abstained:$b, failed:$x, skipped:$s,
       admitted:$a, deferred:$d, pass:$pass, ready_gate:$rg, ready_checked:$rc, ready_void:$rv,
       ready_unknown:$ru, ready_would_block_pct:$rp}' \
     >> "$IDL" 2>/dev/null || true
}

# PAGE channel (autonomy-sweep drains *.page; nightly-regression format: line1 epoch, line2 human).
# A standing-alarm key: the cliff persists until quota resets; a recovered run clears it.
PAGE_FILE="$PAGES_DIR/cc-dispatch-quota-cliff.page"
write_page() { # <detail>
  mkdir -p "$PAGES_DIR" 2>/dev/null || return 0
  { date +%s; printf 'cc-dispatch quota-cliff @ %s: %s\n' "$(now_iso)" "$1"; } \
    > "$PAGE_FILE" 2>/dev/null || true
}
clear_page() { rm -f "$PAGE_FILE" 2>/dev/null || true; }

# ── one cron pass ────────────────────────────────────────────────────────────────────────────────
dispatch() { # <dry|run|decide>
  local mode="$1" backlog waveplan spawn items dispatchable count wave plan rc n
  local v2=1; [ "$LANE" = v1 ] && v2=0
  local inflight=0        # 1 = another pass holds the singleton ⇒ DECIDE but never admit
  # the v1 lane has no decision journal, so a decide-only pass there has no product at all; degrade
  # it to the incumbent dry pass (still zero claims/spawns/pages) rather than invent a lane-v1 mode.
  [ "$v2" -eq 0 ] && [ "$mode" = decide ] && mode=dry

  # 0. S6 SINGLETON — writing modes only. A dry pass writes nothing, so it must neither block a live
  # pass nor be blocked by one. skip-not-queue: a LIVE holder means an ADMISSION is already in
  # flight, so this pass may never claim or spawn (never queues ⇒ never double-claims).
  #
  # It does NOT return here. Losing the lock costs this pass its admission budget, not its voice:
  # the decision journal is a pure read (S1) and is what the 5-minute bound is measured on, so it
  # runs either way and `inflight` carries the verdict downstream. Returning at this line is the
  # A2 defect itself — see THE LOCK COVERS ADMISSION, NOT DECISION in the header.
  if [ "$v2" -eq 1 ] && [ "$mode" != dry ] && ! lock_acquire; then
    inflight=1
    idl_inflight
    echo "cc-dispatch: an admission is already in flight — DECIDING ONLY (zero claims, zero spawns)." >&2
  fi

  backlog="$(resolve_bin "${CC_DISPATCH_BACKLOG_BIN:-}" cc-backlog)" \
    || die3 "backlog bin unresolvable (set CC_DISPATCH_BACKLOG_BIN)"

  # 1. pull + filter dispatchable (status=="open" skips already-claimed).
  items="$("$backlog" list --open --json 2>/dev/null)"; rc=$?
  [ "$rc" -eq 0 ] || die3 "'$backlog list --open --json' failed (rc=$rc)"
  printf '%s' "$items" | jq -e 'type=="array"' >/dev/null 2>&1 \
    || die3 "backlog list did not return a JSON array"
  local open_items guarded gcount g uncovered ucount
  open_items="$(printf '%s' "$items" \
    | jq -c --argjson ps "$PROJECTS_JSON" '[ .[] | select(.status=="open" and (.project as $x | $ps | index($x))) ]')"

  # 1a. UNCOVERED — open items whose project is NOT in the dispatch set. Before this, they were the
  # defect itself: no decision, no deferral, no record, no stderr line — invisible, and therefore
  # indistinguishable from an empty backlog (item f7abcbdee98c). They are recorded every pass as a
  # decision with verdict "skip" so a project that appears in the shared ledger without a conf row
  # is LOUD instead of structurally undrained. Deliberately a record and NOT a blocking lint: the
  # ledger is shared, so a foreign project would otherwise turn every author's gate red for work no
  # author caused (memory: whole-tree-lint-is-a-fleet-wide-hard-stop).
  uncovered="$(printf '%s' "$items" \
    | jq -c --argjson ps "$PROJECTS_JSON" '[ .[] | select(.status=="open" and (.project as $x | $ps | index($x) | not)) ]')"
  ucount="$(printf '%s' "$uncovered" | jq 'length' 2>/dev/null || echo 0)"
  if [ "$ucount" -gt 0 ]; then
    echo "cc-dispatch: $ucount open item(s) in project(s) OUTSIDE the dispatch set — declare them in $PROJECTS_CONF to drain:" >&2
    printf '%s' "$uncovered" | jq -r 'group_by(.project // "") | map("  \(.[0].project // "(null)"): \(length) item(s)")[]' >&2
    if [ "$mode" = dry ]; then
      printf 'PLAN: %s uncovered item(s) → would record verdict=skip reason=project-not-dispatched\n' "$ucount"
    elif [ "$v2" -eq 1 ]; then
      while IFS="$(printf '\t')" read -r g gp; do
        [ -n "$g" ] || continue
        SKIPPED=$((SKIPPED + 1)); idl_decision "$g" skip 0 project-not-dispatched "$gp"
      done < <(printf '%s' "$uncovered" | jq -r '.[] | "\(.id // "")\t\(.project // "")"')
    fi
  fi

  # 1b. DONE-GUARD — an item that has ALREADY been completed once is not auto-dispatchable, even
  # when something has put it back to "open". `wasDone` is cc-backlog's done LATCH: it sticks from
  # the first `done` and clears only on a deliberate `cc-backlog reopen <id> --force`. Without this
  # the wave re-fires landed work and burns a whole worker session on it (incident 2026-07-20:
  # a60d62a215f1 → 6488617, two peers on one already-landed item).
  #
  # Fail-CLOSED by construction. The latch lives in the ledger fold, so the check needs no repo or
  # sha lookup — a git content-verify HERE would have to fail OPEN (dispatch anyway) every time the
  # repo could not be resolved, which under a bare launchd PATH/cwd is the common case, not the
  # rare one; fail-silent-open is precisely what this spine forbids. The prior `evidence` rides the
  # skip record instead, so a human content-verifies from the surfaced sha.
  #
  # THIS FILTER IS PULL-TIME, AND PULL-TIME IS NOT ENOUGH ON ITS OWN. It reads a snapshot here and
  # the claim is taken at step 5a, 7-45 s of wave-plan plus an admission tail later; a `done` that
  # lands inside that gap is invisible to this jq and the claim fires against stale truth (measured
  # 2026-08-05 on item 5690b9d11bee — claimed 5 m 23 s after its own `done`). The window is closed
  # at the ACTUATOR: `cc-backlog claim` refuses a `wasDone` item outright (rc 4), which step 5a
  # branches on. This filter stays because it is the CHEAP fence — it keeps a done-latched item out
  # of the wave-plan call and out of a quota placement entirely, which the actuator guard, firing
  # after both, cannot do.
  guarded="$(     printf '%s' "$open_items" | jq -c '[ .[] | select(.wasDone == true) ]')"
  dispatchable="$(printf '%s' "$open_items" | jq -c '[ .[] | select(.wasDone != true) ]')"

  # 1a1. THE VENUE ADMISSION FILTER (CC_DISPATCH_VENUE_ONLY) — the migration lever.
  #
  # WHY IT HAD TO EXIST AT ALL. `CC_DISPATCH_VENUE_LABEL` decides what an item is LABELLED; nothing
  # decided what a pass is ALLOWED TO FIRE. So the only way to stop local spawning was
  # DECIDE_ONLY, which stops every spawn including the cloud ones — "migrate from local to cloud"
  # was inexpressible, and the two states available were "everything fires" and "nothing does".
  # This is the third axis: fire ONLY the venue named here.
  #
  # ELEMENT-EXACT against the closed set, never a substring: `venuePlan` is written by cc-venue from
  # cc-eligible's own verdict, and a typo'd filter value that matched nothing would read exactly
  # like a correctly-configured cloud-only box with an empty cloud queue — a silent total outage
  # wearing the shape of success. An unrecognised value therefore REFUSES the pass rather than
  # narrowing it to zero (MEMORY.md: default-path-hardening-is-blind-to-the-explicit-argument).
  #
  # 🚨 THE EXCLUDED ITEMS ARE COUNTED AND JOURNALLED, NOT SILENTLY DROPPED. Measured 2026-08-11 the
  # live queue is 45 cloud / 236 local / 31 unlabelled, so `=cloud` parks 267 of 312 items —
  # 86% of the queue, indefinitely. That is the true cost of the migration and it must be visible in
  # the IDL on every pass, because an operator reading "the backlog is running on cloud now" has no
  # other way to learn that six items in seven are not running at all. An unlabelled row is excluded
  # too: absence of a plan is not evidence of eligibility, and the producer fails CLOSED for the
  # same reason (a wrong answer in a venue where nobody can SEE it).
  VENUE_ONLY="${CC_DISPATCH_VENUE_ONLY:-}"
  venue_parked=0
  if [ -n "$VENUE_ONLY" ]; then
    case "$VENUE_ONLY" in
      cloud|local) ;;
      *) echo "cc-dispatch: refusing — CC_DISPATCH_VENUE_ONLY='$VENUE_ONLY' is not in the closed set (cloud|local). A filter that matches nothing is a total outage that reads as an empty queue." >&2
         idl abstained "venue-only '$VENUE_ONLY' outside the closed set (cloud|local) — refusing rather than narrowing to zero"
         return 3 ;;
    esac
    local _before _after
    _before="$(printf '%s' "$dispatchable" | jq 'length' 2>/dev/null || echo 0)"
    dispatchable="$(printf '%s' "$dispatchable" \
      | jq -c --arg v "$VENUE_ONLY" '[ .[] | select((.venuePlan // "") == $v) ]')"
    _after="$(printf '%s' "$dispatchable" | jq 'length' 2>/dev/null || echo 0)"
    venue_parked=$((_before - _after))
    if [ "$venue_parked" -gt 0 ]; then
      idl skipped "venue-only=$VENUE_ONLY parked $venue_parked of $_before dispatchable item(s) — they carry a different venuePlan or none, and will NOT fire while this filter is set"
    fi
  fi

  # 1a2. THE WRITE-PATH VENUE LABEL (W1 item 5a). DECIDE mode only, because that is what
  # `cc-backlog add` kicks — a `--once` cron tick is a clock, and hanging a labeller off a clock is
  # the sweep this wave deletes. A dry pass writes nothing, by the same rule as every other write
  # here, and a pass that lost the singleton is a pure read.
  if [ "$v2" -eq 1 ] && [ "$mode" = decide ] && [ "$inflight" -eq 0 ]; then
    venue_label_new "$open_items"
  fi
  gcount="$(printf '%s' "$guarded"      | jq 'length' 2>/dev/null || echo 0)"
  count="$( printf '%s' "$dispatchable" | jq 'length' 2>/dev/null || echo 0)"

  # never a SILENT fence (the abstention law): every skip is printed AND recorded with its evidence
  # and the exact command that would override it.
  if [ "$gcount" -gt 0 ]; then
    while IFS= read -r g; do
      [ -n "$g" ] || continue
      echo "cc-dispatch: skipped $g" >&2
      [ "$mode" = dry ] && { echo "PLAN: SKIP $g"; continue; }
      SKIPPED=$((SKIPPED + 1)); idl skipped "$g"
    done < <(printf '%s' "$guarded" | jq -r '.[]
      | "\(.id): already done — evidence: \(if (.evidence // "") == "" then "<none>" else .evidence end)"
      + " — re-dispatch needs `cc-backlog reopen \(.id) --force`"')
  fi

  # 1c. S1 — a done-guard skip IS a decision (verdict "skip"), so a pass's decision records cover
  # EVERY non-blocked open item, which is what the A1 acceptance read compares against the folded
  # ledger. Blocked items were filtered out at step 1 and are deliberately NOT decided here: they are
  # parked OUT of the wave by contract, and deciding them would re-create the operator-gated
  # re-dispatch loop `blocked` exists to break. A skip is capacity-INDEPENDENT (the latch drops the
  # item whether or not slots are free), so its free_slots/live_workers fields carry no meaning —
  # only admit/defer records testify about capacity.
  if [ "$v2" -eq 1 ] && [ "$mode" != dry ] && [ "$gcount" -gt 0 ]; then
    while IFS="$(printf '\t')" read -r g gp; do
      [ -n "$g" ] || continue
      idl_decision "$g" skip 0 already-done "$gp"
    done < <(printf '%s' "$guarded" | jq -r '.[] | "\(.id // "")\t\(.project // "")"')
  fi

  # 1d. STALE-PREMISE GUARD — an auto-generated `plan-open` item whose PREMISE has since gone false.
  # cc-discover's C2 critic mints one item per plan that `find-plan.sh --list-open` reports, so the
  # item's entire claim is "this plan is still open". That claim is a SNAPSHOT and nothing re-reads
  # it: the plan lands, its frontmatter flips to `complete`, and the item sits `open` forever. The
  # next wave then claims it and burns a full worker session re-deriving finished work.
  #
  # Measured live 2026-07-31 on item 4d5f09d7716c (row 10 / OPERATOR_SURFACE_V2): emitted 00:57:02Z
  # while the plan read `in-progress`, plan flipped `complete` at 02:29:32Z — 92 minutes later — and
  # a worker was still dispatched onto it a day after all twelve of its increments were on trunk.
  # Two more items were queued behind it in the same state.
  #
  # SCOPED TO source=="plan-open" ON PURPOSE, and this is the load-bearing part of the design. A
  # terminal dodRef is NOT evidence about a HUMAN-filed item: it only falsifies an item whose whole
  # reason for existing was the plan being open. The same live scan found `791345455b58` — a real
  # 358-site pipefail defect (source `relogin-verify-…`) that merely CITES a complete plan as its
  # DoD. Keying this guard on "the dodRef plan is complete" alone would have silently closed it.
  #
  # Fail-OPEN, unlike the fail-CLOSED done-guard above, and for exactly the reason that block's
  # comment gives: this premise lives in a FILE, not in the ledger fold, so every way of failing to
  # read it (unresolvable helper, dodRef that is a code ref rather than a path, deleted plan,
  # unparseable frontmatter) must dispatch anyway. Starving the queue on a sensor failure is the
  # worse error — an unread premise is "I could not tell", never "it is finished" (I6).
  # Kill switch: CC_DISPATCH_PREMISE_GATE=off restores the incumbent wave exactly.
  # The CO-VERSIONED sibling is tried FIRST — `$(dirname "$_self")/../scripts/find-plan.sh`, the same
  # `_self`-anchored repo-root hop this file already uses for PROJECTS_CONF. cc-dispatch and
  # find-plan.sh live in one repo and deploy together (per-file symlinks that track the checkout), so
  # the sibling is GUARANTEED to match the running cc-dispatch's version. Resolving via $HOME first
  # instead skews them whenever cc-dispatch runs from a tree the deployed find-plan.sh has not caught
  # up to (a worktree under test, or a land not yet fast-forwarded into the shared checkout) — the
  # `--status` verb would read as an unknown NAME on the stale copy and the guard would silently
  # fail-open forever. `_self` resolves the symlink chain, so this holds for the deployed layer too.
  local stale='[]' scount=0 findplan staleids
  if [ "${CC_DISPATCH_PREMISE_GATE:-on}" != off ] && [ "$count" -gt 0 ]; then
    findplan="$(resolve_bin "${CC_DISPATCH_FINDPLAN_BIN:-}" find-plan.sh \
                  "$(cd "$(dirname "$_self")/.." 2>/dev/null && pwd)/scripts/find-plan.sh" \
                  "$HOME/.claude/scripts/find-plan.sh")" || findplan=""
    if [ -n "$findplan" ]; then
      local sid sdod sst slist=""
      while IFS="$(printf '\t')" read -r sid sdod; do
        [ -n "$sid" ] && [ -n "$sdod" ] || continue
        [ -f "$sdod" ] || continue                                  # not a plan path ⇒ fail OPEN
        sst="$("$findplan" --status "$sdod" 2>/dev/null)" || continue   # exit 2 / unreadable ⇒ OPEN
        case "$sst" in complete|superseded) slist="$slist$sid	$sst	$(basename "$sdod")
" ;; esac
      done < <(printf '%s' "$dispatchable" \
                 | jq -r '.[] | select((.source // "") == "plan-open")
                              | "\(.id // "")\t\(.dodRef // "")"')
      if [ -n "$slist" ]; then
        staleids="$(printf '%s' "$slist" | cut -f1 | jq -R -s -c 'split("\n")|map(select(length>0))')"
        stale="$(       printf '%s' "$dispatchable" | jq -c --argjson s "$staleids" '[ .[] | select((.id // "") as $i | $s | index($i))       ]')"
        dispatchable="$(printf '%s' "$dispatchable" | jq -c --argjson s "$staleids" '[ .[] | select((.id // "") as $i | $s | index($i) | not) ]')"
        scount="$(printf '%s' "$stale"        | jq 'length' 2>/dev/null || echo 0)"
        count="$( printf '%s' "$dispatchable" | jq 'length' 2>/dev/null || echo 0)"
        # never a SILENT fence: print it, record it, and RETRACT it so the next pass need not
        # re-derive the same thing. The retraction is a ledger write, so it happens only in a real
        # run that holds the singleton — dry and decide stay pure reads, and an inflight pass leaves
        # the write to the lock holder rather than racing it.
        while IFS="$(printf '\t')" read -r sid sst sdod; do
          [ -n "$sid" ] || continue
          echo "cc-dispatch: retracted $sid — its plan $sdod is $sst (source=plan-open premise no longer holds)" >&2
          if [ "$mode" = dry ]; then echo "PLAN: RETRACT $sid ($sdod → $sst)"; continue; fi
          SKIPPED=$((SKIPPED + 1)); idl skipped "$sid: plan-open premise stale — $sdod is $sst — re-open needs \`cc-backlog reopen $sid --force\`"
          [ "$v2" -eq 1 ] && idl_decision "$sid" skip 0 plan-premise-stale \
            "$(printf '%s' "$stale" | jq -r --arg i "$sid" '.[]|select(.id==$i)|.project // ""' | head -1)"
          if [ "$mode" = run ] && [ "$inflight" -eq 0 ]; then
            # evidence says PREMISE, never "verified": no code was read by this retraction.
            # `done` is QUOTED: unquoted, shellcheck parses the verb as the loop keyword (SC1010)
            # and the land gate runs bare shellcheck, which is stricter than -S warning.
            "$backlog" "done" "$sid" --evidence "premise-retracted: $sdod is $sst (source=plan-open; no code verified by this retraction)" >/dev/null 2>&1 || true
          fi
        done <<< "$(printf '%s' "$slist")"
      fi
    fi
  fi

  # 2. nothing dispatchable → passed.
  if [ "$count" -eq 0 ]; then
    local why="backlog empty"
    [ "$gcount" -gt 0 ] && why="backlog empty after done-guard ($gcount already-done item(s) skipped)"
    [ "$scount" -gt 0 ] && why="$why; $scount stale plan-open premise(s) retracted"
    if [ "$mode" = dry ]; then echo "PLAN: $why (projects=$(printf '%s' "$PROJECTS" | tr '\n' ',')) → would pass, no spawn"; return 0; fi
    idl passed "$why"; idl_summary; return 0
  fi

  # ── 3. S1+S2+S7 — DECIDE over the whole backlog, then ADMIT what capacity allows ───────────────
  # v2 replaces the raw FIFO slice below with: order by the fairness key → read the live-worker count
  # through the bounded oracle → journal a verdict for EVERY dispatchable item → hand ONLY the admit
  # set to the planner. The v1 slice is kept verbatim under CC_DISPATCH_LANE=v1.
  local ordered admit_n admitted_ids=""
  if [ "$v2" -eq 1 ]; then
    local th rk reason_admit="" di=0 pos vverdict vreason did
    th="$(thrash_map)"
    printf '%s' "$th" | jq -e 'type=="object"' >/dev/null 2>&1 || th='{}'
    # the derived rank (M2 fire gate). {} on any failure ⇒ every term reads 0 ⇒ the incumbent
    # thrash-then-oldest order, which is why this can never make the pass worse than it was.
    rk='{}'
    if [ "${CC_DISPATCH_RANK:-on}" != off ]; then rk="$(rank_map "$backlog" "$dispatchable")"; fi
    ordered="$(order_dispatchable "$dispatchable" "$th" "$rk")"
    # ordering is a FAIRNESS optimisation, never a correctness dependency: if the sort produced
    # anything but an array (a jq failure, a shape surprise), fall back to the unordered set rather
    # than dropping the pass — a pass that decides nothing is the outage this rebuild is fixing.
    printf '%s' "$ordered" | jq -e 'type=="array"' >/dev/null 2>&1 || ordered="$dispatchable"

    if [ "$inflight" -eq 1 ]; then
      # NO LOCK ⇒ NO ADMISSION BUDGET, and deliberately no capacity MEASUREMENT either. free_slots
      # is 0 because another pass holds the singleton, not because the fleet is full, and a live
      # count on these records would read as though this pass had evaluated capacity and found none
      # — conflating "I was not allowed to admit" with "there was nothing to admit", which is the
      # named-failure-vs-no-verdict conflation this rebuild exists to remove. live_workers:null +
      # reason:"pass-in-flight" says exactly what happened. It also saves the `list --all` read.
      LIVE_RAW=""; FREE_SLOTS=0
    else
      # THE LANE THIS PASS FIRES INTO decides which ceiling bounds it (2026-08-12). A pass narrowed
      # by CC_DISPATCH_VENUE_ONLY fires into exactly one venue, so it must be charged against that
      # venue's own resource — off-box work against quota, on-box work against panes/worktrees/CPU.
      # Charging cloud fires to the local ceiling is what wedged this dispatcher at fired:0 for 1h34m.
      #
      # UNSET (mixed queue) keeps the PRE-FIX behaviour byte-for-byte — `any` against CEILING. That is
      # deliberate: per-item lane accounting in a mixed pass is a real change to admission ordering,
      # it is not needed by the live configuration (which is venue-only), and shipping it untested
      # here would trade a measured wedge for an unmeasured one. Named as open, not silently ~done.
      local _lane _lane_ceiling
      case "$VENUE_ONLY" in
        cloud) _lane=cloud; _lane_ceiling="$CLOUD_CEILING" ;;
        local) _lane=local; _lane_ceiling="$CEILING" ;;
        *)     _lane=any;   _lane_ceiling="$CEILING" ;;
      esac
      LIVE_RAW="$(live_workers "$backlog" "$_lane")"
      if [ -z "$LIVE_RAW" ]; then
        # UNKNOWN: admit AT MOST ONE. Not 0 (a permanently unreadable ledger would stall the queue
        # forever — fail-closed must not amplify into an outage) and not CEILING (that is a blind
        # fire into an unknown fleet). CEILING=0 still admits nothing: the switch outranks the guess.
        FREE_SLOTS=1; [ "$_lane_ceiling" -lt 1 ] && FREE_SLOTS=0
        reason_admit="live-count-unknown"
      else
        FREE_SLOTS=$((_lane_ceiling - LIVE_RAW)); [ "$FREE_SLOTS" -lt 0 ] && FREE_SLOTS=0
      fi
    fi
    admit_n="$FREE_SLOTS"; [ "$admit_n" -gt "$count" ] && admit_n="$count"

    # the decision journal — one record per dispatchable item, in queue order. The queue is ONE
    # cross-project queue under the S7 key, so `position` is a fleet-wide rank and the per-record
    # `project` is what tells a reader which project a rank belongs to.
    #
    # ── THE CLUSTER IS THE DISPATCH UNIT (M2, backlog 1b00d62958a6) ────────────────────────────────
    # Admission used to be `position <= admit_n`, which spends one slot per ROW. Rows are not the
    # unit of work: 18 `tests/deploy-parity.bats` post-land rows differing only by sha are ONE root
    # cause, and slicing the head of the queue fires 18 workers at it. So a slot is spent per
    # CLUSTER — the first member admits, every later member of that same cluster DEFERS with its own
    # reason, and the slot it would have burned goes to different work instead.
    #
    # DEFER, NEVER CLOSE, and that is what makes an aggressive cluster key safe: the sibling keeps
    # its row, keeps its evidence, and is admitted on a later pass once the representative is no
    # longer live. Nothing is merged and nothing is retracted here — cc-backlog's `--condition` lease
    # is the mechanism that decides two rows are one piece of work, and this only declines to spend
    # two slots in one tick.
    #
    # ⚠️ MEASURED SMALL TODAY, AND THAT IS THE HONEST NUMBER: over the live store on 2026-08-10 the
    # open population holds ONE multi-member cluster (4 rows, the MEMORY.md-index condition), so this
    # saves 3 admissions right now — not 17. The 18-row deploy-parity pile that motivates the design
    # is `blocked`, and blocked items were already filtered out at step 1. This is a standing guard
    # against a pile re-forming, not a fix for a pile that is currently in the queue; a reader
    # comparing it against the design note should get that from the code, not from a surprise.
    #
    # bash 3.2 (this box) has NO associative arrays, so membership is a newline-delimited string
    # matched with `grep -Fxq` — an exact WHOLE-LINE match, because a cluster key is free text and a
    # substring test would merge a key into any longer key containing it.
    # ⚠️ THE SEPARATOR IS \037 (UNIT SEPARATOR), NOT A TAB, AND THAT IS A CORRECTNESS FIX, NOT A
    # STYLE ONE. Tab is an IFS *whitespace* character, so bash `read` collapses a RUN of them into a
    # single delimiter and empty middle fields vanish. With three fields that was invisible (an empty
    # trailing cluster is just a short line); with five it is a silent COLUMN SHIFT — a row whose
    # `_cluster` and `_clusterSrc` are both empty delivered `venuePlan` into `$dclus`, so two
    # unrelated items both "clustered" on the string `local` and the second was deferred as a sibling
    # of the first. Measured on a two-item fixture before this line existed. A non-whitespace IFS
    # character delimits exactly one field each time, so an empty field stays empty.
    local dproj dclus dcsrc dvplan taken_clusters="" n_admit=0 rverd rstate rreason rsha
    while IFS="$(printf '\037')" read -r did dproj dclus dcsrc dvplan; do
      [ -n "$did" ] || continue
      pos=$((di + 1)); di=$((di + 1))
      if [ -n "$dclus" ] && [ "${CC_DISPATCH_CLUSTER:-on}" != off ] \
         && printf '%s' "$taken_clusters" | grep -Fxq -- "$dclus"; then
        # A sibling of an item ALREADY ADMITTED THIS PASS. Capacity-independent, like the done-guard
        # skip: it would defer at any free_slots, so it must not be reported as `at-ceiling` — that
        # reason feeds cc-blockers' SATURATED premise gate, which counts it as evidence the fleet is
        # full, and a cluster deferral is evidence of nothing of the kind.
        vverdict=defer; vreason="cluster-sibling"; DEFERRED=$((DEFERRED + 1))
      elif [ "$n_admit" -lt "$admit_n" ]; then
        # ── THE READINESS CONJUNCTION, at the ONE seam where admission is decided ────────────────
        # Evaluated HERE and nowhere else: an item reaches this branch only when capacity exists for
        # it and no sibling has taken its cluster's slot, so the check runs O(free_slots) times per
        # pass rather than over the store. `READY_MAX` bounds it absolutely — past the budget the
        # verdict is UNKNOWN, which is journalled and never blocks, so a long enforce-lane walk can
        # never turn into an unbounded scan wearing a gate's clothes.
        rstate=unknown; rreason="gate-off"; rsha=""
        if [ "$READY_GATE" != off ]; then
          if [ "$READY_CHECKED" -ge "$READY_MAX" ]; then
            rstate=unknown; rreason="budget-spent"; rsha=""
          else
            rverd="$(readiness_verdict "$did" "$dproj" "$dvplan" "$dcsrc" \
              "$( [ "$mode" = dry ] && echo 0 || echo 1 )" </dev/null)"
            IFS="$(printf '\037')" read -r rstate rreason rsha <<< "$rverd"
            READY_CHECKED=$((READY_CHECKED + 1))
            case "$rstate" in
              void)    READY_VOID=$((READY_VOID + 1)) ;;
              unknown) READY_UNKNOWN=$((READY_UNKNOWN + 1)) ;;
            esac
          fi
          if [ "$mode" = dry ]; then
            printf 'READY: %s %s%s (readyAt=%s)\n' \
              "$did" "$rstate" "${rreason:+ — $rreason}" "${rsha:-none}"
          else
            idl_readiness "$did" "$rstate" "$rreason" "$rsha" "$dproj"
          fi
        fi
        if [ "$rstate" = void ] && [ "$READY_GATE" = enforce ]; then
          # ENFORCE — a DEFERRAL, never a drop and never a `done` (R3). The row, its evidence and
          # its queue position are untouched; the slot it would have spent goes to the next
          # candidate, exactly like a cluster sibling's. `readiness_verdict` has already re-derived
          # what a re-derivation can cure, so the item is eligible again on the next pass.
          vverdict=defer; vreason="not-ready:$rreason"; DEFERRED=$((DEFERRED + 1))
        else
          vverdict=admit; vreason="$reason_admit"; ADMITTED=$((ADMITTED + 1)); n_admit=$((n_admit + 1))
          admitted_ids="$admitted_ids$did
"
          [ -n "$dclus" ] && taken_clusters="$taken_clusters$dclus
"
        fi
      else
        vverdict=defer; DEFERRED=$((DEFERRED + 1))
        # pass-in-flight outranks at-ceiling, which outranks capacity (slots existed, this item is
        # past them) and outranks the unknown note: with zero slots the count could not have changed
        # the outcome. The order is by how much of the outcome each explains — "another pass held
        # the singleton" fully determines free_slots:0, so reporting it as at-ceiling would blame
        # the fleet for a lock and would feed cc-blockers' SATURATED premise gate (which counts
        # reason=="at-ceiling") deferrals that carry no evidence about capacity at all.
        # quoted, all three: an unquoted `x=a-b` reads as arithmetic to shellcheck (SC2100) — the
        # value survives, but the warning is real noise on a repo whose gate lints this file.
        if   [ "$inflight" -eq 1 ];   then vreason="pass-in-flight"
        elif [ "$FREE_SLOTS" -eq 0 ]; then vreason="at-ceiling"
        else                               vreason="capacity"; fi
      fi
      [ "$mode" = dry ] || idl_decision "$did" "$vverdict" "$pos" "$vreason" "$dproj"
    done < <(printf '%s' "$ordered" | jq -r --arg s "$(printf '\037')" '.[]
      | [ (.id // ""), (.project // ""),
          ((._cluster // "") | gsub("[\\t\\n\\r\\u001f]"; " ")),
          (._clusterSrc // ""), (.venuePlan // "") ] | join($s)')
    # The cluster rides a delimited field, so it is scrubbed of the separator AND of tabs/newlines at
    # the source rather than trusted: a title is free text and one stray control character would
    # shift every later field silently.

    # admit_n is the CAPACITY bound; n_admit is what was actually spent after cluster collapse, and
    # the two differ exactly when a sibling was declined a slot. Report the spent one — a PLAN line
    # that says "4 admit" while the wave holds 2 is the claimed-vs-checked defect in miniature.
    if [ "$mode" = dry ]; then
      printf 'PLAN: %s dispatchable · ceiling=%s live=%s free_slots=%s → %s admit, %s defer\n' \
        "$count" "$CEILING" "${LIVE_RAW:-unknown}" "$FREE_SLOTS" "$n_admit" "$((count - n_admit))"
      # The would-block rate, printed with its DENOMINATOR — this is the number the flip from
      # `advisory` to `enforce` is decided on, and a rate whose population is not stated alongside
      # it cannot be re-derived later by anyone reading the line.
      printf 'READY: gate=%s checked=%s void=%s unknown=%s would_block=%s%%\n' \
        "$READY_GATE" "$READY_CHECKED" "$READY_VOID" "$READY_UNKNOWN" \
        "$( [ "$READY_CHECKED" -gt 0 ] && ready_rate_pct || printf 'n-a' )"
    fi

    # 3a0. S6 — NO LOCK, so the journal above IS the whole product of this pass. Returning HERE, and
    # not at step 0, is the A2 fix: every dispatchable item now has a verdict from this pass, which
    # is what the 5-minute bound is measured on, while the capacity-consuming steps below (wave-plan,
    # claim, worktree, spawn) stay unreachable without the singleton. Before 3b deliberately: this
    # pass has zero free slots because a lock is held, NOT because the fleet is at its ceiling, and
    # 3b's stderr line would assert the wrong one of those.
    if [ "$inflight" -eq 1 ]; then idl_summary; return 0; fi

    # 3a. DECIDE-ONLY (`--decide` / CC_DISPATCH_DECIDE_ONLY) — the journal IS the product: zero
    # claims, zero spawns, zero pages, no oracle beyond the live count. The safe activation lane.
    if [ "$mode" = decide ]; then idl_summary; return 0; fi

    # 3b. AT CEILING — the load-bearing behaviour of the whole rebuild. Zero free slots is a NORMAL,
    # RECORDED state (backlog > concurrency is the measured steady state), so the pass makes ZERO
    # wave-plan calls, takes ZERO claims, fires ZERO spawns and writes ZERO pages: quota that is
    # never asked for can never be exhausted, and an exhaustion that never happens cannot cliff.
    # A standing cliff page is deliberately NOT cleared here — "at ceiling" is evidence about SLOTS,
    # not about quota headroom (an account can be busy AND capped), and clearing an alarm without
    # falsifying evidence is a false all-clear. It resolves on the next pass that consults the oracle.
    if [ "$admit_n" -eq 0 ]; then
      if [ "$mode" = dry ]; then
        printf 'PLAN: 0 free slots (ceiling=%s live=%s) → all %s item(s) defer, NO wave-plan call, NO page, NO spawn\n' \
          "$CEILING" "${LIVE_RAW:-unknown}" "$count"
        return 0
      fi
      echo "cc-dispatch: at ceiling ($CEILING) — $count item(s) deferred, no spawn (not a cliff)." >&2
      idl_summary; return 0
    fi
  fi

  # 3. wave → quota placement. BOUND the wave to MAX_SPAWN: cc-wave-plan cliffs (exit 4) on any
  # wave exceeding total concurrency (~2x accounts) and by contract NEVER partial-places ("never a
  # blind partial"), so planning the ENTIRE open backlog false-cliffs the instant it exceeds that --
  # stranding ALL items though headroom exists (found live 2026-07-19: a 28-item backlog cliffed
  # every tick while next4 sat at 5h-0%). We spawn at most MAX_SPAWN per tick (step 5) anyway, so
  # plan exactly that many; unclaimed items carry to the next tick. A cliff on THIS bounded wave is
  # then a genuine all-capped cliff. (Assumes MAX_SPAWN <= total concurrency; true for the default.)
  #
  # V2 keeps that invariant and derives the bound from CAPACITY instead of the per-pass constant: the
  # wave is exactly the admit set (free_slots items, already ordered by the S7 key), so it is bounded
  # by CEILING <= total concurrency. Same protection against the false cliff, now with the surplus
  # RECORDED as deferrals rather than silently re-sliced every tick.
  #
  # M2: the wave is now the set the decision loop ACTUALLY ADMITTED, not the head slice `[0:admit_n]`.
  # Those two were the same expression only while admission was positional; once a cluster sibling can
  # be declined a slot mid-slice, a head slice would silently re-add the very row the journal just
  # recorded as `cluster-sibling` — a wave that contradicts its own decision records. Selecting by id
  # keeps the journal and the wave one artifact, and it PRESERVES QUEUE ORDER because the select runs
  # over `ordered`.
  if [ "$v2" -eq 1 ]; then
    local admit_json
    admit_json="$(printf '%s' "$admitted_ids" | jq -R -s -c 'split("\n") | map(select(length > 0))')" \
      || admit_json='[]'
    wave="$(printf '%s' "$ordered" | jq -c --argjson a "$admit_json" \
      '[ .[] | select(.id as $i | $a | index($i)) | {id, slot: (.slot // "lead")} ]')"
  else
    wave="$(printf '%s' "$dispatchable" | jq -c --argjson k "$MAX_SPAWN" '[ .[0:$k][] | {id, slot: (.slot // "lead")} ]')"
  fi
  waveplan="$(resolve_bin "${CC_DISPATCH_WAVEPLAN_BIN:-}" cc-wave-plan)" \
    || die3 "wave-plan bin unresolvable (set CC_DISPATCH_WAVEPLAN_BIN)"
  # 4. THE WALL VERDICT — read what cc-wave-plan SAID, not merely how it exited.
  #
  # cc-wave-plan is four-valued and has been since S3: `capped`(4) `capacity`(4) `auth`(5)
  # `unknown`(6), each with its own operator action, all four pinned by 25 tests in
  # tests/cc-wave-plan-verdict.bats. This is its ONLY executable consumer, and it read the EXIT CODE
  # alone: every 4 became "⛔ QUOTA CLIFF … run /limit-recover", and 5/6 fell into the fail-closed
  # `die3` default. The discrimination was built, tested, landed — and destroyed at the one place
  # obliged to act on it. Both halves cost real behaviour, and both are MEASURED, not reasoned:
  #
  #   · capacity → the wrong page. ~/.claude/autonomy/idl.jsonl:77973, the one and only quota-cliff
  #     record on this box, carries its own contrary diagnosis — reason:"wave-overflow",
  #     action:"reduce-wave-size", four accounts at 1-8% of their 5-hour window. The operator was
  #     told to run /limit-recover over a fleet that was very nearly empty.
  #   · unknown → a dead dispatcher. `cc-dispatch: wave-plan returned non-cliff rc=6 — refusing to
  #     fire blind`, launchctl com.claude.dispatcher LastExitStatus 768 (= exit 3), with `failed`
  #     per day going 7 · 20 · 16 · 16 · 96 · 136 across 08-11..08-16
  #     (docs/research/usage-telemetry-100p-2026-08-16/utilization.md F13). rc 6 is the producer
  #     saying "the oracle gave no answer, retry next pass" — a defined NON-VERDICT, which this
  #     turned into a config-fail that killed the pass. Class: new-enum-member-falls-into-fail-
  #     closed-default; the plan that ADDED these states wrote the lesson itself
  #     (AUTONOMY_DISPATCH_V2.md, 2026-07-31: "when a state is added to a system, enumerate its
  #     consumers and visit each") and this consumer was never visited.
  #
  # The verdict rides the producer's STDERR as `WALL[<verdict>]`, and this call sent that stream to
  # /dev/null. Capturing it is the same idiom as the claim/fire captures further down — a
  # subordinate's diagnosis is evidence, not noise. The exit code stays as the FALLBACK map, so a
  # capture that fails degrades to the contract's own rc→verdict mapping rather than to silence.
  local wperrf="" wpverdict="" wpcap="" wpexc="" wave_n replanned=0
  wave_n="$(printf '%s' "$wave" | jq 'length' 2>/dev/null || echo 0)"
  wperrf="$(mktemp "${TMPDIR:-/tmp}/cc-dispatch-waveplan.XXXXXX" 2>/dev/null || true)"
  while :; do
    if [ -n "$wperrf" ]; then plan="$("$waveplan" --items "$wave" --json 2>"$wperrf")"; rc=$?
    else                      plan="$("$waveplan" --items "$wave" --json 2>/dev/null)";  rc=$?; fi
    [ "$rc" -eq 0 ] && break
    wpverdict=""; wpcap=""; wpexc=""
    if [ -n "$wperrf" ] && [ -s "$wperrf" ]; then
      wpverdict="$(sed -n 's/.*WALL\[\([a-z][a-z]*\)\].*/\1/p' "$wperrf" 2>/dev/null | tail -1)"
      wpcap="$(sed -n 's/.*capacity=\([0-9][0-9]*\).*/\1/p' "$wperrf" 2>/dev/null | tail -1)"
      wpexc="$(head -1 "$wperrf" 2>/dev/null | tr -cd '\40-\176' | cut -c1-200)"
    fi
    # No WALL[] token ⇒ fall back to the rc, which IS the contract (bin/cc-wave-plan:59). This also
    # keeps lane v1 — one unlabelled exit 4 — resolving to `capped`, exactly as it did before.
    if [ -z "$wpverdict" ]; then
      case "$rc" in 4) wpverdict=capped ;; 5) wpverdict=auth ;; 6) wpverdict=unknown ;; esac
    fi
    # `reduce-wave-size` is an ACTION and nothing performed it. Re-plan ONCE at the bound the
    # producer reported; cc-wave-plan stays the arbiter of the smaller wave and a second wall is
    # taken at face value, so this cannot loop. Without it a box whose capacity sits below CEILING
    # walls on EVERY tick forever: nothing fires, so live_workers never rises, so free_slots never
    # falls, so the wave is rebuilt at the same oversized width next pass — starvation with headroom.
    if [ "$wpverdict" = capacity ] && [ "$replanned" -eq 0 ] \
       && [ -n "$wpcap" ] && [ "$wpcap" -gt 0 ] && [ "$wpcap" -lt "$wave_n" ]; then
      replanned=1
      DEFERRED=$((DEFERRED + wave_n - wpcap))
      echo "cc-dispatch: wave-plan WALL[capacity] — re-planning $wave_n → $wpcap item(s) at the capacity it reported; $((wave_n - wpcap)) deferred." >&2
      wave="$(printf '%s' "$wave" | jq -c --argjson k "$wpcap" '[ .[0:$k][] ]')"
      wave_n="$wpcap"
      continue
    fi
    break
  done
  [ -n "$wperrf" ] && rm -f "$wperrf" 2>/dev/null || true

  if [ "$rc" -ne 0 ]; then
    case "$wpverdict" in
      capacity)
        # NOT a quota cliff and NOT a page: the accounts have headroom; the wave is simply wider than
        # the per-wave caps can place, and a re-plan could not shrink it (no bound on the wire, or
        # already at the bound). Surplus DEFERS — the same disposition as the at-ceiling path above,
        # and what scripts/dispatch-acceptance.sh A3 requires of surplus.
        if [ "$mode" = dry ]; then echo "PLAN: wave-plan WALL[capacity] → would defer $wave_n item(s), NO page, NO spawn"; return 0; fi
        DEFERRED=$((DEFERRED + wave_n))
        echo "cc-dispatch: wave exceeds placement capacity — $wave_n item(s) deferred, no spawn (NOT a quota cliff: the accounts have headroom)." >&2
        idl_summary; return 0 ;;
      auth)
        # A real STOP, but a DIFFERENT one: /relogin, never /limit-recover. Recorded under its own
        # action token rather than `abstained` — A3 counts `abstained` records to prove surplus is
        # not abstaining, and an auth wall is not surplus, so folding it in there would trip a
        # reader that is asking a different question. The page still fires; nothing is laundered.
        if [ "$mode" = dry ]; then echo "PLAN: wave-plan WALL[auth] → would page + refuse, NO spawn"; return 0; fi
        ABSTAINED=1; idl walled "auth-wall${wpexc:+: $wpexc}"
        write_page "wave-plan reports an AUTH wall — accounts are logged out (run /relogin)"
        echo "cc-dispatch: ⛔ AUTH WALL — paged, NO spawn (run /relogin — this is NOT a quota wall)." >&2
        idl_summary; return 0 ;;
      unknown)
        # The producer's own words: "NOT a wall and NOT a page: the oracle gave no answer. Retry next
        # pass." A defined non-verdict is not a config-fail. Dying here is what turned a slow account
        # oracle into a dead dispatcher (F13 above) — the pass exits 0 having decided nothing, and
        # the next tick asks again.
        if [ "$mode" = dry ]; then echo "PLAN: wave-plan WALL[unknown] → would retry next pass, NO page, NO spawn"; return 0; fi
        DEFERRED=$((DEFERRED + wave_n))
        echo "cc-dispatch: ⚠️  wave-plan gave NO verdict (the account oracle did not answer) — $wave_n item(s) deferred, retry next pass. Not a cliff, not a page, not a failure." >&2
        idl_summary; return 0 ;;
      capped)
        if [ "$mode" = dry ]; then echo "PLAN: quota-cliff → would abstain + page, NO spawn"; return 0; fi
        ABSTAINED=1; idl abstained "quota-cliff"; write_page "wave-plan reports no account headroom"
        echo "cc-dispatch: ⛔ QUOTA CLIFF — abstained, paged, NO spawn (run /limit-recover)." >&2
        idl_summary; return 0 ;;
    esac
    # Outside the producer's verdict contract (rc 2 usage, rc 3 config-fail, anything unforeseen) the
    # fail-closed default is KEPT, verbatim and loud. Narrowing it to the four DEFINED states is the
    # whole point: an undefined rc still refuses.
    if [ "$mode" = dry ]; then echo "PLAN: wave-plan un-plannable (rc=$rc) → would refuse, NO spawn"; fi
    [ "$mode" = dry ] || { FAILED=1; idl failed "wave-plan rc=$rc${wpexc:+ · $wpexc}"; idl_summary; }
    die3 "wave-plan returned non-verdict rc=$rc — refusing to fire blind"
  fi
  printf '%s' "$plan" | jq -e 'type=="array"' >/dev/null 2>&1 \
    || die3 "wave-plan did not return a JSON array"
  n="$(printf '%s' "$plan" | jq 'length' 2>/dev/null || echo 0)"

  # dry-run: PRINT the plan, no writes.
  if [ "$mode" = dry ]; then
    echo "PLAN: $n placement(s), spawn cap=$MAX_SPAWN (projects=$(printf '%s' "$PROJECTS" | tr '\n' ',')):"
    printf '%s' "$plan" | jq -r '.[] | "  \(.id) -> \(.account // "?")  fire_line=\(.fire_line // [] | @json)"'
    return 0
  fi

  clear_page   # a live placement means quota recovered → drop any standing cliff alarm.

  # 5. claim + spawn, capped at MAX_SPAWN.
  spawn="$(resolve_bin "${CC_DISPATCH_SPAWN_BIN:-}" handoff-fire.sh "$HOME/.claude/scripts/handoff-fire.sh")" \
    || die3 "spawn bin unresolvable (set CC_DISPATCH_SPAWN_BIN)"
  local i=0 spawned=0 p id acct ftype a
  while [ "$i" -lt "$n" ]; do
    [ "$spawned" -ge "$MAX_SPAWN" ] && break
    p="$(printf '%s' "$plan" | jq -c ".[$i]")"; i=$((i + 1))
    id="$(printf '%s' "$p" | jq -r '.id // empty')"
    acct="$(printf '%s' "$p" | jq -r '.account // "?"')"
    [ -n "$id" ] || { FAILED=$((FAILED + 1)); idl failed "placement missing id"; continue; }

    # build the fire_line argv (array | single string), injection-safe.
    local fire_args=()
    ftype="$(printf '%s' "$p" | jq -r '.fire_line | type' 2>/dev/null)"
    if [ "$ftype" = array ]; then
      while IFS= read -r a; do fire_args+=("$a"); done \
        < <(printf '%s' "$p" | jq -r '.fire_line[]')
    elif [ "$ftype" = string ]; then
      # the real planner (cc-wave-plan) emits ONE flat string that INCLUDES the spawn program
      # itself — word-split it (read -ra, no eval) and drop the leading program token, else the
      # whole line lands as argv[1]: handoff-fire errors and the --prompt-file scan sees nothing
      # (found live 2026-07-19: 7/7 spawns died while the argv-array selftests stayed green)
      read -ra fire_args <<< "$(printf '%s' "$p" | jq -r '.fire_line')"
      case "${fire_args[0]:-}" in
        *handoff-fire.sh|*"$(basename "$spawn")") fire_args=("${fire_args[@]:1}") ;;
      esac
    fi
    if [ "${#fire_args[@]}" -eq 0 ]; then
      FAILED=$((FAILED + 1)); idl failed "$id: empty/invalid fire_line"; continue
    fi

    # a. claim — THE ACTUATOR IS THE ARBITER, for four distinct predicates it owns and this caller
    # must not re-implement. A refusal (rc 4) is the system WORKING, never a malfunction, but the
    # causes need OPPOSITE journalling, so the verdict token on line 1 discriminates them:
    #
    #   verdict=sibling-held — a DIFFERENT ROW naming the SAME WORK is claimed and live (cc-backlog
    #     § CONDITION LEASE, 2026-08-07: 97f16b6709fa and 6078392359ac, two wordings of one piece of
    #     work, both dispatched, two worktrees building the same mechanism). Recorded as a SKIP, and
    #     see the branch below for why it must not be the lease's FAILED.
    #   verdict=done-latched — the item LANDED between step 1b's snapshot and this claim, inside the
    #     7-45 s wave-plan plus the admission tail. A race the puller cannot win: a second pull-time
    #     re-check would only shrink the read→append gap, never close it (backlog dadc3c2410aa;
    #     measured on 5690b9d11bee, claimed 5 m 23 s after its own `done`, one burned worker
    #     session). Recorded as a SKIP — the work is finished, the guard held, no human is needed,
    #     and counting it `failed` would feed thrash_map a fault record for a correct refusal.
    #   anything else — THE LEASE: another worker already holds this item and cc-backlog declined to
    #     mint a second onto it. Kept as a FAILURE with its excerpt, as landed: that must stay
    #     distinguishable from a broken ledger or an unknown id, else healthy contention reads as
    #     breakage — the same un-evidenced-verdict defect the spawn capture below exists to fix.
    #
    # Neither path rolls back: a REFUSED claim appends nothing, so the item is exactly as it was.
    #
    # G5 — THE CLAIM CARRIES THE VENUE. Built as an ARRAY so the flag cannot be word-split, and
    # labelled ONLY for a cloud fire: the fold already defaults a venue-less claim to "local"
    # (bin/cc-backlog:615), so an explicit `--venue local` would add a field to every claim in the
    # fleet, carry zero information, and make the rare cloud claim harder to find.
    #
    # NO CAPABILITY FALLBACK, deliberately — unlike the --self-release path below. If this
    # cc-backlog is older than --venue it rejects the flag with rc 2 and the claim FAILS, which is
    # correct: retrying without the flag would mint a claim that says `local` about a session
    # running off-box, and every local oracle would then convict it. Fail-closed and visible beats
    # a silently mislabelled lease.
    # G6 — THE CLAIM CARRIES THE ROLE, AND THIS ONE IS UNCONDITIONAL. `$SID` is `<host>-$$`, this
    # dispatcher's own bash pid, and this pass is ALIVE by construction at the instant the worker it
    # is about to spawn runs its SessionStart hand-over. To `kill -0` that is indistinguishable from
    # a competing peer worker, so cc-backlog's anti-steal guard refused the hand-over and the worker
    # was then gate-refused on its own first write as a "duplicate" of its own dispatcher — measured
    # 2026-08-09 on item b922dde5567b (bin/cc-backlog cmd_reclaim carries the full trace). Labelling
    # the claim is what lets `reclaim` tell a HAND-OVER from a STEAL; nothing else can.
    #
    # Unconditional, unlike --venue above: a dispatcher claim is ALWAYS a placeholder for a worker
    # that does not exist yet, so there is no case where omitting it is right. And NO CAPABILITY
    # FALLBACK, for the same reason --venue has none, sharpened: retrying without the flag would mint
    # an UNLABELLED dispatcher claim, which is precisely the deadlocking claim this fixes — the fix
    # would go silently inert exactly when it is needed (memory:
    # sensor-default-off-makes-blindness-the-shipping-path). Fail-closed and visible.
    # G5-P — THE SEAM WHERE THE DECISION PLUGS IN (W1, docs/plans/CLOUD_BACKLOG_PIPELINE.md).
    # Everything below this block was built and tested with ZERO PRODUCERS: `fire_venue` read an
    # argv that no caller ever put `--cloud` into, so the whole cloud lane was reachable only by
    # hand. bin/cc-venue now writes `venuePlan` onto open rows and THIS is where the plan becomes
    # an argument — the ONE place a fire is composed.
    #
    # IT MUTATES THE ARGV, IT DOES NOT SET THE VENUE. That distinction is the whole design of the
    # three functions above: `fire_venue` reads the array that will ACTUALLY RUN, because that is
    # the one source which cannot disagree with what was launched. Injecting the flag and then
    # letting fire_venue derive the label from it keeps that property exactly; assigning
    # `venue=cloud` here directly would re-create the mislabel-that-reads-as-a-verdict this file
    # was written to prevent. The `!= cloud` guard is fire_venue itself, so the duplicate check is
    # element-exact too rather than a substring test over "${fire_args[*]}".
    #
    # THE BOX OPT-IN OUTRANKS THE PLAN, and the fail-direction is deliberate. handoff-fire ships
    # `--cloud` DEFAULT-OFF and refuses with exit 2 unless CC_FIRE_CLOUD=on, because an off-box
    # fire spends an ACCOUNT's rate limit rather than this box's cores. If this block injected the
    # flag regardless, every cloud-labelled item on a box without the opt-in would become a FIRE
    # FAILURE — a producer that strands exactly the work it routed. So the plan is honoured only
    # where the actuator would accept it, and an unhonoured plan is JOURNALLED rather than
    # silently dropped: the item fires locally, which is always allowed and never wrong, and the
    # IDL says why. The claim label stays truthful either way, since it is read off the argv.
    local plan_venue
    plan_venue="$(printf '%s' "$items" \
      | jq -r --arg i "$id" 'map(select(.id == $i)) | first | .venuePlan // ""' 2>/dev/null)" \
      || plan_venue=""
    # THE CLOUD ACTUATOR IS `cc-offload up`, NOT a --cloud flag on the local spawn (2026-08-11,
    # the lead's fire-#1 forensics — session_01YcTifmgrKh3KFYuz45Rret, item 38de29ec5e59). The
    # handoff-fire cloud leg is the DEPRECATED CLI create: it bundle-retries, DELIVERS NO BRIEF
    # (its own success output offers `send: cc-notify --cloud …` as a step nobody takes — the
    # session sat NOT-STARTED forever), and this dispatcher's follow-up declare then OVERWROTE the
    # leg's correct declaration with the worktree name as the branch, so the reconcile watched a
    # branch the VM would never push. cc-offload up --via api is the one managed create: the
    # acceptance-gated two-call create, the brief delivery, the declaration with the REAL branch +
    # management fields, and custody-at-fire all live there and are pinned by its own suites.
    # The venue is therefore a SELECTION between actuators, not an argv mutation — and the
    # selection variable is the single source the claim label reads, which preserves G5's rule
    # (the label cannot disagree with what launches, because it and the launch read one variable).
    local venue claim_args
    venue=local
    if [ "$plan_venue" = cloud ]; then
      if [ "${CC_FIRE_CLOUD:-off}" = on ]; then
        venue=cloud
      else
        idl skipped "$id: venue=cloud PLANNED but not honoured — CC_FIRE_CLOUD is '${CC_FIRE_CLOUD:-off}' (needs 'on') on this box, so the off-box actuator would refuse; fired LOCALLY instead"
      fi
    fi
    # A hand-authored fire_line that already says --cloud keeps its meaning even when the plan is
    # silent: the legacy flag routes to the same selection, never to the deprecated leg.
    [ "$venue" = cloud ] || venue="$(fire_venue "${fire_args[@]}")"
    claim_args=(claim "$id" --by "$SID" --role dispatcher)
    if [ "$venue" = cloud ]; then claim_args+=(--venue cloud); fi
    local cerrf crc cexc
    cerrf="$(mktemp "${TMPDIR:-/tmp}/cc-dispatch-claim.XXXXXX" 2>/dev/null || true)"
    if [ -n "$cerrf" ]; then "$backlog" "${claim_args[@]}" >/dev/null 2>"$cerrf"; crc=$?
    else                     "$backlog" "${claim_args[@]}" >/dev/null 2>&1;       crc=$?
    fi
    cexc="$(claim_excerpt "$cerrf")"
    [ -n "$cerrf" ] && rm -f "$cerrf" 2>/dev/null || true
    if [ "$crc" -eq 4 ] && [ "${cexc#*verdict=sibling-held}" != "$cexc" ]; then
      # verdict=sibling-held — another ROW naming the SAME WORK is claimed and live, and the actuator
      # declined to put a second worker on it (cc-backlog § CONDITION LEASE). A DEFERRAL, journalled
      # like done-latched rather than like the row lease, for two reasons the row lease does not have:
      #
      #   · It RECURS BY DESIGN. The refusal appends nothing, so the item stays `open` and every pass
      #     until the sibling releases will land here again. That is the same shape as an at-ceiling
      #     deferral — a normal recorded state — whereas `failed` would feed thrash_map a fault
      #     record on every tick for a correct refusal, and eventually block the item outright.
      #   · NOBODY IS NEEDED. The row lease's FAILED is right because contention over one row can
      #     mean a wedged worker someone must look at. Here the second row is SUPPOSED to wait: the
      #     work is in progress, and it will be dispatchable (or done) when the sibling finishes.
      #
      # Discriminated POSITIVELY, like done-latched and for the same reason: a token that went
      # missing degrades to the lease's incumbent FAILED path, never to a silent fire.
      echo "cc-dispatch: skipped $id — a sibling row holds this condition (claim refused, will retry)" >&2
      SKIPPED=$((SKIPPED + 1))
      idl skipped "$id: sibling-held — claim REFUSED at the actuator: another row naming this work is live${cexc:+ — $cexc} — retries automatically when the sibling releases"
      continue
    fi
    if [ "$crc" -eq 4 ] && [ "${cexc#*verdict=done-latched}" != "$cexc" ]; then
      echo "cc-dispatch: skipped $id — landed during this pass's admission tail (claim refused)" >&2
      SKIPPED=$((SKIPPED + 1))
      idl skipped "$id: already done — claim REFUSED at the actuator (landed after the step-1 snapshot)${cexc:+ — $cexc} — re-dispatch needs \`cc-backlog reopen $id --force\`"
      continue
    fi
    # A PREMISE REFUSAL IS A SKIP, NOT A FAILURE — and it has to be said explicitly here, because
    # the default arm below counts every other rc 4 as FAILED. That default is right for the lease
    # (contention is transient; retrying next tick is the cure) and exactly wrong for this: a refuted
    # premise is a PERMANENT state, so counting it a failure re-dispatches the same item every 300 s
    # forever and inflates the failure rate that the admission logic reads. Same shape as the
    # done-latch arm above, same positive discrimination on the token
    # (memory: new-enum-member-falls-into-fail-closed-default).
    if [ "$crc" -eq 4 ] && [ "${cexc#*verdict=premise-refuted}" != "$cexc" ]; then
      echo "cc-dispatch: skipped $id — its premise no longer holds (claim refused at the actuator)" >&2
      SKIPPED=$((SKIPPED + 1))
      idl skipped "$id: premise refuted — claim REFUSED at the actuator${cexc:+ — $cexc} — the disproof is the deliverable; re-dispatch needs \`cc-backlog claim $id --force\`"
      continue
    fi
    # verdict=cloud-ineligible — bin/cc-eligible refused the item for THIS VENUE ONLY (repo-only work
    # is fine off-box; visual/design work and anything about THIS BOX is not), and bin/cc-backlog
    # translated its rc 3 into the claim's rc 4. A SKIP, for the same two reasons as sibling-held:
    #
    #   · It RECURS BY DESIGN. The refusal appends nothing, so the item stays `open` and every future
    #     cloud pass lands here again until it is reclassified or claimed locally. Counting that
    #     FAILED feeds thrash_map a fault record per tick for a correct refusal.
    #   · NOBODY IS NEEDED, and nothing is broken. The item is perfectly dispatchable — just not
    #     off-box. `--venue local` runs it untouched, which is the opposite of a failure.
    #
    # Positively discriminated on the token like the three arms above, so a renamed or missing
    # verdict degrades to the incumbent FAILED path rather than to a silent fire
    # (memory: new-enum-member-falls-into-fail-closed-default). Without this arm the item took the
    # default below and was journalled as a lease FAILURE — harmless only while the tap is shut.
    if [ "$crc" -eq 4 ] && [ "${cexc#*verdict=cloud-ineligible}" != "$cexc" ]; then
      echo "cc-dispatch: skipped $id — ineligible for --venue cloud (claim refused at the actuator)" >&2
      SKIPPED=$((SKIPPED + 1))
      idl skipped "$id: cloud-ineligible — claim REFUSED at the actuator: this work cannot run off-box${cexc:+ — $cexc} — it claims LOCALLY untouched, or \`cc-backlog claim $id --venue cloud --force\`"
      continue
    fi
    if [ "$crc" -ne 0 ]; then
      FAILED=$((FAILED + 1)); idl failed "$id: claim rc=$crc${cexc:+ — $cexc}"; continue
    fi
    # G5 — WHERE THE OWNING ACCOUNT IS RECORDED, and why it is here rather than on the claim.
    # An off-box session spends ONE account's rate limit, and "which one" is the first question
    # anyone asks of a cloud item — but cc-backlog's claim record has no account field
    # (bin/cc-backlog:1171-1179 writes id/ts/event/by/evidence/needs/run/session/venue/force), and
    # bin/cc-backlog is owned by another live session, so this change may not add one.
    #
    # The two existing fields were both REJECTED as carriers. `--evidence` is folded FORWARD
    # (bin/cc-backlog:604 `($r.evidence // $p.evidence // "")`), so an account name written there
    # would render as the item's evidence in `show` and in the operator readouts until a `done`
    # overwrote it — where the contract is "the landed sha". `--session` names a session id, which
    # `by` already carries. Either would be a mislabel, and a mislabel reads as a verdict.
    #
    # So it goes in the DISPATCHER'S OWN journal, which has no competing semantics and no owner but
    # us. Emitted at CLAIM time rather than only at fire time so the pairing survives a fire that
    # never returns: an item claimed `venue=cloud` with no recorded account would otherwise be an
    # off-box lease whose spender is unknowable.
    if [ "$venue" = cloud ]; then
      idl claimed "$id: venue=cloud account=${acct} — claimed --venue cloud; the account is recorded HERE because cc-backlog's claim record has no account field"
    fi
    # a2. compose the BRIEF the fire_line references. wave-plan (a pure planner) only emits the
    # path; the actuator writes the content — with nothing writing it, every spawn died on the
    # absent --prompt-file (found live 2026-07-19). An existing NON-EMPTY file is honored
    # (an operator-authored brief wins); compose-fail reopens, never a blind spawn.
    local pfile="" bj title dod iproj irepo rails
    # the ITEM's project — every project-shaped field in the brief and in worktree provisioning is
    # per-item now (the dispatch set spans projects), never the pass's pinned project.
    iproj="$(printf '%s' "$dispatchable" | jq -r --arg i "$id" '.[]|select(.id==$i)|.project // empty' | head -1)"
    [ -n "$iproj" ] || iproj="$PROJECT"
    for ((bj=0; bj<${#fire_args[@]}-1; bj++)); do
      [ "${fire_args[$bj]}" = "--prompt-file" ] && { pfile="${fire_args[$((bj+1))]}"; break; }
    done
    if [ -n "$pfile" ] && [ ! -s "$pfile" ]; then
      title="$(printf '%s' "$dispatchable" | jq -r --arg i "$id" '.[]|select(.id==$i)|.title // empty' | head -1)"
      dod="$(printf '%s' "$dispatchable"   | jq -r --arg i "$id" '.[]|select(.id==$i)|.dodRef // empty' | head -1)"
      # RAILS ARE READ FROM THE PROJECT, never hardcoded. The brief used to promise "the project-local
      # /ship" unconditionally; that rail exists in claude-infrastructure and reso-management-app but
      # NOT in doc_classifier (no .claude/commands/ship.md, no CLAUDE.md) — and doc_classifier holds
      # the 5 oldest open items in the ledger, so under the S7 key it is the FIRST thing this change
      # dispatches. A brief that names a nonexistent landing command sends a worker to invent one.
      irepo="$(project_repo "$iproj")"
      if [ -f "$irepo/.claude/commands/ship.md" ]; then
        rails="dedicated worktree + own branch; gate green before commit; land ONLY via the project-local /ship (never bare push); C10 — never edit settings.json/live hooks/launchd in place."
      else
        rails="dedicated worktree + own branch; gate green before commit. This project has NO /ship rail — commit on your own branch and SURFACE it for the operator; never bare-push, never land yourself. C10 — never edit settings.json/live hooks/launchd in place."
      fi
      # THE PREMISE CONTRACT RIDES THE BRIEF, because the brief is the only enforcing store a
      # worker actually reads (memory: conclusion-must-reach-the-enforcing-store). The claim gate
      # refuses the ~11 items whose whole premise is gone; the far larger class is an item with ONE
      # refuted sub-claim and real work beside it, which MUST be worked — but not on the refuted
      # part. Printing that verdict where only a log sees it changes nothing, so it goes here.
      # Silent when there is nothing to say: a contract that fires on every item is one the worker
      # learns to skip. Failure is a no-op — a brief without it is exactly the incumbent brief.
      # `$_self` already resolved the symlink chain at the top of this file, so the CO-VERSIONED
      # sibling is one dirname away — and it is tried FIRST rather than via `command -v`, for the
      # reason the find-plan.sh gate gives above: resolving through $HOME would pair a worktree's
      # cc-dispatch with the DEPLOYED cc-premise and silently skew the two.
      local pcontract="" pbin
      pbin="${CC_DISPATCH_PREMISE_BIN:-$(cd "$(dirname "$_self")" 2>/dev/null && pwd)/cc-premise}"
      [ -x "$pbin" ] && pcontract="$("$pbin" contract "$id" 2>/dev/null || true)"
      # …and a SUPERSESSION finding is additionally PRINTED and JOURNALLED, unlike the rest of the
      # contract. The brief alone is not enough for this one class: it says a sibling row may
      # already hold this item's fix, i.e. that dispatching at all may have been the mistake — and
      # the only reader who can act on THAT is whoever is watching the wave, who never sees the
      # worker's prompt file. Journalled for the same reason the done-guard's skips are: an
      # unrecorded near-miss cannot be counted later (backlog 0c5d47c863bf — the incident it was
      # filed for cost a full worker session, and nothing in the store said so).
      #
      # NOT A SKIP. cc-dispatch keeps dispatching: supersession is a judgement the worker makes
      # with the contract in hand, and retracting the item here would re-create the plan-open
      # gate's failure mode on a heuristic that is right about 1 candidate in 2, not 1 in 1.
      if [ -n "$pcontract" ] && [ "${pcontract#*POSSIBLE SUPERSESSION}" != "$pcontract" ]; then
        local psup
        psup="$(printf '%s\n' "$pcontract" | sed -n 's/.*\(POSSIBLE SUPERSESSION.*\)/\1/p' | head -1)"
        echo "cc-dispatch: $id — possible supersession, dispatching WITH the contract: ${psup:-POSSIBLE SUPERSESSION}" >&2
        idl note "$id: possible supersession — a sibling closed after this item was filed and its landed diff touched a file this item cites; the worker is briefed to adjudicate before working"
      fi
      # The desk back-channel is briefed as `--role desk`, NOT `$(cat ~/.claude/cc-roles/desk)`
      # (2026-08-10, backlog 08ba1e3dccc2). Both are role-indirection and payload-lint accepts either,
      # but they fail DIFFERENTLY when the role is unset — which is its standing state here, since a
      # desk-less fleet is a supported configuration (see cc-reaper + lead-supervisor, 2026-08-01).
      # `$(cat …)` resolves in the WORKER's shell, so an unset role collapses the address to "" before
      # cc-notify sees it, and the worker is told its registry holds no such target. `--role desk` hands
      # the role name to the resolver intact, so the worker is told the role is unset and where its file
      # lives. Same delivery, an actionable diagnosis instead of a misdirected one.
      # THE STALENESS RAIL (backlog 6110fc45141e), and why it rides the brief even though the fire
      # is now gated. On 2026-08-08 a worker was fired into a worktree 735 commits behind trunk. The
      # post-land RED it carried reproduced FAITHFULLY there — the fix had landed on trunk eight days
      # earlier and was simply absent from that tree — so the failure was live, the file matched the
      # item, the diagnosis was correct, and the diff would have REVERTED two landed generalisations
      # with a commit message confidently explaining why. Every ordinary check passed. Only an
      # explicit `git show origin/main:<path>` caught it.
      #
      # The fire-time gates (warm_worktree + the pre-existing-dir arm above, and handoff-fire's own
      # hf_freshness_gate) make a STALE TREE the thing that cannot happen. This is the other half,
      # and it is not redundant with them: the tree can be perfectly fresh and the ITEM still be
      # stale — filed against a sha whose cure landed while the row sat in the queue. Both failures
      # end the same way, in a diff that reverts trunk, and only one of them is a git question. So
      # the worker is told to re-check at CONSUMPTION rather than trust what it was handed, which is
      # the same rule the evidence-freshness sibling (f46261b23ec2) proposes for the item's TEXT.
      #
      # NO BACKTICKS ANYWHERE IN THIS LIST — these are double-quoted shell strings, so a backtick
      # would command-substitute at compose time and write its OUTPUT into the worker's brief.
      local staleness_rail
      staleness_rail="FIRST STEP — read what this item cites on TRUNK, never in your own tree. Run: git -C $irepo fetch origin -q && git rev-list --count HEAD..origin/main (0 means your tree IS trunk; anything else means every file you are about to read predates it), then 'git show origin/main:<path>' for each file the item names, and check the cited sha against origin/main with 'git log --oneline <sha>..origin/main -- <path>'. A post-land RED reproduces FAITHFULLY in a stale tree, and against a fix that already landed, so a correct-looking diagnosis can produce a diff that REVERTS trunk (cc-backlog 6110fc45141e). If the cure is already on trunk, the item is DONE — close it with that sha as evidence rather than re-deriving it."
      if ! printf '%s\n' \
        "TASK — ${title:-backlog item $id} — cc-backlog item $id (project $iproj, repo $irepo)." \
        "DoD ref: ${dod:-none}. Scope (frozen): drive this ONE item to finished-verified-landed." \
        ${pcontract:+"$pcontract"} \
        "$staleness_rail" \
        "Rails: $rails" \
        "On completion: cc-backlog done $id --evidence \"<landed sha>\"." \
        "If blocked on an OPERATOR-only step (a key, a launchctl bootout, any human action you cannot do): cc-backlog block $id --needs \"<the exact step>\" — this PARKS the item OUT of the dispatch wave (no re-dispatch loop, no burned worker slot) until the operator acts, then cc-notify --role desk \"<the step>\". Do NOT reopen an operator-gated item — that re-cycles it." \
        "If blocked on info or a decision instead (not an operator step): cc-backlog reopen $id and cc-notify --role desk \"<the blocker>\"." \
        > "$pfile"; then
        # --by $SID: this is a SELF-RELEASE of the claim we took two lines up. cc-backlog's
        # live-claim reopen guard refuses a FOREIGN reopen of a live claim (and $SID — our own
        # still-running pid — is maximally live), so the rollback must identify itself as the
        # claimer or it would be refused and the item would strand as claimed until reap.
        local csr; csr="$(self_release "$id" compose-fail)"
        FAILED=$((FAILED + 1)); idl failed "$id: brief compose failed (reopened${csr})"; continue
      fi
    fi
    # a3. provision the worker's OWN worktree WARM (item b87573077f11). wave-plan is a pure planner:
    # it emits `--cwd <path>` and creates nothing. Firing every worker co-cwd in the shared checkout
    # made a wave fight over one git index and land-conflict (rebase exit 5); handing them
    # `--worktree` instead would take handoff-fire's COLD path, which races CC boot for the
    # auto-submit keystroke (memory cold-worktree-fire-autosubmit-race). So we create it here, fully
    # provisioned, and the fire is a plain warm `cd`. Absent/existing path ⇒ no-op; failure reopens.
    local wcwd="" wj
    for ((wj=0; wj<${#fire_args[@]}-1; wj++)); do
      [ "${fire_args[$wj]}" = "--cwd" ] && { wcwd="${fire_args[$((wj+1))]}"; break; }
    done
    if [ -n "$wcwd" ] && [ ! -d "$wcwd" ] && ! warm_worktree "$wcwd" "$iproj"; then
      local wsr; wsr="$(self_release "$id" worktree-fail)"
      FAILED=$((FAILED + 1)); idl failed "$id: worktree provision failed (reopened${wsr})"; continue
    fi
    # M2 — THE SECOND FRESHNESS HOLE, and the one with no fetch in front of it at all. The line above
    # provisions only when the path is ABSENT; an already-present `wt-<id>` directory short-circuits
    # the whole of warm_worktree, so it is fired into with no fetch, no base read, and an arbitrarily
    # old HEAD. warm_worktree's own guard cannot see this case by construction — it is never called.
    # Same three-state discipline: only a PROVEN-stale tree refuses; `unknown` fires, as every sensor
    # failure in this file does.
    if [ -n "$wcwd" ] && [ -d "$wcwd" ] && [ "${CC_DISPATCH_WT_FRESH:-on}" != off ]; then
      local wrepo wbase wstate
      wrepo="$(project_repo "$iproj")" || wrepo=""
      if [ -n "$wrepo" ] && git -C "$wrepo" rev-parse --git-dir >/dev/null 2>&1; then
        wbase="${CC_DISPATCH_WT_BASE:-}"
        if [ -z "$wbase" ]; then
          wbase="$(git -C "$wrepo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
          [ -n "$wbase" ] || wbase="origin/main"
        fi
        git -C "$wrepo" fetch origin -q 2>/dev/null || true
        wstate="$(wt_base_state "$wcwd" HEAD "$wbase")"
        # A1 — THE REFUSAL WAS A LOOP, NOT A GUARD (docs/plans/BACKLOG_DRAIN_24_7.md §4 A1).
        # The guard above is correct and the refusal is right; what followed it was not. `self_release`
        # reopens the row, so the very next pass re-ranks it, re-claims it, re-probes the same
        # never-rebased directory and refuses again — forever, because nothing in the cycle can change
        # the tree. Measured over 24 h: 141 claims / 129 reopens / 73 done, with ee1ac85c6ff6 alone at
        # 50 claims / 48 releases; fleet-wide 63% of 2,462 claims ended in a release. Every one of those
        # cycles burned an admission slot that a fireable row could have had, so the cost is not the
        # noise in the log — it is the work that never got dispatched behind it.
        #
        # TWO EXITS, AND THE SAFE ONE IS THE DEFAULT. warm_worktree already settled this policy one
        # branch over (see its two sub-cases): a leftover carrying nothing is fast-forwarded, and a tree
        # carrying work is never touched by an unattended dispatcher. This site now applies the same
        # rule to the directory warm_worktree never sees:
        #   · PRISTINE (clean tree AND no commits of its own) ⇒ nothing can be lost, so `merge --ff-only`
        #     it onto the freshly-fetched base and re-probe. If it comes back fresh we fall through and
        #     fire on THIS pass — that is the "retry once", and it costs the queue nothing.
        #   · ANYTHING ELSE ⇒ the row is BLOCKED, not reopened. `blocked` is the operator-only state and
        #     cc-dispatch excludes it from the wave by construction, so the row leaves the claim pool
        #     instead of returning to it. That is the whole fix: the loop needs an exit that is not the
        #     entrance.
        # `--needs` carries the worktree AND the one command that clears it, because a blocked row whose
        # remedy is not written down is just a quieter stall.
        #
        # FAIL TOWARD BLOCKING, NEVER TOWARD THE FF. Staged and untracked bytes count as work here: two
        # of the three thrashing worktrees measured clean by `rev-list --count` and were holding real
        # unlanded content anyway — ee1ac85c6ff6 carried 4 files absent from trunk entirely, staged and
        # never committed (memory: landedness-over-commits-is-blind-to-staged-content). `status
        # --porcelain` sees all three populations; a `rev-list` alone would have fast-forwarded over it.
        if [ "$wstate" = stale ]; then
          local wdirty wahead
          wdirty="$(git -C "$wcwd" status --porcelain 2>/dev/null | head -1)"
          wahead="$(git -C "$wcwd" rev-list --count "$wbase..HEAD" 2>/dev/null || echo unknown)"
          if [ -z "$wdirty" ] && [ "$wahead" = 0 ] \
             && git -C "$wcwd" merge -q --ff-only "$wbase" >/dev/null 2>&1 \
             && [ "$(wt_base_state "$wcwd" HEAD "$wbase")" = fresh ]; then
            echo "cc-dispatch: $wcwd was behind $wbase with nothing of its own — fast-forwarded, firing" >&2
          else
            echo "cc-dispatch: refusing to fire into $wcwd — its HEAD does not contain $wbase (pre-existing worktree, never re-based)" >&2
            local wsr2 wnote wblocked
            wsr2="$(self_release "$id" worktree-fail)"
            wnote="pre-existing worktree $wcwd is behind $wbase and cannot be fast-forwarded"
            [ -n "$wdirty" ] && wnote="$wnote (uncommitted/staged content)"
            [ "$wahead" != 0 ] && wnote="$wnote (carries $wahead commit(s) of its own)"
            # Blocked AFTER the release, never before: status folds last-event-wins, so this ordering
            # clears the claim and still leaves the row `blocked`. If the block itself fails we are
            # exactly at the incumbent behaviour — a reopened row — which is a thrash, but a thrash is
            # strictly better than a row silently stranded as `claimed` with no owner.
            wblocked=reopened
            if [ -n "$backlog" ] && [ -x "$backlog" ] \
               && "$backlog" block "$id" --needs "$wnote. Salvage or retire it, then unblock: inspect with \`git -C $wcwd status --porcelain && git -C $wcwd log $wbase..HEAD\`; if there is nothing to keep, \`git -C $wrepo worktree remove --force $wcwd\` — then \`cc-backlog unblock $id\`." >/dev/null 2>&1
            then wblocked=blocked; fi
            FAILED=$((FAILED + 1))
            idl failed "$id: $wnote — not fired ($wblocked${wsr2})"
            continue
          fi
        fi
      fi
    fi

    # b. spawn → on non-zero, reopen the claim (leave it for the next run).
    # The fire's own output is CAPTURED, not discarded. `>/dev/null 2>&1` here made every failure
    # verdict un-evidenced — the defect class §1(c) names and R3 forbids, reproduced inside our own
    # actuator: 112 `spawn non-zero` records in one 10 h window, each naming only that something
    # failed. The rc and a bounded excerpt make the same record diagnosable, and the id-colon prefix
    # is preserved verbatim because thrash_map splits the detail on the FIRST colon to recover the id.
    local ferrf frc fexc
    ferrf="$(mktemp "${TMPDIR:-/tmp}/cc-dispatch-fire.XXXXXX" 2>/dev/null || true)"
    if [ "$venue" = cloud ]; then
      # The managed cloud actuator (see the venue-selection block above). The brief is the SAME
      # composed prompt file the local fire would have carried — extracted from the argv that
      # would actually run, never re-derived — and the account is the routed one. notify-back is
      # the DESK role's pane when one is claimed; with no role file the fire still declares WITH
      # custody, so the sweep manages it and only the wake degrades. A resolve failure or a
      # refused create lands in the ordinary failure arm below: self-release + FAILED + excerpt,
      # which is exactly what those arms exist for.
      local offload_bin cloud_pf="" cnb="" _fa_prev=""
      for _fa in "${fire_args[@]}"; do
        [ "$_fa_prev" = "--prompt-file" ] && { cloud_pf="$_fa"; break; }
        _fa_prev="$_fa"
      done
      offload_bin="$(resolve_bin "${CC_DISPATCH_OFFLOAD_BIN:-}" cc-offload "$HOME/.claude/bin/cc-offload")" || offload_bin=""
      cnb="$(cat "$HOME/.claude/cc-roles/desk" 2>/dev/null || true)"
      if [ -z "$offload_bin" ] || [ -z "$cloud_pf" ]; then
        frc=3
        [ -n "$ferrf" ] && printf 'cloud fire REFUSED before create: %s\n' \
          "${offload_bin:+prompt-file missing from fire_line}${offload_bin:-cc-offload unresolvable (set CC_DISPATCH_OFFLOAD_BIN)}" >"$ferrf"
      else
        local -a up_args=(up --via api --task "$cloud_pf" --account "$acct" --item "$id")
        [ -n "$cnb" ] && up_args+=(--notify-back "$cnb")
        if [ -n "$ferrf" ]; then "$offload_bin" "${up_args[@]}" >"$ferrf" 2>&1; frc=$?
        else                     "$offload_bin" "${up_args[@]}" >/dev/null 2>&1; frc=$?
        fi
      fi
    elif [ -n "$ferrf" ]; then "$spawn" "${fire_args[@]}" >"$ferrf" 2>&1; frc=$?
    else                     "$spawn" "${fire_args[@]}" >/dev/null 2>&1; frc=$?
    fi
    # …BUT ONLY THE FAILURES WERE EVER READ, AND THAT IS ITS OWN BLIND SPOT (2026-08-07).
    # The paragraph above fixed "a failure verdict with no evidence" and left the mirror image
    # standing: on rc 0 `$ferrf` was `rm`'d UNREAD. handoff-fire narrates its whole anchor decision
    # on stderr — `→ headless fire: … anchored to live pane X (N pane(s) in its tab)`,
    # `!! FOCUS-STOLEN …`, `Closed the untyped pane N`, every `→ fire-cleanup: …` — and that stream
    # existed nowhere else, so the ONE path that succeeds was the ONE path whose evidence was
    # destroyed. A fire that misbehaves and still returns 0 was therefore unfalsifiable after the
    # fact, by construction.
    #
    # It stopped being hypothetical on 2026-08-07: two headless fires anchored on the operator's own
    # panes, one of which was destroyed with unsent composer text in it, and the forensic answer to
    # "which call did that?" was unrecoverable — /tmp/claude-dispatcher.stderr.log contains ZERO
    # occurrences of `headless fire`, `anchor`, `FOCUS-STOLEN` or `fire-cleanup` across its entire
    # history, because every one of them was written to a mktemp and deleted seconds later.
    # (Same shape as memory gate-silence-population-and-suppression: never-LOOKED-AT and
    # told-to-IGNORE render as the same green.)
    #
    # A success excerpt is kept — bounded by the same fire_excerpt the failure arm uses, so this
    # cannot become a log-volume problem — and the ANCHOR DECISION is promoted to its own idl field,
    # because "which pane did an autonomous fire attach itself to" is the question that took an
    # incident to ask and had no answer. Silence here reads as "no anchor line was emitted", which
    # is itself diagnostic rather than ambiguous.
    if [ "$frc" -eq 0 ]; then
      local fanch=""
      [ -n "$ferrf" ] && fanch="$(/usr/bin/grep -m1 -o 'anchored to live pane [^ ]*' "$ferrf" 2>/dev/null || true)"
      # The venue is deliberately NOT added to this line. It is already journalled at claim time
      # (the `idl claimed` record above), so repeating it here would buy nothing — and this exact
      # literal is pinned by tests/cc-dispatch-fire-evidence.bats, which exists because the anchor
      # decision went un-recorded through an incident. Not worth reddening that pin for a duplicate.
      FIRED=$((FIRED + 1)); spawned=$((spawned + 1)); idl fired "$id -> $acct${fanch:+ — $fanch}"
      [ -n "$ferrf" ] && fire_log_keep "$id" "$acct" "$frc" "$ferrf"
      # G5 — DECLARE THE CLOUD SESSION, NOW. The id is a RETURN VALUE (CLOUD_OBSERVABILITY.md
      # §8.1), so this is the earliest moment it can be done at all, and every moment it is not
      # done the session is unobservable AND reapable. Loud on failure, on stderr and in the
      # journal, because the fire itself returned 0 — nothing else about this pass looks wrong,
      # which is exactly why a swallowed declare failure would never be found.
      #
      # NOT counted into FAILED: the fire succeeded and the item is legitimately claimed and
      # working. What is broken is the observability of it, which is its own state and needs its
      # own name in the ledger rather than being folded into "the spawn failed".
      if [ "$venue" = cloud ]; then
        local cdv cdrc=0
        cdv="$(cloud_declare "$id" "$ferrf" "$(fire_branch "${fire_args[@]}")" "$acct")" || cdrc=$?
        if [ "$cdrc" -eq 0 ]; then
          idl declared "$id: $cdv"
        else
          echo "cc-dispatch: !! $id — $cdv" >&2
          idl undeclared "$id: $cdv — the session is LIVE and spending ${acct}'s quota, but nothing on this box can see, name or reap it"
        fi
      fi
    else
      # THE HIGH-VOLUME ONE. rc 9 here is the fire CAPACITY GATE, whose refusal text is literally
      # "Shed load first … then re-fire" — a retryable machine state, measured at 36 refusals against
      # 5 fires in one 2 h window. Unflagged it wrote the same ledger shape as a worker bouncing off
      # the item, and reap's rule B blocked 228 items on it. See SELF-RELEASE in bin/cc-backlog.
      local fsr; fsr="$(self_release "$id" spawn-fail)"
      fexc="$(fire_excerpt "$ferrf")"
      FAILED=$((FAILED + 1)); idl failed "$id: spawn rc=$frc (reopened${fsr})${fexc:+ — $fexc}"
      [ -n "$ferrf" ] && fire_log_keep "$id" "$acct" "$frc" "$ferrf"
    fi
    [ -n "$ferrf" ] && rm -f "$ferrf" 2>/dev/null || true
  done

  idl_summary
  return 0
}

# ── selftest: every branch RED-proved against stubbed actuators (no bats dependency) ───────────────
selftest() {
  local pass=0 fail=0 tmp SELF
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/cc-dispatch-selftest.XXXXXX")" || die3 "cannot mktemp"
  trap 'rm -rf "${tmp:-}"' EXIT
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  # backlog stub: seeded array from $STUB_ITEMS; claim/reopen append to $tmp/backlog.log + echo id.
  # `list --all` is the CEILING source (the claimed fold), `list --open` the dispatchable set —
  # two different questions, so the stub answers them separately. \$STUB_LIVE seeds the claimed
  # count; "x" makes the output UNPARSEABLE and \$STUB_LIST_ALL_RC makes the read FAIL — both are
  # the UNKNOWN path.
  cat > "$tmp/backlog" <<STUB
#!/bin/bash
case "\$1" in
  list)
    shift
    case "\$*" in
      *--all*)
        [ -n "\${STUB_LIST_ALL_RC:-}" ] && exit "\$STUB_LIST_ALL_RC"
        if [ "\${STUB_LIVE:-0}" = x ]; then echo 'not json at all'
        else jq -cn --argjson n "\${STUB_LIVE:-0}" '[range(\$n) | {id:"c\(.)", status:"claimed"}]'; fi ;;
      *)  cat "$tmp/items.json" ;;
    esac ;;
  claim) printf 'claim %s\n' "\$2" >> "$tmp/backlog.log"
         # The FULL argv on its own line, so the id-only line above keeps matching \`grep -qx 'claim i2'\`
         # verbatim while the flags become assertable (G6's --role, G5's --venue).
         printf 'claimargs %s\n' "\$*" >> "$tmp/backlog.log"; echo "\$2"
         # REFUSAL seam. \$STUB_CLAIM_RC is the exit code; \$STUB_CLAIM_VERDICT is the LINE-1 stderr
         # the dispatcher discriminates on, because rc 4 has two causes with opposite journalling
         # (done-latch ⇒ skip, lease ⇒ failed). Emitted in the real verb's shape — verdict token
         # first, prose after — so the cases exercise the parse and not just the rc. The attempt is
         # logged either way, so a case can tell "tried and was refused" from "never asked".
         [ -n "\${STUB_CLAIM_VERDICT:-}" ] && \\
           printf 'cc-backlog claim: REFUSED %s — \$2 stub refusal\\n  second line, must not be read\\n' \\
             "\$STUB_CLAIM_VERDICT" >&2
         exit "\${STUB_CLAIM_RC:-0}" ;;
  # SELF-RELEASE seam. The real cc-backlog rejects an unknown arg with rc 2, and a cc-backlog older
  # than the flag is a REAL state (the bin resolves through a symlink into a checkout that lands on
  # its own schedule). A stub that swallowed every flag would grade the capable path only, and the
  # fallback — the branch that keeps a failed rollback from STRANDING the item as claimed — would
  # ship having never executed.
  #
  # A flagged reopen logs its OWN line shape and the bare one keeps the original verbatim, so the
  # two are distinguishable AND every pre-existing assertion on 'reopen <id>' keeps the exact
  # meaning it had. Appending the flags to the shared line instead would have silently weakened the
  # negative ones — 'not grep -qx "reopen i1"' would go true for a reopen that really happened
  # (memory: stale-assertion-becomes-an-inverted-guard).
  reopen)case "\$* " in
           *--self-release*) printf 'reopen-selfrel %s\n' "\$2" >> "$tmp/backlog.log"
                             exit "\${STUB_REOPEN_SELFREL_RC:-0}" ;;
         esac
         printf 'reopen %s\n' "\$2" >> "$tmp/backlog.log"; echo "\$2" ;;
  done)  printf 'done %s %s\n' "\$2" "\$4" >> "$tmp/backlog.log"; echo "\$2" ;;
esac
exit 0
STUB
  # wave-plan stub: rc from \$STUB_WP_RC; plan from \$tmp/plan.json; captures the --items wave to
  # \$tmp/wave.json so (j) can assert the dispatcher bounds it to MAX_SPAWN.
  cat > "$tmp/waveplan" <<STUB
#!/bin/bash
while [ "\$#" -gt 0 ]; do case "\$1" in --items) printf '%s' "\$2" > "$tmp/wave.json"; shift 2 ;; *) shift ;; esac; done
rc="\${STUB_WP_RC:-0}"
[ "\$rc" = 0 ] && cat "$tmp/plan.json"
exit "\$rc"
STUB
  # spawn stub: rc from \$STUB_SPAWN_RC; logs argv to \$tmp/spawn.log; diagnoses itself on stderr
  # (the fixture for case (d)'s failure-evidence assertion — a real handoff-fire does the same).
  cat > "$tmp/spawn" <<STUB
#!/bin/bash
printf '%s\n' "\$*" >> "$tmp/spawn.log"
echo "handoff-fire: no pane anchor resolved" >&2
exit "\${STUB_SPAWN_RC:-0}"
STUB
  chmod +x "$tmp/backlog" "$tmp/waveplan" "$tmp/spawn"

  # EVERY seam is pinned explicitly, including the ones whose defaults would already be right: a
  # selftest that inherits a caller's CC_DISPATCH_* (a bats suite exercising the same binary does
  # export them) silently grades a different configuration than the one it asserts about.
  export CC_DISPATCH_BACKLOG_BIN="$tmp/backlog" CC_DISPATCH_WAVEPLAN_BIN="$tmp/waveplan" \
         CC_DISPATCH_SPAWN_BIN="$tmp/spawn" CC_DISPATCH_PAGES_DIR="$tmp/pages" \
         CC_DISPATCH_IDL="$tmp/idl.jsonl" CC_DISPATCH_PROJECT="/repo/a" CC_DISPATCH_MAX_SPAWN=2 \
         CC_DISPATCH_SID="selftest"         CC_DISPATCH_LOCK_DIR="$tmp/dispatch.lock" CC_DISPATCH_CEILING=6 CC_DISPATCH_LANE=v2 \
         CC_DISPATCH_DECIDE_ONLY=off
  # the premise gate's helper is pinned to THIS checkout's copy, never resolved. Unpinned it would
  # fall through resolve_bin to ~/.claude/scripts/find-plan.sh — a symlink into the SHARED checkout —
  # so the suite would grade a different tree than the one it is testing, and would go green on a
  # predicate this branch never changed. Deliberately the REAL script, not a stub: the thing under
  # test is whether cc-dispatch and find-plan.sh agree about a status word.
  CC_DISPATCH_FINDPLAN_BIN="$(cd "$(dirname "$SELF")/../scripts" 2>/dev/null && pwd)/find-plan.sh"
  export CC_DISPATCH_PREMISE_GATE=on CC_DISPATCH_FINDPLAN_BIN
  seed_plandoc() { printf -- '---\nstatus: %s\nrow: 99\n---\n# fixture\n' "$2" > "$tmp/$1"; }
  unset STUB_WP_RC STUB_SPAWN_RC STUB_LIVE STUB_LIST_ALL_RC STUB_CLAIM_RC

  # wave.json is removed too: its ABSENCE is the observable for "made zero wave-plan calls", and a
  # leftover from the previous case would make that assertion vacuously false (or vacuously true).
  reset() { : > "$tmp/backlog.log"; : > "$tmp/spawn.log"; : > "$tmp/idl.jsonl"; rm -rf "$tmp/pages"; rm -f "$tmp/f1.txt" "$tmp/wave.json"; }
  ok()   { printf '  ok   %s\n' "$1"; pass=$((pass+1)); }
  bad()  { printf '  FAIL %s\n' "$1"; fail=$((fail+1)); }
  t()    { local m="$1"; shift; if "$@"; then ok "$m"; else bad "$m"; fi; }   # <label> <predicate-cmd...>
  not()  { ! "$@"; }                                                          # negate a predicate for t()
  last() { tail -1 "$tmp/idl.jsonl" | jq -r "$1" 2>/dev/null; }
  epoch1() { head -1 "$1" 2>/dev/null | grep -qE '^[0-9]+$'; }                # first line is an epoch
  seed_items() { printf '%s\n' "$1" > "$tmp/items.json"; }
  seed_plan()  { printf '%s\n' "$1" > "$tmp/plan.json"; }

  echo "cc-dispatch selftest — every branch must RED-prove:"

  # (a) empty backlog → passed, no spawn.
  reset; seed_items '[]'; seed_plan '[]'
  "$SELF" --once >/dev/null 2>&1
  t "(a) empty backlog → passed"            grep -q '"action":"passed"' "$tmp/idl.jsonl"
  t "(a) empty backlog → ZERO spawn"        test ! -s "$tmp/spawn.log"

  # (k) blocked-on-operator item → filtered out (dispatch keeps ONLY status=="open") → passed,
  # ZERO spawn. THE anti-loop guard: an operator-gated item that `block`ed itself must NOT be
  # re-dispatched (the whole point of the blocked status). RED-proves the step-1 filter.
  reset; seed_items '[{"id":"i1","project":"a","status":"blocked","title":"t1","needs":"operator: run claude-kimi set-key"}]'; seed_plan '[]'
  "$SELF" --once >/dev/null 2>&1
  t "(k) blocked item → NOT dispatched (passed)" grep -q '"action":"passed"' "$tmp/idl.jsonl"
  t "(k) blocked item → ZERO spawn (no loop)"    test ! -s "$tmp/spawn.log"

  # (l) DONE-GUARD: an item carrying the ledger's done latch (`wasDone`) is NOT dispatched even
  # though it folds to status "open" — it is skipped, recorded WITH its prior evidence, and never
  # claimed. THE anti-waste guard: without it a reopen of completed work burns a whole worker
  # session re-doing what already landed (incident 2026-07-20, a60d62a215f1 → 6488617).
  # the plan is seeded with a LIVE placement for i1 — what a planner handed [i1] would return — so
  # this RED-proves the step-1b filter: drop it and i1 reaches the planner and spawns.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","wasDone":true,"title":"t1","evidence":"6488617 fix(x)"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --once >/dev/null 2>&1
  t "(l) done-latched item → ZERO spawn (no burned session)"  test ! -s "$tmp/spawn.log"
  t "(l) done-latched item → NOT claimed"                     test ! -s "$tmp/backlog.log"
  t "(l) done-latched item → IDL skipped (never a silent fence)" grep -q '"action":"skipped"' "$tmp/idl.jsonl"
  t "(l) skip record carries the prior evidence"              grep -q '6488617' "$tmp/idl.jsonl"
  t "(l) skip record names the --force override"              grep -q 'reopen i1 --force' "$tmp/idl.jsonl"
  t "(l) summary counts the skip"                             test "$(last '.skipped')" = 1

  # (m) the guard is PER-ITEM, not a whole-wave abort: a done-latched item beside a fresh one
  # must not suppress the fresh one.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","wasDone":true,"title":"t1"},{"id":"i2","project":"a","status":"open","title":"t2"}]'
  seed_plan '[{"id":"i2","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --once >/dev/null 2>&1
  # wave.json — what reached the PLANNER — is the discriminating observable, and the reason is worth
  # recording: claims and spawns are driven by the seeded plan, and the stub returns that plan
  # whatever wave it is handed. So the three assertions below that read backlog.log/spawn.log ALL
  # pass with the wasDone predicate stripped out (measured 2026-07-31 by rewriting it to
  # `select(true)`: (l) went 6-RED as it should, (m) stayed fully green). They were vacuous — the
  # fixture never placed i1, so "i1 was not claimed" was true before the guard existed. (l) proves
  # the guard fires for a LONE item; only this pair proves the PER-ITEM claim (m) is actually about.
  t "(m) mixed wave → the un-done item reaches the planner"  grep -q '"i2"' "$tmp/wave.json"
  t "(m) mixed wave → the done-latched item does NOT"        not grep -q '"i1"' "$tmp/wave.json"
  t "(m) mixed wave → the un-done item IS claimed"     grep -qx 'claim i2' "$tmp/backlog.log"
  t "(m) mixed wave → the done-latched item is NOT claimed" not grep -qx 'claim i1' "$tmp/backlog.log"
  # (m4) G6 — THE CLAIM IS LABELLED A DISPATCHER CLAIM. Without this flag on the wire, cc-backlog's
  # `reclaim` cannot tell this pass's still-live pid from a competing peer worker, refuses the
  # hand-over, and the worker this pass is about to spawn is denied on its own first write as a
  # duplicate of its own dispatcher (measured 2026-08-09, item b922dde5567b). The flag going missing
  # is SILENT — every claim still succeeds, dispatch still fires, and only the worker deadlocks — so
  # it has to be asserted on the wire rather than inferred from the pass succeeding.
  t "(m4) the claim is labelled --role dispatcher (else reclaim cannot tell hand-over from steal)" \
    grep -q '^claimargs claim i2 .*--role dispatcher' "$tmp/backlog.log"
  t "(m) mixed wave → exactly 1 spawn"                 test "$(grep -c . "$tmp/spawn.log")" -eq 1

  # (m2) THE ACTUATOR IS THE ARBITER (backlog dadc3c2410aa). The item is clean at step 1b — no
  # `wasDone` in the snapshot — so it passes the pull-time filter, reaches the planner and gets a
  # placement. It lands DURING the admission tail, which the pull cannot see, and `cc-backlog claim`
  # refuses it with rc 4. This is the ONE fixture the step-1b filter cannot produce: (l) and (m)
  # both seed `wasDone:true` and never reach the claim at all, so neither says anything about what
  # the dispatcher does with a refusal. Discriminating observable = the VERDICT: skipped, never
  # failed, and no spawn. RED-proof: delete the rc-4 done-latch branch and the `crc -ne 0` arm takes
  # it → failed:1 / skipped:0.
  reset; unset STUB_CLAIM_RC STUB_CLAIM_VERDICT
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  STUB_CLAIM_RC=4 STUB_CLAIM_VERDICT=verdict=done-latched "$SELF" --once >/dev/null 2>&1
  t "(m2) claim REFUSED done-latched → ZERO spawn (no burned session)" test ! -s "$tmp/spawn.log"
  t "(m2) claim REFUSED done-latched → the claim WAS attempted"        grep -qx 'claim i1' "$tmp/backlog.log"
  t "(m2) claim REFUSED done-latched → counted SKIPPED, not failed"    test "$(last '.skipped')" = 1
  t "(m2) claim REFUSED done-latched → failed stays 0"                 test "$(last '.failed')" = 0
  t "(m2) claim REFUSED done-latched → IDL skipped names the override" grep -q 'reopen i1 --force' "$tmp/idl.jsonl"
  t "(m2) claim REFUSED done-latched → and carries the refusal's own line 1" \
      grep -q 'verdict=done-latched' "$tmp/idl.jsonl"
  # BOTH reopen shapes, deliberately. Since the rollback learned --self-release there are two ways to
  # reopen, and an assertion naming only the bare one would go green for a rollback that really
  # happened — the negative test quietly retired by a change elsewhere in the same file.
  t "(m2) claim REFUSED done-latched → NO rollback reopen (nothing was appended to roll back)" \
      not grep -qE '^reopen(-selfrel)? i1$' "$tmp/backlog.log"

  # (m2b) THE DISCRIMINATOR, not the rc. rc 4 has TWO causes and they journal OPPOSITELY: a LEASE
  # refusal (another live worker holds the item) keeps its landed FAILED classification, because
  # that must stay distinguishable from a broken ledger. Same exit code as (m2), different line 1 —
  # so this pair is what proves the branch reads the VERDICT and not merely `crc -eq 4`. Without it,
  # rewriting the condition to a bare `[ "$crc" -eq 4 ]` would stay fully green while silently
  # reclassifying every lease refusal on the box.
  reset; unset STUB_CLAIM_RC STUB_CLAIM_VERDICT
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  STUB_CLAIM_RC=4 STUB_CLAIM_VERDICT="— i1 is already claimed by peer-9, which is LIVE" \
    "$SELF" --once >/dev/null 2>&1
  t "(m2b) LEASE refusal (same rc 4) → still FAILED, not skipped" test "$(last '.failed')" = 1
  t "(m2b) LEASE refusal → skipped stays 0"                       test "$(last '.skipped')" = 0
  t "(m2b) LEASE refusal → the record names rc + the excerpt"     grep -q 'claim rc=4 — .*already claimed by peer-9' "$tmp/idl.jsonl"
  t "(m2b) LEASE refusal → ZERO spawn"                            test ! -s "$tmp/spawn.log"

  # (m2c) THE FOURTH rc-4 CAUSE — cloud-ineligible (bin/cc-backlog translating cc-eligible's rc 3).
  # Same actuator-arbiter shape as (m2): refused for THIS VENUE ONLY must journal as a SKIP, never
  # the lease's FAILED. Paired with (m2b) above, which keeps a real lease refusal on the FAILED
  # path, this is what stops the new arm being widened to a bare `[ "$crc" -eq 4 ]`.
  reset; unset STUB_CLAIM_RC STUB_CLAIM_VERDICT
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  STUB_CLAIM_RC=4 STUB_CLAIM_VERDICT="verdict=cloud-ineligible — i1 cannot run off-box" \
    "$SELF" --once >/dev/null 2>&1
  t "(m2c) cloud-ineligible → ZERO spawn (no burned session)"   test ! -s "$tmp/spawn.log"
  t "(m2c) cloud-ineligible → the claim WAS attempted"          grep -qx 'claim i1' "$tmp/backlog.log"
  t "(m2c) cloud-ineligible → counted SKIPPED, not failed"      test "$(last '.skipped')" = 1
  t "(m2c) cloud-ineligible → failed stays 0"                   test "$(last '.failed')" = 0
  t "(m2c) cloud-ineligible → IDL skipped carries the verdict"  grep -q 'verdict=cloud-ineligible' "$tmp/idl.jsonl"
  t "(m2c) cloud-ineligible → names the LOCAL claim as the cure" grep -q 'claims LOCALLY untouched' "$tmp/idl.jsonl"

  # (m3) …and the new branch did not swallow ORDINARY claim failures: any non-4 rc is still a
  # FAILURE, with the rc named in the record (§1(c)/R3 — a verdict must name its cause).
  reset; unset STUB_CLAIM_RC STUB_CLAIM_VERDICT
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  STUB_CLAIM_RC=1 "$SELF" --once >/dev/null 2>&1
  t "(m3) claim rc 1 → still FAILED, not skipped"  test "$(last '.failed')" = 1
  t "(m3) claim rc 1 → skipped stays 0"            test "$(last '.skipped')" = 0
  t "(m3) claim rc 1 → the record names the rc"    grep -q 'claim rc=1' "$tmp/idl.jsonl"
  unset STUB_CLAIM_RC STUB_CLAIM_VERDICT

  # (v) STALE-PREMISE GUARD. A `plan-open` item is a SNAPSHOT of "this plan was open at discovery";
  # when the plan lands, nothing re-reads it and the wave burns a worker re-deriving finished work
  # (live 2026-07-31: item 4d5f09d7716c, emitted 92 min before its plan flipped `complete`).
  # RED-proves the 1d filter: drop the guard and v1's item reaches the planner and spawns.
  reset; seed_plandoc p_done.md complete
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1","source":"plan-open","dodRef":"'"$tmp"'/p_done.md"}]'
  seed_plan  '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --once >/dev/null 2>&1
  t "(v1) plan-open item, plan complete → ZERO spawn"      test ! -s "$tmp/spawn.log"
  t "(v1) …→ NOT claimed"                                  not grep -qx 'claim i1' "$tmp/backlog.log"
  t "(v1) …→ RETRACTED via cc-backlog done"                grep -q '^done i1 ' "$tmp/backlog.log"
  t "(v1) …→ evidence says PREMISE, not 'verified'"        grep -q 'premise-retracted' "$tmp/backlog.log"
  t "(v1) …→ IDL skipped (never a silent fence)"           grep -q '"action":"skipped"' "$tmp/idl.jsonl"
  t "(v1) …→ decision reason is plan-premise-stale"        grep -q 'plan-premise-stale' "$tmp/idl.jsonl"

  # (p2) THE POSITIVE CONTROL for every absence assertion in (v1): the SAME fixture, the SAME
  # source, only the plan's status word differs. Without this pair a gate that fired on EVERY
  # plan-open item — or a broken stub that spawned nothing at all — would satisfy v1 vacuously.
  reset; seed_plandoc p_open.md in-progress
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1","source":"plan-open","dodRef":"'"$tmp"'/p_open.md"}]'
  seed_plan  '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --once >/dev/null 2>&1
  t "(v2) plan still in-progress → IS claimed"             grep -qx 'claim i1' "$tmp/backlog.log"
  t "(v2) …→ DOES spawn"                                   test -s "$tmp/spawn.log"
  t "(v2) …→ NOT retracted"                                not grep -q '^done i1 ' "$tmp/backlog.log"

  # (p3) SCOPE control — the one that matters most. A terminal dodRef falsifies ONLY an item whose
  # premise WAS "the plan is open". A human/verify-filed item may legitimately cite a finished plan
  # as its DoD: live scan found 791345455b58, a real 358-site pipefail defect, doing exactly that.
  # Keying the guard on the plan status alone would silently close it.
  reset; seed_plandoc p_done.md complete
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1","source":"relogin-verify-e67b8e6278f2","dodRef":"'"$tmp"'/p_done.md"}]'
  seed_plan  '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --once >/dev/null 2>&1
  t "(v3) NON-plan-open item citing a complete plan → IS claimed" grep -qx 'claim i1' "$tmp/backlog.log"
  t "(v3) …→ NEVER retracted"                                     not grep -q '^done i1 ' "$tmp/backlog.log"

  # (p4) FAIL-OPEN. The premise lives in a FILE, so every way of failing to read it must dispatch
  # anyway — starving the queue on a sensor failure is the worse error (I6). Most live dodRefs are
  # code refs ("hooks/notify.sh#L35"), not plan paths, and must not be read as "finished".
  reset
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1","source":"plan-open","dodRef":"hooks/notify.sh#L35"},{"id":"i2","project":"a","status":"open","title":"t2","source":"plan-open","dodRef":"'"$tmp"'/absent.md"}]'
  seed_plan  '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --once >/dev/null 2>&1
  t "(v4) dodRef is a code ref, not a path → fail OPEN, claimed" grep -qx 'claim i1' "$tmp/backlog.log"
  t "(v4) dodRef file absent → fail OPEN, never retracted"       not grep -q '^done i2 ' "$tmp/backlog.log"

  # (p5) KILL SWITCH (I8 — every mechanism ships one; never revert-as-plan).
  reset; seed_plandoc p_done.md complete
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1","source":"plan-open","dodRef":"'"$tmp"'/p_done.md"}]'
  seed_plan  '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  CC_DISPATCH_PREMISE_GATE=off "$SELF" --once >/dev/null 2>&1
  t "(v5) gate=off → incumbent wave restored (claimed)"    grep -qx 'claim i1' "$tmp/backlog.log"
  t "(v5) gate=off → no retraction"                        not grep -q '^done i1 ' "$tmp/backlog.log"

  # (p6) PER-ITEM, not a whole-wave abort — the same property (m) asserts for the done-guard.
  reset; seed_plandoc p_done.md complete
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1","source":"plan-open","dodRef":"'"$tmp"'/p_done.md"},{"id":"i2","project":"a","status":"open","title":"t2"}]'
  seed_plan  '[{"id":"i2","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --once >/dev/null 2>&1
  # asserted on wave.json — WHAT REACHED THE PLANNER — not on claim/spawn. Claims and spawns are
  # driven by the seeded plan, and the stub returns that plan whatever wave it is handed, so a
  # "the stale item was not claimed" assertion passes with the guard REMOVED (verified: it did) —
  # vacuous, because the fixture never placed i1 in the first place. wave.json is the only
  # observable here that a guardless build actually changes.
  t "(v6) mixed wave → the fresh item reaches the planner"  grep -q '"i2"' "$tmp/wave.json"
  t "(v6) mixed wave → the stale-premise item does NOT"     not grep -q '"i1"' "$tmp/wave.json"
  t "(v6) mixed wave → the fresh item IS claimed"           grep -qx 'claim i2' "$tmp/backlog.log"
  t "(v6) mixed wave → exactly 1 spawn"                     test "$(grep -c . "$tmp/spawn.log")" -eq 1

  # (b) quota-cliff (wave-plan exit 4) → abstained + page + ZERO spawn.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  STUB_WP_RC=4 "$SELF" --once >/dev/null 2>&1
  t "(b) cliff → abstained IDL"             grep -q '"action":"abstained"' "$tmp/idl.jsonl"
  t "(b) cliff → summary is the last record" test "$(last '.action')" = summary
  t "(b) cliff → page file written"         test -f "$tmp/pages/cc-dispatch-quota-cliff.page"
  t "(b) page line1 is an epoch (drain-compatible)" epoch1 "$tmp/pages/cc-dispatch-quota-cliff.page"
  t "(b) cliff → ZERO spawn (never fire blind)" test ! -s "$tmp/spawn.log"

  # (c) green → claim invoked + spawn invoked with the fire_line + IDL fired.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt","--account","next3"]}]'
  "$SELF" --once >/dev/null 2>&1
  t "(c) green → item claimed (transition invoked)" grep -qx 'claim i1' "$tmp/backlog.log"
  t "(c) green → spawn got the fire_line argv" grep -q -- "--prompt-file $tmp/f1.txt --account next3" "$tmp/spawn.log"
  t "(c) green → IDL fired"                 grep -q '"action":"fired"' "$tmp/idl.jsonl"
  t "(c) summary fired=1"                   test "$(last '.fired')" = 1
  t "(c) brief composed at the fire_line path (id + title)" grep -q 'cc-backlog item i1' "$tmp/f1.txt"
  t "(c) brief names the ITEM's project, not the pass's" grep -q 'project a,' "$tmp/f1.txt"
  # The rails line is READ FROM THE PROJECT since multi-project coverage, so this fixture (project
  # "a", which resolves to a repo that does not exist and therefore has no .claude/commands/ship.md)
  # must get the DEGRADED variant. Asserting the unconditional '/ship' here would have re-encoded the
  # bug the rails change fixes: doc_classifier has no ship rail and holds the oldest items in the
  # ledger, so it is the FIRST thing dispatched. Both branches are asserted — (c6) is the positive
  # control that proves this harness can still observe a real ship rail when one exists.
  t "(c) no ship.md in the project → brief does NOT promise /ship" \
    bash -c "! grep -q 'project-local /ship' '$tmp/f1.txt'"
  t "(c) no ship.md in the project → brief says so and forbids landing" \
    grep -q 'NO /ship rail' "$tmp/f1.txt"

  # (c6) POSITIVE CONTROL for the rails branch: a project whose repo DOES carry .claude/commands/ship.md
  reset; mkdir -p "$tmp/repo-b/.claude/commands"; : > "$tmp/repo-b/.claude/commands/ship.md"
  printf 'b  repo=%s\n' "$tmp/repo-b" > "$tmp/projects.conf"
  seed_items '[{"id":"i9","project":"b","status":"open","title":"t9"}]'
  seed_plan '[{"id":"i9","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f9.txt","--account","next3"]}]'
  rm -f "$tmp/f9.txt"
  CC_DISPATCH_PROJECTS_CONF="$tmp/projects.conf" "$SELF" --once >/dev/null 2>&1
  t "(c6) a conf-declared foreign project IS dispatched (one loop, not one project)" \
    grep -qx 'claim i9' "$tmp/backlog.log"
  t "(c6) its repo HAS ship.md → the brief DOES promise the project-local /ship" \
    grep -q 'project-local /ship' "$tmp/f9.txt"
  t "(c6) and the brief names that project + its resolved repo" \
    grep -q "project b, repo $tmp/repo-b" "$tmp/f9.txt"
  rm -f "$tmp/f9.txt"

  # (c2) STRING fire_line (the real wave-plan shape, program-prefixed) → split argv, program
  # token dropped, brief still composed.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan "[{\"id\":\"i1\",\"account\":\"next3\",\"fire_line\":\"~/.claude/scripts/handoff-fire.sh --prompt-file $tmp/f1.txt --account next3\"}]"
  "$SELF" --once >/dev/null 2>&1
  t "(c2) string fire_line → spawn got SPLIT argv (no program token)" grep -q -- "^--prompt-file $tmp/f1.txt --account next3$" "$tmp/spawn.log"
  t "(c2) string fire_line → brief composed" grep -q 'cc-backlog item i1' "$tmp/f1.txt"

  # (c3) b87573077f11 — a fire_line carrying `--cwd <wt>` gets that worktree provisioned WARM by
  # THIS actuator before the spawn. wave-plan only emits the path (pure planner), so if nothing
  # created it the fired pane would `cd` into a non-existent dir. Warm, not cold: the pane must only
  # cd+launch, never install at boot (that is the keystroke race this whole fix avoids).
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  wtrepo="$tmp/wtrepo"; rm -rf "$wtrepo" "$tmp/wt-i1"
  ( mkdir -p "$wtrepo" && cd "$wtrepo" && git init -q . && git config user.email t@t && git config user.name t \
    && echo x > f && git add f && git commit -qm init && git branch -f origin/main HEAD ) >/dev/null 2>&1
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt","--cwd","'"$tmp"'/wt-i1"]}]'
  CC_DISPATCH_REPO="$wtrepo" CC_DISPATCH_WT_BASE=origin/main "$SELF" --once >/dev/null 2>&1
  t "(c3) --cwd worktree is CREATED before the fire"    test -d "$tmp/wt-i1"
  t "(c3) it is a real git worktree (own checkout)"     test -e "$tmp/wt-i1/.git"
  t "(c3) it is on its OWN branch (no shared index)" \
    bash -c "[ \"\$(git -C '$tmp/wt-i1' rev-parse --abbrev-ref HEAD)\" = wt-i1 ]"
  t "(c3) the spawn still received the --cwd argv"      grep -q -- "--cwd $tmp/wt-i1" "$tmp/spawn.log"
  t "(c3) spawn happened (provisioning did not swallow the fire)" test -s "$tmp/spawn.log"
  t "(c3) IDL fired"                                    grep -q '"action":"fired"' "$tmp/idl.jsonl"

  # (c4) provisioning FAILURE must reopen the claim and fire NOTHING — never a spawn into a dir
  # that does not exist (the shape that burns a worker slot silently).
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt","--cwd","'"$tmp"'/wt-nope"]}]'
  CC_DISPATCH_REPO="$tmp/not-a-repo" "$SELF" --once >/dev/null 2>&1
  t "(c4) unprovisionable worktree → ZERO spawn"  test ! -s "$tmp/spawn.log"
  t "(c4) unprovisionable worktree → reopened"    grep -qx 'reopen-selfrel i1' "$tmp/backlog.log"
  t "(c4) unprovisionable worktree → IDL failed"  grep -q '"action":"failed"' "$tmp/idl.jsonl"

  # (c5) an EXISTING --cwd is reused as-is (idempotent re-dispatch, no clobber of live work).
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  mkdir -p "$tmp/wt-live" && echo sentinel > "$tmp/wt-live/keep"
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt","--cwd","'"$tmp"'/wt-live"]}]'
  CC_DISPATCH_REPO="$tmp/not-a-repo" "$SELF" --once >/dev/null 2>&1
  t "(c5) existing worktree → untouched" test -f "$tmp/wt-live/keep"
  t "(c5) existing worktree → still spawns" test -s "$tmp/spawn.log"

  # (d) spawn non-zero → item reopened + IDL failed.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  STUB_SPAWN_RC=7 "$SELF" --once >/dev/null 2>&1
  t "(d) spawn-fail → item reopened"        grep -qx 'reopen-selfrel i1' "$tmp/backlog.log"
  t "(d) spawn-fail → and the BARE reopen was not needed" not grep -qx 'reopen i1' "$tmp/backlog.log"
  t "(d) spawn-fail → IDL failed"           grep -q '"action":"failed"' "$tmp/idl.jsonl"
  # The verdict must NAME ITS CAUSE (§1(c)/R3): rc + the fire's own stderr, with the id-colon
  # prefix intact so thrash_map's split(":") still recovers the id for S7 ordering.
  # …and it must name the rollback as a SELF-RELEASE. Without that word the journal reads identically
  # before and after the rule-B fix, so nothing in it could confirm the pair was excluded from the
  # thrash count — the inert-mechanism-is-invisible failure this file guards against everywhere else.
  t "(d) spawn-fail → the record names the rc"        grep -q '"detail":"i1: spawn rc=7 (reopened, self-release)' "$tmp/idl.jsonl"
  t "(d) spawn-fail → and carries the fire's own why" grep -q 'no pane anchor resolved' "$tmp/idl.jsonl"

  # (d2) THE FALLBACK, and it is not hypothetical: cc-backlog resolves through a symlink into a
  # checkout that lands on its own schedule, so a binary predating the flag rejects it with rc 2.
  # Two things must hold together, and only one of them is obvious. The claim must STILL be released
  # — stranding it `claimed` until reap ages it out is strictly worse than the bug the flag fixes —
  # and the journal must then NOT say "self-release", because none was recorded. A marker printed
  # unconditionally would describe the attempt instead of the outcome (memory:
  # claimed-outcome-vs-checked-outcome), and that is exactly the un-evidenced verdict (d) exists for.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  STUB_SPAWN_RC=7 STUB_REOPEN_SELFREL_RC=2 "$SELF" --once >/dev/null 2>&1
  t "(d2) flag REFUSED → the flag WAS attempted"       grep -qx 'reopen-selfrel i1' "$tmp/backlog.log"
  t "(d2) flag REFUSED → the claim is still released"  grep -qx 'reopen i1' "$tmp/backlog.log"
  t "(d2) flag REFUSED → the journal does NOT claim one" \
      test "$(grep -c 'self-release' "$tmp/idl.jsonl")" -eq 0
  t "(d2) flag REFUSED → the failure is still journalled with its rc" \
      grep -q '"detail":"i1: spawn rc=7 (reopened)' "$tmp/idl.jsonl"

  # (e) --dry-run → plan printed, backlog UNCHANGED, spawn NOT called, no page.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"next3","fire_line":["--prompt-file","'"$tmp"'/f1.txt"]}]'
  "$SELF" --dry-run > "$tmp/dry.out" 2>/dev/null
  t "(e) --dry-run prints the plan"         grep -q 'PLAN:' "$tmp/dry.out"
  t "(e) --dry-run → backlog UNCHANGED"     test ! -s "$tmp/backlog.log"
  t "(e) --dry-run → spawn NOT called"      test ! -s "$tmp/spawn.log"

  # (f) MAX_SPAWN cap → only N spawns even with more placements.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"},{"id":"i2","project":"a","status":"open","title":"t2"},{"id":"i3","project":"a","status":"open","title":"t3"}]'
  seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]},{"id":"i2","account":"a","fire_line":["--x"]},{"id":"i3","account":"a","fire_line":["--x"]}]'
  CC_DISPATCH_MAX_SPAWN=2 "$SELF" --once >/dev/null 2>&1
  t "(f) MAX_SPAWN=2 caps spawns at 2"      test "$(grep -c . "$tmp/spawn.log")" -eq 2

  # (j) WAVE BOUNDING (regression: false quota-cliff on an oversized backlog). A backlog LARGER
  # than the admission bound must still reach wave-plan as a wave sliced TO that bound — else
  # wave-plan's total-concurrency guard (exit 4, never a partial) makes dispatch abstain and strand
  # everything though headroom exists. V2 keeps the invariant and moves the bound from the per-pass
  # constant to CAPACITY (free_slots = CEILING - live): with ceiling 2 and 0 live, a 5-item backlog
  # plans exactly 2. RED-proves the admit-set slice at step 3.
  reset; rm -f "$tmp/wave.json"
  seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"},{"id":"i2","project":"a","status":"open","title":"t2"},{"id":"i3","project":"a","status":"open","title":"t3"},{"id":"i4","project":"a","status":"open","title":"t4"},{"id":"i5","project":"a","status":"open","title":"t5"}]'
  seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]},{"id":"i2","account":"a","fire_line":["--x"]}]'
  CC_DISPATCH_CEILING=2 CC_DISPATCH_MAX_SPAWN=2 "$SELF" --once >/dev/null 2>&1
  t "(j) backlog=5 → wave sliced to the admission bound (2)" test "$(jq 'length' "$tmp/wave.json" 2>/dev/null)" -eq 2
  t "(j) wave keeps the FIRST items (i1 first)"  test "$(jq -r '.[0].id' "$tmp/wave.json" 2>/dev/null)" = i1
  t "(j) the 3 surplus items are DEFERRED, not stranded silently" \
    test "$(grep -c '"verdict":"defer"' "$tmp/idl.jsonl")" -eq 3
  t "(j) surplus defers say capacity (slots existed), NOT at-ceiling" grep -q '"reason":"capacity"' "$tmp/idl.jsonl"
  t "(j) NOT an abstention — the surplus never touches the cliff path" \
    not grep -q '"action":"abstained"' "$tmp/idl.jsonl"

  # (j2) LANE v1 — the whole-rebuild kill switch reproduces the INCUMBENT path verbatim: the raw
  # MAX_SPAWN slice, no ceiling term, and no decision journal at all.
  reset; rm -f "$tmp/wave.json"
  CC_DISPATCH_LANE=v1 CC_DISPATCH_CEILING=0 CC_DISPATCH_MAX_SPAWN=2 "$SELF" --once >/dev/null 2>&1
  t "(j2) lane v1 → wave is the MAX_SPAWN slice (ceiling ignored)" test "$(jq 'length' "$tmp/wave.json" 2>/dev/null)" -eq 2
  t "(j2) lane v1 → ZERO decision records"      not grep -q '"action":"decision"' "$tmp/idl.jsonl"
  t "(j2) lane v1 → still fires (ceiling=0 cannot suppress it)" test -s "$tmp/spawn.log"

  # (g) config-fail: unresolvable backlog bin → exit 3 LOUD.
  CC_DISPATCH_BACKLOG_BIN="/nonexistent/nope" "$SELF" --once >/dev/null 2>&1; rc=$?
  t "(g) unresolvable actuator → exit 3"    test "$rc" -eq 3

  # (h) flag combos: `--once --dry-run` is DRY (no spawn, no IDL) — never a silent live pass.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]}]'
  "$SELF" --once --dry-run >/dev/null 2>&1
  t "(h) --once --dry-run → ZERO spawn"     test ! -s "$tmp/spawn.log"
  t "(h) --once --dry-run → ZERO IDL"       test ! -s "$tmp/idl.jsonl"
  # (i) PROJECT normalization: a path-style CC_DISPATCH_PROJECT matches basename-keyed items.
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"}]'
  seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]}]'
  CC_DISPATCH_PROJECT="/some/path/to/a" "$SELF" --once >/dev/null 2>&1
  t "(i) path-style project env → still dispatches (basename-normalized)" test -s "$tmp/spawn.log"

  # ── V2 — the decision/admission split (§3 S1,S2,S6,S7) ──────────────────────────────────────────
  local items3 items12
  items3='[{"id":"i1","project":"a","status":"open","title":"t1"},{"id":"i2","project":"a","status":"open","title":"t2"},{"id":"i3","project":"a","status":"open","title":"t3"}]'
  items12="$(jq -cn '[range(1;13) | {id:("i"+(tostring)), project:"a", status:"open", title:"t"}]')"

  # (n) CEILING=0 — admit NOTHING, yet still decide EVERYTHING. The pure-observation kill switch and
  # the shape of the at-ceiling path: zero wave-plan calls, zero claims, zero spawns, zero pages.
  reset; seed_items "$items3"; seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]}]'
  CC_DISPATCH_CEILING=0 "$SELF" --once >/dev/null 2>&1
  t "(n) ceiling=0 → a decision for EVERY item (3)"   test "$(grep -c '"action":"decision"' "$tmp/idl.jsonl")" -eq 3
  t "(n) ceiling=0 → every verdict is defer"          test "$(grep -c '"verdict":"defer"' "$tmp/idl.jsonl")" -eq 3
  t "(n) ceiling=0 → reason is at-ceiling"            test "$(grep -c '"reason":"at-ceiling"' "$tmp/idl.jsonl")" -eq 3
  t "(n) ceiling=0 → ZERO admit"                      not grep -q '"verdict":"admit"' "$tmp/idl.jsonl"
  t "(n) ceiling=0 → ZERO wave-plan calls"            test ! -f "$tmp/wave.json"
  t "(n) ceiling=0 → ZERO claims"                     test ! -s "$tmp/backlog.log"
  t "(n) ceiling=0 → ZERO spawns"                     test ! -s "$tmp/spawn.log"
  t "(n) ceiling=0 → ZERO pages (a full queue is NOT a cliff)" test ! -d "$tmp/pages"
  t "(n) ceiling=0 → NOT an abstention"               not grep -q '"action":"abstained"' "$tmp/idl.jsonl"
  t "(n) summary counts the deferrals"                test "$(last '.deferred')" = 3

  # (n2) POSITIVE CONTROL for every absence assertion in (n): the SAME harness, SAME fixture, only
  # the ceiling reversed — so "no wave-plan call / no spawn / no page dir" above is a real
  # observation and not a harness that cannot see those effects at all.
  reset; CC_DISPATCH_CEILING=3 "$SELF" --once >/dev/null 2>&1
  t "(n2) control: ceiling=3 → the wave-plan IS called (harness can see it)" test -f "$tmp/wave.json"
  t "(n2) control: ceiling=3 → a spawn IS observed"    test -s "$tmp/spawn.log"
  t "(n2) control: ceiling=3 → a claim IS observed"    grep -q '^claim ' "$tmp/backlog.log"
  t "(n2) control: ceiling=3 → 3 admits, 0 defers"     test "$(grep -c '"verdict":"admit"' "$tmp/idl.jsonl")" -eq 3

  # (o) A1's discriminating fixture — 12 items, ceiling 3: EVERY item is decided in ONE pass (the
  # whole point of S1: decision latency is the cadence, not ⌈P/2⌉ ticks), 3 admitted and 9 deferred
  # with their queue positions, all under a single pass id a consumer can group_by.
  reset; seed_items "$items12"
  seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]},{"id":"i2","account":"a","fire_line":["--x"]},{"id":"i3","account":"a","fire_line":["--x"]}]'
  CC_DISPATCH_CEILING=3 "$SELF" --once >/dev/null 2>&1
  t "(o) 12 items → 12 decision records in ONE pass" \
    test "$(jq -rs '[.[]|select(.action=="decision")]|length' "$tmp/idl.jsonl")" -eq 12
  t "(o) exactly 3 admit"  test "$(grep -c '"verdict":"admit"' "$tmp/idl.jsonl")" -eq 3
  t "(o) exactly 9 defer"  test "$(grep -c '"verdict":"defer"' "$tmp/idl.jsonl")" -eq 9
  t "(o) the deferrals carry queue positions 4..12" \
    test "$(jq -rs '[.[]|select(.verdict=="defer")|.position]|sort|@csv' "$tmp/idl.jsonl")" = '4,5,6,7,8,9,10,11,12'
  t "(o) one pass id for the whole pass (group_by(.pass) == 1)" \
    test "$(jq -rs '[.[]|select(.action=="decision")|.pass]|unique|length' "$tmp/idl.jsonl")" -eq 1
  t "(o) every decision names its item id (no unattributed verdict)" \
    test "$(jq -rs '[.[]|select(.action=="decision" and ((.id//"")==""))]|length' "$tmp/idl.jsonl")" -eq 0

  # (p) the LIVE count is what consumes the ceiling — not a constant. 6 live against ceiling 6 ⇒ zero
  # free slots ⇒ the fleet cap holds without any quota call, which is how exhaustion becomes
  # unreachable (the measured 50-fires-then-12-cliffs curve cannot happen).
  reset; seed_items "$items3"
  STUB_LIVE=6 CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(p) live=6 vs ceiling=6 → all defer at-ceiling"  test "$(grep -c '"reason":"at-ceiling"' "$tmp/idl.jsonl")" -eq 3
  t "(p) live=6 vs ceiling=6 → ZERO spawn"            test ! -s "$tmp/spawn.log"
  t "(p) the record carries the live count it decided on" grep -q '"live_workers":6' "$tmp/idl.jsonl"
  reset; STUB_LIVE=5 CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(p2) control: live=5 vs ceiling=6 → exactly 1 admit" test "$(grep -c '"verdict":"admit"' "$tmp/idl.jsonl")" -eq 1
  t "(p2) control: live=5 → it DOES fire"             test -s "$tmp/spawn.log"

  # (q) UNKNOWN ≠ 0 and ≠ cliff. An unparseable oracle must admit AT MOST ONE — never zero (a dead
  # oracle would stall the queue forever) and never the full ceiling (a blind fire) — and must NOT
  # page: reporting an unknown as a quota cliff is exactly failure mode F4.
  reset; STUB_LIVE=x CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(q) unparseable oracle → exactly 1 admit"        test "$(grep -c '"verdict":"admit"' "$tmp/idl.jsonl")" -eq 1
  t "(q) unparseable oracle → named live-count-unknown" grep -q '"reason":"live-count-unknown"' "$tmp/idl.jsonl"
  t "(q) unknown is recorded as null, never as 0"     grep -q '"live_workers":null' "$tmp/idl.jsonl"
  t "(q) unknown → NO page written"                   test ! -d "$tmp/pages"
  t "(q) unknown → NOT an abstention"                 not grep -q '"action":"abstained"' "$tmp/idl.jsonl"
  reset; STUB_LIST_ALL_RC=7 CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(q2) unreadable ledger → the SAME unknown path" grep -q '"reason":"live-count-unknown"' "$tmp/idl.jsonl"
  t "(q2) unreadable ledger → still admits 1 (never 0-forever)" test "$(grep -c '"verdict":"admit"' "$tmp/idl.jsonl")" -eq 1

  # (r) DECIDE-ONLY — the safe activation lane: the journal is the whole product.
  reset; seed_items "$items3"; CC_DISPATCH_CEILING=6 "$SELF" --decide >/dev/null 2>&1
  t "(r) --decide → decisions ARE journalled (3)"     test "$(grep -c '"action":"decision"' "$tmp/idl.jsonl")" -eq 3
  t "(r) --decide → ZERO wave-plan calls"             test ! -f "$tmp/wave.json"
  t "(r) --decide → ZERO claims"                      test ! -s "$tmp/backlog.log"
  t "(r) --decide → ZERO spawns"                      test ! -s "$tmp/spawn.log"
  reset; CC_DISPATCH_DECIDE_ONLY=on CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(r2) CC_DISPATCH_DECIDE_ONLY=on → same, via env"  test "$(grep -c '"action":"decision"' "$tmp/idl.jsonl")" -eq 3
  t "(r2) CC_DISPATCH_DECIDE_ONLY=on → ZERO spawns"    test ! -s "$tmp/spawn.log"

  # (s) S7 FAIR ORDERING — an item that keeps failing SINKS. With one free slot, a head item with two
  # prior `failed` records must yield the slot to the item behind it; without this, the same broken
  # item re-burns the only slot every pass and nothing behind it is ever decided-and-fired (F10).
  reset; seed_items '[{"id":"i1","project":"a","status":"open","title":"t1"},{"id":"i2","project":"a","status":"open","title":"t2"}]'
  seed_plan '[{"id":"i2","account":"a","fire_line":["--x"]}]'
  printf '%s\n' '{"actor":"cc-dispatch","action":"failed","detail":"i1: spawn non-zero (reopened)"}' \
                '{"actor":"cc-dispatch","action":"failed","detail":"i1: claim failed"}' >> "$tmp/idl.jsonl"
  CC_DISPATCH_CEILING=1 "$SELF" --once >/dev/null 2>&1
  t "(s) the thrashing head item is DEFERRED"  test "$(jq -rs '[.[]|select(.action=="decision" and .id=="i1")|.verdict]|first' "$tmp/idl.jsonl")" = defer
  t "(s) the item behind it is ADMITTED"       test "$(jq -rs '[.[]|select(.action=="decision" and .id=="i2")|.verdict]|first' "$tmp/idl.jsonl")" = admit
  t "(s) and it is the one that fires"         grep -qx 'claim i2' "$tmp/backlog.log"
  reset; seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]}]'
  CC_DISPATCH_CEILING=1 "$SELF" --once >/dev/null 2>&1
  t "(s2) control: with NO thrash history the head item wins the slot" \
    test "$(jq -rs '[.[]|select(.action=="decision" and .id=="i1")|.verdict]|first' "$tmp/idl.jsonl")" = admit

  # (t) S6 SINGLETON, pinned by pid|lstart. A LIVE holder ⇒ skip-not-queue.
  reset; seed_items "$items3"; seed_plan '[{"id":"i1","account":"a","fire_line":["--x"]}]'
  sleep 30 & local holder=$!
  mkdir -p "$tmp/dispatch.lock"
  printf '%s|%s\n' "$holder" "$(ps -o lstart= -p "$holder" 2>/dev/null)" > "$tmp/dispatch.lock/owner"
  CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(t) a live holder → the pass records pass-in-flight" grep -q '"reason":"pass-in-flight"' "$tmp/idl.jsonl"
  # item de5e3e24be8f — the lock gates ADMISSION, not DECISION. This assertion was the INVERSE
  # ("ZERO decisions") until the A2 miss was measured: holding the singleton across the 414-833 s
  # spawn tail meant a kick arriving during one produced no verdict at all, so 3 of 18 in-window
  # adds blew the 300 s bound. Deciding costs no quota, no session and no lock (S1).
  t "(t) a live holder → the pass STILL DECIDES every item (the A2 bound)" \
    test "$(jq -rs '[.[]|select(.action=="decision")]|length' "$tmp/idl.jsonl")" = 3
  t "(t) …and every one of those verdicts is defer/pass-in-flight" \
    test "$(jq -rs '[.[]|select(.action=="decision" and .verdict=="defer" and .reason=="pass-in-flight")]|length' "$tmp/idl.jsonl")" = 3
  # free_slots:0 with live_workers:null — "not allowed to admit", never "measured no capacity".
  t "(t) …carrying free_slots 0 and live_workers null (no capacity claim)" \
    test "$(jq -rs '[.[]|select(.action=="decision")|select(.free_slots==0 and .live_workers==null)]|length' "$tmp/idl.jsonl")" = 3
  # THE INVARIANT THE LOCK EXISTS FOR — the claiming path is unreachable without it, so N concurrent
  # passes still admit at most CEILING between them. ZERO admits, claims, wave-plan calls, spawns.
  t "(t) a live holder → ZERO admits (no double-admission)"  test "$(jq -rs '[.[]|select(.action=="decision" and .verdict=="admit")]|length' "$tmp/idl.jsonl")" = 0
  t "(t) a live holder → ZERO claims"                    not grep -q '^claim ' "$tmp/backlog.log"
  t "(t) a live holder → ZERO wave-plan calls"           test ! -f "$tmp/wave.json"
  t "(t) a live holder → ZERO spawns"                    test ! -s "$tmp/spawn.log"
  # a RECYCLED pid is the case `kill -0` alone cannot see: same live pid, different start time.
  # This case is ALSO (t)'s positive control: same fixture, same harness, lock free instead of held,
  # and every effect (t) asserts ABSENT is asserted PRESENT here. Without that pairing a broken stub
  # would satisfy all four of (t)'s zero-assertions vacuously.
  reset; printf '%s|%s\n' "$holder" 'Mon Jan  1 00:00:00 2001' > "$tmp/dispatch.lock/owner"
  CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(t2) lstart mismatch (recycled pid) → stale, lock TAKEN, pass runs" grep -q '"action":"decision"' "$tmp/idl.jsonl"
  t "(t2) recycled-pid holder → it ADMITS (control for (t)'s zero-admits)" \
    test "$(jq -rs '[.[]|select(.action=="decision" and .verdict=="admit")]|length' "$tmp/idl.jsonl")" -ge 1
  t "(t2) recycled-pid holder → it CLAIMS (control for (t)'s zero-claims)"      grep -q '^claim ' "$tmp/backlog.log"
  t "(t2) recycled-pid holder → it calls wave-plan (control for (t))"           test -f "$tmp/wave.json"
  t "(t2) recycled-pid holder → it fires (never wedged forever)"         test -s "$tmp/spawn.log"
  kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
  # a DEAD holder is stale too — and the lock dir is released, not leaked, when the pass ends.
  reset; mkdir -p "$tmp/dispatch.lock"
  printf '%s|%s\n' "$holder" 'Mon Jan  1 00:00:00 2001' > "$tmp/dispatch.lock/owner"
  CC_DISPATCH_CEILING=6 "$SELF" --once >/dev/null 2>&1
  t "(t3) dead holder → lock broken, pass runs"      grep -q '"action":"decision"' "$tmp/idl.jsonl"
  t "(t3) the lock is RELEASED on exit (no leak)"    test ! -d "$tmp/dispatch.lock"

  # (u) config-fail is LOUD for the new switches too — a garbage ceiling must never read as 0
  # (silently admitting nothing) or as ∞ (silently admitting everything).
  CC_DISPATCH_CEILING=abc "$SELF" --once >/dev/null 2>&1; rc=$?
  t "(u) non-numeric CC_DISPATCH_CEILING → exit 3"   test "$rc" -eq 3
  CC_DISPATCH_LANE=v3 "$SELF" --once >/dev/null 2>&1; rc=$?
  t "(u) unknown lane → exit 3"                      test "$rc" -eq 3

  echo "cc-dispatch selftest: $pass passed, $fail failed"
  [ "$fail" -eq 0 ] || exit 1
}

command -v jq >/dev/null 2>&1 || { echo "cc-dispatch: jq is required" >&2; exit 3; }
# flag parsing walks ALL args — `--once --dry-run` must be DRY, never a silent live pass
# (the single-$1 case ignored trailing flags; found live 2026-07-19). Dry wins over once.
MODE=run; WANT_SELFTEST=0; WANT_USAGE=0; WANT_DRY=0; WANT_DECIDE=0
[ $# -eq 0 ] && set -- --once
for a in "$@"; do
  case "$a" in
    selftest)        WANT_SELFTEST=1 ;;
    --dry-run)       WANT_DRY=1 ;;
    --decide)        WANT_DECIDE=1 ;;
    --once)          ;;
    -h|--help|help)  WANT_USAGE=1 ;;
    *) printf 'cc-dispatch: unknown arg %s\n\n' "$a" >&2; usage >&2; exit 3 ;;
  esac
done
# precedence is by BLAST RADIUS, not argument order (`--decide --dry-run` and `--dry-run --decide`
# must agree): dry (writes nothing at all) > decide (journals, never actuates) > run.
if   [ "$WANT_DRY" -eq 1 ];    then MODE=dry
elif [ "$WANT_DECIDE" -eq 1 ] || is_on "${CC_DISPATCH_DECIDE_ONLY:-}"; then MODE=decide
fi
if   [ "$WANT_USAGE" -eq 1 ];    then usage
elif [ "$WANT_SELFTEST" -eq 1 ]; then selftest
else dispatch "$MODE"
fi
