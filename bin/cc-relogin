#!/usr/bin/env python3
"""cc-relogin — unattended OAuth re-authentication for ONE Claude Max account.

Re-auths an account that genuinely needs it, never racing a live Claude Code session (a
relogin that rotates the token out from under a running CC has its rotation discarded —
and a discarded rotation IS a logout). Two phases, cheapest first:
  phase 1  headless refresh grant via `claude auth login` (browser-free). Does NOT move
           the ~30-day login deadline, so it never substitutes for phase 2.
  phase 2  browser OAuth over CDP in the account's dedicated Chrome profile
           (`cc-authbrowser <acct> --start` -> Target.createTarget -> Authorize).
Success is proven by EFFECT, never by report: `claude-accounts --fresh --json` must come
back auth=="ok" AND the login deadline must have MOVED. "Login successful." is a claim;
the moved deadline is the proof.

Exit: 0 PROVEN · 1 ERROR · 2 REFUSED · 3 HEADLESS-EXHAUSTED · 4 BROWSER-FAILED ·
5 UNVERIFIED · 6 FALLBACK-REQUIRED · 7 CONSENT-GATE (retained, never emitted).
Test-injection env: CC_RELOGIN_{ACCOUNTS_BIN,TMP,WARN_H,PS_BIN,SECURITY_BIN,
AUTHBROWSER_BIN,LOG}. Identity (claude binary, config dir, email, scopes) comes ONLY from
`claude-accounts --relogin-info`; scopes are passed verbatim, NEVER widened.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from typing import Any

HOME = os.path.expanduser("~")
EXIT_PROVEN, EXIT_ERROR, EXIT_REFUSED = 0, 1, 2
EXIT_HEADLESS_EXHAUSTED, EXIT_BROWSER_FAILED = 3, 4
EXIT_UNVERIFIED, EXIT_FALLBACK_REQUIRED = 5, 6
# Retained ONLY for consumer compatibility: the dedicated-profile substrate (cc-authbrowser,
# contract §3) makes a per-connection consent dialog structurally impossible, so nothing
# below emits 7. Do not wire it up.
EXIT_CONSENT_GATE = 7
RESULT_BY_EXIT = {0: "proven", 1: "error", 2: "refused", 3: "headless-exhausted",
                  4: "browser-failed", 5: "unverified", 6: "fallback-required",
                  7: "consent-gate"}
# auth states a relogin can actually fix (claude-accounts row["auth"] vocabulary).
LOGIN_FIXABLE = ("logged-out", "token-invalid", "no-oauth-blob", "login-required")
AUTH_ACTIONABLE = LOGIN_FIXABLE + ("keychain-error",)


def _env(name: str, default: str) -> str:
    return os.environ.get(name) or default


ACCOUNTS_BIN = _env("CC_RELOGIN_ACCOUNTS_BIN", "claude-accounts")
AUTHBROWSER_BIN = _env("CC_RELOGIN_AUTHBROWSER_BIN", "cc-authbrowser")
TMP = _env("CC_RELOGIN_TMP", "/tmp")
PS_BIN = _env("CC_RELOGIN_PS_BIN", "ps")
SECURITY_BIN = _env("CC_RELOGIN_SECURITY_BIN", "/usr/bin/security")
LOG_PATH = _env("CC_RELOGIN_LOG", os.path.join(HOME, ".claude", "logs", "cc-relogin.log"))
try:
    WARN_H = float(_env("CC_RELOGIN_WARN_H", "72"))
except ValueError:
    WARN_H = 72.0
DEBUG = False


class Bail(Exception):
    """Terminate the run with a specific exit code and an operator-readable detail."""

    def __init__(self, code: int, detail: str, phase: str = "gate") -> None:
        super().__init__(detail)
        self.code, self.detail, self.phase = code, detail, phase


def dbg(msg: str) -> None:
    if DEBUG:
        print(f"[cc-relogin] {msg}", file=sys.stderr)


_SECRET_RE = re.compile(r"(?:sk-[A-Za-z0-9_-]{8,}|[A-Za-z0-9_-]{40,})")


def redact(s: str) -> str:
    """Child output rides into the result object AND the log — never let a token ride with it."""
    return _SECRET_RE.sub("[REDACTED]", s)


def log(msg: str) -> None:
    """Append-only operational journal. Best-effort — never fatal, never account state."""
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        with open(LOG_PATH, "a") as fh:
            fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {msg}\n")
    except OSError:
        pass


# ---- claude-accounts: the identity + state SSOT ------------------------------------------------

def accounts_run(args: list[str], timeout: float = 180.0) -> tuple[int, str, str]:
    try:
        p = subprocess.run([ACCOUNTS_BIN, *args], capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError) as exc:
        raise Bail(EXIT_ERROR, f"claude-accounts {' '.join(args)}: {exc}") from exc
    return p.returncode, p.stdout, p.stderr


def relogin_info(acct: str) -> dict[str, Any]:
    rc, out, err = accounts_run(["--relogin-info", acct], timeout=60.0)
    if rc != 0:
        raise Bail(EXIT_REFUSED, f"unknown account {acct!r}: {(err or out).strip()[:200]}")
    try:
        info = json.loads(out)
    except json.JSONDecodeError as exc:
        raise Bail(EXIT_ERROR, "--relogin-info emitted non-JSON") from exc
    if not isinstance(info, dict):
        raise Bail(EXIT_ERROR, "--relogin-info emitted a non-object")
    return info


def fresh_row(acct: str) -> dict[str, Any]:
    """The account's live row from `claude-accounts --fresh --json` (forces a live sweep)."""
    rc, out, _ = accounts_run(["--fresh", "--json"])
    try:
        rows = json.loads(out).get("rows", [])
    except (json.JSONDecodeError, AttributeError) as exc:
        raise Bail(EXIT_ERROR, f"--fresh --json emitted non-JSON (rc={rc})") from exc
    row = next((r for r in rows if isinstance(r, dict) and r.get("acct") == acct), None)
    if row is None:
        raise Bail(EXIT_ERROR, f"account {acct!r} absent from --fresh --json rows")
    return row


def snapshot(row: dict[str, Any], info: dict[str, Any]) -> dict[str, Any]:
    return {"auth": row.get("auth"), "has_refresh_token": info.get("has_refresh_token"),
            "login_expires_at": row.get("login_expires_at")}


# ---- the gate ----------------------------------------------------------------------------------

def live_sessions(config_dir: str) -> int:
    """Live interactive-session count for ONE account; -1 when it cannot be determined.

    Mirrors claude-accounts concurrency() (bin/claude-accounts:225-259) exactly: argv[0] must
    be the claude binary; headless one-shots (-p/--print/--version in the first few argv slots)
    are skipped; attribution uses the LAST CLAUDE_CONFIG_DIR= match because `ps -E` appends the
    environment AFTER argv (an earlier match could be prompt text merely mentioning it). Bare
    `claude` counts toward the ~/.claude-next account — ~/.claude mirrors it.
    """
    target = os.path.expanduser(config_dir or "").rstrip("/")
    default_dir = os.path.join(HOME, ".claude")
    mirrors_default = target.endswith(".claude-next")
    try:
        out = subprocess.run([PS_BIN, "-wwEo", "command="], capture_output=True,
                             text=True, timeout=10).stdout
    except (subprocess.TimeoutExpired, OSError):
        return -1
    n = 0
    for line in out.splitlines():
        toks = line.split()
        if not toks:
            continue
        t0 = toks[0]
        if not (t0 == "claude" or t0.endswith("/claude") or "cli.js" in t0):
            continue
        head = [t for t in toks[1:7] if t.startswith("-")]
        if "-p" in head or "--print" in head or "--version" in head:
            continue
        cfgs = re.findall(r"CLAUDE_CONFIG_DIR=(\S+)", line)
        d = os.path.expanduser(cfgs[-1]).rstrip("/") if cfgs else default_dir
        if d == target or (mirrors_default and d == default_dir):
            n += 1
    return n


def need_relogin(row: dict[str, Any], info: dict[str, Any]) -> tuple[bool, str]:
    """Is a re-auth GENUINELY needed?

    §2 version tolerance: login_expired / login_expires_h / login_expires_at exist only on the
    unlanded feat/accounts-login-cliff claude-accounts. When absent we degrade EXPLICITLY to the
    keychain / refresh-token / auth-actionable signals and SAY SO — "cannot detect" is never
    silently reported as "nothing to do".
    """
    auth = row.get("auth")
    if auth in AUTH_ACTIONABLE:
        return True, f"auth={auth}"
    if row.get("login_expired") is True:
        return True, "login_expired"
    hours = row.get("login_expires_h")
    if isinstance(hours, (int, float)) and not isinstance(hours, bool) and hours <= WARN_H:
        return True, f"login_expires_h={hours} <= warn {WARN_H}"
    if any(k in row for k in ("login_expired", "login_expires_h", "login_expires_at")):
        return False, f"healthy (auth={auth}, login_expires_h={hours})"
    if info.get("keychain_state") != "present":
        return True, f"DEGRADED detection: keychain_state={info.get('keychain_state')}"
    if not info.get("has_refresh_token"):
        return True, "DEGRADED detection: no refresh token in keychain"
    return False, (f"healthy on the signals available (auth={auth}) — but login-deadline "
                   "detection is UNAVAILABLE: this claude-accounts emits no login_expires_* "
                   "fields (contract §2). Cannot prove a renewal is due.")


# ---- phase 1: headless refresh grant -----------------------------------------------------------

def phase1_blocked(info: dict[str, Any], row: dict[str, Any]) -> str | None:
    """None when phase 1 is possible, else the reason it is not."""
    if not info.get("has_refresh_token"):
        return "no refresh token in keychain"
    if row.get("refresh_token_expired") is True:
        return "refresh token expired"
    return None


def read_refresh_token(info: dict[str, Any]) -> str | None:
    """claudeAiOauth.refreshToken out of the account's keychain item (read-only)."""
    service = info.get("keychain_service")
    if not service:
        return None
    cmd = [SECURITY_BIN, "find-generic-password", "-s", service]
    # --relogin-info does not emit keychain_account today; the service string already embeds
    # sha256(config_dir)[:8], so it is unique on its own. Narrow with -a only if a future
    # claude-accounts starts emitting the field.
    if info.get("keychain_account"):
        cmd += ["-a", str(info["keychain_account"])]
    cmd.append("-w")
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except (subprocess.TimeoutExpired, OSError):
        return None
    if p.returncode != 0:
        return None
    try:
        blob = json.loads(p.stdout)
    except json.JSONDecodeError:
        return None
    return (blob.get("claudeAiOauth") or {}).get("refreshToken") if isinstance(blob, dict) else None


def phase1(info: dict[str, Any]) -> tuple[bool, str]:
    """Headless grant. Returns (binary CLAIMED success, detail) — the claim is not proof."""
    token = read_refresh_token(info)
    if not token:
        return False, "refresh token unreadable from keychain"
    cbin = os.path.expanduser(info.get("claude_bin") or "")
    if not cbin or not os.path.exists(cbin):
        return False, f"claude binary missing at {cbin!r}"
    env = os.environ.copy()
    env["CLAUDE_CONFIG_DIR"] = os.path.expanduser(info.get("config_dir") or "")
    env["CLAUDE_CODE_OAUTH_REFRESH_TOKEN"] = token
    env["CLAUDE_CODE_OAUTH_SCOPES"] = info.get("oauth_scopes") or ""   # verbatim, never widened
    try:
        p = subprocess.run([cbin, "auth", "login"], env=env, capture_output=True,
                           text=True, timeout=90)
    except subprocess.TimeoutExpired:
        return False, "phase 1 timed out (90s)"
    except OSError as exc:
        return False, f"phase 1 exec failed: {exc}"
    out = redact((p.stdout + p.stderr).strip().replace("\n", " "))[-200:]
    return p.returncode == 0, out or f"exit {p.returncode}"


# ---- phase 2: browser OAuth over CDP -----------------------------------------------------------

def phase2(info: dict[str, Any], url_timeout: float) -> tuple[int, str]:
    """PHASE B — cc-authbrowser substrate + CDP Authorize drive. Returns (exit code, detail).

    Teardown (login child, WS, fifo, `cc-authbrowser <acct> --stop`) belongs in this
    function's own finally block: no CDP port may outlive a run, success or failure.
    """
    return EXIT_BROWSER_FAILED, ("phase 2 (browser OAuth drive) is not implemented in this "
                                 f"build — substrate would be `{AUTHBROWSER_BIN} "
                                 f"{info.get('name')} --start` (url timeout {url_timeout:g}s)")


# ---- verify by EFFECT --------------------------------------------------------------------------

def verify(acct: str, before: dict[str, Any]) -> tuple[bool, str, dict[str, Any]]:
    """Proof, not report: auth=="ok", a refresh token present, and the deadline MOVED."""
    try:
        row, info = fresh_row(acct), relogin_info(acct)
    except Bail as exc:
        return False, f"post-check unavailable: {exc.detail}", {}
    after = snapshot(row, info)
    if row.get("auth") != "ok":
        return False, f"auth={row.get('auth')!r} (expected 'ok')", after
    if not info.get("has_refresh_token"):
        return False, "no refresh token in the keychain after the attempt", after
    old, new = before.get("login_expires_at"), after.get("login_expires_at")
    if old is None:
        return True, ("auth ok + refresh token present; deadline-move UNVERIFIABLE — this "
                      "claude-accounts emits no login_expires_at (contract §2)"), after
    try:
        moved = new is not None and new > old
    except TypeError:
        return False, f"login_expires_at incomparable ({old!r} -> {new!r})", after
    if not moved:
        return False, f"login deadline did NOT move ({old!r} -> {new!r})", after
    return True, f"login deadline moved ({old!r} -> {new!r})", after


# ---- driver ------------------------------------------------------------------------------------

def emit(state: dict[str, Any], code: int, detail: str, phase: str, as_json: bool,
         result: str | None = None) -> int:
    state.update(result=result or RESULT_BY_EXIT[code], exit=code,
                 phase_reached=phase, detail=detail)
    log(f"{state['acct']} {state['result']} exit={code} phase={phase} :: {detail}")
    if as_json:
        print(json.dumps(state, indent=2))
    else:
        print(f"cc-relogin {state['acct']}: {state['result'].upper()} ({code}) — {detail}")
    return code


def parse_args(argv: list[str]) -> argparse.Namespace:
    """argparse exits 2 on a usage error, which IS the frozen REFUSED code — bad args refuse."""
    p = argparse.ArgumentParser(prog="cc-relogin", description=(__doc__ or "").strip(),
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("acct", help="account name (next | next2 | next3 | next4)")
    p.add_argument("--dry-run", action="store_true", help="gate + phase plan only; mutate nothing")
    p.add_argument("--no-browser", action="store_true", help="phase 1 only; never open a browser")
    p.add_argument("--json", action="store_true", help="emit the result object on stdout")
    p.add_argument("--url-timeout", type=float, default=30.0, metavar="N")
    p.add_argument("--debug", action="store_true", help="progress to stderr")
    return p.parse_args(argv)


def run(acct: str, o: argparse.Namespace, state: dict[str, Any]) -> int:
    """The gate, the phase ladder, and verification. The heal lock is held for the WHOLE run."""
    as_json = bool(o.json)
    info = relogin_info(acct)
    row = fresh_row(acct)
    state["before"] = before = snapshot(row, info)
    need, why = need_relogin(row, info)
    state["need_reason"] = why
    if not need:
        raise Bail(EXIT_REFUSED, f"no re-auth needed — {why}")
    dbg(f"need: {why}")
    k = live_sessions(info.get("config_dir", ""))
    if k != 0:
        raise Bail(EXIT_REFUSED, f"{k} live session(s) — CC owns the token lifecycle" if k > 0
                   else "live-session count UNKNOWN (ps failed) — refusing")
    lock_path = os.path.join(TMP, f"claude-accounts-heal-{acct}.lock")
    lock = open(lock_path, "w")
    try:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise Bail(EXIT_REFUSED,
                       f"heal lock busy ({lock_path}) — another heal/relogin in flight") from exc
        # Re-check liveness UNDER the lock: the snapshot above is already stale by the time we
        # hold the lock, and a relogin racing a running CC has its rotation discarded — which
        # IS a logout. Mirrors claude-accounts heal() (bin/claude-accounts:314-350).
        k = live_sessions(info.get("config_dir", ""))
        if k != 0:
            raise Bail(EXIT_REFUSED, f"a session appeared under the lock (k={k}) — "
                                     "CC owns the token lifecycle")
        blocked = phase1_blocked(info, row)
        state["plan"] = [f"phase1: SKIP ({blocked})" if blocked
                         else "phase1: headless refresh grant (claude auth login)",
                         "phase2: SKIP (--no-browser)" if o.no_browser
                         else f"phase2: browser OAuth via {AUTHBROWSER_BIN}"]
        if o.dry_run:
            return emit(state, EXIT_PROVEN, "gate passed; lock probed (taken + released); "
                        "nothing mutated", "gate", as_json, result="dry-run")
        if not blocked:
            claimed, detail = phase1(info)
            state["phase1"] = {"ran": True, "claimed_success": claimed, "detail": detail}
            dbg(f"phase1 claimed={claimed} :: {detail}")
            if claimed:
                ok, vdetail, state["after"] = verify(acct, before)
                if ok:
                    return emit(state, EXIT_PROVEN,
                                f"phase 1 headless refresh PROVEN — {vdetail}", "verify", as_json)
                if o.no_browser:
                    return emit(state, EXIT_UNVERIFIED, "phase 1 reported success but the "
                                f"effect check failed — {vdetail}", "verify", as_json)
                # A refresh grant does not move the login deadline, so an unproven phase 1 is
                # EXPECTED when the deadline is what expired. Escalate, never stop here.
                dbg("phase 1 unproven — escalating to phase 2")
            elif o.no_browser:
                return emit(state, EXIT_HEADLESS_EXHAUSTED,
                            f"phase 1 failed and --no-browser given — {detail}", "phase1", as_json)
        elif o.no_browser:
            return emit(state, EXIT_HEADLESS_EXHAUSTED,
                        f"phase 1 impossible and --no-browser given — {blocked}", "phase1", as_json)
        code, detail = phase2(info, float(o.url_timeout))
        if code != EXIT_PROVEN:
            return emit(state, code, detail, "phase2", as_json)
        ok, vdetail, state["after"] = verify(acct, before)
        return emit(state, EXIT_PROVEN if ok else EXIT_UNVERIFIED,
                    (f"phase 2 browser OAuth PROVEN — {vdetail}" if ok else
                     f"phase 2 reported success but the effect check failed — {vdetail}"),
                    "verify", as_json)
    finally:
        lock.close()          # closing releases the flock — held until here, always


def main() -> int:
    global DEBUG
    o = parse_args(sys.argv[1:])
    DEBUG = bool(o.debug)
    acct = str(o.acct)
    state: dict[str, Any] = {"acct": acct, "dry_run": bool(o.dry_run), "before": {}, "after": {}}
    try:
        return run(acct, o, state)
    except Bail as exc:
        return emit(state, exc.code, exc.detail, exc.phase, bool(o.json))
    except Exception as exc:                              # noqa: BLE001 — reported, never lost
        return emit(state, EXIT_ERROR, f"{type(exc).__name__}: {exc}", "gate", bool(o.json))


if __name__ == "__main__":
    sys.exit(main())
