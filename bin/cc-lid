#!/bin/bash
# cc-lid — read and toggle macOS clamshell sleep (`pmset -a disablesleep`) so a
# long-running Claude Code session survives the lid being closed.
#
# WHY (2026-09-03): `caffeinate` — which this fleet runs constantly — takes an
# idle-sleep assertion (PreventUserIdleSystemSleep). Clamshell sleep is a
# DIFFERENT path and ignores it entirely, so a machine with nine caffeinate
# assertions still sleeps the instant the lid shuts. The only setting that
# covers it is `pmset disablesleep`, which needs root.
#
# THE ELEVATION LADDER, and why the last rung is not `sudo`: passwordless sudo runs
# straight through; a real terminal drives sudo and lets it prompt; with NO TTY sudo
# cannot prompt AT ALL — it dies on 'a terminal is required to read the password'
# before running anything — so the command handed back there must be the osascript
# form, which raises the native macOS password dialog instead of reading a tty.
# Measured 2026-09-03: an agent is denied `sudo` outright by hooks/validate-bash.sh,
# and the `sudo pmset` line it printed then failed for the operator too, because they
# pasted it into Claude Code's `!` surface, which has no tty either. One command that
# only works in a window the reader may not be in is a worksheet, not a hand-off.
#
# Usage:
#   cc-lid                 status — current setting, and what it does/doesn't cover
#   cc-lid on              disable sleep (lid may be closed)
#   cc-lid off             restore normal sleep
#   cc-lid toggle          flip whichever way it currently is
#   cc-lid --machine       one parseable line: state=<on|off> verdict=<...>
#
# Exit codes: 0 already/now in the requested state · 10 operator must run the
# printed command · 2 usage · 3 not macOS · 4 applied but verification failed.
set -u

PMSET="${CC_LID_PMSET:-/usr/bin/pmset}"        # overridable for tests
SUDO="${CC_LID_SUDO:-sudo}"                    # overridable for tests

MACHINE="" ACTION="status"
while [ $# -gt 0 ]; do
  case "$1" in
    on|1|yes|awake)   ACTION="on" ;;
    off|0|no|sleep)   ACTION="off" ;;
    toggle|flip)      ACTION="toggle" ;;
    status|"")        ACTION="status" ;;
    --machine)        MACHINE=1 ;;
    -h|--help)        sed -n '2,29p' "$0"; exit 0 ;;
    *) echo "cc-lid: unknown argument '$1' (want: on | off | toggle | status)" >&2; exit 2 ;;
  esac
  shift
done

[ "$(uname -s)" = "Darwin" ] || { echo "cc-lid: macOS only (pmset is a Darwin tool)" >&2; exit 3; }
[ -x "$PMSET" ] || { echo "cc-lid: pmset not executable at $PMSET" >&2; exit 3; }

# Read the LIVE setting. Fail closed: an unreadable pmset is 'unknown', never 'off'.
read_state() {
  local v
  v="$("$PMSET" -g 2>/dev/null | awk '$1=="SleepDisabled"{print $2; exit}')"
  case "$v" in
    1) echo on ;;
    0) echo off ;;
    *) echo unknown ;;
  esac
}

CUR="$(read_state)"
[ "$CUR" = unknown ] && { echo "cc-lid: could not read SleepDisabled from '$PMSET -g' — refusing to guess" >&2; exit 3; }

case "$ACTION" in
  toggle) if [ "$CUR" = on ]; then WANT=off; else WANT=on; fi ;;
  on)     WANT=on ;;
  off)    WANT=off ;;
  status) WANT="$CUR" ;;
esac

TARGET_BIT=$([ "$WANT" = on ] && echo 1 || echo 0)

# WHICH command we hand back depends on the SURFACE, not on taste. `sudo` reads the
# password from a tty; with no tty it cannot prompt at all and dies before running
# anything. So the fallback form must be the one that raises the GUI dialog.
if [ -n "${CC_LID_TTY:-}" ]; then HAS_TTY="$CC_LID_TTY"; elif [ -t 0 ]; then HAS_TTY=1; else HAS_TTY=0; fi
SUDO_CMD="sudo pmset -a disablesleep $TARGET_BIT"
GUI_CMD="osascript -e 'do shell script \"/usr/bin/pmset -a disablesleep $TARGET_BIT\" with administrator privileges'"
# --machine reports what a caller on THIS surface could run. The printed block is a
# different question and always answers GUI — see the render at the bottom.
if [ "$HAS_TTY" = 1 ]; then CMD="$SUDO_CMD"; else CMD="$GUI_CMD"; fi

if [ -n "$MACHINE" ]; then
  if [ "$CUR" = "$WANT" ]; then echo "state=$CUR want=$WANT verdict=satisfied cmd=none"
  else echo "state=$CUR want=$WANT verdict=needs-sudo cmd=$CMD"; fi
  [ "$CUR" = "$WANT" ] && exit 0 || exit 10
fi

if [ "$ACTION" = status ] || [ "$CUR" = "$WANT" ]; then
  if [ "$CUR" = on ]; then
    echo "Lid-close sleep is DISABLED — the machine keeps running with the lid shut."
    echo "This persists across reboot. Turn it back off with: cc-lid off"
    echo "Keep it plugged in and out of a bag; it runs full-tilt with no airflow."
  else
    echo "Lid-close sleep is ENABLED (normal) — closing the lid suspends the machine."
    echo "caffeinate does NOT cover this; only 'pmset disablesleep' does. Enable with: cc-lid on"
  fi
  exit 0
fi

verify_and_report() {   # verify by a DIFFERENT call than the one that made the change
  local new; new="$(read_state)"
  [ "$new" = "$WANT" ] || { echo "cc-lid: applied but pmset still reads '$new' (wanted '$WANT')" >&2; exit 4; }
  echo "Lid-close sleep is now $([ "$new" = on ] && echo DISABLED || echo ENABLED) (verified: SleepDisabled=$TARGET_BIT)."
  [ "$new" = on ] && echo "Persists across reboot — revert with: cc-lid off"
  return 0
}

# A change is needed. Three rungs, in order of how little they ask of the operator.
# 1. Passwordless sudo — just do it.
if $SUDO -n true >/dev/null 2>&1; then
  $SUDO "$PMSET" -a disablesleep "$TARGET_BIT" || {
    echo "cc-lid: '$PMSET -a disablesleep $TARGET_BIT' failed" >&2; exit 4; }
  verify_and_report; exit 0
fi

# 2. A real terminal — drive sudo and let it prompt. Do NOT print the command and
#    make the operator re-type it; that is the worksheet defect.
if [ "$HAS_TTY" = 1 ]; then
  echo "Needs root — sudo will ask for your password."
  if $SUDO "$PMSET" -a disablesleep "$TARGET_BIT"; then verify_and_report; exit 0; fi
  echo "cc-lid: sudo did not complete — falling back to the GUI prompt below." >&2
fi

# 3. The block, and it is ALWAYS the GUI form — never $SUDO_CMD. Reaching here means
#    sudo has already been ruled out: with no tty it cannot prompt at all (it dies on
#    'a terminal is required to read the password' before running anything), and with a
#    tty it was just DRIVEN above and failed. Printing the sudo line either way hands
#    back a command that has already been shown not to work on this surface — measured
#    2026-09-03, when the shipped line failed in Claude Code's `!` surface, and again
#    when the first cut of this very fix re-printed it after a cancelled prompt.
WHAT=$([ "$WANT" = on ] && echo "keep running with the lid closed" || echo "restore normal lid-close sleep")
printf '%s\n' "Needs root, and sudo cannot get a password on this surface."
printf '%s\n' "This one uses the macOS password dialog instead. It will $WHAT, and the setting persists across reboot."
printf '\n%s\n\n' "▶ Run this:"
printf '%s\n' "\`$GUI_CMD\`"
exit 10
