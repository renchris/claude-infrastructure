#!/usr/bin/env python3
"""permission-prompt audit — rank the commands most likely to be BLOCKING sessions.

Method: every Bash tool_use in the transcript corpus is matched against the live
settings.json allow/deny/ask rules. Commands matching NO allow rule are prompt
CANDIDATES; ranked by frequency they are the highest-value allow-list additions.

HONEST BOUND: the candidate ranking is an UPPER bound on prompts, not the true prompt
set. Auto mode runs a classifier on top of the static rules and silently approves much
of what does not match a literal rule; it also cannot see prompts the classifier raised
for a command that DOES match.

The OBSERVED section closes that gap where data exists. cc-permission-beacon.sh now
appends every resolved prompt to a durable archive before removing it, so this report
carries a measured set alongside the inferred bound. The archive only accumulates
FORWARD from the day it landed, so a short history means a small observed set, not an
absence of prompts — the two are distinguished explicitly below.

Usage:
  cc-permission-audit [DAYS]            the report above (0/absent = all history)
  cc-permission-audit --prune [FILE…]   list provably-dead approved patterns; writes NOTHING
  CONFIRM=1 cc-permission-audit --prune [FILE…]   remove them (timestamped backup per file)
  cc-permission-audit --drop [FILE…]    list allow rules AUTO MODE DELETES; writes NOTHING, ever
"""

import json, glob, re, sys, collections, os, time

SETTINGS = os.path.expanduser("~/.claude/settings.json")
ARCHDIR = os.environ.get(
    "CC_PERMARCHIVE_DIR", os.path.expanduser("~/.claude/autonomy/permission-archive")
)


def _days_arg(v):
    """`7`, `7d`, `7 days` → 7. A ValueError traceback on `7d` — the natural spelling of this
    argument — is a worse answer than reading the intent, and exiting 1 before any output at
    all looks like a crash rather than a usage error."""
    m = re.match(r"^\s*(\d+)\s*(?:d|day|days)?\s*$", str(v), re.I)
    if not m:
        sys.stderr.write(f"cc-permission-audit: ignoring unparseable day count {v!r}\n")
        return 0
    return int(m.group(1))


ARGV = sys.argv[1:]
PRUNE = "--prune" in ARGV
DROP = "--drop" in ARGV
# `--prune FILE…` / `--drop FILE…` take explicit settings paths; the positional day-count keeps
# working unchanged when no flag is given, so `cc-permission-audit 7` is untouched.
PRUNE_PATHS = [a for a in ARGV if not a.startswith("-") and a.endswith(".json")]
_POS = [a for a in ARGV if not a.startswith("-") and a not in PRUNE_PATHS]
DAYS = _days_arg(_POS[0]) if _POS else 0  # 0 = all history
# AXIS MISMATCH, deliberate and disclosed: with DAYS set the ARCHIVE is filtered per-ROW on
# resolved_ts, while the transcript corpus is filtered per-FILE on mtime — so an actively
# appended transcript contributes its entire history. The two halves of this report answer
# "last N days" at different precision; the corpus half is the loose one. Tightening it means
# parsing every line's timestamp across ~1,000 transcripts, which is why it was not done here.


def load_rules():
    o = json.load(open(SETTINGS))
    p = o.get("permissions", {})

    def bash_rules(key):
        out = []
        for r in p.get(key, []):
            m = re.match(r"^Bash\((.*)\)$", r)
            if m:
                pat = m.group(1)
                out.append(pat[:-2] if pat.endswith(":*") else pat)
        return out

    return bash_rules("allow"), bash_rules("deny"), bash_rules("ask")


def norm(cmd):
    """Collapse a command to the comparable prefix a rule would match."""
    c = " ".join(cmd.strip().split())
    # strip leading env assignments and cd-chains — they are not the decided verb
    while True:
        m = re.match(r"^(?:[A-Za-z_][A-Za-z0-9_]*=\S*\s+)(.*)$", c)
        if not m:
            break
        c = m.group(1)
    return c


def head(cmd, n=2):
    parts = norm(cmd).split()
    return " ".join(parts[:n]) if parts else ""


def matches(cmd, rules):
    c = norm(cmd)
    for r in rules:
        if c == r or c.startswith(r + " ") or c.startswith(r):
            return r
    return None


def cmd_of(row):
    """The command text of an archived row, including the truncated-payload fallback so an
    over-long prompt still contributes its identity instead of vanishing from the ranking."""
    ti = row.get("tool_input")
    if isinstance(ti, dict):
        return (ti.get("command") or ti.get("file_path")
                or ti.get("description") or row.get("tool_input_summary") or "")
    return row.get("tool_input_summary") or ""


def _read_rows(cutoff):
    """Every archive row in range, plus an explicit READ-ERROR count.

    Two failure modes are handled per-ROW rather than per-file. The first cut wrapped the
    whole file loop in `except Exception: continue`, so a single type-corrupt field (a
    string `resolved_ts` meeting a numeric comparison) aborted every REMAINING row in that
    file — five ten-minute blocks reported as "nothing has actually blocked". A row is a
    row; one bad one may cost itself and nothing else.
    """
    rows, bad, unreadable = [], 0, 0
    files = sorted(glob.glob(os.path.join(ARCHDIR, "*.jsonl")))
    for f in files:
        try:
            fh = open(f, encoding="utf-8-sig", errors="ignore")   # utf-8-sig strips a BOM
        except OSError:
            unreadable += 1                                       # never silently an all-clear
            continue
        with fh:
            while True:
                try:
                    ln = fh.readline()
                except OSError:
                    unreadable += 1
                    break
                if not ln:
                    break
                ln = ln.strip()
                if not ln:
                    continue
                try:
                    o = json.loads(ln)
                    if not isinstance(o, dict):
                        raise ValueError("not an object")
                    rts = o.get("resolved_ts")
                    if cutoff:
                        if not isinstance(rts, (int, float)) or rts < cutoff:
                            continue
                    rows.append(o)
                except Exception:
                    bad += 1                                      # counted, never guessed at
    return rows, bad, unreadable, files


def _classify(r):
    """approved | refused | collateral | unknown — and a grant is PROVEN, never inferred.

    The only evidence that a prompt was GRANTED is that the very invocation it gated is the
    one whose PostToolUse cleared it: tool_use_id must match. Matching tool NAMES was the
    previous rule and it is a guess that fails in the unsafe direction — this tool's traffic
    is overwhelmingly Bash, so a DENIED `git push --force` followed by any other Bash command
    in the same turn gave cleared_tool == tool_name == "Bash" and the refusal was counted as
    an approval. Without the ids, the honest answer is `unknown`.
    """
    ev = r.get("resolved_by") or "unknown"
    if ev in ("Stop", "SessionEnd"):
        return "refused"
    if ev != "PostToolUse":
        return "unknown"
    tid, cid = r.get("tool_use_id") or "", r.get("cleared_tool_use_id") or ""
    if tid and cid:
        return "approved" if tid == cid else "collateral"
    ct, tn = r.get("cleared_tool") or "", r.get("tool_name") or ""
    if ct and tn and ct != tn:
        return "collateral"          # provably a different tool ⇒ provably not this grant
    return "unknown"                 # same name, or no ids: not evidence of anything


def archive_report():
    """The OBSERVED prompt set, from cc-permission-beacon.sh's durable archive.

    Absence is read as FOUR states, not two. A missing directory means the archiver has never
    run; an empty one means it ran and nothing blocked — that split only works because the
    hook stamps `.archive-alive` on every clear. An UNREADABLE directory is the third, and it
    used to be indistinguishable from the all-clear: isdir() succeeded, glob() returned []
    silently, and the report said "nothing has actually blocked" over a directory it could not
    open. That is precisely the false all-clear this logic exists to prevent, so it is now its
    own state, as is a readable directory holding unreadable files.
    """
    print("\n── OBSERVED PROMPTS (measured, from the beacon archive) ──")
    if not os.path.isdir(ARCHDIR):
        print(f"  archive ABSENT ({ARCHDIR})")
        print("  ⇒ the beacon has never archived a resolution. This report is BLIND to")
        print("    actual prompts; the ranking above remains an upper bound only.")
        return
    if not os.access(ARCHDIR, os.R_OK | os.X_OK):
        print(f"  archive UNREADABLE ({ARCHDIR}) — permission denied")
        print("  ⇒ BLIND. This is NOT an all-clear: rows may exist and cannot be counted.")
        return

    alive = os.path.exists(os.path.join(ARCHDIR, ".archive-alive"))
    cutoff = time.time() - DAYS * 86400 if DAYS else 0
    rows, bad, unreadable, files = _read_rows(cutoff)

    if unreadable:
        print(f"  ⚠ {unreadable} archive file(s) could not be read — counts below are a FLOOR.")
    if bad:
        print(f"  ⚠ {bad} unparseable row(s) skipped.")

    if not rows:
        if not files and not alive:
            # No .jsonl AND no heartbeat: the archiver has not demonstrably run here.
            print(f"  archive dir present but the archiver has left NO evidence ({ARCHDIR})")
            print("  ⇒ treat as BLIND, not as an all-clear.")
        else:
            print(f"  archive present, {len(files)} file(s), no rows in range ({ARCHDIR})")
            print("  ⇒ the archiver is wired and running; nothing has actually blocked in range.")
        return

    buckets = collections.Counter(_classify(r) for r in rows)
    approved = buckets["approved"]
    refused = buckets["refused"]
    collateral = buckets["collateral"]
    unknown = buckets["unknown"]
    span = ""
    ts = [r.get("resolved_ts") for r in rows if isinstance(r.get("resolved_ts"), (int, float))]
    if ts:
        span = (f"  {time.strftime('%Y-%m-%d', time.localtime(min(ts)))}"
                f" → {time.strftime('%Y-%m-%d', time.localtime(max(ts)))}")
    print(f"  {len(rows)} resolved prompt(s) across "
          f"{len({r.get('session_id') for r in rows})} session(s){span}")
    # The four buckets SUM to the total — a headline whose parts do not add up is the kind of
    # number people quote without checking.
    print(f"  approved {approved}  ·  denied/abandoned {refused}  ·  "
          f"cleared-by-other {collateral}  ·  unknown {unknown}   (= {len(rows)})")
    if approved == 0 and unknown:
        print("  NOTE: no grant could be PROVEN (a grant needs the clearing tool_use_id to match")
        print("        the prompted one). 'unknown' is not 'denied' — see _classify().")

    waits = sorted(r.get("waited_s") for r in rows
                   if isinstance(r.get("waited_s"), (int, float)))
    if waits:
        n = len(waits)
        med = waits[n // 2] if n % 2 else (waits[n // 2 - 1] + waits[n // 2]) / 2
        worst = max(rows, key=lambda r: r.get("waited_s")
                    if isinstance(r.get("waited_s"), (int, float)) else 0)
        print(f"  median block {med:.0f}s  ·  longest "
              f"{(worst.get('waited_s') or 0) / 3600:.1f}h  "
              f"({cmd_of(worst)[:60]})")

    # Bash only: this section feeds hooks/smart-bash-allowlist.sh, and a Write or Edit prompt
    # ranked into a Bash allow-list is an action item that cannot be actioned.
    seen = collections.Counter(head(cmd_of(r)) for r in rows
                               if (r.get("tool_name") or "") == "Bash" and cmd_of(r))
    if seen:
        print("\n  ── Bash commands that ACTUALLY blocked (rank these first) ──")
        for h, n in seen.most_common(15):
            print(f"  {n:5d}  {h}")
    other = collections.Counter((r.get("tool_name") or "?") for r in rows
                                if (r.get("tool_name") or "") != "Bash")
    if other:
        print("  non-Bash prompts (not allow-listable here): "
              + ", ".join(f"{k}×{v}" for k, v in other.most_common(6)))


# ─────────────────────────────── --prune ────────────────────────────────────
#
# THE DEAD-ENTRY PREDICATE — REDUNDANCY, proven inside the one file being rewritten.
#
# An approved entry is DEAD iff removing it cannot change what any command resolves to,
# proven from that same file's own `permissions.allow` list:
#
#   (a) DUPLICATE — a byte-identical earlier entry survives. Semantics-preserving under ANY
#       matcher, because the surviving twin IS the same rule.
#   (b) SHADOWED  — it is a wildcard-free rule `Tool(literal)` and the same list holds a
#       prefix rule `Tool(base:*)` where `literal.startswith(base + " ")`. Under the
#       documented prefix semantics the only command string the exact rule can match — the
#       literal itself — starts with `base ` and is therefore still matched by the surviving
#       prefix rule. Removal shrinks the file and widens nothing.
#
# This is a rule-ALGEBRA test, never a denylist of spellings: no command text is inspected
# for "looks like a temp path / a sha / a pid".
#
# DELIBERATELY NOT PRUNED, though backlog row a78f0fa4223a asked for it: the "one-shot
# exact-match" class — an entry naming a literal that looks unrepeatable. Nothing on disk
# proves the operator will not type it again (`mkdir -p /tmp/advV/x` is one-shot-LOOKING and
# perfectly repeatable), and the two errors are not symmetric: a false prune re-prompts the
# operator forever, a missed prune costs a line of JSON. Measured 2026-08-17: 63.2% of the
# fleet's 1748 Bash patterns are exact matches, but only 10.2% of all 2399 patterns are
# provably redundant — exactness is not deadness, which is why that 48% figure is not the
# prune population.
#
# ALSO NOT USED AS PROOF:
#   · `literal == base` (does `Tool(x:*)` match the bare command `x`?). That is the matcher's
#     business and is not asserted here; 3 fleet-wide entries turn on it and they stay.
#   · a shadower living in a DIFFERENT settings file. Precedence-merged files are edited
#     independently, so the proof has to live in the file that is being rewritten.

WILDCARD = re.compile(r"[*?\[\]]")
RULE_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_.-]*)\((.*)\)$", re.S)
# Discovery is a bounded walk, not `**` — a recursive glob of $HOME does not terminate in
# usable time. Explicit paths on the command line skip it entirely (that is what tests use).
WALK_SKIP = {
    "node_modules", "Library", "Applications", ".Trash", ".git", ".venv", "venv",
    "site-packages", "Movies", "Music", "Pictures", "Downloads", ".npm", ".cache",
    "dist", "build", ".next",
}
WALK_MAXDEPTH = 5


def _settings_files(names=("settings.local.json",)):
    """Discovered settings files, or the explicit paths given on the command line.

    THE DEFAULT IS `settings.local.json` ONLY, AND THAT IS A SAFETY PROPERTY, NOT AN OVERSIGHT.
    `--prune` REWRITES what discovery hands it, and `settings.json` is the operator's primary,
    hand-maintained store — the one file C10 says is never edited in place. So the writing mode
    keeps the narrow default and a primary is pruned only when named explicitly, out loud, on the
    command line.

    `--drop` is read-only by construction, so it widens the walk to `settings.json` as well. That
    widening is the whole reason the drop audit can see anything at all on this box: measured
    2026-08-20 (docs/research/permission-settings-store-2026-08-20.md §1), NO `settings.local.json`
    exists in ANY of the five config dirs, while the primaries hold 339/339/338/338/338 allow
    entries. Discovery restricted to `.local` returns the empty set there — a report that says
    "0 files" over 1,692 live rules, which reads as an all-clear and is the exact false negative
    this audit exists to prevent.
    """
    if PRUNE_PATHS:
        return PRUNE_PATHS
    root = os.path.expanduser("~")
    base = root.rstrip("/").count("/")
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        if dirpath.count("/") - base >= WALK_MAXDEPTH:
            dirnames[:] = []
        else:
            dirnames[:] = [d for d in dirnames if d not in WALK_SKIP]
        if not os.path.basename(dirpath).startswith(".claude"):
            continue
        for n in names:
            if n in filenames:
                out.append(os.path.join(dirpath, n))
    return sorted(out)


def dead_entries(allow):
    """(survivors, [(index, rule, reason)]) for one `permissions.allow` list.

    See THE DEAD-ENTRY PREDICATE above. Order of survivors is preserved exactly.
    """
    prefixes = collections.defaultdict(list)
    for rule in allow:
        m = RULE_RE.match(rule)
        if not m:
            continue
        tool, arg = m.group(1), m.group(2)
        if arg.endswith(":*") and not WILDCARD.search(arg[:-2]):
            prefixes[tool].append(arg[:-2])

    survivors, dead, seen = [], [], set()
    for i, rule in enumerate(allow):
        if rule in seen:
            dead.append((i, rule, "duplicate of an earlier entry"))
            continue
        m = RULE_RE.match(rule)
        if m and not WILDCARD.search(m.group(2)):
            tool, arg = m.group(1), m.group(2)
            hit = next((b for b in prefixes[tool] if arg.startswith(b + " ")), None)
            if hit is not None:
                dead.append((i, rule, f"shadowed by {tool}({hit}:*)"))
                continue
        seen.add(rule)
        survivors.append(rule)
    return survivors, dead


def _backup(path):
    stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime())
    dest = f"{path}.permprune-bak-{stamp}"
    n = 0
    while os.path.exists(dest):                      # never clobber a same-second backup
        n += 1
        dest = f"{path}.permprune-bak-{stamp}.{n}"
    with open(path, "rb") as src, open(dest, "wb") as out:
        out.write(src.read())
    return dest


def prune_report():
    """Dry-run by default; writes only under CONFIRM=1 (this repo's dominant confirm idiom)."""
    apply = os.environ.get("CONFIRM", "0") == "1"
    files = _settings_files()
    print(f"── PRUNE {'(APPLY)' if apply else '(DRY RUN — nothing will be written)'} ──")
    print(f"  scope: {len(files)} settings.local.json file(s)")
    total = dead_total = written = failed = 0
    for path in files:
        try:
            with open(path, encoding="utf-8") as fh:
                obj = json.load(fh)
        except Exception as e:
            print(f"  ⚠ SKIP (unreadable/invalid JSON): {path}: {e}")
            failed += 1
            continue
        allow = ((obj.get("permissions") or {}).get("allow")) if isinstance(obj, dict) else None
        if not isinstance(allow, list):
            continue
        total += len(allow)
        survivors, dead = dead_entries(allow)
        if not dead:
            continue
        dead_total += len(dead)
        print(f"\n  {path}  ({len(allow)} → {len(survivors)}, {len(dead)} dead)")
        for _, rule, why in dead:
            print(f"    - {rule[:100]}   [{why}]")
        if not apply:
            continue
        try:
            bak = _backup(path)                      # backup BEFORE the write, always
            obj["permissions"]["allow"] = survivors
            tmp = path + ".permprune-tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(obj, fh, indent=2, ensure_ascii=False)
                fh.write("\n")
            os.replace(tmp, path)                    # atomic; nothing half-written
            written += 1
            print(f"    ✔ rewritten (backup: {bak})")
        except Exception as e:
            print(f"    ⚠ WRITE FAILED, file left alone: {e}")
            failed += 1
    pct = f"{100 * dead_total / total:.1f}%" if total else "n/a"
    print(f"\n  {dead_total} provably-dead entr(ies) of {total} approved patterns ({pct})")
    if apply:
        print(f"  {written} file(s) rewritten, {failed} skipped/failed")
    else:
        print("  DRY RUN — nothing written. Re-run as: "
              f"CONFIRM=1 {os.path.basename(sys.argv[0])} --prune"
              + (" " + " ".join(PRUNE_PATHS) if PRUNE_PATHS else ""))
    return 1 if failed else 0


# ────────────────────── --drop: the AUTO-MODE drop predicate ───────────────────────
#
# A DIFFERENT KIND OF DEAD FROM --prune, AND THE TWO MUST NOT BE CONFUSED.
#
# `--prune` removes entries that are dead under EVERY mode, proven by rule algebra inside one
# file (a duplicate, or a literal already covered by its own file's prefix rule). Removing one
# cannot change any decision, so it writes.
#
# `--drop` reports entries that are dead ONLY IN AUTO MODE. On entering auto, Claude Code
# DELETES every allow rule that grants arbitrary code execution (`pme` → `qNt` → `gsn`/`_sn`);
# they are RESTORED on leaving auto. So a dropped entry is live in `default`/`acceptEdits` and
# inert in `auto` — it is dead weight only for as long as the session runs auto, which on this
# box is every session (`ps aux`, 2026-08-19: all 16 run `--permission-mode auto`).
#
# 🚨 THEREFORE `--drop` NEVER WRITES, UNDER ANY FLAG OR ENV VAR. Deleting a rule the operator
# would want back the moment they leave auto mode is a decision only they can make, and this
# tool has no way to know which of the two modes the rule was written for. The output is an
# audit; the edit is theirs. `--prune`'s CONFIRM=1 arm has no counterpart here on purpose.
#
# PROVENANCE, and its honest limit. The predicate below transcribes the extraction in
# docs/research/permission-matcher-truth-2026-08-20.md §3 ("Auto mode drops broad allow rules —
# the exact predicate"), read out of CC 2.1.220's bundled binary at the offsets that doc names.
# That doc flags this as its ONE load-bearing claim resting on code-and-doc reading rather than
# a live probe: no observable in `stream-json` distinguishes "allowed by rule" from "allowed by
# classifier" in auto mode, so the drop could not be probe-confirmed. Two consequences worth
# stating rather than burying: a finding here is a claim about the BINARY, not about a measured
# refusal, and it is pinned to 2.1.220 — a later build may move the list. What makes the report
# actionable anyway is the direction of its error: every rule it names is one the DO-list in
# that same doc says to rewrite narrower regardless, because a rule that survives the filter is
# strictly better than one that needs the classifier's goodwill.
#
# WHY THIS IS NOT A GREP. Recommendation 8 of that doc asks for exactly this audit and proposes
# `grep` over the command names. Grep gets four classes wrong, each in the expensive direction:
# it cannot see that `Bash(npm run test:*)` SURVIVES while `Bash(npm run:*)` dies; it cannot
# apply the `-m pkg.module` exception that keeps `Bash(python -m foo.bar *)` alive; it has no
# model of the nSd branch, where `kubectl get` lives and `kubectl exec` dies; and it hits the
# command name anywhere in a rule, so `Bash(git log --format=%h -- bin/env:*)` is a false
# positive. The predicate is structural, so it is written out structurally.

ISD = [  # iSd (offset 19668065), verbatim — the arbitrary-code-execution list
    "python", "python3", "python2", "node", "deno", "tsx", "ruby", "perl", "php", "lua",
    "npx", "bunx", "npm run", "yarn run", "pnpm run", "bun run",
    "bash", "sh", "ssh", "zsh", "fish", "eval", "exec", "env", "xargs", "sudo",
]
NSD = ["curl", "wget", "kubectl", "aws", "gcloud", "gsutil"]  # network/cloud, special handling
KUBECTL_MUTATING = {
    "exec", "apply", "create", "delete", "run", "cp", "port-forward", "proxy", "patch",
    "edit", "replace", "attach", "debug", "scale", "rollout", "drain", "cordon", "taint",
}
# The one documented survival inside a flag tail: `Bash(python -m pkg.module *)`.
DASH_M_OK = re.compile(r"^-m\s+\w+\.[\w.]+(\s*:|\s+)$")
# Longest first so `npm run` is tested before any single-token entry could shadow it.
_ISD_SORTED = sorted(ISD, key=len, reverse=True)
_NSD_SORTED = sorted(NSD, key=len, reverse=True)


def _bare_forms(cmd, c):
    """The four spellings of "the whole command, unconstrained": `x`, `x:*`, `x *`, `x*`."""
    return c in (cmd, cmd + ":*", cmd + " *", cmd + "*")


def _nsd_reason(cmd, c):
    if _bare_forms(cmd, c):
        return f"broad `{cmd}` rule — no positional argument"
    if not c.startswith(cmd + " "):
        return None
    tail = c[len(cmd) + 1:]
    if "$" in tail or "`" in tail:
        return f"`{cmd}` rule whose argument interpolates (`$` or backtick)"
    args = [a for a in tail.split() if a not in ("*", ":*")]
    if cmd == "kubectl":
        first = next((a for a in args if not a.startswith("-")), None)
        if first and first.rstrip(":*") in KUBECTL_MUTATING:
            return f"`kubectl {first.rstrip(':*')}` is a mutating verb"
    if not [a for a in args if not a.startswith("-")]:
        # curl/wget carrying a scheme are the documented exception — the URL IS the constraint.
        if cmd in ("curl", "wget") and "://" in tail:
            return None
        return f"broad `{cmd}` rule — no positional argument"
    return None


def _isd_reason(cmd, c):
    if _bare_forms(cmd, c):
        return f"broad `{cmd}` rule — grants arbitrary code execution"
    if not c.startswith(cmd + " "):
        return None
    tail = c[len(cmd) + 1:]
    if not tail.startswith("-"):
        return None                                  # a constrained tail survives the filter
    if DASH_M_OK.match(tail[:-1] if tail.endswith("*") else tail):
        return None                                  # `python -m pkg.module *` — documented
    return f"`{cmd}` rule whose argument starts with a flag"


def _sn(content):
    """`_sn(ruleContent, iSd)` — the reason this rule content is dropped, or None if it survives."""
    c = " ".join(content.strip().lower().split())
    if c == "*":
        return "the unanchored wildcard `*`"
    for cmd in _NSD_SORTED:
        r = _nsd_reason(cmd, c)
        if r is not None:
            return r
    for cmd in _ISD_SORTED:
        r = _isd_reason(cmd, c)
        if r is not None:
            return r
    return None


def drop_reason(rule, classify_all_shell=False):
    """Why auto mode deletes this allow rule, or None if it survives into an auto session.

    `gsn(e,t)` gates on the tool: only Bash rules reach `_sn`. `PHs` drops every Agent rule
    whatever its specifier, and `qNt` drops every Bash AND PowerShell rule outright when any
    settings source sets `autoMode.classifyAllShell`.
    """
    m = RULE_RE.match(rule)
    tool, content = (m.group(1), m.group(2)) if m else (rule.strip(), None)
    if tool == "Agent":
        return "every `Agent` allow rule is dropped in auto mode, whatever its specifier"
    if tool in ("Bash", "PowerShell"):
        if classify_all_shell:
            return f"`autoMode.classifyAllShell` drops EVERY {tool} allow rule"
        if tool != "Bash":
            return None
        if content is None or content == "":
            return "bare `Bash` — an empty specifier grants every command"
        if re.fullmatch(r"[\s*]+", content):
            return "a specifier of only whitespace and `*` grants every command"
        return _sn(content)
    return None


def _classify_all_shell(paths):
    """`ZLi()` — true when ANY settings source sets `autoMode.classifyAllShell`. Sources it
    cannot read are reported by the caller, never silently treated as false."""
    for p in paths:
        try:
            with open(p, encoding="utf-8") as fh:
                o = json.load(fh)
        except Exception:
            continue
        if isinstance(o, dict) and (o.get("autoMode") or {}).get("classifyAllShell") is True:
            return p
    return None


def drop_report():
    """The auto-mode audit. Read-only by construction — there is no apply arm."""
    files = _settings_files(("settings.json", "settings.local.json"))
    print("── AUTO-MODE DROP AUDIT (read-only — this mode never writes) ──")
    print(f"  scope: {len(files)} settings file(s)")
    if not files:
        print("  no settings file found. This is NOT an all-clear — it is a blind report.")
        return 0
    cas = _classify_all_shell(files)
    if cas:
        print(f"  ⚠ autoMode.classifyAllShell is set in {cas}")
        print("    ⇒ EVERY Bash and PowerShell allow rule is dropped, however narrow.")
    total = dropped_total = failed = 0
    for path in files:
        try:
            with open(path, encoding="utf-8") as fh:
                obj = json.load(fh)
        except Exception as e:
            print(f"  ⚠ SKIP (unreadable/invalid JSON): {path}: {e}")
            failed += 1
            continue
        allow = ((obj.get("permissions") or {}).get("allow")) if isinstance(obj, dict) else None
        if not isinstance(allow, list):
            continue
        total += len(allow)
        dead = [(r, why) for r in allow
                for why in (drop_reason(r, classify_all_shell=bool(cas)),) if why]
        if not dead:
            print(f"\n  {path}  ({len(allow)} entries, none dropped)")
            continue
        dropped_total += len(dead)
        live = len(allow) - len(dead)
        print(f"\n  {path}  ({len(allow)} entries → {live} survive auto mode, {len(dead)} dropped)")
        by_reason = collections.Counter(why for _, why in dead)
        for rule, why in dead:
            print(f"    - {rule[:100]}   [{why}]")
        print("    ── by reason ──")
        for why, n in by_reason.most_common():
            print(f"    {n:5d}  {why}")
    pct = f"{100 * dropped_total / total:.1f}%" if total else "n/a"
    print(f"\n  {dropped_total} of {total} allow entr(ies) are INERT in auto mode ({pct})")
    print("  They are restored on leaving auto mode, so this is a rewrite list, not a delete")
    print("  list: replace each with the narrowest form that survives — `<cmd> <subcmd>:*`.")
    print("  Nothing was written. This mode has no apply arm; the edit is the operator's.")
    return 1 if failed else 0


def main():
    if DROP:
        # Before load_rules(), for the same two reasons --prune is: the audit must not require
        # ~/.claude/settings.json to exist, and must not spend a minute on a corpus it never reads.
        sys.exit(drop_report())
    if PRUNE:
        # Before load_rules(): a prune must not depend on ~/.claude/settings.json existing,
        # and must not spend a minute scanning the transcript corpus it does not read.
        sys.exit(prune_report())
    allow, deny, ask = load_rules()
    files = glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl"))
    files += glob.glob(os.path.expanduser("~/.claude-next/projects/*/*.jsonl"))
    if DAYS:
        import time

        cutoff = time.time() - DAYS * 86400
        files = [f for f in files if os.path.getmtime(f) >= cutoff]

    total = 0
    unmatched = collections.Counter()
    matched = 0
    hit_ask = collections.Counter()
    hit_deny = collections.Counter()
    examples = {}

    for f in files:
        try:
            for ln in open(f, errors="ignore"):
                if '"Bash"' not in ln:
                    continue
                try:
                    o = json.loads(ln)
                except Exception:
                    continue
                msg = o.get("message") or {}
                content = msg.get("content")
                if not isinstance(content, list):
                    continue
                for blk in content:
                    if not (
                        isinstance(blk, dict)
                        and blk.get("type") == "tool_use"
                        and blk.get("name") == "Bash"
                    ):
                        continue
                    cmd = (blk.get("input") or {}).get("command", "")
                    if not cmd:
                        continue
                    total += 1
                    if matches(cmd, ask):
                        hit_ask[head(cmd)] += 1
                        continue
                    if matches(cmd, deny):
                        hit_deny[head(cmd)] += 1
                        continue
                    if matches(cmd, allow):
                        matched += 1
                    else:
                        h = head(cmd)
                        unmatched[h] += 1
                        examples.setdefault(h, norm(cmd)[:110])
        except Exception:
            continue

    print(f"corpus: {len(files)} transcripts, {total} Bash invocations")
    print(f"rules:  allow={len(allow)} deny={len(deny)} ask={len(ask)}")
    if not total:
        print("no data")
        archive_report()   # the archive is independent of the transcript corpus
        return
    print(f"\nmatched an allow rule : {matched:6d}  ({100 * matched / total:.1f}%)")
    ua = sum(unmatched.values())
    print(
        f"matched NOTHING       : {ua:6d}  ({100 * ua / total:.1f}%)  <- prompt candidates (upper bound)"
    )
    print(f"hit an ASK rule       : {sum(hit_ask.values()):6d}  <- these SHOULD stop")
    print(f"hit a DENY rule       : {sum(hit_deny.values()):6d}")

    print(f"\n── TOP 25 PROMPT CANDIDATES (add these to permissions.allow) ──")
    print(f"{'count':>7}  {'head':<26} example")
    for h, n in unmatched.most_common(25):
        print(f"{n:7d}  {h:<26} {examples.get(h, '')[:80]}")

    if hit_ask:
        print(f"\n── ASK rules actually exercised (these are your REAL blocks) ──")
        for h, n in hit_ask.most_common(10):
            print(f"{n:7d}  {h}")

    archive_report()


if __name__ == "__main__":
    main()
