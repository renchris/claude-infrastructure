#!/usr/bin/env bash
# cc-cloud — the OFF-BOX session reconciler: one honest verdict per DECLARED cloud session,
# read ENTIRELY from the repo side.
#
#   cc-cloud preflight [--repo P] [--branch B]       can a fire HERE be observed at all? exit 1 = no
#   cc-cloud declare --id <id> --branch <b> [opts]   register a session BEFORE firing it
#   cc-cloud fill-paths --id <id> | --all            fill `paths=` POST-HOC from the VM's own commits
#   cc-cloud retire  --id <id>                       terminal; the id stops being reconciled
#   cc-cloud poll                                    advance the last-seen sidecar (the ONLY mutator)
#   cc-cloud is-offbox <id>                          exit 0 iff <id> is declared and not retired
#   cc-cloud show <id> | --item <backlog-id>         the declaration + its live state, human-readable
#                                                    (--item resolves through the declaration's own
#                                                    `item=` link; rc 1 = no declaration names it)
#   cc-cloud list [--json] [--state]                 the declaration inventory from DISK — no probe
#                                                    (--state opts INTO the state function, §9.3)
#   cc-cloud --json | --table | --check | --selftest
#
# ── ONE tool, because two reading one observable set is worse than either ─────────────────────────
# `bin/cc-cloud-watch` was an independent implementation of this same observable set, landed in the
# same commit (07f9707c) by a second session of the 9-way dispatch storm on backlog 191d4d056c98.
# Two tools over one observable set drift, and a caller cannot tell which is authoritative — so it
# was deleted and its two verbs that had no home here were migrated in (backlog 163676679912):
#   preflight  → here, verbatim in intent: the executable form of "design the observable set BEFORE
#                firing". Its load-bearing refusal is an UNPUSHED branch — a cloud VM clones from
#                the REMOTE, so local-only work is invisible to it and the session silently runs
#                against the default branch instead.
#   record     → `declare`, which was already a superset EXCEPT for one behaviour that is migrated
#                below: seeding `base_sha` from the live remote at fire time (see BASELINE).
#   list       → here, but factual rather than a cached verdict: see `cmd_list`.
#   observe    → `--json` / `--table`, which stay PURE READS (`poll` is the only sidecar mutator);
#                cc-cloud-watch's `observe` wrote its store as a side effect of rendering.
#   retire     → `retire --id`, unchanged.
# Its verdict vocabulary maps onto this state function with nothing lost: nofetch=U0 UNKNOWN,
# waiting=C2 BOOTING / C5 ALIVE, fresh=C5 after a poll advance, dark=C1 / C4 / C6, retired=retired.
#
# ── why this exists, and why it must be built BEFORE the first cloud session fires ───────────────
# A session running in an Anthropic-managed VM shares no kernel, no filesystem and no terminal with
# this box, so every local instrument the fleet is built on is blind to it: ps, lsof, kill -0,
# launchctl, load average, vm_stat, ~/.claude/cc-registry, ~/.claude/cc-beats, /tmp/cc-telemetry,
# and the iTerm2 pane id. Most of them go SILENT, which is survivable.
#
# Three of them do not go silent — they LIE, converting "not on this box" into "dead":
#   bin/cc-spawn-verify:89-97      argv scan of the LOCAL process table ⇒ exit 1 ABSENT,
#                                  "Died, or never launched", for a perfectly healthy cloud session.
#   bin/cc-board:126-141           a registry row with no local telemetry whose pid fails `kill -0`
#                                  is printed DIED-UNRENDERED — a fabricated death verdict.
#   scripts/team-orphan-reaper.sh:61-70   treats a failed `kill -0` as "POSITIVE evidence of death"
#                                  and ARCHIVES the team. Destructive, on a 600s launchd timer.
# That is the real hazard, and it is why the observable set is designed before firing rather than
# after: a false death is not recoverable by looking harder, and `is-offbox` below is the lookup
# those three need in order to abstain instead of convict.
#
# The second reason for "before, not after": ATTRIBUTION CANNOT BE RETROFITTED. A cloud session that
# pushed nothing and was never declared leaves zero trace anywhere this box can read — no transcript
# under ~/.claude/projects, no registry row, no backlog write (the store is
# ~/.claude/autonomy/backlog.jsonl and `git ls-files autonomy/` is 0 — a cloud VM cannot reach it).
# There is no forensic path back. The declaration has to exist at fire time or the session is
# permanently unobservable.
#
# ── the observable set (measured on this box 2026-08-07; see docs/plans/CLOUD_OBSERVABILITY.md) ───
#   O1 remote ref exists      `git ls-remote --heads <remote> <branch>`   the VM booted, had network
#                             + auth, and got far enough to push.
#   O2 remote ref ADVANCES    sha delta vs the sidecar                    the only heartbeat there is.
#   O3 `Claude-Session:` trailer on the commit                            which cloud session, + the
#                             URL to open. VERSION-GATED — see `trailer_supported` below.
#   O4 landed on trunk BY CONTENT  `git ls-tree <trunk> -- <path>`        completion. Never by count:
#                             a count reads 0 after a sibling rebase and proves nothing.
#   O5 PR state               `gh pr list --head <branch>`                a durable review handle.
# The web UI (claude.ai/code) is REAL. The claim that used to stand here — "no CLI or API on either
# binary this box has (2.1.114 pinned, 2.1.220 present — neither exposes a `--cloud` verb)" — is
# RETRACTED as of 2026-08-07: `--cloud` is genuinely absent on the pinned 2.1.114 but present and
# HIDDEN on 2.1.215/219/220, so `claude --help` (how it was measured) is structurally incapable of
# seeing it. See docs/plans/CLOUD_OBSERVABILITY.md §6.1-6.7 + §7.1 for the parser probes and controls.
#
# What survives that retraction, and why recover_cmd is still `open <url>`: a cloud session cannot be
# FIRED programmatically from this box today. Both programmatic routes need one web-only operator
# action (CLI create → connect GitHub at claude.ai/code; routines `/fire` → mint a per-routine bearer
# token), and interactive attach is refused `not enabled for your account` on ALL FOUR accounts — an
# Anthropic-side rollout. So the web UI remains the OPERATOR escalation path in practice.
#
# One capability IS now available and is NOT an `open <url>`: the headless send arm
# `claude -p "<msg>" --cloud <id> --output-format json` (no TTY; the bundle calls it
# `cloud_attach_headless`). It needs a live session id, so it is reachable only once a fire happens.
# Design for wiring it into cc-notify: CLOUD_OBSERVABILITY.md §9.2 — and note §8.1: `declare` before
# fire is UNSATISFIABLE on both real routes, because the id is a RETURN VALUE of the fire.
#
# ── the discriminator this whole file is built around (measured, not assumed) ─────────────────────
#   git ls-remote, remote REACHABLE + ref absent   → rc=0,   empty stdout
#   git ls-remote, remote UNREACHABLE              → rc=128, empty stdout
# Both are empty. A `[ -z "$out" ]` test conflates them, and that conflation would convict a live
# cloud session as NOT-STARTED on a wifi blip. THE EXIT CODE IS THE ONLY DISCRIMINATOR: rc!=0 yields
# UNKNOWN and never a verdict (the repo's own "no sensor, no verdict" law, at the one place it is
# easy to get wrong).
#
# ── the state function (total, first match wins, every arm TERMINAL) ─────────────────────────────
#   U0 UNKNOWN      a sensor could not run (ls-remote rc!=0, unreadable declaration, no git).
#                   NO row, `--table` says UNKNOWN, `--check` FAILS. Never a vacuous pass.
#   C1 NOT-STARTED  no ref (or the ref is STILL at its fire-time sha), past declared_at+boot_s  ROW
#   C2 BOOTING      same, still inside the boot budget — expected, not a fault              no row
#   C3 LANDED       every declared path is content-present on the trunk ref                 no row
#   C4 STALLED      ref exists, sha unchanged for > stall_s (sidecar evidence REQUIRED)       ROW
#   C5 ALIVE        ref exists and advanced inside the budget                               no row
#   C6 ABANDONED    ref exists, not landed, past life_s                                       ROW
#   C7 VANISHED     no ref NOW, but one was OBSERVED before — pushed, then the branch went     ROW
#                   away, and its content is not on trunk. Work that may be lost.
#
# ── 🚨 C7, AND WHY "NO REF" WAS NEVER ONE FACT (backlog f85fce7c26f5, 2026-08-25) ────────────────
# `sha == ""` is an AMBIGUOUS value and this file used to read exactly one of its causes. Enumerate
# every way to produce it (method 184 — a row that says "X is indistinguishable from Y" is written
# from the ONE path its author observed, so count the paths):
#   P1 the VM never booted, or booted and pushed nothing            ⇒ genuinely NOT-STARTED
#   P2 it pushed, the work LANDED, and the branch was then PRUNED   ⇒ the session SUCCEEDED
#   P3 it pushed, the branch was deleted, nothing reached trunk     ⇒ the work is LOST
#   P4 the remote could not be read                                 ⇒ U0, already discriminated by rc
# P1 and P2 are the SAME BYTES on the wire. Measured here: 54 landed branches were pruned on
# 2026-08-19, and every one of them flipped from LANDED to NOT-STARTED at that instant — which is a
# state machine running BACKWARD, and it is not cosmetic. `cc-backlog`'s cloud_map reads
# NOT-STARTED as `open` ("nobody is working this, so it returns to the wave") and LANDED as `done`,
# so a pruned success is RE-DISPATCHED: a fresh cloud slot and real quota spent re-doing work that
# is already on trunk. Worse, the LANDED arm below is only reachable while the ref still exists, so
# after a prune `done` is STRUCTURALLY UNREACHABLE for that session, forever.
# THE TWO DISCRIMINATORS, and both were already on disk before this arm used them:
#   D1 content on the trunk ref (`landed()`)  — separates P2. It is the same evidence C3 uses; it
#      was simply being asked AFTER the absent-ref arm had already returned a verdict.
#   D2 the heartbeat sidecar `<id>.seen`      — `poll` writes it only from a ref it actually read,
#      and NEVER clears it on a no-ref pass, so a recorded sha is durable positive proof that the
#      branch once existed. Guarded against the re-used-branch case: a sidecar holding the
#      FIRE-TIME sha proves the branch existed, not that this session pushed, so it does not count.
# D2 without D1 is C7 VANISHED — a row, because "a VM pushed and the branch is gone" is precisely
# the event that must not be silent. VANISHED is deliberately NOT mapped by any consumer yet: every
# one of them (cc-backlog's cloud_state, custody-deathwatch's peer_disposition, cc-offload's
# palette) already routes an unmodelled token to "cannot tell" and abstains, which is the fail-SAFE
# direction and, for cc-backlog, is the whole point — it stops the false reopen without inventing a
# close. What VANISHED should MEAN to the reap is a separate decision with a real cost either way.
#
# ── BASELINE: why C1/C2 also fire on a ref that EXISTS (migrated from cc-cloud-watch `record`) ────
# `declare` probes the remote once and records the sha the branch held BEFORE the fire. Without it,
# declaring against a branch name that already exists reads C5 ALIVE from the instant of the
# declaration and stays silent for the whole life_s budget (6h by default) — the single most likely
# real failure, a session that never boots onto a re-used branch name, hidden for six hours behind
# a green verdict. With it, "the session has produced nothing" is `sha == base_sha`, which is the
# same fact as "no ref" and takes the same two arms.
# The baseline is MEASURED, never assumed: `base_probe=ok` is written only when the fire-time probe
# actually answered. If it could not run, the key is ABSENT and this arm abstains entirely rather
# than treating an unmeasured baseline as an empty one — the same law as U0 one level down.
# It is checked AFTER C3: a session whose declared content is on trunk is finished, and how its ref
# moved is no longer a question worth alarming on.
#
# C3 precedes C4 DELIBERATELY: a finished session stops pushing, so a STALLED-first order would
# alarm forever on every successful cloud session — the failure mode where an alarm that always
# fires carries the same zero bits as one that never fires.
# C4 claims STALLED only with sidecar HISTORY. With no history there is no evidence the sha ever
# differed, so no verdict is available and none is invented.
#
# ── row schema (matches bin/cc-fleet's FROZEN shape so cc-blockers can consume it unchanged) ─────
# {"kind":"cloud-session","state":"<S>","detail":"<ascii, <=44 bytes>","subject":"<id>",
#  "recover_cmd":"<paste-ready>","ts":<epoch>}
# state ∈ NOT-STARTED|STALLED|ABANDONED|VANISHED.  `detail` is ASCII-only and <=44 bytes: the board's
# renderer pads by BYTES, so one em-dash silently shifts the column.
#
# READ-ONLY against the network and against the git repo. `git ls-remote` performs no fetch and
# writes no ref. The only bytes this program writes are its own declarations and sidecars under
# CC_CLOUD_STATE, and only `declare` / `retire` / `poll` write at all.
#
# Env seams (the override surface is what makes --selftest and the suite hermetic):
#   CC_CLOUD_STATE     declaration dir (~/.claude/autonomy/cloud)   CC_CLOUD_NOW    epoch override
#   CC_CLOUD_GIT_BIN   git binary (git)                             CC_CLOUD_RECONCILE  on|off
#   CC_CLOUD_BOOT_S    default boot budget (900)                    CC_CLOUD_STALL_S    (3600)
#   CC_CLOUD_LIFE_S    default lifetime budget (21600)              CC_CLOUD_NET_TIMEOUT_S (20)
set -uo pipefail

SELF="$0"
while [ -L "$SELF" ]; do
  _link="$(readlink "$SELF")"
  case "$_link" in
    /*) SELF="$_link" ;;
    *)  SELF="$(dirname "$SELF")/$_link" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

STATE="${CC_CLOUD_STATE:-$HOME/.claude/autonomy/cloud}"
GIT_BIN="${CC_CLOUD_GIT_BIN:-git}"
RECONCILE="${CC_CLOUD_RECONCILE:-on}"
DEF_BOOT="${CC_CLOUD_BOOT_S:-900}"
DEF_STALL="${CC_CLOUD_STALL_S:-3600}"
DEF_LIFE="${CC_CLOUD_LIFE_S:-21600}"
NET_TIMEOUT="${CC_CLOUD_NET_TIMEOUT_S:-20}"
DETAIL_MAX=44

now() { if [ -n "${CC_CLOUD_NOW:-}" ]; then printf '%s' "$CC_CLOUD_NOW"; else date +%s; fi; }

# ── helpers ──────────────────────────────────────────────────────────────────────────────────────
jesc() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }
is_num() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac; return 0; }

# Bound `detail` by BYTES, not characters, and only ever at a byte boundary we chose.
clip() { local s="$1"; if [ "${#s}" -le "$DETAIL_MAX" ]; then printf '%s' "$s"; else printf '%s' "${s:0:$DETAIL_MAX}"; fi; }

# A human duration for `detail`, kept short so the 44-byte budget survives a long id.
dur() { # <seconds> → 45s | 12m | 3h | 2d
  local s="${1:-0}"
  if [ "$s" -lt 60 ]; then printf '%ss' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%sm' "$((s / 60))"
  elif [ "$s" -lt 86400 ]; then printf '%sh' "$((s / 3600))"
  else printf '%sd' "$((s / 86400))"; fi
}

# Declarations are `key=value`, one per line, values never containing a newline. Read WITHOUT eval:
# a declaration is data written by a dispatcher, and `eval` on it would be an injection seam.
dfield() { # <file> <key> → value (empty if absent)
  local f="$1" k="$2" line
  [ -f "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$k="*) printf '%s' "${line#*=}"; return 0 ;; esac
  done < "$f"
  return 0
}

ids() { # every declared, non-retired id, sorted
  local f b
  [ -d "$STATE" ] || return 0
  for f in "$STATE"/*.decl; do
    [ -f "$f" ] || continue
    b="${f##*/}"; b="${b%.decl}"
    [ -f "$STATE/$b.retired" ] && continue
    printf '%s\n' "$b"
  done | sort
}

# ── id_for_item — the BACKLOG-SIDE lookup, so a caller holding a work item can reach its session ──
# `cc-cloud declare --item <backlog-id>` already records the link (cc-dispatch writes it on every
# off-box fire); nothing could READ it back, so a caller holding a backlog row had no way to name
# the session that is working it. That gap is why cc-backlog's reap blocked every venue=cloud claim:
# the only oracle it could reach was the LOCAL worktree probe, which by construction cannot see an
# off-box worker (see cc-backlog's owned_wait venue gate).
#
# RETIRED DECLARATIONS ARE DELIBERATELY NOT SKIPPED here, unlike `ids()`. `ids()` feeds the
# reconciler, where a retired session is finished business; this feeds a caller asking "what
# happened to my item", and "the session that worked it was retired" is an ANSWER — `cmd_show`
# renders the .retired record, and `classify` still computes the live state. Skipping them would
# convert a terminal answer into ABSENCE, which every caller must treat as "cannot tell".
#
# NEWEST DECLARATION WINS. A re-fire mints a second declaration naming the same item, and the one
# that describes the live attempt is the one declared LAST. Ties (equal declared_at) resolve by the
# glob's sort order — deterministic, and a tie means two fires in the same second, which the
# dispatcher's own lock makes unreachable.
id_for_item() { # <backlog-item-id> → echoes the declaration id, rc 0; rc 1 = NO declaration names it
  local item="$1" f b dat best="" bestat=-1
  [ -n "$item" ] || return 1
  [ -d "$STATE" ] || return 1
  for f in "$STATE"/*.decl; do
    [ -f "$f" ] || continue
    [ "$(dfield "$f" item)" = "$item" ] || continue
    dat="$(dfield "$f" declared_at)"; is_num "$dat" || dat=0
    if [ "$dat" -gt "$bestat" ]; then
      bestat="$dat"; b="${f##*/}"; best="${b%.decl}"
    fi
  done
  [ -n "$best" ] || return 1
  printf '%s\n' "$best"
}

# The network sensor. Returns rc 0 with the sha on stdout (ref present), rc 0 with EMPTY stdout
# (remote reachable, ref absent), or rc 2 (SENSOR FAILED — never to be read as absence).
NET_BOUND=""
if command -v timeout >/dev/null 2>&1; then NET_BOUND="timeout"
elif command -v gtimeout >/dev/null 2>&1; then NET_BOUND="gtimeout"; fi
remote_sha() { # <repo-path-or-empty> <remote> <branch>
  local repo="$1" remote="$2" branch="$3" out rc
  local -a cmd=()
  [ -n "$NET_BOUND" ] && cmd=("$NET_BOUND" "$NET_TIMEOUT")
  if [ -n "$repo" ] && [ -d "$repo" ]; then
    cmd+=("$GIT_BIN" -C "$repo" ls-remote --heads "$remote" "refs/heads/$branch")
  else
    cmd+=("$GIT_BIN" ls-remote --heads "$remote" "refs/heads/$branch")
  fi
  # GIT_TERMINAL_PROMPT=0 is the difference between a bounded failure and an indefinite hang on a
  # credential prompt, which no timeout on a parent can help with once git owns the tty.
  out="$(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/true "${cmd[@]}" 2>/dev/null)"; rc=$?
  [ "$rc" -eq 0 ] || return 2
  printf '%s' "${out%%[[:space:]]*}"
  return 0
}

# O4: landed BY CONTENT. `git ls-tree <trunk> -- <path>` per declared path — the repo's own rule,
# because `rev-list --count` reads 0 after a sibling rebase and proves nothing (scripts/land-verify.sh:6-11).
landed() { # <repo> <trunk-ref> <comma-separated-paths> → 0 landed, 1 not, 2 cannot tell
  local repo="$1" trunk="$2" paths="$3" p rest out
  [ -n "$paths" ] || return 1                       # nothing declared ⇒ landing is not assertable
  [ -n "$repo" ] && [ -d "$repo" ] || return 2
  "$GIT_BIN" -C "$repo" rev-parse --verify --quiet "$trunk" >/dev/null 2>&1 || return 2
  rest="$paths"
  while [ -n "$rest" ]; do
    case "$rest" in *,*) p="${rest%%,*}"; rest="${rest#*,}" ;; *) p="$rest"; rest="" ;; esac
    [ -n "$p" ] || continue
    out="$("$GIT_BIN" -C "$repo" ls-tree "$trunk" -- "$p" 2>/dev/null)" || return 2
    [ -n "$out" ] || return 1
  done
  return 0
}

# ── fill-paths — the POST-HOC path set, derived from the VM's own commits ────────────────────────
# THE DEFECT THIS CLOSES (backlog a435e3987fbf; CLOUD_OBSERVABILITY.md §13.5 closing ⚠️). `landed()`
# above returns "not landed" on an EMPTY path list by design — nothing declared means landedness is
# not assertable — and `cc-offload up` declares `paths=` empty, because at fire time the dispatcher
# does not know what the VM will write. So every cloud result read ELIGIBLE forever: C3 could never
# fire, `cc-offload land --all` re-attempted finished work on every sweep, and the re-attempt was
# harmless only because the lander itself noticed ("origin/main already contains HEAD").
#
# THE FIX IS A FILL, NOT A WIDER `landed()`. Weakening landed() to "empty ⇒ landed" would convert
# every unobservable session into a finished one — the exact absence-is-evidence inversion this file
# exists to refuse. What was actually missing is the DATA: after the VM has pushed, its own commits
# state the path set exactly, so the answer is derivable and there is no need to have predicted it.
#
# TWO RULES, and both are load-bearing:
#   1. DELETIONS ARE EXCLUDED (`--diff-filter=d`, i.e. drop D). A path the branch DELETES is in its
#      diff and is by construction absent from the trunk tree after a perfect land, so including it
#      would manufacture a declaration that can never read LANDED — the same never-satisfiable
#      verdict this change exists to remove, re-created from the other side.
#   2. AN EMPTY RESULT IS NEVER WRITTEN. A delete-only branch (or a range that cannot be bounded)
#      leaves `paths=` untouched and exits non-zero, so "not assertable" stays honest instead of
#      becoming a silent empty write that reads exactly like the bug.
# The range is bounded at the merge-base with the trunk: an unbounded `--name-only` over the whole
# history would claim every file the repo has ever had.
PATHS_DETAIL=""
branch_paths() { # <repo> <trunk-ref> <ref> → 0 + comma-list on stdout · 2 cannot tell · 4 empty set
  local repo="$1" trunk="$2" ref="$3" base out
  PATHS_DETAIL=""
  [ -n "$repo" ] && [ -d "$repo" ] || { PATHS_DETAIL="no readable repo"; return 2; }
  "$GIT_BIN" -C "$repo" rev-parse --verify --quiet "$ref" >/dev/null 2>&1 || {
    PATHS_DETAIL="'$ref' does not resolve in $repo — fetch the branch first"; return 2; }
  base="$("$GIT_BIN" -C "$repo" merge-base "$trunk" "$ref" 2>/dev/null)" || base=""
  [ -n "$base" ] || { PATHS_DETAIL="no merge-base between $trunk and $ref — the range cannot be bounded"; return 2; }
  out="$("$GIT_BIN" -C "$repo" diff --name-only --diff-filter=d "$base" "$ref" 2>/dev/null)" || {
    PATHS_DETAIL="git diff --name-only failed over $base..$ref"; return 2; }
  # A path containing a comma would be split by the reader's own separator, and a quoted path
  # (core.quotepath) is not a path at all. Neither is silently dropped: they make the fill abstain.
  case "$out" in *,*|*'"'*) PATHS_DETAIL="a changed path contains a comma or is quoted; the declaration's comma-separated list cannot represent it"; return 2 ;; esac
  out="$(printf '%s' "$out" | tr '\n' ',' | sed 's/,$//')"
  [ -n "$out" ] || { PATHS_DETAIL="the range adds or modifies NO file (delete-only, or empty) — landedness by content is not assertable for it"; return 4; }
  printf '%s' "$out"
  return 0
}

# Rewrite ONE key in a declaration, atomically, preserving every other line and its order. `declare`
# is the only other writer and it writes the whole file, so a partial-write here would be the one
# way this store could be corrupted — hence temp + mv rather than an in-place edit.
decl_set() { # <file> <key> <value>
  local f="$1" k="$2" v="$3" tmp line wrote=0
  tmp="$f.tmp.$$"
  : >"$tmp" || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$k="*) printf '%s=%s\n' "$k" "$v" >>"$tmp"; wrote=1 ;;
      *)      printf '%s\n' "$line" >>"$tmp" ;;
    esac
  done < "$f"
  [ "$wrote" -eq 1 ] || printf '%s=%s\n' "$k" "$v" >>"$tmp"
  mv "$tmp" "$f" 2>/dev/null || { rm -f "$tmp"; return 1; }
  return 0
}

# 🚨 THE DERIVATION AND THE WRITE ARE SEPARABLE, AND THEY MUST BE — measured 2026-08-11 on the first
# live managed round trip. The range is bounded at the merge-base with the TRUNK, so the moment the
# land succeeds the branch's commits ARE on trunk, `merge-base(trunk, ref) == ref`, and the range is
# EMPTY. A post-hoc fill is therefore self-defeating in exactly the case it exists for: it read
# "adds or modifies no file" over a branch that had just landed one, and refused (correctly, since
# writing an empty set is the bug it was built to remove).
# So a caller that lands does BOTH halves at the right moments: `--print` while the branch is still
# ahead of trunk, and `--set` once the land has succeeded. `--id` alone stays the right call for a
# branch that has NOT landed yet, and it now NAMES this cause rather than reporting a bare emptiness.
# The suite missed this because its lander stub never advanced trunk — a control that does not
# replay the real post-land artifact cannot fail the way production does
# (memory: control-must-replay-the-real-artifact).
cmd_fill_paths() {
  local id="" all=0 force=0 rc=0 worst=0 n_filled=0 print_only=0 set_to="" have_set=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) id="${2:-}"; shift 2 ;;
      --all) all=1; shift ;;
      --force) force=1; shift ;;
      --print) print_only=1; shift ;;
      --set) set_to="${2:-}"; have_set=1; shift 2 ;;
      *) echo "cc-cloud fill-paths: unknown arg $1" >&2; return 2 ;;
    esac
  done
  if [ "$have_set" -eq 1 ]; then
    [ -n "$id" ] || { echo "cc-cloud fill-paths: --set needs --id" >&2; return 2; }
    [ -f "$STATE/$id.decl" ] || { echo "cc-cloud fill-paths: no such declaration: $id" >&2; return 1; }
    # The never-empty rule binds here too: a caller whose derivation came back empty must not be
    # able to launder that into a written empty set through the other door.
    [ -n "$set_to" ] || { echo "cc-cloud fill-paths: refusing to write an EMPTY path set for $id (not assertable is not the same as landed)" >&2; return 4; }
    # The newline guard is written as a LITERAL, for the reason `cmd_declare` records ten lines
    # further down and this arm re-learned the hard way: `$(printf '\n')` strips the very newline it
    # is testing for and collapses to "", so the pattern becomes *""* and matches EVERY input — a
    # guard that rejects everything reads exactly like a guard that works, and it refused the first
    # real path set it was ever handed.
    local NL='
'
    case "$set_to" in *"$NL"*) echo "cc-cloud fill-paths: newline in the path set" >&2; return 2 ;; esac
    decl_set "$STATE/$id.decl" paths "$set_to" || return 1
    decl_set "$STATE/$id.decl" paths_src "caller-derived-pre-land" || true
    decl_set "$STATE/$id.decl" paths_at "$(now)" || true
    printf '✓ %s — paths=%s (derived before the land, written after it)\n' "$id" "$set_to"
    return 0
  fi
  [ -n "$id" ] || [ "$all" -eq 1 ] || { echo "cc-cloud fill-paths: --id <id> or --all is required" >&2; return 2; }

  local one f repo trunk remote branch cur out ref cand
  while IFS= read -r one; do
    [ -n "$one" ] || continue
    f="$STATE/$one.decl"
    [ -f "$f" ] || { echo "cc-cloud fill-paths: no such declaration: $one" >&2; worst=1; continue; }
    cur="$(dfield "$f" paths)"
    if [ -n "$cur" ] && [ "$force" -eq 0 ] && [ "$print_only" -eq 0 ]; then
      printf '· %s — paths already declared (%s); not overwriting (--force to re-derive)\n' "$one" "$cur"
      continue
    fi
    repo="$(dfield "$f" repo)"
    remote="$(dfield "$f" remote)"; [ -n "$remote" ] || remote="origin"
    branch="$(dfield "$f" branch)"
    trunk="$(dfield "$f" trunk)"; [ -n "$trunk" ] || trunk="origin/main"
    # The LOCAL head first, then the remote-tracking ref. The local one is what the lander fetched
    # and re-authored, so after a land it is the range that actually went to trunk; the tracking ref
    # is the fallback for a branch that has been fetched but not landed.
    ref=""
    for cand in "refs/heads/$branch" "refs/remotes/$remote/$branch"; do
      "$GIT_BIN" -C "${repo:-.}" rev-parse --verify --quiet "$cand" >/dev/null 2>&1 && { ref="$cand"; break; }
    done
    if [ -z "$ref" ]; then
      printf '✗ %s — neither refs/heads/%s nor refs/remotes/%s/%s resolves in %s; nothing derived (paths left EMPTY, which stays honest)\n' \
        "$one" "$branch" "$remote" "$branch" "${repo:-.}" >&2
      worst=2; continue
    fi
    out="$(branch_paths "$repo" "$trunk" "$ref")"; rc=$?
    if [ "$rc" -ne 0 ]; then
      # NAME THE COMMONEST CAUSE. An empty range over a branch that has ALREADY landed is not the
      # same fact as a delete-only branch, and reporting them identically is what made the first
      # live failure read as "the VM wrote nothing" instead of "you asked too late".
      if [ "$rc" -eq 4 ] && "$GIT_BIN" -C "${repo:-.}" merge-base --is-ancestor "$ref" "$trunk" 2>/dev/null; then
        printf '✗ %s — %s is ALREADY on %s, so the range against the trunk is empty. The path set has to be derived BEFORE the land (fill-paths --print) and written after it (--set).\n' \
          "$one" "$ref" "$trunk" >&2
      else
        printf '✗ %s — %s\n' "$one" "$PATHS_DETAIL" >&2
      fi
      [ "$worst" -lt "$rc" ] && worst="$rc"
      continue
    fi
    if [ "$print_only" -eq 1 ]; then printf '%s\n' "$out"; continue; fi
    decl_set "$f" paths "$out" || { echo "cc-cloud fill-paths: could not write $f" >&2; worst=1; continue; }
    decl_set "$f" paths_src "vm-commits:$ref" || true
    decl_set "$f" paths_at "$(now)" || true
    n_filled=$((n_filled + 1))
    printf '✓ %s — paths=%s (from %s, deletions excluded)\n' "$one" "$out" "$ref"
  done <<EOF
$([ -n "$id" ] && printf '%s\n' "$id" || ids)
EOF
  [ "$all" -eq 1 ] && printf 'fill-paths: %d filled.\n' "$n_filled"
  return "$worst"
}

# O3 is version-gated and the gate is MEASURED, never assumed: the `Claude-Session:` trailer exists
# in 2.1.220 (default on, emitted for web and Remote Control sessions) and does NOT exist in the
# pinned 2.1.114. A design that hardcoded "the trailer is available" would be wrong on the very
# binary the launcher runs.
trailer_supported() { # <claude-binary> → 0 yes, 1 no, 2 cannot tell
  local bin="${1:-}"
  [ -n "$bin" ] && [ -f "$bin" ] || return 2
  command -v strings >/dev/null 2>&1 || return 2
  { strings -a "$bin" 2>/dev/null || true; } | grep -q 'Claude-Session' && return 0
  return 1
}

# ── the state function ───────────────────────────────────────────────────────────────────────────
# Emits: <state>\t<detail>\t<recover_cmd>  — exactly one line per id, always.
classify() { # <id>
  local id="$1" f="$STATE/$1.decl" seen="$STATE/$1.seen"
  local branch remote repo paths trunk url dat boot stall life
  local sha rc n age url_cmd first_seen sha_age base_sha base_probe lrc last_sha

  branch="$(dfield "$f" branch)"
  remote="$(dfield "$f" remote)"
  repo="$(dfield "$f" repo)"
  paths="$(dfield "$f" paths)"
  trunk="$(dfield "$f" trunk)";       [ -n "$trunk" ] || trunk="origin/main"
  url="$(dfield "$f" url)";           [ -n "$url" ] || url="https://claude.ai/code"
  dat="$(dfield "$f" declared_at)"
  boot="$(dfield "$f" boot_s)";       is_num "$boot"  || boot="$DEF_BOOT"
  stall="$(dfield "$f" stall_s)";     is_num "$stall" || stall="$DEF_STALL"
  life="$(dfield "$f" life_s)";       is_num "$life"  || life="$DEF_LIFE"
  url_cmd="open $url"

  if [ -z "$branch" ] || [ -z "$remote" ] || ! is_num "$dat"; then
    printf 'UNKNOWN\tdeclaration unreadable or incomplete\t%s\n' "cc-cloud show $id"; return 0
  fi

  n="$(now)"; age=$((n - dat)); [ "$age" -lt 0 ] && age=0

  sha="$(remote_sha "$repo" "$remote" "$branch")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'UNKNOWN\tls-remote failed; remote unreachable\t%s\n' "$GIT_BIN ls-remote --heads $remote"
    return 0
  fi

  if [ -z "$sha" ]; then
    # THE REF IS ABSENT, AND THERE IS MORE THAN ONE WAY TO BE ABSENT — see C7 in the header. Ask
    # both discriminators BEFORE convicting the session of never having started, because "never
    # pushed" and "pushed, landed, pruned" are the same empty string on the wire.
    # D1 — content on trunk. Identical evidence to C3 below; only its POSITION was wrong. `landed()`
    # returns 1 on an empty path set, so this cannot pass vacuously for a session whose paths were
    # never filled.
    landed "$repo" "$trunk" "$paths"; lrc=$?
    if [ "$lrc" -eq 0 ]; then
      printf 'LANDED\tcontent on %s; branch since pruned\t-\n' "$trunk"; return 0
    fi
    # D2 — the heartbeat sidecar. `poll` writes it only from a ref it read, and leaves it untouched
    # on a no-ref pass, so a recorded sha OUTLIVES the branch. The base_sha guard is load-bearing:
    # on a re-used branch name the only sha ever observed can be the FIRE-TIME one, which proves the
    # branch existed and says nothing about this session — that case is P1, not P3.
    last_sha=""
    [ -f "$seen" ] && last_sha="$(dfield "$seen" sha)"
    base_probe="$(dfield "$f" base_probe)"
    base_sha="$(dfield "$f" base_sha)"
    if [ -n "$last_sha" ] && ! { [ "$base_probe" = "ok" ] && [ "$last_sha" = "$base_sha" ]; }; then
      # Two spellings, because rc 2 is "the trunk sensor could not run", never "not landed" — the
      # no-sensor-no-verdict law one level down, kept visible in the detail the board renders.
      if [ "$lrc" -eq 2 ]; then
        printf 'VANISHED\tref %.7s pushed, gone; trunk unread\t%s\n' "$last_sha" "$url_cmd"
      else
        printf 'VANISHED\tref %.7s pushed, gone, not on trunk\t%s\n' "$last_sha" "$url_cmd"
      fi
      return 0
    fi
    if [ "$age" -gt "$boot" ]; then
      printf 'NOT-STARTED\tno ref after %s (boot budget %s)\t%s\n' "$(dur "$age")" "$(dur "$boot")" "$url_cmd"
    else
      printf 'BOOTING\tno ref yet, %s into a %s budget\t-\n' "$(dur "$age")" "$(dur "$boot")"
    fi
    return 0
  fi

  # C3 before C4: a landed session has stopped pushing ON PURPOSE.
  landed "$repo" "$trunk" "$paths"; rc=$?
  if [ "$rc" -eq 0 ]; then
    printf 'LANDED\tcontent present on %s\t-\n' "$trunk"; return 0
  fi

  # BASELINE (C1/C2 for a ref that exists but has not MOVED since the fire). Only when the fire-time
  # probe actually answered: an unmeasured baseline abstains rather than being read as an empty one.
  base_probe="$(dfield "$f" base_probe)"
  base_sha="$(dfield "$f" base_sha)"
  if [ "$base_probe" = "ok" ] && [ -n "$base_sha" ] && [ "$sha" = "$base_sha" ]; then
    if [ "$age" -gt "$boot" ]; then
      printf 'NOT-STARTED\tref still at pre-fire sha after %s\t%s\n' "$(dur "$age")" "$url_cmd"
    else
      printf 'BOOTING\tno push yet, %s into a %s budget\t-\n' "$(dur "$age")" "$(dur "$boot")"
    fi
    return 0
  fi

  # C4 needs HISTORY. The sidecar records "sha X was first seen at T"; `poll` writes it.
  first_seen=""
  if [ -f "$seen" ]; then
    case "$(dfield "$seen" sha)" in
      "$sha") first_seen="$(dfield "$seen" since)" ;;
    esac
  fi
  if is_num "$first_seen"; then
    sha_age=$((n - first_seen)); [ "$sha_age" -lt 0 ] && sha_age=0
    if [ "$sha_age" -gt "$stall" ]; then
      printf 'STALLED\tref frozen at %.7s for %s\t%s\n' "$sha" "$(dur "$sha_age")" "$url_cmd"; return 0
    fi
  fi

  if [ "$age" -gt "$life" ]; then
    printf 'ABANDONED\talive %s, past %s, not landed\t%s\n' "$(dur "$age")" "$(dur "$life")" "$url_cmd"; return 0
  fi

  printf 'ALIVE\tref at %.7s\t-\n' "$sha"
  return 0
}

emit_rows() {
  local id line state detail rcmd n
  n="$(now)"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    line="$(classify "$id")"
    state="${line%%	*}"; line="${line#*	}"
    detail="${line%%	*}"; rcmd="${line#*	}"
    case "$state" in
      NOT-STARTED|STALLED|ABANDONED|VANISHED) ;;
      *) continue ;;
    esac
    printf '{"kind":"cloud-session","state":"%s","detail":"%s","subject":"%s","recover_cmd":"%s","ts":%s}\n' \
      "$state" "$(jesc "$(clip "$detail")")" "$(jesc "$id")" "$(jesc "$rcmd")" "$n"
  done < <(ids)
}

emit_table() {
  local id line state detail any=0
  printf '%-22s %-12s %s\n' "SESSION" "STATE" "DETAIL"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    any=1
    line="$(classify "$id")"
    state="${line%%	*}"; line="${line#*	}"
    detail="${line%%	*}"
    printf '%-22s %-12s %s\n' "$id" "$state" "$detail"
  done < <(ids)
  [ "$any" -eq 1 ] || printf '%s\n' "(no cloud sessions declared — nothing is firing off-box)"
}

# --check: exit 0 iff every declared session is in a state that needs nobody. UNKNOWN FAILS it —
# a check that could not run must never pass vacuously.
do_check() {
  local id line state bad=0
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    line="$(classify "$id")"; state="${line%%	*}"
    case "$state" in
      BOOTING|ALIVE|LANDED) ;;
      *) bad=1; printf '%s %s\n' "$state" "$id" >&2 ;;
    esac
  done < <(ids)
  return "$bad"
}

# ── mutating verbs ───────────────────────────────────────────────────────────────────────────────
cmd_declare() {
  local id="" branch="" remote="origin" repo="$ROOT" paths="" trunk="" url="" surface="" item="" account=""
  local boot="" stall="" life="" f base="" brc=0
  local notify_back="" goal="" goal_probe="" custody=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --id)      id="${2:-}"; shift 2 ;;
      --branch)  branch="${2:-}"; shift 2 ;;
      --remote)  remote="${2:-}"; shift 2 ;;
      --repo)    repo="${2:-}"; shift 2 ;;
      --paths)   paths="${2:-}"; shift 2 ;;
      --trunk)   trunk="${2:-}"; shift 2 ;;
      --url)     url="${2:-}"; shift 2 ;;
      --surface) surface="${2:-}"; shift 2 ;;
      # THE OWNING ACCOUNT. A session id is NOT a globally-addressable handle: measured 2026-08-08
      # (backlog 95422d3518bc), the same id from the owning account returns {ok:true} and from
      # another account returns {ok:false,"Session not found"} — a wrong-account send that reads as
      # a DEAD SESSION. Nothing downstream can recover that distinction without this field, so it
      # is recorded at declaration time or it is unrecoverable, exactly like the declaration itself.
      --account) account="${2:-}"; shift 2 ;;
      --item)    item="${2:-}"; shift 2 ;;
      # ── THE MANAGEMENT FIELDS (W2). A cloud fire had no return path into the machinery that
      # manages local work: no wake, no custody, no goal (CLOUD_BACKLOG_PIPELINE.md §2 rows 1-3).
      # All three are properties of the FIRE, so they are recorded where the fire's other
      # unrecoverable facts are — here, at declaration time — for the same reason the account is:
      # nothing downstream can reconstruct them, and the return path runs in a different process
      # minutes or hours later.
      #   --notify-back  the ORIGINATOR's pane uuid. The wake target; without it a completion has
      #                  nowhere to land and the originator can only poll.
      #   --goal         the measurable end state, in words, evaluated from THIS side.
      #   --goal-probe   the command that DECIDES it (exit 0 = met). Optional: with no probe the
      #                  end state is the landed-by-content verdict, which is the default goal of
      #                  every cloud fire and needs no restating.
      #   --custody      the custody marker this fire opened, so the return path can discharge the
      #                  exact debt rather than guessing at one.
      --notify-back) notify_back="${2:-}"; shift 2 ;;
      --goal)        goal="${2:-}"; shift 2 ;;
      --goal-probe)  goal_probe="${2:-}"; shift 2 ;;
      --custody)     custody="${2:-}"; shift 2 ;;
      --boot)    boot="${2:-}"; shift 2 ;;
      --stall)   stall="${2:-}"; shift 2 ;;
      --life)    life="${2:-}"; shift 2 ;;
      *) echo "cc-cloud declare: unknown arg $1" >&2; return 2 ;;
    esac
  done
  [ -n "$id" ] && [ -n "$branch" ] || { echo "cc-cloud declare: --id and --branch are REQUIRED (an undeclared cloud session is unobservable)" >&2; return 2; }
  case "$id" in *[!A-Za-z0-9._-]*) echo "cc-cloud declare: --id must be [A-Za-z0-9._-]+ (it is a filename)" >&2; return 2 ;; esac
  # The newline guard keeps the `key=value` store parseable. It is written as a literal because
  # `$(printf '\n')` strips the very newline it is testing for and collapses to "", which makes the
  # pattern `*""*` match EVERY input — a guard that rejects everything reads exactly like a guard
  # that works, and it passed this file's own selftest vacuously before the selftest grew a
  # positive control.
  local NL='
'
  # Every free-text field is guarded, not just the ones that existed when the guard was written: a
  # newline in ANY value breaks the `key=value` store's one-line-per-field invariant, and a guard
  # that enumerates the fields it knows about gets out-run by the next field added (memory:
  # denylist-enumerates-spellings-not-the-class).
  case "$branch$remote$paths$url$account$notify_back$goal$goal_probe$custody" in
    *"$NL"*) echo "cc-cloud declare: newline in a field" >&2; return 2 ;;
  esac
  # THE TRUNK REFUSAL (backlog 55065a61b31c). A cloud session declared against the remote's DEFAULT
  # branch makes O2 read every SIBLING session's push to that branch as this session's heartbeat —
  # measured 2026-08-08 as a false state=ALIVE, which is the one verdict the whole observability
  # stack must never fabricate (a stranded session is visible and recoverable; a session wrongly
  # reported alive is neither). The fire protocol wants a per-session ref
  # (CONCURRENCY_PROGRAM §S5a's refs/cc/<id>); until it has one, declaring against trunk is not a
  # thing to warn about, it is a thing to refuse.
  #
  # NOT A NAME LIST. Refusing the spellings `main`/`master`/`trunk` would be a denylist enumerating
  # spellings rather than the class, and would still miss a repo whose default is anything else
  # (memory: denylist-enumerates-spellings-not-the-class). The predicate is "is this ref the
  # remote's default", ASKED — and it is asked twice, of two independent resolvers, because either
  # can be blind: the remote may be unreachable, and a local checkout may have no
  # refs/remotes/<remote>/HEAD. Only when BOTH are blind does the guard abstain, and abstaining is
  # correct there: an undeclared session is unobservable, which is strictly worse than an
  # unverified branch choice — the same trade-off the baseline probe below already makes.
  local _def=""
  _def="$(git ${repo:+-C "$repo"} ls-remote --symref "$remote" HEAD 2>/dev/null \
          | sed -n 's#^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$#\1#p' | head -1)"
  [ -z "$_def" ] && _def="$(git ${repo:+-C "$repo"} symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null | sed "s#^$remote/##")"
  if [ -n "$_def" ] && [ "$branch" = "$_def" ]; then
    echo "cc-cloud declare: REFUSED — '$branch' is the default branch of remote '$remote'." >&2
    echo "  A session declared against trunk cannot be told apart from its siblings: every other" >&2
    echo "  session's push to that branch reads as THIS session's heartbeat, so the observer" >&2
    echo "  reports a false state=ALIVE (measured 2026-08-08, backlog 55065a61b31c)." >&2
    echo "  Declare against the per-session branch this fire will actually push (e.g. claude/<id>)." >&2
    return 2
  fi

  mkdir -p "$STATE" || return 1

  # BASELINE (migrated from cc-cloud-watch `record`). Probe the remote ONCE, now, so that "the
  # session has pushed nothing" is later distinguishable from "the branch already existed". Failure
  # is NOT fatal and NOT silently coerced: an undeclared session is unobservable, which is strictly
  # worse than an unmeasured baseline, so the declaration is still written — but `base_probe` is
  # then absent and `classify` abstains from the baseline arm instead of reading an unmeasured
  # baseline as an empty one.
  base="$(remote_sha "$repo" "$remote" "$branch")"; brc=$?

  f="$STATE/$id.decl"
  {
    printf 'id=%s\n' "$id"
    printf 'branch=%s\n' "$branch"
    printf 'remote=%s\n' "$remote"
    printf 'repo=%s\n' "$repo"
    printf 'paths=%s\n' "$paths"
    if [ "$brc" -eq 0 ]; then
      printf 'base_probe=ok\n'
      printf 'base_sha=%s\n' "$base"
    fi
    [ -n "$trunk" ]   && printf 'trunk=%s\n' "$trunk"
    [ -n "$url" ]     && printf 'url=%s\n' "$url"
    [ -n "$surface" ] && printf 'surface=%s\n' "$surface"
    [ -n "$account" ] && printf 'account=%s\n' "$account"
    [ -n "$item" ]    && printf 'item=%s\n' "$item"
    [ -n "$notify_back" ] && printf 'notify_back=%s\n' "$notify_back"
    [ -n "$goal" ]        && printf 'goal=%s\n' "$goal"
    [ -n "$goal_probe" ]  && printf 'goal_probe=%s\n' "$goal_probe"
    [ -n "$custody" ]     && printf 'custody=%s\n' "$custody"
    is_num "$boot"  && printf 'boot_s=%s\n' "$boot"
    is_num "$stall" && printf 'stall_s=%s\n' "$stall"
    is_num "$life"  && printf 'life_s=%s\n' "$life"
    printf 'declared_at=%s\n' "$(now)"
  } > "$f" || return 1
  rm -f "$STATE/$id.retired"
  printf 'declared %s (branch %s on %s) — it is now observable\n' "$id" "$branch" "$remote"
  if [ "$brc" -ne 0 ]; then
    printf '  ! fire-time baseline UNMEASURED (remote did not answer) — a pre-existing ref on %s\n' "$branch" >&2
    printf '    cannot be told from this session pushing one; re-declare when the remote answers.\n' >&2
  elif [ -n "$base" ]; then
    printf '  ! %s ALREADY EXISTS on %s at %.7s — progress is measured as a move OFF that sha\n' \
      "$branch" "$remote" "$base" >&2
  fi
}

cmd_retire() {
  local id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) id="${2:-}"; shift 2 ;;
      *) echo "cc-cloud retire: unknown arg $1" >&2; return 2 ;;
    esac
  done
  [ -n "$id" ] || { echo "cc-cloud retire: --id is required" >&2; return 2; }
  [ -f "$STATE/$id.decl" ] || { echo "cc-cloud retire: no such declaration: $id" >&2; return 1; }
  printf 'retired_at=%s\n' "$(now)" > "$STATE/$id.retired" || return 1
  printf 'retired %s\n' "$id"
}

# The ONLY mutator of the heartbeat sidecar. A stall verdict needs history and history needs a
# writer; keeping it out of --json is what lets the renderers stay pure reads.
cmd_poll() {
  local id f sha rc prev n seen
  n="$(now)"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    f="$STATE/$id.decl"; seen="$STATE/$id.seen"
    sha="$(remote_sha "$(dfield "$f" repo)" "$(dfield "$f" remote)" "$(dfield "$f" branch)")"; rc=$?
    [ "$rc" -eq 0 ] || { printf 'UNKNOWN %s (sensor failed — sidecar untouched)\n' "$id"; continue; }
    [ -n "$sha" ] || { printf 'no-ref  %s\n' "$id"; continue; }
    prev="$(dfield "$seen" sha)"
    if [ "$prev" != "$sha" ]; then
      { printf 'sha=%s\n' "$sha"; printf 'since=%s\n' "$n"; } > "$seen"
      printf 'advanced %s -> %.7s\n' "$id" "$sha"
    else
      printf 'unchanged %s at %.7s\n' "$id" "$sha"
    fi
  done < <(ids)
}

# THE PRIMITIVE the three lying instruments need. Exit 0 means "this id is running off-box, so your
# local absence evidence is NOT evidence of death — abstain." Deliberately silent and cheap: it is
# meant to sit on a hot path, and its callers branch on the exit code alone.
cmd_is_offbox() {
  local id="${1:-}"
  [ -n "$id" ] || return 2
  [ -f "$STATE/$id.decl" ] || return 1
  [ -f "$STATE/$id.retired" ] && return 1
  return 0
}

cmd_show() {
  local id="${1:-}" f line state detail rcmd
  # `--item <backlog-id>` resolves through the declaration's own `item=` link (see id_for_item).
  # A miss is rc 1 — the SAME rc as an unknown id — because both mean exactly "this tool has no
  # declaration to speak about", and a caller that must fail closed on ignorance needs one rc for
  # it (memory: lookup-miss-is-not-absence).
  if [ "$id" = "--item" ]; then
    local item="${2:-}"
    [ -n "$item" ] || { echo "cc-cloud show: --item needs a backlog id" >&2; return 2; }
    id="$(id_for_item "$item")" || {
      echo "cc-cloud show: no declaration names item $item" >&2; return 1; }
  fi
  [ -n "$id" ] || { echo "cc-cloud show: need an id" >&2; return 2; }
  f="$STATE/$id.decl"
  [ -f "$f" ] || { echo "cc-cloud show: no such declaration: $id" >&2; return 1; }
  cat "$f"
  [ -f "$STATE/$id.retired" ] && cat "$STATE/$id.retired"
  [ -f "$STATE/$id.seen" ] && cat "$STATE/$id.seen"
  line="$(classify "$id")"
  state="${line%%	*}"; line="${line#*	}"; detail="${line%%	*}"; rcmd="${line#*	}"
  printf -- '--\nstate=%s\ndetail=%s\nrecover=%s\n' "$state" "$detail" "$rcmd"
}

# ── preflight — the executable form of "design the observable set BEFORE firing" ─────────────────
# Migrated wholesale from cc-cloud-watch, minus its `jq` check (this tool has no jq dependency, and
# a preflight that asserts a dependency its subject does not have is a lie about what is required).
# Exit 0 = a fire here is observable. Exit 1 = it is NOT, and firing would produce a session nothing
# on this box can ever see again.
#
# The load-bearing check is the branch one. A cloud VM clones from the REMOTE, so work that exists
# only in a local branch is invisible to it and the session silently runs against the default branch
# instead. Measured 2026-08-07 on this repo: origin carried exactly ONE head (refs/heads/main)
# against 286 local branches with no upstream, so the failing case is the overwhelmingly likely one.
cmd_preflight() {
  local repo="$ROOT" branch="" remote="" fail=0 warn=0 sha rc
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)   repo="${2:-}"; shift 2 ;;
      --branch) branch="${2:-}"; shift 2 ;;
      --remote) remote="${2:-}"; shift 2 ;;
      *) echo "cc-cloud preflight: unknown arg $1" >&2; return 2 ;;
    esac
  done

  if ! "$GIT_BIN" -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    printf '✗ %s is not a git repo — there is no repo-side channel to observe\n' "$repo"
    printf '\nPREFLIGHT FAIL — a session fired now would be UNOBSERVABLE.\n'
    return 1
  fi

  [ -n "$remote" ] || remote="$("$GIT_BIN" -C "$repo" remote 2>/dev/null | head -1)"
  if [ -z "$remote" ]; then
    printf '✗ no git remote — a cloud VM clones from the REMOTE; with none there is nothing to watch\n'
    fail=1
  else
    printf '✓ remote: %s\n' "$remote"
    # Reachability, bounded the same way every other probe here is. Note this asks for ALL heads
    # rather than one: it separates "the remote is unreachable" from "that branch is absent", which
    # is the same rc=128-vs-rc=0 discriminator the state function is built on, one level up.
    local -a rcmd=()
    [ -n "$NET_BOUND" ] && rcmd=("$NET_BOUND" "$NET_TIMEOUT")
    rcmd+=("$GIT_BIN" -C "$repo" ls-remote --heads "$remote")
    if GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/true "${rcmd[@]}" >/dev/null 2>&1; then
      printf '✓ remote reachable — ls-remote answers\n'
    else
      printf '✗ remote UNREACHABLE within %ss — every verdict would be UNKNOWN\n' "$NET_TIMEOUT"
      fail=1
    fi
  fi

  if [ -n "$branch" ] && [ -n "$remote" ]; then
    sha="$(remote_sha "$repo" "$remote" "$branch")"; rc=$?
    if [ "$rc" -ne 0 ]; then
      printf '✗ could not probe %s on %s — cannot confirm the branch is visible off-box\n' "$branch" "$remote"
      fail=1
    elif [ -z "$sha" ]; then
      printf '✗ branch %s is NOT on %s — the cloud VM would clone without it.\n' "$branch" "$remote"
      printf '  git push -u %s %s\n' "$remote" "$branch"
      fail=1
    else
      printf '✓ branch %s present on %s (%.12s)\n' "$branch" "$remote" "$sha"
    fi
  elif [ -z "$branch" ]; then
    printf '! no --branch given — the observer would not know which ref to poll\n'
    warn=1
  fi

  if mkdir -p "$STATE" 2>/dev/null && [ -w "$STATE" ]; then
    printf '✓ declaration store writable: %s\n' "$STATE"
  else
    printf '✗ declaration store NOT writable: %s — the session id could not be captured at fire time\n' "$STATE"
    fail=1
  fi

  if command -v gh >/dev/null 2>&1; then
    printf '✓ gh present — PR-side observation (O5) available if the session opens one\n'
  else
    printf '! gh ABSENT — O5 unavailable; commits and branches only\n'
    warn=1
  fi

  if [ "$fail" -ne 0 ]; then
    printf '\nPREFLIGHT FAIL — a session fired now would be UNOBSERVABLE. Fix the ✗ lines first.\n'
    return 1
  fi
  if [ "$warn" -ne 0 ]; then printf '\nPREFLIGHT PASS (with warnings above).\n'
  else printf '\nPREFLIGHT PASS.\n'; fi
  return 0
}

# Every declaration including RETIRED ones — `list` keeps them for forensics, which is the whole
# reason `retire` writes a marker instead of deleting the declaration.
all_ids() {
  local f b
  [ -d "$STATE" ] || return 0
  for f in "$STATE"/*.decl; do
    [ -f "$f" ] || continue
    b="${f##*/}"; printf '%s\n' "${b%.decl}"
  done | sort
}

# ── list — the declaration inventory, from DISK ONLY. No probe, no network. ───────────────────────
# This is where the migration departs from cc-cloud-watch's `list`, which replayed a stored
# `lastVerdict` under the label "last known". Every arm of this state function is a function of the
# CLOCK as well as the sha: BOOTING becomes NOT-STARTED with no new observation at all, purely by
# time passing. A verdict stored at T and replayed at T+n is therefore not stale-but-directional —
# it is wrong, and wrong in the direction that reads as healthy. So `list` reports only what does
# not decay: what was declared, and what was last OBSERVED. Verdicts come from --table/--json,
# which probe.
#
# `--state` is the OPT-IN probing form (§9.3). The default above must stay probe-free — that is the
# whole point of this verb — but a VIEW that renders an off-box session beside local ones needs the
# verdict, and the one thing it must not do is re-derive it. `classify` is the arbiter; this flag
# exposes it on the inventory so a consumer makes ONE call to the owning tool instead of
# re-implementing its arms outside it. `url` is emitted unconditionally because it is declaration
# truth, not a verdict: the `open <url>` recover action costs no probe and must be available even
# when the network cannot answer.
cmd_list() {
  local fmt="table" probe=0 id f seen branch remote item dat base bprobe lsha lsince n age any=0
  local url line state detail rcmd
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)  fmt=json; shift ;;
      --table) fmt=table; shift ;;
      --state) probe=1; shift ;;
      *) echo "cc-cloud list: unknown arg $1" >&2; return 2 ;;
    esac
  done
  n="$(now)"
  if [ "$fmt" = table ]; then
    if [ "$probe" -eq 1 ]; then
      printf '%-22s %-24s %-12s %-8s %s\n' "SESSION" "BRANCH" "STATE" "AGE" "LAST OBSERVED"
    else
      printf '%-22s %-24s %-8s %s\n' "SESSION" "BRANCH" "AGE" "LAST OBSERVED"
    fi
  fi
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    any=1
    f="$STATE/$id.decl"; seen="$STATE/$id.seen"
    branch="$(dfield "$f" branch)"
    remote="$(dfield "$f" remote)"
    item="$(dfield "$f" item)"
    dat="$(dfield "$f" declared_at)"
    base="$(dfield "$f" base_sha)"
    bprobe="$(dfield "$f" base_probe)"; [ "$bprobe" = ok ] || bprobe="unmeasured"
    lsha="$(dfield "$seen" sha)"
    lsince="$(dfield "$seen" since)"
    url="$(dfield "$f" url)"; [ -n "$url" ] || url="https://claude.ai/code"
    if is_num "$dat"; then age=$((n - dat)); [ "$age" -lt 0 ] && age=0; else age=0; fi
    # THE ARBITER, not a copy of it: state/detail/recover come from `classify` verbatim.
    state=""; detail=""; rcmd=""
    if [ "$probe" -eq 1 ]; then
      line="$(classify "$id")"
      state="${line%%	*}"; line="${line#*	}"
      detail="${line%%	*}"; rcmd="${line#*	}"
      [ -n "$state" ] || state="UNKNOWN"
    fi
    if [ "$fmt" = json ]; then
      printf '{"id":"%s","branch":"%s","remote":"%s","item":"%s","declared_at":%s,"age_s":%s,' \
        "$(jesc "$id")" "$(jesc "$branch")" "$(jesc "$remote")" "$(jesc "$item")" \
        "$(is_num "$dat" && printf '%s' "$dat" || printf 'null')" "$age"
      printf '"account":"%s",' "$(jesc "$(dfield "$f" account)")"
      # The management fields ride the SAME projection as everything else. A consumer that had to
      # open the .decl itself would be a second reader of this store with its own parser — the
      # shape that has already cost this repo a checker holding a stale copy of what it audits
      # (memory: uniform-error-ratio-indicts-the-model). One call to the owning tool, or none.
      printf '"paths":"%s","notify_back":"%s","goal":"%s","goal_probe":"%s","custody":"%s","item_id":"%s",' \
        "$(jesc "$(dfield "$f" paths)")" "$(jesc "$(dfield "$f" notify_back)")" \
        "$(jesc "$(dfield "$f" goal)")" "$(jesc "$(dfield "$f" goal_probe)")" \
        "$(jesc "$(dfield "$f" custody)")" "$(jesc "$(dfield "$f" item)")"
      printf '"repo":"%s","trunk":"%s",' \
        "$(jesc "$(dfield "$f" repo)")" "$(jesc "$(dfield "$f" trunk)")"
      printf '"base_probe":"%s","base_sha":"%s","last_sha":"%s","last_seen_at":%s,"url":"%s",' \
        "$bprobe" "$(jesc "$base")" "$(jesc "$lsha")" \
        "$(is_num "$lsince" && printf '%s' "$lsince" || printf 'null')" "$(jesc "$url")"
      if [ "$probe" -eq 1 ]; then
        printf '"state":"%s","detail":"%s","recover":"%s",' \
          "$(jesc "$state")" "$(jesc "$(clip "$detail")")" "$(jesc "$rcmd")"
      fi
      printf '"retired":%s}\n' \
        "$([ -f "$STATE/$id.retired" ] && printf 'true' || printf 'false')"
    else
      local obs
      if [ -f "$STATE/$id.retired" ]; then obs="RETIRED"
      elif [ -n "$lsha" ] && is_num "$lsince"; then obs="$(printf '%.7s for %s' "$lsha" "$(dur $((n - lsince)))")"
      elif [ "$bprobe" = ok ] && [ -n "$base" ]; then obs="$(printf 'never polled (pre-fire %.7s)' "$base")"
      else obs="never polled"; fi
      if [ "$probe" -eq 1 ]; then
        printf '%-22s %-24s %-12s %-8s %s\n' "$id" "$branch" "$state" "$(dur "$age")" "$obs"
      else
        printf '%-22s %-24s %-8s %s\n' "$id" "$branch" "$(dur "$age")" "$obs"
      fi
    fi
  done < <(all_ids)
  [ "$any" -eq 1 ] || [ "$fmt" = json ] || printf '%s\n' "(no cloud sessions declared — nothing is firing off-box)"
  return 0
}

# ── selftest: hermetic, RED-provable, no network ─────────────────────────────────────────────────
# Uses REAL local bare repositories as the remote, not a stubbed `git`: the whole correctness claim
# of this file is about what `git ls-remote` actually returns, so a stub would test the stub.
_ST_PASS=0
_ST_FAIL=0
_st_expect() { # <name> <expected-state> <id>
  local got; got="$(classify "$3")"; got="${got%%	*}"
  if [ "$got" = "$2" ]; then _ST_PASS=$((_ST_PASS + 1)); printf 'ok   %s\n' "$1"
  else _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL %s (want %s, got %s)\n' "$1" "$2" "$got"; fi
}
_st_rc() { # <name> <expected-rc> <cmd...>
  local name="$1" want="$2"; shift 2
  local got=0; "$@" >/dev/null 2>&1 || got=$?
  if [ "$got" = "$want" ]; then _ST_PASS=$((_ST_PASS + 1)); printf 'ok   %s\n' "$name"
  else _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL %s (want rc %s, got %s)\n' "$name" "$want" "$got"; fi
}
do_selftest() {
  # `_ST_D` is deliberately NOT `local`: the EXIT trap fires after this function has returned, and a
  # local would be out of scope by then — under `set -u` that aborts the cleanup with an unbound
  # variable instead of removing the fixture.
  _ST_D="$(mktemp -d)" || return 1
  trap 'rm -rf "$_ST_D"' EXIT
  STATE="$_ST_D/state"
  CC_CLOUD_NOW=2000000000

  "$GIT_BIN" init -q --bare "$_ST_D/remote.git"

  # POSITIVE CONTROL, and it is not ceremony: the first cut of this selftest reported 1/4 passing
  # where the one "pass" came from a `declare` that had SILENTLY FAILED, leaving no file at all —
  # classify then returned UNKNOWN for the right answer and the wrong reason. Asserting the
  # declaration exists is what separates "the sensor said UNKNOWN" from "there was nothing to sense".
  cmd_declare --id boot --branch feat/x --remote "$_ST_D/remote.git" --repo "" >/dev/null
  if [ -f "$STATE/boot.decl" ]; then _ST_PASS=$((_ST_PASS + 1)); printf 'ok   declare wrote a declaration (control)\n'
  else _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL declare wrote no declaration — every verdict below is vacuous\n'; fi

  _st_expect "absent ref inside the boot budget is BOOTING, not a fault" BOOTING boot

  CC_CLOUD_NOW=$((2000000000 + 5000))
  _st_expect "absent ref past the boot budget is NOT-STARTED" NOT-STARTED boot
  CC_CLOUD_NOW=2000000000

  cmd_declare --id gone --branch feat/y --remote "$_ST_D/nonexistent.git" --repo "" >/dev/null
  _st_expect "an UNREACHABLE remote is UNKNOWN, never NOT-STARTED" UNKNOWN gone

  # A real pushed ref, produced by real git — not a stub. The entire correctness claim of this file
  # is about what `git ls-remote` actually returns, so a stubbed git would only test the stub.
  "$GIT_BIN" init -q "$_ST_D/work"
  (
    cd "$_ST_D/work" || exit 1
    "$GIT_BIN" -c user.email=t@t -c user.name=t commit -q --allow-empty -m seed
    "$GIT_BIN" push -q "$_ST_D/remote.git" HEAD:refs/heads/feat/x
  ) >/dev/null 2>&1
  _st_expect "a pushed ref inside its budgets is ALIVE" ALIVE boot

  # BASELINE (migrated from cc-cloud-watch `record`). `boot` above was declared BEFORE the push, so
  # its ref MOVED and ALIVE is right. `reused` is declared AFTER, onto the same already-pushed
  # branch: nothing has moved, and without a fire-time baseline that reads ALIVE for the whole 6h
  # life budget — a session that never booted onto a re-used branch name, hidden behind a green.
  cmd_declare --id reused --branch feat/x --remote "$_ST_D/remote.git" --repo "" >/dev/null 2>&1
  _st_expect "a ref that already existed at fire time is BOOTING, not ALIVE" BOOTING reused
  CC_CLOUD_NOW=$((2000000000 + 5000))
  _st_expect "an unmoved pre-fire ref past the boot budget is NOT-STARTED" NOT-STARTED reused
  # POSITIVE CONTROL at the SAME clock: the session that genuinely pushed is still ALIVE. Without
  # this, both verdicts above are equally explained by the clock convicting every declaration.
  _st_expect "control: the session that DID push is ALIVE at that same clock" ALIVE boot
  CC_CLOUD_NOW=2000000000

  # PREFLIGHT (migrated from cc-cloud-watch). The refusal that carries the point: a cloud VM clones
  # from the REMOTE, so a local-only branch is invisible to it and the session runs against the
  # default branch instead — measured 2026-08-07, origin held 1 head against 286 local branches.
  "$GIT_BIN" -C "$_ST_D/work" remote add origin "$_ST_D/remote.git" >/dev/null 2>&1
  _st_rc "preflight passes for a branch that is on the remote (control)" 0 \
    cmd_preflight --repo "$_ST_D/work" --branch feat/x
  _st_rc "preflight REFUSES a branch that exists only locally" 1 \
    cmd_preflight --repo "$_ST_D/work" --branch never-pushed
  _st_rc "preflight REFUSES a repo with no remote at all" 1 \
    cmd_preflight --repo "$_ST_D/remote.git" --branch feat/x

  # ── FILL-PATHS (backlog a435e3987fbf). Real commits in a real repo: the whole claim is about
  # what `git diff --name-only` returns over a real range, so a stub would test the stub.
  #
  # THE TRUNK IN THIS FIXTURE CARRIES THE CONTENT UNDER A DIFFERENT SHA, on purpose. That is what a
  # real cloud land looks like — cloud-reconcile RE-AUTHORS, so the sha the VM pushed is never the
  # sha that lands — and a fixture whose trunk simply contained the branch would prove landedness
  # by ancestry and never exercise the by-content rule this whole file is built on.
  # Branch names are created from SHAs rather than assumed (`main` vs `master` is an init default,
  # not a fact about this repo), so the fixture cannot go red on someone else's git config.
  (
    cd "$_ST_D/work" || exit 1
    seed="$("$GIT_BIN" rev-parse HEAD)"
    "$GIT_BIN" branch trunkref "$seed"
    "$GIT_BIN" checkout -q -b claude/fill "$seed"
    mkdir -p docs
    printf 'x\n' > docs/added.md
    printf 'y\n' > doomed.md
    "$GIT_BIN" add -A && "$GIT_BIN" -c user.email=t@t -c user.name=t commit -q -m "add two"
    "$GIT_BIN" rm -q doomed.md
    "$GIT_BIN" -c user.email=t@t -c user.name=t commit -q -m "delete one"
    # the "landed" trunk: same CONTENT, independent history — the re-author case
    "$GIT_BIN" checkout -q -b landedtrunk "$seed"
    mkdir -p docs && printf 'x\n' > docs/added.md
    "$GIT_BIN" add -A && "$GIT_BIN" -c user.email=t@t -c user.name=t commit -q -m "landed by a re-author"
    "$GIT_BIN" checkout -q -b claude/delonly landedtrunk
    "$GIT_BIN" rm -q docs/added.md
    "$GIT_BIN" -c user.email=t@t -c user.name=t commit -q -m "delete only"
    "$GIT_BIN" checkout -q "$seed"
  ) >/dev/null 2>&1
  cmd_declare --id fillme --branch claude/fill --remote "$_ST_D/remote.git" --repo "$_ST_D/work" \
    --trunk trunkref >/dev/null 2>&1
  cmd_fill_paths --id fillme >/dev/null 2>&1
  _st_kv() { # <name> <expected> <id> <key>
    local got; got="$(dfield "$STATE/$3.decl" "$4")"
    if [ "$got" = "$2" ]; then _ST_PASS=$((_ST_PASS + 1)); printf 'ok   %s\n' "$1"
    else _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL %s (want "%s", got "%s")\n' "$1" "$2" "$got"; fi
  }
  _st_kv "fill-paths derives the path set from the branch's own commits" "docs/added.md" fillme paths
  # THE TRAP, pinned as its own arm: a DELETED path is in the diff and is absent from trunk after a
  # perfect land, so including it would manufacture a declaration that can never read LANDED.
  if [ "$(dfield "$STATE/fillme.decl" paths)" = "docs/added.md" ]; then
    _ST_PASS=$((_ST_PASS + 1)); printf 'ok   a DELETED path is excluded (it could never be content-present on trunk)\n'
  else
    _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL a deleted path leaked into paths= — that declaration can never read LANDED\n'
  fi
  # An existing declaration is not overwritten without --force …
  cmd_fill_paths --id fillme >/dev/null 2>&1
  _st_kv "an already-filled declaration is not silently re-derived" "docs/added.md" fillme paths
  # … and the EMPTY case never writes. A delete-only range must leave paths= alone and refuse.
  cmd_declare --id delonly --branch claude/delonly --remote "$_ST_D/remote.git" --repo "$_ST_D/work" \
    --trunk landedtrunk >/dev/null 2>&1
  _st_rc "a delete-only range REFUSES rather than writing an empty path set" 4 \
    cmd_fill_paths --id delonly
  _st_kv "…and it leaves paths= empty, which stays honestly 'not assertable'" "" delonly paths
  # ── --print / --set: the split the FIRST LIVE ROUND TRIP forced ──────────────────────────────
  # The range is bounded at the merge-base with the trunk, so after a successful land the branch is
  # an ancestor of trunk, the range is EMPTY, and a post-hoc derivation can only refuse. These arms
  # pin both halves and the diagnosis that tells them apart from a genuinely empty branch.
  cmd_declare --id printme --branch claude/fill --remote "$_ST_D/remote.git" --repo "$_ST_D/work" \
    --trunk trunkref >/dev/null 2>&1
  if [ "$(cmd_fill_paths --id printme --print 2>/dev/null)" = "docs/added.md" ]; then
    _ST_PASS=$((_ST_PASS + 1)); printf 'ok   --print derives without writing\n'
  else _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL --print did not derive the expected set\n'; fi
  _st_kv "…and --print left the declaration untouched" "" printme paths
  cmd_fill_paths --id printme --set "docs/added.md" >/dev/null 2>&1
  _st_kv "--set writes what the caller derived before the land" "docs/added.md" printme paths
  _st_rc "--set REFUSES an empty set — the never-empty rule binds through this door too" 4 \
    cmd_fill_paths --id printme --set ""
  # THE LIVE FAILURE, as its own arm: a branch already on trunk must be told apart from an empty one.
  cmd_declare --id landedalready --branch claude/fill --remote "$_ST_D/remote.git" --repo "$_ST_D/work" \
    --trunk claude/fill >/dev/null 2>&1
  # CAPTURE, THEN MATCH — never `cmd | grep -q`. Under `pipefail` (line 136) the pipeline adopts the
  # PRODUCER's non-zero, so a grep that matched perfectly still read FALSE because fill-paths exits
  # 4 on the very refusal being asserted. That is the repo's own pipefail/SIGPIPE ratchet class,
  # met here from the inside.
  _la_out="$(cmd_fill_paths --id landedalready 2>&1)"
  if printf '%s' "$_la_out" | grep -q 'ALREADY on'; then
    _ST_PASS=$((_ST_PASS + 1)); printf 'ok   an already-landed branch NAMES that cause, not a bare emptiness\n'
  else _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL an already-landed branch reported as merely empty (got: %s)\n' "$_la_out"; fi

  # An unresolvable ref is 'cannot tell' (2), never a write.
  cmd_declare --id noref --branch claude/never-pushed --remote "$_ST_D/remote.git" --repo "$_ST_D/work" >/dev/null 2>&1
  _st_rc "an unresolvable branch is 'cannot tell', never an empty fill" 2 cmd_fill_paths --id noref

  # THE POINT OF THE WHOLE CHANGE, asserted end-to-end: a finished cloud session whose content is on
  # trunk reads ELIGIBLE-forever before the fill and LANDED after it. Both halves off ONE fixture,
  # because "LANDED after" proves nothing without "not LANDED before" — and the declaration is made
  # BEFORE the push, so the pre-fill verdict is the live-session ALIVE this defect actually hid
  # behind, not the never-booted BOOTING that would pass for the wrong reason.
  cmd_declare --id landedcheck --branch claude/fill --remote "$_ST_D/remote.git" --repo "$_ST_D/work" \
    --trunk landedtrunk >/dev/null 2>&1
  "$GIT_BIN" -C "$_ST_D/work" push -q "$_ST_D/remote.git" refs/heads/claude/fill:refs/heads/claude/fill >/dev/null 2>&1
  _st_expect "before the fill, a finished session reads ALIVE forever (paths empty ⇒ not assertable)" ALIVE landedcheck
  cmd_fill_paths --id landedcheck >/dev/null 2>&1
  _st_expect "after the fill, its content on the trunk ref reads LANDED" LANDED landedcheck

  # ── C7: A PRUNED BRANCH IS NOT A BRANCH THAT NEVER EXISTED (backlog f85fce7c26f5) ──────────────
  # Every arm below runs off ONE deletion each, at ONE clock, so the only axis that moves is the
  # thing under test. `neverpushed` is declared here rather than reused from `boot`, because `boot`
  # is about to acquire a sidecar and the control has to be a declaration that never had one.
  cmd_declare --id neverpushed --branch feat/absent --remote "$_ST_D/remote.git" --repo "" >/dev/null 2>&1

  # The sidecar is the second discriminator and it needs a writer. `poll` is that writer, and it
  # records only refs it actually READ — so this both arms the test and asserts the precondition.
  cmd_poll >/dev/null 2>&1

  # V1 — THE 54. `landedcheck`'s content is on its trunk ref and its paths are filled. Deleting the
  # branch removes NOTHING that made it LANDED, so the verdict must not move. Pre-fix this read
  # NOT-STARTED, i.e. cc-backlog would have reopened a finished item and burned a second VM.
  "$GIT_BIN" -C "$_ST_D/work" push -q --delete "$_ST_D/remote.git" refs/heads/claude/fill >/dev/null 2>&1
  CC_CLOUD_NOW=$((2000000000 + 5000))
  _st_expect "a LANDED session whose branch was PRUNED still reads LANDED" LANDED landedcheck

  # V2/V3 — THE DISCRIMINATOR PAIR, off ONE deletion of feat/x at ONE clock. `boot` was declared
  # before feat/x existed (base_sha empty) and its sidecar holds the sha it really pushed ⇒ the ref
  # existed and is gone ⇒ VANISHED. `reused` was declared onto feat/x AFTER it existed, so the only
  # sha ever observed for it is its own fire-time baseline ⇒ that is evidence about the BRANCH, not
  # about the session ⇒ still NOT-STARTED. Without this pair the new arm would be satisfied by a
  # rule that simply calls every absent ref VANISHED.
  "$GIT_BIN" -C "$_ST_D/work" push -q --delete "$_ST_D/remote.git" refs/heads/feat/x >/dev/null 2>&1
  _st_expect "a session that PUSHED and whose branch then vanished reads VANISHED" VANISHED boot
  _st_expect "a sidecar holding only the FIRE-TIME sha is not evidence of a push" NOT-STARTED reused

  # V4 — THE NEGATIVE CONTROL, same clock, same code path: no ref, no sidecar, nothing on trunk.
  # This is the one case the old arm was right about, and it must stay right.
  _st_expect "control: a ref that never existed at all is still NOT-STARTED" NOT-STARTED neverpushed

  # V5 — the row schema. A VANISHED session must reach the board; a state that is invisible to
  # `--json` is a verdict nobody acts on (memory: alarm-polarity-and-attention-budget).
  # CAPTURE, THEN MATCH IN THE SHELL — no pipe on either leg. `emit_rows | grep -q …` is the
  # pipefail/SIGPIPE class this repo ratchets on: the early-exit consumer kills the producer, the
  # pipeline adopts the producer's non-zero, and the condition reads FALSE on a MATCH. Caught here
  # by scripts/ship-land.sh's own pipefail-sigpipe arm before this ever landed.
  _v5="$(emit_rows)"
  case "$_v5" in
    *'"state":"VANISHED","detail":"ref '*'"subject":"boot"'*)
      _ST_PASS=$((_ST_PASS + 1)); printf 'ok   VANISHED emits a board row, not just a table cell\n' ;;
    *) _ST_FAIL=$((_ST_FAIL + 1)); printf 'FAIL VANISHED emitted no row for boot (got: %s)\n' "$_v5" ;;
  esac
  CC_CLOUD_NOW=2000000000

  printf '%s\n' "--- $_ST_PASS passed, $_ST_FAIL failed"
  [ "$_ST_FAIL" -eq 0 ]
}

# ── dispatch ─────────────────────────────────────────────────────────────────────────────────────
case "${1:-}" in
  preflight)  shift; cmd_preflight "$@"; exit $? ;;
  declare)    shift; cmd_declare "$@"; exit $? ;;
  fill-paths) shift; cmd_fill_paths "$@"; exit $? ;;
  retire)     shift; cmd_retire "$@"; exit $? ;;
  poll)       shift; cmd_poll "$@"; exit $? ;;
  is-offbox)  shift; cmd_is_offbox "${1:-}"; exit $? ;;
  show)       shift; cmd_show "$@"; exit $? ;;
  list)       shift; cmd_list "$@"; exit $? ;;
  --selftest) do_selftest; exit $? ;;
  -h|--help)  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --json|--table|--check) ;;
  "")  echo "cc-cloud: pick a verb (preflight|declare|fill-paths|retire|poll|is-offbox|show|list|--json|--table|--check|--selftest)" >&2; exit 2 ;;
  *)   echo "cc-cloud: unknown arg $1" >&2; exit 2 ;;
esac

# The kill switch mirrors cc-fleet's: zero rows, exit 0, one stderr line saying so — so turning the
# reconciler off is legible rather than looking like a clean board.
if [ "$RECONCILE" = "off" ]; then
  echo "cc-cloud: CC_CLOUD_RECONCILE=off — reconciliation skipped, zero rows emitted" >&2
  [ "$1" = "--table" ] && echo "(reconciliation disabled)"
  exit 0
fi

case "$1" in
  --json)  emit_rows ;;
  --table) emit_table ;;
  --check) do_check; exit $? ;;
esac
