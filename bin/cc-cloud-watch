#!/usr/bin/env bash
# cc-cloud-watch — the OBSERVABLE SET for off-box (cloud) Claude Code sessions.
#
#   cc-cloud-watch preflight [--repo P] [--branch B]   can a fire here be observed AT ALL?
#   cc-cloud-watch record --id <id> --branch <b> [...]  capture at FIRE TIME (the only moment)
#   cc-cloud-watch observe [--json|--table]            probe the remote, emit verdicts
#   cc-cloud-watch list   [--json|--table]             last-known verdicts, NO probe
#   cc-cloud-watch retire <id>                         terminal; stops the record being observed
#   cc-cloud-watch --selftest                          hermetic, red-provable
#
# ── WHY THIS EXISTS ──────────────────────────────────────────────────────────────────────────────
# A cloud session runs in an Anthropic-managed VM. Every liveness instrument this fleet owns is
# anchored to THIS box — `ps`/`pgrep`, `lsof`, `launchctl`, load average, the iTerm2 pane API, and
# every state file under $HOME (cc-registry, cc-telemetry, cc-permission-pending, the backlog
# ledger's `by` field, which `claimer_live` resolves with `kill -0`). None of them can see it, and
# none of them SAY so: they return a confident wrong answer rather than an error.
#
# The measured instance, and the reason this file is not a document (verified 2026-08-07 by driving
# the real function, not a replica — controls in the selftest):
#
#     scripts/lead-supervisor.sh:437  reobserve_effects() → "fresh" | "dark" | "unknown"
#
#   Its whole probe is wrapped in `if [ -n "$cwd" ] && [ -d "$cwd" ]`, and `verdict` is INITIALISED
#   to `dark`. A cloud session's cwd does not exist on this box, so the guard is skipped and the
#   function returns `dark` — 100% of the time, for a perfectly healthy session. `resolve_page()`
#   (:468) escalates on `dark`. Its own header says the third state is "load-bearing, not defensive
#   dressing… folding a cut probe into `dark` would let a slow-but-healthy repo manufacture the
#   escalation this whole protocol exists to prevent." An off-box session is not a cut probe, it is
#   an ABSENT one, and it lands in that same wrong bucket — deterministically instead of
#   occasionally. That is a new class falling into a pre-existing default arm.
#
# So the observable set is not a port of the local one. It is a different QUESTION:
#
#     local     "is the process alive?"     sampled · instantaneous · high-resolution
#     repo-side "has work ARRIVED?"         monotone · lagging · coarse · SILENCE IS AMBIGUOUS
#
# You cannot distinguish "thinking hard" from "died" from the repo side. Nothing fixes that; it is a
# property of observing a product instead of an executor. What CAN be fixed is making silence
# INTERPRETABLE, and that requires three facts which exist only at fire time:
#
#   O1  the session id      — no local ledger of cloud sessions exists (`claude agents --json` is
#                             pid-anchored; verified 2026-08-07: 13/14 rows carried a local `pid`,
#                             and the one `kind:"background"` row was a LOCAL background agent).
#                             Un-captured at fire, the id is gone; the session becomes unobservable
#                             in principle, not merely in practice.
#   O2  the branch          — tells the observer WHERE to look. Without it there is no ref to poll.
#   O3  a declared deadline — turns silence from a shrug into a verdict.
#
# That is the whole content of "design the observable set BEFORE firing, not after": after the fire,
# O1 is unrecoverable and no amount of tooling brings it back. `preflight` is that rule, executable.
#
# ── WHY ls-remote, NOT origin/* ──────────────────────────────────────────────────────────────────
# Measured 2026-08-07: `git ls-remote` has ZERO callsites repo-wide. Every "remote" read in this
# repo hits the LOCAL cache `refs/remotes/origin/*`, refreshed only as a side-effect of an action
# (land, deploy, spawn) — nothing fetches on a schedule in order to OBSERVE. A cloud session's only
# footprint is on the real remote, so reading the local cache would report `dark` until some
# unrelated command happened to fetch. This file therefore asks the remote directly, and bounds it.
#
# ── VERDICTS (total; every arm terminal) ─────────────────────────────────────────────────────────
#   fresh    the branch's remote sha ADVANCED since the last observation. Unambiguous progress.
#   waiting  no advance, but still inside a declared window (first-push grace, or silenceMaxS).
#            NOT an alarm. This is the state `dark` steals when a grace window is missing.
#   dark     no advance, past the declared window. NOT "dead" — it means GO LOOK AT THE WEB UI.
#            Repo-side observation is exhausted here; it cannot ever prove death.
#   nofetch  WE COULD NOT LOOK — the remote probe failed or was cut. Never folded into `dark`.
#            Name reused deliberately from scripts/worktree-gc-infra-run.sh:54, the only other
#            place that treats staleness of the remote observation itself as a first-class verdict.
#   retired  terminal, set by hand. Stops observation; keeps the record for forensics.
#
# `dark` vs `nofetch` is the same discipline reobserve_effects() already encodes and that this file
# exists because a cloud session bypasses. Folding "could not look" into "no progress" manufactures
# exactly the escalation the third state was invented to prevent.
#
# ── DELIBERATELY NOT HERE ────────────────────────────────────────────────────────────────────────
# LANDEDNESS. This repo already has THREE landedness predicates, deliberately different, and a
# fourth would be the "do not rebuild what exists" trap the program doc calls out:
#   patch-equivalence  scripts/worktree-gc.sh:374   `git cherry` — right for NOT deleting a dir
#   strict ancestry    scripts/branch-reaper.sh:118 `git branch --merged` — right for deleting a ref
#   content-absence    scripts/stranded-sweep.sh:80 `merge-base --is-ancestor` + `ls-tree` per path
# This file reports PROGRESS and stops. Terminality is asserted with `retire`, never inferred.
#
# READ-ONLY over the repo, ALWAYS. It never fetches objects, never writes a ref, never pushes.
# Its only writes are to its own record store.
set -uo pipefail

CLOUD_DIR="${CC_CLOUD_DIR:-$HOME/.claude/cloud-sessions}"
GIT_BIN="${CC_CLOUD_GIT_BIN:-git}"
PROBE_TIMEOUT_S="${CC_CLOUD_PROBE_TIMEOUT_S:-25}"
# Defaults are DECLARED, not guessed, and both are overridable per-record at fire time.
# A cloud session clones, reads, plans and only then commits; the first push legitimately lags.
DEF_FIRST_PUSH_S="${CC_CLOUD_FIRST_PUSH_S:-1800}"   # 30 min grace before silence means anything
DEF_SILENCE_MAX_S="${CC_CLOUD_SILENCE_MAX_S:-3600}" # 60 min without a ref advance ⇒ go look

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; }
now()   { date +%s; }
die()   { printf 'cc-cloud-watch: %s\n' "$1" >&2; exit "${2:-2}"; }

# jq is the only hard dependency; every other repo tool here already requires it.
have_jq() { command -v jq >/dev/null 2>&1; }

# ── the remote probe. Bounded, direct, and it distinguishes "empty" from "could not look". ───────
# Prints the sha, or nothing. Returns 0 = answered (sha may be empty ⇒ branch absent), 1 = could
# not look. That two-channel return is what keeps `nofetch` out of `dark`: an empty stdout on a
# SUCCESSFUL probe is real information (the branch is not there yet), while a failed probe is not.
probe_ref() { # $1=repo $2=remote $3=branch → stdout sha|"" ; rc 0=answered 1=nofetch
  local repo="$1" remote="$2" branch="$3" out rc
  out="$(timeout "$PROBE_TIMEOUT_S" "$GIT_BIN" -C "$repo" ls-remote --heads "$remote" \
          "refs/heads/$branch" 2>/dev/null)"; rc=$?
  [ "$rc" -ne 0 ] && return 1
  printf '%s' "$out" | awk 'NR==1{print $1}'
  return 0
}

record_path() { printf '%s/%s.json' "$CLOUD_DIR" "$1"; }

# ── preflight — the executable form of "design the observable set BEFORE firing". ────────────────
# Exit 0 = a fire here is observable. Exit 1 = it is NOT; do not fire, you would be blind.
cmd_preflight() {
  local repo="${PWD}" branch="" fail=0 warn=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)   repo="${2:-}"; shift 2 ;;
      --branch) branch="${2:-}"; shift 2 ;;
      *) die "preflight: unknown arg '$1'" ;;
    esac
  done
  have_jq || { printf '✗ jq ABSENT — the record store cannot be written or read\n'; fail=1; }

  "$GIT_BIN" -C "$repo" rev-parse --git-dir >/dev/null 2>&1 \
    || { printf '✗ %s is not a git repo — there is no repo-side channel to observe\n' "$repo"; exit 1; }

  local remote; remote="$("$GIT_BIN" -C "$repo" remote 2>/dev/null | head -1)"
  if [ -z "$remote" ]; then
    printf '✗ no git remote — a cloud VM clones from the REMOTE; with none there is nothing to watch\n'
    fail=1
  else
    printf '✓ remote: %s\n' "$remote"
    if ! timeout "$PROBE_TIMEOUT_S" "$GIT_BIN" -C "$repo" ls-remote --heads "$remote" >/dev/null 2>&1; then
      printf '✗ remote UNREACHABLE within %ss — every verdict would be nofetch\n' "$PROBE_TIMEOUT_S"
      fail=1
    else
      printf '✓ remote reachable — ls-remote answers\n'
    fi
  fi

  # The load-bearing check, and the one that ties S5 back to S1. A cloud session clones from
  # GitHub; work that exists only in a local branch is INVISIBLE to it. Measured 2026-08-07 on
  # this repo: origin carried exactly ONE head (refs/heads/main) against 199 local branches.
  if [ -n "$branch" ] && [ -n "$remote" ]; then
    local sha rc
    sha="$(probe_ref "$repo" "$remote" "$branch")"; rc=$?
    if [ "$rc" -ne 0 ]; then
      printf '✗ could not probe %s on %s — cannot confirm the branch is visible off-box\n' "$branch" "$remote"
      fail=1
    elif [ -z "$sha" ]; then
      printf '✗ branch %s is NOT on %s — the cloud VM would clone without it.\n' "$branch" "$remote"
      printf '  push it first:  git push -u %s %s\n' "$remote" "$branch"
      fail=1
    else
      printf '✓ branch %s present on %s (%s)\n' "$branch" "$remote" "$(printf '%s' "$sha" | cut -c1-12)"
    fi
  elif [ -z "$branch" ]; then
    printf '! no --branch given — O2 unchecked; the observer would not know which ref to poll\n'
    warn=1
  fi

  if mkdir -p "$CLOUD_DIR" 2>/dev/null && [ -w "$CLOUD_DIR" ]; then
    printf '✓ record store writable: %s\n' "$CLOUD_DIR"
  else
    printf '✗ record store NOT writable: %s — the session id could not be captured at fire time\n' "$CLOUD_DIR"
    fail=1
  fi

  command -v gh >/dev/null 2>&1 \
    && printf '✓ gh present — PR-side observation available if the cloud session opens one\n' \
    || { printf '! gh ABSENT — PR observation unavailable; commits+branches only\n'; warn=1; }

  if [ "$fail" -ne 0 ]; then
    printf '\nPREFLIGHT FAIL — a session fired now would be UNOBSERVABLE. Fix the ✗ lines first.\n'
    return 1
  fi
  [ "$warn" -ne 0 ] && printf '\nPREFLIGHT PASS (with warnings above).\n' || printf '\nPREFLIGHT PASS.\n'
  return 0
}

# ── record — O1/O2/O3 captured at the ONE moment they are capturable. ────────────────────────────
cmd_record() {
  local id="" branch="" repo="${PWD}" url="" item="" remote="" first="$DEF_FIRST_PUSH_S" silence="$DEF_SILENCE_MAX_S"
  while [ $# -gt 0 ]; do
    case "$1" in
      --id)     id="${2:-}"; shift 2 ;;
      --branch) branch="${2:-}"; shift 2 ;;
      --repo)   repo="${2:-}"; shift 2 ;;
      --url)    url="${2:-}"; shift 2 ;;
      --item)   item="${2:-}"; shift 2 ;;
      --remote) remote="${2:-}"; shift 2 ;;
      --first-push-s) first="${2:-}"; shift 2 ;;
      --silence-max-s) silence="${2:-}"; shift 2 ;;
      *) die "record: unknown arg '$1'" ;;
    esac
  done
  [ -n "$id" ]     || die "record: --id is REQUIRED (O1). Capture it from the fire; it is unrecoverable after."
  [ -n "$branch" ] || die "record: --branch is REQUIRED (O2). Without it no ref can be polled."
  have_jq || die "record: jq is required"
  [ -n "$remote" ] || remote="$("$GIT_BIN" -C "$repo" remote 2>/dev/null | head -1)"
  [ -n "$remote" ] || remote="origin"
  mkdir -p "$CLOUD_DIR" 2>/dev/null || die "record: cannot create $CLOUD_DIR"

  # Seed lastSha with what the remote holds RIGHT NOW, so the first advance is measured against the
  # pre-fire state rather than against nothing. A record whose baseline is empty cannot tell
  # "pushed before I looked" from "never pushed".
  local base rc; base="$(probe_ref "$repo" "$remote" "$branch")"; rc=$?
  [ "$rc" -ne 0 ] && base=""

  local ts; ts="$(now)"
  jq -nc --arg id "$id" --arg url "$url" --arg repo "$repo" --arg remote "$remote" \
         --arg branch "$branch" --arg item "$item" --arg base "$base" \
         --argjson firedAt "$ts" --argjson lastAdvanceAt "$ts" \
         --argjson first "$first" --argjson silence "$silence" \
    '{schema:1, id:$id, url:$url, repo:$repo, remote:$remote, branch:$branch, item:$item,
      firedAt:$firedAt, firstPushDeadlineS:$first, silenceMaxS:$silence,
      baseSha:$base, lastSha:$base, lastAdvanceAt:$lastAdvanceAt, state:"open"}' \
    > "$(record_path "$id")" || die "record: write failed"
  printf 'recorded %s → %s\n' "$id" "$(record_path "$id")"
}

cmd_retire() {
  local id="${1:-}"; [ -n "$id" ] || die "retire: <id> required"
  local p; p="$(record_path "$id")"
  [ -f "$p" ] || die "retire: no record for '$id'" 1
  have_jq || die "retire: jq is required"
  local tmp="$p.tmp.$$"
  jq -c '.state="retired"' "$p" > "$tmp" && mv "$tmp" "$p" || { rm -f "$tmp"; die "retire: write failed"; }
  printf 'retired %s\n' "$id"
}

# ── verdict for ONE record. Probes unless $2=noprobe. Echoes a JSON object. ──────────────────────
verdict_for() { # $1=record-path $2=probe|noprobe
  local p="$1" mode="$2" j; j="$(cat "$p" 2>/dev/null)" || return 1
  [ -n "$j" ] || return 1
  local id repo remote branch last adv first silence state
  id="$(printf '%s' "$j" | jq -r '.id')"
  repo="$(printf '%s' "$j" | jq -r '.repo')"
  remote="$(printf '%s' "$j" | jq -r '.remote')"
  branch="$(printf '%s' "$j" | jq -r '.branch')"
  last="$(printf '%s' "$j" | jq -r '.lastSha // ""')"
  adv="$(printf '%s' "$j" | jq -r '.lastAdvanceAt')"
  first="$(printf '%s' "$j" | jq -r '.firstPushDeadlineS')"
  silence="$(printf '%s' "$j" | jq -r '.silenceMaxS')"
  state="$(printf '%s' "$j" | jq -r '.state // "open"')"

  if [ "$state" = "retired" ]; then
    printf '%s' "$j" | jq -c '{id, item, branch, verdict:"retired", detail:"terminal — set by hand"}'
    return 0
  fi

  local verdict detail sha rc nowt; nowt="$(now)"
  if [ "$mode" = noprobe ]; then
    verdict="$(printf '%s' "$j" | jq -r '.lastVerdict // "unobserved"')"
    detail="last known; no probe run"
  else
    sha="$(probe_ref "$repo" "$remote" "$branch")"; rc=$?
    if [ "$rc" -ne 0 ]; then
      # WE COULD NOT LOOK. Never `dark`: an unobserved session must not manufacture an escalation.
      verdict="nofetch"; detail="ls-remote failed or was cut at ${PROBE_TIMEOUT_S}s"
    elif [ -z "$sha" ]; then
      local age=$(( nowt - $(printf '%s' "$j" | jq -r '.firedAt') ))
      if [ "$age" -le "$first" ]; then
        verdict="waiting"; detail="branch not on remote yet; ${age}s of ${first}s first-push grace"
      else
        verdict="dark"; detail="no branch on remote after ${age}s (grace ${first}s) — check the web UI"
      fi
    elif [ "$sha" != "$last" ]; then
      verdict="fresh"; detail="remote sha advanced to $(printf '%s' "$sha" | cut -c1-12)"
      adv="$nowt"; last="$sha"
    else
      local age=$(( nowt - adv ))
      if [ "$age" -le "$silence" ]; then
        verdict="waiting"; detail="no advance for ${age}s, inside ${silence}s window"
      else
        verdict="dark"; detail="no advance for ${age}s (max ${silence}s) — check the web UI"
      fi
    fi
    # Persist the observation. Only these three fields move; the fire-time contract is immutable.
    local tmp="$p.tmp.$$"
    if printf '%s' "$j" | jq -c --arg s "$last" --argjson a "$adv" --arg v "$verdict" \
         '.lastSha=$s | .lastAdvanceAt=$a | .lastVerdict=$v' > "$tmp" 2>/dev/null; then
      mv "$tmp" "$p" 2>/dev/null || rm -f "$tmp"
    else
      rm -f "$tmp"
    fi
  fi
  printf '%s' "$j" | jq -c --arg v "$verdict" --arg d "$detail" \
    '{id, item, branch, remote, url, verdict:$v, detail:$d, firedAt}'
}

cmd_observe() { # $1=probe|noprobe ; rest: --json|--table
  local mode="$1"; shift
  local fmt="table"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)  fmt=json; shift ;;
      --table) fmt=table; shift ;;
      *) die "unknown arg '$1'" ;;
    esac
  done
  have_jq || die "jq is required"
  [ -d "$CLOUD_DIR" ] || { [ "$fmt" = json ] || printf 'no cloud-session records (%s absent)\n' "$CLOUD_DIR"; return 0; }

  local any=0 f
  [ "$fmt" = table ] && printf '%-22s %-14s %-9s %s\n' "ID" "ITEM" "VERDICT" "DETAIL"
  for f in "$CLOUD_DIR"/*.json; do
    [ -f "$f" ] || continue
    any=1
    local row; row="$(verdict_for "$f" "$mode")" || continue
    if [ "$fmt" = json ]; then
      printf '%s\n' "$row"
    else
      printf '%-22s %-14s %-9s %s\n' \
        "$(printf '%s' "$row" | jq -r '.id' | cut -c1-22)" \
        "$(printf '%s' "$row" | jq -r '.item // "-"' | cut -c1-14)" \
        "$(printf '%s' "$row" | jq -r '.verdict')" \
        "$(printf '%s' "$row" | jq -r '.detail')"
    fi
  done
  [ "$any" = 0 ] && [ "$fmt" = table ] && printf '(no records)\n'
  return 0
}

# ── selftest — hermetic. Builds a real bare remote + clone; never touches the real store. ────────
cmd_selftest() {
  have_jq || die "selftest: jq is required"
  local root pass=0 fail=0
  root="$(mktemp -d)" || die "selftest: mktemp failed"
  # shellcheck disable=SC2064
  trap "rm -rf '$root'" EXIT

  ok()  { pass=$((pass+1)); printf '  ok   %s\n' "$1"; }
  bad() { fail=$((fail+1)); printf '  FAIL %s (got: %s)\n' "$1" "$2"; }
  chk() { [ "$2" = "$3" ] && ok "$1" || bad "$1" "$3"; }

  # Set the RESOLVED variable, not just the env var. CLOUD_DIR is assigned at script load, so
  # exporting CC_CLOUD_DIR here would be too late and the selftest would write into the operator's
  # REAL store — which is exactly what the first draft of this file did, leaving two cse_test*.json
  # records in ~/.claude/cloud-sessions. A "hermetic" test that configures itself after the config
  # has already been read is not hermetic; the override has to reach the variable the code uses.
  CLOUD_DIR="$root/store"
  export CC_CLOUD_DIR="$CLOUD_DIR"
  local bare="$root/remote.git" work="$root/work"
  git init -q --bare "$bare"
  git init -q "$work"
  git -C "$work" config user.email t@t; git -C "$work" config user.name t
  git -C "$work" remote add origin "$bare"
  : > "$work/f"; git -C "$work" add f; git -C "$work" commit -qm one
  git -C "$work" branch -M main; git -C "$work" push -q -u origin main

  printf 'cc-cloud-watch selftest\n'

  # 1. preflight PASSES on a branch that is on the remote.
  ( cmd_preflight --repo "$work" --branch main >/dev/null 2>&1 ) && ok "preflight passes for a pushed branch" \
    || bad "preflight passes for a pushed branch" "nonzero"

  # 2. preflight FAILS for a branch that exists only locally — the S1↔S5 tie, and the single
  #    most consequential refusal here: the cloud VM would clone without the work.
  git -C "$work" branch local-only
  ( cmd_preflight --repo "$work" --branch local-only >/dev/null 2>&1 ) \
    && bad "preflight refuses an unpushed branch" "exit 0" \
    || ok "preflight refuses an unpushed branch"

  # 3. record captures, and seeds the baseline from the live remote.
  cmd_record --id cse_test1 --branch main --repo "$work" --item deadbeef >/dev/null
  local head; head="$(git -C "$work" rev-parse main)"
  chk "record seeds baseSha from the remote" "$head" "$(jq -r .baseSha "$root/store/cse_test1.json")"

  # 4. no push since record ⇒ waiting (inside the silence window), NOT dark.
  chk "no advance inside the window ⇒ waiting" "waiting" \
      "$(verdict_for "$root/store/cse_test1.json" probe | jq -r .verdict)"

  # 5. a push ⇒ fresh.
  : > "$work/g"; git -C "$work" add g; git -C "$work" commit -qm two; git -C "$work" push -q origin main
  chk "remote sha advance ⇒ fresh" "fresh" \
      "$(verdict_for "$root/store/cse_test1.json" probe | jq -r .verdict)"

  # 6. the advance PERSISTED, so an immediate re-probe is waiting, not a second fresh.
  chk "advance is persisted (no repeat fresh)" "waiting" \
      "$(verdict_for "$root/store/cse_test1.json" probe | jq -r .verdict)"

  # 7. past the silence window with no advance ⇒ dark.
  local tmp="$root/store/cse_test1.json.t"
  jq -c '.silenceMaxS=0 | .lastAdvanceAt=(.lastAdvanceAt-10)' "$root/store/cse_test1.json" > "$tmp" \
    && mv "$tmp" "$root/store/cse_test1.json"
  chk "silence past the window ⇒ dark" "dark" \
      "$(verdict_for "$root/store/cse_test1.json" probe | jq -r .verdict)"

  # 8. THE CENTRAL INVARIANT. An unreachable remote must read `nofetch`, NEVER `dark` — folding
  #    "could not look" into "no progress" is the exact defect this file exists to prevent.
  #    Note the record is left in the post-7 state (window expired), so a naive implementation
  #    that ignored the probe failure WOULD say `dark` here. That is what makes this a real test.
  jq -c '.remote="file:///nonexistent-remote-'"$$"'.git"' "$root/store/cse_test1.json" > "$tmp" \
    && mv "$tmp" "$root/store/cse_test1.json"
  chk "unreachable remote ⇒ nofetch, not dark" "nofetch" \
      "$(verdict_for "$root/store/cse_test1.json" probe | jq -r .verdict)"

  # 9. retire is terminal and stops observation.
  cmd_retire cse_test1 >/dev/null
  chk "retire is terminal" "retired" \
      "$(verdict_for "$root/store/cse_test1.json" probe | jq -r .verdict)"

  # 10. record REFUSES without --id: O1 is the fact that is unrecoverable after the fire.
  ( cmd_record --branch main --repo "$work" >/dev/null 2>&1 ) \
    && bad "record refuses a missing --id" "exit 0" || ok "record refuses a missing --id"

  # 11. A branch absent from the remote inside the grace window is `waiting`; past it, `dark`.
  cmd_record --id cse_test2 --branch never-pushed --repo "$work" --first-push-s 3600 >/dev/null
  chk "absent branch inside first-push grace ⇒ waiting" "waiting" \
      "$(verdict_for "$root/store/cse_test2.json" probe | jq -r .verdict)"
  # Age firedAt backwards rather than only zeroing the deadline: at age==0 the boundary `age <= 0`
  # is legitimately `waiting`, so a zero-deadline-only mutation would test the boundary, not the
  # elapsed-time semantic this arm is for.
  jq -c '.firstPushDeadlineS=0 | .firedAt=(.firedAt-10)' "$root/store/cse_test2.json" > "$tmp" \
    && mv "$tmp" "$root/store/cse_test2.json"
  chk "absent branch past first-push grace ⇒ dark" "dark" \
      "$(verdict_for "$root/store/cse_test2.json" probe | jq -r .verdict)"

  printf '\n%s passed, %s failed\n' "$pass" "$fail"
  [ "$fail" -eq 0 ]
}

case "${1:---table}" in
  preflight) shift; cmd_preflight "$@" ;;
  record)    shift; cmd_record "$@" ;;
  retire)    shift; cmd_retire "$@" ;;
  observe)   shift; cmd_observe probe "$@" ;;
  list)      shift; cmd_observe noprobe "$@" ;;
  --selftest) cmd_selftest ;;
  --json)    cmd_observe probe --json ;;
  --table)   cmd_observe probe --table ;;
  -h|--help) usage ;;
  *) usage; exit 2 ;;
esac
