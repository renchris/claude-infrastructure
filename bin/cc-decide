#!/bin/bash
# cc-decide — the unattended DECISION-QUEUE packet tool (P15 §3.2). A STOP-ASK
# boundary with no human present writes ONE durable decision packet here instead of
# idling in-session context; the packet SURVIVES a recycle, is push-notified for
# early-veto, and (class-B) fires its default at a deadline. The packet is EVIDENCE:
# its status is a VIEW/hygiene concern — an OPEN packet is NEVER deleted on age
# (inv7); only terminal packets (vetoed|actioned|expired-actioned) age-compact.
#
# Store: one JSON file per decision at ${CC_DECISIONS_DIR:-~/.claude/autonomy/decisions}/<id>.json
# id = 12-hex of class+session_sid+what_plain (content-keyed → re-`open` is idempotent
#      while the packet is still on disk; a genuinely new decision has new content → new id).
#
# THE THREE CLASSES (gate-classify.sh routes every boundary to exactly one):
#   A  AUTO-DECIDE + audit trail — the agent already ruled + ACTED; the packet is the trail.
#   B  QUEUE-FOR-REVIEW — a value-fork/external-info the values don't settle, AFTER route-around
#      failed: carries a default_if_no_veto + veto_deadline; the default FIRES at the deadline
#      (async early-veto, never a sync approval).
#   C  HARD-BLOCK (human-only) — C10 self-mod / C6 money-path / permission denial: WAITS, has NO
#      default (the ceiling holds); carries a staged one-action artifact + rollback one-liner.
#
# Verbs:
#   open  --class A|B|C --what <plain-english, NO codenames>
#         [--option "label::outcome" ...] [--recommendation r] [--default d] [--deadline ISO]
#         [--project subject-project] [--default-effect change|no-change]
#         [--session-sid s] [--session-pane u] [--staged-artifact p] [--route-around r] [--id id]
#           → fail-closed: B needs default+deadline; C must NOT carry a default (nor a
#             --default-effect, having no default to describe); what_plain required.
#             Echoes the id.
#   veto   <id> [--by who]                 open → vetoed   (operator killed the default)
#   action <id> [--evidence ref]           open → actioned (the decision was carried out)
#   list   [--open | --all | --class X | --expiring] [--json]     (default --open)
#          --json emits the FULL matching packets as ONE JSON array (never the table), so a
#          consumer can filter on fields the table does not carry — `session_sid` above all.
#   expire-sweep    class-B past veto_deadline & open ⇒ expired-actioned, and REPORT the fired
#                   default line to stdout for the CALLER to act on:
#                     "fired\t<id>\t<subject_project|->\t<change|no-change>\t<default>"
#                   The sweep itself EXECUTES nothing and DELETES nothing (inv7).
#
# ── TWO PRODUCER-DECLARED FIELDS the actuator needs (item f32588a73993) ───────────────────────
# `subject_project` and `default_effect` exist because the ACTUATOR of a fired class-B default
# (scripts/autonomy-sweep.sh) has to answer two questions the packet could not previously answer,
# and neither is inferable from the packet after the fact:
#
#   subject_project — WHICH project the decision is about. The sweep runs from launchd with cwd=/,
#     so it can only name its own host project; of the five live fired records, four concerned
#     doc_classifier and one voiceink, and every one was filed against the sweep's host. The
#     subject is knowable ONLY from prose (`what_plain`), and grepping a path out of prose is
#     exactly the shape-classifier that must not be built (memory:
#     fixture-vs-real-classifier-needs-a-producer — classify by the producer's literal emission,
#     never by shape). So the PRODUCER, which already knows its own cwd, declares it here.
#
#   default_effect — whether firing the default CHANGES anything. "hold (no change without
#     ruling)", "disclose-only (already landed; silence = no further change)" and "park this
#     decision to the backlog and continue other work" all actuate NOTHING, yet each became an
#     open dispatch candidate and could spawn a worker whose whole assignment was to change
#     nothing. Same rule: the producer states it; nothing reads the default's wording to guess.
#
# BOTH are OPTIONAL and BOTH fail OPEN — absent reads as "unknown project" and "change", i.e. the
# pre-existing behaviour (host-project fallback + a dispatch candidate). Making either mandatory
# on class B would rc-2 every legacy producer at exactly the moment a session is trying to escape
# a STOP-ASK, turning a missing annotation into a lost packet. An unnecessary work item is visible
# waste; a dropped one is silent loss.
#
# Env (tests): CC_DECISIONS_DIR · CC_IDL (audit trail) · CC_NOW (ISO override for expiry compare).
# BSD+GNU portable, no eval, fail-loud. Exit 0 ok · 2 usage/schema-refusal · 3 unknown id.
set -uo pipefail

DECISIONS_DIR="${CC_DECISIONS_DIR:-$HOME/.claude/autonomy/decisions}"
IDL="${CC_IDL:-$HOME/.claude/autonomy/idl.jsonl}"

usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'; }

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# mk_id <class> <sid> <what> → 12-hex content key (US-separated, collision-safe).
mk_id() { printf '%s\037%s\037%s' "$1" "$2" "$3" | shasum -a 256 | cut -c1-12; }

ensure_dir() { mkdir -p "$DECISIONS_DIR" 2>/dev/null || true; }

# ── TSV field-collapse guard — docs/research/TSV_FIELD_COLLAPSE_2026-07-25.md ──────────────────
# Tab is IFS-*whitespace*, so `IFS=$'\t' read` collapses a RUN of tabs: ANY empty cell shifts every
# later field one position LEFT, silently and with a zero exit status. Padding at the `@tsv`
# EMITTER is the only durable fix — the read side cannot be repaired (a non-whitespace IFS would
# have to be $'\037'; $'\001' is bash's internal CTLESC and does not split at all on bash 3.2).
# `//` alone is NOT enough: it substitutes for null/false only, never for a present-but-empty
# string — which is exactly the live case (`.veto_deadline // ""` on every class-C packet).
# `if . == null` rather than `// ""` so a legitimate `false` still renders "false", not the pad.
CELL='def cell(ph): (if . == null then "" else . end) | tostring
      | gsub("[\\t\\r\\n]"; " ") | if . == "" then ph else . end; '

# ── status FOLD — an ABSENT or empty `.status` reads as "open" ─────────────────────────────────
# Every status predicate here is a jq `select`, so a packet with no `.status` key is DROPPED with a
# zero exit: silently absent from the board rather than flagged. That is the wrong polarity for an
# operator queue — a malformed packet must be LOUDER than a well-formed one, never quieter. Six live
# `shipland-esc-*` packets written by scripts/ship-land.sh carried no `.status` at all and so were
# invisible to `list --open` (and to autonomy-sweep, cc-digest and operator-readout, which share this
# idiom). Folding on the READ side fixes those legacy packets in place without rewriting them —
# inv7: a packet is EVIDENCE, so it is never overwritten to satisfy a view.
# Deliberately NOT a bare `.status // "open"`: `//` substitutes for null/false only, never for a
# present-but-empty string (the same trap CELL documents above), and `"status": ""` must fold too.
# PAIRED with `(.veto_deadline // "") != ""` at every deadline site — see cmd_expire_sweep.
SFOLD='def sopen: (.status // "" | if . == "" then "open" else . end); '

# Best-effort audit line; NEVER fails the command.
log_idl() { # <verb> <id> <class> <status>
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  printf '{"ts":"%s","tool":"cc-decide","verb":"%s","id":"%s","class":"%s","status":"%s"}\n' \
    "$(now_iso)" "$1" "$2" "$3" "$4" >> "$IDL" 2>/dev/null || true
}

cmd_open() {
  local class="" what="" rec="" def="" deadline="" sid="" pane="" staged="" route="" id=""
  local project="" deffect=""
  local options=()
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --class)           class="${1:-}";    [ $# -gt 0 ] && shift ;;
      --what)            what="${1:-}";      [ $# -gt 0 ] && shift ;;
      --option)          options+=("${1:-}"); [ $# -gt 0 ] && shift ;;
      --recommendation)  rec="${1:-}";       [ $# -gt 0 ] && shift ;;
      --default)         def="${1:-}";       [ $# -gt 0 ] && shift ;;
      --default-effect)  deffect="${1:-}";   [ $# -gt 0 ] && shift ;;
      --project)         project="${1:-}";   [ $# -gt 0 ] && shift ;;
      --deadline)        deadline="${1:-}";  [ $# -gt 0 ] && shift ;;
      --session-sid)     sid="${1:-}";       [ $# -gt 0 ] && shift ;;
      --session-pane)    pane="${1:-}";      [ $# -gt 0 ] && shift ;;
      --staged-artifact) staged="${1:-}";    [ $# -gt 0 ] && shift ;;
      --route-around)    route="${1:-}";     [ $# -gt 0 ] && shift ;;
      --id)              id="${1:-}";        [ $# -gt 0 ] && shift ;;
      *) printf 'cc-decide open: unknown arg %s\n' "$key" >&2; return 2 ;;
    esac
  done

  # ── fail-closed schema gate (asymmetric: a malformed packet is REFUSED, never half-written) ──
  case "$class" in
    A|B|C) : ;;
    *) echo "cc-decide open: --class must be A|B|C (got '${class}')" >&2; return 2 ;;
  esac
  [ -n "$what" ] || { echo "cc-decide open: --what (plain-english, no codenames) is required" >&2; return 2; }
  if [ "$class" = "B" ]; then
    [ -n "$def" ]      || { echo "cc-decide open: class-B REQUIRES --default (default_if_no_veto)" >&2; return 2; }
    [ -n "$deadline" ] || { echo "cc-decide open: class-B REQUIRES --deadline (veto_deadline)" >&2; return 2; }
  fi
  if [ "$class" = "C" ] && [ -n "$def" ]; then
    echo "cc-decide open: class-C must NOT carry a --default (C waits, never defaults)" >&2; return 2
  fi
  # --default-effect DESCRIBES a default, so class-C (which has none) must not carry one either —
  # same polarity as the --default refusal above. The value itself is closed: an unrecognised
  # spelling is REFUSED rather than silently folded to "change", or a typo'd "nochange" would
  # dispatch a worker on a no-change default while reading as annotated.
  if [ -n "$deffect" ]; then
    if [ "$class" = "C" ]; then
      echo "cc-decide open: class-C must NOT carry a --default-effect (C has no default to describe)" >&2; return 2
    fi
    case "$deffect" in
      change|no-change) : ;;
      *) echo "cc-decide open: --default-effect must be change|no-change (got '${deffect}')" >&2; return 2 ;;
    esac
  fi

  # ── SESSION ATTRIBUTION LADDER — a CONTRACT, and the reason it needs a third rung ─────────────
  # An explicit --session-sid always wins, so a caller filing on another session's behalf can say
  # so (scripts/limit-recover/lr-reset-poller.sh:565 does exactly that). The env rungs mirror
  # bin/cc-backlog:2669-2671 with ONE addition that measurement forced:
  #
  #   $CLAUDE_SESSION_ID is NOT exported to a tool-call shell — this repo says so in three places
  #   (hooks/log-bash.sh:9 and hooks/validate-bash.sh:1266 both cite D-9; commands/wrap.md:23
  #   "verified 2026-08-01") — and `cc-decide open` runs in exactly that shell. So a ladder ending
  #   at CLAUDE_SESSION_ID resolves to "" at every real call site: the fix would be a NO-OP wearing
  #   a fix's clothes. $CLAUDE_CODE_SESSION_ID IS set there and names the transcript — the same id
  #   hooks/completion-assert.sh:211 feeds wrap-ledger as --session, and the one
  #   scripts/ship-land.sh:1003 already uses for this purpose.
  #
  # WHY IT MATTERS: session_sid was written "" on every unflagged open, and
  # scripts/wrap-ledger.sh:730 selects `(.session_sid // "") == $sid`, so an unattributed packet
  # matched NOTHING — and :718 returns BLOCKED=0 when $sid is itself empty, so it could not match
  # in either branch. An open class-C hard-block therefore blocked nobody and the close rendered
  # "✅ SAFE TO CLOSE — nothing of mine is open" over it. Measured 2026-08-24: 11 of the 14 open
  # class-C packets in the live store carried an empty sid, and the 3 that did not were one batch
  # from 2026-07-18.
  #
  # FAIL DIRECTION IS MONOTONE: if none of the three is set, sid stays "" — byte-identical to the
  # behaviour this replaces. The fix can be a no-op; it can never attribute a packet to the wrong
  # session, because these ids are per-session uuids and cannot collide.
  #
  # NOTE mk_id is class+sid+what, so a resolved sid CHANGES the id — deliberately. Per-session
  # keying is the design (see the header at :10); today's cross-session idempotency is an artifact
  # of sid always being empty, not an intended property. Re-`open` within one session is still
  # idempotent (same sid ⇒ same id).
  [ -n "$sid" ] || sid="${CLAUDE_SESSION_ID:-}"
  [ -n "$sid" ] || sid="${CLAUDE_CODE_SESSION_ID:-}"
  [ -n "$sid" ] || sid="${CC_SESSION_ID:-}"

  ensure_dir
  [ -n "$id" ] || id="$(mk_id "$class" "$sid" "$what")"
  local file="$DECISIONS_DIR/$id.json"
  # Idempotent + inv7: an existing packet is EVIDENCE — never overwrite it, just echo the id.
  if [ -f "$file" ]; then echo "$id"; return 0; fi

  # Build the options array (bash 3.2-safe: guard the empty-array expansion under set -u).
  local opts_json="[]" o label outcome
  if [ "${#options[@]}" -gt 0 ]; then
    for o in "${options[@]}"; do
      label="${o%%::*}"; outcome="${o#*::}"
      [ "$outcome" = "$o" ] && outcome=""     # no '::' separator → outcome empty
      opts_json="$(printf '%s' "$opts_json" | jq -c --arg l "$label" --arg o "$outcome" \
        '. + [{label:$l, outcome_in_operator_terms:$o}]')" || { echo "cc-decide open: options build failed" >&2; return 2; }
    done
  fi

  # NOTE mk_id is class+sid+what ONLY — deliberately NOT the new fields. Annotating an existing
  # decision with its project or default-effect must not mint a SECOND packet for the same fork.
  local tmp="$file.tmp.$$"
  if jq -n --arg id "$id" --arg created "$(now_iso)" --arg class "$class" \
        --arg sid "$sid" --arg pane "$pane" --arg what "$what" \
        --argjson options "$opts_json" --arg rec "$rec" --arg def "$def" \
        --arg deadline "$deadline" --arg staged "$staged" --arg route "$route" \
        --arg project "$project" --arg deffect "$deffect" \
    '{id:$id, created:$created, class:$class, session_sid:$sid, session_pane_uuid:$pane,
      what_plain:$what, subject_project:$project, options:$options, recommendation:$rec,
      default_if_no_veto:$def, default_effect:$deffect, veto_deadline:$deadline,
      staged_artifact_path:$staged, route_around_taken:$route, status:"open"}' \
    > "$tmp" 2>/dev/null && mv "$tmp" "$file"; then :; else
    rm -f "$tmp" 2>/dev/null || true; echo "cc-decide open: write failed" >&2; return 2
  fi

  log_idl open "$id" "$class" open
  echo "$id"
}

# Shared open→terminal transition (status is a VIEW update; content preserved, file NEVER deleted).
cmd_transition() {
  local verb="$1"; shift
  local id="${1:-}"; [ $# -gt 0 ] && shift
  local by="" evidence=""
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --by)       by="${1:-}";       [ $# -gt 0 ] && shift ;;
      --evidence) evidence="${1:-}"; [ $# -gt 0 ] && shift ;;
      *) printf 'cc-decide %s: unknown arg %s\n' "$verb" "$key" >&2; return 2 ;;
    esac
  done
  [ -n "$id" ] || { printf 'cc-decide %s: <id> is required\n' "$verb" >&2; return 2; }
  local file="$DECISIONS_DIR/$id.json"
  [ -f "$file" ] || { printf 'cc-decide %s: unknown id %s\n' "$verb" "$id" >&2; return 3; }
  local newstatus; [ "$verb" = "veto" ] && newstatus="vetoed" || newstatus="actioned"
  local tmp="$file.tmp.$$"
  if jq --arg s "$newstatus" --arg ev "$evidence" --arg by "$by" --arg ts "$(now_iso)" \
     '.status=$s | .resolved=$ts
      | (if $ev != "" then .evidence=$ev  else . end)
      | (if $by != "" then .resolved_by=$by else . end)' \
     "$file" > "$tmp" 2>/dev/null && mv "$tmp" "$file"; then :; else
    rm -f "$tmp" 2>/dev/null || true; printf 'cc-decide %s: update failed\n' "$verb" >&2; return 2
  fi
  log_idl "$verb" "$id" "$(jq -r '.class' "$file" 2>/dev/null || echo '?')" "$newstatus"
  echo "$id"
}

# ── the ONE select predicate `list` owns ───────────────────────────────────────────────────────
# Written once and shared by BOTH renderings (table and --json). cc-decide is the arbiter of what
# "open"/"expiring" MEAN for a packet (memory: make-the-actuator-the-arbiter), so a second copy of
# this jq — in the --json leg, or worse in a consumer — would be a second, independently-rotting
# definition of the board. `--json` exists precisely so a consumer never has to write one.
# shellcheck disable=SC2016  # $classf/$mode are JQ variables bound by --arg, not shell expansions;
# single quotes are exactly right here and double-quoting would let the shell eat them.
LIST_SELECT='select($classf == "" or .class == $classf)
      | select(
          $mode == "all"
          or ($mode == "open"     and sopen == "open")
          or ($mode == "expiring" and sopen == "open" and .class == "B" and (.veto_deadline // "") != "")
        )'

cmd_list() {
  local mode="open" classf="" as_json=0 f
  while [ $# -gt 0 ]; do
    local key="$1"; shift
    case "$key" in
      --open)     mode="open" ;;
      --all)      mode="all" ;;
      --expiring) mode="expiring" ;;
      --json)     as_json=1 ;;
      --class)    classf="${1:-}"; [ $# -gt 0 ] && shift ;;
      *) printf 'cc-decide list: unknown arg %s\n' "$key" >&2; return 2 ;;
    esac
  done

  # ── --json: the FULL packets, as ONE array ───────────────────────────────────────────────────
  # A consumer reads this to answer questions the table cannot even express — "is an open class-C
  # packet MINE?" needs `session_sid`, which the five table columns drop. The array is emitted even
  # when EMPTY: `[]` says "read fine, zero rows", and silence says "the read failed". Those are
  # different facts, and a consumer that cannot tell them apart will either manufacture a verdict
  # from a failure or swallow one (MEMORY.md lookup-miss-is-not-absence). `jq -s` is what
  # guarantees it — on empty stdin it prints `[]`, so the zero-row path needs no special case.
  # `.status` is FOLDED to the same value the table's status column shows: an absent/empty status
  # is a legacy `shipland-esc-*` packet the SFOLD prelude already resolves to "open", and shipping
  # a view in which that field reads null would hand every consumer the exact `select` bug the fold
  # exists to fix. The file on disk is untouched — inv7 governs the PACKET, not the view of it.
  if [ "$as_json" -eq 1 ]; then
    local rows
    if [ -d "$DECISIONS_DIR" ]; then
      rows="$(
        for f in "$DECISIONS_DIR"/*.json; do
          [ -e "$f" ] || continue
          jq -c --arg mode "$mode" --arg classf "$classf" "$CELL$SFOLD$LIST_SELECT"'
            | .status = sopen' "$f" 2>/dev/null
        done | jq -s '.' 2>/dev/null
      )"
    fi
    [ -n "${rows:-}" ] || rows="[]"
    printf '%s\n' "$rows"
    return 0
  fi

  [ -d "$DECISIONS_DIR" ] || return 0
  for f in "$DECISIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    jq -r --arg mode "$mode" --arg classf "$classf" "$CELL$SFOLD$LIST_SELECT"'
      | [ (sopen | cell("?")), (.class | cell("?")), (.id | cell("?")),
          (.veto_deadline | cell("-")), (.what_plain | cell("?")) ] | @tsv
    ' "$f" 2>/dev/null
  done | sort | while IFS=$'\t' read -r st cl id dl what; do
      printf '%-16s | %s | %s | %-20s | %s\n' "$st" "$cl" "$id" "$dl" "$what"
    done
}

# expire-sweep: REPORT (never execute) each fired class-B default; transition it to
# expired-actioned. Deletes nothing. A class-C packet has no deadline ⇒ never fires.
#
# The reported line is "fired\t<id>\t<subject_project|->\t<change|no-change>\t<default>". Two
# properties of that shape are load-bearing, not cosmetic:
#
#   PADDED — every cell goes through CELL, so no cell is ever EMPTY. Tab is IFS-*whitespace*, so
#     the caller's `IFS=$'\t' read` collapses a RUN of tabs and shifts every later field one
#     position left, silently and at rc 0 (docs/research/TSV_FIELD_COLLAPSE_2026-07-25.md). A
#     packet with no subject_project is the common case, so without the pad the actuator would
#     read the EFFECT out of the project slot on exactly the packets the fix is for.
#   STRUCTURED-BEFORE-FREE-TEXT — id/project/effect precede the operator-written default, so
#     nothing in that free text can shift a field the actuator branches on. (@tsv also escapes any
#     embedded tab/newline; CELL's gsub is the second belt.)
#
# The effect is NORMALISED HERE, never at the caller: cc-decide owns the packet schema, so it is
# the arbiter of "is this a no-change default" (memory: make-the-actuator-the-arbiter — never
# re-implement a gate's predicate outside it). An absent/unrecognised value reads as "change",
# which is the pre-fix behaviour: fail toward a visible surplus item, never a silent drop.
cmd_expire_sweep() {
  [ -d "$DECISIONS_DIR" ] || return 0
  local now="${CC_NOW:-$(now_iso)}" f info id proj effect def tmp
  for f in "$DECISIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    # `(.veto_deadline // "") != ""` is what keeps the SFOLD safe. In jq a MISSING key is `null`, and
    # `null != ""` is TRUE while `null < <any string>` is ALSO true — so folding an absent status to
    # "open" without this guard would fire the default of every deadline-less legacy class-B packet,
    # transitioning a land-block no human ever saw straight to `expired-actioned` against a null
    # default. The fold makes such packets VISIBLE; this guard keeps them from being auto-closed.
    info="$(jq -r --arg now "$now" "$CELL$SFOLD"'
      if (.class == "B" and sopen == "open" and (.veto_deadline // "") != "" and .veto_deadline < $now)
      then [ (.id             | cell("?")),
             (.subject_project| cell("-")),
             (.default_effect // "" | if . == "no-change" then "no-change" else "change" end),
             (.default_if_no_veto | cell("(none)")) ] | @tsv
      else empty end' "$f" 2>/dev/null || true)"
    [ -n "$info" ] || continue
    IFS=$'\t' read -r id proj effect def <<< "$info"
    tmp="$f.tmp.$$"
    if jq --arg ts "$now" '.status="expired-actioned" | .resolved=$ts' "$f" > "$tmp" 2>/dev/null \
      && mv "$tmp" "$f"; then :; else
      rm -f "$tmp" 2>/dev/null || true; continue
    fi
    log_idl expire-sweep "$id" B expired-actioned
    printf 'fired\t%s\t%s\t%s\t%s\n' "$id" "$proj" "$effect" "$def"
  done
}

command -v jq >/dev/null 2>&1 || { echo "cc-decide: jq is required" >&2; exit 1; }

case "${1:-}" in
  open)         shift; cmd_open "$@" ;;
  veto)         shift; cmd_transition veto "$@" ;;
  action)       shift; cmd_transition action "$@" ;;
  list)         shift; cmd_list "$@" ;;
  expire-sweep) shift; cmd_expire_sweep "$@" ;;
  ""|-h|--help|help) usage ;;
  *) printf 'cc-decide: unknown verb %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
