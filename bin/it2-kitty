#!/usr/bin/env bash
# it2-kitty — speak `it2` on the outside, drive kitty on the inside.
#
# PURPOSE. Claude Code's Agent Teams pane backend (`ITermBackend`) shells out to a PATH-resolved
# `it2` binary. It is NOT linked against iTerm2 and performs NO handshake with it — so a program
# that answers the same five subcommands gets Claude Code to build teammate panes in ANY terminal.
# This file is that program for kitty. The result is NATIVE KITTY SPLIT PANES for assignee sessions,
# visible in the operator's window — not a detached tmux session, and with no fork of either app.
#
# ── THE CONTRACT, READ OUT OF THE LIVE 2.1.219 BINARY (do not "improve" it) ──────────────────────
# Decompiled from claude.exe; every element below is load-bearing:
#
#   isAvailable() = wpe() && Uor()
#     wpe(): TERM_PROGRAM==="iTerm.app" || !!ITERM_SESSION_ID || terminal==="iTerm.app"
#            — a pure ENV CHECK. Setting ITERM_SESSION_ID satisfies it. There is no deeper probe.
#     Uor(): NOT a resolution check, despite how it starts. Re-read from the 2.1.219 binary
#            2026-07-31 after an earlier draft of this header described it as resolution-only and
#            that error cost a live outage. In full:
#              1. r = $SHELL -lc "command -v it2"   (2s timeout) → LAST non-empty line, .at(-1)
#              2. o = r || "it2"
#              3. RUNS `<o> session list` and requires exit 0.   ← the actual gate
#              4. retries once with bare "it2" ONLY if that exits 127 / ENOENT — so a program that
#                 exists and fails for any other reason (e.g. the real it2's rc=2 "Not running
#                 inside iTerm2") is terminal: no retry, no fallback.
#              5. on success it CACHES o and drives that exact path for every later call.
#            Two consequences. (a) `-lc` is login-but-NOT-interactive: it reads .zprofile/.zshenv
#            and NEVER .zshrc, so a PATH entry added only in .zshrc does not exist for this lookup.
#            (b) because step 5 caches the resolved path, losing the PATH race does not merely fail
#            on kitty — on iTerm2 it silently bypasses bin/it2-wrapper and all three of its
#            interceptions. scripts/kitty-setup.sh step 3b is what wins that race; it replays this
#            exact sequence in --check rather than testing for files.
#
#   leader id  = ITERM_SESSION_ID.slice(indexOf(":")+1)     ← returns null if there is NO colon,
#                which downgrades the first split to "from active pane". So the session shim MUST
#                export ITERM_SESSION_ID="w0t0p0:<KITTY_WINDOW_ID>" — colon REQUIRED.
#
#   first teammate    : it2 session split -v -s <leader>    (-v ⇒ iTerm2 "Split Vertically" ⇒ RIGHT)
#   later teammates   : it2 session split    -s <prevPane>  (no flag ⇒ iTerm2 default ⇒ BELOW)
#                       ⇒ teammates stack DOWN a column on the RIGHT of the leader. Preserve this
#                         orientation mapping or the swarm layout inverts.
#   parse new pane id : /Created new pane:\s*(.+)/ against our STDOUT, .trim()
#                       ⇒ we MUST print exactly `Created new pane: <id>`; the id is then passed back
#                         verbatim as `-s <id>`, so any opaque token works — we use the kitty id.
#   liveness prune    : on split failure it runs `it2 session list` and tests
#                       stdout.includes(<paneId>) ⇒ list MUST emit raw ids, one per line.
#   send to pane      : it2 session send -s <id> $'\x15'   (Ctrl-U, clears the line) then
#                       it2 session run  -s <id> <text>    (text + Enter)
#   kill pane         : it2 session close -f -s <id>
#
# ── WHY A SHIM AND NOT A FORK ────────────────────────────────────────────────────────────────────
# Forking iTerm2 to get a better renderer means rewriting the per-pane CAMetalLayer/CVDisplayLink
# architecture that measurably saturated WindowServer on this box — i.e. writing a new terminal.
# Forking `it2` gains nothing either: it is a thin client for iTerm2's proprietary Python websocket
# API, so the vendor lock IS the protocol, not the CLI. The cheap seam is the PROCESS BOUNDARY that
# Claude Code already crosses, which is what this file occupies.
#
# ── FAIL-LOUD ────────────────────────────────────────────────────────────────────────────────────
# Claude Code treats a non-zero exit as a real pane failure and falls back (in-process teammates),
# which is the correct, visible degradation. A silent success with no pane created would strand the
# operator watching an empty window, so every path here either creates the pane or exits non-zero.
#
# ── CLOSE-TARGET IDENTITY PIN (2026-08-04) ───────────────────────────────────────────────────────
# A kitty window id is a PER-PROCESS COUNTER that restarts at 1 with every kitty. The iTerm2 session
# UUIDs this shim impersonates are never recycled, which is why every caller in the fleet was
# written as though a stale id could only no-op. Under kitty it cannot: a recorded id survives a
# kitty restart as a perfectly VALID id pointing at a completely unrelated window, and `valid_id` —
# a digits-only SHAPE check — cannot tell the two apart. A positive control closed a non-claude
# window this way.
#
# So `session close` accepts two OPTIONAL pins and verifies them with ONE `kt ls` (measured 0.036 s)
# before closing:
#   --expect-cmdline-match <substring>   the target window's foreground/launch cmdline must contain
#                                        this (callers pass the harness's own `--agent-name <n>`)
#   --expect-generation <pid>            the target window's env.KITTY_PID must equal this
#
# Tri-state, mirroring pane_present's discipline: an unreadable payload, a failed `ls`, or zero
# windows matched ⇒ REFUSE (exit 66), never close. Absence of evidence is not evidence of the right
# target — the whole defect is that the id LOOKS fine.
#
# The pin is CALLER-SUPPLIED and both flags default off. With neither present the close path is
# today's, byte for byte: handoff-fire's self-close, cc-pane and every operator close are untouched,
# so a mispinned or mis-wired check can never become a self-close OUTAGE. Only a caller that knows
# what it expects to be closing can ask to be checked.
#
# Exit codes: 1 kitty failed · 3 not inside kitty · 4 no control socket · 5 pinned binary unusable ·
#             64 unsupported command/verb · 65 bad or missing window id · 66 identity pin
#             unsatisfied or unverifiable (above).
#
# Seams: CC_TERM_KITTY (kitty binary) · CC_TERM_KITTY_TO (socket) · IT2_KITTY_TIMEOUT_S

set -uo pipefail

TIMEOUT_S="${IT2_KITTY_TIMEOUT_S:-15}"

err(){ printf 'it2-kitty: %s\n' "$*" >&2; }

# ── RESOLVE THE KITTY BINARY BY ABSOLUTE PATH, NOT BY NAME ───────────────────────────────────────
# `KITTY_BIN="${CC_TERM_KITTY:-kitty}"` — a bare name — was the whole line here until 2026-08-01, and
# it made EVERY AUTOMATED pane close a no-op on kitty while every interactive one worked.
#
# Hooks and launchd jobs run with a minimal PATH (`/usr/bin:/bin:/usr/sbin:/sbin`) that excludes
# Homebrew, so `kitty` does not exist for them. Measured: a `session close` run under that PATH exits
# `it2-kitty: line 76: kitty: command not found`, rc=1, pane survives — while the identical command
# from an operator's shell closes the pane, rc=0. So the closers that MATTER (teammate-auto-shutdown,
# cc-teardown, cc-reaper, handoff-fire) were the exact set that could not close anything, and the one
# caller that could was the human who never needs to.
#
# ⚠ This is the SAME defect bin/it2-wrapper's `_resolve_timeout()` already documents in the file that
# EXECS this one — "PATH alone is NOT enough: the hooks and launchd jobs that fork this wrapper run
# with a minimal PATH that excludes Homebrew". iTerm2 was immune only because `REAL_IT2` there is a
# hardcoded absolute path; kitty arrived with a bare name and inherited the failure the neighbouring
# comment warns about. A PATH-resolved dependency in a file whose callers are daemons is a latent
# outage, not a style choice — and its polarity is the worst kind: green where a human tests it, dead
# where it runs.
#
# CC_TERM_KITTY is an EXPLICIT operator choice and is NOT a candidate in the search — it either wins
# verbatim or fails loudly. Folding it into the fallback list looks equivalent and is not: a
# CC_TERM_KITTY naming a path that is missing or non-executable would then be silently SKIPPED and an
# auto-detected kitty driven instead, i.e. the operator pins a binary and the shim quietly uses a
# different one. Caught by this file's own control on 2026-08-01 (CC_TERM_KITTY=/nonexistent/kitty
# closed a pane through the real kitty and reported success). An override that can be overridden is
# not an override.
if [[ -n "${CC_TERM_KITTY:-}" ]]; then
  KITTY_BIN="$CC_TERM_KITTY"
  [[ -x "$KITTY_BIN" ]] || { err "CC_TERM_KITTY=$KITTY_BIN is not executable — refusing to silently use a different kitty"; exit 5; }
else
  _resolve_kitty() {
    local c
    for c in "$(command -v kitty 2>/dev/null || true)" \
             /opt/homebrew/bin/kitty /usr/local/bin/kitty \
             /Applications/kitty.app/Contents/MacOS/kitty \
             "$HOME/Applications/kitty.app/Contents/MacOS/kitty"; do
      [[ -n "$c" && -x "$c" ]] && { printf '%s' "$c"; return 0; }
    done
    return 1
  }
  KITTY_BIN="$(_resolve_kitty)" || {
    # Fail LOUD and non-zero: Claude Code reads that as a real pane failure and degrades visibly to
    # in-process teammates, which is correct. A silent no-op here is what stranded live teammate panes.
    err "cannot resolve a kitty binary (tried PATH, /opt/homebrew/bin, /usr/local/bin,"
    err "/Applications/kitty.app/Contents/MacOS/kitty, ~/Applications/...). PATH=$PATH"
    err "If kitty IS installed, this is a minimal-PATH caller (hook/launchd) — set CC_TERM_KITTY."
    exit 5
  }
fi

# Bound every call. kitty's unix socket has no serializing queue (unlike iTerm2's Python API, whose
# unbounded probes deadlocked this fleet on 2026-07-25), but an unbounded call in a spawn path that
# Claude Code awaits would hang teammate creation with no diagnostic.
#
# timeout(1) is resolved the same way and for the same reason — coreutils installs it under Homebrew,
# so a PATH-only lookup left exactly the automated callers unbounded. Unresolvable ⇒ run UNBOUNDED
# rather than refuse: a missing bound degrades this call, a refusal breaks teardown outright.
_resolve_timeout() {
  local c
  for c in "$(command -v timeout 2>/dev/null || true)" "$(command -v gtimeout 2>/dev/null || true)" \
           /opt/homebrew/bin/timeout /usr/local/bin/timeout \
           /opt/homebrew/bin/gtimeout /usr/local/bin/gtimeout; do
    [[ -n "$c" && -x "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}
TIMEOUT_BIN="$(_resolve_timeout || true)"

kt() {
  if [[ -n "$TIMEOUT_BIN" ]]; then "$TIMEOUT_BIN" "$TIMEOUT_S" "$KITTY_BIN" @ ${CC_TERM_KITTY_TO:+--to "$CC_TERM_KITTY_TO"} "$@"
  else "$KITTY_BIN" @ ${CC_TERM_KITTY_TO:+--to "$CC_TERM_KITTY_TO"} "$@"
  fi
}

# ── AM I ACTUALLY IN KITTY? ──────────────────────────────────────────────────────────────────────
# KITTY_LISTEN_ON alone cannot answer this. It is an ordinary exported env var, so an iTerm2.app
# launched from a kitty pane carries it — along with KITTY_WINDOW_ID and KITTY_PID — into every
# iTerm2 pane under it, forever. On 2026-07-31 that made this file drive a background kitty from
# inside genuine iTerm2 panes: the socket check passed, `session list` returned rc 0 (so Claude Code
# cached the pane backend as AVAILABLE), and every assignee spawn then died at USE time on the id
# rejection below, with no fallback to in-process teammates.
#
# This check is deliberately DUPLICATED here rather than left to bin/it2-wrapper's dispatch. The two
# halves deploy by different mechanisms — ~/.claude/bin/it2 is a COPY refreshed only by install.sh,
# while ~/.claude/bin/it2-kitty is a SYMLINK that goes live the moment the repo moves — so a partial
# deploy can leave a stale wrapper diverting to a current translator. The always-fresh half is the
# one that has to be able to say no.
#
# CC_TERM_KITTY_TO is an explicit operator choice of socket and bypasses the ancestry requirement:
# naming a socket IS the statement that you mean to drive that kitty from wherever you are.
if [ -z "${CC_TERM_KITTY_TO:-}" ]; then
  _cc_in_kitty="$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/cc-in-kitty"
  if [ -x "$_cc_in_kitty" ] && ! "$_cc_in_kitty"; then
    err "$("$_cc_in_kitty" --why 2>/dev/null)"
    err "refusing to drive kitty from a pane that is not kitty's — that would send Agent Teams panes"
    err "into a window you are not looking at. Set CC_TERM_KITTY_TO=<socket> if you meant this."
    exit 3
  fi
fi

[ -n "${KITTY_LISTEN_ON:-}${CC_TERM_KITTY_TO:-}" ] || {
  err "no kitty control socket (KITTY_LISTEN_ON unset). kitty.conf needs 'allow_remote_control socket-only' + 'listen_on', and kitty must be RESTARTED — neither option is reloadable."
  exit 4
}

# ── argument shape: it2 session <verb> [flags] [args] ────────────────────────────────────────────
[ "${1:-}" = "session" ] || { err "unsupported command: ${*:-<none>} (this shim implements 'session' only)"; exit 64; }
shift
verb="${1:-}"; shift 2>/dev/null || true

SESSION=""; VERTICAL=0; JSON=0
# The close-target identity pins. Empty = not supplied = today's unchecked close (see the header).
EXPECT_CMDLINE=""; EXPECT_GENERATION=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -s|--session) SESSION="${2:-}"; shift 2 ;;
    -v|--vertical) VERTICAL=1; shift ;;
    # --json is NOT part of Claude Code's contract (ITermBackend calls bare `session list`) but it IS
    # part of THIS REPO's contract: bin/cc-pane:153 and bin/cc-notify both call `session list --json`
    # and jq-parse `.[].id`. Until this flag existed it fell through to the `*)` arm below, landed in
    # ARGS, and `list` ignored ARGS entirely — so both callers got bare integers where they demanded
    # an array. Measured 2026-07-31: jq read each line as a scalar, `n` became a multi-line string,
    # and cc-pane:160 `[ "$n" -eq 0 ]` raised `integer expression expected` and exited INDETERMINATE,
    # while cc-notify's `type=="array"` test failed and its pane-liveness oracle returned "unknown".
    # Both degraded SAFELY, and both were non-functional. Parsed as a flag so it can never reach the
    # send/run text either.
    --json)       JSON=1; shift ;;
    # Close-target identity pins — see § CLOSE-TARGET IDENTITY PIN. Parsed in the SHARED loop, not
    # in the close arm, for the same reason --json is: an unparsed flag falls through to `*)` and
    # lands in ARGS, which for send/run is the TEXT TYPED AT THE PANE. A pin that silently became
    # keystrokes would be worse than no pin.
    --expect-cmdline-match) EXPECT_CMDLINE="${2:-}"; shift 2 ;;
    --expect-generation)    EXPECT_GENERATION="${2:-}"; shift 2 ;;
    # -f is ACCEPTED AND DISCARDED, deliberately — not stored, because nothing downstream can use
    # it: kitty has no running-job confirmation modal, which is the entire reason the iTerm2 wrapper
    # needed a force=True interception. Claude Code always passes it on close, so it must parse
    # without error; binding it to a variable would only invite a reader to "wire it up" later.
    -f|--force)   shift ;;
    --) shift; ARGS+=("$@"); break ;;
    *)  ARGS+=("$1"); shift ;;
  esac
done

# A kitty window id is always an integer. Claude Code hands back whatever token we printed, so a
# non-integer here means the caller is passing an iTerm2 UUID from a previous (real-iTerm2) run —
# refuse rather than silently target the active pane, which would hijack the operator's own window.
valid_id(){ case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

# ── ARGV DELIVERY — the pane's COMMAND is never typed at a prompt (plan §9.1, 2026-08-03) ────────
# Claude Code's ITermBackend spawns a teammate by TYPING: `session send -s <id> ^U` to clear the
# prompt line, then `session run -s <id> <cmd>` for the text and Enter. Two process spawns against
# one mutable resource the HUMAN also owns. On 2026-08-03 a 7-way fan-out lost two of seven agents to
# that race — the operator's in-flight keystroke landed between the two calls and concatenated:
# `ccd …` (command not found) and `tcd …` (parked forever on `correct 'tcd' to 'cd' [nyae]?`). Both
# corruptions were exactly ONE character; both were silent, because Claude Code only checks that the
# KEYSTROKES were delivered, never that anything STARTED.
#
# No amount of escaping or line-clearing closes it — a `^U` was already being sent and is visible as
# literal text in the surviving capture. Correctness would require the operator not to be typing.
# Claude Code's own tmux backend does not have this defect (`tmux respawn-pane -k -t <pane> -- <cmd>`
# makes the pane's ARGV the command), so the remedy here is to give kitty the same shape:
#
#   split → launch the pane running bin/cc-pane-runner (NOT an interactive shell) and mark it ARMED
#   run   → write the command to a file the runner is already blocked on; no prompt is involved
#   send  → nothing to clear on an armed pane, so the ^U is a no-op
#
# The arming is CONSUMED by the runner (it deletes its own marker before exec'ing), so a pane returns
# to the legacy typing transport for every LATER send/run — which is what keeps this safe for the
# callers that legitimately type into an already-running program.
#
# CC_KITTY_ARGV_SPAWN=0 restores the pre-2026-08-03 interactive-shell split verbatim. It is set by the
# two in-repo callers that TYPE into a freshly-split pane rather than `run`-ing one command into it:
# scripts/handoff-fire.sh (bracketed paste + echo-verify + its own engagement assertion) and
# bin/cc-pane's `spawn` (drv_iterm2_send). Arming those would leave their keystrokes buffered in a tty
# nobody reads. The opt-out is per-CALLER and explicit; there is deliberately no attempt to sniff who
# is calling.
CMD_DIR="${CC_PANE_CMD_DIR:-$HOME/.claude/run/kitty-pane-cmd}"
ARGV_SPAWN="${CC_KITTY_ARGV_SPAWN:-1}"
VERIFY_S="${CC_KITTY_SPAWN_VERIFY_S:-20}"
SELF_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")"
RUNNER="${CC_PANE_RUNNER_BIN:-$SELF_DIR/cc-pane-runner}"

armed(){ [ -f "$CMD_DIR/$1.armed" ]; }

pane_exists(){ # $1=window id → 0 present, 1 absent, 2 could not tell
  local out; out="$(kt ls 2>/dev/null)" || return 2
  [ -n "$out" ] || return 2
  printf '%s' "$out" | ID="$1" python3 -c '
import json,os,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(2)
want=os.environ["ID"]
sys.exit(0 if any(str(w["id"])==want for ow in d for t in ow["tabs"] for w in t["windows"]) else 1)'
}

# deliver_argv — hand the command to an ARMED pane as a file, then ASSERT it was picked up.
#
# The assertion is the half Claude Code does not have. Its ITermBackend only checks that `session run`
# exited 0, i.e. that the KEYSTROKES were accepted — which is why all seven spawns reported "Spawned
# successfully" on 2026-08-03 while two of them had already died on the prompt line. Here the ack is
# the runner DELETING the command file, which it does only after reading it, so a non-zero exit from
# this function means the command provably never started. Claude Code turns that into a real
# `Failed to send command to iTerm2 pane <id>` throw — a loud spawn failure instead of a silent one.
#
# This is the LIVENESS half only, and deliberately so: it is on Claude Code's blocking spawn path, so
# it must cost milliseconds in the healthy case (it does — consumption is a 50ms poll away). Whether a
# started agent is making PROGRESS (vs. parked on the .mcp.json trust modal, §9.2) cannot be known
# this early and is asserted separately by bin/cc-spawn-assert.
deliver_argv(){ # $1=pane id  $2=command text
  local pane="$1" text="$2" tmp="$CMD_DIR/$1.cmd.new.$$" deadline
  printf '%s' "$text" > "$tmp" 2>/dev/null || { err "cannot stage the command for pane $pane in $CMD_DIR"; return 1; }
  mv -f "$tmp" "$CMD_DIR/$pane.cmd" 2>/dev/null || {
    rm -f "$tmp" 2>/dev/null; err "cannot deliver the command to pane $pane"; return 1; }

  [ "$VERIFY_S" = 0 ] && return 0
  deadline=$(( $(date +%s) + VERIFY_S ))
  while [ -f "$CMD_DIR/$pane.cmd" ]; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      err "pane $pane never picked up its launch command within ${VERIFY_S}s — the agent did NOT start."
      err "the pane's last lines were:"
      kt get-text --match "id:$pane" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -5 | while IFS= read -r _l; do err "  | $_l"; done
      rm -f "$CMD_DIR/$pane.cmd" 2>/dev/null
      return 1
    fi
    # An absent pane is terminal; an UNREADABLE enumeration is not, and must not be allowed to
    # convict a healthy spawn (rc 2 keeps waiting, exactly as every other liveness oracle in this
    # repo treats indeterminate).
    pane_exists "$pane"; case $? in
      1) err "pane $pane disappeared before it could run its launch command"
         rm -f "$CMD_DIR/$pane.cmd" 2>/dev/null; return 1 ;;
    esac
    sleep 0.05
  done
  return 0
}

# A rejection has to name its own cause. `not a kitty window id: 'E5D77446-…'` was the whole
# diagnostic an operator got on 2026-07-31 while every teammate spawn failed, and it points at the
# id — the one innocent party. The id is correct; the caller is the wrong terminal's.
reject_id(){
  err "not a kitty window id: '$1' (verb: session ${2:-?})"
  case "$1" in
    *-*-*-*-*)
      err "that is an iTerm2 session UUID, so this process was handed an iTerm2 pane to drive."
      err "Cause: KITTY_* env vars are INHERITED — an iTerm2 launched from a kitty pane carries them"
      err "into every pane under it, and bin/it2-wrapper used to divert on KITTY_WINDOW_ID alone."
      err "Fix: deploy the current bin/cc-in-kitty + bin/it2-wrapper (scripts/kitty-setup.sh --apply)."
      ;;
  esac
  exit 65
}

# ── IS THIS WINDOW THE ONE THE CALLER MEANT? ─────────────────────────────────────────────────────
# One `kt ls --match id:<id>` (0.036 s), then every supplied pin must hold. Returns 0 only when the
# evidence AFFIRMS the target; every other outcome — kitty failed, payload unparseable, no window,
# more than one window, a pin unmet, env.KITTY_PID absent — returns 1 and the caller refuses.
#
# The id is re-filtered HERE rather than trusted to kitty's --match, so "exactly one window matched"
# means literally "one window carries this id". A kitty that ignored --match would otherwise hand
# back the whole fleet and the count test would read it as ambiguity by luck rather than by check.
#
# The cmdline haystack is the UNION of every foreground process's cmdline AND the window's own
# launch cmdline — the same union scripts/assignee-chain-state.py:43-48 already reads. Neither half
# alone is sufficient: `foreground_processes` is a SAMPLED process GROUP (bin/cc-spawn-verify:32 —
# live panes have shown caffeinate/tee/an MCP server alongside the binary), and the window cmdline
# is the LAUNCH argv, which for an argv-spawned pane names cc-pane-runner rather than what it
# exec'd. Widening the haystack can only cause a false MATCH on a window that genuinely carries the
# caller's own `--agent-name <member>` string — i.e. the right pane — while narrowing it would cause
# false REFUSALS, and a refusal here means a teammate pane is never reaped.
identity_ok(){
  local id="$1" _err rc _l
  # mktemp with TRAILING Xs — BSD mktemp only substitutes a trailing run (memory: prescribed-remedy-worse).
  _err="$(mktemp "${TMPDIR:-/tmp}/it2-kitty-idpin.XXXXXX" 2>/dev/null || printf '/tmp/it2-kitty-idpin.%s' "$$")"
  kt ls --match "id:$id" 2>"$_err" | \
    WANT_ID="$id" WANT_CMDLINE="$EXPECT_CMDLINE" WANT_GEN="$EXPECT_GENERATION" python3 -c '
import json, os, sys
want_id = os.environ["WANT_ID"]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.stderr.write("payload from kitty ls is unreadable\n"); sys.exit(1)
try:
    rows = [w for ow in d for t in ow.get("tabs", []) for w in t.get("windows", [])
            if str(w.get("id")) == want_id]
except Exception:
    sys.stderr.write("payload from kitty ls has an unexpected shape\n"); sys.exit(1)
if len(rows) != 1:
    sys.stderr.write("expected exactly 1 window with id %s, kitty reported %d\n" % (want_id, len(rows)))
    sys.exit(1)
w = rows[0]
gen = os.environ.get("WANT_GEN", "")
if gen:
    live = str((w.get("env") or {}).get("KITTY_PID", ""))
    if live != gen:
        sys.stderr.write("generation mismatch: window %s belongs to kitty pid %r, caller pinned %r\n"
                         % (want_id, live or "<absent>", gen))
        sys.exit(1)
want = os.environ.get("WANT_CMDLINE", "")
if want:
    hay = [" ".join(p.get("cmdline") or []) for p in (w.get("foreground_processes") or [])]
    hay.append(" ".join(w.get("cmdline") or []))
    if not any(want in h for h in hay):
        sys.stderr.write("cmdline mismatch: window %s runs %r, caller pinned %r\n"
                         % (want_id, " | ".join(h for h in hay if h), want))
        sys.exit(1)
sys.exit(0)' 2>&1 | while IFS= read -r _l; do err "  identity: $_l"; done
  rc="${PIPESTATUS[1]}"
  # kitty's own stderr is RENDERED, never discarded — `kt ls 2>/dev/null` is exactly what hid the
  # bare-name binary defect for its entire life (see the `list` arm).
  if [ -s "$_err" ]; then while IFS= read -r _l; do err "  kitty: $_l"; done < "$_err"; fi
  rm -f "$_err" 2>/dev/null
  [ "${rc:-1}" = 0 ]
}

case "$verb" in

  split)
    # -v ⇒ RIGHT (iTerm2 "Split Vertically"), default ⇒ BELOW. See contract above.
    if [ "$VERTICAL" = 1 ]; then loc=vsplit; else loc=hsplit; fi
    # --keep-focus is LOAD-BEARING, not cosmetic. kitty focuses a newly-launched window by
    # default; iTerm2 does not (its `it2 session split` never calls async_activate, so the pane
    # arrives as a HANDLE and focus is an opt-in nobody opts into). That default difference is the
    # whole reason spawns corrupt under kitty and never did under iTerm2 — not latency, which runs
    # the other way (it2's websocket client is slower per call than kitty's ~50ms).
    #
    # The failure it closes: the backend's contract is split → send Ctrl-U → run <text> (see the
    # header). `launch` starts a bare interactive zsh with no program, so between the line-clear and
    # the command there is a ~50-150ms window in which a FOCUSED pane owns the keyboard. Anything
    # the operator is typing into another pane lands in that window's line buffer — measured
    # 2026-08-03, a single stray `a` turned the teammate launch into `acd …` and, via
    # `setopt CORRECT` (~/.zshrc:53), into an interactive `correct 'acd' to 'cd' [nyae]?` HANG that
    # no caller can distinguish from a working agent. Correct addressing cannot help: the operator's
    # keystrokes and our send-text write to the SAME pty, and a pty has no notion of who typed.
    # `focus_follows_mouse` is unset (kitty default `no`), so the stolen focus is STICKY — it never
    # drifts back, which turns a 100ms race into an open-ended keystroke leak.
    #
    # A/B measured on kitty 0.48.2 at this exact call shape: with the flag, focus HELD at the
    # spawning window while the pane count moved 9→10 (positive control: the window really was
    # created); without it, focus MOVED to the new window. handoff-fire.sh:3739 already carries this
    # flag for the same reason — this path simply never got it.
    #
    # ⚠ THE FLAG CLOSES THE LEAK; IT DOES NOT CLOSE THE RACE — and the paragraph above says why in
    # its own words: "`launch` starts a bare interactive zsh with no program, so between the line-
    # clear and the command there is a ~50-150ms window". Un-focusing the pane removes the operator's
    # keystrokes as a SOURCE, but the window itself is a property of typing a command at a prompt,
    # and anything else that reaches that pty (a stray `session send`, a paste, a `focus_follows_mouse`
    # flip, a caller that legitimately focuses the pane) lands in the same buffer. The ARM path below
    # removes the window instead of the source: an armed pane runs no shell and has no line buffer to
    # land in. The flag stays regardless — it is correct on its own terms, and it is what protects the
    # legacy transport that CC_KITTY_ARGV_SPAWN=0 callers still use.
    launch_args=(launch --type=window --location="$loc" --cwd=current --keep-focus)
    if [ -n "$SESSION" ]; then
      valid_id "$SESSION" || reject_id "$SESSION" split
      # --match window_id: is NOT redundant with --next-to. kitty's launch.py drops --next-to when
      # the target tab does not contain it, and the target tab defaults to the ACTIVE tab — so
      # without --match the anchor is silently discarded and the pane lands somewhere else.
      launch_args+=(--match "window_id:$SESSION" --next-to "id:$SESSION")
    fi

    # ARM the pane: launch the runner instead of an interactive shell, so `run` can hand the command
    # over as a FILE. `-l -i` is load-bearing and not decoration — .zprofile puts ~/.claude/shims on
    # PATH (the login-PATH race, §8.4) and .zshrc synthesizes ITERM_SESSION_ID="w0t0p0:$KITTY_WINDOW_ID",
    # the pane identity every hook, cc-notify address and comms registration is keyed on. Both run
    # BEFORE the runner and export into it. Measured on kitty 0.48.2, pane 331: the new pane's own id,
    # not the leader's, and shims present. `exec "$CC_PANE_RUNNER"` is expanded by the PANE's shell
    # from the --env below, so no path ever has to survive a round of shell quoting.
    arm=0
    if [ "$ARGV_SPAWN" = 1 ] && [ -x "$RUNNER" ]; then
      # Created BEFORE the launch: the runner may reach its wait loop before this shell resumes.
      mkdir -p "$CMD_DIR" 2>/dev/null && chmod 700 "$CMD_DIR" 2>/dev/null
      if [ -d "$CMD_DIR" ] && [ -w "$CMD_DIR" ]; then
        arm=1
        # Single quotes are the POINT, not an oversight: $CC_PANE_RUNNER must survive this shell
        # untouched and be expanded by the PANE's shell from the --env above. Expanding it here would
        # bake a path into an argv that then has to survive kitty's own quoting.
        # shellcheck disable=SC2016
        launch_args+=(--env "CC_PANE_CMD_DIR=$CMD_DIR" --env "CC_PANE_RUNNER=$RUNNER"
                      -- "${SHELL:-/bin/zsh}" -l -i -c 'exec "$CC_PANE_RUNNER"')
      else
        # An unusable state dir must not silently become a TYPED spawn — that is the defect. Say so
        # and fall through to the legacy shell, which is at least the behaviour that was measured.
        err "cannot use command dir '$CMD_DIR' — falling back to a typed spawn (the §9.1 race is live)"
      fi
    elif [ "$ARGV_SPAWN" = 1 ]; then
      err "runner '$RUNNER' is missing or not executable — falling back to a typed spawn (the §9.1 race is live)"
    fi

    new=$(kt "${launch_args[@]}" 2>&1)
    rc=$?
    if [ $rc -ne 0 ] || ! valid_id "$new"; then
      err "kitty launch failed (rc=$rc): $new"; exit 1
    fi
    if [ "$arm" = 1 ]; then
      : > "$CMD_DIR/$new.armed" 2>/dev/null || err "could not mark pane $new armed — its command will be typed"
      # Sweep only OUR OWN filename shapes, and only at this directory level. A bare `find -type f`
      # here would annex anything a future reader co-locates in the dir (memory:
      # content-keyed-dir-annexes-what-you-colocate); the -name fences are what keep it a fence.
      find "$CMD_DIR" -maxdepth 1 -type f \
           \( -name '*.armed' -o -name '*.cmd' -o -name '*.cmd.new.*' \) \
           -mmin +1440 -delete 2>/dev/null
    fi
    # EXACT format the backend regexes: /Created new pane:\s*(.+)/
    printf 'Created new pane: %s\n' "$new"
    ;;

  list)
    # TWO output shapes, one enumeration — and both are load-bearing, so neither may be dropped:
    #   bare (Claude Code)  raw ids, one per line. The backend only does stdout.includes(<id>) for
    #                       dead-pane pruning, and it never passes --json.
    #   --json (this repo)  a JSON array of {id,…}. cc-pane and cc-notify both jq `.[].id`.
    # ids are emitted as STRINGS on the --json side to match the "opaque token" contract the split
    # verb already honours (Claude Code hands whatever token we printed straight back as `-s <id>`),
    # and because every consumer compares them with `grep -qxF` against shell strings.
    #
    # NOTE the ids are FULL and untruncated on both paths. The real it2 renders this list through
    # `rich`, which truncates the Session ID column to the 80 columns it assumes when stdout is a
    # pipe — which makes Claude Code's own `!stdout.includes(fullSessionId)` liveness test always
    # read "dead" and prune teammates on no evidence (plan §4.3). Printing full ids is deliberately
    # BETTER than the incumbent, not merely equal to it.
    # kitty's stderr is CAPTURED, not discarded. `kt ls 2>/dev/null` was the whole reason the
    # bare-name `kitty` defect above was invisible for its entire life: the one line that named the
    # cause — `it2-kitty: line 76: kitty: command not found` — was written to the fd this redirect
    # threw away, and every caller saw only the generic `kitty ls failed`. A diagnostic that
    # discards the diagnosis leaves an operator staring at a healthy-looking terminal and a pane
    # that will not close. It stays off STDOUT (the id list is a parsed contract) but must be
    # RENDERED on failure.
    # mktemp with TRAILING Xs — BSD mktemp only substitutes a trailing run, so an embedded template
    # mints a CONSTANT filename shared by every concurrent caller (memory: prescribed-remedy-worse).
    _kt_err="$(mktemp "${TMPDIR:-/tmp}/it2-kitty-stderr.XXXXXX" 2>/dev/null || printf '/tmp/it2-kitty-stderr.%s' "$$")"
    kt ls 2>"$_kt_err" | JSON="$JSON" python3 -c '
import json,os,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
rows=[w for ow in d for t in ow["tabs"] for w in t["windows"]]
if os.environ.get("JSON")=="1":
    json.dump([{"id": str(w["id"]), "title": w.get("title",""),
                "cwd": w.get("cwd",""), "pid": w.get("pid")} for w in rows], sys.stdout)
    sys.stdout.write("\n")
else:
    for w in rows: print(w["id"])' || {
      err "kitty ls failed (binary: $KITTY_BIN)"
      [ -s "$_kt_err" ] && while IFS= read -r _l; do err "  kitty: $_l"; done < "$_kt_err"
      rm -f "$_kt_err" 2>/dev/null
      exit 1
    }
    rm -f "$_kt_err" 2>/dev/null
    ;;

  send)
    # Raw text, NO newline. Claude Code sends \x15 (Ctrl-U) here to clear the prompt line.
    text="${ARGS[*]:-}"
    if [ -n "$SESSION" ]; then valid_id "$SESSION" || reject_id "$SESSION" send
      # An ARMED pane has no prompt line and no line editor — it is a runner blocked on a file. There
      # is nothing to clear, and anything typed at it would sit unread in a tty buffer, so this is a
      # deliberate no-op rather than a delivery. Exit 0: Claude Code does not check this call's code,
      # but the honest answer is that the requested effect (an empty input line) already holds.
      armed "$SESSION" && exit 0
      kt send-text --match "id:$SESSION" -- "$text" || exit 1
    else kt send-text -- "$text" || exit 1; fi
    ;;

  run)
    # Text + Enter. This is how the teammate's launch command is actually executed.
    text="${ARGS[*]:-}"
    if [ -n "$SESSION" ]; then valid_id "$SESSION" || reject_id "$SESSION" run
      if armed "$SESSION"; then deliver_argv "$SESSION" "$text" || exit 1; exit 0; fi
      kt send-text --match "id:$SESSION" -- "$text"$'\r' || exit 1
    else kt send-text -- "$text"$'\r' || exit 1; fi
    ;;

  close)
    # -f is accepted and ignored: kitty has no running-job confirmation modal, which is the entire
    # reason the iTerm2 wrapper needed a force=True interception. That workaround does not port —
    # it disappears.
    [ -n "$SESSION" ] || { err "close requires -s <id>"; exit 65; }
    valid_id "$SESSION" || reject_id "$SESSION" close
    # A window id is a per-process counter, so `valid_id` proves only that the SHAPE is right. When
    # the caller supplied a pin, prove the TARGET before destroying it. Neither flag ⇒ this whole
    # branch is skipped and the close below is byte-for-byte today's.
    if [ -n "$EXPECT_CMDLINE" ] || [ -n "$EXPECT_GENERATION" ]; then
      identity_ok "$SESSION" || {
        err "refusing to close window $SESSION — it is not the window the caller pinned."
        err "A kitty window id restarts at 1 with every kitty, so a stale id can name a LIVE"
        err "unrelated window. Refusing is the only safe answer; re-derive the id and retry."
        exit 66
      }
    fi
    kt close-window --match "id:$SESSION" || exit 1
    ;;

  focus)  [ -n "$SESSION" ] && kt focus-window --match "id:$SESSION" || exit 1 ;;
  read)   [ -n "$SESSION" ] && kt get-text    --match "id:$SESSION" || exit 1 ;;

  *) err "unsupported subcommand: session $verb"; exit 64 ;;
esac
