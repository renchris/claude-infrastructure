#!/usr/bin/env bash
# cc-relogin-poll — the CADENCE layer for autonomous re-login. One tick per hour (launchd,
# StartInterval 3600); each tick picks AT MOST ONE account and hands it to `cc-relogin`.
#
#   cc-relogin-poll [--json] [--dry-run] [--once] [--trigger-days N] [--escalate-hours N]
#
#   --json               machine-readable result object on stdout
#   --dry-run            decide + report, invoke NOTHING (no cc-relogin, no board row, no state)
#   --once               run exactly one tick and exit — the DEFAULT; accepted so a hand
#                        invocation reads like the launchd one. This tool never loops/daemonizes.
#   --trigger-days N     start attempting at T−N days (default 7)
#   --escalate-hours N   raise the class-C blocker at T−N hours (default 48)
#
# WHY T−7d, not the 72h warn: `cc-relogin` can only act when the account has ZERO live sessions
# (k==0), so a login deadline is otherwise one fragile attempt. A 7-day window turns it into
# ~168 hourly chances to catch a k==0 moment on a busy account.
#
# WHY T−48h escalation: if days of hourly chances never caught a window, silence until the
# deadline IS the failure. At T−48h the poller stops being quiet and raises a class-C
# `relogin-blocked` row on the IDL board carrying the exact runnable recovery command — LOUD
# BEFORE the deadline, never after. The row is raised BEFORE this tick's attempt, so a hung or
# crashing attempt can never swallow the escalation. A row whose `deadline` has since moved is
# historical (dedup key is acct+deadline: one row per deadline, never a per-tick page).
#
# 🚨 The poller NEVER takes /tmp/claude-accounts-heal-<acct>.lock — `cc-relogin` holds it for its
# whole run, so a poller that took it would deadlock its own child. `k` is read only as a cheap
# pre-filter to skip a doomed invocation; the authoritative gate lives inside `cc-relogin`.
#
# Counts ATTEMPTS, not successes (a counter that only moves on success never trips while the
# thing is failing): CC_RELOGIN_POLL_MAX_ATTEMPTS attempts against one deadline escalate early.
#
# Detection ladder — never treat "cannot detect" as "nothing to do":
#   1. `claude-accounts --login-status` (TSV: acct state reason when hours launcher) — support is
#      probed POSITIVELY from the help text, never assumed: on `main` the unknown flag falls
#      through to the human table WITH EXIT 0, which an exit-code check would read as "all clear".
#   2. `claude-accounts --no-heal --fresh --json` → rows[] login_expires_at / login_expires_h /
#      login_expired. `--no-heal` is NOT optional: a bare `--fresh --json` may run the headless
#      heal (`claude auth login`, a token ROTATION) and it takes the very
#      /tmp/claude-accounts-heal-<acct>.lock this poller must never hold. Detection must stay
#      pure-read-only — credentials are `cc-relogin`'s exclusive business.
#   3. neither surface → exit 3 DETECTION-UNAVAILABLE, naming what was missing.
#
# Exit: 0 nothing due / attempted / renewed · 1 poller error (bad args, missing jq, unwritable
# state) · 3 DETECTION-UNAVAILABLE · 5 ESCALATED. A child `cc-relogin` failure is DATA, not a
# poller error — it is logged, counted, and exits 0; the escalation is the loud channel.
#
# Env (test injection): CC_RELOGIN_POLL_LOG · CC_RELOGIN_POLL_STATE_DIR · CC_REAPER_IDL ·
# CC_RELOGIN_POLL_ACCOUNTS_BIN · CC_RELOGIN_POLL_RELOGIN_BIN · CC_RELOGIN_POLL_NOW (fixed clock) ·
# CC_RELOGIN_POLL_MAX_ATTEMPTS (24) · CC_RELOGIN_POLL_TIMEOUT_S (900, child watchdog) ·
# CC_RELOGIN_POLL_DEADLINE_EPSILON_H (12, same-cycle tolerance; 0 = exact match).
set -uo pipefail

JSON=0 DRYRUN=0 TRIG_DAYS=7 ESC_HOURS=48
while [ $# -gt 0 ]; do case "$1" in
  --json)           JSON=1; shift ;;
  --dry-run)        DRYRUN=1; shift ;;
  --once)           shift ;;
  --trigger-days)   TRIG_DAYS="${2:-}"; shift 2 ;;
  --escalate-hours) ESC_HOURS="${2:-}"; shift 2 ;;
  -h|--help)        sed -n '2,12p;29,45p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "cc-relogin-poll: unknown arg $1 (usage: cc-relogin-poll [--json] [--dry-run] [--once] [--trigger-days N] [--escalate-hours N])" >&2; exit 1 ;;
esac; done
case "$TRIG_DAYS" in ''|*[!0-9]*) echo "cc-relogin-poll: --trigger-days needs a non-negative integer" >&2; exit 1 ;; esac
case "$ESC_HOURS" in ''|*[!0-9]*) echo "cc-relogin-poll: --escalate-hours needs a non-negative integer" >&2; exit 1 ;; esac
command -v jq >/dev/null || { echo "cc-relogin-poll: jq required" >&2; exit 1; }

LOG="${CC_RELOGIN_POLL_LOG:-$HOME/.claude/logs/cc-relogin-poll.log}"
STATE_DIR="${CC_RELOGIN_POLL_STATE_DIR:-$HOME/.claude/autonomy/relogin-poll}"
IDL_FILE="${CC_REAPER_IDL:-$HOME/.claude/autonomy/idl.jsonl}"
ACCOUNTS_BIN="${CC_RELOGIN_POLL_ACCOUNTS_BIN:-claude-accounts}"
RELOGIN_BIN="${CC_RELOGIN_POLL_RELOGIN_BIN:-cc-relogin}"
MAX_ATTEMPTS="${CC_RELOGIN_POLL_MAX_ATTEMPTS:-24}"
TIMEOUT_S="${CC_RELOGIN_POLL_TIMEOUT_S:-900}"
EPS_H="${CC_RELOGIN_POLL_DEADLINE_EPSILON_H:-12}"
case "$EPS_H" in ''|*[!0-9]*) echo "cc-relogin-poll: CC_RELOGIN_POLL_DEADLINE_EPSILON_H needs a non-negative integer" >&2; exit 1 ;; esac

# Do two deadlines name the SAME login cycle? Not a rounding nicety — the state key.
#
# $DL is DERIVED as NOW + <remaining>, and <remaining> arrives as claude-accounts' fmt_h() TEXT,
# quantized to 0.1d (~±1.2h — remainder R-6). NOW advances ~3600s per tick, so $DL can only repeat
# across two ticks if <remaining> falls by exactly 3600s, which coarse text cannot do. Keying state
# on `!=` therefore read "the deadline moved → fresh cycle" on essentially EVERY tick. Observed on
# one account over four hours: 19:55:31 → 20:55:48 → 19:31:50 → 20:35:35 → 19:12:27 → 20:21:49.
#
# Three consequences, all measured: attempts never accumulated (all six ATTEMPT lines in the
# production log read `#1`); the MAX_ATTEMPTS arm below was therefore UNREACHABLE; and the class-C
# row raised for `next` on 2026-07-31T20:47:13Z told the operator "no k==0 window caught in 0
# attempt(s)" after FOUR attempts. On the REQUIRED path $DL is NOW itself, so dedup was
# structurally impossible and next2 was paged twice in two hours.
#
# The two populations do not overlap: jitter ≤ ~2.4h between adjacent ticks, a real re-grant moves
# the wall 26.1-30.0d (C1). 12h is 5x the former and 52x under the latter. 0 restores exact match.
same_cycle() {  # <a_epoch> <b_epoch> — success when both are set and within EPS_H of each other
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
  case "$1$2" in *[!0-9]*) return 1 ;; esac
  d=$(( $1 - $2 )); [ "$d" -lt 0 ] && d=$(( 0 - d ))
  [ "$d" -le $(( EPS_H * 3600 )) ]
}

# Tab is IFS *whitespace*, so `IFS=$'\t' read` collapses a RUN of tabs into one delimiter: an
# EMPTY field silently shifts every later field left (a launcher landing in `k` reads as "account
# busy" → the account is never attempted, silently, forever). A non-whitespace IFS is not the fix
# either — macOS ships bash 3.2, whose `read` does not split on \001 at all. So: no field is ever
# allowed to be empty. `norm <n>` pads every row to n fields and fills the empties with "-", which
# each consumer maps back. Every row parsed here — both surfaces AND the state file — goes through it.
norm() { awk -F'\t' -v n="$1" 'BEGIN{OFS="\t"} {if(NF<n)NF=n; for(i=1;i<=n;i++) if($i=="") $i="-"; NF=n; print}'; }
dash() { [ "$1" = "-" ] && printf '' || printf '%s' "$1"; }   # sentinel → empty

now()  { printf '%s' "${CC_RELOGIN_POLL_NOW:-$(date +%s 2>/dev/null || echo 0)}"; }
utc()  { date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo ''; }
log()  { mkdir -p "$(dirname "$LOG")" 2>/dev/null || true; printf '%s %s\n' "$(utc)" "$*" >> "$LOG" 2>/dev/null || true; }
# ISO → epoch. BSD `date -j -f` first (both Z and ±hhmm forms), then GNU `date -d`. 0 = unparseable.
iso_epoch() {
  local iso="$1" e
  [ -n "$iso" ] || { printf '0'; return; }
  e="$(TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%SZ' "$iso" +%s 2>/dev/null)" && { printf '%s' "$e"; return; }
  e="$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "$iso" +%s 2>/dev/null)" && { printf '%s' "$e"; return; }
  e="$(date -d "$iso" +%s 2>/dev/null)" && { printf '%s' "$e"; return; }
  printf '0'
}
epoch_iso() { date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo ''; }
# "41.5h" / "3.7d" / "30m" / "now" / "-3" / "12" → seconds. EMPTY when unrecognised (callers must
# never fabricate a deadline).
#
# NO LONGER THE PRIMARY PATH — and that is the fix. As of 2026-07-30 `--login-status` emits a
# normalised UTC ISO stamp in `when` and a BARE DECIMAL hour count in `hours`, so this function
# now sees only numbers and iso_epoch does the real work. Before that, `when` carried the rendered
# "Sun 13:21", which iso_epoch cannot parse (it returns 0) — so the ISO branch was dead by
# construction and a regex over fmt_h's DISPLAY string was the sole deadline source in the whole
# autonomous re-login path. That is why a cosmetic table change had to be matched by an awk edit
# here. A display format must never be an API.
#
# The unit-aware rules are KEPT as version tolerance, not as the contract: ~/.claude is a symlink
# layer that advances on its own deploy cycle, so a DEPLOYED older claude-accounts keeps emitting
# "2.9d" for a while after this lands. Deleting them would break exactly the window the deploy lag
# opens. They can go once no reachable build renders this field.
#
# UNIT-AWARE because the original parser was `${1%%.*}` + an integer test, which strips the
# fraction AND the unit in one step: "3.7d" became "3" became 3 HOURS. 24x under. It stayed
# latent only because detection was capped at 72h, where fmt_h emits hours; widening the window
# to the declared T-7d walked straight into it, and a T-90h account computed T-3h, escalated
# 3 days early, and poisoned the state file's deadline-keyed dedup on every tick.
# Tolerated: "30m", "41.5h", "2d 6h", "4d", "now", "99d+", and the bare number now sent.
# Float maths goes through awk deliberately: $(( )) is integer-only, and macOS ships bash 3.2.
hours_secs() { # <fmt_h-or-numeric-string> -> seconds | ""
  printf '%s' "${1:-}" | awk '
    { v = $0 }
    v == "" || v == "-" || v == "?"   { exit }                          # no value: refuse
    v == "now"                       { print 0; exit }                 # already past ⇒ NOW
    v ~ /^-/                         { print 0; exit }                 # negative hours ⇒ NOW
    v ~ /d\+$/                       { exit }                          # "99d+" is a display BOUND
    v ~ /^[0-9]+(\.[0-9]+)?m$/       { printf "%d", (v + 0) * 60;    exit }
    v ~ /^[0-9]+(\.[0-9]+)?h$/       { printf "%d", (v + 0) * 3600;  exit }
    v ~ /^[0-9]+(\.[0-9]+)?d$/       { printf "%d", (v + 0) * 86400; exit }
    # "2d 6h" — fmt_h renders every ≥24h countdown this way as of 2026-07-30. Kept BELOW the
    # bare-day rule so "4d" still matches that one. Without this rule the row falls through to
    # "" and an EXPIRING account with no ISO `when` is `continue`d — i.e. widening the window
    # past 24h would have silently dropped the very rows it was widened to catch, the same
    # latent-until-the-window-moves failure the 3.7d→3h bug had.
    v ~ /^[0-9]+d +[0-9]+h$/         { split(v, p, /d +/); sub(/h$/, "", p[2])
                                       printf "%d", p[1] * 86400 + p[2] * 3600; exit }
    v ~ /^[0-9]+(\.[0-9]+)?$/        { printf "%d", (v + 0) * 3600;  exit }   # bare = hours
  '
}

# ── detection ladder ────────────────────────────────────────────────────────────────────────
# ROWS lines (tab-separated, NO empty fields — "-" stands in):
#   acct, deadline_epoch, k, launcher, deadline_src, cause, state
#
# `deadline_src` is the PROVENANCE of column 2, and it exists because that column serves two jobs
# that need different values:
#   ORDERING   — "how urgent is this account?" (the T-window filter + the nearest-first sort + the
#                state file's cycle key). Every row needs a number here, always.
#   PUBLICATION— "when does this account's login actually die?" (the escalation text, the class-C
#                board row, the --json object). Only a MEASURED deadline may be published.
# stamp/hours are measurements. `required` is NOT: it is NOW used as an ordering position for a row
# whose deadline the producer deliberately did not publish (see the REQUIRED arm below), and it is
# the one value that must never be printed as a deadline. `expired` is a measured BOUND — the
# deadline is known to be at or before now.
NOW="$(now)"; ROWS=""; DETECT="unavailable"; MISSING=""; WINDOW_CAPPED=""
# READ THE HELP ONCE, MATCH IT WITH `case` — NEVER `… -h | grep -q` (2026-07-30).
# `grep -q` exits the instant it matches, so the producer is SIGPIPEd on the NEXT line it tries
# to write, and `set -o pipefail` (line 50) promotes that 141 into the pipeline's status. The
# `if` then reads FALSE on a surface that is plainly advertised. Measured on bash 3.2 against a
# 3-line help whose match is line 2: FALSE 263/400 (66%); with pipefail off, 0/400. The REAL
# `claude-accounts --help` prints many lines after the match, so the window is wider still, and
# both probes below were affected — which is what put a spurious `WINDOW-CAPPED` in the live
# poll log while the deployed claude-accounts did support --window-h.
# A false negative here is never cosmetic: it makes this poller declare DETECTION-UNAVAILABLE,
# or silently narrow its window to 72h, exactly when a renewal is due — the precise failure §2
# exists to prevent. Capturing to a variable removes the pipe (and one of the two forks).
# `case` on an already-captured string is bash-3.2 safe: the trap is `case` INSIDE `$( )`.
ACCT_HELP="$("$ACCOUNTS_BIN" -h 2>/dev/null || true)"
case "$ACCT_HELP" in *--login-status*) LS_ADVERTISED=1 ;; *) LS_ADVERTISED=0 ;; esac
if [ "$LS_ADVERTISED" = 1 ]; then
  # ASK FOR OUR OWN WINDOW. --login-status is a pre-FILTERED view, gated at claude-accounts'
  # login_warn_h (72h) — a HUMAN warning constant, not this poller's policy. Reading it bare
  # capped the declared T-7d attempt window at 72h, so 96 of 168 hours were structurally
  # unreachable and the comment at the top of this file described a window the code could not
  # see. Probe support POSITIVELY from the help text, exactly as --login-status itself is probed:
  # an unknown flag here would exit 64 (usage), and a bare exit-code probe cannot distinguish
  # that from a verdict.
  LS_WINDOW=""
  case "$ACCT_HELP" in
    *--window-h*) LS_WINDOW="$((TRIG_DAYS * 24))" ;;
    *) WINDOW_CAPPED="--window-h unsupported on this claude-accounts — detection is capped at its login_warn_h, NOT the declared T-${TRIG_DAYS}d" ;;
  esac
  if [ -n "$LS_WINDOW" ]; then
    LS_OUT="$("$ACCOUNTS_BIN" --login-status --window-h "$LS_WINDOW" 2>/dev/null)"; LS_RC=$?
  else
    LS_OUT="$("$ACCOUNTS_BIN" --login-status 2>/dev/null)"; LS_RC=$?
  fi
  if [ "$LS_RC" -le 2 ]; then
    DETECT="login-status"
    # A capped window is never silent: it is the difference between 168 chances at a k==0
    # moment and 72, on the one account that most needs them.
    [ -n "$WINDOW_CAPPED" ] && log "WINDOW-CAPPED $WINDOW_CAPPED"
    # norm 6 first: the frozen TSV carries an optional `reason`, and an empty one would otherwise
    # collapse with its neighbour and slide `when`/`hours` into the wrong variables.
    while IFS=$'\t' read -r a state reason when hours launcher; do
      case "${state:-}" in REQUIRED|EXPIRING) ;; *) continue ;; esac   # shape-validated, not trusted
      src=stamp; cause="-"
      dl="$(iso_epoch "$(dash "$when")")"
      if [ "$dl" = 0 ]; then
        s="$(hours_secs "$(dash "$hours")")"
        if [ -n "$s" ]; then dl=$((NOW + s)); src=hours
        elif [ "$state" = REQUIRED ]; then
          # REQUIRED's own documented meaning is "action required NOW", so NOW is that surface's
          # ANSWER, not a fabricated deadline. Before this, a REQUIRED row whose cause was not its
          # deadline (a rejected grant with time still on the stamp — next3's real 2026-07-24
          # shape) printed "—" in both deadline columns and was `continue`d: the poller silently
          # dropped the one account that most needed it, forever.
          #
          # …but NOW is that answer only as an ORDERING POSITION, never as a deadline to PUBLISH,
          # and conflating the two is what `src=required` exists to stop. The producer blanks both
          # deadline columns DELIBERATELY, and says so at bin/claude-accounts:2284 — "An account can
          # need /login for a reason that is NOT its deadline … printing that stamp beside REQUIRED
          # read as 'required, and it expires in 14 days'. The deadline columns are therefore filled
          # only when the deadline is what is driving the verdict; otherwise the reason column
          # carries the cause". Reading that "—" as a deadline of NOW re-manufactures exactly the
          # misreading the producer removed, in the opposite direction: measured live on 2026-08-03,
          # next2 escalated TWICE with `T-0h to the login deadline (2026-08-03T14:34:18Z)` while its
          # own grant stamp read 674.6h out (docs/research/forced-relogin-rootcause-2026-08-02.md
          # UPDATE 3). Worse than cosmetic — a class-C row whose `deadline` is NOW is EARLIER than
          # the account's live login_expires_at, which is precisely cc-blockers' stale-drop
          # predicate (bin/cc-blockers drop_stale_relogin), so the loudest surface this poller has
          # discarded the row by construction. Measured: 1 row raised, 0 rendered.
          #
          # So: keep NOW for ordering, publish NO deadline, and carry the `reason` the producer says
          # holds the cause — it was being read into `_reason` and thrown away.
          dl="$NOW"; src=required; cause="${reason:--}"
        else continue; fi                        # EXPIRING with no deadline is genuinely unknowable
      fi
      # k is not in the TSV — resolved lazily, only if we act
      ROWS+="$a	$dl	-	$launcher	$src	$cause	$state"$'\n'
    done < <(printf '%s\n' "$LS_OUT" | norm 6)
  else
    MISSING="claude-accounts --login-status advertised but exited $LS_RC"
  fi
else
  MISSING="claude-accounts --login-status"
fi
if [ "$DETECT" = unavailable ]; then
  JS="$("$ACCOUNTS_BIN" --no-heal --fresh --json 2>/dev/null)"
  if printf '%s' "$JS" | jq -e '[.rows[]? | select(type=="object")
        | select(has("login_expires_at") or has("login_expires_h") or has("login_expired"))] | length > 0' >/dev/null 2>&1; then
    DETECT="json-fields"
    while IFS=$'\t' read -r a at hrs expired k launcher; do
      [ -n "$a" ] && [ "$a" != "-" ] || continue
      src=stamp
      dl="$(iso_epoch "$(dash "$at")")"
      if [ "$dl" = 0 ]; then
        s="$(hours_secs "$(dash "$hrs")")"
        # `expired` is NOT the `required` case: login_expired=true says the deadline is at or
        # before now, so NOW is a MEASURED upper bound and stays publishable. The REQUIRED arm
        # above has no bound at all — its deadline may be weeks out and simply is not the cause.
        if [ -n "$s" ]; then dl=$((NOW + s)); src=hours
        elif [ "$expired" = true ]; then dl="$NOW"; src=expired
        else continue; fi
      fi
      # No state token on this surface — `-`, never a guess. Deriving REQUIRED/EXPIRING here would
      # be a second copy of claude-accounts' classifier, free to rot against it.
      ROWS+="$a	$dl	$k	$launcher	$src	-	-"$'\n'
    done < <(printf '%s' "$JS" | jq -r '.rows[]? | select(type=="object") | [(.acct//""),(.login_expires_at//""),
              ((.login_expires_h // "")|tostring),((.login_expired//false)|tostring),((.k // "")|tostring),(.launcher//"")]
              | @tsv' 2>/dev/null | norm 6)
  else
    MISSING="$MISSING + claude-accounts --fresh --json login_expires_at/login_expires_h/login_expired"
  fi
fi
if [ "$DETECT" = unavailable ]; then
  log "DETECTION-UNAVAILABLE no login-deadline surface: $MISSING — cannot tell whether a re-login is due; NOT treating this as nothing-to-do"
  echo "cc-relogin-poll: DETECTION-UNAVAILABLE — missing: $MISSING" >&2
  [ "$JSON" = 1 ] && jq -nc --arg m "$MISSING" '{ts:(now|todate),detection:"unavailable",missing:$m,action:"none",exit:3}'
  exit 3
fi

# ── select: inside the T−trigger window, nearest deadline first, AT MOST ONE per tick ────────
TRIG_EPOCH=$((NOW + TRIG_DAYS * 86400))
CAND="$(printf '%s' "$ROWS" | awk -F'\t' -v lim="$TRIG_EPOCH" 'NF>=2 && $1!="" && $2 ~ /^-?[0-9]+$/ && $2+0 <= lim' \
        | sort -t$'\t' -k2,2n)"
NCAND="$(printf '%s' "$CAND" | grep -c . || true)"
if [ "${NCAND:-0}" -eq 0 ]; then
  # Name the window ACTUALLY APPLIED, never the one this poller wanted. The old line read
  # "no account inside the T-7d window" while detection was capped at 72h — a claim about a
  # window the code had not looked at, which is how a real cliff 8 days out read as "nothing due".
  log "no account inside the T-${TRIG_DAYS}d window (detection=$DETECT$([ -n "$WINDOW_CAPPED" ] && echo ", WINDOW CAPPED at claude-accounts' login_warn_h — this verdict does NOT cover T-${TRIG_DAYS}d")) — nothing due"
  [ "$JSON" = 1 ] && jq -nc --arg d "$DETECT" --argjson td "$TRIG_DAYS" \
    '{ts:(now|todate),detection:$d,trigger_days:$td,candidates:0,action:"none",exit:0}'
  exit 0
fi
IFS=$'\t' read -r ACCT DL K LAUNCHER DLSRC CAUSE STATE <<< "$(printf '%s' "$CAND" | head -1)"
K="$(dash "$K")"; LAUNCHER="$(dash "$LAUNCHER")"; STATE="$(dash "${STATE:-}")"
DLSRC="$(dash "${DLSRC:-stamp}")"; CAUSE="$(dash "${CAUSE:-}")"; [ -n "$DLSRC" ] || DLSRC=stamp
SECS_LEFT=$((DL - NOW)); HOURS_LEFT=$((SECS_LEFT / 3600))

# ── ORDERING is settled; PUBLICATION starts here, and only a MEASURED deadline crosses ────────
# Below this line $DL and $SECS_LEFT still decide WHAT WE DO (escalate? attempt? which cycle?) —
# that part is right and unchanged. $DL_ISO / $HOURS_LEFT decide WHAT WE CLAIM, and on the
# `required` path there is nothing to claim: DL_ISO is empty and hours_left is JSON null, so no
# consumer can read a fabricated instant back out of this poller. $DL_DISP / $T_DISP are the log's
# renderings of the same two states — "unknown" and "T-?" — never a number we did not measure.
if [ "$DLSRC" = required ]; then
  DL_KNOWN=0; DL_ISO=""; DL_DISP="unknown(no-deadline-published)"; T_DISP="T-?"; HL_JSON=null
else
  DL_KNOWN=1; DL_ISO="$(epoch_iso "$DL")"; DL_DISP="$DL_ISO"; T_DISP="T-${HOURS_LEFT}h"
  HL_JSON="$HOURS_LEFT"
fi

# ── state: attempts + escalation are keyed to THIS deadline; a moved deadline resets both ────
SFILE="$STATE_DIR/relogin-poll-$ACCT.json"; S_DL=""; S_ATT=0; S_ESC=""
if [ -f "$SFILE" ]; then
  IFS=$'\t' read -r S_DL S_ATT S_ESC < <(jq -r '[(.deadline//""),(.attempts//0),(.escalated_for//"")]|@tsv' "$SFILE" 2>/dev/null | norm 3)
  S_DL="$(dash "$S_DL")"; S_ESC="$(dash "$S_ESC")"
fi
case "${S_ATT:-}" in ''|*[!0-9]*) S_ATT=0 ;; esac
same_cycle "$S_DL" "$DL" || { S_ATT=0; S_ESC=""; }    # genuinely moved (or first sighting) → fresh cycle
write_state() { # <attempts> <escalated_for> <result>
  mkdir -p "$STATE_DIR" 2>/dev/null || { echo "cc-relogin-poll: cannot create state dir $STATE_DIR" >&2; exit 1; }
  jq -nc --arg dl "$DL" --argjson att "$1" --arg esc "$2" --arg res "$3" --arg ts "$(utc)" \
    '{deadline:$dl,attempts:$att,escalated_for:$esc,last_ts:$ts,last_result:$res}' > "$SFILE" \
    || { echo "cc-relogin-poll: cannot write state $SFILE" >&2; exit 1; }
}

# ── escalate FIRST (loud before the deadline — a hung attempt must not swallow it) ───────────
RECOVER_CMD="cc-relogin $ACCT"
ESC_NOW=0; ESC_REASON=""
if [ "$SECS_LEFT" -le $((ESC_HOURS * 3600)) ]; then
  # Say which of the two it is. The old text hardcoded the no-window story and read the count off a
  # state that reset every tick, so the real 2026-07-31 board row claimed "no k==0 window caught in
  # 0 attempt(s)" after four attempts — three of which reached cc-relogin.
  ESC_NOW=1
  # WHY we are loud, in the surface's OWN terms. The clock sentence is reachable only when a
  # deadline was measured; a `required` row says what actually drives it — the state and the cause
  # claude-accounts published beside it — and says plainly that no deadline is being claimed. The
  # operator reading "T-0h" against a grant with 674h on its stamp is the defect this replaces.
  if [ "$DL_KNOWN" = 1 ]; then
    ESC_WHY="T-${HOURS_LEFT}h to the login deadline ($DL_ISO)"
  else
    ESC_WHY="login state is REQUIRED now (cause: ${CAUSE:-not published}) and claude-accounts published NO deadline for it — the deadline is not what drives this verdict"
  fi
  if [ "$S_ATT" -eq 0 ]; then
    ESC_REASON="$ESC_WHY and no k==0 window caught yet — every tick so far found live sessions"
  else
    ESC_REASON="$ESC_WHY and $S_ATT attempt(s) against it have not renewed it"
  fi
elif [ "$S_ATT" -ge "$MAX_ATTEMPTS" ]; then
  ESC_NOW=1; ESC_REASON="$S_ATT attempt(s) against deadline $DL_DISP all failed (cap $MAX_ATTEMPTS) — re-login is not self-healing"
fi
ESCALATED=0
if [ "$ESC_NOW" = 1 ]; then
  ESCALATED=1
  if [ "$DRYRUN" = 1 ]; then
    log "DRY-RUN would raise relogin-blocked for $ACCT: $ESC_REASON (recover: $RECOVER_CMD)"
  elif same_cycle "$S_ESC" "$DL"; then
    # Ratchet the stored key forward: the row is on the board for THIS cycle, and the derived
    # deadline drifts every tick, so a fixed key would drift out of tolerance and re-page.
    S_ESC="$DL"
    log "ESCALATED(already) $ACCT deadline=$DL_DISP — row already on the board for this cycle, not re-raising"
  else
    mkdir -p "$(dirname "$IDL_FILE")" 2>/dev/null || true
    # `deadline` is EMPTY, not NOW, when none was measured — and `deadline_known` says which of the
    # two states an empty field is, so no consumer has to guess "unpublished" from "dropped a field".
    # An empty deadline lands in cc-blockers' documented fail-open ("$d == null … keep"): it is the
    # branch that file chose on purpose, on the polarity its author stated — "a stale row is noise,
    # a dropped live one is silence". With NOW here the row was silence.
    # `state` closes a contract cc-blockers already had and this producer never met: its renderer
    # reads `(.state // .reason)` into a 12-char STATE column and its own suite fixtures the field
    # on rows attributed to `cc-relogin-poll` (tests/cc-relogin-status.bats rl()), while every row
    # this poller has ever written omitted it — so that column has only ever shown the first 12
    # characters of the reason prose. Sent when the surface published one; DELETED (not "") when it
    # did not, so the json-fields path keeps falling back to `.reason` exactly as before.
    if jq -nc --arg ts "$(utc)" --arg acct "$ACCT" --arg dl "$DL_ISO" --arg reason "$ESC_REASON" \
              --arg cmd "$RECOVER_CMD" --arg launcher "${LAUNCHER:-}" --arg st "$STATE" \
              --arg src "$DLSRC" --arg cause "$CAUSE" --argjson known "$DL_KNOWN" \
         '{ts:$ts,actor:"cc-relogin-poll",kind:"relogin-blocked",acct:$acct,account:$acct,
           deadline:$dl,deadline_known:($known==1),deadline_src:$src,cause:$cause,state:$st,
           launcher:$launcher,reason:$reason,recover_cmd:$cmd}
          | if $st == "" then del(.state) else . end' >> "$IDL_FILE"
    then
      S_ESC="$DL"; log "ESCALATED $ACCT deadline=$DL_DISP src=$DLSRC reason=$ESC_REASON recover=$RECOVER_CMD"
    else
      log "ESCALATION-WRITE-FAILED $ACCT board=$IDL_FILE — recover: $RECOVER_CMD"
      echo "cc-relogin-poll: could not write the class-C row to $IDL_FILE — recover: $RECOVER_CMD" >&2
    fi
  fi
fi

# ── attempt: k is only a cheap pre-filter; cc-relogin owns the authoritative gate + the lock ──
# (login-status has no k column, so resolve it from the CACHED sweep — never --fresh, an hourly
# job must not force an endpoint sweep just to decide whether to skip.)
[ -n "$K" ] || K="$("$ACCOUNTS_BIN" --no-heal --json 2>/dev/null | jq -r --arg a "$ACCT" '.rows[]? | select(.acct==$a) | (.k // "") | tostring' 2>/dev/null | head -1)"
# ONLY a positive integer counts as busy. Unknown/garbage k → attempt anyway and let cc-relogin's
# authoritative gate refuse: an unreadable pre-filter must never become a silent permanent skip.
case "$K" in ''|0|*[!0-9]*) K_BUSY=0 ;; *) K_BUSY=1 ;; esac
ACTION="invoked"; CHILD_RC=""
if [ "$DRYRUN" = 1 ]; then
  ACTION="dry-run"
  log "DRY-RUN $ACCT deadline=$DL_DISP ($T_DISP, k=${K:-?}, attempts=$S_ATT) would run: $RELOGIN_BIN $ACCT"
elif [ "$K_BUSY" = 1 ]; then
  ACTION="skipped-busy"     # NOT an attempt: nothing was invoked, so the attempt cap must not move
  log "SKIP $ACCT k=$K (>0) — cc-relogin would refuse; deadline=$DL_DISP $T_DISP attempts=$S_ATT"
  write_state "$S_ATT" "$S_ESC" "skipped-busy"
else
  S_ATT=$((S_ATT + 1))
  log "ATTEMPT #$S_ATT $ACCT deadline=$DL_DISP $T_DISP k=${K:-?} → $RELOGIN_BIN $ACCT (child stdout+stderr below)"
  "$RELOGIN_BIN" "$ACCT" >>"$LOG" 2>>"$LOG" &
  cp=$!
  ( sleep "$TIMEOUT_S"; kill -TERM "$cp" 2>/dev/null ) >/dev/null 2>&1 &
  wp=$!
  wait "$cp"; CHILD_RC=$?
  kill "$wp" 2>/dev/null; wait "$wp" 2>/dev/null
  log "RESULT $ACCT attempt=$S_ATT exit=$CHILD_RC$([ "$CHILD_RC" = 0 ] && echo ' PROVEN — deadline should move')"
  write_state "$S_ATT" "$S_ESC" "exit=$CHILD_RC"
fi

if [ "$JSON" = 1 ]; then
  # hours_left is JSON `null` — not 0 — when no deadline was measured. 0 is a NUMBER a consumer
  # will compare, and "T-0h" is exactly the claim this poller must not make; null cannot be
  # mistaken for a countdown, and deadline_known says the emptiness is deliberate.
  jq -nc --arg d "$DETECT" --arg a "$ACCT" --arg dl "$DL_ISO" --arg act "$ACTION" --arg k "${K:-}" \
         --arg rc "${CHILD_RC:-}" --arg reason "$ESC_REASON" --arg cmd "$RECOVER_CMD" \
         --arg src "$DLSRC" --arg cause "$CAUSE" --argjson known "$DL_KNOWN" \
         --argjson td "$TRIG_DAYS" --argjson eh "$ESC_HOURS" --argjson hl "$HL_JSON" \
         --argjson att "$S_ATT" --argjson cand "$NCAND" --argjson esc "$ESCALATED" --argjson dry "$DRYRUN" \
    '{ts:(now|todate),detection:$d,trigger_days:$td,escalate_hours:$eh,candidates:$cand,acct:$a,
      deadline:$dl,deadline_known:($known==1),deadline_src:$src,cause:$cause,
      hours_left:$hl,k:$k,attempts:$att,action:$act,child_exit:$rc,
      escalated:($esc==1),escalation_reason:$reason,recover_cmd:$cmd,dry_run:($dry==1),
      exit:(if ($esc==1 and $dry==0) then 5 else 0 end)}'
fi
[ "$ESCALATED" = 1 ] && [ "$DRYRUN" = 0 ] && exit 5
exit 0
