#!/bin/bash
# cc-inbox-guard — the FAIL-LOUD backstop of the v2 non-keystroke comms channel. A message enqueued to a
# session but never CONSUMED must ALARM, never silently vanish (the frozen guarantee). This is what makes
# the inbox transport safe: delivery is best-effort at a boundary, but an undelivered line is loud.
#
#   cc-inbox-guard sweep            check every inbox; escalate the overdue ones (default; writes markers)
#   cc-inbox-guard sweep --dry-run  classify + print, escalate NOTHING
#   cc-inbox-guard --selftest       RED-prove the alarm fires (and does NOT on a consumed inbox)
#
# WHAT IT WATCHES (critique fixes, keyed on the CONSUMED cursor — never the eager .seen):
#   • unacked mail past a deadline (mailbox_unacked_count = lines − .acked). The drain/fold advance .acked
#     only on proven consumption, so unacked>0 past the deadline = the model never took a turn carrying it.
#   • F8: owner liveness by PANE existence (it2 session list) after a cc-reconcile backfill — NOT registry
#     membership. An INDETERMINATE owner (can't prove the pane gone) ESCALATES — silence is not fail-loud.
#   • NAME-KEYED boxes, not just uuid-keyed ones. `cc-notify --role` writes the role file's value
#     VERBATIM as the mailbox key, and a role legitimately holds "a uuid, a session id, or a pane name"
#     (desk-register / cc-announce). The sweep used to skip any non-hex basename, so mail sent that way
#     sat undelivered with the fail-loud backstop structurally blind to it. Such a box is not
#     adjudicable by `it2 session list` (which lists pane uuids), so its liveness is INDETERMINATE —
#     escalated with that stated, never dressed up as "the pane died".
#   • F12: class-specific deadlines — a reaper/supervisor PAGE ([from] tag) is urgent (short); a peer ping
#     is routine (long). v1's instant keystroke gave confirmed-stuck classes an urgency floor; preserve it.
#   • F11: cursor-past-EOF (.seen or .acked > line count — rotation/GC/recycle can drop mail) alarms too.
#   • F4: enqueue-FAILED records (cc-notify's exit-5 dir) — a message that could not even persist — alarm.
#
# ESCALATION = push-send.sh (the VERIFIED phone leg) + an IDL record + a durable alarm record. Damped per
# (uuid, acked:lines) so the SAME undelivered mail escalates once; new mail or partial progress re-fires.
#
# Env seams (tests): CC_MAILBOX_DIR · CC_INBOX_GUARD_DEADLINE_S (600) · CC_INBOX_GUARD_URGENT_S (60) ·
#   CC_INBOX_GUARD_STATE_DIR · CC_IDL · CC_COMMS_ALARM_DIR · CC_INBOX_GUARD_PUSH_BIN · CC_INBOX_GUARD_IT2 ·
#   CC_INBOX_GUARD_RECONCILE_BIN · CC_INBOX_GUARD_NOW (epoch clock override) · CC_INBOX_GUARD_LIVE_UUIDS
#   (test: space-sep list treated as live panes, bypassing it2).
# bash 3.2-safe. Exit: 0 = swept (escalations may have fired) · 2 = usage.
# shellcheck disable=SC2015  # file-wide: the selftest's `[ test ] && okp || badp` reporter idiom is
# intentional — okp/badp always return 0 (printf + arithmetic), so SC2015's "C runs when A true but B
# fails" cannot occur.
set -uo pipefail

MBOX_DIR="${CC_MAILBOX_DIR:-$HOME/.claude/mailbox}"
DEADLINE_S="${CC_INBOX_GUARD_DEADLINE_S:-600}"
URGENT_S="${CC_INBOX_GUARD_URGENT_S:-60}"
STATE_DIR="${CC_INBOX_GUARD_STATE_DIR:-$HOME/.claude/autonomy/inbox-guard}"
IDL="${CC_IDL:-$HOME/.claude/autonomy/idl.jsonl}"
ALARM_DIR="${CC_COMMS_ALARM_DIR:-$HOME/.claude/autonomy/comms-alarms}"
IT2="${CC_INBOX_GUARD_IT2:-$HOME/.claude/bin/it2}"

command -v jq >/dev/null 2>&1 || { echo "cc-inbox-guard: jq required" >&2; exit 2; }

# shared cursor lib (bin → ../hooks/lib, then ~/.claude/hooks/lib)
_bd="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
_mbxlib="$_bd/../hooks/lib/mailbox-pending.sh"
[ -f "$_mbxlib" ] || _mbxlib="$HOME/.claude/hooks/lib/mailbox-pending.sh"
# shellcheck source=/dev/null
if [ -f "$_mbxlib" ]; then . "$_mbxlib" 2>/dev/null || true; fi
command -v mailbox_lines >/dev/null 2>&1 || { echo "cc-inbox-guard: mailbox lib not usable ($_mbxlib)" >&2; exit 2; }

PUSH_BIN="${CC_INBOX_GUARD_PUSH_BIN:-}"
if [ -z "$PUSH_BIN" ]; then
  for _c in "$_bd/../scripts/push-send.sh" "$HOME/.claude/scripts/push-send.sh" "$(command -v push-send.sh 2>/dev/null || true)"; do
    [ -n "$_c" ] && [ -x "$_c" ] && { PUSH_BIN="$_c"; break; }
  done
fi
# UNSET ⇒ auto-resolve a cc-reconcile. SET — including set to EMPTY ⇒ honored verbatim, so
# `CC_INBOX_GUARD_RECONCILE_BIN=` genuinely disables the backfill fork. `${VAR:-}` could not tell
# unset from set-empty, so the documented "" disable did NOT disable: it fell straight into the
# auto-resolve below and ran the REAL cc-reconcile, which forks `it2 session list --json`
# (cc-reconcile:237). Against a wedged iTerm2 API that fork costs the shim's full 30s bound PER
# SWEEP — and tests/cc-inbox-guard.bats sets exactly this "" to stay hermetic, so all 19 tests
# paid it: the suite printed `1..19`, completed 2, and timed out (rc 124, measured 2026-07-26).
# Because it lives in tests/, that hung the FULL-scope landing gate for every session on this box
# — the wedge's most expensive symptom. Same seam defect as IT2_WRAPPER_TIMEOUT_BIN (it2-wrapper)
# and the earlier cc-inbox-guard fix 02c3de8: a seam that cannot turn a thing OFF is not a seam.
if [ -n "${CC_INBOX_GUARD_RECONCILE_BIN+set}" ]; then
  RECONCILE_BIN="$CC_INBOX_GUARD_RECONCILE_BIN"
else
  RECONCILE_BIN=""
  for _c in "$_bd/cc-reconcile" "$HOME/.claude/bin/cc-reconcile" "$(command -v cc-reconcile 2>/dev/null || true)"; do
    [ -n "$_c" ] && [ -x "$_c" ] && { RECONCILE_BIN="$_c"; break; }
  done
fi

# Bound every external fork that can reach the iTerm2 API. The it2 shim self-bounds at 30s, but
# 30s of dead wait per sweep is still a wedge the guard should not absorb: both consumers here
# ALREADY treat an empty/failed probe as INDETERMINATE and escalate (fail-loud), so a short cap
# converts an indefinite block into the degradation they were built for. PATH alone is not enough
# to find timeout(1) — the launchd jobs that run this sweep have a minimal PATH without Homebrew,
# exactly where coreutils installs it, so an absolute-path fallback list is required or the
# AUTOMATED callers stay unbounded while interactive shells look fine (same resolution as
# it2-wrapper's _resolve_timeout). No timeout(1) anywhere ⇒ run unbounded rather than break the
# call. Seams: CC_INBOX_GUARD_TIMEOUT_S · CC_INBOX_GUARD_TIMEOUT_BIN (set-but-EMPTY disables).
_IG_TIMEOUT_S="${CC_INBOX_GUARD_TIMEOUT_S:-8}"
if [ -n "${CC_INBOX_GUARD_TIMEOUT_BIN+set}" ]; then
  _IG_TIMEOUT_BIN="$CC_INBOX_GUARD_TIMEOUT_BIN"
else
  _IG_TIMEOUT_BIN=""
  for _c in "$(command -v timeout 2>/dev/null || true)" "$(command -v gtimeout 2>/dev/null || true)" \
            /opt/homebrew/bin/timeout /usr/local/bin/timeout \
            /opt/homebrew/bin/gtimeout /usr/local/bin/gtimeout; do
    [ -n "$_c" ] && [ -x "$_c" ] && { _IG_TIMEOUT_BIN="$_c"; break; }
  done
fi
_ig_bounded() { # run "$@" under the cap; unbounded only when no timeout(1) exists
  if [ -z "$_IG_TIMEOUT_BIN" ] || [ ! -x "$_IG_TIMEOUT_BIN" ]; then "$@"; return $?; fi
  "$_IG_TIMEOUT_BIN" -k 3 "$_IG_TIMEOUT_S" "$@"
}

NL='
'          # a literal newline, for exact whole-line `case` matching (bash 3.2-safe; == grep -qxF)

now()  { printf '%s' "${CC_INBOX_GUARD_NOW:-$(date +%s 2>/dev/null || echo 0)}"; }
utc()  { date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo ''; }
stamp(){ date -u +%Y%m%dT%H%M%SZ 2>/dev/null || echo "$$"; }

# ISO ("2026-07-20T02:10:14-0700") → epoch. BSD `date -j -f` first, then GNU `date -d`.
iso_epoch() {
  local iso="$1" e
  e="$(date -j -f '%Y-%m-%dT%H:%M:%S%z' "$iso" +%s 2>/dev/null)" && { printf '%s' "$e"; return; }
  e="$(date -d "$iso" +%s 2>/dev/null)" && { printf '%s' "$e"; return; }
  printf '0'
}

# a mailbox KEY: any safe filename component, not just a UUID (mirrors the lib's _mbx_valid_uuid). The
# guard used to skip every non-hex box outright, so a NAME-keyed inbox — the shape `cc-notify --role`
# produces whenever a role file holds a name rather than a pane uuid, which desk-register and
# cc-announce both document as legal — was never swept and its undelivered mail could never alarm.
valid_key() {
  case "${1:-}" in
    ''|.|..) return 1 ;;
    .*) return 1 ;;
    *[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}
# canonical 8-4-4-4-12 — the shape `it2 session list` can actually adjudicate.
canonical_uuid() {
  case "${1:-}" in
    [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) return 0 ;;
    *) return 1 ;;
  esac
}

# owner liveness by PANE existence (F8): live=0 · dead=1 · indeterminate=2. Test override wins.
#
# The pane list is probed ONCE PER SWEEP and memoized (P1). It used to be re-forked per overdue inbox —
# `it2 session list --json` costs ~0.57 s, so at live scale (47 overdue boxes) that ONE avoidable fork
# was ~27 s of every sweep, and it grew with the backlog. A sweep is a point-in-time classification, so
# one snapshot is not merely cheaper but MORE coherent than 47 probes taken seconds apart. The FAILURE
# verdict is memoized too: if it2 is unreadable it is unreadable for the whole sweep, and re-asking 47
# times cannot change that — every box still returns INDETERMINATE, so fail-loud is untouched.
_LIVE_STATE=""   # '' = not yet probed · ok = have a pane list · bad = it2 unreadable (INDETERMINATE)
_LIVE_IDS=""     # newline-DELIMITED and newline-BRACKETED, so a case-glob match == `grep -qxF`
owner_liveness() {
  local u="$1"
  if [ -n "${CC_INBOX_GUARD_LIVE_UUIDS:-}" ]; then
    case " $CC_INBOX_GUARD_LIVE_UUIDS " in *" $u "*) return 0 ;; *) return 1 ;; esac
  fi
  # A NAME-keyed box is not addressable in `it2 session list` (that lists pane UUIDs), so absence there
  # proves nothing about it. Reporting "the pane died" would be a fabricated cause on a real backlog of
  # mail — INDETERMINATE is the honest verdict, and it escalates just the same. Answered BEFORE the
  # probe, so a name-keyed box also costs nothing (it can never be resolved by the pane list anyway).
  canonical_uuid "$u" || return 2
  if [ -z "$_LIVE_STATE" ]; then
    local raw; raw="$(_ig_bounded "$IT2" session list --json 2>/dev/null || true)"
    if [ -n "$raw" ] && printf '%s' "$raw" | jq -e 'type=="array"' >/dev/null 2>&1; then
      # bracket in TWO steps: `x="$(printf '\n%s\n' …)"` would strip the trailing newline it just added
      # (command substitution eats trailing newlines), leaving the LAST pane in the list unmatchable —
      # i.e. one live session per sweep mis-escalated as a NOW-DEAD pane. Assignment does not strip.
      _LIVE_IDS="$(printf '%s' "$raw" | jq -r '.[].id // empty' 2>/dev/null)"
      _LIVE_IDS="$NL$_LIVE_IDS$NL"
      _LIVE_STATE=ok
    else
      _LIVE_STATE=bad
    fi
  fi
  [ "$_LIVE_STATE" = ok ] || return 2   # it2 unavailable → cannot prove the pane gone → INDETERMINATE
  case "$_LIVE_IDS" in *"$NL$u$NL"*) return 0 ;; esac
  return 1
}

# ── the unacked-window scan (P2) ──────────────────────────────────────────────────────────────────
# ONE awk pass replaces a per-MESSAGE bash loop that forked ~5 processes per line — `sed -n Np` to
# read the line (which also re-read the file from line 1, so an O(n²) scan), two more `sed`s to split
# ts/from-tag, a `date` to epoch it, and a subshell for the class. At live scale (2006 unacked lines)
# that was ~68 s of a ~5-minute reap tick, and it grew with the backlog; the awk pass is ~0.01 s.
#
# EXACTNESS over speed: awk only does the arithmetic for a STRICTLY canonical, in-range
# `YYYY-MM-DDTHH:MM:SS±HHMM`. Anything else non-empty is emitted as an `FB` record and resolved by the
# original `date`-backed iso_epoch, so odd/legacy input keeps the OLD code path verbatim rather than
# inheriting new arithmetic. An EMPTY ts needs no fallback: `date` cannot parse "" either, so the old
# path always landed on ep=now ⇒ age 0, which is what awk scores directly.
#
# Prints `FB <deadline> <ts>` per unresolved line, then exactly one `R <overdue> <oldest_age>`.
scan_window() { # <file> <acked> <lines> <now>
  awk -v ack="$2" -v lim="$3" -v now="$4" -v urg="$URGENT_S" -v dfl="$DEADLINE_S" '
    function dim(y, m) {                       # days in month (proleptic Gregorian)
      if (m==1||m==3||m==5||m==7||m==8||m==10||m==12) return 31
      if (m==4||m==6||m==9||m==11) return 30
      return ((y%4==0 && y%100!=0) || y%400==0) ? 29 : 28
    }
    function dfc(y, m, d,   era, yoe, doy, doe) {   # days from 1970-01-01 (Hinnant days_from_civil)
      if (m <= 2) y = y - 1
      era = int((y >= 0 ? y : y - 399) / 400)
      yoe = y - era * 400
      doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
      doe = yoe * 365 + int(yoe/4) - int(yoe/100) + doy
      return era * 146097 + doe - 719468
    }
    BEGIN { od = 0; oldest = 0 }
    NR <= ack { next }
    NR >  lim { exit }                         # never read past the line count the caller measured
    $0 == ""  { next }
    {
      n = 0; L = length($0)                    # ts = leading run of [0-9T:+-]  (== the old sed)
      while (n < L) { c = substr($0, n+1, 1); if (c ~ /^[0-9T:+-]$/) n++; else break }
      ts = substr($0, 1, n)
      tag = ""; p = index($0, "[")             # from-tag = the FIRST [...] pair (== the old sed)
      if (p > 0) { r = substr($0, p+1); q = index(r, "]"); if (q > 0) tag = substr(r, 1, q-1) }
      # F12 class deadline — THE classifier (it replaced a class_deadline() shell fn; edit it HERE)
      dl = (tag ~ /reaper|supervisor|desk-invariant|deathwatch|PAGE|permission/) ? urg : dfl
      age = -1                                 # -1 = undecided ⇒ hand to the shell fallback
      if (ts == "") age = 0
      else if (ts ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9][+-][0-9][0-9][0-9][0-9]$/) {
        Y=substr(ts,1,4)+0; M=substr(ts,6,2)+0; D=substr(ts,9,2)+0
        h=substr(ts,12,2)+0; mi=substr(ts,15,2)+0; s=substr(ts,18,2)+0
        sg=substr(ts,20,1); oh=substr(ts,21,2)+0; om=substr(ts,23,2)+0
        if (M>=1 && M<=12 && D>=1 && D<=dim(Y,M) && h<=23 && mi<=59 && s<=59 && oh<=23 && om<=59) {
          ep = dfc(Y,M,D)*86400 + h*3600 + mi*60 + s - (oh*3600 + om*60) * (sg == "-" ? -1 : 1)
          # ep<0 (pre-1970) stays UNDECIDED on purpose: BSD date rejects 1900-01-01 and returns -1 for
          # 1600-02-29, so arithmetic here would out-escalate the old path. Let the date path decide.
          if (ep == 0) age = 0                 # ep==0 ⇒ the old path substituted now ⇒ age 0
          else if (ep > 0) { age = now - ep; if (age < 0) age = 0 }
        }
      }
      if (age < 0) { print "FB", dl, ts; next }
      if (age > oldest) oldest = age
      if (age >= dl) od = 1
    }
    END { print "R", od+0, oldest+0 }
  ' "$1" 2>/dev/null
}

idl_rec() { # <uuid> <kind> <detail-json-obj>
  mkdir -p "$(dirname "$IDL")" 2>/dev/null || true
  jq -nc --arg ts "$(utc)" --arg u "$1" --arg kind "$2" --argjson x "${3:-{\}}" \
    '{ts:$ts, actor:"cc-inbox-guard", uuid:$u, kind:$kind} + $x' >> "$IDL" 2>/dev/null || true
}
alarm_rec() { # <uuid> <reason>
  mkdir -p "$ALARM_DIR" 2>/dev/null || true
  jq -nc --arg ts "$(utc)" --arg u "$1" --arg r "$2" \
    '{kind:"undelivered", uuid:$u, reason:$r, ts:$ts}' > "$ALARM_DIR/undelivered-$(stamp)-$$-$RANDOM.json" 2>/dev/null || true
}
phone() { # <title> <msg> — best-effort VERIFIED phone; records the leg's outcome, never crashes the sweep
  [ -n "$PUSH_BIN" ] || { printf 'no-push-bin'; return 0; }
  local prc
  "$PUSH_BIN" send --title "$1" --message "$2" >/dev/null 2>&1; prc=$?
  if [ "$prc" = 0 ]; then printf 'phoned'; else printf 'push-rc-%s' "$prc"; fi
}

DRY=0
escalate() { # <uuid> <acked> <lines> <reason> <phone-msg>
  local u="$1" reason="$4" pmsg="$5"
  # damping: one escalation per (uuid, acked:lines); new mail / partial progress changes the key → re-fire.
  #
  # The cursors are PASSED IN, not re-read (P4). Re-deriving them here re-`grep -c`'d the same inbox a
  # third and fourth time per box — and worse, keyed the damp marker on a state the verdict was never
  # computed from: a message appended between the scan and this call moved the key, so the next sweep
  # damped a verdict that had never been raised for that key. Passing the scanned values makes the
  # marker mean exactly "this reason was raised for THIS state" — cheaper AND race-free.
  local key ackln mk last
  ackln="$2:$3"
  key="$(printf '%s' "$u" | tr -c 'A-Za-z0-9._-' '_')"
  mk="$STATE_DIR/$key.escalated"
  last="$(cat "$mk" 2>/dev/null || true)"
  if [ "$last" = "$ackln" ]; then
    echo "  keep   $u — already escalated (acked:lines=$ackln; damped)"
    return 0
  fi
  if [ "$DRY" = 1 ]; then echo "  WOULD-ESCALATE $u — $reason"; return 0; fi
  local pr; pr="$(phone "⚠️ UNDELIVERED comms" "$pmsg")"
  alarm_rec "$u" "$reason"
  idl_rec "$u" "undelivered-escalated" "$(jq -nc --arg r "$reason" --arg p "$pr" '{reason:$r, phone:$p}')"
  mkdir -p "$STATE_DIR" 2>/dev/null || true; printf '%s' "$ackln" > "$mk" 2>/dev/null || true
  echo "  ESCALATE $u — $reason (phone: $pr)"
}

sweep() {
  [ "${1:-}" = "--dry-run" ] && DRY=1
  echo "cc-inbox-guard sweep$([ "$DRY" = 1 ] && echo ' (DRY-RUN)') — deadline=${DEADLINE_S}s urgent=${URGENT_S}s"
  # backfill the registry first so a live-but-unregistered pane is classifiable (F8), gated off dry-run.
  [ "$DRY" = 0 ] && [ -n "$RECONCILE_BIN" ] && _ig_bounded "$RECONCILE_BIN" >/dev/null 2>&1 || true
  local now; now="$(now)"; local n_esc=0

  # F4: enqueue-FAILED records — a message that could not even persist. Escalate + consume the record.
  if [ -d "$ALARM_DIR" ]; then
    local ef
    for ef in "$ALARM_DIR"/enqueue-fail-*.json; do
      [ -e "$ef" ] || continue
      local tgt msg; tgt="$(jq -r '.target // "?"' "$ef" 2>/dev/null)"; msg="$(jq -r '.msg // ""' "$ef" 2>/dev/null)"
      if [ "$DRY" = 1 ]; then echo "  WOULD-ESCALATE [enqueue-fail] $tgt"; else
        phone "⚠️ comms enqueue FAILED" "inbox unwritable for $tgt — NOT delivered: $msg" >/dev/null
        idl_rec "$tgt" "enqueue-failed-escalated" "$(jq -nc --arg m "$msg" '{msg:$m}')"
        mv -f "$ef" "$ef.handled" 2>/dev/null || rm -f "$ef" 2>/dev/null || true
      fi
      n_esc=$((n_esc+1))
    done
  fi

  [ -d "$MBOX_DIR" ] || { echo "cc-inbox-guard: no mailbox dir — $n_esc escalation(s)"; return 0; }
  local f u lines acked unacked
  for f in "$MBOX_DIR"/*.md; do
    [ -e "$f" ] || continue
    u="$(basename "$f" .md)"
    valid_key "$u" || continue
    lines="$(mailbox_lines "$u")"; acked="$(mailbox_acked "$u")"
    # `lines - acked` IS mailbox_unacked_count, computed from the two values already in hand (P3).
    # Calling the helper re-derived both cursors from scratch — mailbox_acked → mailbox_seen →
    # mailbox_lines — re-`grep -c`-ing the same file a third and fourth time, per box, for no new fact.
    unacked=$(( lines - acked )); [ "$unacked" -lt 0 ] && unacked=0

    # F11: a raw cursor PAST EOF (before the lib clamp) = rotation/GC/recycle that can silently drop mail.
    local raw_seen; raw_seen="$(head -n1 "$MBOX_DIR/$u.seen" 2>/dev/null | tr -dc '0-9')"; raw_seen="${raw_seen:-0}"
    if [ "${raw_seen:-0}" -gt "$lines" ] 2>/dev/null; then
      escalate "$u" "$acked" "$lines" "cursor past EOF (.seen=$raw_seen > lines=$lines) — mailbox rotated/truncated under a live cursor; mail may have been dropped" \
        "inbox $u cursor past EOF ($raw_seen>$lines) — possible dropped mail"
      n_esc=$((n_esc+1))
    fi

    [ "$unacked" -gt 0 ] 2>/dev/null || continue   # nothing unconsumed → fine

    # the oldest unacked line (line acked+1) and its class deadline; escalate if ANY unacked line is overdue.
    local overdue=0 oldest_age=0 scanres
    local kind a1 a2 ep age
    scanres="$(scan_window "$f" "$acked" "$lines" "$now")"
    # a here-doc (NOT a pipe) so the loop runs in THIS shell and its verdict actually survives
    while read -r kind a1 a2; do
      case "$kind" in
        R)  # a1=overdue a2=oldest_age, over every line awk resolved itself
            [ "$a1" = 1 ] && overdue=1
            [ "${a2:-0}" -gt "$oldest_age" ] 2>/dev/null && oldest_age="$a2" ;;
        FB) # a1=class deadline a2=ts — awk declined it, so resolve on the ORIGINAL date path verbatim
            ep="$(iso_epoch "$a2")"; [ "$ep" = 0 ] && ep="$now"   # unparseable ts → treat as now (fail toward NOT over-alarming a fresh line)
            age=$(( now - ep )); [ "$age" -lt 0 ] && age=0
            [ "$age" -gt "$oldest_age" ] && oldest_age="$age"
            [ "$age" -ge "$a1" ] 2>/dev/null && overdue=1 ;;
      esac
    done <<SCANEOF
$scanres
SCANEOF
    [ "$overdue" = 1 ] || { echo "  ok     $u — $unacked unacked but within deadline (oldest ${oldest_age}s)"; continue; }

    owner_liveness "$u"; local lv=$?
    case "$lv" in
      0) escalate "$u" "$acked" "$lines" "LIVE session, $unacked message(s) unconsumed for ${oldest_age}s past deadline — its watcher lapsed / it never took a turn to drain" \
                  "desk/session $u: $unacked message(s) undrained ${oldest_age}s (live but not consuming) — re-engage it" ;;
      1) escalate "$u" "$acked" "$lines" "$unacked message(s) enqueued to a NOW-DEAD pane ($u) — the target died with mail undelivered" \
                  "session $u died with $unacked undelivered message(s) — the page never reached anyone" ;;
      *) escalate "$u" "$acked" "$lines" "$unacked message(s) unconsumed ${oldest_age}s AND owner liveness INDETERMINATE ($(canonical_uuid "$u" && echo 'it2 unreadable' || echo "'$u' is a NAME-keyed box — not a pane uuid it2 can adjudicate")) — cannot prove delivery" \
                  "inbox $u: $unacked undelivered ${oldest_age}s, liveness unknown — fail-loud escalate" ;;
    esac
    n_esc=$((n_esc+1))
  done
  echo "cc-inbox-guard: sweep done — $n_esc escalation(s)$([ "$DRY" = 1 ] && echo ' (dry-run: none fired)')"
  return 0
}

# ── selftest: RED-prove the alarm fires for undelivered-to-live past deadline, and NOT for a consumed inbox ──
PASS=0; FAIL=0
okp()  { printf '  ok   %s\n' "$1"; PASS=$((PASS+1)); }
badp() { printf '  FAIL %s\n' "$1"; FAIL=$((FAIL+1)); }
selftest() {
  # d is script-scope (NOT local): the EXIT trap fires after this function returns, where a `local` would
  # be out of scope under `set -u`. Guard with ${d:-} for belt-and-suspenders.
  d="$(mktemp -d "${TMPDIR:-/tmp}/cc-inbox-guard-selftest.XXXXXX")" || { echo mktemp; exit 1; }
  trap 'rm -rf "${d:-}"' EXIT
  export CC_MAILBOX_DIR="$d/mbox"; export CC_INBOX_GUARD_STATE_DIR="$d/state"; export CC_IDL="$d/idl.jsonl"
  export CC_COMMS_ALARM_DIR="$d/alarms"; export CC_INBOX_GUARD_DEADLINE_S=600
  mkdir -p "$CC_MAILBOX_DIR"
  local U="AAAAAAAA-1111-2222-3333-444444444444"
  local pushlog="$d/push.log"
  export CC_INBOX_GUARD_PUSH_BIN="$d/push"; { printf '#!/bin/bash\n'; printf 'printf "%%s\\n" "$*" >> "%s"\nexit 0\n' "$pushlog"; } > "$d/push"; chmod +x "$d/push"
  export CC_INBOX_GUARD_RECONCILE_BIN=""; export CC_INBOX_GUARD_LIVE_UUIDS="$U"
  local SELF; SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  # an old (2h-stale) unacked message to a LIVE session, .acked=0 → MUST escalate
  printf '2026-07-20T00:00:00+0000 [reaper] crashed pane needs triage\n' > "$CC_MAILBOX_DIR/$U.md"
  CC_INBOX_GUARD_NOW=$(( $(date -j -f '%Y-%m-%dT%H:%M:%S%z' '2026-07-20T02:00:00+0000' +%s 2>/dev/null || date -d '2026-07-20T02:00:00+0000' +%s) )) \
    "$SELF" sweep >/dev/null 2>&1
  [ -s "$pushlog" ] && [ -n "$(find "$d/alarms" -name 'undelivered-*.json' 2>/dev/null)" ] \
    && okp "undelivered-to-LIVE past deadline → phone + alarm record (fail-loud)" \
    || badp "an undelivered-to-live message did NOT escalate"
  # now mark it consumed (.acked=1) → a re-sweep must NOT escalate (no double-alarm on delivered mail)
  : > "$pushlog"; rm -f "$d"/alarms/*.json 2>/dev/null || true; rm -rf "$CC_INBOX_GUARD_STATE_DIR" 2>/dev/null
  printf '1\n' > "$CC_MAILBOX_DIR/$U.acked"; printf '1\n' > "$CC_MAILBOX_DIR/$U.seen"
  CC_INBOX_GUARD_NOW=$(( $(date -j -f '%Y-%m-%dT%H:%M:%S%z' '2026-07-20T02:00:00+0000' +%s 2>/dev/null || date -d '2026-07-20T02:00:00+0000' +%s) )) \
    "$SELF" sweep >/dev/null 2>&1
  [ ! -s "$pushlog" ] && [ -z "$(find "$d/alarms" -name 'undelivered-*.json' 2>/dev/null)" ] \
    && okp "CONSUMED (.acked advanced) inbox → NO escalation (guard keys on .acked, not .seen)" \
    || badp "the guard escalated a consumed inbox (false alarm)"
  # enqueue-fail record → escalate (F4)
  : > "$pushlog"; mkdir -p "$d/alarms"; printf '{"kind":"enqueue-failed","target":"%s","msg":"x"}' "$U" > "$d/alarms/enqueue-fail-test.json"
  "$SELF" sweep >/dev/null 2>&1
  [ -s "$pushlog" ] && okp "F4: enqueue-FAILED record → phone escalation (a message that could not persist)" \
    || badp "an enqueue-fail record did not escalate"
  echo "cc-inbox-guard --selftest: $PASS passed, $FAIL failed"
  [ "$FAIL" -eq 0 ] || exit 1
  echo "cc-inbox-guard --selftest: GREEN — undelivered-to-live + enqueue-fail escalate; consumed does not."
}

case "${1:-}" in
  sweep)       sweep "${2:-}" ;;
  --selftest)  selftest ;;
  -h|--help|"") sed -n '2,32p' "$0"; exit 0 ;;
  *)           echo "cc-inbox-guard: unknown command '$1' (sweep | --selftest)" >&2; exit 2 ;;
esac
