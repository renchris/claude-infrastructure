#!/usr/bin/env bash
# cc-jev — operate and MEASURE the Jev evaluation path. The library hooks call is
# hooks/lib/jev.sh; this is the human-facing side of it.
#
#   cc-jev status            what is configured and what is missing. Read-only, no network.
#   cc-jev probe             ONE real call. Proves the key, the model id and the ZDR route.
#   cc-jev ask <file|->      raw {state,questions} through the same path a hook uses.
#   cc-jev pilot [-n N]      score Jev against REAL closes this fleet already labelled.
#
# WHY `pilot` IS THE POINT OF THIS FILE. The whole case for the semantic arm in
# anti-deference-nudge.sh rests on Jev being good at ONE judgment on OUR corpus, and
# docs/research/jev-at-cost-api-2026-09-18.md §5 states the evidence position plainly: "Nobody
# has ever scored Jev against real labels." Every number in circulation is the vendor's or a
# relay of it, and the one independent bench says Jev's terminal verdict LOSES to Haiku 4.5
# (62.6% vs 81.3%) while its decomposed extractor form wins on cost and speed at parity. So the
# arm ships DISABLED-BY-DEFAULT and this command is how it earns the right to be turned on.
#
# 🚨 `pilot` SENDS REAL CLOSING MESSAGES TO A THIRD PARTY. That is a new sub-processor for this
# fleet's own prose, so it is GATED on a typed yes and never runs as a side effect of anything.
# ZDR is on and fails closed, and only the closing message is sent — no transcript, no paths, no
# history. It is still the operator's call, not the agent's.
set -uo pipefail

# Resolve $0 through its symlinks BEFORE deriving anything from it. ~/.claude/{bin,scripts}/ are
# per-file symlinks into the checkout, so an unresolved `dirname "$0"/..` yields ~/.claude — which
# has no node_modules, no tests/ and no .git. The script would not fail; it would read the WRONG
# TREE, and only on the live path (memory symlinked-$0-splits-siblings). No `readlink -f`: GNU-only.
_resolve_self() {
  local p="$1" d
  while [ -L "$p" ]; do
    d="$(cd -P "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  printf '%s' "$p"
}
_self="$(_resolve_self "${BASH_SOURCE[0]}")"
ROOT="$(cd -P "$(dirname "$_self")/.." && pwd)"
# shellcheck source=/dev/null
. "$ROOT/hooks/lib/jev.sh"

die() { printf '%s\n' "$*" >&2; exit 2; }

cmd_status() {
  local key deps node_ok arm src
  src="$(jev_secret_source)"
  key=$([ "$src" = none ] && echo "NO" || echo "yes (via $src)")
  deps=$([ -d "$ROOT/node_modules/ai" ] && echo yes || echo "NO")
  node_ok=$(command -v node >/dev/null && node --version || echo "NO")
  arm=$([ "${CC_JEV:-1}" = "0" ] && echo "off (CC_JEV=0)" || echo on)
  printf 'root        %s\n' "$ROOT"
  printf 'node        %s\n' "$node_ok"
  printf 'deps (ai)   %s\n' "$deps"
  printf 'API key     %s\n' "$key"
  printf 'kill switch %s\n' "$arm"
  printf 'model       %s\n' "${CC_JEV_MODEL:-typesafe-ai/jev}"
  printf 'threshold   P(true) >= %s\n' "$CC_JEV_MIN_P"
  printf 'timeout     %s ms (maxRetries 0)\n' "$CC_JEV_TIMEOUT_MS"
  printf 'ZDR         %s\n' "$([ "${CC_JEV_ZDR:-1}" = 0 ] && echo OFF || echo "on, fails closed")"
  # EGRESS — checked by NAME, never inferred from a failed call. `agent-secrets run` starts a
  # CONNECT proxy whenever this file exists, and a host missing from it is blocked outright; at
  # runtime that is indistinguishable from a network blip, so it has to be said here or it gets
  # rediscovered the hard way. Reported, never written: an allowlist is an authorisation
  # boundary and belongs to the operator.
  if [ "$src" = "agent-secrets" ] && [ -f "$CC_JEV_EGRESS_ALLOW" ]; then
    if grep -qF "$CC_JEV_GATEWAY_HOST" "$CC_JEV_EGRESS_ALLOW" 2>/dev/null; then
      printf 'egress      %s allowlisted\n' "$CC_JEV_GATEWAY_HOST"
    else
      printf 'egress      🚨 %s NOT in %s — every call will be BLOCKED by the proxy\n' \
             "$CC_JEV_GATEWAY_HOST" "$CC_JEV_EGRESS_ALLOW"
    fi
  fi
  echo
  if jev_available; then
    # CONFIGURED is not ABLE TO ANSWER, and reporting the first as "live" was measurably wrong.
    # On 2026-09-19 every field above read healthy while EVERY call returned HTTP 403 and the arm
    # abstained 100% of the time: ZDR is Pro/Enterprise-only and FAILS CLOSED, so on a hobby plan
    # `ZDR on` is not a protection that is holding — it is a guarantee that no verdict can ever be
    # produced. A status that reports CONFIGURATION and calls it LIVENESS is the same defect as a
    # threshold shipped above the model's output range
    # (docs/lessons/an-imported-threshold-can-sit-above-the-model-s-output-range.md): the feature
    # lands inert and every green light stays green. So this branch states the one condition that
    # decides whether a verdict is REACHABLE, and claims nothing it has not checked. It stays a
    # STATIC read — no probe call — because a status command must not spend egress to render.
    echo "CONFIGURED — the semantic arm in anti-deference-nudge.sh is wired in."
    if [ "${CC_JEV_ZDR:-1}" != 0 ]; then
      cat <<'EOF'

🚨 CONFIGURED IS NOT ANSWERING. ZDR is Pro/Enterprise-only and fails closed, so on a hobby plan
   every call returns HTTP 403 and the arm abstains 100% of the time — measured here, not
   inferred. Nothing above is misconfigured; the PLAN is the blocker. Two ways out, and both are
   the operator's to take, never an agent's:
     · buy Vercel Pro (~$20/mo) and keep zero-data-retention, or
     · run with CC_JEV_ZDR=0, which sends the model's own closing message (bounded by
       CC_JEV_MAX_STATE_B — no transcript, no paths, no history) under STANDARD retention.
   The measured trade is in decision packet c3752f5fca96.
EOF
    fi
    echo
    echo "Next: cc-jev probe   (one real call), then cc-jev pilot (score it on real closes)."
    jev_free_window
  else
    echo "DISABLED — every consumer falls through to today's behaviour. Nothing is degraded."
    [ "$deps" = "NO" ] && echo "  to fix deps: (cd $ROOT && npm install)"
    [ "$src" = none ] && cat <<'EOF'
  to fix the key — in YOUR terminal, not through an agent:
      1. create one at https://vercel.com/dashboard  ->  AI Gateway  ->  API Keys
      2. agent-secrets add AI_GATEWAY_API_KEY      (paste at its prompt; the value never
                                                    touches a transcript, a profile or argv)
  This command deliberately does NOT write the key, or any allowlist, for you.
EOF
    jev_free_window
  fi
}

# THE FREE WINDOW, RENDERED FROM A DATE RATHER THAN ASSERTED. It used to be one sentence in the
# DISABLED branch — "Jev is free on the Gateway until 2026-09-25" — which is the branch an operator
# who has ALREADY set everything up never sees, and it was a bare claim with no expiry behaviour:
# on 2026-09-26 it would have gone on saying "free until" a date in the past. Both halves matter
# here, because the whole reason this integration exists is to be exercised inside that window.
# After it lapses the cost is not a cliff: $0.042/MTok in, $0 out, measured at ~960 calls/day
# ≈ $2.45/mo for the production arm, against a key already capped at $5/mo.
jev_free_window() {
  # The prices are LITERAL dollar signs, not expansions. Carried in a variable rather than inline
  # so the printf formats hold no `$` at all: a `# shellcheck disable=SC2016` would work, but this
  # file's own corpus warns that a directive separated from its subject silently stops applying
  # (marker-adjacency), and two future edits to these lines would each have to remember it.
  local usd='$'
  local until="${CC_JEV_FREE_UNTIL:-2026-09-25}" today days
  today="$(date -u +%Y-%m-%d)"
  if [ "$today" \> "$until" ]; then
    printf '\nFree window CLOSED (ended %s). Metered now: %s0.042/MTok in, %s0 out —\n' \
           "$until" "$usd" "$usd"
    printf 'measured ~960 calls/day ≈ %s2.45/mo for the arm, under the %s5/mo key cap.\n' \
           "$usd" "$usd"
    return
  fi
  days=$(( ( $(date -u -j -f %Y-%m-%d "$until" +%s 2>/dev/null || echo 0) \
             - $(date -u +%s) ) / 86400 ))
  [ "$days" -ge 0 ] 2>/dev/null || days=0
  printf '\nFree on the Gateway until %s — %s day(s) left. After that it is metered, not cut off:\n' \
         "$until" "$days"
  printf '%s0.042/MTok in, %s0 out ≈ %s2.45/mo at the measured ~960 calls/day, under the %s5/mo cap.\n' \
         "$usd" "$usd" "$usd" "$usd"
}

cmd_probe() {
  jev_available || die "not available — run: cc-jev status"
  local out rc
  out="$(jq -n '{
    state: "The build failed with exit code 1.",
    questions: {
      passed: { type: "boolean", instructions: "Did the build succeed?",
                criteria: { true: "exit code 0", false: "any non-zero exit code" } },
      area:   { type: "choice", instructions: "Which area is this?",
                criteria: { build: "compilation or packaging", test: "a failing test", deploy: "a release step" } }
    }}' | jev_ask)"
  rc=$?
  printf '%s\n' "$out" | jq .
  if [ "$rc" -ne 0 ]; then
    printf '\nABSTAINED (%s) — no verdict was produced.\n' "$(jev_reason "$out")" >&2
    return 1
  fi
  # A correct model answers ~0 here. This is a smoke test of the ROUTE, not of accuracy.
  printf '\nroute OK. P(passed)=%s expected near 0.\n' "$(printf '%s' "$out" | jq -r '.answers.passed.probability')"
}

cmd_ask() {
  local src="${1:--}"
  jev_available || die "not available — run: cc-jev status"
  if [ "$src" = "-" ]; then jev_ask; else [ -r "$src" ] || die "unreadable: $src"; jev_ask < "$src"; fi
  echo
}

usage() { sed -n '3,9p' "$_self" | sed 's/^# \{0,1\}//'; }

case "${1:-status}" in
  status) cmd_status ;;
  probe)  cmd_probe ;;
  ask)    shift; cmd_ask "${1:--}" ;;
  pilot)  shift; exec "$ROOT/scripts/jev/pilot.sh" "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
