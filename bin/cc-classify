#!/bin/bash
# cc-classify — idle-CAUSE classifier for a Claude Code session. The BRAIN of the autonomous
# lifecycle reaper: it decides WHY a session is idle so the reaper (bin/cc-reaper) can reap ONLY
# the provably-terminal, work-safe causes and NEVER an active/waiting/limited one.
#
#   cc-classify <target> [--json]     target = sessionId | paneUUID | friendly-name
#   cc-classify --all [--json]        classify every live session across the 4 accounts
#   cc-classify selftest              RED-proof each cause against fixtures (no real session)
#
# CAUSES (exactly one per session):
#   active            recent *assistant* turn (< idle threshold), pid alive        → NEVER reap
#   rate-limited      a structured usage-cap API error in the transcript tail       → NEVER reap
#   owned-wait        pid alive, idle, a legitimate wait (live teammates / user)    → NEVER reap
#   coordination-hang pid alive, idle, had REAL teammates but none alive / no prog  → NEVER reap (surface)
#   handed-off-lead   idle, fired a /handoff, a live successor exists elsewhere      → reap IFF work landed
#   finished-teammate a SPAWNER-STAMPED fired worker in a worktree, idle, done       → reap IFF work landed
#   finished          a SPAWNER-STAMPED fired worker, idle past threshold, work LANDED (on trunk) → reap
#   finished-operator an OPERATOR pane (no fired stamp), idle, landed — looks done   → NEVER reap (surface)
#   crashed           owning process is DEAD                                         → NEVER auto-reap (surface)
#
# SAFETY: the three REAPABLE causes (handed-off-lead, finished-teammate, finished) demand POSITIVE
# evidence (a fired handoff + a live successor; a spawner fired-stamp + worktree + idleness; a
# spawner fired-stamp + work durably landed + idle). Every ambiguous/idle case falls to a NEVER-reap
# cause. 2026-07-24 (Danny-Studio-60 / Opus-5 incident): "done" additionally requires the pane not be
# OPERATOR-HELD — between prompts a live operator conversation is indistinguishable from "done" by
# idle+clean+landed alone (a Q&A session that writes nothing is ALWAYS clean & 0 ahead), so two
# sessions the operator had typed into 12-14 min earlier were reaped as finished/finished-teammate.
# Two structural guards close it: (1) a REAL operator-typed prompt within INTERACTIVE_HOLD_S reads
# owned-wait (operator ADOPTION — for a fired worker only prompts AFTER firedAt+slack count; the fire
# brief itself arrives as a user prompt); (2) finished/finished-teammate require the spawner's
# cc-fired stamp — an unstamped "done" pane is finished-operator, surfaced for confirm-close, never
# auto-reaped (the reaper's north star: an idle handed-off lead never lingers, NOTHING else is killed). The implicit-team model (CC 2.1.178+)
# writes a team config for EVERY session — a config alone is NOT a coordination context; only a member
# beyond the in-process `team-lead` placeholder is (else every idle solo session read as coordination-hang
# and nothing could ever be `finished`). Work-landed and the final teardown gate are re-checked by the reaper
# and cc-teardown — this classifier is the FIRST of a defence-in-depth chain, never the only one.
# Inputs are read from durable signals (last-ASSISTANT-ts, registry pid, git, structured API error,
# process liveness), NEVER file mtime alone (mtime bumps on any append; memory cc-notify-session-pane).

set -uo pipefail

SESSIONS_BIN="${CC_CLASSIFY_SESSIONS_BIN:-cc-sessions}"
PS_BIN="${CC_CLASSIFY_PS_BIN:-/bin/ps}"
IDLE_S="${CC_CLASSIFY_IDLE_S:-300}"                 # < this since last assistant turn ⇒ active
COORD_HANG_DEAD_REAP_S="${CC_CLASSIFY_COORD_HANG_DEAD_REAP_S:-7200}"  # a coordination-hang idle past this WITH a live co-cwd owner ⇒ abandoned zombie (reapable)
NOW="${CC_CLASSIFY_NOW:-$(date +%s)}"
PROJECT_ROOTS="${CC_CLASSIFY_PROJECT_ROOTS:-$HOME/.claude/projects $HOME/.claude-secondary/projects $HOME/.claude-tertiary/projects $HOME/.claude-quaternary/projects}"
GIT_BIN="${CC_CLASSIFY_GIT_BIN:-git}"
TRUNK="${CC_CLASSIFY_TRUNK:-origin/main}"
TEAMS_GLOB="${CC_CLASSIFY_TEAMS_GLOB:-$HOME/.claude*/teams}"
WAIT_CONTRACTS_DIR="${CC_CLASSIFY_WAIT_CONTRACTS_DIR:-$HOME/.claude/wait-contracts}"   # L2 wait system (a17 S-3)
DESK_ROLE_FILE="${CC_CLASSIFY_DESK_ROLE_FILE:-$HOME/.claude/cc-roles/desk}"            # desk-role never-reap (a17 S-3)
FIRED_DIR="${CC_FIRED_DIR:-$HOME/.claude/cc-fired}"          # spawner↔reaper fired-peer contract (T-P3-4; shared name with cc-reaper)
FIRED_BOOT_MAX_S="${CC_FIRED_BOOT_MAX_S:-1800}"             # stamp tenancy: a fired worker boots within this of firedAt; a later tenant is a stale stamp (2026-07-24)
INTERACTIVE_HOLD_S="${CC_CLASSIFY_INTERACTIVE_HOLD_S:-21600}"  # operator prompt within this ⇒ ADOPTED pane, never-reap (2026-07-24)
INTERACTIVE_HOLD_DISABLE="${CC_CLASSIFY_INTERACTIVE_HOLD_DISABLE:-0}"  # tests-only: 1 turns the operator-adoption hold OFF deliberately
FIRE_PROMPT_SLACK_S="${CC_CLASSIFY_FIRE_PROMPT_SLACK_S:-300}"  # prompts within this of firedAt = the spawn brief, not adoption
# CC_CLASSIFY_INTERACTIVE_TAIL_BYTES (tail window, default 2000000; recency needs the tail only) is read
# DIRECTLY by hooks/lib/cc-interactive.sh — no shell var here, since last_interactive_epoch just wraps the lib.
# ── safeguard-blocked detection (2026-07-25) — a model CONTENT-safeguard refusal that is the tail's
#    TERMINAL conversational event (no real user/assistant turn after it) is a dead-on-arrival block,
#    NOT "finished". A fired peer blocked on its first turn leaves an EMPTY thinking block as its last
#    non-error assistant record, so last_assistant_ts computes an idle and it would otherwise read
#    finished-teammate → auto-reaped as if it did its work (it did NOTHING). Signatures are CONFIGURABLE
#    + case-insensitive (matched against the isApiErrorMessage text); the model_refusal_no_fallback
#    system subtype is an independent STRUCTURAL corroborator (the cleanest deterministic marker).
# default built in a single-quoted var — bash 3.2 (macOS) mishandles a literal apostrophe inside "${x:-…}"
_SG_SIG_DEFAULT='safeguards flagged this message|can'\''t respond to this request with|may flag safe, normal content'
SAFEGUARD_SIGNATURES="${CC_CLASSIFY_SAFEGUARD_SIGNATURES:-$_SG_SIG_DEFAULT}"
SAFEGUARD_REFUSAL_SUBTYPE="${CC_CLASSIFY_SAFEGUARD_SUBTYPE:-model_refusal_no_fallback}"
SAFEGUARD_IDLE_S="${CC_CLASSIFY_SAFEGUARD_IDLE_S:-120}"   # refusal terminal AND idle >= this ⇒ blocked
# ── task-less (2026-08-08): booted this long ago with ZERO assistant turns ever ⇒ a pane that started
#    claude and never got a brief. Sized well above any real first-turn latency (a fired peer's first
#    assistant record lands in seconds; the slowest cold start measured is far under a minute), because
#    the ONLY cost of a too-large value is that an empty pane stays invisible a while longer, while a
#    too-small one mislabels a session that is merely early. FLOORED like INTERACTIVE_HOLD_S — a
#    mis-set (empty / non-numeric / tiny) value must never make this fire at boot age ~0.
TASKLESS_BOOT_S="${CC_CLASSIFY_TASKLESS_BOOT_S:-1800}"
case "$TASKLESS_BOOT_S" in
  ''|*[!0-9]*) TASKLESS_BOOT_S=1800 ;;
  *) [ "$TASKLESS_BOOT_S" -lt 60 ] 2>/dev/null && TASKLESS_BOOT_S=1800 ;;
esac

die(){ printf 'cc-classify: %s\n' "$*" >&2; exit 2; }

# ONE stderr line per INVOCATION (not per pane) when the interactive primitive is unresolvable, and
# it carries the remediation rather than just the symptom. Damped because --all classifies N panes
# through the same missing lib: N identical lines is noise an operator learns to skip, and the
# condition is a property of the deploy, not of any one pane. stderr only — stdout stays parseable
# JSON for every consumer (cc-reaper, cc-teardown, the desk).
_CI_LIB_WARNED=0
ci_lib_warn() {
  [ "$_CI_LIB_WARNED" = 1 ] && return 0
  _CI_LIB_WARNED=1
  printf 'cc-classify: hooks/lib/cc-interactive.sh unresolvable — cannot read WHO drove the last turn, so operator adoption is UNKNOWN; every idle pane falls closed to owned-wait (never-reap, fail-closed) instead of finished. Fix: run ./install.sh from the checkout to (re)link it.\n' >&2
}
command -v jq >/dev/null || die "jq required"

# HOLD FLOOR (2026-07-24 rule 5): a too-small hold (unset/0/<60) is almost certainly a mis-set env, and
# a near-zero hold silently disables the operator-adoption guard — the exact reap this fix closes. Floor
# to the 21600 default and WARN (stderr, so --json stdout stays clean). An explicit
# CC_CLASSIFY_INTERACTIVE_HOLD_DISABLE=1 (tests only) turns the hold off on purpose (no warning).
if [ "$INTERACTIVE_HOLD_DISABLE" != 1 ]; then
  case "$INTERACTIVE_HOLD_S" in
    ''|*[!0-9]*) _hold_bad=1 ;;
    *) [ "$INTERACTIVE_HOLD_S" -lt 60 ] 2>/dev/null && _hold_bad=1 || _hold_bad=0 ;;
  esac
  if [ "${_hold_bad:-0}" = 1 ]; then
    printf 'cc-classify: INTERACTIVE_HOLD_S=%s invalid (<60s) — flooring to 21600\n' "${INTERACTIVE_HOLD_S:-unset}" >&2
    INTERACTIVE_HOLD_S=21600
  fi
fi

# G9 (2026-07-25) — a LIVE hold-disable must not be SILENT. CC_CLASSIFY_INTERACTIVE_HOLD_DISABLE=1 is
# the tests-only kill switch for the §4.7 operator-adoption hold — i.e. it removes the single guard the
# 2026-07-24 Danny-Studio-60 / Opus-5 incident added, and the floor above deliberately exempts it, so
# set live it reproduces the pre-incident reaper exactly and nothing anywhere says so. It stays HONORED
# (a floor cannot police an explicit override, and the bats suite depends on it), but outside bats it
# now leaves evidence: one loud stderr line + ONE IDL record, in the same append-only ledger cc-audit
# and cc-idl already read, so "why was that pane reaped" stays answerable after the fact. Behavior is
# otherwise unchanged. stdout stays clean (--json consumers unaffected); every write is best-effort.
if [ "$INTERACTIVE_HOLD_DISABLE" = 1 ] && [ -z "${BATS_TEST_FILENAME:-}" ]; then
  printf 'cc-classify: ⚠ CC_CLASSIFY_INTERACTIVE_HOLD_DISABLE=1 outside tests — the §4.7 operator-adoption hold is OFF; an operator-adopted pane can be classified REAPABLE (the 2026-07-24 incident shape). Unset it unless you are running tests.\n' >&2
  _idl="${CC_IDL:-$HOME/.claude/autonomy/idl.jsonl}"
  mkdir -p "$(dirname "$_idl")" 2>/dev/null || true
  # jq-encode every field: one malformed line aborts cc-audit's `jq -rs` slurp (which reads as "no
  # records" and silently flips the alarm green) — the same rule hooks/completion-assert.sh log_idl uses.
  jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '?')" --arg target "${1:-?}" \
    '{ts:$ts,hook:"cc-classify",sid:"?",disposition:"warned",reason:"interactive-hold-disabled",target:$target}' \
    >> "$_idl" 2>/dev/null || true
fi

# ── shared interactive-recency primitive (the ONE WHO-drove-the-last-turn signal) ──────────────
# hooks/lib/cc-interactive.sh owns ci_last_interactive_epoch; last_interactive_epoch (below) is a thin
# wrapper. Same resolve order as cc-reaper's libs: beside-script → CLAUDE_CONFIG_DIR → ~/.claude.
_CI_HERE="$(cd "$(dirname "$0")" && pwd)"
for _c in "$_CI_HERE/../hooks/lib/cc-interactive.sh" \
          "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/lib/cc-interactive.sh" \
          "$HOME/.claude/hooks/lib/cc-interactive.sh"; do
  # shellcheck disable=SC1090,SC1091
  [ -f "$_c" ] && { . "$_c" 2>/dev/null || true; break; }
done

# ── the ONE origin/tenancy oracle (row dcf58e1ba056) ──────────────────────────────────────────
# hooks/lib/origin-identity.sh owns fired_stamp_tenancy — the shared absent|valid|spent|stale|unknown
# state model. Until now this script held a SECOND, divergently-keyed copy of the same question
# (fired_peer's startedAt boot window), and two auditors over one population that disagree is the
# defect itself (MEMORY sibling-auditors-must-share-the-state-model). Same resolve order as above.
# Seam: CC_FIRED_DIR (already this script's $FIRED_DIR) — the lib takes an explicit stamp path, so the
# suite drives it through the same temp store cc-classify reads, with no second env to pin.
for _c in "$_CI_HERE/../hooks/lib/origin-identity.sh" \
          "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/lib/origin-identity.sh" \
          "$HOME/.claude/hooks/lib/origin-identity.sh"; do
  # shellcheck disable=SC1090,SC1091
  [ -f "$_c" ] && { . "$_c" 2>/dev/null || true; break; }
done
_OI_LIB_WARNED=0
oi_lib_warn() {
  [ "$_OI_LIB_WARNED" = 1 ] && return 0
  _OI_LIB_WARNED=1
  printf 'cc-classify: hooks/lib/origin-identity.sh unresolvable — cannot ask the shared origin/tenancy oracle, so NO stamp can be proven tenancy-valid; every stamped pane falls closed to the operator-safe cause (never auto-reap). Fix: run ./install.sh from the checkout to (re)link it.\n' >&2
}

# ── input helpers (all read-only) ─────────────────────────────────────────────────────────────
iso_to_epoch() { # <iso8601 e.g. 2026-07-16T22:46:27.449Z> → epoch seconds (empty on parse fail)
  local s="${1%%.*}"; s="${s%Z}"                    # drop fractional seconds + trailing Z
  [ -z "$s" ] && return 0
  TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$s" +%s 2>/dev/null || true
}
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
pid_lstart() { # <pid> → normalized ps lstart string (identity pin, a17 S-4). Matches cc-teardown's format.
  [ -n "${1:-}" ] || return 0
  "$PS_BIN" -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ *//;s/ *$//'
}

find_transcript() { # <sid> → path to its .jsonl (first match across the account roots)
  local sid="$1" r f
  for r in $PROJECT_ROOTS; do
    [ -d "$r" ] || continue
    f="$(find "$r" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null | head -1)"
    [ -n "$f" ] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

last_assistant_ts() { # <jsonl> → epoch of last real assistant turn (excludes sidechain + api-error)
  local f="$1" iso
  [ -f "$f" ] || return 1
  iso="$(jq -rc 'select(.type=="assistant" and (.isSidechain|not) and ((.isApiErrorMessage//false)|not)) | .timestamp' "$f" 2>/dev/null | tail -1)"
  [ -n "$iso" ] && iso_to_epoch "$iso"
}

# turn-census (2026-08-08, the task-less blind spot): "<assistant-count> <real-user-count>" on stdout,
# rc 1 iff the file could not be READ. last_assistant_ts() returns EMPTY for three different answers —
# transcript unresolvable, transcript resolved-but-zero-assistant-records, and timestamp unparseable —
# and classify_entry collapses all three into IDLE=-1 ⇒ CAUSE=active ⇒ neither reaped nor paged. This
# function exists to separate "answered: never spoke" from "could not ask" (memory
# sensor-default-off-makes-blindness-the-shipping-path: one probe value for both is how blindness ships).
#
# THE rc CHECK IS LOAD-BEARING, NOT HYGIENE. A live session's transcript is being appended to RIGHT NOW,
# so its trailing line is routinely a partial write; measured 2026-08-08, jq exits 5 on such a file and a
# naive `jq … | wc -l` still prints the count of the records BEFORE the parse error — i.e. a transcript
# truncated before its first assistant record reports "0 assistant turns" for a session that is actively
# working. Capturing jq's own rc (never a pipeline's — memory pipefail-inverts-early-exit-probe) is what
# keeps an unreadable file an UNREADABLE answer instead of a confident zero.
turn_census() { # <jsonl> → "<assistant> <real-user>"; rc 1 = unreadable (never a count)
  local f="${1:-}" out line a=0 u=0
  [ -n "$f" ] && [ -f "$f" ] || return 1
  out="$(jq -rc 'if (.type=="assistant" and (.isSidechain|not) and ((.isApiErrorMessage//false)|not)) then "A"
                 elif (.type=="user" and (.isSidechain|not) and ((.isMeta//false)|not)) then "U"
                 else empty end' "$f" 2>/dev/null)" || return 1
  while IFS= read -r line; do
    case "$line" in A) a=$((a+1)) ;; U) u=$((u+1)) ;; esac
  done <<EOF
$out
EOF
  printf '%s %s' "$a" "$u"
}

recent_api_limit() { # <jsonl> → 0 if a structured USAGE-CAP api error is among the last records
  local f="$1"
  [ -f "$f" ] || return 1
  # isApiErrorMessage is the SIGNAL (never text-grep 429 — mostly false positives, aa49); the text
  # is only to confirm it is a real cap ("session limit"/"weekly limit"), not a transient blip.
  # a18 L-14: a MONTHLY spend cap is a BILLING-plane error ("You've hit your monthly spend limit") the
  # old set missed entirely, so a spend-capped clean+landed session read `finished` and was reapable.
  tail -n 60 "$f" 2>/dev/null \
    | jq -rc 'select((.isApiErrorMessage//false)==true) | (.message.content // [] | map(.text // "") | join(" "))' 2>/dev/null \
    | grep -qiE 'session limit|weekly limit|usage limit|limit ·|resets|monthly spend limit|spend limit|billing'
}

parse_blocked_model() { # <refusal-text> → best-effort model name (e.g. "Fable 5"), empty if unparseable
  local t="$1" m
  # "…can't respond to this request with <Model>." — the authoritative phrasing.
  m="$(printf '%s' "$t" | sed -nE 's/.*[Rr]espond to this request with ([A-Za-z][A-Za-z0-9]*( [0-9]+(\.[0-9]+)*)?).*/\1/p' | head -1)"
  # fallback: "API Error: <Model>'s safeguards …"
  [ -z "$m" ] && m="$(printf '%s' "$t" | sed -nE "s/^API Error: ([A-Za-z][A-Za-z0-9]*( [0-9]+(\.[0-9]+)*)?)'s safeguards.*/\1/p" | head -1)"
  printf '%s' "$m"
}

safeguard_blocked() { # <jsonl> → prints "<refusal-iso>\t<refusal-text>", returns 0 if the tail's TERMINAL
  # conversational event is a model CONTENT-safeguard refusal (nothing real after it). A refusal is either
  # a system record with subtype==$SAFEGUARD_REFUSAL_SUBTYPE OR an isApiErrorMessage assistant whose text
  # matches a configured (case-insensitive) signature. A "real turn" that would mean RECOVERY is a genuine
  # user prompt or a content-bearing NON-error assistant turn. Blocked ⟺ the last of these two kinds is a
  # refusal. Terminal-refusal grabs the informative (text-bearing) refusal's ts+text.
  local f="$1" tagged tb="${CC_CLASSIFY_INTERACTIVE_TAIL_BYTES:-2000000}"
  [ -f "$f" ] || return 1
  tagged="$(tail -c "$tb" "$f" 2>/dev/null | jq -Rrc \
      --arg sub "$SAFEGUARD_REFUSAL_SUBTYPE" --arg sig "$SAFEGUARD_SIGNATURES" '
      ($sig | ascii_downcase | split("|")) as $sigs
      | fromjson? | objects | . as $r
      | ([ (($r.message.content) // []) | if type=="array" then .[]? else empty end
           | select(.type=="text") | (.text // "") ] | join(" ") | gsub("[\\t\\r\\n]"; " ")) as $txt
      | ($txt | ascii_downcase) as $lc
      | if ($r.type=="system" and (($r.subtype // "") == $sub)) then "REFUSAL\t\t"
        elif ($r.type=="assistant" and (($r.isApiErrorMessage // false) == true)
              and (any($sigs[]; . as $s | ($s|length) > 0 and ($lc | contains($s))))) then
          "REFUSAL\t" + ($r.timestamp // "") + "\t" + $txt
        elif ($r.type=="user" and ($r.isMeta != true)
              and ((($r.message.content|type) == "string" and (($r.message.content|length) > 0))
                   or (($r.message.content|type) == "array"
                       and ([$r.message.content[]? | select(.type=="tool_result")] | length) == 0
                       and ([$r.message.content[]? | select(.type=="text" and ((.text//"")|length) > 0)] | length) > 0))
              ) then "TURN"
        elif ($r.type=="assistant" and (($r.isApiErrorMessage // false) != true)
              and ([ (($r.message.content) // [])[]? | select(.type=="text" and ((.text//"")|length) > 0) ] | length) > 0
              ) then "TURN"
        else empty end
    ' 2>/dev/null)"
  [ -n "$tagged" ] || return 1
  printf '%s\n' "$tagged" | awk -F'\t' '
      { if ($1=="REFUSAL") { last="R"; if ($2!="" || $3!="") { rts=$2; rtxt=$3 } }
        else if ($1=="TURN") { last="T" } }
      END { if (last=="R") { print rts "\t" rtxt; exit 0 } exit 1 }'
}

handoff_fired() { # <jsonl> → 0 if the session actually FIRED a SELF-/handoff near the end
  local f="$1"
  [ -f "$f" ] || return 1
  # SELF-scoped tell (a18 L-3): a Bash tool_use that INVOKES the handoff mechanism AND is a self-op
  # (--recycle / self-close), or a bare /handoff — and does NOT target ELSEWHERE (--cwd / --worktree,
  # i.e. a third-party fire spawning some OTHER session). It is NEVER a mere Read of a *-resume.md
  # payload (reading a resume doc is not "I handed MYSELF off"), and NEVER the CC-native
  # `bridge-session` record (aa49). Reads carry .input.file_path, not .input.command — restricting to
  # .input.command drops them; the per-command awk keeps the --cwd/--worktree exclusion SCOPED to the
  # same command (a session may BOTH self-recycle AND third-party-fire in one tail window).
  tail -n 80 "$f" 2>/dev/null | jq -rc '
      if .type=="assistant"
      then (.message.content // [] | map(select(.type=="tool_use") | (.input.command // empty)) | .[])
      else empty end' 2>/dev/null \
    | awk '
        /(^|[ =])--cwd([ =]|$)/ || /(^|[ =])--worktree([ =]|$)/ { next }   # third-party fire → skip
        {
          mech   = ($0 ~ /handoff-fire\.sh/) || ($0 ~ /scripts\/handoff\.sh/)
          selfop = ($0 ~ /(^|[ ])--recycle([ ]|$)/) || ($0 ~ /(^|[ ])self-close([ ]|$)/)
          bare   = ($0 ~ /(^| )\/handoff( |$)/)
          if ((mech && selfop) || bare) { found = 1; exit }
        }
        END { exit(found ? 0 : 1) }'
}

tool_in_flight() { # <jsonl> → 0 if a tool is RUNNING: the transcript's LAST record is an assistant
  # tool_use whose id has no matching tool_result anywhere (a18 L-13). "idle" must mean no-new-assistant
  # AND no-tool-in-flight; a single long Bash/build/test call otherwise leaves the last record an
  # assistant tool_use timestamped at call START, so IDLE crosses 300s mid-call and reads `finished`.
  # In a real transcript a finished turn's last record is an assistant TEXT turn or a `user` tool_result
  # (never a bare trailing tool_use) — so this fires ONLY for a genuine mid-call state.
  local f="$1" last_rec tu_id
  [ -f "$f" ] || return 1
  last_rec="$(tail -n 1 "$f" 2>/dev/null)"
  [ -n "$last_rec" ] || return 1
  # last record must be an assistant message carrying at least one tool_use block
  printf '%s' "$last_rec" | jq -e '.type=="assistant" and ((.message.content // []) | map(select(.type=="tool_use")) | length > 0)' >/dev/null 2>&1 || return 1
  tu_id="$(printf '%s' "$last_rec" | jq -r '(.message.content // []) | map(select(.type=="tool_use")) | last | .id // empty' 2>/dev/null)"
  if [ -n "$tu_id" ]; then
    # a matching tool_result (a `user` record block) anywhere ⇒ the tool returned ⇒ not in-flight
    jq -rc 'select(.type=="user") | (.message.content // []) | if type=="array" then .[] else empty end | select(.type=="tool_result") | .tool_use_id // empty' "$f" 2>/dev/null \
      | grep -qxF "$tu_id" && return 1
  fi
  return 0   # trailing tool_use with no (matching) result → a tool is running
}

find_successor() { # <this-sid> <this-cwd> <since-epoch-SECONDS> <all-json> → candidate {paneUUID,pid} objects, one/line
  local sid="$1" cwd="$2" since="${3:-0}" all="$4"
  # A handoff continues the SAME work in the SAME cwd. A successor is a DISTINCT session (different
  # session_id) in that cwd, started at/after this session's last turn. Liveness (kill -0) is checked
  # by the caller — a dead 'successor' is no successor. Exclude self by session_id, never by pane
  # (a --recycle successor reuses the pane; a self-close successor gets a new one).
  # UNIT FIX (a18 L-3): registry startedAt is epoch-MILLISECONDS (session-register.sh:69 `date +%s*1000`)
  # while $since is epoch-SECONDS (a last-assistant ts). The old `startedAt >= since` was ms>=s — VACUOUS
  # (always true), so even a sibling started long BEFORE the "handoff" counted. Compare startedAt/1000.
  printf '%s' "$all" | jq -rc --arg cwd "$cwd" --arg sid "$sid" --argjson since "${since:-0}" '
      .[] | select(.cwd==$cwd)
          | select((.session_id // .sessionId // "") != $sid)
          | select($since==0 or ((.startedAt // 0) / 1000) >= $since)
          | {paneUUID, pid: ((.pid // "")|tostring)}' 2>/dev/null | head -20
}

cocwd_live() { # <sid> <cwd> <all-json> → 0 if a DISTINCT LIVE session shares this cwd. That live
  # session OWNS the shared working tree (its uncommitted work, not the target's), so reaping the
  # idle target strands nothing — its committed work persists in git, its WIP is checkpointed by
  # cc-teardown (git-plumbing snapshot, zero working-tree impact), and the live owner keeps the tree.
  local sid="$1" cwd="$2" all="$3" cand spid
  while IFS= read -r cand; do
    [ -z "$cand" ] && continue
    spid="$(printf '%s' "$cand" | jq -r '.pid // ""' 2>/dev/null)"
    alive "$spid" && return 0
  done < <(find_successor "$sid" "$cwd" 0 "$all")
  return 1
}

ahead_zero() { # <cwd> → 0 if HEAD is NOT ahead of trunk (this session's commits are landed on trunk)
  local cwd="$1" ahead
  [ -d "$cwd" ] || return 1
  "$GIT_BIN" -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 || return 1
  ahead="$("$GIT_BIN" -C "$cwd" rev-list --count "$TRUNK"..HEAD 2>/dev/null)" || return 1
  [ "${ahead:-1}" = 0 ]
}

is_worktree_session() { # <cwd> → 0 if the cwd is a teammate/worktree path
  case "$1" in /tmp/wt-*|/private/tmp/wt-*|*/.worktrees/*|/tmp/worktree-*) return 0 ;; esac
  return 1
}

live_agent_procs() { # → count of live `--agent-name` (teammate) processes machine-wide
  "$PS_BIN" -eo pid=,command= 2>/dev/null | grep -c -- '--agent-name' || true
}

team_config() { # <sid> → path of a team config.json naming this sid as lead (empty if none)
  local sid="$1" c
  # shellcheck disable=SC2231  # $TEAMS_GLOB is INTENTIONALLY unquoted: it word-splits across the 4
  # account roots AND expands the `.claude*` glob — quoting would defeat both. (Cf. reaper-horizon-lint SC2086.)
  for c in $TEAMS_GLOB/*/config.json; do
    [ -f "$c" ] || continue
    jq -e --arg s "$sid" '((.leadSessionId // .lead_session_id // "")==$s)' "$c" >/dev/null 2>&1 && { printf '%s' "$c"; return 0; }
  done
  return 1
}

team_live_member() { # <team-config> → 0 if any member of this team is a live `--agent-name` process
  local c="$1" names procs m
  names="$(jq -r '(.members // [])[] | (.name // .member // empty)' "$c" 2>/dev/null)"
  [ -n "$names" ] || return 1
  procs="$("$PS_BIN" -eo pid=,command= 2>/dev/null | grep -- '--agent-name' || true)"
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    printf '%s' "$procs" | grep -qF -- "--agent-name $m" && return 0
    printf '%s' "$procs" | grep -qF -- "--agent-name=$m" && return 0
  done <<< "$names"
  return 1
}

team_has_real_members() { # <team-config> → 0 if the team ACTUALLY spawned a teammate (≥1 member that is
  # NOT the in-process `team-lead` placeholder). The implicit-team model (CC 2.1.178+) writes a
  # teams/session-<sid8>/config.json for EVERY session — solo ones too — carrying a single phantom
  # member {name:team-lead, agentType:team-lead, backendType:in-process}: the lead itself, not a
  # teammate. Without this gate every idle solo session matched team_config and fell to coordination-hang.
  local c="$1" n
  n="$(jq -r '[(.members // [])[] | select(((.agentType // "") != "team-lead") and ((.name // "") != "team-lead"))] | length' "$c" 2>/dev/null)"
  [ -n "$n" ] && [ "$n" -gt 0 ]
}

open_wait_contract() { # <sid> <pane> → 0 if an OPEN wait-contract names this session as waiter (a17 S-3)
  # The L2 wait system (bin/cc-wait) writes a durable {waiter,waitee,...,status:"OPEN"} contract on disk
  # BEFORE a block. The classifier never read it, so a conscientious desk that went clean+landed and
  # waited on fired peers read `finished` and was executed. An OPEN contract naming this sid/pane as
  # waiter is POSITIVE wait evidence → never-reap. A CLOSED contract confers nothing (never weakens).
  local sid="$1" pane="$2" c w st
  [ -d "$WAIT_CONTRACTS_DIR" ] || return 1
  for c in "$WAIT_CONTRACTS_DIR"/*.json; do
    [ -f "$c" ] || continue
    st="$(jq -r '.status // ""' "$c" 2>/dev/null)"
    [ "$st" = OPEN ] || continue
    w="$(jq -r '.waiter // ""' "$c" 2>/dev/null)"
    [ -n "$w" ] || continue
    { [ "$w" = "$sid" ] || [ "$w" = "$pane" ]; } && return 0
  done
  return 1
}

is_desk_role() { # <sid> <pane> <name> → 0 if the desk-role file resolves to this session (a17 S-3)
  # cc-roles/<role> holds a single target (uuid|name). If the desk role points at this pane/sid/name,
  # this IS the orchestrator desk — never-reap, unconditionally (a dead desk has no respawner).
  local sid="$1" pane="$2" name="$3" t
  [ -f "$DESK_ROLE_FILE" ] || return 1
  t="$(head -1 "$DESK_ROLE_FILE" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$t" ] || return 1
  [ "$t" = "$pane" ] || [ "$t" = "$sid" ] || [ "$t" = "$name" ]
}

# ── fired-peer stamp + operator-interaction recency (2026-07-24, Danny-Studio-60 / Opus-5) ─────
fired_peer() { # <paneUUID> [startedAt-ms] [cwd] → 0 iff a TENANCY-VALID spawner stamp gates THIS session.
  # Mirrors cc-reaper's fired_peer: the only writer is handoff-fire.sh mark_fired_peer, at fire time.
  # FAIL-SAFE BY CONSTRUCTION — no marker ⇒ operator/role session ⇒ the "done" causes never apply.
  # TENANCY (2026-07-24 rule 2): the stamp is pane-keyed and never expired with tenancy, so a later
  # session reusing a previously-fired pane (a worker closed, the operator reopened it) inherited the
  # stale "self-retiring worker" contract and could be auto-reaped. The stamp gates the CURRENT session
  # only if that session BOOTED within CC_FIRED_BOOT_MAX_S of the fire (a real worker boots ~at fire);
  # a startedAt beyond firedAt+boot-max is a different tenant → stamp does NOT apply. Unknown startedAt
  # (0/absent/unparseable) ⇒ INVALID: fail toward surface, never toward reap.
  #
  # THE SHARED ORACLE (row dcf58e1ba056). The boot window above is NOT the whole tenancy question,
  # and this script used to answer it alone — a second, divergently-keyed copy of what
  # hooks/lib/origin-identity.sh answers with cwd + closedAt. Measured divergence, both directions:
  #   · reused pane id in a DIFFERENT cwd, booted within the window → this said finished-teammate
  #     (REAPABLE); the oracle says `stale`. A live wrong-reap.
  #   · cwd matches but the stamp carries closedAt (a contract already used up by a completed
  #     self-close, inherited by the next tenant of a reused id) → this said REAPABLE; the oracle
  #     says `spent`. The state this script was structurally blind to.
  #   · cwd matches, closedAt null, booted +2h (the peer crashed rather than self-closed and a later
  #     session took the id) → the oracle says `valid`; the boot window refutes it. This is the state
  #     the ORACLE is blind to, and it is why the fix is a CONJUNCT and not a replacement: unifying
  #     onto cwd alone would auto-reap a pane this classifier deliberately surfaces today.
  # So the oracle's verdict is added as a REFUTATION, never as an authorisation: only a positive
  # `stale` or `spent` withdraws the stamp. `unknown` (no jq, no cwd field, a worktree since removed)
  # and `absent` keep the pre-tenancy answer exactly — the lib's own calibrated-to-abstain rule. Every
  # arm of this change NARROWS, so no consumer can begin reaping something it previously spared.
  # CC_SELFCLOSE_TENANCY=0 makes the oracle answer `unknown` for every stamp ⇒ this conjunct is a
  # no-op ⇒ the same kill switch restores the pre-unification behavior here too, by construction.
  local pane="${1:-}" started_ms="${2:-}" here="${3:-}" fep started_s
  [ -n "$pane" ] || return 1
  case "$pane" in *[!0-9A-Fa-f-]*) return 1 ;; esac   # UUID-shaped only — never a path fragment
  [ -f "$FIRED_DIR/$pane.json" ] || return 1
  case "$started_ms" in ''|*[!0-9]*) return 1 ;; esac  # unknown startedAt ⇒ INVALID (surface, not reap)
  [ "$started_ms" -gt 0 ] || return 1
  # Lib unresolvable ⇒ the oracle cannot be asked ⇒ no stamp is provable ⇒ fail CLOSED to the
  # operator-safe cause, the same direction (and the same damped one-line remediation) the
  # cc-interactive primitive's absence takes. A deploy gap must never widen what may be reaped.
  if ! command -v fired_stamp_tenancy >/dev/null 2>&1; then oi_lib_warn; return 1; fi
  case "$(fired_stamp_tenancy "$FIRED_DIR/$pane.json" "$here")" in
    stale|spent) return 1 ;;
  esac
  fep="$(fired_at_epoch "$pane" || true)"
  case "$fep" in ''|*[!0-9]*) return 1 ;; esac         # unparseable firedAt ⇒ INVALID
  started_s=$(( started_ms / 1000 ))
  [ "$started_s" -le $(( fep + FIRED_BOOT_MAX_S )) ]
}

find_fired_successor_stamp() { # <predecessor-sid> <all-json> → 0 iff a TENANCY-VALID cc-fired stamp
  # exists whose firedBy == the predecessor's session_id. change 4 (2026-07-24): handed-off-lead needs
  # a POSITIVE link, not merely "a live session shares my cwd" — a real /handoff fire stamps the
  # SUCCESSOR pane with firedBy=<my sid> (scripts/handoff-fire.sh mark_fired_peer). Absent that stamp
  # the handoff was operator-driven/unstamped, so the predecessor surfaces (finished-operator) rather
  # than auto-reaping. The stamp sits on the successor's OWN paneUUID → scan FIRED_DIR for firedBy match,
  # tenancy-valid per rule 2 (the successor booted ~at fire).
  local sid="$1" all="$2" f pane fb started scwd
  [ -n "$sid" ] || return 1
  [ -d "$FIRED_DIR" ] || return 1
  for f in "$FIRED_DIR"/*.json; do
    [ -f "$f" ] || continue
    fb="$(jq -r '.firedBy // ""' "$f" 2>/dev/null)"
    [ "$fb" = "$sid" ] || continue
    pane="$(basename "$f" .json)"
    started="$(printf '%s' "$all" | jq -r --arg p "$pane" '.[] | select(.paneUUID==$p) | (.startedAt // "")' 2>/dev/null | head -1)"
    # The tenancy oracle is keyed on the SUCCESSOR's own cwd, not the predecessor's — same registry
    # row the startedAt came from, so the two halves of one verdict cannot describe two sessions.
    scwd="$(printf '%s' "$all" | jq -r --arg p "$pane" '.[] | select(.paneUUID==$p) | (.cwd // "")' 2>/dev/null | head -1)"
    fired_peer "$pane" "$started" "$scwd" && return 0
  done
  return 1
}

fired_at_epoch() { # <paneUUID> → epoch of the fire (marker firedAt; fallback: marker file mtime)
  local pane="${1:-}" f iso ep
  f="$FIRED_DIR/$pane.json"; [ -f "$f" ] || return 1
  iso="$(jq -r '.firedAt // ""' "$f" 2>/dev/null)"
  ep="$(iso_to_epoch "$iso")"
  [ -n "$ep" ] || ep="$(stat -f %m "$f" 2>/dev/null)"
  [ -n "$ep" ] || return 1
  printf '%s' "$ep"
}

last_interactive_epoch() { # <jsonl> → epoch of the last REAL operator-typed prompt (empty-fail if none)
  # Thin wrapper over the shared ci_last_interactive_epoch primitive (hooks/lib/cc-interactive.sh —
  # the ONE WHO-drove-the-last-turn signal; semantics mirror context-econ.sh ce_last_interactive_age
  # plus the image-only-paste case + the whole-file fallback beyond the tail window). Returns an EPOCH
  # (not an age) so it is comparable against the seam-pinned $NOW. If the lib failed to source (should
  # never happen — it ships beside this script), fail closed to "no interactive turn" (never-reap wins).
  command -v ci_last_interactive_epoch >/dev/null 2>&1 || return 1
  ci_last_interactive_epoch "${1:-}"
}

work_landed() { # <cwd> → 0 if clean AND the branch's content is on trunk (P0-17 landed-by-CONTENT).
  # a18 L-10: landed was a rev-list COUNT — a squash/cherry-pick land (different sha, same content)
  # left HEAD "N ahead" though the work was durably on trunk, so a finished session DEFERred every 300s
  # forever. The repo's own landing-safety memory ("verify by CONTENT, never by count", incident
  # dfacccd) already names this. Now: clean + (0-ahead fast path OR patch-id-equivalent OR tree-diff-0).
  local cwd="$1"
  [ -d "$cwd" ] || return 1
  "$GIT_BIN" -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 || return 1
  [ -z "$("$GIT_BIN" -C "$cwd" status --porcelain 2>/dev/null)" ] || return 1
  local ahead; ahead="$("$GIT_BIN" -C "$cwd" rev-list --count "$TRUNK"..HEAD 2>/dev/null)" || return 1
  [ "${ahead:-1}" = 0 ] && return 0                              # fast path: 0 ahead by COUNT → landed
  # content path (squash/cherry-pick-tolerant): `git cherry` marks each HEAD commit '-' when a patch-id
  # equivalent is already on trunk, '+' when genuinely unlanded. Zero '+' ⇒ every ahead commit landed.
  local cherry_out
  if cherry_out="$("$GIT_BIN" -C "$cwd" cherry "$TRUNK" HEAD 2>/dev/null)"; then
    printf '%s\n' "$cherry_out" | grep -q '^+' || return 0
  fi
  # multi-commit-squash backstop: HEAD's tree already equals trunk's (net content landed).
  "$GIT_BIN" -C "$cwd" diff --quiet "$TRUNK" HEAD 2>/dev/null && return 0
  return 1
}

# ── the decision tree ─────────────────────────────────────────────────────────────────────────
# sets: CAUSE, IDLE (seconds or -1), LANDED (yes/no/na), SUCCESSOR (uuid|""), DETAIL
classify_entry() { # <entry-json> <all-sessions-json>
  local e="$1" all="$2"
  local sid pid cwd pane name started
  sid="$(printf '%s' "$e"  | jq -r '.session_id // .sessionId // ""')"
  pid="$(printf '%s' "$e"  | jq -r '.pid // ""')"
  cwd="$(printf '%s' "$e"  | jq -r '.cwd // ""')"
  pane="$(printf '%s' "$e" | jq -r '.paneUUID // ""')"
  name="$(printf '%s' "$e" | jq -r '.name // ""')"
  started="$(printf '%s' "$e" | jq -r '.startedAt // ""')"   # epoch-MS; stamp-tenancy input (rule 2)
  CAUSE=""; IDLE=-1; LANDED=na; SUCCESSOR=""; DETAIL=""; SG_MODEL=""; SG_TEXT=""

  # 1. owning process dead → crashed (idle-linger targets are ALIVE; a dead pid is a separate cleanup)
  if ! alive "$pid"; then CAUSE=crashed; DETAIL="pid ${pid:-?} not alive"; return 0; fi

  local tj lat
  tj="$(find_transcript "$sid" 2>/dev/null || true)"
  lat="$(last_assistant_ts "$tj" 2>/dev/null || true)"
  [ -n "$lat" ] && IDLE=$(( NOW - lat ))

  # 2. structured usage-cap in the transcript tail → rate-limited (resumes on reset; never reap)
  if [ -n "$tj" ] && recent_api_limit "$tj"; then CAUSE=rate-limited; DETAIL="structured usage-cap api error"; return 0; fi

  # 2.5 safeguard-blocked: a model CONTENT-safeguard refusal that is the tail's TERMINAL conversational
  #     event. Checked BEFORE `active`/the no-ts fail-safe and the finished-teammate branch: a fired peer
  #     blocked on its FIRST turn leaves an EMPTY thinking block as its last non-error assistant record,
  #     so last_assistant_ts computes an idle and the session otherwise reads finished-teammate → gets
  #     auto-reaped as if it had done its work (it did NOTHING). Idle is anchored to the REFUSAL's OWN
  #     timestamp so it works even with no prior assistant turn. NEVER-REAP (a surface cause); the reaper
  #     notifies the ORIGINATOR (firedBy) and offers opt-in recovery (re-fire on a different model).
  if [ -n "$tj" ]; then
    local _sg _sgts _sgtxt _sgep _sgidle
    if _sg="$(safeguard_blocked "$tj")"; then
      _sgts="${_sg%%$'\t'*}"; _sgtxt="${_sg#*$'\t'}"
      _sgep="$(iso_to_epoch "$_sgts")"
      if [ -n "$_sgep" ]; then _sgidle=$(( NOW - _sgep )); else _sgidle="$IDLE"; fi
      [ "$_sgidle" -ge 0 ] 2>/dev/null || _sgidle=0
      if [ "$_sgidle" -ge "$SAFEGUARD_IDLE_S" ] 2>/dev/null; then
        SG_TEXT="${_sgtxt:0:240}"                                    # bound the surfaced/board text
        SG_MODEL="$(parse_blocked_model "$_sgtxt")"
        IDLE="$_sgidle"
        CAUSE=safeguard-blocked
        DETAIL="model safeguards refused the last turn ${_sgidle}s ago (terminal — no turn since)${SG_MODEL:+ — blocked model: $SG_MODEL}"
        return 0
      fi
    fi
  fi

  # 3. recent assistant turn → active
  if [ "$IDLE" -ge 0 ] 2>/dev/null && [ "$IDLE" -lt "$IDLE_S" ]; then
    CAUSE=active; DETAIL="last assistant turn ${IDLE}s ago (< ${IDLE_S}s)"; return 0
  fi
  # 3.5 task-less (2026-08-08): booted, ALIVE, and it has never produced a single assistant turn —
  #     a pane that started claude but got no brief. Such a pane took the IDLE=-1 fail-safe below, which
  #     answers `active`; `active` is in NEITHER cc-reaper's REAPABLE_RE nor its SURFACE_PAGE_RE, so the
  #     pane persisted forever with no board row and nothing ever asked about it. The generator was
  #     mostly removed by the argv-launch landing (2f074ef14947), but the blind spot outlived it.
  #
  #     THIS IS A SURFACE-ONLY CAUSE AND MUST STAY ONE. Making `active` reapable is the destructive
  #     path — a wrong verdict kills a live session — so the fix does not touch what may be reaped at
  #     all: task-less is added to SURFACE_PAGE_RE and to NEITHER REAPABLE_RE nor AUTOREAP_FIRED_RE.
  #     The change is therefore a strict NARROWING of `active` and a strict WIDENING of what the desk
  #     can see, with the reapable set byte-identical.
  #
  #     Three gates, each closing one way a healthy session could be mislabeled:
  #       (a) the transcript RESOLVED — this is the whole point (turn_census's rc separates "never
  #           spoke" from "could not ask"); an unresolvable or unreadable transcript still falls to
  #           the fail-safe below, unchanged.
  #       (b) ZERO assistant records, positively counted — never inferred from an empty last_assistant_ts,
  #           which is also empty for an unparseable timestamp.
  #       (c) booted >= TASKLESS_BOOT_S ago, from the registry's own startedAt. Measured 2026-08-08:
  #           THIS session read cause=active idle=-1 while genuinely working, seconds into its first
  #           turn — a live falsifier for (a)+(b) alone. Age is what separates "never got a brief" from
  #           "has not answered yet", and startedAt is validated exactly as fired_peer validates it, so
  #           an absent/0/malformed value fails toward the fail-safe rather than toward a label.
  if [ "$IDLE" -lt 0 ] && [ -n "$tj" ]; then
    local _tc _ta _tu _bootage
    if _tc="$(turn_census "$tj")"; then
      _ta="${_tc%% *}"; _tu="${_tc##* }"
      case "$started" in ''|*[!0-9]*) _bootage="" ;; *)
        if [ "$started" -gt 0 ] 2>/dev/null; then _bootage=$(( NOW - started / 1000 )); else _bootage=""; fi ;;
      esac
      if [ "$_ta" = 0 ] && [ -n "$_bootage" ] && [ "$_bootage" -ge "$TASKLESS_BOOT_S" ] 2>/dev/null; then
        IDLE="$_bootage"                       # re-anchor to boot age (mirrors §2.5): -1 on a board row says nothing
        CAUSE=task-less
        if [ "$_tu" = 0 ]; then
          DETAIL="booted ${_bootage}s ago, ZERO assistant turns and no prompt ever arrived — task-less pane (never-reap, surface)"
        else
          DETAIL="booted ${_bootage}s ago, ${_tu} prompt(s) but ZERO assistant turns ever — never started work (never-reap, surface)"
        fi
        return 0
      fi
    fi
  fi
  # If we could not read a transcript ts AT ALL, we cannot prove idleness → treat as active (never-reap).
  if [ "$IDLE" -lt 0 ]; then CAUSE=active; DETAIL="no readable assistant timestamp — cannot prove idle (fail-safe)"; return 0; fi

  # --- pid alive, provably idle (>= IDLE_S), not rate-limited ---
  LANDED=no; work_landed "$cwd" && LANDED=yes

  # 4.0 operator-interaction hold (2026-07-24, Danny-Studio-60 / Opus-5): a REAL operator-typed prompt
  #     marks the pane operator-ADOPTED. Between prompts an interactive conversation is indistinguishable
  #     from "done" by every durable signal below (idle since the last assistant turn + clean + landed —
  #     a Q&A session that writes nothing is ALWAYS clean & 0 ahead), so two live operator conversations
  #     were reaped 12-14 min after the operator's last prompt. The hold reads the one signal "done"
  #     cannot fake: WHO drove the last turn. For a spawner-stamped fired worker the fire-time brief (and
  #     its immediate retries) arrives as a real user prompt — only interaction AFTER firedAt+slack is
  #     adoption, so worker GC is not held by the brief itself.
  #     PLACED BEFORE handed-off-lead (change 3, 2026-07-24): a recent operator prompt is owned-wait even
  #     when a live successor exists — a lead that fired a /handoff but is STILL being typed into is
  #     adopted, not spent. The fired-self-handoff case the old ordering protected (the successor carries
  #     the conversation, so the predecessor should reap) is preserved by the firedAt EXCLUSION below, not
  #     by ordering: a stamped worker's fire-brief prompts (< firedAt+slack) don't count as adoption, so a
  #     self-recycled predecessor still reaps; only a genuine post-fire operator prompt holds it.
  #     THIRD STATE (2026-07-29, C-SC-1): ci_last_interactive_epoch now returns rc 2 / "unreadable" for
  #     "could not read the answer" (vs rc 1 "parsed, nobody typed"). This gate needs NO rc-2 branch of
  #     its own, and the reason is structural, not incidental: every world that makes the WHO-scan
  #     unreadable (transcript unresolvable, unreadable perms, no jq, not one well-formed record) ALSO
  #     denies this function a last-assistant timestamp, so IDLE stays -1 and the fail-safe ~20 lines
  #     above has already returned CAUSE=active (never-reap). A rc-2 answer is therefore unreachable
  #     here. DO NOT weaken that IDLE<0 fail-safe without adding an explicit unreadable ⇒ hold branch
  #     right here — it is the only thing standing between this ladder and a reap on unreadable input.
  #     (The actuators that CAN reach rc 2 — cc-teardown's belt, teammate-auto-shutdown's TeammateIdle
  #     close — read it explicitly and HOLD.)
  #
  #     LIB-ABSENT IS THE ONE WORLD THAT REASONING MISSES (G1, measured 2026-07-29). The paragraph
  #     above holds for every world where the TRANSCRIPT is unreadable — but an unresolvable
  #     hooks/lib/cc-interactive.sh is not one of them: the transcript is perfectly readable, so IDLE
  #     is computed normally and the IDLE<0 fail-safe never fires. last_interactive_epoch() then
  #     returns 1 ("no interactive turn") for a MISSING PRIMITIVE exactly as it does for "nobody
  #     typed", the hold below is skipped, and the ladder falls through to `finished` = REAPABLE.
  #     Measured on the incident fixture (stamped 50000s, landed, idle 900s, real operator prompt
  #     950s ago): lib present ⇒ owned-wait; lib unresolvable ⇒ finished. That is a live operator
  #     conversation auto-reaped by a deploy gap, and the gap is routine — all three resolve
  #     candidates collapse onto $CLAUDE_CONFIG_DIR/hooks/lib/ when deployed, which is a dir of
  #     per-file symlinks that a bare ff-sync never extends to a NEW tracked lib (the same class that
  #     left hooks/lib/idl-log.sh live-missing; see scripts/deploy-parity-assert.sh).
  #     So: absence of the primitive is adoption-UNKNOWN, never adoption-absent. Fail closed to
  #     owned-wait. Keyed on `command -v` — the same predicate last_interactive_epoch() itself uses —
  #     so it cannot drift from the thing it guards, and it NARROWS: with the lib resolvable this
  #     branch is unreachable and every path below is byte-for-byte unchanged.
  if [ "$INTERACTIVE_HOLD_DISABLE" != 1 ] && ! command -v ci_last_interactive_epoch >/dev/null 2>&1; then
    ci_lib_warn
    CAUSE=owned-wait
    DETAIL="interactive lib unresolvable — cannot prove no operator adoption (adoption-unknown, fail-closed)"
    return 0
  fi
  local iep
  if [ "$INTERACTIVE_HOLD_DISABLE" != 1 ] && [ -n "$tj" ] && iep="$(last_interactive_epoch "$tj")"; then
    local iage=$(( NOW - iep )); [ "$iage" -lt 0 ] && iage=0
    if [ "$iage" -lt "$INTERACTIVE_HOLD_S" ]; then
      local fep=""
      if fired_peer "$pane" "$started" "$cwd"; then fep="$(fired_at_epoch "$pane" || true)"; fi
      if [ -z "$fep" ] || [ "$iep" -gt $(( fep + FIRE_PROMPT_SLACK_S )) ]; then
        CAUSE=owned-wait; DETAIL="operator prompt ${iage}s ago (< hold ${INTERACTIVE_HOLD_S}s) — operator-adopted pane (never-reap)"; return 0
      fi
    fi
  fi

  # 4. handed-off-lead: fired a /handoff, a LIVE successor session exists in the same cwd, AND a cc-fired
  #    stamp positively LINKS them (change 4, 2026-07-24). The old test — "a distinct live session shares
  #    my cwd" — mislabeled any operator who happened to open a second pane in the same checkout as a
  #    handoff successor and auto-reaped the first. A real /handoff fire stamps the SUCCESSOR pane with
  #    firedBy=<my sid> (handoff-fire.sh mark_fired_peer); requiring that stamp (tenancy-valid) makes the
  #    link positive. No stamped successor ⇒ handed-off-lead NOT assigned — an operator-driven unstamped
  #    handoff then falls through to finished-operator (surface for confirm-close), never auto-reaping.
  if [ -n "$tj" ] && handoff_fired "$tj"; then
    local cand spid found=""
    while IFS= read -r cand; do
      [ -z "$cand" ] && continue
      spid="$(printf '%s' "$cand" | jq -r '.pid // ""' 2>/dev/null)"
      if alive "$spid"; then found="$(printf '%s' "$cand" | jq -r '.paneUUID // ""' 2>/dev/null)"; break; fi
    done < <(find_successor "$sid" "$cwd" "${lat:-0}" "$all")
    if [ -n "$found" ] && find_fired_successor_stamp "$sid" "$all"; then
      SUCCESSOR="$found"
      CAUSE=handed-off-lead; DETAIL="fired /handoff; LIVE firedBy-stamped successor $found in cwd; work-landed=$LANDED"; return 0
    fi
    DETAIL="fired /handoff but no stamped+live successor — surface, not auto-reap"
  fi

  # 4.5 in-flight tool → active (a18 L-13). A single long tool call (12-min build/test) leaves the
  #     transcript's LAST record an assistant tool_use timestamped at call START; IDLE crosses 300s
  #     mid-call and the session otherwise reads `finished`/`finished-teammate`. A running tool ⇒ NOT
  #     idle ⇒ never-reap. Checked BEFORE the finished/finished-teammate branches (and after
  #     handed-off-lead, whose own last record is the handoff tool_use with its tool_result already landed).
  if [ -n "$tj" ] && tool_in_flight "$tj"; then
    CAUSE=active; DETAIL="in-flight tool call (unmatched trailing tool_use) — running, not idle (never-reap)"; return 0
  fi

  # 4.6 wait-contract / desk-role → owned-wait (never-reap). a17 S-3: the classifier's only wait evidence
  #     was team-config members; it never read the L2 wait system, so a desk that went clean+landed and
  #     waited >10 min on fired peers read `finished` and the launchd reaper EXECUTED it. Read BOTH now,
  #     BEFORE any reapable idle cause: an OPEN wait-contract naming this session as waiter, or the desk
  #     role resolving to it, is positive wait evidence — never-reap (a dead desk has no respawner).
  if open_wait_contract "$sid" "$pane"; then
    CAUSE=owned-wait; DETAIL="idle ${IDLE}s, an OPEN wait-contract names this session as waiter — owned wait (never-reap)"; return 0
  fi
  if is_desk_role "$sid" "$pane" "$name"; then
    CAUSE=owned-wait; DETAIL="idle ${IDLE}s, the desk-role file resolves to this session — desk-role (never-reap)"; return 0
  fi

  # 5. finished-teammate: a SPAWNER-STAMPED fired worker in a worktree, idle. The cwd path alone is
  #    NOT teammate evidence (2026-07-24: an operator conversing inside a wt-pool worktree was reaped
  #    as finished-teammate 14 min after their prompt) — the stamp is the spawner's own "self-retiring
  #    worker" contract (tenancy-valid); an unstamped worktree session falls through to the operator-safe
  #    branches.
  if is_worktree_session "$cwd" && fired_peer "$pane" "$started" "$cwd"; then
    CAUSE=finished-teammate; DETAIL="spawner-stamped fired worker in a worktree, idle ${IDLE}s; work-landed=$LANDED"; return 0
  fi

  # 6. REAL team coordination — ONLY when the team actually spawned a teammate (a member beyond the
  #    in-process `team-lead` placeholder; see team_has_real_members). A live member ⇒ owned-wait
  #    (healthy wave); had real members but none alive now ⇒ coordination-hang (stuck, surface).
  #    Both NEVER-reap; the split only decides whether the reaper SURFACES for re-engagement. Without
  #    the real-members gate the implicit-team config (every session has one) collapsed ALL idle solo
  #    sessions to coordination-hang — the "defaulting, not discriminating" bug this fix closes.
  local tc; tc="$(team_config "$sid" 2>/dev/null || true)"
  if [ -n "$tc" ] && team_has_real_members "$tc"; then
    if team_live_member "$tc"; then
      CAUSE=owned-wait; DETAIL="idle ${IDLE}s, lead of a team with ≥1 live member — healthy wait"; return 0
    fi
    # Gap A (2026-07-17): a coordination-hang whose partner is DEAD, idle past the dead-reap horizon,
    # WHILE a live co-cwd session owns the shared tree, is an abandoned zombie — reapable. Committed
    # work persists in git; WIP is checkpointed by cc-teardown; the live owner keeps the working tree.
    # The 13h doc_classifier wave-2 lead was exactly this (dead fix-w6 partner + live endgame lead in
    # the same cwd). LIVE coordination (team_live_member above) never reaches here.
    if [ "$IDLE" -ge "$COORD_HANG_DEAD_REAP_S" ] && cocwd_live "$sid" "$cwd" "$all"; then
      CAUSE=coordination-abandoned; DETAIL="idle ${IDLE}s (> ${COORD_HANG_DEAD_REAP_S}s horizon), team partner dead, a LIVE co-cwd session owns the tree — abandoned zombie, reapable"; return 0
    fi
    CAUSE=coordination-hang; DETAIL="idle ${IDLE}s, lead of a team but NO live member — stuck (surface, never reap)"; return 0
  fi

  # 7. finished: idle past threshold, no live teammates, and work is LANDED (clean tree AND nothing
  #    ahead of trunk). POSITIVE, durable done-evidence (committed + on trunk), never inferred from
  #    silence. Reapable ONLY for a spawner-stamped fired worker — an unstamped pane is the
  #    OPERATOR's (or predates the marker): it is surfaced as finished-operator for confirm-close,
  #    never auto-reaped (2026-07-24; "clean & landed & idle" is every interactive Q&A session's
  #    steady state, not proof the operator is done with the pane).
  if [ "$LANDED" = yes ]; then
    if fired_peer "$pane" "$started" "$cwd"; then
      CAUSE=finished; DETAIL="idle ${IDLE}s, no live teammates, work landed (clean & 0 ahead of $TRUNK), spawner-stamped worker — done, reapable"; return 0
    fi
    CAUSE=finished-operator; DETAIL="idle ${IDLE}s, work landed, but operator-launched (no tenancy-valid fired-peer stamp) — surface for confirm-close, never auto-reap"; return 0
  fi

  # Gap B (2026-07-17): a solo idle session whose OWN commits are landed (0 ahead of trunk) but whose
  # cwd tree is dirty, WITH a live co-cwd session that owns that dirt, is very likely finished — the
  # dirt is the sibling's, not ours (session-4 the reaper-session: landed to main, yet the shared
  # checkout carried an unrelated `M validate-bash.sh`). SURFACE it (a dirty tree could still hold our
  # OWN WIP, so NOT auto-reaped — the desk/operator confirm-closes) so it never lingers silently.
  if [ "$LANDED" = no ] && ahead_zero "$cwd" && cocwd_live "$sid" "$cwd" "$all"; then
    CAUSE=finished-shared-review; DETAIL="idle ${IDLE}s, own commits landed (0 ahead of $TRUNK), tree dirty but a LIVE co-cwd sibling owns it — likely finished, surface for confirm-close (not auto-reaped)"
    return 0
  fi

  # 8. default: idle + alive but work NOT landed (or a solo/implicit team). NEVER reap — the operator
  #    may return, and an unlanded tree must never be stranded. owned-wait is the never-reap bucket.
  CAUSE=owned-wait; DETAIL="idle ${IDLE}s, pid alive, work not landed / no real team — waiting (never-reap default)"
  return 0
}

emit_one() { # <entry-json> <all-json> <json?>
  classify_entry "$1" "$2"
  if [ "${3:-}" = "--json" ]; then
    # emit pid + classify-time lstart so cc-reaper can pin session identity across classify→act (a17 S-4).
    local _pid _lstart
    _pid="$(printf '%s' "$1" | jq -r '.pid // ""')"
    _lstart="$(pid_lstart "$_pid")"
    jq -nc --argjson e "$1" --arg cause "$CAUSE" --arg idle "$IDLE" --arg landed "$LANDED" \
       --arg succ "$SUCCESSOR" --arg detail "$DETAIL" --arg lstart "$_lstart" \
       --arg sgmodel "$SG_MODEL" --arg sgtext "$SG_TEXT" \
       '{name:$e.name, paneUUID:$e.paneUUID, account:$e.account, cwd:$e.cwd,
         pid:($e.pid // null), startedAt:($e.startedAt // null),
         session_id:($e.session_id // $e.sessionId // null),
         cause:$cause, idle_s:($idle|tonumber? // -1), work_landed:$landed,
         lstart:(if $lstart=="" then null else $lstart end),
         blocked_model:(if $sgmodel=="" then null else $sgmodel end),
         refusal:(if $sgtext=="" then null else $sgtext end),
         successor:(if $succ=="" then null else $succ end), detail:$detail}'
  else
    printf '%-18s %-17s %-8s idle=%-7s landed=%-3s %s\n' \
      "$(printf '%s' "$1" | jq -r '.name // .paneUUID')" "$CAUSE" \
      "$(printf '%s' "$1" | jq -r '.account // "?"')" "$IDLE" "$LANDED" "$DETAIL"
  fi
}

cmd_classify() { # <target> [--json]
  local target="$1" json="${2:-}"
  local all; all="$("$SESSIONS_BIN" --json 2>/dev/null || echo '[]')"
  local e
  e="$(printf '%s' "$all" | jq -c --arg t "$target" '.[] | select(.paneUUID==$t or .session_id==$t or .sessionId==$t or .name==$t)' 2>/dev/null | head -1)"
  [ -n "$e" ] || die "no live session matches '$target'"
  emit_one "$e" "$all" "$json"
}

cmd_all() { # [--json]
  local json="${1:-}"
  local all; all="$("$SESSIONS_BIN" --json 2>/dev/null || echo '[]')"
  local n; n="$(printf '%s' "$all" | jq 'length' 2>/dev/null || echo 0)"
  [ "$json" = "--json" ] && printf '['
  local first=1 i
  for ((i=0; i<n; i++)); do
    local e; e="$(printf '%s' "$all" | jq -c ".[$i]")"
    if [ "$json" = "--json" ]; then
      [ $first = 1 ] || printf ','; first=0
      emit_one "$e" "$all" --json
    else
      emit_one "$e" "$all"
    fi
  done
  [ "$json" = "--json" ] && printf ']\n'
  return 0
}

case "${1:-}" in
  --all)        cmd_all "${2:-}" ;;
  selftest)     exec bats "$(cd "$(dirname "$0")" && pwd)/../tests/cc-classify.bats" ;;
  -h|--help|"") sed -n '2,20p' "$0"; exit 0 ;;
  *)            cmd_classify "$1" "${2:-}" ;;
esac
