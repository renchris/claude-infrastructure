#!/usr/bin/env python3
"""cc-where — which physical screen is that Claude Code session on, and how do I reach it?

THE DEFECT THIS CLOSES (measured 2026-08-07, operator incident)
    A live session became unfindable without ever being destroyed. Two of them, in fact:
    `Investigate hidden panes in Kitty Terminal` and `Investigate lakehouse-lecture session
    crash and prevent data loss`. Both were idle, healthy, and rendering zero pixels.

    kitty draws exactly ONE tab per OS window. At the time of the incident 9 of 21 session
    panes sat in non-active tabs. That alone would be survivable — you would switch tabs and
    find them — except kitty's default `tab_title_template` labels a tab with its ACTIVE
    pane's title ONLY. So tab 4 advertised "Fix shared repo checkpoint overflow in
    teammate-checkpoint.sh" while silently holding three other sessions. Nothing anywhere on
    screen said the session the operator was hunting for existed. It was invisible AND
    unnamed, which is indistinguishable from deleted.

    Spread that over four OS windows on four physical displays and eyeballing is hopeless.
    That is the gap: there was no way to ask "where is it" — only to look.

WHY THIS IS A SEPARATE BINARY AND NOT A VERB ON AN EXISTING ONE
    `cc-sessions` lists REGISTRY rows (name/uuid/account/age/cwd) — it knows a session exists,
    not where it is drawn. `cc-pane` is the it2-era spawn/address/send/close driver. Neither
    models "is this on screen right now". `kitty-pane-menu` is the closest relative and its
    `window_screen_positions()` is the prior art reused below, but its job is choosing a MOVE
    TARGET, not finding a lost session. Nothing answers the operator's actual question, so
    this does — and it is deliberately NOT called `cc-panes`, one letter off `cc-pane`.

DESIGN RULE — a lookup miss is not absence
    `--go` refuses on 0 matches and refuses on >1, naming the candidates. It never picks one.
    Focusing "some" pane is precisely how you lose the other one, which is the bug.
    And it verifies BY CONTENT afterwards: `kitty @ focus-window` exits 0 on a window it
    matched but could not actually raise, so the exit code alone proves nothing.
"""
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys

# Below this a Claude Code TUI is present but not usable — the composer truncates and the
# readout tables wrap into noise. Measured against the real client, not guessed: the incident
# tab had panes at 24 and 36 columns and the operator could not read any of them.
READABLE_COLS = 80

# Explicit truecolor, never SGR-2 dim: this output is data the operator is hunting through.
C = {
    "reset": "\033[0m",
    "bold": "\033[1m",
    "on": "\033[38;2;107;243;133m",      # green  — on screen and readable
    "off": "\033[38;2;255;107;107m",     # red    — off screen entirely
    "narrow": "\033[38;2;255;217;89m",   # yellow — on screen but squeezed
    "head": "\033[38;2;138;180;248m",
    "meta": "\033[38;2;150;150;160m",
}


def _kitty() -> str:
    for name in ("kitty", "kitten"):
        p = shutil.which(name)
        if p:
            return p
    sys.exit("cc-where: kitty not on PATH")


def ls_tree() -> list:
    # CC_WHERE_KITTY_LS — hermetic seam for the bats suite, same shape as cc-url-open's
    # CC_URL_OPEN_KITTY_LS. Never set in production; a census that shelled out to the live
    # kitty could not be tested against a fixture tree at all.
    fixture = os.environ.get("CC_WHERE_KITTY_LS")
    if fixture:
        with open(fixture, encoding="utf-8") as fh:
            return json.load(fh)
    r = subprocess.run([_kitty(), "@", "ls"], capture_output=True, text=True, timeout=15)
    if r.returncode != 0:
        sys.exit(f"cc-where: kitty @ ls failed ({r.returncode}): {r.stderr.strip()}")
    return json.loads(r.stdout)


def _cloud_bin() -> str | None:
    """`cc-cloud`, the ONLY source of off-box rows (CLOUD_OBSERVABILITY.md §9.3).

    CC_WHERE_CLOUD_BIN is the test seam. Sibling-first otherwise, same order cc-sessions uses:
    the tool beside this one is the deterministic pick, and ~/.claude/bin is the live layer.
    """
    override = os.environ.get("CC_WHERE_CLOUD_BIN")
    if override:
        return override if os.access(override, os.X_OK) else None
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in (os.path.join(here, "cc-cloud"), os.path.expanduser("~/.claude/bin/cc-cloud")):
        if os.access(cand, os.X_OK):
            return cand
    return shutil.which("cc-cloud")


def cloud_sessions() -> list[dict]:
    """Declared, non-retired off-box sessions — NEVER a pane row.

    An off-box session has no kitty window, no pid and no local anything, so it cannot be
    synthesised into the census list: `panes()` rows carry `win`/`oswin`/`on_screen`, and a fake
    one would be focusable, killable and countable as a pane. It gets its own block instead.

    `--state` asks cc-cloud's own state function; cc-where does not re-derive it. A probe that
    could not answer degrades to the probe-free inventory, whose rows then render the literal
    UNKNOWN — never to an empty list, because that would put this tool back in the class of local
    oracles that report a healthy off-box session as absent.
    """
    cc = _cloud_bin()
    if not cc:
        return []
    out = ""
    for argv in ([cc, "list", "--json", "--state"], [cc, "list", "--json"]):
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode == 0:
            out = r.stdout
            break
    rows = []
    for line in out.splitlines():          # NDJSON: one object per LINE, never an array
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(d, dict) or d.get("retired") is True:
            continue
        rows.append(
            {
                "kind": "offbox",
                "id": d.get("id") or "",
                "branch": d.get("branch") or "",
                "item": d.get("item") or "",
                "state": d.get("state") or "UNKNOWN",   # U0 renders as the WORD, never as a gap
                "url": d.get("url") or "https://claude.ai/code",
            }
        )
    return rows


def cloud_match(rows: list[dict], pat: "re.Pattern[str]") -> list[dict]:
    return [r for r in rows if pat.search(r["id"]) or pat.search(r["branch"]) or pat.search(r["item"])]


def cloud_block(rows: list[dict]) -> None:
    """§9.3's row, verbatim in shape: kind · addr · state · action. No pid, no kill."""
    if not rows:
        return
    print(f"{C['head']}▸ OFF-BOX — no screen anywhere; these run in an Anthropic VM{C['reset']}")
    for r in rows:
        print(
            f"     {C['off']}offbox{C['reset']} "
            f"kind=offbox  addr={r['id']}  state={r['state']}  action=open {r['url']}"
        )
    print()


def overlay_map(tab: dict, windows: list | None = None) -> tuple[dict[int, int], dict[int, int]]:
    """(covered_by, overlay_of) for one tab, from kitty's window GROUPS.

    A kitty window group is a base window plus the overlay windows stacked on it:
    `{"id": 570, "windows": [472, 471]}` means one of those two is drawn over the other and
    the covered one renders zero pixels. Overlays are how kitty runs its kittens —
    `open_url_with_hints` (⌘E, kitty.conf §6), `unicode_input`, `kitten ask` — so any of them
    can bury a live session.

    🚨 THE ORDER OF `windows` IS NOT THE STACKING ORDER, AND IS NOT EVEN STABLE. The obvious
    reading — first element is the topmost overlay — was taken from one measured overlay and
    is WRONG. Re-measured on kitty 0.48.2 with three identical launches (os-window base, then
    an overlay launch on it — kitty @ launch with `--type=overlay --keep-focus`):
        run1 [480, 481]   run2 [483, 482]   run3 [485, 484]      base = 480 / 482 / 484
    Same script, and the base landed first once and last twice. A positional reading is a coin
    flip that names the WRONG pane as the one to press ESC in — worse than saying nothing,
    because the operator acts on it. Caught only because an end-to-end run against a real
    overlay disagreed with the fixture the positional version was built from.

    THE DISCRIMINATOR IS `created_at`: within a group the base is the OLDEST window. That is
    true by construction rather than by convention — an overlay is mounted on a window that
    already exists, so it can never predate it. Verified 3/3 on the runs above, and it also
    re-derives the incident correctly (base 390 created 05:33:21, kitten 467 at 13:51:50).

    Fails OPEN — returns no coverage — when a group member has no `created_at`. Reporting
    nothing degrades to the pre-overlay census; guessing would re-introduce the inversion.

    THE INCIDENT THIS CLOSES (2026-08-07). A ⌘E mis-hit mounted a "Choose URL" hints kitten
    on a working session's pane. The kitten re-renders the pane's text PLAIN — no colour —
    and takes the keyboard, so the pane read as all-white and swallowed every keystroke: an
    exact visual match for a hung client. The session was never hung; its main thread was
    parked in kevent64 the whole time and it answered `kitty @ send-text` instantly, because
    the API addresses the base window directly and bypasses the overlay. Diagnosing it took a
    sample(1) and a hand-read of the `ls` tree. This census is where that answer belongs.

    Returns ({}, {}) when `groups` is absent — kitty < 0.42, or a fixture without it — so an
    older kitty degrades to the pre-overlay census rather than losing the whole tab.
    """
    born = {
        w["id"]: w.get("created_at")
        for w in (windows if windows is not None else tab.get("windows") or [])
    }
    covered: dict[int, int] = {}
    overlay_of: dict[int, int] = {}
    for g in tab.get("groups") or []:
        stack = [wid for wid in (g.get("windows") or []) if wid in born]
        if len(stack) < 2:
            continue
        if any(born[wid] is None for wid in stack):
            continue                                   # fail open, never guess
        ordered = sorted(stack, key=lambda wid: born[wid])
        base, top = ordered[0], ordered[-1]
        for wid in ordered[:-1]:                       # base + any middle overlays
            covered[wid] = top
        overlay_of[top] = base
    return covered, overlay_of


def screen_positions() -> dict[str, tuple[float, float, float, float]]:
    """macOS window title -> (x, y, w, h) for every kitty OS window, via System Events (JXA).

    DUPLICATED, DELIBERATELY, from kitty-pane-menu.window_screen_positions(). That file is
    owned by the move-menu work and is edited from other sessions; importing a sibling CLI
    script would couple this tool to its module-level `__file__` setup and break silently when
    it changes. Twenty-five lines of JXA is the cheaper coupling. Size is added here because
    it is what distinguishes the 1728x974 built-in display from a 2560x1440 external.

    Returns {} on ANY failure — most commonly the Accessibility permission not being granted
    (kitty-setup.sh step 6, GUI-only). Degrades to no location labels, never blocks the census.
    """
    script = (
        'var se = Application("System Events");\n'
        'var wins = se.processes["kitty"].windows();\n'
        'var out = [];\n'
        'for (var i = 0; i < wins.length; i++) {\n'
        '  try {\n'
        '    var w = wins[i]; var p = w.position(); var s = w.size();\n'
        '    out.push(w.name() + "\\t" + p[0] + "\\t" + p[1] + "\\t" + s[0] + "\\t" + s[1]);\n'
        '  } catch (e) {}\n'
        '}\n'
        'out.join("\\n");\n'
    )
    try:
        r = subprocess.run(
            ["osascript", "-l", "JavaScript", "-e", script],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if r.returncode != 0:
        return {}
    out: dict[str, tuple[float, float, float, float]] = {}
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 5:
            continue
        try:
            out[parts[0]] = (float(parts[1]), float(parts[2]), float(parts[3]), float(parts[4]))
        except ValueError:
            continue
    return out


def _ordinal(n: int) -> str:
    return {1: "1st", 2: "2nd", 3: "3rd"}.get(n, f"{n}th")


def location_labels(tree: list) -> dict[int, str]:
    """kitty os-window id -> "2nd from left · 2560x1440". Same ordinal vocabulary as
    kitty-pane-menu's move targets, on purpose: the operator should learn ONE way of naming a
    physical window, not two that disagree.

    Keying is by macOS window title, which kitty sets from the ACTIVE pane of the ACTIVE tab.
    Two OS windows can therefore carry the same title (two panes both titled "Claude Code" is
    routine here). An ambiguous title labels NEITHER window rather than mislabelling one —
    a wrong location sends the operator to the wrong display, which is worse than no label.
    """
    positions = screen_positions()
    if not positions:
        return {}

    expected: dict[int, str] = {}
    for osw in tree:
        tabs = osw.get("tabs", [])
        tab = next((t for t in tabs if t.get("is_active")), tabs[0] if tabs else None)
        if not tab or not tab.get("windows"):
            continue
        wins = tab["windows"]
        # is_active = active WITHIN its tab, which is what kitty puts in the macOS window
        # title. is_focused is global and true for at most one window on the whole desktop, so
        # keying on it left every unfocused OS window unlabelled — and because the ordinals
        # were then computed over the surviving subset, the labels that DID render were wrong
        # ("3rd from left" for a window that is 4th of 4).
        w = next((x for x in wins if x.get("is_active")), None) \
            or next((x for x in wins if x.get("is_focused")), wins[0])
        expected[osw["id"]] = w.get("title") or ""

    seen: dict[str, int] = {}
    for title in expected.values():
        seen[title] = seen.get(title, 0) + 1

    pts = [
        (oid, positions[t])
        for oid, t in expected.items()
        if t in positions and seen[t] == 1
    ]
    if len(pts) < 2:
        return {}

    xs = [p[1][0] for p in pts]
    ys = [p[1][1] for p in pts]
    horizontal = (max(xs) - min(xs)) >= (max(ys) - min(ys))
    axis, word = (0, "left") if horizontal else (1, "top")
    ordered = sorted(pts, key=lambda p: p[1][axis])
    return {
        oid: f"{_ordinal(i + 1)} from {word} · {int(pt[2])}x{int(pt[3])}"
        for i, (oid, pt) in enumerate(ordered)
    }


def panes(tree: list) -> list[dict]:
    """Flatten the tree, deciding for each pane whether it is actually DRAWN.

    THREE independent ways a live pane renders zero pixels, and a census that models only the
    first is exactly as useless as no census — it reports the lost session as visible:

      1. TAB OCCLUSION — its tab is not the active tab of its OS window.
      2. STACK LAYOUT — its tab IS active, but the tab is in `stack`, which draws only the
         tab's active window and hides the rest full-size behind it. This is the mechanism
         behind the 2026-08-07 incident: kitty.conf binds cmd+shift+enter to
         `toggle_layout stack`, which is ALSO the chord the operator presses for a newline in
         the Claude Code composer. One mis-keystroke zooms one pane and every other session in
         that tab disappears. kitty reports every stacked pane at FULL width, so width alone
         cannot distinguish "wide and visible" from "wide and buried".
      3. OVERLAY COVERAGE — a kitten (hints/⌘E, unicode_input, ask) is mounted on the pane,
         drawn over it full-size and holding the keyboard. See overlay_map(). This one is
         WORSE than 1 and 2 for the operator, because the other two leave the pane plainly
         missing, whereas an overlay leaves something pane-shaped on screen that does not
         respond — which reads as a crashed client, not as a UI mode.

    An overlay window is not a session, so it does not inflate the tab's pane count: the
    truthful count is the number of GROUPS, and only the count is derived that way (rows are
    still emitted per window, with the overlay flagged, so `--json` can still see it).
    """
    rows = []
    for osw in tree:
        for tab in osw["tabs"]:
            tab_visible = bool(tab.get("is_active"))
            stacked = tab.get("layout") == "stack"
            covered, overlay_of = overlay_map(tab, tab["windows"])
            titles = {w["id"]: w.get("title", "") for w in tab["windows"]}
            n_panes = len(tab["groups"]) if tab.get("groups") else len(tab["windows"])
            for w in tab["windows"]:
                top_of_stack = bool(w.get("is_active"))
                covered_by = covered.get(w["id"])
                drawn = tab_visible and (top_of_stack if stacked else True) and not covered_by
                if not tab_visible:
                    hidden_by = "tab"
                elif stacked and not top_of_stack:
                    hidden_by = "stack"
                elif covered_by:
                    hidden_by = "overlay"
                else:
                    hidden_by = ""
                rows.append(
                    {
                        "oswin": osw["id"],
                        "tab": tab["id"],
                        "tab_panes": n_panes,
                        # An overlay is a kitten mounted on `covers`, not a session of its
                        # own; `covered_by` is the reverse edge, naming what buried this pane.
                        "is_overlay": w["id"] in overlay_of,
                        "covers": overlay_of.get(w["id"]),
                        "covered_by": covered_by,
                        "covered_by_title": titles.get(covered_by, "") if covered_by else "",
                        "tab_layout": tab.get("layout", ""),
                        "win": w["id"],
                        "pid": w.get("pid"),
                        "title": w.get("title", ""),
                        "cwd": w.get("cwd", ""),
                        "cols": w.get("columns", 0),
                        "on_screen": drawn,
                        "hidden_by": hidden_by,
                        # tab_active = "this is the pane the tab shows, or would show the
                        # moment you switch to it". THE marker to render.
                        #
                        # NOT is_focused. is_focused is only meaningful while kitty is the
                        # frontmost application, and this tool runs from a Bash call inside a
                        # Claude Code pane, which frequently is not that moment. Measured on
                        # one live tree: 2 of 24 panes reported is_focused — impossible as a
                        # global truth, since at most one window on the desktop is focused —
                        # while is_active came back at exactly one per tab, 5 across 5 tabs.
                        # (bin/cc-url-open:117-122 records the same conclusion for link
                        # provenance: is_active is the durable field, kitty keeps marking the
                        # last-active OS window, tab and pane while unfocused.)
                        # is_focused is kept in --json for callers that want it; nothing in
                        # the human output depends on it.
                        "tab_active": top_of_stack,
                        "focused": bool(w.get("is_focused")),
                    }
                )
    return rows


def _state(r: dict) -> tuple[str, str]:
    if not r["on_screen"]:
        return C["off"], "off"
    if r["cols"] < READABLE_COLS:
        return C["narrow"], "narrow"
    return C["on"], "on"


def render(
    rows: list[dict],
    tree: list,
    subset: list[dict] | None = None,
    cloud: list[dict] | None = None,
) -> int:
    labels = location_labels(tree)
    shown = subset if subset is not None else rows
    cloud = cloud or []

    sessions = [r for r in rows if not r["is_overlay"]]
    n_off = sum(1 for r in sessions if not r["on_screen"])
    n_narrow = sum(1 for r in sessions if r["on_screen"] and r["cols"] < READABLE_COLS)
    n_cov = sum(1 for r in sessions if r["covered_by"])
    print(
        f"{C['bold']}{len(sessions)} panes{C['reset']} · "
        f"{C['off']}{n_off} off-screen{C['reset']} · "
        f"{C['narrow']}{n_narrow} squeezed under {READABLE_COLS} cols{C['reset']}"
    )
    # Answer-first: a covered pane is the one state that LOOKS like a crashed client, so it
    # gets its own line above the tree rather than waiting to be found inside it.
    if n_cov:
        print(
            f"{C['off']}{C['bold']}{n_cov} pane(s) BURIED UNDER A KITTEN OVERLAY{C['reset']} — "
            f"live, but the overlay holds the keyboard. Click the pane and press ESC."
        )
    print()

    if not shown:
        # An off-box match is an ANSWER, not a miss: reporting "no pane matches" over a live cloud
        # session is the same conversion of "not on this box" into "gone" that §5.2 catalogues.
        if cloud:
            cloud_block(cloud)
            return 0
        print("no pane matches.")
        return 1

    groups: dict[tuple[int, int], list[dict]] = {}
    for r in shown:
        groups.setdefault((r["oswin"], r["tab"]), []).append(r)

    last_osw = None
    for (osw, tab), group in sorted(groups.items()):
        if osw != last_osw:
            ntabs = sum(len(o["tabs"]) for o in tree if o["id"] == osw)
            where = labels.get(osw, "position unknown")
            print(f"{C['head']}▸ {where}{C['reset']}  {C['meta']}kitty window {osw} · {ntabs} tabs{C['reset']}")
            last_osw = osw
        g0 = group[0]
        tab_drawn = any(r["on_screen"] for r in group) or g0["hidden_by"] != "tab"
        mark = f"{C['on']}ON SCREEN {C['reset']}" if tab_drawn else f"{C['off']}OFF SCREEN{C['reset']}"
        zoom = ""
        if g0["tab_layout"] == "stack" and g0["tab_panes"] > 1:
            zoom = f"  {C['off']}ZOOMED — {g0['tab_panes'] - 1} pane(s) buried underneath{C['reset']}"
        print(f"   tab {tab:<4} {mark} {C['meta']}{g0['tab_panes']} panes{C['reset']}{zoom}")
        for r in group:
            col, _ = _state(r)
            star = "▸" if r["tab_active"] else " "
            if r["is_overlay"]:
                # Render the kitten as what it is — a lid on another pane, not a peer session.
                # Listing it flat as "Choose URL" beside the sessions is what let it read as
                # just another pane during the incident.
                print(
                    f"     {star} {C['off']}  ovl{C['reset']} "
                    f"{C['meta']}win {r['win']:<5}{C['reset']} {r['title'][:44]} "
                    f"{C['off']}◀ OVERLAY covering win {r['covers']}{C['reset']}"
                )
                continue
            if r["covered_by"]:
                why = (
                    f"  {C['off']}[covered by win {r['covered_by']} "
                    f"\"{r['covered_by_title'][:28]}\" — press ESC]{C['reset']}"
                )
            elif r["hidden_by"]:
                why = f"  {C['off']}[hidden by {r['hidden_by']}]{C['reset']}"
            else:
                why = ""
            print(
                f"     {star} {col}{r['cols']:>4}c{C['reset']} "
                f"{C['meta']}win {r['win']:<5}{C['reset']} {r['title'][:64]}{why}"
            )
        print()

    cloud_block(cloud)

    if n_off and subset is None:
        print(f"{C['meta']}reach one:  cc-where --go \"<part of its title>\"{C['reset']}")
    return 0


def go(rows: list[dict], query: str) -> int:
    try:
        pat = re.compile(query, re.I)
    except re.error as e:
        print(f"cc-where: bad pattern {query!r}: {e}", file=sys.stderr)
        return 64
    # Overlays are excluded from --go targets: a kitten is not somewhere the operator wants
    # to be sent, and matching one would make `--go` refuse-on-ambiguity against a lid.
    hits = [r for r in rows if not r["is_overlay"] and pat.search(r["title"])]
    if not hits:
        # BEFORE declaring a miss, ask cc-cloud. "Nothing matches" over a declared off-box session
        # is the local-oracle lie (§5.2): the session is fine, it is simply on no screen this box
        # owns. There is nothing to focus and nothing to signal — the action is the URL, and it
        # goes to STDOUT because it is an answer, not an error. Exit 5 says exactly that: found,
        # off-box, not focusable — distinguishable from 1 (no such session anywhere).
        offbox = cloud_match(cloud_sessions(), pat)
        if offbox:
            print(f"{len(offbox)} off-box session(s) match {query!r} — on NO screen, by construction:")
            cloud_block(offbox)
            print(f"open it:  open {offbox[0]['url']}")
            return 5
        print(f"cc-where: nothing matches {query!r}. Run `cc-where` for the census.", file=sys.stderr)
        return 1
    if len(hits) > 1:
        print(f"cc-where: {query!r} matches {len(hits)} panes — refusing to guess:", file=sys.stderr)
        for r in hits:
            print(f"  win {r['win']}  {r['title']}", file=sys.stderr)
        return 2

    target = hits[0]
    r = subprocess.run(
        [_kitty(), "@", "focus-window", "--match", f"id:{target['win']}"],
        capture_output=True, text=True, timeout=15,
    )
    if r.returncode != 0:
        print(f"cc-where: focus-window failed: {r.stderr.strip()}", file=sys.stderr)
        return 3

    # Verify by CONTENT. focus-window exits 0 for a window it matched but could not raise, so
    # re-read the tree and require the pane to now be in an ACTIVE tab.
    tree = ls_tree()
    after = next((p for p in panes(tree) if p["win"] == target["win"]), None)
    if after is None:
        print(f"cc-where: win {target['win']} vanished between match and focus", file=sys.stderr)
        return 4
    if after["covered_by"]:
        # Reached, but not usable — and this is the one failure whose remedy the operator can
        # act on in one keystroke, so it must not be reported as the generic off-screen miss.
        # cc-where does NOT dismiss it: a kitten is an operator UI mode that may be mid-use,
        # and closing one from a locate command would be acting on the operator's behalf.
        print(
            f"cc-where: win {after['win']} is raised but BURIED — kitten overlay win "
            f"{after['covered_by']} (\"{after['covered_by_title']}\") is drawn over it and "
            f"holds the keyboard. Press ESC in that pane; the session underneath is unharmed.",
            file=sys.stderr,
        )
        return 4
    if not after["on_screen"]:
        print(
            f"cc-where: focus-window returned 0 but win {after['win']} is STILL off-screen "
            f"(kitty window {after['oswin']}, tab {after['tab']})",
            file=sys.stderr,
        )
        return 4

    where = location_labels(tree).get(after["oswin"], f"kitty window {after['oswin']}")
    warn = ""
    if after["cols"] < READABLE_COLS:
        warn = f"  {C['narrow']}[only {after['cols']} cols — press cmd+shift+e to equalize]{C['reset']}"
    print(f"→ {where}, tab {after['tab']}: {after['title']}{warn}")
    return 0


USAGE = """cc-where — locate a Claude Code session on your physical screens

  cc-where                 every pane, grouped by display > kitty window > tab
  cc-where <regex>         only panes whose title matches
  cc-where --hidden        only panes that are off-screen right now
  cc-where --go <regex>    focus that pane (raises its window, switches to its tab)
  cc-where --json          machine-readable census (LOCAL PANES ONLY — see below)

  OFF-BOX sessions (declared with cc-cloud) are listed in their own block: they run
  in an Anthropic-managed VM, so they are on no screen this box owns, have no pid
  and no pane, and the only way to reach one is `open <url>` — never a kill.
  `--go` on one exits 5: found, off-box, nothing local to focus. They are absent
  from `--json` on purpose — that is a census of kitty panes, and an off-box row is
  not one; `cc-sessions --offbox --json` is the machine surface for them.

  A pane is OFF SCREEN when its tab is not the active tab of its kitty window,
  when the tab is ZOOMED (stack) and this is not the pane on top, or when a
  kitten OVERLAY is mounted on it: live, healthy, and drawing zero pixels in
  all three cases.
  ▸ marks the pane its tab shows — the one you land on when you switch to it.

  A COVERED pane is the one that looks broken rather than absent — the overlay
  (⌘E "Choose URL", unicode input, a kitten prompt) is drawn over the session
  full-size and holds the keyboard, so the pane goes colourless and ignores
  every keystroke. Nothing is wrong with the session. Press ESC in that pane."""


def main(argv: list[str]) -> int:
    args = argv[1:]

    if args and args[0] in ("-h", "--help"):
        print(USAGE)
        return 0

    tree = ls_tree()
    rows = panes(tree)

    if not args:
        return render(rows, tree, cloud=cloud_sessions())
    if args[0] == "--json":
        print(json.dumps(rows, indent=2))
        return 0
    if args[0] == "--go":
        if len(args) < 2:
            print("cc-where --go <regex>", file=sys.stderr)
            return 64
        return go(rows, args[1])
    if args[0] == "--hidden":
        hidden = [r for r in rows if not r["on_screen"]]
        # An off-box session is off-screen by construction, so --hidden is exactly the query it
        # answers — and it must not report "every pane is on a visible tab" while one exists.
        offbox = cloud_sessions()
        if not hidden:
            if not offbox:
                print("nothing is off-screen — every pane is on a visible tab.")
                return 0
            print("every local pane is on a visible tab; these are not on this box at all:")
            cloud_block(offbox)
            return 0
        return render(rows, tree, subset=hidden, cloud=offbox)
    if args[0].startswith("-"):
        print(USAGE, file=sys.stderr)
        return 64

    try:
        pat = re.compile(args[0], re.I)
    except re.error as e:
        print(f"cc-where: bad pattern {args[0]!r}: {e}", file=sys.stderr)
        return 64
    return render(
        rows,
        tree,
        subset=[r for r in rows if pat.search(r["title"])],
        cloud=cloud_match(cloud_sessions(), pat),
    )


if __name__ == "__main__":
    sys.exit(main(sys.argv))
