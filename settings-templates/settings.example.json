            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-plan-structure.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-version-commit.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-bash.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/waiting-recycle.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/relay-verbatim.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/task-mutation-index.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/teammate-checkpoint.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mailbox-drain.sh post-tool",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-pin-session.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/setup-plan-symlinks.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/setup-task-symlinks.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-session-validate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/lead-crash-watchdog.sh",
            "timeout": 10
