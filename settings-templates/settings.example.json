{
  "_comment": "Reproducible Claude Code config template \u2014 the FULL live hook roster (G-P6-7). Captured from the primary ~/.claude/settings.json with PORTABLE ~/.claude paths (live uses some machine-absolute /Users/... paths; the template normalizes them). install.sh --wire-hooks merges .hooks/.permissions.deny/.permissions.ask additively; scripts/settings-drift-assert.sh asserts these arrays match across all 5 config dirs. The anti-premature-done Stop hooks (session-continue, anti-deference-nudge, teammate-checkpoint, boundary-handoff) MUST survive a settings reset \u2014 that is the whole point of this capture.",
  "_comment_env": "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION / _AWAY_SUMMARY hard-pin the two grey-text UI features (input ghost-text suggestion; the 'recap:' line). Both are the FIRST branch of their gate fn (Kwo/vyr in 2.1.220), so a truthy value short-circuits the GrowthBook gate, the non-interactive check, and an accidental /config toggle-off — and re-wins on every settings reload. Load-bearing for suggestions: their gate tengu_chomp_inflection DEFAULTS FALSE, so they fail-to-OFF whenever GrowthBook is unreachable (telemetry off, cold cache, startup budget missed); the env var is what makes them deterministic. Neither var affects how OFTEN the features fire — that is trigger conditions (recap: terminal blurred + 3min idle + fresh prompt cache; suggestions: terminal focused + empty input + last turn under 10k tokens), which are not configurable. NOTE this comment sits OUTSIDE .env deliberately: every key inside .env is written into process.env and inherited by every child process.",
  "env": {
    "MCP_TIMEOUT": "30000",
    "MCP_TOOL_TIMEOUT": "60000",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "true",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "effortLevel": "high",
  "teammateMode": "tmux",
  "autoCompactEnabled": false,
  "worktree": {
    "_comment": "NEVER symlink node_modules (breaks pnpm's isolated layout + native bins \u2014 global CLAUDE.md rule). Only .cache.",
    "symlinkDirectories": [
      ".cache"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "defaultMode": "auto",
    "_comment_allow": "allow[] is project-specific and long (~350 entries live); this template keeps only the DESK-CRITICAL entries. Extend per project \u2014 the drift-assert does NOT gate on allow[] (auto-mode permits anything not matching an ask-rule; only deny/ask/hooks are safety-load-bearing).",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "MultiEdit",
      "Write",
      "WebSearch",
      "SendMessage",
      "Bash(cc-notify:*)",
      "Bash(~/.claude/scripts/handoff-fire.sh:*)",
      "Bash(~/.claude/scripts/restore-file.sh:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(jq:*)",
      "Bash(pnpm:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.local.*)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./credentials.json)",
      "Read(./**/*credentials*)",
      "Read(./**/*secret*)",
      "Bash(unlink:*)",
      "Bash(shred:*)",
      "Bash(truncate:*)",
      "Bash(wget:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(eval:*)",
      "Bash(exec:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(git clean:*)",
      "Bash(chflags nouchg:*)",
      "Bash(chflags -R nouchg:*)",
      "Bash(chflags noschg:*)",
      "Bash(chflags -R noschg:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf .git/)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(fly deploy:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
