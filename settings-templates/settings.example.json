        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-index-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/config-mirror-assert.sh",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/frontier-status.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/live-session-registry.sh",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "STAGED (P0-14 activation queue): re-page an un-run pending-activation script. Wire via install.sh once hooks/activation-watch.sh is deployed.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/activation-watch.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dod-persist.sh",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "Desk role activation: injects the canonical desk brief (docs/templates/desk-boot-brief.md) IFF this pane holds ~/.claude/cc-roles/desk. Pairs with dod-persist.sh above \u2014 that carries the mutable frozen DoD keyed on cwd, this carries the durable ROLE keyed on the role file. Silent no-op in every non-desk session. Wired by docs/activation/pending-activation/06-desk-bootstrap-activate.sh.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/desk-brief-inject.sh",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "The /accounts board at session start, at ZERO model tokens: it emits a TOP-LEVEL systemMessage (the only one of the three SessionStart channels that reaches the terminal without entering model context — hookSpecificOutput.systemMessage is silently ignored and additionalContext is billed; proven in docs/research/R5b-sessionstart-render-probe.py). It is a file read (~65ms), never a claude-accounts call: --readout measures 5.33s, over this timeout. The board is pre-rendered by the com.claude.accounts-keepwarm launchd job (claude-accounts --keepwarm), and the hook labels or withholds it by age.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/accounts-board.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end.sh",
            "timeout": 10
          }
        ]
      },
      {
        "_comment": "Registry deregistration: removes THIS pane's ~/.claude/cc-registry/<paneUUID>.json on a clean close. session-register.sh (SessionStart) wrote the row and session-deregister.sh was written to remove it, but the pair was never actually wired here \u2014 so every clean close and every `handoff-fire.sh self-close` leaked its row (82 stale rows found 2026-07-20), and the reaper read those ghosts as crashed sessions. Skips reason=clear by design (same pane re-registers immediately). Wired by docs/activation/pending-activation/08-session-deregister-activate.sh.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-deregister.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-index-end.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-save-id.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/harvest-skill-end.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/live-session-registry.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "_comment": "obj-1 \u2014 the anti-premature-done + notify chain (order matters). session-continue + anti-deference-nudge are the FM1 stack; they MUST be reproduced on every account.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh complete",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/cache-expiry-tracker.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/teammate-checkpoint.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-continue.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/anti-deference-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/completion-assert.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/operator-readout.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-beat.sh stop",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "obj-2 \u2014 boundary-handoff (state-preservation advisory at the context boundary). Live wires this only on ~/.claude via a machine-absolute path (G-P6-5b); the fix moves it here on ALL config dirs with a portable ~/.claude path.",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/boundary-handoff.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
