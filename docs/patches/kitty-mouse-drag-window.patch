@@ -0,0 +1,230 @@
+#!/usr/bin/env python
+# License: GPL v3 Copyright: 2026, kitty contributors
+
+import os
+from collections.abc import Iterator
+from contextlib import contextmanager
+from functools import partial
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from kitty.actions import get_all_actions
+from kitty.boss import Boss
+from kitty.conf.utils import KeyAction
+from kitty.config import load_config
+from kitty.fast_data_types import (
+    GLFW_MOUSE_BUTTON_LEFT,
+    GLFW_MOUSE_BUTTON_RIGHT,
+    clear_click_queue_for_window,
+    dnd_test_cleanup_fake_window,
+    dnd_test_create_fake_window,
+    dnd_test_set_mouse_pos,
+    get_mouse_press_data_for_window,
+    get_window_being_dragged,
+    set_window_being_dragged,
+)
+from kitty.tabs import TabManager
+from kitty.window import Window
+
+from .base import BaseTest
+
+ACTION = 'mouse_drag_window'
+
+
+@contextmanager
+def fake_window() -> Iterator[tuple[int, int]]:
+    """A window that exists on the C side, so that the real mouse position and drag state can be used.
+
+    The drag state is process global, so it must be cleared however the test ends."""
+    os_window_id, window_id = dnd_test_create_fake_window()
+    try:
+        yield os_window_id, window_id
+    finally:
+        set_window_being_dragged()
+        dnd_test_cleanup_fake_window(os_window_id)
+
+
+class DragWindow:
+    "The parts of Window that mouse_drag_window touches. Deliberately not a Mock: see test_unimplemented_action_is_not_consumed()"
+
+    mouse_drag_window = Window.mouse_drag_window
+
+    def __init__(self, window_id: int, button: int = GLFW_MOUSE_BUTTON_LEFT) -> None:
+        self.id = window_id
+        self.current_mouse_event_button = button
+        self.tab = SimpleNamespace()
+
+    def tabref(self) -> SimpleNamespace:
+        # dispatch_action() gives up before reaching the window if the tab is None
+        return self.tab
+
+
+class DragBoss(Boss):
+    window_for_dispatch: 'DragWindow | None'
+
+    @property
+    def active_window(self) -> 'DragWindow | None':
+        return self.window_for_dispatch
+
+    @property
+    def active_tab(self) -> None:
+        return None
+
+    def set_active_window(self, window: object, switch_os_window_if_needed: bool = False, **kw: object) -> None:
+        self.activated.append((window, switch_os_window_if_needed))
+
+
+def make_boss() -> DragBoss:
+    boss = DragBoss.__new__(DragBoss)
+    boss.args = SimpleNamespace(debug_keyboard=False)
+    boss.window_for_dispatch = None
+    boss.activated = []
+    return boss
+
+
+def press_data(cell_x: int = 0, cell_y: int = 0, x: float = 0.0, y: float = 0.0, drag_in_progress: bool = False) -> dict[str, object]:
+    return {'cell_x': cell_x, 'cell_y': cell_y, 'left_press_x': x, 'left_press_y': y, 'drag_in_progress': drag_in_progress}
+
+
+class TestWindowDrag(BaseTest):
+    def setUp(self) -> None:
+        super().setUp()
+        self.set_options({'drag_threshold': 5})
+
+    def tearDown(self) -> None:
+        set_window_being_dragged()
+        super().tearDown()
+
+    def dispatch(self, boss: DragBoss, w: DragWindow, defn: str = ACTION) -> bool:
+        with patch('kitty.window.get_boss', return_value=boss):
+            return boss.combine(defn, window_for_dispatch=w, dispatch_type='MouseEvent', raise_error=True)
+
+    # T1
+    def test_action_is_bindable_in_mouse_map(self) -> None:
+        errors: list[object] = []
+        opts = load_config(overrides=(f'mouse_map cmd+left press ungrabbed {ACTION} 2',), accumulate_bad_lines=errors)
+        self.ae(errors, [])
+        self.ae([d for d in opts.mousemap.values() if d.startswith(ACTION)], [f'{ACTION} 2'])
+        # The same resolution combine() performs, which is what the func_with_args parser exists for
+        self.ae(opts.alias_map.resolve_aliases(f'{ACTION} 2', 'mouse_map'), (KeyAction(ACTION, (2,)),))
+        self.ae(opts.alias_map.resolve_aliases(ACTION, 'mouse_map'), (KeyAction(ACTION, ()),))
+        # An unparseable argument must fall back to the default rather than raise
+        self.ae(opts.alias_map.resolve_aliases(f'{ACTION} nonsense', 'mouse_map'), (KeyAction(ACTION, (0,)),))
+        self.ae(opts.alias_map.resolve_aliases(f'{ACTION} -3', 'mouse_map'), (KeyAction(ACTION, (0,)),))
+        # and the action must be discoverable, which also proves the @ac() doc is well formed
+        self.assertIn(ACTION, {a.name for a in get_all_actions()['mouse']})
+
+    # T2
+    def test_action_arms_the_drag(self) -> None:
+        with fake_window() as (os_window_id, window_id):
+            boss, w = make_boss(), DragWindow(window_id)
+            with patch('kitty.window.get_mouse_press_data_for_window', return_value=press_data(x=12.5, y=34.5)):
+                self.assertTrue(self.dispatch(boss, w), 'the press must be consumed')
+            self.ae(get_window_being_dragged(), (window_id, False, 12.5, 34.5))
+            self.ae(boss.activated, [(w, True)])
+
+    def test_action_refuses_to_arm(self) -> None:
+        for name, data, button, opts in (
+            ('a non-left button', press_data(), GLFW_MOUSE_BUTTON_RIGHT, {}),
+            ('dragging disabled', press_data(), GLFW_MOUSE_BUTTON_LEFT, {'drag_threshold': 0}),
+            ('another drag in progress', press_data(drag_in_progress=True), GLFW_MOUSE_BUTTON_LEFT, {}),
+            ('no mouse data', None, GLFW_MOUSE_BUTTON_LEFT, {}),
+        ):
+            if opts:
+                self.set_options(opts)
+            with fake_window() as (os_window_id, window_id):
+                boss, w = make_boss(), DragWindow(window_id, button)
+                with patch('kitty.window.get_mouse_press_data_for_window', return_value=data):
+                    self.assertFalse(self.dispatch(boss, w), f'the press must pass through with {name}')
+                self.ae(get_window_being_dragged()[0], 0, f'the drag must not be armed with {name}')
+                self.ae(boss.activated, [], f'the window must not be focused with {name}')
+            if opts:
+                self.set_options({'drag_threshold': 5})
+
+    # T2-neg: the control that makes T2 mean anything
+    def test_unimplemented_action_is_not_consumed(self) -> None:
+        with fake_window() as (os_window_id, window_id):
+            boss, w = make_boss(), DragWindow(window_id)
+            self.assertFalse(self.dispatch(boss, w, 'definitely_not_an_action'))
+            self.ae(get_window_being_dragged()[0], 0)
+            self.ae(boss.activated, [])
+
+    # T3: the only test that does the distance arithmetic
+    def test_threshold_crossing_starts_the_drag(self) -> None:
+        threshold = self.set_options({'drag_threshold': 5}).drag_threshold
+        self.ae(threshold, 5)
+        for dx, dy, expected in ((3, 4, False), (4, 4, True)):  # 5.0 and 5.66 from the press point
+            with fake_window() as (os_window_id, window_id):
+                boss = SimpleNamespace(request_thumbnail=Mock(), start_window_drag=object())
+                tm = SimpleNamespace(os_window_id=os_window_id, recent_title_bar_mouse_events=Mock())
+                set_window_being_dragged(window_id, False, 100.0, 200.0)
+                with patch('kitty.tabs.get_boss', return_value=boss):
+                    TabManager.handle_window_title_bar_mouse(tm, window_id, 100.0 + dx, 200.0 + dy, -1, 0, 0)
+                self.ae(get_window_being_dragged(), (window_id, expected, 100.0, 200.0))
+                self.ae(boss.request_thumbnail.call_count, 1 if expected else 0, f'thumbnail at dx={dx} dy={dy}')
+
+    # T4
+    def test_drag_payload(self) -> None:
+        with fake_window() as (os_window_id, window_id):
+            w = SimpleNamespace(id=window_id, title='a window')
+            boss = SimpleNamespace(window_id_map={window_id: w}, all_tab_managers=())
+            tm = SimpleNamespace(os_window_id=os_window_id)
+            tm._clear_force_show_title_bars = partial(TabManager._clear_force_show_title_bars, tm)
+            set_window_being_dragged(window_id, True, 0.0, 0.0)
+            with (
+                patch('kitty.tabs.get_boss', return_value=boss),
+                patch('kitty.tabs.draw_single_line_of_text', return_value=(b'\0' * 16, 4)) as draw,
+                patch('kitty.tabs.start_drag_with_data') as sdwd,
+            ):
+                TabManager.start_window_drag(tm, b'\1' * 32, 4, 2)
+                self.ae(draw.call_count, 1)
+                self.ae(sdwd.call_count, 1)
+                os_window_arg, drag_data, thumbnails = sdwd.call_args.args
+                self.ae(os_window_arg, os_window_id)
+                self.ae(drag_data, {f'application/net.kovidgoyal.kitty-window-{os.getpid()}': str(window_id).encode()})
+                self.ae(thumbnails, ((b'\0' * 16 + b'\1' * 32, 4, 3),))
+                self.ae(get_window_being_dragged()[0], window_id, 'a successful drag must not clear the state')
+
+                # A failure to hand the drag to the OS must unwind the state
+                sdwd.side_effect = OSError('no drag for you')
