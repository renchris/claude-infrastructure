+// Window title band {{{
+// A one-cell-tall strip of system-font text drawn OVER the window's first (or
+// last) row. Unlike the cell title bar it is not a Screen and takes no row from
+// the grid: nothing about the layout changes when it appears, so no pty is
+// resized, no child is signalled and no content moves. It is redrawn at a fixed
+// rect every frame, so it does not scroll with the content beneath it.
+
+bool
+window_title_band_rect(const OSWindow *os_window, const Window *w, unsigned *left, unsigned *top, unsigned *width, unsigned *height) {
+    if (!OPT(window_title_bar_overlay) || !w || !w->visible || !os_window || !os_window->fonts_data) return false;
+    const Screen *screen = w->render_data.screen;
+    if (!screen || screen->lines < 2) return false;
+    const unsigned ch = os_window->fonts_data->fcm.cell_height;
+    const WindowGeometry *g = &w->render_data.geometry;
+    // Never draw a band over a window that is not at least one cell taller than it.
+    if (!ch || g->right <= g->left || g->bottom <= g->top + ch) return false;
+    *left = g->left; *width = g->right - g->left; *height = ch;
+    *top = OPT(window_title_bar) == TITLE_BAR_BOTTOM ? g->bottom - ch : g->top;
+    return true;
+}
+
+void
+free_window_title_band(Window *w) {
+    WindowTitleBandData *band = &w->title_band;
+    if (band->texture_id) { GLuint t = band->texture_id; free_texture(&t); band->texture_id = 0; }
+    free(band->buf); band->buf = NULL; band->width = 0; band->height = 0;
+    Py_CLEAR(band->last_title);
+    band->texture_is_current = false;
+}
+
+static void
+window_title_band_colors(const UIRenderData *ui, color_type *fg, color_type *bg) {
+    color_type f = ui->is_active_window ? OPT(window_title_bar_active_foreground) : OPT(window_title_bar_inactive_foreground);
+    color_type b = ui->is_active_window ? OPT(window_title_bar_active_background) : OPT(window_title_bar_inactive_background);
+    // An unset (none) colour arrives as 0; fall back to the window's own colours,
+    // which is what the other bars kitty draws over a window use.
+#define RGBCOL(which) (colorprofile_to_color_with_fallback(ui->screen->color_profile, ui->screen->color_profile->overridden.which, ui->screen->color_profile->configured.which, ui->screen->color_profile->overridden.which, ui->screen->color_profile->configured.which))
+    if (!f) f = RGBCOL(default_fg);
+    if (!b) b = RGBCOL(default_bg);
+#undef RGBCOL
+    // The text stays opaque; the FILL takes the window's own alpha, so on a translucent terminal
+    // the band is translucent too rather than a solid strip across it. cocoa_render_line_of_text
+    // and its freetype sibling both read the fill alpha from the top byte of bg.
+    float a = ui->bg_alpha; a = a < 0.f ? 0.f : (a > 1.f ? 1.f : a);
+    *fg = 0xff000000 | f; *bg = ((color_type)(uint8_t)(a * 255.f) << 24) | b;
+}
+
+static void
+draw_window_title_band(const UIRenderData *ui, bool for_final_output) {
+    unsigned left, top, width, height;
+    Window *w = ui->window;
+    if (!w || !w->title || !window_title_band_rect(ui->os_window, w, &left, &top, &width, &height)) return;
+    WindowTitleBandData *band = &w->title_band;
+    color_type fg, bg;
+    window_title_band_colors(ui, &fg, &bg);
+
+    if (band->width != width || band->height != height) {
+        uint8_t *nbuf = realloc(band->buf, (size_t)4 * width * height);
+        if (!nbuf) return;
+        band->buf = nbuf; band->width = width; band->height = height;
+        Py_CLEAR(band->last_title);  // force a re-render into the new buffer
+    }
+    if (!band->last_title || band->last_title != w->title || band->last_fg != fg || band->last_bg != bg) {
+        const char *title = PyUnicode_Check(w->title) ? PyUnicode_AsUTF8(w->title) : NULL;
+        if (!title) { PyErr_Clear(); return; }
+        static char titlebuf[2048];
+        snprintf(titlebuf, arraysz(titlebuf), " %s", title);
+        if (!draw_window_title(ui->os_window->fonts_data->font_sz_in_pts, ui->os_window->fonts_data->logical_dpi_y,
+                               titlebuf, fg, bg, band->buf, width, height, NULL)) { PyErr_Clear(); return; }
+        Py_CLEAR(band->last_title); band->last_title = Py_NewRef(w->title);
+        band->last_fg = fg; band->last_bg = bg;
+        band->texture_is_current = false;
+    }
+    if (!band->texture_id) { glGenTextures(1, &band->texture_id); band->texture_is_current = false; }
+    if (!band->texture_id) return;
+    glBindTexture(GL_TEXTURE_2D, band->texture_id);
+    if (!band->texture_is_current) {
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_SRGB_ALPHA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, band->buf);
+        band->texture_is_current = true;
+    }
+    // draw_window_title() fills the whole buffer with bg, so the quad is opaque and
+    // no separate blanking pass is needed.
+    ImageRenderData data = {.group_count=1};
+    gpu_data_for_image(&data, -1, 1, 1, -1);
+    data.texture_id = band->texture_id;
+    bind_program(GRAPHICS_PROGRAM);
+    if (for_final_output) glEnable(GL_FRAMEBUFFER_SRGB);
+    save_viewport_using_top_left_origin(left, top, width, height, ui->full_framebuffer_height);
+    draw_graphics(GRAPHICS_PROGRAM, &data, 0, 1, 1.f);
+    restore_viewport();
+    if (for_final_output) glDisable(GL_FRAMEBUFFER_SRGB);
+}
