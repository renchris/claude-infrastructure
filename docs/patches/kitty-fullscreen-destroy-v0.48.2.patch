+// Closing a window that is in native fullscreen, or moving into or out of it, closes it under
+// AppKit's fullscreen transition machinery: the window logs "finishing close" before its
+// NSToolbarFullScreenWindow is torn down, and the _NSExitFullScreenTransitionController that
+// then frees it can crash (-[_NSExitFullScreenTransitionController dealloc] -> -[NSWindow dealloc]
+// -> _removeForwardedObserver -> objc_retain on a dead object). This object owns such a window
+// after the GLFW window is gone, takes it out of fullscreen, and closes it only once AppKit
+// reports that it has left fullscreen. It releases itself when the window is closed.
+@interface GLFWDeferredClose : NSObject <NSWindowDelegate>
+- (instancetype)initWithWindow:(GLFWWindow *)w inTransition:(bool)in_transition;
+@end
+
+@implementation GLFWDeferredClose {
+    GLFWWindow *window;
+    bool exiting, closed, done;
+}
+
+- (instancetype)initWithWindow:(GLFWWindow *)w inTransition:(bool)in_transition
+{
+    self = [super init];
+    if (self) {
+        window = [w retain];
+        [window setDelegate:self];
+        [self after:5.0 run:@selector(timedOut)];
+        // Mid-transition, wait for AppKit to report where it ended up before acting.
+        if (!in_transition) [self leaveFullScreen];
+    }
+    return self;
+}
+
+- (void)after:(NSTimeInterval)delay run:(SEL)sel
+{
+    [self performSelector:sel withObject:nil afterDelay:delay inModes:@[NSRunLoopCommonModes]];
+}
+
+- (bool)leaveFullScreen
+{
+    if (exiting || done) return false;
+    exiting = true;
+    [window leaveFullScreenDetached];
+    return true;
+}
+
+- (void)timedOut
+{
+    // No transition callback arrived: start the exit ourselves once, then give up and close.
+    if (!exiting && ([window styleMask] & NSWindowStyleMaskFullScreen)) {
+        [self leaveFullScreen];
+        [self after:5.0 run:@selector(timedOut)];
+        return;
+    }
+    [self finish];
+}
+
+- (void)finish
+{
+    if (done) return;
+    done = true;
+    [NSObject cancelPreviousPerformRequestsWithTarget:self];
+    GLFWWindow *w = window;
+    window = nil;
+    [w setDelegate:nil];
+    if (!closed) {
+        [w orderOut:nil];
+        // The Tahoe zero-size frame workaround (see _glfwPlatformDestroyWindow), never on a window
+        // that is still fullscreen: the timeout and failed-exit paths can get here before it left,
+        // and a degenerate frame fed to the exit transition is what upstream 7e88f51ed7 removed.
+        if (!([w styleMask] & NSWindowStyleMaskFullScreen)) {
+            NSRect frame = w.frame; frame.size.width = 0; frame.size.height = 0;
+            [w setFrame:frame display:NO];
+            [w setHasShadow:NO];
+        }
+        [w close];  // releases the reference GLFW created the window with
+    }
+    [w release];
+    [self release];
+}
+
+// Never free the window inside one of its own delegate callbacks: close on a later run loop turn,
+// after AppKit has finished tearing down the fullscreen transition.
+- (void)windowDidEnterFullScreen:(NSNotification *)notification { (void)notification; [self leaveFullScreen]; }
+- (void)windowDidFailToEnterFullScreen:(NSWindow *)w { (void)w; [self after:0 run:@selector(finish)]; }
+- (void)windowDidExitFullScreen:(NSNotification *)notification { (void)notification; [self after:0.3 run:@selector(finish)]; }
+- (void)windowDidFailToExitFullScreen:(NSWindow *)w { (void)w; [self after:0 run:@selector(finish)]; }
+- (void)windowWillClose:(NSNotification *)notification { (void)notification; closed = true; }
+@end
+
