#!/usr/bin/env python3
"""stamp-version.py — print the build stamp for the current checkout.

    scripts/stamp-version.py            prints "version <short-sha>"
    scripts/stamp-version.py --dirty    appends "+dirty" when the tree has uncommitted changes

Resolves git from PATH, so a test can substitute its own git.
"""

import subprocess
import sys


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True
    ).stdout.strip()


def main(argv: list[str]) -> int:
    sha = git("rev-parse", "--short", "HEAD")
    stamp = f"version {sha}"
    if "--dirty" in argv and git("status", "--porcelain"):
        stamp += "+dirty"
    print(stamp)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
