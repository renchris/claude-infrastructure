                  "uri": "hooks/notify.sh"
                },
                "region": {
                  "endLine": 39,
                  "startLine": 39
                }
              }
            }
          ],
          "message": {
            "text": "The notification hook writes its log and debounce lock to hardcoded `/tmp` paths. `/tmp` is world-writable on macOS, so a process running as another uid can pre-create either path as a symlink and have the hook's append or touch follow it, writing to a file of the attacker's choosing with the invoking user's privileges."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:422cb08f647e95160b5d31ffe645842d9011ca3ffa5a78cd2e66688e14491e02",
            "primaryLocationLineHash": "1582b9d68c7ce209:1"
          },
          "properties": {
            "category": "Insecure temporary file / link following",
            "confidence": "high",
            "findingId": "csf_3e515867f4bce69bbfe083ce",
            "occurrenceId": "occ_f00cfa565b32dcc7068f6057",
            "severity": "low"
          },
          "ruleId": "tempfile.predictable-world-writable-path",
          "ruleIndex": 1
        }
      ],
