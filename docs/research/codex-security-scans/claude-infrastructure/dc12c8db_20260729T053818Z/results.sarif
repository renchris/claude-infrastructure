            "confidence": "high",
            "findingId": "csf_62c61e14bacee96a5c5fb5ca",
            "occurrenceId": "occ_78102ca2f37cb6df1a059265",
            "severity": "medium"
          },
          "ruleId": "denylist.incomplete-flag-forms",
          "ruleIndex": 0
        },
