              }
            }
          ],
          "message": {
            "text": "The tokenless launcher grants every ReviewApp role based only on an app-state marker and loopback TCP peer. It does not bind the grant to the expected Host, Origin, or an unguessable launcher credential, so a browser DNS-rebinding origin can potentially reach protected routes as the local principal."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:72cba4c20c0bd1bfa71bdf6b049cb63eda6538694fc6fd63b303d8bf1e2523b3"
