# OS
.DS_Store

# Secrets (never commit actual env/tokens)
.env
.env.local
*.key
*.pem

# Claude runtime state
*.log
*.db
*.lock
.claude-tasks

# Claude project config — global gitignore ignores all of .claude/; un-ignore it
# here so committed project-local commands (.claude/commands/) are tracked, then
# re-ignore the volatile local state.
!.claude/
.claude/settings.local.json
.claude/worktrees/
.claude/tmp/
.claude/logs/

# ad-hoc token-usage snapshot dumps (cross-account transcript analysis, 2026-07-16) — generated, never source
usage/

# accounts.json holds real email addresses — a fresh clone copies accounts.json.example instead.
# NOT retroactive: this repo's own tracked accounts.json (added before this rule existed, by
# deliberate operator choice) stays tracked — gitignore never untracks an already-added file.
/accounts.json

# agents/ — name-invoked subagent definitions; this repo IS their source of truth.
# The global gitignore's RESEARCH-*.md rule (meant for UPPERCASE research OUTPUT docs) also
# matches lowercase research-*.md on macOS's case-insensitive filesystem. It already had to
# hand-negate one casualty by name (!research-subagents.md), and it silently swallowed
# agents/research-decomposition-critic.md on 2026-07-25 — `git add agents/` staged 3 of 4 files
# and reported no error. Un-ignore this repo's own agent surface structurally, by path, so the
# next research-named agent is not lost the same way. (Repo .gitignore is read AFTER the global
# excludesFile, so this negation wins; agents/ itself was never excluded — only the *.md
# pattern was — so re-inclusion is legal here.)
!agents/*.md

# python bytecode cache (bin/*.py, cc-wave-plan, claude-accounts, etc.)
__pycache__/
*.pyc

# diagram render toolchain only (scripts/render-diagrams.mjs); package-lock.json IS
# committed — CI's `npm ci` requires it.
node_modules/

# defensive: a worktree must NEVER be created INSIDE the repo (they belong in
# ~/Development/.worktrees). A stray inside-repo one read as untracked litter and made every
# co-cwd session permanently "dirty" to the reaper. .claude/worktrees/ is ignored above.
/.worktrees/

# VHS can only write GIF, so `vhs assets/demo/handoff-real.tape` emits a GIF that is then
# converted to the committed animated WebP (see the tape header). The GIF is a build
# intermediate — regenerable, ~709 KB, and never referenced by the README.
/assets/demo/handoff-real.gif

# VHS emits a GIF that gif2webp converts to the committed WebP; the GIF is a build intermediate.
/assets/demo/terminal-bench.gif

# backlog-consolidation-2026-08-09 INPUTS. The run's deliverables — the 15 OUT-*.md — are tracked
# and are what every citation names (bin/cc-blockers:464, and four plan docs). These are its raw
# working data: ~1.2 MB of cluster-*.json / backlog-open.json / verdicts.json regenerated by
# link.py, cited by nothing, and untracked since 2026-08-11. Ignored rather than committed so the
# shared checkout stops reading dirty at every close without paying 1.2 MB of history for data no
# reader asks for.
/docs/plans/backlog-consolidation-2026-08-09/backlog-open.json
/docs/plans/backlog-consolidation-2026-08-09/cluster-*.json
/docs/plans/backlog-consolidation-2026-08-09/verdicts.json
/docs/plans/backlog-consolidation-2026-08-09/link-log.txt

# Timestamped pre-migration backups of accounts.json. Point-in-time safety copies, never inputs.
/accounts.json.pre-*
