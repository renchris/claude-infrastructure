<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude.session-search-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/bin/bash ~/.claude/hooks/session-index-sweep.sh 2>&amp;1 | head -20 >> ~/.claude/logs/sweep-daemon.log</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <!--
        StartInterval stays 60 (tests/session-index-sweep.bats pins it); the throttle is the
        script's own knob (hooks/session-index-sweep.sh "Cadence knob"): a tick inside 300 s of the
        last real pass exits before touching the DB, instead of walking every project directory
        each minute (docs/plans/LOAD_AND_PROMPT_HOOK_TIMEOUTS.md O3). Index lag becomes at most
        5 min. A loaded job re-reads this only on reload: c10, migrations/0065.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>SESSION_INDEX_SWEEP_MIN_INTERVAL_S</key>
        <string>300</string>
    </dict>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>/tmp/session-search-sweep.err</string>
</dict>
</plist>
