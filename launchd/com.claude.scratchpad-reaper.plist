<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SSOT for com.claude.scratchpad-reaper. STAGED, NOT LOADED — standing activation of a
     DELETING job is a class-C operator decision (C10). Activation (operator, in this order):
       1. rehearse:  ~/.claude/scripts/scratchpad-reaper.sh            # dry-run, deletes nothing
       2. install:   cp launchd/com.claude.scratchpad-reaper.plist ~/Library/LaunchAgents/
       3. load:      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.claude.scratchpad-reaper.plist
     Horizon is 48 h and liveness-gated inside the script (see its header). -->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.claude.scratchpad-reaper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH="$HOME/.claude/bin:$PATH"; ~/.claude/scripts/scratchpad-reaper.sh --apply</string>
  </array>
  <key>StartInterval</key>    <integer>21600</integer>
  <key>RunAtLoad</key>        <false/>
  <key>ProcessType</key>      <string>Background</string>
  <key>LowPriorityIO</key>    <true/>
  <key>Nice</key>             <integer>10</integer>
  <key>StandardOutPath</key>  <string>/Users/chrisren/.claude/logs/scratchpad-reaper.out.log</string>
  <key>StandardErrorPath</key><string>/Users/chrisren/.claude/logs/scratchpad-reaper.err.log</string>
</dict>
</plist>
