<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SSOT for com.claude.research-market. STAGED, NOT LOADED — loading it is the operator's
     (migrations/0051-research-jobs.sh, class c10). Weekly, Monday 08:00: `cc-research job market`
     refreshes each program's outside populations on their own cadence and parks new members as
     next-version candidates (REPORT.md §5.5). -->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.claude.research-market</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chrisren/.claude/scripts/research-kit/jobs/research-job.sh</string>
    <string>market</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>        <integer>1</integer>
    <key>Hour</key>           <integer>8</integer>
    <key>Minute</key>         <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>        <false/>
  <key>StandardOutPath</key>  <string>/Users/chrisren/.claude/logs/research-market.out.log</string>
  <key>StandardErrorPath</key><string>/Users/chrisren/.claude/logs/research-market.err.log</string>
</dict>
</plist>
