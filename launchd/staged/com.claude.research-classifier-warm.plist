<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SSOT for com.claude.research-classifier-warm. STAGED, NOT LOADED — loading it is the operator's
     (migrations/0059-research-classifier-warm.sh, class c10). A resident daemon: it keeps two
     classifier processes started ahead of the prompt, so the re-ask router's label does not pay a
     cold start inside its 9 s limit (decision 4bf73c4e55d5 option 3; plan wave E1c). When it is
     not running the router makes the cold call it makes today. -->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.claude.research-classifier-warm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chrisren/.claude/scripts/research-kit/jobs/classifier-warm.sh</string>
  </array>
  <key>RunAtLoad</key>        <true/>
  <key>KeepAlive</key>        <true/>
  <key>ThrottleInterval</key> <integer>30</integer>
  <key>StandardOutPath</key>  <string>/Users/chrisren/.claude/logs/research-classifier-warm.out.log</string>
  <key>StandardErrorPath</key><string>/Users/chrisren/.claude/logs/research-classifier-warm.err.log</string>
</dict>
</plist>
