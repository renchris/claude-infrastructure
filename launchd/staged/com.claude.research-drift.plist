     (REPORT.md §5.5). -->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.claude.research-drift</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chrisren/.claude/scripts/research-kit/jobs/research-job.sh</string>
    <string>drift</string>
