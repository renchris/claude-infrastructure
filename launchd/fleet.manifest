com.claude.power-policy-verify    | staged | 3600 | auto | 12 | 05-pmset-caffeinate-activate.sh
com.claude.team-orphan-reaper     | staged | 600  | auto | 11 | 18-fleet-activate.sh
com.claude.desk-invariant         | staged | 300  | auto | 5  | 06-desk-bootstrap-activate.sh
