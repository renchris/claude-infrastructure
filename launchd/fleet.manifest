com.claude.log-rotation           | run    | 3600 | auto | 12 | 18-fleet-activate.sh
com.claude.session-search-sweep   | run    | 60   | auto | 9  | 18-fleet-activate.sh
com.claude.session-search-backfill| run    | 0    | auto | 9  | 18-fleet-activate.sh
