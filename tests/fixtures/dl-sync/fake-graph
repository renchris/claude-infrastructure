#!/usr/bin/env python3
"""Graph stub for tests/dl-sync.bats: dl_calendar_graph.py's CLI over $STUB/graph.json; mail
probes answer from $STUB/mail.json. $STUB/graph-down makes every call fail."""
import json, os, re, sys, uuid
S = os.environ["STUB"]
a = sys.argv[1:]
with open(os.path.join(S, "graph-calls.log"), "a") as f:
    f.write(" ".join(a) + "\n")
if os.path.exists(os.path.join(S, "graph-down")):
    sys.exit(1)
p = os.path.join(S, "graph.json")
ev = json.load(open(p)) if os.path.exists(p) else []
if a[0] == "upsert":
    j = json.load(sys.stdin)
    e = next((e for e in ev if e["id"] == j.get("event_id")), None) or next((e for e in ev if f"[{j['tag']}]" in e["notes"]), None)
    if e is None:
        e = {"id": "g-" + uuid.uuid4().hex[:8]}; ev.append(e)
    e.update(title=j["title"], notes=j["notes"], start=j["start"])
    json.dump(ev, open(p, "w"), indent=1); print(json.dumps({"id": e["id"], "created": False}))
elif a[0] == "tags":
    print(json.dumps([t[1:-1] for e in ev for t in re.findall(r"\[dl:[a-z0-9.:-]+\]", e["notes"])]))
elif a[0] == "mail":
    print(open(os.path.join(S, "mail.json")).read() if os.path.exists(os.path.join(S, "mail.json")) else "[]")
elif a[0] == "delete":
    json.dump([e for e in ev if e["id"] != a[1]], open(p, "w")); print('{"ok": true}')
